on load:
    set {_enchanting} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting"
    set {enchanterstable} to (enchanting table named "<#9854ba>Enchanter's Table") with lore ("%{_enchanting}%%nl%&7Interact to craft items, &f✨ &oEnchant &7and &f✨ &oDisenchant&7.%nl%&7Can be placed anywhere in the world.")

on rightclick on a player:
    if (clicked player's name) = "Atticus":
        playEnchantMenuSound(player)

        play sound "entity.villager.yes" with volume 5 and pitch 0.62 to player
        play sound "item.book.page_turn" with volume 5 and pitch 0 to player

        set {_dialogue} to a random integer between 1 and 3
        if {_dialogue} = 1:
            send "&8[<#d35de8>NPC&8] &8<<#d35de8>Master Atticus&8> &fWhat truth shall we uncover today?" to player
        else if {_dialogue} = 2:
            send "&8[<#d35de8>NPC&8] &8<<#d35de8>Master Atticus&8> &fEvery rune tells a story." to player
        else:
            send "&8[<#d35de8>NPC&8] &8<<#d35de8>Master Atticus&8> &fPower requires a steady hand." to player

        if not knowsProfession(player, "Enchanting"):
            set (metadata tag "EnchantingLearn" of player) to (a chest inventory with 3 rows named "&5Learn Enchanting")
            set {_enchantingLearn} to metadata tag "EnchantingLearn" of player
            set {_name} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Learn Enchanting"

            loop 28 times:
                set slot (loop-number - 1) of {_enchantingLearn} to (black stained glass pane named " ")

            set {_lore} to "&f✨ Enchanting%nl%&7Enchanters are masters at empowering Gear and%nl%&7tools and crafting items using magical reagents%nl%&7obtained from &f&o✨ Disenchanting &7Cards and other loot.%nl% %nl%&f(!) Click here to learn the Enchanting profession."
            set slot 13 of {_enchantingLearn} to (book named {_name}) with lore ({_lore}) with nbt from ("{""minecraft:custom_model_data"":{floats:[4.0f]}}")
            set (boolean tag "LearnEnchanting" of (custom nbt of (slot 13 of {_enchantingLearn}))) to true
            open {_enchantingLearn} to player

        else:
            openEnchantingMenu(player)

command /en:
    trigger:
        if yaml "EnchantingProfessionList" is loaded:
            unload yaml "EnchantingProfessionList"
            broadcast "unloaded"
        else:
            load yaml "plugins/Skript/lists/EnchantingProfessionList" as "EnchantingProfessionList"
            broadcast "loaded"

command /en2:
    trigger:
        if yaml "GearList" is loaded:
            unload yaml "GearList"
            broadcast "unloaded"
        else:
            load yaml "plugins/Skript/lists/GearList" as "GearList"
            broadcast "loaded"

command /en3:
    trigger:
        if yaml "RuneList" is loaded:
            unload yaml "RuneList"
            broadcast "unloaded"
        else:
            load yaml "plugins/Skript/lists/RuneList" as "RuneList"
            broadcast "loaded"

command /en4:
    trigger:
        if yaml "CardList" is loaded:
            unload yaml "CardList"
            broadcast "unloaded"
        else:
            load yaml "plugins/Skript/lists/CardList" as "CardList"
            broadcast "loaded"

function learnEnchantingRecipe(p: player, recipeName: string):
    set yaml value "Professions.Enchanting.Unlocked Recipes.%{_recipeName}%.Purchased" in "data-%{_p}%" to true
    set {_recipesLearned} to "Statistics.Professions.Recipes Learned"
    addToYaml(1, "data-%{_p}%", "%{_recipesLearned}%.Enchanting")
    addToYaml(1, "data-%{_p}%", "%{_recipesLearned}%.Total")
    save yaml "data-%{_p}%"

function playLearnEnchantingRecipe(p: player, items: items):
    play sound "block.amethyst_block.chime" with volume 1 and pitch 1.8 to {_p}
    play sound "entity.experience_orb.pickup" with volume 0.8 and pitch 0.5 to {_p}
    
    wait 2 ticks

    play sound "block.enchantment_table.use" with volume 1 and pitch 1.2 to {_p}
    play sound "item.book.page_turn" with volume 1 and pitch 0.8 to {_p}
    
    wait 3 ticks
    
    play sound "entity.player.levelup" with volume 0.6 and pitch 1.6 to {_p}
    play sound "block.note_block.chime" with volume 1 and pitch 1.4 to {_p}
    
    draw 15 of (((witch particle) with an extra value of 0.05) with offset vector(0.5, 0.5, 0.5)) at (location above {_p})

    loop {_items::*}:
        draw 30 of (((loop-value item particle) with an extra value of 0.05) with offset vector(0.5, 0.5, 0.5)) at (location above {_p})
        wait 3 ticks
    

function openEnchantingMenu(p: player):
    set (metadata tag "EnchantingMenu" of {_p}) to (chest inventory with 3 rows named "Enchanting Menu")
    set {_enchantingMenu} to metadata tag "EnchantingMenu" of {_p}

    set {_recipes} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>View Recipes"
    set {_level} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Check Enchanting Level"
    set {_buyItems} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Purchase Items"
    set {_specs} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Profession Specializations"

    loop 28 times:
        set slot (loop-number - 1) of  {_enchantingMenu} to (black stained glass pane named " ")

    set slot 10 of {_enchantingMenu} to (book named {_level}) with lore ("&7Click here to check your &f✨ Enchanting &7level%nl%&7and discover the reward track.") with nbt from ("{""minecraft:custom_model_data"":{floats:[4.0f]}}")
    set slot 12 of {_enchantingMenu} to (pink dye named {_specs}) with lore ("&7Click here to check your &f✨ Enchanting &7Profesion%nl%&7Specializations and assign Knowledge Points.") with nbt from ("{""minecraft:custom_model_data"":{floats:[7.0f]}}") 
    set slot 14 of {_enchantingMenu} to (glowstone dust named {_recipes}) with lore ("&7Click here to view or pruchase%nl%&7your discovered &f✨ Enchanting &7recipes.") with nbt from ("{""minecraft:custom_model_data"":{floats:[1.0f]}}")
    set slot 16 of {_enchantingMenu} to (amethyst shard named {_buyItems}) with lore ("&7Click here to purchase items required for%nl%&7&f✨ Enchanting &7crafts.") with nbt from ("{""minecraft:custom_model_data"":{floats:[2.0f]}}")
    
    set (boolean tag "EnchantingLevel" of (custom nbt of slot 10 of {_enchantingMenu})) to true
    set (boolean tag "EnchantingSpecializations" of (custom nbt of slot 12 of {_enchantingMenu})) to true
    set (boolean tag "EnchantingRecipes" of (custom nbt of slot 14 of {_enchantingMenu})) to true
    set (boolean tag "EnchantingBuyItems" of (custom nbt of slot 16 of {_enchantingMenu})) to true
    play sound "item.book.page_turn" with volume 0.8 and pitch 0.9 at {_p} for {_p}
    open {_enchantingMenu} to {_p}

function openEnchantingPurchaseMenu(p: player):
    set (metadata tag "EnchantingMenu-Purchase" of {_p}) to (a chest inventory with 6 rows named "Enchanting Menu - Purchase")
    set {_enchantingMenu} to metadata tag "EnchantingMenu-Purchase" of {_p}
    set slots (integers between 45 and 53) of {_enchantingMenu} to (black stained glass pane named " ")
    
    set {_baseSlot} to 0
    set {_shopItems::*} to yaml node keys "Shop Items" in "EnchantingProfessionList"

    play sound "item.book.page_turn" with volume 0.8 and pitch 0.9 at {_p} for {_p}

    loop (size of {_shopItems::*}) times:
        set {_itemName} to {_shopItems::%loop-counter%}
        set {_item} to yaml value "%{_itemName}%.Item" in "ItemList"
        add "%nl%&7Purchase cost:%nl%" to lore of {_item}

        set {_itemCost::*} to yaml node keys "Shop Items.%{_itemName}%.Price" in "EnchantingProfessionList"
        loop {_itemCost::*}:
            set {_currencyAmount} to yaml value "Shop Items.%{_itemName}%.Price.%loop-value-2%" in "EnchantingProfessionList"

            set {_currencyItem} to (yaml value "%loop-value-2%.Item" in "ItemList")
            set {_currencyNameColoured} to name of {_currencyItem}

            add "&f- %{_currencyAmount}%x %{_currencyNameColoured}%" to lore of {_item}
            set int tag "Price;%loop-value-2%" of custom nbt of {_item} to {_currencyAmount}

            if {_p} has {_currencyAmount} of {_currencyItem}:
                set {_checkTrue} to {_checkTrue} + 1

        if {_checkTrue} = (size of {_itemCost::*}):
            add "%nl%&aClick here to purchase this item." to lore of {_item}
        else:
            add "%nl%&cInsufficient amount of currency." to lore of {_item}
        
        set slot (loop-counter - 1) of {_enchantingMenu} to {_item}

    open {_enchantingMenu} to {_p}

function openEnchantingLevelMenu(p: player):
    set (metadata tag "EnchantingMenu-Level" of {_p}) to (a chest inventory with 6 rows named "Enchanting Menu - Level Track")
    set {_enchantingMenu} to metadata tag "EnchantingMenu-Level" of {_p}

    set {_gradient} to "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>"
    set {_enchanting} to mini message from "%{_gradient}%Enchanting Profession"

    set {_menuDecor} to white stained glass pane named " "
    set slots (0, 8, 9, 17, 18, 26, 27, 35) of {_enchantingMenu} to {_menuDecor}
    set slots (integers between 36 and 44) of {_enchantingMenu} to {_menuDecor}

    set slot 49 of {_enchantingMenu} to (barrier named "&cExit") with lore ("&7Click here to exit the menu.")
    set slot 53 of {_enchantingMenu} to (arrow named "&fNext Page") with lore ("&7Click here to jump to the next page.")

    set boolean tag "NextPage" of (custom nbt of slot 53 of {_enchantingMenu}) to true

    enchantingMenuPage({_p}, {_enchantingMenu})

    set {_level} to getEnchantingLevel({_p})
    set {_maxLevel} to 75
    set {_experience} to getEnchantingExp({_p})
    set {_recipes} to (size of (yaml node keys "Professions.Enchanting.Unlocked Recipes" in "data-%{_p}%"))
    set {_maxRecipes} to (size of (yaml node keys "Recipes" in "EnchantingProfessionList"))

    set {_paths::totalCrafts} to "Statistics.Crafting.Professions.Enchanting.Total"
    set {_paths::itemsEnchanted} to "Statistics.Professions.Enchanting.Enchanting.Enchanted Items.Total"
    set {_paths::itemsDisenchanted} to "Statistics.Professions.Enchanting.Disenchanting.Disenchanted Items.Total"
    set {_paths::playerExpEarned} to "Statistics.Experience.Professions.Enchanting.Total"

    loop {_paths::*}:
        set {_%loop-index%} to yaml value loop-value in "data-%{_p}%"
        if {_%loop-index%} is not set:
            set {_%loop-index%} to 0
    
    set {_lore} to "&7Level: &f%{_level}%%nl%&7Experience: &f%{_experience}% XP%nl%&7Unlocked Recipes: &f%{_recipes}%&7/&f%{_maxRecipes}%%nl% %nl%&7Total Crafts: &f%{_totalCrafts}%"
    set {_lore} to "%{_lore}%%nl%&7Items Disenchanted: &f%{_itemsDisenchanted}%%nl%%nl%&7Items Enchanted: &f%{_itemsEnchanted}%%nl%&7Player Experience Earned: &f%{_playerExpEarned}% XP"
    set (slot 4 of {_enchantingMenu}) to (book named {_enchanting}) with lore {_lore} with nbt from ("{""minecraft:custom_model_data"":{floats:[4.0f]}}")

    play sound "item.book.page_turn" with volume 0.8 and pitch 0.9 at {_p} for {_p}
    open {_enchantingMenu} to {_p}

function enchantingMenuPage(p: player, enchantingMenu: inventory):
    set {_page} to metadata tag "EnchantingMenuCurrentPage" of {_p}
    if {_page} > 1:
        set slot 45 of {_enchantingMenu} to (arrow named "&fPrevious Page") with lore ("&7Click here to jump to the previous page.")
        set boolean tag "PreviousPage" of (custom nbt of (slot 45 of {_enchantingMenu})) to true
    else:
        set slot 45 of {_enchantingMenu} to air

    set {_baseSlot} to 18
    set {_level} to getEnchantingLevel({_p})
    set {_experience} to getEnchantingExp({_p})
    
    set {_expPerLevel} to yaml value "Experience Requirement" in "EnchantingProfessionList"

    set {_allLevelReward} to yaml value "Enchanting.Rewards.All Levels.Description" in "EnchantingProfessionList"
    set {_allLevelRewardAmount} to yaml value "Enchanting.Rewards.All Levels.Amount" in "EnchantingProfessionList"
    set {_allLevelRewardApexLevel} to yaml value "Enchanting.Rewards.All Levels.Apex Level" in "EnchantingProfessionList"
    set {_allLevelRewardApexAmount} to yaml value "Enchanting.Rewards.All Levels.Apex Amount" in "EnchantingProfessionList"

    set {_totalExperienceGathered} to ({_expPerLevel} * ({_level} * ({_level} + 1) / 2))
    broadcast {_totalExperienceGathered}

    replace all "{NL}" in {_allLevelReward} with nl 

    play sound "item.book.page_turn" with volume 0.8 and pitch 0.9 at {_p} for {_p}

    loop 14 times:
        set {_slotLevel} to (({_page} - 1) * 14) + loop-number
        set {_experienceRequirement} to (({_expPerLevel} * ({_slotLevel} * ({_slotLevel} + 1) / 2)) - {_totalExperienceGathered})

        if {_level} > {_slotLevel}:
            set {_slotItem} to magenta stained glass pane
            set {_nameColour} to "<#aa56db>"
            set {_requirement} to "<#aa56db>✔ Unlocked"

        else if {_level} = {_slotLevel}:
            set {_slotItem} to pink stained glass pane
            set {_nameColour} to "&d"
            set {_missingExperience} to {_experienceRequirement}-{_experience}
            set {_requirement} to "&d✔ You are at this level"
        
        else:
            set {_slotItem} to gray stained glass pane
            set {_nameColour} to "&8"
            set {_missingExperience} to {_experienceRequirement}-{_experience}
            set {_requirement} to "&7Experience Needed: &f%{_missingExperience}%"
        
        set {_rewardString} to {_allLevelReward}

        if {_slotLevel} is divisible by {_allLevelRewardApexLevel}:
            replace all "{AMOUNT}" in {_rewardString} with "%{_allLevelRewardApexAmount}%"
        else:
            replace all "{AMOUNT}" in {_rewardString} with "%{_allLevelRewardAmount}%"
        
        set {_levelsWithApexIncrease} to (rounded down ({_slotLevel}/{_allLevelRewardApexLevel}))*{_allLevelRewardApexAmount}
        set {_excludeLevelsOnApex} to (rounded down ({_slotLevel}/{_allLevelRewardApexLevel}))* {_allLevelRewardAmount}
        set {_totalIncrease} to ({_slotLevel}*{_allLevelRewardAmount}) + ({_levelsWithApexIncrease} - {_excludeLevelsOnApex})

        set {_allLevelRewardDescription} to "%{_rewardString}% &7(Total Increase: &f%{_totalIncrease}%%%&7)"

        if yaml value "Enchanting.Rewards.Level %{_slotLevel}%" in "EnchantingProfessionList" is set:
            set {_reward} to formatted (yaml value "Enchanting.Rewards.Level %{_slotLevel}%.Description" in "EnchantingProfessionList")

            if yaml value "Enchanting.Rewards.Level %{_slotLevel}%.Reward.Item Type" in "EnchantingProfessionList" is set:
                set {_itemType} to yaml value "Enchanting.Rewards.Level %{_slotLevel}%.Reward.Item Type" in "EnchantingProfessionList"
                set {_enchantName} to yaml value "Enchanting.Rewards.Level %{_slotLevel}%.Reward.Reward Name" in "EnchantingProfessionList"
                set {_enchantRank} to yaml value "Enchanting.Rewards.Level %{_slotLevel}%.Reward.Tier" in "EnchantingProfessionList"
                set {_value} to yaml value "Enchants.%{_itemType}%.%{_enchantName}%.Tiers.%{_enchantRank}%.Value" in "EnchantingProfessionList"
            else:
                set {_value} to (yaml value "Enchanting.Rewards.Level %{_slotLevel}%.Value" in "EnchantingProfessionList")
                
            replace all "{NL}" in {_reward} with nl

            if {_reward} contains "{GRADIENT}":
                set {_gradientText} to (2nd element of ({_reward} split at "{GRADIENT}"))
                set {_gradientText} to (1st element of ({_gradientText} split at "{/GRADIENT}"))
                set {_gradient} to (yaml value "Enchanting.Rewards.Level %{_slotLevel}%.Gradient" in "EnchantingProfessionList")
                replace all "{GRADIENT}%{_gradientText}%{/GRADIENT}" in {_reward} with mini message from "%{_gradient}%%{_gradientText}%</gradient>"
            
            if {_reward} contains "{TOTAL}":
                broadcast "Ass"
            replace all "{VALUE}" in {_reward} with "%{_value}%"

            set {_rewardDesc} to "%{_reward}%%nl% %nl%%{_allLevelRewardDescription}%"
        else:
            set {_rewardDesc} to {_allLevelRewardDescription}

        if ({_baseSlot} + 1) = 26:
            set {_baseSlot} to 27

        set (slot ({_baseSlot} + 1) of {_enchantingMenu}) to ({_slotItem} named "%{_nameColour}%Level %{_slotLevel}%") with lore ("%nl%%{_rewardDesc}%%nl% %nl%%{_requirement}%")

        set {_baseSlot} to {_baseSlot} + 1

on rightclick on enchanting table:
    if boolean tag "EnchantingTable" of custom nbt of event-block is true:
        cancel event
        if knowsProfession(player, "Enchanting"):
            play sound "minecraft:block.enchantment_table.use" with volume 4 and pitch 1 to player
            set (metadata tag "EnchantingTable" of player) to (chest inventory with 3 rows named "Enchanting Table")

            set {_menu} to metadata tag "EnchantingTable" of player
            set {_disenchant} to mini message from "<gradient:##d6ff94:##70ffa1:##606df1:##3c59cd>Disenchant"
            set {_enchant} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchant"
            set {_craft} to mini message from "<gradient:#ab4984:#7f40c7>Craft an Item"
            set {_rune} to mini message from "<gradient:#e84a72:#e84aa9>Engrave a Rune"

            loop 28 times:
                set slot (loop-number - 1) of {_menu} to (black stained glass pane named " ")

            set slot 10 of {_menu} to (enchanting table named {_craft}) with lore ("&7Click here to craft an Item.")
            set slot 12 of {_menu} to (glowstone dust named {_disenchant}) with lore ("&7Click here to &f✨ Disenchant%nl%&7a Card or Gear item.") with nbt from ("{""minecraft:custom_model_data"":{floats:[15.0f]}}")
            set slot 14 of {_menu} to (glowstone dust named {_enchant}) with lore ("&7Click here to &f✨ Enchant%nl%&7a Gear ot Tool item.") with nbt from ("{""minecraft:custom_model_data"":{floats:[1.0f]}}")
            set slot 16 of {_menu} to (burn pottery sherd named {_rune}) with lore ("&7Click here to engrave a%nl%&f✨ Rune &7onto a Gear item.")
            
            set slot 19 of {_menu} to (purple stained glass pane named " ")
            set slot 21 of {_menu} to (light blue stained glass pane named " ")
            set slot 23 of {_menu} to (pink stained glass pane named " ")
            set slot 25 of {_menu} to (red stained glass pane named " ")

            set boolean tag "Craft" of (custom nbt of (slot 10 of {_menu})) to true
            set boolean tag "Disenchant" of (custom nbt of (slot 12 of {_menu})) to true
            set boolean tag "Enchant" of (custom nbt of (slot 14 of {_menu})) to true
            set boolean tag "Rune" of (custom nbt of (slot 16 of {_menu})) to true
            open {_menu} to player
        else:
            send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>You must know the <#bf8cfa>✨ Enchanting Profession <white>to interact with this block." to player 
            play sound "block.chest.close" with volume 1 and pitch 0 to player

function disenchantMenu(p: player):
    play sound "minecraft:block.enchantment_table.use" with volume 4 and pitch 1.5 to {_p}
    set (metadata tag "EnchantingTable-Disenchant" of {_p}) to (chest inventory with 3 rows named "Enchanting Table - Disenchant")
    set {_menu} to (metadata tag "EnchantingTable-Disenchant" of {_p})
    loop 28 times:
        set (slot (loop-number - 1) of {_menu}) to (black stained glass pane named " ")
    set slot 12 of {_menu} to (purple stained glass pane named "<#bf8cfa>Place Item Here") with lore ("&7Place an item over this slot%nl%&7to prepare a &f✨ Disenchant &7action.")
    set {_cardDust} to yaml value "Card Dust.Item" in "ItemList"
    set {_lore} to "&7Click here to &f✨ Disenchant &7the placed item.%nl% %nl%&fDisenchanting Cards:%nl%&7Grants &f1 Player EXP &7per %name of {_cardDust}% &7obtained.%nl% %nl%&fDisenchanting Gear:%nl%&7Grants &fPlayer EXP &7based on item Rarity and%nl%&7Item Level.%nl% %nl%&c&lWARNING:%nl%&cThis action will consume the item in the process."
    set slot 14 of {_menu} to (glowing (bottle o' enchanting named "<#f536cb>Disenchant")) with lore ({_lore})
    set boolean tag "PlaceItem" of (custom nbt of (slot 12 of {_menu})) to true
    set boolean tag "DisenchantItem" of (custom nbt of (slot 14 of {_menu})) to true
    open {_menu} to {_p}

on rightclick:
    if player's tool is rabbit hide:
        set {_p} to player
        clear yaml value "Professions.Enchanting" in "data-%{_p}%"
        set yaml value "Professions.Enchanting.Level" in "data-%{_p}%" to 0
        set yaml value "Professions.Enchanting.Exp" in "data-%{_p}%" to 0

        save yaml "data-%{_p}%"
    if player's tool is gold nugget:
        save yaml "data-%player%"
        if yaml "EnchantingProfessionList" is loaded:
            addEnchantingExp(player, 400, 1)
        stop
        #set {_item} to Gear("Ring of Forbidden Techniques", "Ring", 120, "Epic", "Intellect", "Siege of Spawn")
       # give {_item} to player
        set {_item2} to Gear("Vision of the Serpent", "Helmet", 50, "Common", "Intellect", "Forest")
        set {_item3} to Gear("Nature's Curtain", "Helmet", 70, "Rare", "Intellect", "Forest")
        #broadcast {_item}
        give {_item2} and {_item3} to player
        stop
        set string tag "Enchant;Name" of (custom nbt of player's tool) to "Atticus's Wisdom"
        set int tag "Enchant;Rank" of (custom nbt of player's tool) to 1
        set int tag "Enchant;Stats;Mastery" of (custom nbt of player's tool) to 4
        set lore of player's tool to GearLoreUpdate(player's tool)
        
        clear string list tag "Runes" of (custom nbt of player's tool)
        set string tag "Runes;Core Intensity;Card" of (custom nbt of player's tool) to "Ghazan"
        set double tag "Runes;Core Intensity;Value" of (custom nbt of player's tool) to 1.3
        set double tag "Runes;Core Intensity;Runic Power" of (custom nbt of player's tool) to 100
        #set string list tag "Runes" of (custom nbt of player's tool) to "Igneous Flow"
        stop
        #give player enchanted book named "<#aa56db>Enchanting Scroll - Atticus's Wisdom" with lore ("<#f536cb>Gear Enchant%nl%&7Imbues a gear slot with the &fAtticus's Wisdom%nl%&f✨ Enchant&7, increasing <#f53b98> Mastery &7by &f4&7.%nl% %nl%&6&o'Atticus forgot more about magic than most%nl%&6&owill ever learn.'%nl% %nl%&7Quality: <#6b492e>★"
        set {_flavourText::*} to "&6&o'The weight of the world, held in your palm.'", "&6&o'Chaos, contained within a single sigil.'", "&6&o'An ancient echo trapped in etched stone.'" and "&6&o'The deeper the carving, the louder the magic.'"
        set {_flavourText} to a random element of {_flavourText::*} 
        give player (burn pottery sherd named "<#b03228>Rune: &kGhazan") with lore ("<#9a38ab>🌀 Gear Rune%nl%&7Used by &f✨ Enchanters &7to infuse Gear with runic%nl%&7power. Can be engraved onto any Gear to provide%nl%&7a minor boost to an Ability for its matching Card.%nl%&7The potency of each &fRune &7is determined randomly.%nl% %nl%&8» &7Card: <#b03228>Ghazan%nl%&8» &7Effect: &f1.3%%  <#b03228>Lava Burst &7damage%nl% %nl%  <#9a38ab>* Runic Power: &f100%%%nl% %nl%%{_flavourText}%")
        

on inventory click:
    if event-inventory = (metadata tag "EnchantingLearn" of player):
        cancel event
        if (boolean tag "LearnEnchanting" of (custom nbt of clicked slot)):
            learnEnchanting(player)
            close player's inventory
            clear metadata tag "EnchantingLearn" of player

    else if event-inventory = (metadata tag "EnchantingMenu" of player):
        cancel event
        if event-slot != air:
            if event-slot != black stained glass pane:
                close player's inventory

        if (boolean tag "EnchantingLevel" of (custom nbt of clicked slot)):
            set (metadata tag "EnchantingMenuCurrentPage" of player) to 1
            openEnchantingLevelMenu(player)

        else if (boolean tag "EnchantingBuyItems" of (custom nbt of clicked slot)):
            openEnchantingPurchaseMenu(player)

        else if (boolean tag "EnchantingRecipes" of (custom nbt of clicked slot)):
            openEnchantingRecipeMenu(player)

    else if event-inventory = (metadata tag "EnchantingMenu-Level" of player):
        cancel event
        if (boolean tag "NextPage" of (custom nbt of clicked slot)):
            add 1 to (metadata tag "EnchantingMenuCurrentPage" of player)
            enchantingMenuPage(player, (metadata tag "EnchantingMenu-Level" of player))
        else if (boolean tag "PreviousPage" of (custom nbt of clicked slot)):
            remove 1 from (metadata tag "EnchantingMenuCurrentPage" of player)
            enchantingMenuPage(player, (metadata tag "EnchantingMenu-Level" of player))

    else if event-inventory = (metadata tag "EnchantingTable" of player):
        cancel event
        if (boolean tag "Disenchant" of (custom nbt of clicked slot)):
            disenchantMenu(player)
    else if event-inventory = (metadata tag "EnchantingTable-Disenchant" of player):
        cancel event
        if (boolean tag "PlaceItem" of (custom nbt of clicked slot)):
            set {_placedItem} to cursor slot of player
            if {_placedItem} != air:
                if (boolean tag "Disenchantable" of (custom nbt of {_placedItem})):
                    set (cursor slot of player) to air
                    set event-slot to {_placedItem}
                    play sound "item.book.page_turn" with volume 0.8 and pitch 0.9 at player for player
                    play sound "entity.ender_eye.death" with volume 0.3 and pitch 1.8 at player for player
                else:
                    play sound "entity.villager.no" with volume 1 and pitch 0.8 to player

        else if (boolean tag "DisenchantItem" of (custom nbt of clicked slot)):
            set {_placedItem} to slot 12 of event-inventory
            if not (boolean tag "PlaceItem" of (custom nbt of {_placedItem})):
                if (boolean tag "Disenchantable" of (custom nbt of {_placedItem})):
                    disenchantItem(player, {_placedItem})
    else if event-inventory = (metadata tag "EnchantingMenu-Recipes" of player):
        cancel event
        set {_recipeName} to uncoloured name of event-slot
        replace all "★ " and "★" in {_recipeName} with ""
        if yaml value "Professions.Enchanting.Unlocked Recipes.%{_recipeName}%.Purchased" in "data-%player%" != true:
            set {_items::*} to nbt tags of (compound tag "Price" of (custom nbt of event-slot))
            broadcast custom nbt of nbt of event-slot
            loop {_items::*}:
                set {_amountReq} to int tag "Price;%loop-value%" of (custom nbt of event-slot)
                set {_item} to yaml value "%loop-value%.Item" in "ItemList"
                
                add ({_amountReq} of {_item}) to {_requirements::*}
                add (type of {_item}) to {_itemTypes::*}

                if player has {_amountReq} of {_item}:
                    set {_checkTrue} to {_checkTrue} + 1

            if {_checkTrue} = (size of {_items::*}):
                remove {_requirements::*} from the inventory of player
                set {_message} to yaml value "Messages.Purchase Recipe" in "EnchantingProfessionList"

                set {_colour} to hex code of (first string colour of (name of event-slot))
                replace all "{NAME}" in {_message} with "<#%{_colour}%>%name of event-slot%"

                send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>%{_message}%" to player

                learnEnchantingRecipe(player, {_recipeName})
                playLearnEnchantingRecipe(player, {_itemTypes::*})
                close player's inventory
            else:
                set {_message} to yaml value "Messages.Not Enough Currency Recipe" in "EnchantingProfessionList"
                send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <red>%{_message}%" to player
                play sound "entity.villager.no" with volume 1 and pitch 1 to player
        
        if event-slot is not air:
            play sound "item.book.page_turn" with volume 0.8 and pitch 1.74 at player for player
    else if event-inventory = (metadata tag "EnchantingMenu-Purchase" of player):
        cancel event
        if event-slot is not air:
            set (metadata tag "EnchantingMenu-Purchase-Clicked Item" of player) to event-slot
            sliderShopDialog(player)
            play sound "item.book.page_turn" with volume 0.8 and pitch 1.74 at player for player

function sliderShopDialog(p: player):
    open new multi action dialog to {_p}:
        title: "Choose amount"
        inputs:
            add number range input:
                key: "purchaseAmount"
                label: "Amount"
                start: 1
                end: 500
                initial: 1
                step: 1
        actions:
            add callback action button:
                label: "Purchase"
                width: 150
                trigger:
                    set {_amount} to float tag "purchaseAmount" of event-nbt
                    
                    if {_amount} <= 0:
                        send "&cThe amount entered is invalid." to {_p}
                        stop
                    
                    else:
                        set {_clickedItem} to metadata tag "EnchantingMenu-Purchase-Clicked Item" of {_p}
                        set {_itemName} to uncoloured name of {_clickedItem}

                        set {_items::*} to nbt tags of (compound tag "Price" of (custom nbt of {_clickedItem}))
                        
                        loop {_items::*}:
                            set {_amountReq} to int tag "Price;%loop-value%" of (custom nbt of {_clickedItem})
                            set {_item} to yaml value "%loop-value%.Item" in "ItemList"
                            
                            set {_totalAmountRequired} to {_amountReq} * {_amount}
                            add ({_totalAmountRequired} of {_item}) to {_requirements::*}
                            
                            set {_colour} to hex code of (first string colour of (name of {_item}))
                            set {_itemAmountsString::%loop-value%} to "<white>%{_totalAmountRequired}%x <#%{_colour}%>%loop-value%</#%{_colour}%>"

                            if {_p} has {_totalAmountRequired} of {_item}:
                                set {_checkTrue} to {_checkTrue} + 1

                        if {_checkTrue} = (size of {_items::*}):
                            remove {_requirements::*} from the inventory of {_p}
                            set {_message} to yaml value "Messages.Purchase Item" in "EnchantingProfessionList"

                            set {_colour} to hex code of (first string colour of (name of {_clickedItem}))
                            replace all "{NAME}" in {_message} with "<#%{_colour}%>%name of {_clickedItem}%"
                            replace all "{AMOUNT}" in {_message} with "%{_amount}%"
                            
                            set {_priceString} to join {_itemAmountsString::*} by " <white>& "
                            replace all "{PRICE}" in {_message} with {_priceString}

                            set {_purchasedItem} to yaml value "%{_itemName}%.Item" in "ItemList"
                            give {_p} {_amount} of {_purchasedItem}

                            send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>%{_message}%" to {_p}

                            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1 to {_p}
                            play sound "entity.chicken.egg" with volume 1 and pitch 1.21 to {_p}

                            set {_itemsPurchased} to "Statistics.Professions.Enchanting.Purchased Items"
                            addToYaml({_amount}, "data-%{_p}%", "%{_recipesLearned}%.Total")
                            addToYaml({_amount}, "data-%{_p}%", "%{_recipesLearned}%.%{_itemName}%")

                            save yaml "data-%{_p}%"

                        else:
                            set {_message} to yaml value "Messages.Not Enough Currency" in "EnchantingProfessionList"
                            send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <red>%{_message}%" to {_p}
                            play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}

                        clear metadata tag "EnchantingMenu-Purchase-Clicked Item" of {_p}

            add static action button:
                label: "&cExit"
                width: 50
on inventory close:
    if event-inventory = (metadata tag "EnchantingTable-Disenchant" of player):
        if not (boolean tag "PlaceItem" of (custom nbt of (slot 12 of event-inventory))):
            giveItem(player, slot 12 of event-inventory)
            play sound "entity.chicken.egg" with volume 3 and pitch 1 to player

function openEnchantingRecipeMenu(p: player):
    set (metadata tag "EnchantingMenu-Recipes" of {_p}) to (a chest inventory with 6 rows named "Enchanting Menu - Recipes")
    set {_enchantingMenu} to metadata tag "EnchantingMenu-Recipes" of {_p}

    set {_baseSlot} to 0
    set {_recipes::*} to yaml node keys "Recipes" in "EnchantingProfessionList"

    play sound "item.book.page_turn" with volume 0.8 and pitch 0.9 at {_p} for {_p}

    loop (size of {_recipes::*}) times:
        set {_itemName} to {_recipes::%loop-counter%}
        
        set {_recipeType} to yaml value "Recipes.%{_itemName}%.Type" in "EnchantingProfessionList"

        if {_itemName} does not contain " | ":
            set {_item} to yaml value "%{_itemName}%.Item" in "ItemList"
        else:
            set {_itemName::*} to {_itemName} split at " | "
            set {_itemNameFormatted} to {_itemName::1}

            set {_enchantTier} to {_itemName::2}
            set {_numeralEnchantTier} to roman numeral {_enchantTier} as number

            set {_tierColour} to yaml value "Rank Colours.%{_numeralEnchantTier}%" in "GearList"

            set {_enchantRank} to yaml value "Professions.Enchanting.Unlocked Recipes.%{_itemName}%.Rank" in "data-%{_p}%"
            set {_maxRanks} to yaml value "Max Values.Ranks" in "EnchantingProfessionList"
            set {_starString} to ""

            if {_enchantRank} is not set:
                set {_enchantRank} to 1
            
            set {_starsRank} to ("&e★" repeated {_enchantRank} times)
            set {_starString} to "%{_starString}%%{_starsRank}%"
            
            if ({_maxRanks}-{_enchantRank}) > 0:
                set {_starsRankGrey} to ("&8★" repeated ({_maxRanks}-{_enchantRank}) times)
                set {_starString} to "%{_starString}%%{_starsRankGrey}%"

            set {_enchantColour} to yaml value "Enchants.%{_recipeType}% Colour" in "EnchantingProfessionList"
            set {_enchantName} to formatted "%{_starString}% %{_enchantColour}%%{_itemName}%"
            set {_enchantValue} to yaml value "Enchants.%{_recipeType}%.%{_itemNameFormatted}%.Tiers.%{_enchantTier}%.Value" in "EnchantingProfessionList"
            set {_enchantDesc} to yaml value "Enchants.%{_recipeType}%.%{_itemNameFormatted}%.Description" in "EnchantingProfessionList"
            
            replace all "{VALUE}" in {_enchantDesc} with "%{_enchantValue}%"
            replace all "{NL}" in {_enchantDesc} with nl

            set {_starsTier} to ("★" repeated {_numeralEnchantTier} times)
            set {_enchantDesc} to formatted ("%{_enchantDesc}%%nl% %nl%&7Quality: %{_tierColour}%%{_starsTier}%")

            loop {_maxRanks} times:
                set {_rank} to loop-number-2
                set {_starsTooltip} to "&e★" repeated {_rank} times

                set {_remainingRanks} to ({_maxRanks}-{_rank})
                if {_remainingRanks} > 0:
                    set {_remainingStars} to "&8★" repeated {_remainingRanks} times
                    set {_starsTooltip} to "%{_starsTooltip}%%{_remainingStars}%"

                set {_rankName} to "<#00FFFF>Rank %{_rank}%: %{_starsTooltip}%"
                set {_rankTooltip} to formatted (yaml value "Enchants.Rank Tooltip.%{_rank}%" in "EnchantingProfessionList")

                replace all "{NL}" in {_rankTooltip} with nl

                set {_rankSource} to yaml value "Enchants.%{_recipeType}%.%{_itemNameFormatted}%.Ranks.%{_rank}%.Source" in "EnchantingProfessionList"
                set {_rankSource} to "  &fSource: %{_rankSource}%"

                if {_rank} > {_enchantRank}:
                    replace all "<#fdd002>" in {_rankTooltip} with "&8"
                    replace all "<#00FFFF>" in {_rankName} with "&8"
                    replace all "&f" in {_rankSource} with "&8"

                set {_enchantDesc} to "%{_enchantDesc}%%nl% %nl%%{_rankName}%%nl%%{_rankTooltip}%%nl%%{_rankSource}%"

            set {_item} to enchanted book named {_enchantName} with lore {_enchantDesc}

        add "%nl%&7Materials Required:%nl%" to lore of {_item}

        set {_materialAmount} to size of (yaml node keys "Recipes.%{_itemName}%.Items" in "EnchantingProfessionList")
        loop {_materialAmount} times:
            set {_materialName} to yaml value "Recipes.%{_itemName}%.Items.%loop-counter-2%.Name" in "EnchantingProfessionList"
            set {_materialAmount} to yaml value "Recipes.%{_itemName}%.Items.%loop-counter-2%.Amount" in "EnchantingProfessionList"
            
            if {_enchantRank} > 1:
                if {_itemName} contains " | ": 
                    set {_costReduction} to yaml value "Enchants.Rank Cost Reduction.%{_enchantRank}%" in "EnchantingProfessionList"
                    set {_materialAmount} to (rounded up ({_materialAmount}*(1-({_costReduction}/100))))

            set {_materialItem} to (yaml value "%{_materialName}%.Item" in "ItemList")
            set {_materialNameColoured} to name of {_materialItem}

            add "&f- %{_materialAmount}%x %{_materialNameColoured}%" to lore of {_item}
        
        if yaml value "Recipes.%{_itemName}%.Unlocked" in "EnchantingProfessionList" = false:

            if yaml value "Professions.Enchanting.Unlocked Recipes.%{_itemName}%.Purchased" in "data-%{_p}%" = true:
                add "%nl%&a✔ Unlocked" to lore of {_item}
            else:
                add "%nl%&7Purchase cost:" to lore of {_item}
                loop yaml node keys "Recipes.%{_itemName}%.Purchase Price" in "EnchantingProfessionList":
                    set {_currency} to loop-value-2
                    set {_currencyAmount} to yaml value "Recipes.%{_itemName}%.Purchase Price.%{_currency}%" in "EnchantingProfessionList"
                    set {_currencyItem} to yaml value "%{_currency}%.Item" in "ItemList"
                    set {_currencyItemName} to name of {_currencyItem}

                    add "&f- %{_currencyAmount}%x %{_currencyItemName}%" to lore of {_item}
                    
                    set int tag "Price;%{_currency}%" of (custom nbt of {_item}) to {_currencyAmount}
                
                if yaml value "Professions.Enchanting.Unlocked Recipes.%{_itemName}%" in "data-%{_p}%" is set:
                    add "%nl%&eClick here to purchase recipe." to lore of {_item}
                else:
                    add "%nl%&c✘ Not unlocked." to lore of {_item}
                
        else:
            add "%nl%&a✔ Unlocked" to lore of {_item}

        set slot (loop-counter - 1) of {_enchantingMenu} to {_item}

    set slots (integers between 45 and 53) of {_enchantingMenu} to (black stained glass pane named " ")
    set {_item} to guster banner pattern
    

    set slot 49 of {_enchantingMenu} to (barrier named "&cExit") with lore ("&7Click here to exit the menu.")
    set slot 53 of {_enchantingMenu} to (arrow named "&fNext Page") with lore ("&7Click here to jump to the next page.")

    set boolean tag "NextPage" of (custom nbt of slot 53 of {_enchantingMenu}) to true

    open {_enchantingMenu} to {_p}

function disenchantItem(p: player, item: item):
    set {_disenchantingExp} to "Statistics.Experience.Professions.Enchanting.Disenchanting"
    set {_disenchantedItems} to "Statistics.Professions.Enchanting.Disenchanting.Disenchanted Items"
    set {_disenchantingObtained} to "Statistics.Professions.Enchanting.Disenchanting.Items Obtained"
    set {_itemName} to name of {_item}
    set {_colour} to hex code of (first string colour of {_itemName})
    set {_colourReward} to hex code of (first string colour of "<#bf8cfa>")

    set {_rarity} to (string tag "Rarity" of (custom nbt of {_item}))
    set {_itemAmount} to item amount of {_item}

    if (boolean tag "BoosterCard" of (custom nbt of {_item})):
        set {_element} to (string tag "Element" of (custom nbt of {_item}))
        set {_booster} to (string tag "Booster" of (custom nbt of {_item}))

        set {_cardDustAmount} to yaml value "Disenchanting.Cards.%{_rarity}%" in "EnchantingProfessionList"
        
        set {_dropAmount} to {_itemAmount}*{_cardDustAmount}

        set {_expModifier} to 1

        set {_playerExp} to {_dropAmount}
        set {_expAmount} to addPlayerXP({_p}, {_playerExp}, {_expModifier}, "Disenchanting")

        set {_cardDust} to yaml value "Card Dust.Item" in "ItemList"

        giveItem({_p}, ({_dropAmount} of {_cardDust}))

        set {_rewardNames::*} to {_rewardNames::*} and "<#%{_colourReward}%>%{_dropAmount}% <gradient:#d6ff94:#70ffa1:#606df1:#3c59cd>Card Dust"
        
        #Stats: Experience from Disenchanting
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Cards.Total")
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Cards.Rarity.%{_rarity}%")
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Cards.Element.%{_element}%")
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Cards.Booster.%{_booster}%")
        
        #Professions - enchanting - disenchanting
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Cards.Total")
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Cards.Rarity.%{_rarity}%")
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Cards.Element.%{_element}%")
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Cards.Booster.%{_booster}%")
        
        addToYaml({_dropAmount}, "data-%{_p}%", "%{_disenchantingObtained}%.Card Dust")

    else if (boolean tag "GearItem" of (custom nbt of {_item})):
        set {_itemLevel} to (int tag "ItemLevel" of (custom nbt of {_item}))
        set {_source} to (string tag "Source" of (custom nbt of {_item}))
        set {_gearSlot} to (string tag "GearSlot" of (custom nbt of {_item}))

        set {_dropAmount} to 1

        set {_expModifier} to 1

        set {_disenchantItemType} to yaml value "Disenchanting.Gear.%{_rarity}%.Material" in "EnchantingProfessionList"
        set {_rarityModifier} to yaml value "Disenchanting.Gear.%{_rarity}%.Modifier" in "EnchantingProfessionList"

        set {_playerExp} to {_itemLevel}*{_rarityModifier}
        set {_expAmount} to addPlayerXP({_p}, {_playerExp}, {_expModifier}, "Disenchanting")

        set {_disenchantItem} to yaml value "%{_disenchantItemType}%.Item" in "ItemList"
        set {_disenchantItemName} to name of {_disenchantItem}
        set {_colourMaterial} to hex code of (first string colour of {_disenchantItemName})

        set {_rewardNames::*} to {_rewardNames::*} and "<#%{_colourReward}%>%{_dropAmount}% <#%{_colourMaterial}%>%{_disenchantItemName}%"

        giveItem({_p}, ({_dropAmount} of {_disenchantItem}))

        playGearDisenchantSound({_p}, {_dropAmount})

        #Stats: Experience from Disenchanting
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Gear.Total")
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Gear.Rarity.%{_rarity}%")
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Gear.Source.%{_source}%")
        addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Gear.Gear Slot.%{_gearSlot}%")
        
        #Professions - enchanting - disenchanting
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Gear.Total")
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Gear.Rarity.%{_rarity}%")
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Gear.Source.%{_source}%")
        addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Gear.Gear Slot.%{_gearSlot}%")
        
        addToYaml({_dropAmount}, "data-%{_p}%", "%{_disenchantingObtained}%.%{_disenchantItemType}%")

    set {_menu} to (metadata tag "EnchantingTable-Disenchant" of {_p})
    set slot 12 of {_menu} to (purple stained glass pane named "<#bf8cfa>Place Item Here") with lore ("&7Place an item over this slot%nl%&7to prepare a &f✨ Disenchant &7action.")
    set boolean tag "PlaceItem" of (custom nbt of slot 12 of {_menu}) to true

    remove {_expAmount} from {exp::%{_p}%}

    set {_rewards} to join {_rewardNames::*} by " <white>& "

    set {_string} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>You disenchanted <#bf8cfa>%{_itemAmount}%x <#%{_colour}%>%{_itemName}% <white>and received %{_rewards}%<white>."
    send {_string} to {_p}
    send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>You receive <#bf8cfa>%{_expAmount}% <white>EXP." to {_p}

    addToYaml({_expAmount}, "data-%{_p}%", "Statistics.Experience.Total")
    addToYaml({_expAmount}, "data-%{_p}%", "Statistics.Experience.Professions.Enchanting.Total")

    addToYaml({_expAmount}, "data-%{_p}%", "%{_disenchantingExp}%.Total")
    addToYaml({_itemAmount}, "data-%{_p}%", "%{_disenchantedItems}%.Total")

    playDisenchantSound({_p})

    save yaml "data-%{_p}%"

function getEnchantingLevel(p: player) :: integer:
    set {_enchantingLevel} to yaml value "Professions.Enchanting.Level" in "data-%{_p}%"

    return {_enchantingLevel}

function getEnchantingExp(p: player) :: integer:
    set {_enchantingExp} to yaml value "Professions.Enchanting.Exp" in "data-%{_p}%"

    return {_enchantingExp}

function addEnchantingExp(p: player, exp: number, modifier: number = 1):
    set {_exp} to {_exp}*{_modifier}

    set {_enchantingLevel} to yaml value "Professions.Enchanting.Level" in "data-%{_p}%"
    set {_enchantingExp} to yaml value "Professions.Enchanting.Exp" in "data-%{_p}%"

    set {_enchantingExp} to {_enchantingExp} + {_exp}

    set {_expPerLevel} to yaml value "Experience Requirement" in "EnchantingProfessionList"
    
    while {_enchantingExp} >= (({_enchantingLevel}+1)*{_expPerLevel}):
        remove (({_enchantingLevel}+1)*{_expPerLevel}) from {_enchantingExp}

        set {_enchantingLevel} to {_enchantingLevel} + 1

        #ADD ACHIEVEMENT HERE
        loop all players:
            if loop-player is not {_p}:
                send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <#bf8cfa>%{_p}% <white>reached <#bf8cfa>✨ Enchanting Level %{_enchantingLevel}%<white>!" to loop-player
            else:
                send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>Congratulations! You reached <#bf8cfa>✨ Enchanting Level %{_enchantingLevel}%<white>!" to loop-player
        
        set {_allLevelReward} to yaml value "Enchanting.Rewards.All Levels.Description" in "EnchantingProfessionList"
        set {_allLevelRewardAmount} to yaml value "Enchanting.Rewards.All Levels.Amount" in "EnchantingProfessionList"
        set {_allLevelRewardApexLevel} to yaml value "Enchanting.Rewards.All Levels.Apex Level" in "EnchantingProfessionList"
        set {_allLevelRewardApexAmount} to yaml value "Enchanting.Rewards.All Levels.Apex Amount" in "EnchantingProfessionList"

        if {_enchantingLevel} = {_allLevelRewardApexLevel}:
            set {_expIncrease} to {_allLevelRewardApexAmount}
        else:
            set {_expIncrease} to {_allLevelRewardAmount}

        set {_levelsWithApexIncrease} to (rounded down ({_enchantingLevel}/{_allLevelRewardApexLevel}))*{_allLevelRewardApexAmount}
        set {_excludeLevelsOnApex} to (rounded down ({_enchantingLevel}/{_allLevelRewardApexLevel}))* {_allLevelRewardAmount}
        set {_totalIncrease} to ({_enchantingLevel}*{_allLevelRewardAmount}) + ({_levelsWithApexIncrease} - {_excludeLevelsOnApex})
        
        set {_expMessage} to yaml value "Messages.Rewards.Exp Increase" in "EnchantingProfessionList"
        replace all "{AMOUNT}" in {_expMessage} with "%{_expIncrease}%"
        
        send mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>%{_expMessage}%<white>. (Total: +%{_totalIncrease}%%%)" to {_p}

        set yaml value "Professions.Enchanting.Exp Modifier" in "data-%{_p}%" to {_totalIncrease}

        set {_rewardType} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Type" in "EnchantingProfessionList"
        set {_rewardItemType} to  yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Item Type" in "EnchantingProfessionList"

        if {_rewardType} is set:
            set {_rewardName} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Name" in "EnchantingProfessionList"
            set {_rewardMessage} to yaml value "Messages.Rewards.%{_rewardType}%" in "EnchantingProfessionList"
            
            set {_rewardDescription} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Description" in "EnchantingProfessionList"
            replace all "{NL}" in {_rewardDescription} with nl

            if (yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Gradient" in "EnchantingProfessionList") is set:
                set {_gradient} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Gradient" in "EnchantingProfessionList"

                replace all "{GRADIENT}" in {_rewardName} with {_gradient}
                replace all "{/GRADIENT}" in {_rewardName} with "</gradient>"

                replace all "{GRADIENT}" in {_rewardDescription} with {_gradient}
                replace all "{/GRADIENT}" in {_rewardDescription} with "</gradient>"

                set {_rewardName} to mini message from {_rewardName}
                set {_rewardDescription} to mini message from {_rewardDescription}

            if yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Rank" in "EnchantingProfessionList" is set:
                set {_rewardUnformattedName} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Reward Name" in "EnchantingProfessionList"

                set {_tier} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Tier" in "EnchantingProfessionList"
                set {_value} to yaml value "Enchants.%{_rewardItemType}%.%{_rewardUnformattedName}%.Tiers.%{_tier}%.Value" in "EnchantingProfessionList"

                set yaml value "Professions.Enchanting.Unlocked Recipes.%{_rewardUnformattedName}% | %{_tier}%.Rank" in "data-%{_p}%" to 1
                set yaml value "Professions.Enchanting.Unlocked Recipes.%{_rewardUnformattedName}% | %{_tier}%.Purchased" in "data-%{_p}%" to false

                replace all "{VALUE}" in {_rewardDescription} with "%{_value}%"

            else:
                if {_rewardType} = "Recipe":
                    set yaml value "Professions.Enchanting.Unlocked Recipes.%(unformatted {_rewardName})%.Purchased" in "data-%{_p}%" to false

                else if {_rewardType} = "Enchant Knowledge":
                    set {_knowledge} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Knowledge" in "EnchantingProfessionList"
                    add {_knowledge} to (yaml list "Professions.Enchanting.Enchant Knowledge" in "data-%{_p}%")

                else if {_rewardType} = "Disenchant Knowledge":
                    set {_dknowledge} to yaml value "Enchanting.Rewards.Level %{_enchantingLevel}%.Reward.Knowledge" in "EnchantingProfessionList"
                    add {_dknowledge} to (yaml list "Professions.Enchanting.Disenchant Knowledge" in "data-%{_p}%")
            
            replace all "{REWARD}" in {_rewardMessage} with "<tooltip:%{_rewardDescription}%>%{_rewardName}%&f"

            set {_rewardString} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>>"
            send formatted "%{_rewardString}% &f%{_rewardMessage}%" to {_p} 
        
        learnEnchantingEffect({_p})

        play sound "ui.toast.challenge_complete" with volume 2 and pitch 1.5 at (location of {_p})
        spawn fake lightning at {_p} for all players

    set yaml value "Professions.Enchanting.Level" in "data-%{_p}%" to {_enchantingLevel}
    set yaml value "Professions.Enchanting.Exp" in "data-%{_p}%" to {_enchantingExp}

    save yaml "data-%{_p}%"
    
function playGearDisenchantSound(p: player, count: integer):
    loop {_count} times:
        play sound "profession.gem.pick_up" with volume 1 and pitch 1 to {_p}
        play sound "profession.gem.put_down" with volume 1 and pitch 1 to {_p}
        wait 2 ticks

function playDisenchantSound(p: player):
    play sound "entity.player.levelup" with volume 1 and pitch 0 to {_p}
    play sound "block.amethyst_block.chime" with volume 0.5 and pitch 1.6 at {_p} for {_p}
    play sound "block.amethyst_block.chime" with volume 0.5 and pitch 0.7 at {_p} for {_p}
    play sound "block.glass.break" with volume 0.5 and pitch 0.7 at {_p} for {_p}
    play sound "block.glass.break" with volume 0.5 and pitch 1.6 at {_p} for {_p}

function playEnchantMenuSound(p: player):
    play sound "block.enchantment_table.use" with volume 0.7 and pitch 0.6 at {_p} for {_p}
    play sound "block.enchantment_table.use" with volume 0.7 and pitch 1.05 at {_p} for {_p}
    play sound "block.amethyst_block.chime" with volume 0.5 and pitch 1.2 at {_p} for {_p}
    play sound "item.book.page_turn" with volume 0.8 and pitch 0.9 at {_p} for {_p}
    play sound "entity.ender_eye.death" with volume 0.3 and pitch 1.8 at {_p} for {_p}

function knowsProfession(p: player, profession: text) :: boolean:
    if (yaml list "Professions.Learned Professions" in "data-%{_p}%") contains {_profession}:
        set {_bool} to true
    else:
        set {_bool} to false

    return {_bool}

function learnEnchanting(p: player):
    if not knowsProfession({_p}, "Enchanting"):
        add "Enchanting" to (yaml list "Professions.Learned Professions" in "data-%{_p}%")
        set yaml value "Professions.Enchanting.Exp" in "data-%{_p}%" to 0
        set yaml value "Professions.Enchanting.Level" in "data-%{_p}%" to 0
        save yaml "data-%{_p}%"
        set {_string} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting</gradient> <#555555>>> <white>You have learned the <white>✨ Enchanting profession!"
        send {_string} to {_p}
        learnEnchantingEffect({_p})
        enchantingContentUnlocked({_p})

function learnEnchantingEffect(p: player):
    play sound "block.enchantment_table.use" with volume 1 and pitch 0.8 at {_p} for {_p}
    play sound "entity.illusioner.prepare_mirror" with volume 1 and pitch 1.2 at {_p} for {_p}
    
    set {_ring} to (a circle with radius 1.5)
    set (particle of {_ring}) to portal particle
    set (particle count of {_ring}) to 25
        
    loop 20 times:
        draw shape {_ring} at (location above {_p})
        set (radius of {_ring}) to (1.5 - (loop-value * 0.075))
        wait 1 tick
        
    play sound "entity.player.levelup" with volume 1 and pitch 1.5 at {_p} for {_p}
    play sound "entity.ender_eye.death" with volume 1 and pitch 0.5 at {_p} for {_p}
    
    loop 2 times:
        draw 15 of (((witch particle) with an extra value of 0.05) with offset vector(0.5, 0.5, 0.5)) at (location above {_p})
        draw 30 of (((ender eye item particle) with an extra value of 0.05) with offset vector(0.5, 0.5, 0.5)) at (location above {_p})
        wait 3 ticks

on break of enchanting table:
    if {enchanterstable::%event-block%} is true:
        cancel event
        if "%region at player%" is not "Spawn":
            set event-block to air
            drop {enchanterstable} at event-block
        clear {enchanterstable::%event-block%}

on place of enchanting table:
    if (player's held item) = ((item amount of player's held item) of {enchanterstable}):
        set {enchanterstable::%event-block%} to true