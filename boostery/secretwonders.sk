on load:
	set {_desc} to "&7&o''Hidden for generations, ancient wonders and mysterious creatures are emerging to reshape the world around you. Begin your journey into a world of endless discovery and master the hidden potentials of these forgotten legends. Step into the unknown and start your collection today!''"
	set {_desc} to join wrapText({_desc}, 50) by "%nl%&7&o"
	set {boostersecretwonders} to glass pane of unbreaking 10 named "&5Secret Wonders &9Booster" with lore "&9Booster%nl%&7Booster containing one or more cards.%nl%&7Contains exclusive cards from this set.%nl% %nl%%{_desc}%" with nbt from "{""minecraft:custom_data"":{""BoosterName"":""Secret Wonders"",""CardBooster"":1b}}"
	
	set {espeonkartasw} to magenta stained glass pane named "<##d48bc3>Espeon" with lore "&7Psychic" and "&7Level: &f0 &7| &7Exp: &f0%nl%&7Statistics:%nl%&7Intellect: &7■■■■■■■■■■ &7(<##59c1e3>0&7)%nl%&7Health: <##c0ff02>&7■■■■■■■■■■ &7(<##c0ff02>0&7)%nl%&7Damage: <##f74428>&7■■■■■■■■■■ &7(<##f74428>0&7)%nl%&7Resistance: <##ffef45>&7■■■■■■■■■■ &7(<##ffef45>0&7)%nl%&7Mobility: &f&7■■■■■■■■■■ &7(&f0&7)%nl%&7Utility: <##ae78d0>&7■■■■■■■■■■ &7(<##ae78d0>0&7)%nl%&7Crowd Control: <##58c3f5>&7■■■■■■■■■■ &7(<##58c3f5>0&7)%nl%&7Versatility: <##e3ebff>&7■■■■■■■■■■ &7(<##e3ebff>0&7)%nl%&7Mastery: <##f53b98>&7■■■■■■■■■■ &7(<##f53b98>0&7)%nl%&7Critical Hit: <##fca417>&7■■■■■■■■■■ &7(<##fca417>0&7)%nl%&7Element: <##d5ff57>&7■■■■■■■■■■ &7(<##d5ff57>0&7)%nl%&7Haste: <##19943e>&7■■■■■■■■■■ &7(<##19943e>0&7)%nl%&7Avoidance: <##2154ad>&7■■■■■■■■■■ &7(<##2154ad>0&7)" and "&7Element: <##d84af7>Psychic" and "&7Source: &fSecret Wonders" with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]},""minecraft:custom_data"":{""Id"":1,""Booster"":""Secret Wonders"",""Rarity"":""Common"",""Code"":""sw""}}"


# #5996f7 #f04f4f #f59c2f  #f759ba

on rightclick:
	set {_item} to 1 of player's held item
	if boolean tag "CardBooster" of custom nbt of {_item} = true:
		if string tag "BoosterName" of custom nbt of {_item} = "Secret Wonders":
			remove 1 of {_item} from player

			#if {winterDelightPassLEVEL::%player%} >= 0:
			#	getMission(player, "Boostermania", "Boosteromania", 1)

			load yaml "plugins/Skript/playerdata/boosters/Secret Wonders/%uuid of player%.yml" as "Secret Wonders-%player%"
			set {_boostersOpened} to yaml value "Booster.Opened" in "Secret Wonders-%player%"
			set {_boostersOpened} to {_boostersOpened} + 1
			set yaml value "Booster.Opened" in "Secret Wonders-%player%" to {_boostersOpened}

			set {OpenedBoosters::%player%} to {OpenedBoosters::%player%} + 1
			boosterAchievements(player, "Secret Wonders")

			set {_cardLissandra} to BoosterCardFromYaml("Secret Wonders", "Lissandra")

			set {_cardJetVac} to BoosterCardFromYaml("Secret Wonders", "Jet-Vac")

			set {_cardCamo} to BoosterCardFromYaml("Secret Wonders", "Camo")

			set {_cardTwistedFate} to BoosterCardFromYaml("Secret Wonders", "Twisted Fate")

			set {_cardPopFizz} to BoosterCardFromYaml("Secret Wonders", "Pop Fizz")

			set {_cardSmeargle} to BoosterCardFromYaml("Secret Wonders", "Smeargle")

			set {_cardTapuFini} to BoosterCardFromYaml("Secret Wonders", "Tapu Fini")

			set {_cardDelphox} to BoosterCardFromYaml("Secret Wonders", "Delphox")

			set {_cardUmbreon} to BoosterCardFromYaml("Secret Wonders", "Umbreon")

			set {_cardPikachu} to BoosterCardFromYaml("Secret Wonders", "Pikachu")

			set {_cardSylveon} to BoosterCardFromYaml("Secret Wonders", "Sylveon")

			set {_cardDiancie} to BoosterCardFromYaml("Secret Wonders", "Diancie")

			set {_cardEcho} to BoosterCardFromYaml("Secret Wonders", "Echo")

			set {_cardWolfgang} to BoosterCardFromYaml("Secret Wonders", "Wolfgang")

			chance of 10%:
				BoosterPackDrop(player, {_cardLissandra})
			chance of 10%:
				BoosterPackDrop(player, {_cardJetVac})
			chance of 10%:
				BoosterPackDrop(player, {_cardCamo})
			chance of 10%:
				BoosterPackDrop(player, {_cardTwistedFate})
			chance of 10%:
				BoosterPackDrop(player, {_cardPopFizz})
			chance of 10%:
				BoosterPackDrop(player, {_cardSmeargle})
			chance of 10%:
				BoosterPackDrop(player, {_cardTapuFini})
			chance of 10%:
				BoosterPackDrop(player, {_cardDelphox})
			chance of 10%:
				BoosterPackDrop(player, {_cardUmbreon})

			#RARE
			chance of 5%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardPikachu})

			#SUPER RARE
			chance of 3%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardSylveon})

			#HYPER RARE
			chance of 1%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardDiancie})

			#SECRET RARE
			chance of 0.5%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardEcho})
			chance of 0.5%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardWolfgang})
			
			
			if {_droppedRare} is not true:
				set {_pity} to yaml value "Booster.Pity" in "Secret Wonders-%player%"
				set {_pity} to {_pity} + 1
				if {_pity} = 10:
					set {_pity} to 0
					set {_pityDrop} to true
				set yaml value "Booster.Pity" in "Secret Wonders-%player%" to {_pity}

				set {_x} to a random integer between 1 and 9
				if {_x} = 1:
					BoosterPackDrop(player, {_cardLissandra})
				else if {_x} = 2:
					BoosterPackDrop(player, {_cardJetVac})
				else if {_x} = 3:
					BoosterPackDrop(player, {_cardCamo})
				else if {_x} = 4:		
					BoosterPackDrop(player, {_cardTwistedFate})
				else if {_x} = 5:
					BoosterPackDrop(player, {_cardPopFizz})
				else if {_x} = 6:
					BoosterPackDrop(player, {_cardSmeargle})
				else if {_x} = 7:
					BoosterPackDrop(player, {_cardTapuFini})
				else if {_x} = 8:
					BoosterPackDrop(player, {_cardDelphox})
				else if {_x} = 9:
					BoosterPackDrop(player, {_cardUmbreon})
			else:
				set yaml value "Booster.Pity" in "Secret Wonders-%player%" to 0

			if {_pityDrop} is true:
				set {_randomRare} to a random integer between 1 and 100
				if {_randomRare} is between 1 and 50:
					set {_pityCard} to {_cardPikachu}
				else if {_randomRare} is between 51 and 80:
					set {_pityCard} to {_cardSylveon}
				else if {_randomRare} is between 81 and 90:
					set {_pityCard} to {_cardDiancie}
				else if {_randomRare} is between 91 and 95:
					set {_pityCard} to {_cardEcho}
				else if {_randomRare} is between 95 and 100:
					set {_pityCard} to {_cardWolfgang}
				BoosterPackDrop(player, {_pityCard})

				send formatted "&f[&2Booster&f] &aThis &awas your &510th booster &ain a row without at least a Rare rarity drop, meaning that %name of {_pityCard}% &ais a pity drop!" to player
				set {_pityDrops} to yaml value "Booster.Pity Drops" in "Secret Wonders-%player%"
				set {_pityDrops} to {_pityDrops} + 1
				set yaml value "Booster.Pity Drops" in "Secret Wonders-%player%" to {_pityDrops}

				set {pityDrops::%player%} to {pityDrops::%player%} + 1

			save yaml "Secret Wonders-%player%"
			#<##1184e5>Riptide

function cardLore(title: string, element: string, booster: string, rarity: string, s1: integer, s2: integer, s3: integer, s4: integer, s5: integer, s6: integer, s7: integer, s8: integer, s9: integer, s10: integer, s11: integer, s12: integer) :: string:
	set {_squares} to "■■■■■■■■■■"
	set {_colourList::*} to "&7Health: <##c0ff02>", "&7Damage: <##f74428>", "&7Resistance: <##ffef45>", "&7Mobility: &f", "&7Utility: <##ae78d0>", "&7Crowd Control: <##58c3f5>", "&7Versatility: <##e3ebff>", "&7Mastery: <##f53b98>", "&7Critical Hit: <##fca417>", "&7Element: <##d5ff57>", "&7Haste: <##19943e>", "&7Avoidance: <##2154ad>"
	set {_lore} to "&7%{_title}%%nl%&7Statistics:"
	loop 12 times:
		set {_stat::*} to {_squares} split at ""
		if {_s%loop-number%} > 0:
			set {_stat::1} to "%{_colourList::%loop-number%}%%{_stat::1}%"
			set {_stat::%{_s%loop-number%}+1%} to "&7%{_stat::%{_s%loop-number%}+1%}%"
		else:
			set {_stat::1} to "&7%{_stat::1}%"
		set {_stat} to join {_stat::*} by ""
		set {_lore} to "%{_lore}%%nl%%{_stat}%"
	if {_booster} = "TPVSTA":
		set {_booster} to "Team Poison vs. Team Aqua"
	set {_lore} to "%{_lore}%%nl%&7Element: %{_element}%%nl%&7Source: &f%{_booster}%%nl%&7Rarity: %{_rarity}%"
	return {_lore}

function cardItem(base: item, name: string, id: integer, idGlobal: integer, booster: string, code: string, rarity: string, element: string, cmd: integer) :: item:
	set {_cardName} to unformatted {_name}
	set {_yamlItem} to cardItemFromYaml({_booster}, {_cardName})
	if {_yamlItem} is not air:
		return {_yamlItem}
	set {_nbt} to "{""minecraft:custom_model_data"":{floats:[%{_cmd}%.0f]},""minecraft:custom_data"":{""Id"":%{_id}%,""Booster"":""%{_booster}%"",""Rarity"":""%{_rarity}%"",""Code"":""%{_code}%"",""Card"":""%{_cardName}%"",""Element"":""%{_element}%"",""IdGlobal"":%{_idGlobal}%}}"
	set {_card} to {_base} named {_name} with nbt from {_nbt}
	return {_card}

function loadBoosterCardListYaml():
	if yaml "BoosterCardList" is not loaded:
		load yaml "plugins/Skript/lists/BoosterCardList" as "BoosterCardList"

function cardItemFromYaml(booster: string, card: string) :: item:
	loadBoosterCardListYaml()
	set {_baseText} to yaml value "%{_booster}%.Cards.%{_card}%.Base" in "BoosterCardList"
	if {_baseText} is not set:
		return air
	set {_name} to yaml value "%{_booster}%.Cards.%{_card}%.DisplayName" in "BoosterCardList"
	set {_id} to yaml value "%{_booster}%.Cards.%{_card}%.Id" in "BoosterCardList"
	set {_idGlobal} to yaml value "%{_booster}%.Cards.%{_card}%.IdGlobal" in "BoosterCardList"
	set {_rarity} to yaml value "%{_booster}%.Cards.%{_card}%.Rarity" in "BoosterCardList"
	set {_element} to yaml value "%{_booster}%.Cards.%{_card}%.Element" in "BoosterCardList"
	set {_code} to yaml value "%{_booster}%.Cards.%{_card}%.Code" in "BoosterCardList"
	set {_cmd} to yaml value "%{_booster}%.Cards.%{_card}%.CustomModelData" in "BoosterCardList"
	if {_name} is not set:
		set {_name} to {_card}
	set {_base} to {_baseText} parsed as item type
	set {_nbt} to "{""minecraft:custom_model_data"":{floats:[%{_cmd}%.0f]},""minecraft:custom_data"":{""Id"":%{_id}%,""Booster"":""%{_booster}%"",""Rarity"":""%{_rarity}%"",""Code"":""%{_code}%"",""Card"":""%{_card}%"",""Element"":""%{_element}%"",""IdGlobal"":%{_idGlobal}%}}"
	set {_item} to {_base} named {_name} with nbt from {_nbt}
	return {_item}

function BoosterElementColour(element: string) :: string:
	if {_element} = "Ice":
		return "<##add8e6>"
	else if {_element} = "Air":
		return "&f"
	else if {_element} = "Nature":
		return "<##607c3c>"
	else if {_element} = "Magic":
		return "<##512989>"
	else if {_element} = "Fight":
		return "<##953301>"
	else if {_element} = "Water":
		return "<##1ebbd7>"
	else if {_element} = "Fire":
		return "<##ff4d00>"
	else if {_element} = "Dark":
		return "<##333333>"
	else if {_element} = "Storm":
		return "<##fffb05>"
	else if {_element} = "Fairy":
		return "<##ff99bb>"
	else if {_element} = "Astral":
		return "<##a99afc>"
	else if {_element} = "Dragon":
		return "<##306844>"
	else if {_element} = "Ghost":
		return "<##431d53>"
	else if {_element} = "Poison":
		return "<##9c72b2>"
	else if {_element} = "Light":
		return "<##fffec8>"
	else if {_element} = "Metal":
		return "<##cecece>"
	else if {_element} = "Psychic":
		return "<##d84af7>"
	else if {_element} = "Earth":
		return "<##633200>"
	else if {_element} = "Beast":
		return "<##7a0000>"
	else if {_element} = "Tech":
		return "<##ffbf00>"
	return "&f"

function BoosterRarityColour(rarity: string) :: string:
	if {_rarity} = "Common":
		return "<##79f759>"
	else if {_rarity} = "Rare":
		return "<##5996f7>"
	else if {_rarity} = "Super Rare":
		return "<##f04f4f>"
	else if {_rarity} = "Hyper Rare":
		return "<##f04f9d>"
	else if {_rarity} = "Secret Rare":
		return "<##bc5ae0>"
	else if {_rarity} = "Promotional":
		return "<##75c3eb>"
	return "&f"

function BoosterCardLoreFromYaml(booster: string, card: string) :: string:
	loadBoosterCardListYaml()
	set {_title} to yaml value "%{_booster}%.Cards.%{_card}%.Title" in "BoosterCardList"
	if {_title} is not set:
		set {_title} to yaml value "%{_booster}%.Cards.%{_card}%.Description" in "BoosterCardList"
	if {_title} is not set:
		set {_title} to {_card}
	set {_rarity} to yaml value "%{_booster}%.Cards.%{_card}%.Rarity" in "BoosterCardList"
	set {_element} to yaml value "%{_booster}%.Cards.%{_card}%.Element" in "BoosterCardList"
	set {_id} to yaml value "%{_booster}%.Cards.%{_card}%.Id" in "BoosterCardList"
	set {_idGlobal} to yaml value "%{_booster}%.Cards.%{_card}%.IdGlobal" in "BoosterCardList"
	set {_stats::*} to yaml list "%{_booster}%.Cards.%{_card}%.Stats" in "BoosterCardList"
	if size of {_stats::*} = 12:
		return cardLore({_title}, "%BoosterElementColour({_element})%%{_element}%", {_booster}, "%BoosterRarityColour({_rarity})%%{_rarity}%", {_stats::1}, {_stats::2}, {_stats::3}, {_stats::4}, {_stats::5}, {_stats::6}, {_stats::7}, {_stats::8}, {_stats::9}, {_stats::10}, {_stats::11}, {_stats::12})
	set {_health} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Health" in "BoosterCardList"
	if {_health} is set:
		set {_damage} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Damage" in "BoosterCardList"
		set {_resistance} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Resistance" in "BoosterCardList"
		set {_mobility} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Mobility" in "BoosterCardList"
		set {_utility} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Utility" in "BoosterCardList"
		set {_crowdControl} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Crowd Control" in "BoosterCardList"
		set {_versatility} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Versatility" in "BoosterCardList"
		set {_mastery} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Mastery" in "BoosterCardList"
		set {_criticalHit} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Critical Hit" in "BoosterCardList"
		set {_elementStat} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Element" in "BoosterCardList"
		set {_haste} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Haste" in "BoosterCardList"
		set {_avoidance} to yaml value "%{_booster}%.Cards.%{_card}%.Stats.Avoidance" in "BoosterCardList"
		return cardLore({_title}, "%BoosterElementColour({_element})%%{_element}%", {_booster}, "%BoosterRarityColour({_rarity})%%{_rarity}%", {_health}, {_damage}, {_resistance}, {_mobility}, {_utility}, {_crowdControl}, {_versatility}, {_mastery}, {_criticalHit}, {_elementStat}, {_haste}, {_avoidance})
	return "&7%{_title}%%nl%&7Statistics:%nl%&7Element: %BoosterElementColour({_element})%%{_element}%%nl%&7Source: &f%{_booster}%%nl%&7Rarity: %BoosterRarityColour({_rarity})%%{_rarity}%"

function BoosterCardFromYaml(booster: string, card: string) :: item:
	set {_item} to cardItemFromYaml({_booster}, {_card})
	if {_item} is air:
		return air
	set lore of {_item} to BoosterCardLoreFromYaml({_booster}, {_card})
	return {_item}

function BoosterAddDropDate(card: item, date: string) :: item:
	set {_lore::*} to lore of {_card}
	set {_lore::*} to {_lore::*} and "&8Dropped: %{_date}%"
	set lore of {_card} to {_lore::*}
	return {_card}

function BoosterPackDrop(p: player, card: item):
	set {_date} to data()
	
	set {_cardBoosterID} to string tag "Id" of custom nbt of {_card}
	set {_cardGlobalID} to string tag "IdGlobal" of custom nbt of {_card}
	set {_rarity} to string tag "Rarity" of custom nbt of {_card}
	set {_code} to string tag "Code" of custom nbt of {_card}
	set {_cardName} to string tag "Card" of custom nbt of {_card}
	set {_booster} to string tag "Booster" of custom nbt of {_card}

	if yaml "%{_booster}%-%{_p}%" is loaded:
		
		set {_cardDropped} to yaml value "Cards.%{_cardName}%" in "%{_booster}%-%{_p}%"
		if {_cardDropped} is not set:
			set {_cardDropped} to 0
		set {_cardDropped} to {_cardDropped} + 1
		set yaml value "Cards.%{_cardName}%" in "%{_booster}%-%{_p}%" to {_cardDropped}

		if {_cardDropped} = 1:
			set {_card} to BoosterAddDropDate({_card}, {_date})
			set boolean tag "Tradeable" of (custom nbt of {_card}) to false
		else:
			set boolean tag "Tradeable" of (custom nbt of {_card}) to true

	giveItem({_p}, {_card})

	set {totalCardsDropped} to {totalCardsDropped} + 1

	set {_boosterName} to {_booster}
	if {_boosterName} = "TPVSTA":
		set {_boosterName} to "Team Poison vs. Team Aqua"

	if {_rarity} = "Common":
		send formatted "&f[&2Booster&f] &c%{_p}% &ajust dropped the <tooltip:%join lore of {_card} by nl%>%name of {_card}% &acard from the &5%{_boosterName}% &abooster!" to all players

		send "&f[&2Booster&f] &c%{_p}% &ajust dropped the %name of {_card}% &acard from the &5%{_boosterName}% &abooster!" to console
		log "%{_date}% [Booster] %{_p}% just dropped the %{_cardName}% card from the %{_boosterName}% booster!" to "logi/karty.log"

	else:
		send formatted "&f[&2Booster&f] &c%{_p}% &ajust dropped the %{_rarity} in lowercase% <tooltip:%join lore of {_card} by nl%>%name of {_card}% &acard from the &5%{_boosterName}% &abooster!" to all players
		
		if {_rarity} = "Rare":
			play sound "entity.dolphin.ambient" with volume 3 and pitch 1 to all players
		else if {_rarity} = "Super Rare":
			play sound "entity.blaze.ambient" with volume 3 and pitch 1 to all players
			play sound "entity.dolphin.ambient" with volume 3 and pitch 1 to all players
		else if {_rarity} = "Hyper Rare":
			play sound "entity.wither.ambient" with volume 3 and pitch 1 to all players
			play sound "entity.blaze.ambient" with volume 3 and pitch 1 to all players
			play sound "entity.dolphin.ambient" with volume 3 and pitch 1 to all players
		else if {_rarity} = "Secret Rare":
			play sound "entity.wither.ambient" with volume 3 and pitch 1 to all players
			play sound "entity.ender_dragon.ambient" with volume 3 and pitch 1 to all players
			play sound "entity.blaze.ambient" with volume 3 and pitch 1 to all players
			play sound "entity.dolphin.ambient" with volume 3 and pitch 1 to all players

		send "&f[&2Booster&f] &c%{_p}% &ajust dropped the %{_rarity} in lowercase% %name of {_card}% &acard from the &5%{_boosterName}% &abooster!" to console
		log "%{_date}% [Booster] %{_p}% just dropped the %{_rarity} in lowercase% %{_cardName}% card from the %{_boosterName}% booster!" to "logi/karty.log"

	save yaml "%{_booster}%-%{_p}%"

function boosterAchievements(p: player, booster: string):
	if yaml "data-%{_p}%" is not loaded:
		load yaml "plugins/Skript/playerdata/%uuid of {_p}%.yml" as "data-%{_p}%"
	set {_boosterName} to {_booster}
	if {_boosterName} = "Team Poison vs. Team Aqua":
		set {_boosterName} to "TPVSTA"
	addToYaml(1, "data-%{_p}%", "Statistics.Boosters.Total")
	addToYaml(1, "data-%{_p}%", "Statistics.Boosters.%{_booster}%")
	set {_totalOpened} to yaml value "Statistics.Boosters.Total" in "data-%{_p}%"
	if {_totalOpened} is not set:
		set {_totalOpened} to {otwboostery::%{_p}%}
	if {_totalOpened} >= 50:
		set {_yamlValue} to "Achievement.Boosters.Opened Boosters.50"
		achievementYaml({_p}, "Boosters", "Opened Boosters+50", {_totalOpened})
	if {_totalOpened} >= 100:
		set {_yamlValue} to "Achievement.Boosters.Opened Boosters.100"
		achievementYaml({_p}, "Boosters", "Opened Boosters+100", {_totalOpened})
	if {_totalOpened} >= 1000:
		set {_yamlValue} to "Achievement.Boosters.Opened Boosters.1000"
		achievementYaml({_p}, "Boosters", "Opened Boosters+1000", {_totalOpened})
	set {_boosterOpened} to yaml value "Statistics.Boosters.%{_boosterName}%" in "data-%{_p}%"
	if {_boosterOpened} >= 50:
		set {_yamlValue} to "Achievement.Boosters.%{_boosterName}%.50"
		achievementYaml({_p}, "Boosters", "%{_boosterName}%+50", {_boosterOpened})
	if {_boosterOpened} >= 100:
		set {_yamlValue} to "Achievement.Boosters.%{_boosterName}%.100"
		achievementYaml({_p}, "Boosters", "%{_boosterName}%+100", {_boosterOpened})
	if {_boosterOpened} >= 1000:
		set {_yamlValue} to "Achievement.Boosters.%{_boosterName}%.1000"
		achievementYaml({_p}, "Boosters", "%{_boosterName}%+1000", {_boosterOpened})
	save yaml "data-%{_p}%"
