on player pickup xp:
	if {orbbudget::%player%} > 0:
		cancel event
		loop all experience orbs in radius 2 around the player:
			kill loop-value
			stop loop
		remove 1 from {orbbudget::%player%}
		set {orbcount::%player%} to {orbcount::%player%} + 1
		play sound "entity.experience_orb.pickup" with volume 2 and pitch 2 to player
	else:
		if {orbbudget::%player%} is set:
			cancel event
			loop all experience orbs in radius 2 around the player:
				kill loop-value
				stop loop
on xp orb merge:
	cancel event
on sign change:
	line 1 contains "[Elevator]":
		line 2 is "Lift Up":
			set line 1 to "&1[Elevator]"
			set line 2 to "Lift Up"
	line 1 is "[Elevator]":
		line 2 is "Lift Down":
			set line 1 to "&1[Elevator]"
			set line 2 to "Lift Down"
on rightclick:
	if event-block is tagged with tag "paper:signs":
		line 1 contains "&1[Elevator]":
			cancel event
			line 2 is "Lift Up":
				execute player command "/ascend"
			line 2 is "Lift Down":
				execute player command "/descend"
on leaves decay:
	cancel event
on skript load:
	execute console command "/whitelist on"

command /levelreset:
	trigger:
		send "This command has been temporarily disabled for player safety."
		#send "&8[&aEarthcraft&8] &aZresetowano poziom&7!"
		#clear {poziom::%player%}
		#clear {exp::%player%}

function addPlayerXP(p: player, xp: number, modifier: number = 1, source: string = "General") :: number:
	if {doubleXPFriday} is true:
		set {_xp} to {_xp}*2

	set {_xp} to {_xp}*{_modifier}

	set {_source} to {_source} in strict proper case

	if {_source} = "Mining":
		if metadata value "SapphireDice" of {_p} is set:
			set {_xp} to {_xp}*3
		if {poziomgornictwo::%{_p}%} < 50:
			add {_xp} to {expgornictwo::%{_p}%}
			miningProfession({_p})

	set {exp::%{_p}%} to {exp::%{_p}%} + {_xp}

	playerCheckLevelUp({_p})

	if {event} = "Winter Delight":
		winterDelightPassAddXP({_p}, {_xp})
		if {winterDelightPassLEVEL::%{_p}%} >= 0:
			getMission({_p}, "Gaining Experience", "Zdobywanie Doświadczenia", {_xp})
	
	UpdateScoreboard({_p})

	addToYaml({_xp}, "data-%{_p}%", "Statistics.Experience.%{_source}%.Total")
	addToYaml({_xp}, "data-%{_p}%", "Statistics.Experience.Total")
	save yaml "data-%{_p}%"
	
	return {_xp}

function addMiningXP(p: player, xp: number, modifier: number = 1):
	if {poziomgornictwo::%{_p}%} < 50:
		if {doubleXPFriday} is true:
			set {_xp} to {_xp}*2
		set {_xp} to {_xp}*{_modifier}
		set {expgornictwo::%{_p}%} to {expgornictwo::%{_p}%} + {_xp} 
		miningProfession({_p})

function playerCheckLevelUp(p: player):
	while {exp::%{_p}%} >= (100*{poziom::%{_p}%}):
		remove (100*{poziom::%{_p}%}) from {exp::%{_p}%}
		set {poziom::%{_p}%} to {poziom::%{_p}%} + 1
		set {stardust::%{_p}%} to {stardust::%{_p}%} + {poziom::%{_p}%}
		set {totalstardust::%{_p}%} to {totalstardust::%{_p}%} + {poziom::%{_p}%}

		set {cosmicflux::%{_p}%} to {cosmicflux::%{_p}%} + 5*{poziom::%{_p}%}
		set {totalcosmicflux::%{_p}%} to {totalcosmicflux::%{_p}%} + 5*{poziom::%{_p}%}

		set {dziennylimit::stardust::%{_p}%} to {poziom::%{_p}%}
		set {orgpoziom::%{_p}%} to {orgpoziom::%{_p}%} + 1

		set {_allTimeLevel} to yaml value "Player.All Time.Level" in "data-%{_p}%"
		set {_allTimeLevel} to {_allTimeLevel} + 1
		set yaml value "Player.All Time.Level" in "data-%{_p}%" to {_allTimeLevel}

		set {_updateLevel} to yaml value "Player.Per Update.%{currentUpdate}%.Level" in "data-%{_p}%"
		set {_updateLevel} to {_updateLevel} + 1
		set yaml value "Player.Per Update.%{currentUpdate}%.Level" in "data-%{_p}%" to {_updateLevel}

		set yaml value "Player.Level" in "data-%{_p}%" to {poziom::%{_p}%}
		set yaml value "Player.Exp" in "data-%{_p}%" to {exp::%{_p}%}

		set {_data} to data()
		if {winterDelightPassLEVEL::%{_p}%} >= 0:
			getMission({_p}, "Progress", "Progres", 1)
		set {_yamlValue} to "Achievement.Player.Level.10"
		achievementYaml({_p}, "Experience", "Level+10", {poziom::%{_p}%})
		set {_yamlValue} to "Achievement.Player.Level.50"
		achievementYaml({_p}, "Experience", "Level+50", {poziom::%{_p}%})
		set {_yamlValue} to "Achievement.Player.Level.100"
		achievementYaml({_p}, "Experience", "Level+100", {poziom::%{_p}%})
		set {_yamlValue} to "Achievement.Player.Level.200"
		achievementYaml({_p}, "Experience", "Level+200", {poziom::%{_p}%})
		set {_yamlValue} to "Achievement.Player.Level.300"
		achievementYaml({_p}, "Experience", "Level+300", {poziom::%{_p}%})
		set {_yamlValue} to "Achievement.Player.Level.500"
		achievementYaml({_p}, "Experience", "Level+500", {poziom::%{_p}%})
		set {_yamlValue} to "Achievement.Player.Level.1000"
		achievementYaml({_p}, "Experience", "Level+1000", {poziom::%{_p}%})
		if {poziom::%{_p}%} = 10:
			set {_colour} to "#55ffff"
		if {poziom::%{_p}%} = 20:
			set {_colour} to "#ff5555"
		if {poziom::%{_p}%} = 30:
			set {_colour} to "#FF55FF"
		if {poziom::%{_p}%} = 40:
			set {_colour} to "#55FF55"
		if {poziom::%{_p}%} = 50:
			set {_colour} to "#5555ff"
		if {poziom::%{_p}%} = 60:
			set {_colour} to "#FFFF55"
		if {poziom::%{_p}%} = 70:
			set {_colour} to "#AA00AA"
		if {poziom::%{_p}%} = 80:
			set {_colour} to "#00AAAA"
		if {poziom::%{_p}%} = 90:
			set {_colour} to "#aa0000"
			
		if {_colour} is set:
			if 100 > {poziom::%{_p}%}:
				set {kolorek1::%{_p}%} to {_colour}
			else:
				if {kolorek1::%{_p}%} is not set:
					set {kolorek1::%{_p}%} to "#ffffff"

		set {_starShard} to yaml value "Star Shard.Item" in "ItemList"
		
		set {_shardAmount} to round (({poziom::%{_p}%} / 100) + 1)
		giveItem({_p}'s uuid, {_shardAmount} of {_starShard})

		send formatted "&8[&6Earthcraft&8] &7Congratulations! You receive &f%{_shardAmount}%x &cStar Shard &7for reaching level &6%{poziom::%{_p}%}%&7!" to {_p}

		if {poziom::%{_p}%} is divisible by 50:
			set {nagrodalvl::karta::%{_p}%} to {nagrodalvl::karta::%{_p}%} + 1
			set {_starShards} to 5 * ({poziom::%{_p}%}/50)
			send formatted "&8[&6Earthcraft&8] &7Congratulations! You receive &f%{_starShards}%x &cStar Shard &7as a milestone reward for reaching level &6%{poziom::%{_p}%}%&7!" to {_p}
			giveItem({_p}'s uuid, {_starShards} of {_starShard})

		play sound "entity.player.levelup" with volume 3 and pitch 2 to {_p}
		if {poziom::%{_p}%} is set:
			loop all players:
				if loop-player is not {_p}:
					send "&8[&6Earthcraft&8] &6%{_p}% &7reached level &6%{poziom::%{_p}%}%&7!" to loop-player
				else:
					send "&8[&6Earthcraft&8] &7Congratulations! You reached level &6%{poziom::%{_p}%}% &7lvl!" to {_p}
					send "&8[&6Earthcraft&8] &7You receive &6%5*{poziom::%{_p}%}% <##ffe17a>Cosmic Flux &7as a reward for reaching a new level!" to {_p}
					send "&8[&6Earthcraft&8] &7You receive &6%{poziom::%{_p}%}% %{stardust}'s name% &7as a reward for reaching a new level!" to {_p}

			send "Gracz %{_p}% właśnie osiągnął %{poziom::%{_p}%}% poziom!" to console
			log "%{_data}% Gracz %{_p}% właśnie osiągnął %{poziom::%{_p}%}% poziom!" to "logi/poziomy.log"
			execute console command "discord broadcast ##earthcraft %{_data}% | %{_p}% reached level %{poziom::%{_p}%}%!"
			#set the {_p}'s tab name to "&8[<##9b21ad>&l%{poziom::%{_p}%}%&f&8] &f%{_p}%"
			#set the {_p}'s tab name to "&8[<##504cc2>&l%{poziom::%{_p}%}%&f&l&8] &f%{_p}%"
			#set the {_p}'s tab name to "&8[<##ae7ff6>&l%{poziom::%{_p}%}%&f&l&8] &f%{_p}%"
			play sound "ui.toast.challenge_complete" with volume 5 and pitch 1 at {_p}
			set {_data::*} to data() split at " "
			set {_bot} to bot named "Earthcraft"
			make embed:
				set author of embed to "%{_p}% reached level %{poziom::%{_p}%}% | %{_data::1}%"
				set embed color of the embed to lime               
				set author icon of embed to "https://mc-heads.net/avatar/%getSkinHash({_p})%"
			post last embed to channel with id "900397064251379752" using {_bot}

	if yaml "data-%{_p}%" is loaded:
		save yaml "data-%{_p}%"

function miningProfession(p: player):
	if {poziomgornictwo::%{_p}%} < 50:
		if {expgornictwo::%{_p}%} is bigger than or equal to 650 + (650*{poziomgornictwo::%{_p}%}-1):
			remove (650 + (650*{poziomgornictwo::%{_p}%}-1)) from {expgornictwo::%{_p}%}
			set {poziomgornictwo::%{_p}%} to {poziomgornictwo::%{_p}%} + 1
			set {orgpoziomgornictwo::%{_p}%} to {orgpoziomgornictwo::%{_p}%} + 1
			set {_data} to data()
			set {_yamlValue} to "Achievement.Mining.ProfessionLevel.75"
			achievementYaml({_p}, "Professions", "ProfessionLevel+75", {poziomgornictwo::%{_p}%})
			set {_yamlValue} to "Achievement.Mining.ProfessionLevel.10"
			achievementYaml({_p}, "Professions", "ProfessionLevel+10", {poziomgornictwo::%{_p}%})
			set {_yamlValue} to "Achievement.Mining.ProfessionLevel.25"
			achievementYaml({_p}, "Professions", "ProfessionLevel+25", {poziomgornictwo::%{_p}%})
			set {_yamlValue} to "Achievement.Mining.ProfessionLevel.50"
			achievementYaml({_p}, "Professions", "ProfessionLevel+50", {poziomgornictwo::%{_p}%})
			if {poziomgornictwo::%{_p}%} is set:
				send "&8[&6Earthcraft&8] &7Congratulations! You have reached level &6%{poziomgornictwo::%{_p}%}% &7in the &6 Mining &7profession!" to {_p}
				loop all players:
					send "&8[&6Earthcraft&8] &6%{_p}% &7reached level &6%{poziomgornictwo::%{_p}%}% &7in the &6 Mining &7profession!" to loop-player
				send "[Earthcraft] Gracz %{_p}% osiągnął %{poziomgornictwo::%{_p}%}% lvl na profesji  Górnictwo!" to console
				play sound "ui.toast.challenge_complete" with volume 5 and pitch 1 at {_p}
				log "%{_data}% Gracz %{_p}% właśnie osiągnął %{poziomgornictwo::%{_p}%}% poziom na profesji Górnictwo!" to "logi/profesje.log"
			set {_x} to {poziomgornictwo::%{_p}%}
			if {_x} = 1:
				set {umkilof::pomdlon::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the special pickaxe skill &6Helping Hand&7! Speak to &6'Brodaty' Zachary &7to select or swap your pickaxe skill!" to {_p}
			else if {_x} = 3, 14, 21, 22, 27, 33, 39, 42, 46:
				add 0.025 to {bonusesencja::%{_p}%}
				send "&8[&6Earthcraft&8] &7You unlock &6+0.025%% bonus chance to drop Essences&7!" to {_p}
			else if {_x} = 4, 16, 18, 24, 28, 34, 36, 44, 48:
				add 0.07 to {bonusklejnot::%{_p}%}
				send "&8[&6Earthcraft&8] &7You unlock &6+0.07%% bonus chance to drop Klejnots&7!" to {_p}
			else if {_x} = 2, 7, 11, 17, 19, 23, 29, 37, 47, 49:
				add 0.01 to {bonuskamieniesz::%{_p}%}
				send "&8[&6Earthcraft&8] &7You unlock &6+0.01%% bonus chance to drop Gemstones&7!" to {_p}
			else if {_x} = 9, 13, 26, 31, 41:
				add 10 to {bonusprzepalanie::%{_p}%}
				send "&8[&6Earthcraft&8] &7You unlock a &6+10%% bonus to XP gain from smelting ores, stone and deepslate&7!" to {_p}
			else if {_x} = 5:
				set {gornictwo::mechanik::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the &6Mechanic&7 &7ability!" to {_p}
			else if {_x} = 6:
				set {gornictwo::rudamalachitu::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7From now on you can find <##3ea890>Malachite Ore &7when mining!" to {_p}
			else if {_x} = 8:
				set {gornictwo::preznal::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the &6Prehistoric Findings &7ability&7!" to {_p}
			else if {_x} = 10:
				set {umkilof::eksplozja::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the special pickaxe skill &6Explosion&7! Speak to &6'Brodaty' Zachary &7to select or swap your pickaxe skill!" to {_p}
			else if {_x} = 12:
				set {gornictwo::rudasoli::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7From now on you can find <##e0ecff>Salt Ore &7when mining!" to {_p}
			else if {_x} = 15:
				set {gornictwo::stardust::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the &6Stellar Prophecy &7ability!" to {_p}
			else if {_x} = 20:
				set {umkilof::zaplon::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the special pickaxe skill &6Ignition&7! Speak to &6'Brodaty' Zachary &7to select or swap your pickaxe skill!" to {_p}
			else if {_x} = 25:
				set {gornictwo::rudaxp::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7From now on you can find <##8cff98>XP Ore &7when mining!" to {_p}
			else if {_x} = 26:
				set {gornictwo::zylaklejnotow::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7From now on you can find <##b5e550>Klejnot Deposits &7when mining!" to {_p}
			else if {_x} = 30:
				set {umkilof::instogrz::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the special pickaxe skill &6Heating Systems&7! Speak to &6'Brodaty' Zachary &7to select or swap your pickaxe skill!" to {_p}
			else if {_x} = 32:
				set {gornictwo::rudaplatyny::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7From now on you can find <##5c9e71>Platinum Ore &7when mining!" to {_p}
			else if {_x} = 34:
				set {gornictwo::bonusxp::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7Your XP gain from mining ores has been increased by &f25%%&7!" to {_p}
			else if {_x} = 35:
				set {gornictwo::bystreoko::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the &6Sharp Eye &7ability!" to {_p}
			else if {_x} = 40:
				set {umkilof::magnes::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the special pickaxe skill &6Magnet&7! Speak to &6'Brodaty' Zachary &7to select or swap your pickaxe skill!" to {_p}
			else if {_x} = 43:
				set {gornictwo::rudamalachitu::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7From now on you can find <##3ea890>Malachite Ore &7when mining!" to {_p}
			else if {_x} = 45:
				set {gornictwo::poszukiwaczmineralow::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7You unlock the &6Mineral Seeker &7ability! Speak to &6'Brodaty' Zachary &7to select or swap your pickaxe skill!" to {_p}
			else if {_x} = 50:
				set {gornictwo::rudavoidstone::%{_p}%} to true
				send "&8[&6Earthcraft&8] &7From now on you can find <##673a9c>Voidstone Ore &7when mining!" to {_p}
			#if {_x} = 55:
			#	send "a" to {_p}
			#if {_x} = 65:
			#	send "a" to {_p}
			#if {_x} = 70:
			#	send "a" to {_p}
			#if {_x} = 75:
			#	send "a" to {_p}
	if {umkilof::%{_p}%} = "Zapłon":
		if {orbcount::%{_p}%} >= 20:
			remove 20 from {orbcount::%{_p}%}
			apply haste 2 without particles to {_p} for 4 seconds
			play sound "block.brewing_stand.brew" with volume 3 and pitch 0.9 to {_p}
		chance of 8%:
			spawn 1 xp orb at block 2 blocks behind {_p}
			set {orbbudget::%{_p}%} to {orbbudget::%{_p}%} + 1
			send action bar "&a%{orbcount::%{_p}%}%" to {_p}
			play sound "entity.experience_orb.pickup" with volume 1 and pitch 1 + {orbbudget::%{_p}%}/20 to {_p}

command /stonedrop [<text>]:
	trigger:
		if any:
			arg-1 = "on"
			arg-1 = "off"
		then:
			if arg-1 = "on":
				send "&aTurned &lon stone &aand deepslate drop for this session." to player
				clear metadata value "StoneDropDisabled" of player
			else:
				send "&aTurned &loff &astone and deepslate drop for this session." to player
				set metadata value "StoneDropDisabled" of player to true
		else:
			send "&c&oArgument must be either &fon &c&oor &foff&c&o!" to player

on tab complete of "/stonedrop":
	set tab completions for position 1 to "on" and "off"