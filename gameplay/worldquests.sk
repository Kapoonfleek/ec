variables:
    {worldQuestCount} = 0

using script reflection

function portraitDialogue(p: player, icon: string, name: string, text: string, faction: string = ""):
    replace all "<br>" in {_text} with " "
    set {_words::*} to {_text} split at " "
    set {_currentLine} to ""
    set {_lineCount} to 1

    if {_faction} != "":
        set {_name} to "<##fdd002>%{_name}%, &7&o%{_faction}%"
    
    loop {_words::*}:
        if length of ("%{_currentLine}% %loop-value%") <= 40:
            if {_currentLine} is "":
                set {_currentLine} to loop-value
            else:
                set {_currentLine} to "%{_currentLine}% %loop-value%"
        else:
            set {_allLines::%{_lineCount}%} to {_currentLine}
            set {_lineCount} to {_lineCount} + 1
            set {_currentLine} to loop-value
    
    set {_allLines::%{_lineCount}%} to {_currentLine}

    loop {_allLines::*}:
        if loop-index parsed as integer <= 2:
            set {_textAligned::*} to {_textAligned::*} and loop-value
        else:
            set {_textExtra::*} to {_textExtra::*} and loop-value
    send "" to {_p}
    send "          %{_name}%" to {_p}
    
    loop {_textAligned::*}:
        send "          %loop-value%" to {_p}
    
    if size of {_textAligned::*} is 1:
        send "          " to {_p}

    if {_textExtra::*} is set:
        loop {_textExtra::*}:
            if loop-counter = 1:
                send "%{_icon}% %loop-value%" to {_p}
            else:
                send "          %loop-value%" to {_p}
    else:
        send "%{_icon}%" to {_p}
        
    send " " to {_p}

command /ly:
    trigger:
        if yaml "WorldQuestList" is loaded:
            save yaml "WorldQuestList"
            unload yaml "WorldQuestList"
            broadcast "&cunloaded yaml"
        else:
            load yaml "plugins/Skript/lists/WorldQuestList" as "WorldQuestList"
            broadcast "&bloaded yaml"

on rightclick:
    if player's tool is glistering melon slice:
        set {_var} to "Eclair Goat"
        set {_wq} to "Eclair Goats"
        set {_loc} to player's location
        if yaml list "Locations.%{_var}%" in "WorldQuestLocations%{_wq}%" does not contain {_loc}:
            add {_loc} to yaml list "Locations.%{_var}%" in "WorldQuestLocations%{_wq}%"
            showSpawnPoint(player, {_loc})
            save yaml "WorldQuestLocations%{_wq}%"
        
        set {_t::*} to yaml list "Locations.%{_var}%" in "WorldQuestLocations%{_wq}%"
        broadcast size of {_t::*}

command /testdialogue:
    trigger:
        set {_citizens} to Bukkit.getPluginManager().getPlugin("Citizens")
        set {_magni} to {_citizens}.getNPCRegistry().getById(6748).getEntity()
        broadcast {_magni}

function showSpawnPoint(p: player, loc: location):
    while "%region at {_p}%" contains "WorldQuest_":
        make {_p} see block at {_loc} as diamond block
        wait 1 tick

command /wq [<text>]:
    trigger:
        if arg-1 = "tst":
            broadcast all loaded yaml
        if arg-1 = "reward":
            set yaml value "Sage Exp Book.Unicode Icon" in "ItemList" to ""
            save yaml "ItemList"
        if arg-1 = "task":
            set yaml value "Tasks.Collect Things.Tidying Up.Glassware.Block" in "WorldQuestList" to flower pot
           # set yaml value "Tasks.Collect Things.Tidying Up.Glassware.Extra Data" in "WorldQuestList" to "%nbt compound of {_t}%"
        if arg-1 = "yaml":
            NewWorldQuests()
        if arg-1 = "loc":
            add player's location to yaml list "Interact With.The Big Dig.Locations" in "WorldQuestLocations"
            broadcast size of yaml list "Interact With.The Big Dig.Locations" in "WorldQuestLocations"
        if arg-1 = "register":
            set yaml value "World Quests.The Narrow Passage.Location" in "WorldQuestList" to player's location
            set yaml value "World Quests.The Narrow Passage.Location Name" in "WorldQuestList" to "Riptide Reach"
            set yaml value "World Quests.The Narrow Passage.Type" in "WorldQuestList" to "Slay Mobs"
            set yaml value "World Quests.The Narrow Passage.Quest Giver" in "WorldQuestList" to "Philippe 'Rumford'"
            set yaml value "World Quests.The Narrow Passage.EXP" in "WorldQuestList" to 100
            set yaml value "World Quests.The Narrow Passage.Reputation" in "WorldQuestList" to 20
            set yaml list "World Quests.The Narrow Passage.Rewards" in "WorldQuestList" to "Radiant Azerite Fragment"
        if arg-1 = "spawn":
            set {_wq} to "The Narrow Passage"
            WorldQuestSpawn({_wq})
        if arg-1 = "slay":
            loop all entities in radius 200 of player:
                if boolean tag "RemoveOnReset" of custom nbt of loop-entity = true:
                    kill loop-entity

        save yaml "WorldQuestList"

#2. Always 1 "rarer, more difficult world ques, usually slay a boss"
#3. Player stats: Completed world quests, completed world quests per category, xp from world quests
#4. Emissary quests
#5. Add rest of World Quests
#6. set {_yamlValue} to "Achievement.Mining.Klejnot.1000"
#achievementYaml({_p}, "plugins/Skript/playerdata/achievements", "Achievements", {_yamlValue}, "Klejnot: 1000", "Find 1000 Klejnots while mining.")
#7. Also keep track o WQs completed for a specific faction.
#8. Display the progress of all world quests that were picked up somewhere.

function WorldQuestSpawn(wq: string):
    set {_wqType} to yaml value "World Quests.%{_wq}%.Type" in "WorldQuestList"
    if {_wqType} = "Slay Mobs":
        set {_mobTypes::*} to yaml node keys "Tasks.%{_wqType}%.%{_wq}%" in "WorldQuestList"
        loop {_mobTypes::*}:
            set {_mobType} to loop-value
            set {_entity} to (yaml value "Mobs.%{_mobType}%.Entity" in "WorldQuestList")
            set {_health} to yaml value "Mobs.%{_mobType}%.Health" in "WorldQuestList"
            set {_level} to yaml value "Mobs.%{_mobType}%.Level" in "WorldQuestList"
            set {_element} to yaml value "Mobs.%{_mobType}%.Element" in "WorldQuestList"
            set {_item} to yaml value "Mobs.%{_mobType}%.Item" in "WorldQuestList"

            set {_spawnLocations::*} to yaml list "Locations.%{_mobType}%" in "WorldQuestLocations%{_wq}%"
            loop {_spawnLocations::*}:
                WorldQuestSpawnMob(loop-value-2, {_wq}, {_mobType}, {_entity}, {_health}, {_level}, {_element}, {_item})

    else if {_wqType} = "Interact With":
        set {_types::*} to yaml node keys "Tasks.%{_wqType}%.%{_wq}%" in "WorldQuestList"
        loop {_types::*}:
            set {_entity} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value%.Entity" in "WorldQuestList"
            set {_baseEntity} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value%.Base Entity" in "WorldQuestList"
            set {_entityModel} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value%.Model" in "WorldQuestList"
            set {_movementSpeed} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value%.Movement Speed" in "WorldQuestList"
            set {_spawnOffset} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value%.Spawn Offset" in "WorldQuestList"
            set {_showName} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value-1%.Show Name" in "WorldQuestList"
            set {_noGravity} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value-1%.No Gravity" in "WorldQuestList"
            set {_invulnerable} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value-1%.Invulnerable" in "WorldQuestList"
            set {_silent} to yaml value "Tasks.%{_wqType}%.%{_wq}%.%loop-value-1%.Silent" in "WorldQuestList"
            if {_spawnOffset} is not set:
                set {_spawnOffset} to 0

            set {_spawnLocations::*} to yaml list "Locations.%{_entity}%" in "WorldQuestLocations%{_wq}%"
            loop {_spawnLocations::*}:
                spawn ({_baseEntity} parsed as entity type) at location {_spawnOffset} above loop-value-2
                set {_spawnedEntity} to last spawned entity
                set boolean tag "WorldQuestInteractEntity" of custom nbt of {_spawnedEntity} to true
                set boolean tag "RemoveOnReset" of custom nbt of {_spawnedEntity} to true
                set string tag "WorldQuestInteractEntityType" of custom nbt of {_spawnedEntity} to {_entity}
                set string tag "WorldQuest" of custom nbt of {_spawnedEntity} to {_wq}
                set string tag "WorldQuestType" of custom nbt of {_spawnedEntity} to {_wqType}

                if {_noGravity} = true:
                    set boolean tag "NoGravity" of nbt of {_spawnedEntity} to true
                if {_invulnerable} = true:
                    set boolean tag "Invulnerable" of nbt of {_spawnedEntity} to true
                if {_showName} != false:
                    set display name of {_spawnedEntity} to {_entity}

                if {_movementSpeed} is set:
                    set generic movement speed attribute of {_spawnedEntity} to {_movementSpeed}

                if {_entityModel} is set:
                    modelApply({_spawnedEntity}, {_entityModel}, 2.0)
            
            clear {_entityModel}

function WorldQuestSpawnMob(loc: location, wq: string, mobType: string, entity: entity type, health: number, level: number, element: string, item: item):
    spawn {_entity} at {_loc}
    set {_mob} to last spawned entity
    set display name of {_mob} to "&f%{_mobType}%"

    set {_mob}'s max health to {_health} * Math.pow(1.072, {_level})
    heal {_mob}

    set boolean tag "ECMob" of custom nbt of {_mob} to true
    set int tag "ECLvl" of custom nbt of {_mob} to {_level}
    set boolean tag "RemoveOnReset" of custom nbt of {_mob} to true
    set string tag "ECElement" of custom nbt of {_mob} to {_element}
    set boolean tag "ECWorldQuestMob" of custom nbt of {_mob} to true
    set boolean tag "Silent" of nbt of {_mob} to true
    set string tag "MobType" of custom nbt of {_mob} to {_mobType}
    set string tag "WorldQuest" of custom nbt of {_mob} to {_wq}
    set long tag "MobDamageModifier" of custom nbt of {_mob} to 1 * Math.pow(1.026, ({_level}))

    onECMobSpawn({_mob})

    set metadata value "ECSpawnLocation" of {_mob} to {_loc}
    if {_item} is set:
        set {_mob}'s held item to {_item}

    if yaml list "Mobs.%{_mobType}%.Sounds" in "WorldQuestList" is set:
        if yaml value "Mobs.%{_mobType}%.Sound Pitch" in "WorldQuestList" is set:
            set {_pitch} to yaml value "Mobs.%{_mobType}%.Sound Pitch" in "WorldQuestList"
        set {_sounds::*} to yaml list "Mobs.%{_mobType}%.Sounds" in "WorldQuestList"
        WorldQuestMobSounds({_mob}, {_sounds::*}, {_pitch})
    else:
        playEntitySound({_mob}, "Ambient")

    set {_scale} to yaml value "Mobs.%{_mobType}%.Scale" in "WorldQuestList"
    set scale attribute of {_mob} to {_scale}

    set {_movementSpeed} to yaml value "Mobs.%{_mobType}%.Movement Speed" in "WorldQuestList"
    if {_movementSpeed} is set:
        set generic movement speed attribute of {_mob} to {_movementSpeed}

    if yaml value "Mobs.%{_mobType}%.Disguise" in "WorldQuestList" is set:
        set {_disguiseType} to yaml value "Mobs.%{_mobType}%.Disguise.Type" in "WorldQuestList"
        set {_disguise} to yaml value "Mobs.%{_mobType}%.Disguise.Name" in "WorldQuestList"
        if {_disguiseType} = "Mob":
            disguise {_mob} as {_disguise}

    if yaml value "Mobs.%{_mobType}%.Model" in "WorldQuestList" != "none":
        MobInfoAssignments({_mob}, {_loc}, {_mobType})
        set {_modelName} to yaml value "Mobs.%{_mobType}%.Model" in "WorldQuestList"
        set string tag "ECModelName" of custom nbt of {_mob} to {_modelName}
        modelApply({_mob}, {_modelName}, 1.0)
    else:
        MobInfoAssignments({_mob}, {_loc})

function WorldQuestRespawnMob(mob: entity, loc: location):
    set {_mobType} to string tag "MobType" of custom nbt of {_mob}
    set {_wq} to string tag "WorldQuest" of custom nbt of {_mob}
    clear metadata value "ECSpawnLocation" of {_mob}

    set {_entity} to (yaml value "Mobs.%{_mobType}%.Entity" in "WorldQuestList")
    set {_entity} to "adult %{_entity}%" parsed as entity type

    set {_health} to yaml value "Mobs.%{_mobType}%.Health" in "WorldQuestList"
    set {_level} to yaml value "Mobs.%{_mobType}%.Level" in "WorldQuestList"
    set {_element} to yaml value "Mobs.%{_mobType}%.Element" in "WorldQuestList"
    set {_item} to yaml value "Mobs.%{_mobType}%.Item" in "WorldQuestList"

    wait 5 minutes
    WorldQuestSpawnMob({_loc}, {_wq}, {_mobType}, {_entity}, {_health}, {_level}, {_element}, {_item})

function WorldQuestMobDefeat(p: entity, v: entity):
    set {_worldQuest} to string tag "WorldQuest" of custom nbt of {_v}
    set {_mobType} to string tag "MobType" of custom nbt of {_v}
    set {_loc} to location of {_v}

    set {_requirement} to yaml value "Tasks.Slay Mobs.%{_worldQuest}%.%{_mobType}%.Requirement" in "WorldQuestList"
    set {_collected} to yaml value "Slay Mobs.%{_worldQuest}%.%{_mobType}%.Completed" in "WorldQuests%{_p}%"

    if {_collected} < {_requirement}:
        set {_collected} to {_collected} + 1
        set yaml value "Slay Mobs.%{_worldQuest}%.%{_mobType}%.Completed" in "WorldQuests%{_p}%" to {_collected}

        set {_objectives::*} to getObjectives({_worldQuest}, "Slay Mobs")
        loop {_objectives::*}:
            if loop-value contains "%{_mobType}% slain":
                set {_objective} to loop-value
                stop loop
        replace all "- 0/%{_requirement}% " in {_objective} with ""
        set {_objective} to "<color:yellow>%{_collected}%/%{_requirement}%%nl%<color:white>%{_objective}%"

        sendObjectiveProgressionPacket({_p}, {_loc}, {_objective})
        WorldQuestCollectItemVisual({_p}, {_loc})

        save yaml "WorldQuests%{_p}%"
    if {_collected} = {_requirement}:
        set {_rarity} to yaml value "World Quests.%{_worldQuest}%.Rarity" in "WorldQuestList"
        completeWorldQuest({_p}, {_worldQuest}, {_rarity})

function WorldQuestMobSounds(mob: entity, sounds: strings, pitch: number = 1):
    while {_mob} is alive:
        set {_randomCd} to a random number between 10.0 and 20.0
        set {_wait} to "%{_randomCd}% seconds" parsed as timespan
        set {_sound} to a random element of {_sounds::*}
        play sound {_sound} with volume 1 and pitch {_pitch} at location of {_mob}
        wait {_wait}

function MobInfoAssignments(mob: entity, loc: location, customName: string = ""):
    set {_loops} to 2
    if {_customName} != "":
        set {_loops} to {_loops}+1
    loop {_loops} times:
        spawn an armor stand at {_loc}
        set boolean tag "Marker" of nbt of last spawned armor stand to true
        set boolean tag "Invulnerable" of nbt of last spawned armor stand to true
        set boolean tag "Invisible" of nbt of last spawned armor stand to true
        set boolean tag "CustomNameVisible" of nbt of last spawned armor stand to true
        set boolean tag "NoGravity" of nbt of last spawned armor stand to true

        set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true

        if loop-counter = 1:
            set display name of last spawned armor stand to "&a|||||||||| &f(100%%)"
            set string tag "ECTextAbove" of (custom nbt of {_mob}) to uuid of last spawned armor stand
        else if loop-counter = 2:
            set {_mobLevel} to int tag "ECLvl" of (custom nbt of {_mob})
            set display name of last spawned armor stand to "&4Level %{_mobLevel}%"
            set string tag "ECTextAboveLevel" of (custom nbt of {_mob}) to uuid of last spawned armor stand
        else:
            set display name of last spawned armor stand to {_customName}
            set string tag "ECCustomName" of (custom nbt of {_mob}) to uuid of last spawned armor stand
        push {_mob} upwards with velocity 0.01
    
    wait 2 ticks
    set boolean tag "NoAI" of nbt of {_mob} to true

function getActiveWorldQuests() :: strings:
    return {activeWorldQuests::*}

on region enter:
    loop {activeWorldQuests::*}:
        set {_worldQuest} to loop-value
        set {_WQRegion} to {_worldQuest}
        replace all " " in {_WQRegion} with ""
        if "%event-region%" contains "WorldQuest_%{_WQRegion}%":
            set {_worldQuestType} to yaml value "World Quests.%{_worldQuest}%.Type" in "WorldQuestList"
            if yaml list "Completed World Quests" in "WorldQuests%player%" does not contain {_worldQuest}:
                if metadata value "WorldQuestStarted_%{_WQRegion}%" of player is not set:
                    set metadata value "WorldQuestStarted_%{_WQRegion}%" of player to true
                    set {_questGiver} to yaml value "World Quests.%{_worldQuest}%.Quest Giver" in "WorldQuestList"
                    set {_dialogueIcon} to yaml value "Quest Givers.%{_questGiver}%.Dialogue Icon" in "WorldQuestList"
                    set {_dialogue} to yaml value "Quest Text.%{_worldQuest}%.Dialogue" in "WorldQuestList"
                    set {_faction} to yaml value "Quest Givers.%{_questGiver}%.Faction" in "WorldQuestList"

                    send " " to player
                    send "&e(&6&l!&e) &6Started World Quest: &l%{_worldQuest}%" to player

                    set {_objectives::*} to getObjectives({_worldQuest}, {_worldQuestType})

                    if size of {_objectives::*} > 1:
                        set {_objString} to "Objectives"
                    else:
                        set {_objString} to "Objective"

                    send "&e%{_objString}%:" to player
                    send {_objectives::*} to player

                    portraitDialogue(player, {_dialogueIcon}, {_questGiver}, {_dialogue}, {_faction})
                    WorldQuestDialogueSound(player)

                if {_worldQuestType} = "Collect Things":
                    set {_elements::*} to yaml node keys "Tasks.Collect Things.%{_worldQuest}%" in "WorldQuestList"

                    loop {_elements::*}:
                        set {_requirement} to yaml value "Tasks.Collect Things.%{_worldQuest}%.%loop-value-2%.Requirement" in "WorldQuestList"
                        set {_collected} to yaml value "Collect Things.%{_worldQuest}%.%loop-value-2%.Completed" in "WorldQuests%player%"
                        if {_collected} < {_requirement}:
                            set {_block} to yaml value "Tasks.Collect Things.%{_worldQuest}%.%loop-value-2%.Block" in "WorldQuestList"
                            set {_locations::*} to (yaml list "Locations.%loop-value-2%" in "WorldQuestLocations%{_worldQuest}%")
                            set {_extraData} to yaml value "Tasks.Collect Things.%{_worldQuest}%.%loop-value-2%.Extra Data" in "WorldQuestList"
                            if {_extraData} is set:
                                set {_nbt} to nbt compound from {_extraData}
                            wait 5 ticks
                            loop {_locations::*}:
                                if yaml list "Collect Things.%{_worldQuest}%.%{_element}%.Completed Locations" in "WorldQuests%player%" does not contain loop-value-3:
                                    make player see block at loop-value-3 as {_block}
                                    updateFakeBlock(player, "WorldQuest_%{_WQRegion}%", {_worldQuest}, loop-value-2, loop-value-3, {_block})

                else if {_worldQuestType} = "Slay Mobs":
                    set {_regionPoints::*} to getRegionCenterPoint("%event-region%", player's world)

                    set {_centerPoint} to {_regionPoints::1}
                    set {_radius} to {_regionPoints::2}

                    loop all entities in radius {_radius} around {_centerPoint}:
                        if boolean tag "ECMob" of custom nbt of loop-entity is set:
                            clear boolean tag "NoAI" of nbt of loop-entity
            else:
                if {_worldQuestType} = "Interact With":
                    set {_regionPoints::*} to getRegionCenterPoint("%event-region%", player's world)

                    set {_centerPoint} to {_regionPoints::1}
                    set {_radius} to {_regionPoints::2}

                    loop all entities in radius {_radius} around {_centerPoint}:
                        if boolean tag "WorldQuestInteractEntity" of custom nbt of loop-entity is true:
                            if string tag "WorldQuest" of custom nbt of loop-entity = {_worldQuest}:
                                hide loop-entity for player

on region leave:
    FreezeWorldQuestMobsInRegion(player, "%event-region%")

function FreezeWorldQuestMobsInRegion(p: player, region: string):
    loop {activeWorldQuests::*}:
        set {_worldQuest} to loop-value
        set {_WQRegion} to {_worldQuest}
        replace all " " in {_WQRegion} with ""
        if {_region} contains "WorldQuest_%{_WQRegion}%":
            set {_worldQuestType} to yaml value "World Quests.%{_worldQuest}%.Type" in "WorldQuestList"
            if {_worldQuestType} = "Slay Mobs":
                set {_regionPoints::*} to getRegionCenterPoint({_region}, {_p}'s world)

                set {_centerPoint} to {_regionPoints::1}
                set {_radius} to {_regionPoints::2}
                set {_playerCount} to 0

                loop all players in radius {_radius} around {_centerPoint}:
                    if loop-entity is a player:
                        set {_playerCount} to {_playerCount} + 1

                if {_playerCount} = 1:
                    loop all entities in radius {_radius} around {_centerPoint}:
                        if boolean tag "ECMob" of custom nbt of loop-entity is set:
                            set boolean tag "NoAI" of nbt of loop-entity to true

function UnfreezeWorldQuestMobsInRegion(p: player, region: string):
    loop {activeWorldQuests::*}:
        set {_worldQuest} to loop-value
        set {_WQRegion} to {_worldQuest}
        replace all " " in {_WQRegion} with ""
        if {_region} contains "WorldQuest_%{_WQRegion}%":
            set {_worldQuestType} to yaml value "World Quests.%{_worldQuest}%.Type" in "WorldQuestList"
            if {_worldQuestType} = "Slay Mobs":
                set {_regionPoints::*} to getRegionCenterPoint({_region}, {_p}'s world)

                set {_centerPoint} to {_regionPoints::1}
                set {_radius} to {_regionPoints::2}

                loop all entities in radius {_radius} around {_centerPoint}:
                    if boolean tag "ECMob" of custom nbt of loop-entity is set:
                        clear boolean tag "NoAI" of nbt of loop-entity

    loop all entities in radius {_radius} around {_centerPoint}:
        if boolean tag "ECMob" of custom nbt of loop-entity is set:
            clear boolean tag "NoAI" of nbt of loop-entity

function getRegionCenterPoint(region: string, playerWorld: world) :: objects:
    set {_world} to BukkitAdapter.adapt({_playerWorld})
    set {_manager} to WorldGuard.getInstance().getPlatform().getRegionContainer().get({_world})

    replace all " in world %{_playerWorld}%" in {_region} with ""
    set {_region} to {_manager}.getRegion({_region})

    set {_min} to {_region}.getMinimumPoint()
    set {_max} to {_region}.getMaximumPoint()
    
    set {_minLoc} to location({_min}.getX(), {_min}.getY(), {_min}.getZ(), {_playerWorld})
    set {_maxLoc} to location({_max}.getX(), {_max}.getY(), {_max}.getZ(), {_playerWorld})

    set {_radius} to distance between {_minLoc} and {_maxLoc} / 2

    set {_x} to ({_min}.getX() + {_max}.getX()) / 2
    set {_y} to ({_min}.getY() + {_max}.getY()) / 2
    set {_z} to ({_min}.getZ() + {_max}.getZ()) / 2
    set {_centerPoint} to location({_x}, {_y}, {_z}, {_playerWorld})

    set {_return::*} to {_centerPoint} and {_radius}

    return {_return::*}

function sendObjectiveProgressionPacket(p: player, loc: location, text: string):
    set {_id} to random integer between 100000 and 999999
    set {_players::*} to all players in world "%{_p}'s world%"
    
    loop blocks in radius 2 around {_loc}:
        if loop-block is air:
            if block above loop-block is air:
                set {_loc} to location of loop-block
                stop loop
    spawn fake text display entity at location 0.5 above {_loc} for {_players::*} with id {_id}
    
    set {_text} to mini message from {_text}
    set {_packet} to new metadata packet with id {_id}:
        display text: {_text}
        display billboard: center
        display brightness block: 15
        display brightness sky: 15
        display seethrough: true
    send packet {_packet} to {_players::*}
    
    loop 80 times:
        set {_scale} to 1.0 - (loop-value / 120)
        
        send move entity packet with id {_id} by 0, 51, 0 for {_players::*}
        
        set {_packet} to new metadata packet with id {_id}:
            display scale: vector({_scale}, {_scale}, {_scale})
        send packet {_packet} to {_players::*}
        
        wait 1 tick if loop-counter is divisible by 5
        
    remove fake entity with id {_id} for {_players::*}

on rightclick:
    if "%regions at player%" contains "WorldQuest_":
        loop {activeWorldQuests::*}:
            set {_worldQuest} to loop-value
            if yaml list "Completed World Quests" in "WorldQuests%player%" does not contain {_worldQuest}:
                set {_worldQuestType} to yaml value "World Quests.%{_worldQuest}%.Type" in "WorldQuestList"
                set {_elements::*} to yaml node keys "Tasks.%{_worldQuestType}%.%{_worldQuest}%" in "WorldQuestList"

                set {_unformattedWQ} to {_worldQuest} in lowercase
                replace all " ", "'", "," in {_unformattedWQ} with ""

                if clicked block exists:       
                    if "%regions at clicked block%" contains "WorldQuest_%{_unformattedWQ}%":
                        set {_loc} to location of clicked block
                        loop {_elements::*}:
                            set {_element} to loop-value-2
                            set {_requirement} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Requirement" in "WorldQuestList"
                            set {_collected} to yaml value "%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Completed" in "WorldQuests%player%"
                            if {_worldQuestType} = "Collect Things":
                                if yaml list "Locations.%{_element}%" in "WorldQuestLocations%{_worldQuest}%" contains {_loc}:
                                    if {_collected} < {_requirement}:
                                        set {_locs::*} to yaml list "Collect Things.%{_worldQuest}%.%{_element}%.Completed Locations" in "WorldQuests%player%"
                                        if {_locs::*} does not contain {_loc}:
                                            make player see block at {_loc} as (type of block at {_loc})
                                            set {_collected} to {_collected} + 1
                                            set yaml value "Collect Things.%{_worldQuest}%.%{_element}%.Completed" in "WorldQuests%player%" to {_collected}
                                            set {_locs::*} to {_locs::*} and {_loc}
                                            set yaml list "Collect Things.%{_worldQuest}%.%{_element}%.Completed Locations" in "WorldQuests%player%" to {_locs::*}
                                            save yaml "WorldQuests%player%"
                                            set {_objectives::*} to getObjectives({_worldQuest}, {_worldQuestType})
                                            loop {_objectives::*}:
                                                if loop-value-3 contains "%{_element}% retrieved":
                                                    set {_objective} to loop-value-3
                                                    stop loop
                                            replace all "- 0/%{_requirement}% " in {_objective} with ""
                                            set {_objective} to "<color:yellow>%{_collected}%/%{_requirement}%%nl%<color:white>%{_objective}%"
                                            sendObjectiveProgressionPacket(player, {_loc}, {_objective})
                                            WorldQuestCollectItemVisual(player, {_loc})
                                            set {_sounds::*} to yaml list "Tasks.Collect Things.%{_worldQuest}%.%{_element}%.Sounds" in "WorldQuestList"
                                            loop {_sounds::*}:
                                                play sound loop-value-3 with volume 3 and pitch 1.2 to player
                                            if yaml value "Tasks.Collect Things.%{_worldQuest}%.%{_element}%.Item Drop" in "WorldQuestList" is set:
                                                set {_itemDrop} to yaml value "Tasks.Collect Things.%{_worldQuest}%.%{_element}%.Item Drop" in "WorldQuestList"
                                                set {_closestAirBlock} to getClosestAirBlock(clicked block, 5)
                                                clientSideItem(player, {_closestAirBlock}, {_itemDrop}, 0 seconds, 3 seconds, 1.5)
                                        else:
                                            make player see block at {_loc} as (type of block at {_loc})
                                    if {_collected} = {_requirement}:
                                        set {_rarity} to yaml value "World Quests.%{_worldQuest}%.Rarity" in "WorldQuestList"
                                        completeWorldQuest(player, {_worldQuest}, {_rarity})

                            else if {_worldQuestType} = "Click Around":
                                if cooldown "%location of clicked block%%player%" is finished:
                                    set {_blocks::*} to yaml list "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Blocks" in "WorldQuestList"
                                    set {_itemDrop} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Item Drop" in "WorldQuestList"
                                    set {_chance} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Drop Chance" in "WorldQuestList"
                                    
                                    set {_itemDrop} to {_itemDrop} parsed as itemtype
                                    
                                    if {_blocks::*} contains "%type of clicked block%":
                                        create cooldown "%location of clicked block%%player%" for 1 minute
                                        set {_sounds::*} to yaml list "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Interact Sounds" in "WorldQuestList"
                                        loop {_sounds::*}:
                                            play sound loop-value-3 with volume 3 and pitch 1 to player

                                        chance of {_chance}%:
                                            set {_dropped} to true
                                            WorldQuestAddCompletion(player, {_loc}, {_worldQuest}, {_worldQuestType}, {_element})
                                            set {_closestAirBlock} to getClosestAirBlock(clicked block, 5)
                                            clientSideItem(player, {_closestAirBlock}, {_itemDrop}, 0 seconds, 2 seconds)
                                            set {_sounds::*} to yaml list "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Sounds" in "WorldQuestList"
                                            loop {_sounds::*}:
                                                play sound loop-value-3 with volume 3 and pitch 2 to player

                                        if {_dropped} is not set:
                                            sendObjectiveProgressionPacket(player, {_loc}, "Nothing...")
                                else:
                                    set {_cd} to cooldown "%location of clicked block%%player%"
                                    sendObjectiveProgressionPacket(player, {_loc}, "<color:red>You must wait before interacting with this block again.")

                else if clicked entity exists:
                    if "%regions at clicked entity%" contains "WorldQuest_%{_unformattedWQ}%":
                        if player can see clicked entity:
                            set {_uuid} to uuid of clicked entity
                            set {_loc} to location of clicked entity
                            if {_worldQuestType} = "Interact With":
                                loop {_elements::*}:
                                    set {_element} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%loop-value-2%.Entity" in "WorldQuestList"
                                    set {_requirement} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%loop-value-2%.Requirement" in "WorldQuestList"
                                    set {_collected} to yaml value "%{_worldQuestType}%.%{_worldQuest}%.%loop-value-2%.Completed" in "WorldQuests%player%"
                                    if {_collected} < {_requirement}:
                                        set y of {_loc} to (rounded down y of {_loc})
                                        if yaml list "Locations.%{_element}%" in "WorldQuestLocations%{_worldQuest}%" contains {_loc}:
                                            set {_uuids::*} to yaml list "%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Completed Entities" in "WorldQuests%player%"
                                            if {_uuids::*} does not contain {_uuid}:
                                                if metadata value "cast" of player is not set:
                                                    set {_yamlList} to "%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Completed Entities"
                                                    set {_completed} to "%{_worldQuestType}%.%{_worldQuest}%.%loop-value-2%.Completed"

                                                    set {_objective} to "<color:yellow>%{_collected}+1%/%{_requirement}%%nl%<color:white>%loop-value-2%"
                                                    if string tag "WorldQuestInteractEntityType" of custom nbt of clicked entity = "Azerite Ore":
                                                        WorldQuestAzeriteOreMine(player, clicked entity, "Crystal", {_objective}, {_yamlList}, {_completed}, {_requirement}, {_worldQuest})
                                            else:
                                                send "&c&oYou have already interacted with this &l%{_element}%&c." to player

                                        if string tag "WorldQuestInteractEntityType" of custom nbt of clicked entity = "Eclair Goat":
                                            if cooldown "EclairGoatHarvest%uuid of clicked entity%" is finished:
                                                create cooldown "EclairGoatHarvest%uuid of clicked entity%" for 30 seconds
                                                
                                                EclairGoatCooldown(clicked entity)
                                                set {_randomPointlessQuote} to a random integer between 1 and 3
                                                if {_randomPointlessQuote} = 1:
                                                    send "&fEclair Goat >> This is how the cookie crumbles, my dear..." to player
                                                else if {_randomPointlessQuote} = 2:
                                                    send "&fEclair Goat >> The leaf that falls in the morning is rarely the same leaf that regrets the afternoon..." to player
                                                else:
                                                    send "&fEclair Goat >> If the mountain moves, it is likely because it has found better rent elsewhere..."  to player
                                                set target of clicked entity to player
                                                EclairGoatInteraction(player, clicked entity)
                                                stop
                                                
                                            else:
                                                send "&fEclair Goat >> &fThe cream is currently meditating. Do not disturb its internal fluffiness."   to player
                                                stop

function WorldQuestAddCompletion(p: player, loc: location, worldQuest: string, worldQuestType: string, element: string, collected: number = 0):
    set {_requirement} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Requirement" in "WorldQuestList"
    if {_collected} = 0:
        set {_collected} to yaml value "%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Completed" in "WorldQuests%{_p}%"
        set {_collected} to {_collected} + 1
    set yaml value "%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Completed" in "WorldQuests%{_p}%" to {_collected}
    
    save yaml "WorldQuests%{_p}%"

    set {_objectives::*} to getObjectives({_worldQuest}, {_worldQuestType})
    loop {_objectives::*}:
        if loop-value contains {_element}:
            set {_objective} to loop-value
            stop loop
    replace all "- 0/%{_requirement}% " in {_objective} with ""
    set {_objective} to "<color:yellow>%{_collected}%/%{_requirement}%%nl%<color:white>%{_objective}%"
    sendObjectiveProgressionPacket({_p}, {_loc}, {_objective})
    WorldQuestCollectItemVisual({_p}, {_loc})

    if {_collected} = {_requirement}:
        set {_rarity} to yaml value "World Quests.%{_worldQuest}%.Rarity" in "WorldQuestList"
        completeWorldQuest({_p}, {_worldQuest}, {_rarity})

function getObjectives(worldQuest: string, worldQuestType: string) :: strings:
    set {_worldQuestType} to yaml value "World Quests.%{_worldQuest}%.Type" in "WorldQuestList"
    set {_objectiveItems::*} to yaml node keys "Tasks.%{_worldQuestType}%.%{_worldQuest}%" in "WorldQuestList"
    loop {_objectiveItems::*}:
        set {_requirement} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%loop-value%.Requirement" in "WorldQuestList"
        set {_objective} to yaml value "Tasks.%{_worldQuestType}%.Objective" in "WorldQuestList"
        set {_requirementName} to loop-value
        replace all "{COMPLETED}" in {_objective} with "0"
        replace all "{MOBNAME}" in {_objective} with loop-value
        replace all "{REQUIREMENT}" in {_objective} with "%{_requirement}%"
        replace all "{REQUIREMENT}" in {_questText} with "%{_requirement}%"
        replace all "{ITEMNAME}" in {_objective} with "%loop-value% retrieved"
        replace all "{NAME}" in {_objective} with {_requirementName}
        add "- %{_objective}%" to {_objectives::*}
    return {_objectives::*}

function updateFakeBlock(p: player, region: string, worldQuest: string, element: string, loc: location, block: itemtype):
    while "%regions at {_p}%" contains {_region}:
        make {_p} see block at {_loc} as {_block}
        wait 2 seconds
        if {_p} is online:
            if any:
                yaml list "Collect Things.%{_worldQuest}%.%{_element}%.Completed Locations" in "WorldQuests%{_p}%" contains {_loc}
                {_collected} = {_requirement}
                {_p} is not online
            then:
                make {_p} see block at {_loc} as (type of block at {_loc})
                stop
            set {_requirement} to yaml value "Tasks.Collect Things.%{_worldQuest}%.%{_element}%.Requirement" in "WorldQuestList"
            set {_collected} to yaml value "Collect Things.%{_worldQuest}%.%{_element}%.Completed" in "WorldQuests%{_p}%"

function completeWorldQuest(p: player, worldQuest: string, rarity: string):
    broadcast "yaa"
    add {_worldQuest} to yaml list "Completed World Quests" in "WorldQuests%{_p}%"
    save yaml "WorldQuests%{_p}%"

    if {_rarity} = "Rare":
        rareWorldQuestCompletionVisual({_p})
        send "&9(<##0070dd>&l!&9) &fYou completed the World Quest <##0070dd>&l%{_worldQuest}%&f." to {_p}
        set {_colour} to "<##0070dd>"
            
    else if {_rarity} = "Epic":
        epicWorldQuestCompletionVisual({_p})
        send "&5(<##a335ee>&l!&5) &fYou completed the World Quest <##a335ee>&l%{_worldQuest}%&f." to {_p}
        set {_colour} to "<##a335ee>"

    WorldQuestCompleteSound({_p})

    set {_questGiver} to yaml value "World Quests.%{_worldQuest}%.Quest Giver" in "WorldQuestList"
    set {_dialogueIcon} to yaml value "Quest Givers.%{_questGiver}%.Dialogue Icon" in "WorldQuestList"
    set {_dialogue} to a random element of yaml list "Quest Text.%{_worldQuest}%.Completion" in "WorldQuestList"
    set {_faction} to yaml value "Quest Givers.%{_questGiver}%.Faction" in "WorldQuestList"
    portraitDialogue({_p}, {_dialogueIcon}, {_questGiver}, {_dialogue}, {_faction})

    loop {activeWorldQuests::*}:
        if loop-value = {_worldQuest}:
            set {_index} to loop-counter
            stop loop

    broadcast "this"
    stop

    set {_rewardName} to {activeWorldQuestsRewards::%{_index}%}
    set {_rewardType} to yaml value "Rewards.%{_rewardName}%.Type" in "WorldQuestList"
    set {_rewardAmount} to yaml value "Rewards.%{_rewardName}%.Amount" in "WorldQuestList"

    set {_EXP} to yaml value "World Quests.%{_worldQuest}%.EXP" in "WorldQuestList"
    set {_reputation} to yaml value "World Quests.%{_worldQuest}%.Reputation" in "WorldQuestList"

    send "&fRewards:" to {_p}
    if {_rewardType} = "Item":
        set {_reward} to yaml value "%{_rewardName}%.Item" in "ItemList"
        set {_icon} to yaml value "%{_rewardName}%.Icon" in "ItemList"
        giveItem({_p}'s uuid, {_rewardAmount} of {_reward})

        set {_obj::1} to text component of "&f- %{_colour}%%{_rewardAmount}%x "
        set {_obj::2} to object text component with sprite {_icon}
        set {_obj::3} to text component of " %uncolored name of {_reward}%"
        set {_obj} to merge components {_obj::*}

        send component {_obj} to {_p}

    else if {_rewardType} = "Azerite":
        addAzerite({_p}, {_rewardAmount})

    send formatted "&f- %{_colour}%%{_EXP}% &fPlayer EXP" to {_p}
    send formatted "&f- %{_colour}%%{_reputation}% &fReputation with %{_questGiver}%" to {_p}

    addReputation({_p}, {_questGiver}, {_reputation})

    set {_reputationLevel} to yaml value "%{_questGiver}%.Reputation Level" in "Reputation%{_p}%"
    set {_reputationCurrent} to yaml value "%{_questGiver}%.Reputation" in "Reputation%{_p}%"

    set {_nextReputationLevel} to {_reputationLevel} + 1
    if {_nextReputationLevel} = 11:
        set {_reputationLevel} to "&e👑 &fParagon"
        set {_nextReputationLevel} to ""
        set {_reputationRequired} to yaml value "Reputation EXP Requirements.10" in "ReputationRequirements"
        set {_reputationSquareColour} to "&6"
        set {_nextLevel} to "Paragon"
    else:
        set {_reputationRequired} to yaml value "Reputation EXP Requirements.%{_nextReputationLevel}%" in "ReputationRequirements"
        set {_reputationSquareColour} to "&a"
        set {_nextLevel} to {_nextReputationLevel}
        set {_nextReputationLevel} to " %{_nextReputationLevel}%"  

    set {_percentageReputation} to round(({_reputationCurrent}/{_reputationRequired})*100, 1)
    set {_roundedReputation} to round({_percentageReputation}/10, 0)
    set {_reputationSquares} to squaresReputation()

    set {_text1} to first {_roundedReputation} characters of {_reputationSquares}
    if {_text1} is not set:
        set {_text1} to ""
    set {_text2} to last (length of {_reputationSquares}-{_roundedReputation}) characters of {_reputationSquares}
    set {_reputationSquares} to "%{_reputationSquareColour}%%{_text1}%&7%{_text2}%"
    send formatted "  %{_colour}% &f%{_reputationLevel}% %{_reputationSquares}%&f%{_nextReputationLevel}% &7(%{_percentageReputation}%%%) &8%{_reputationCurrent}%/%{_reputationRequired}%" to {_p}

    #addPlayerXP({_p},{_EXP}, 1, "World Quest")
    #add to player stats

function WorldQuestCollectItemVisual(p: player, loc: location):
    draw 20 of blue dust particle of size 1.2 with extra value 0.5 at {_loc}
    set {_y} to 0
    loop 20 times:
        add 0.012 to {_y}
        set {_angle} to loop-value * 32

        add 0.24 * sin({_angle}) to x-coord of {_loc}
        add 0.24 * cos({_angle}) to z-coord of {_loc}
        
        add {_y} to y-coord of {_loc}
        
        if loop-counter is divisible by 2:
            draw 1 of copper flame particle with extra value 0.02 at {_loc}
        else:
            draw 1 of soul fire flame particle with extra value 0.02 at {_loc}
        if loop-counter is divisible by 3:
            draw 2 of cyan dust particle of size 0.7 with extra value 0 at {_loc}
            
        wait 1 tick

function WorldQuestDialogueSound(p: player):
    play sound "block.trial_spawner.detect_player" with volume 1.2 and pitch 1.8 to {_p}
    wait 1 tick
    play sound "block.note_block.chime" with volume 1.0 and pitch 2.0 to {_p}
    wait 1 tick
    play sound "block.vault.open_shutter" with volume 0.7 and pitch 1.4 to {_p}

    loop 3 times:
        play sound "ui.button.click" with volume 0.5 and pitch 2.0 to {_p}
        wait 1 tick

    play sound "entity.villager.yes" with volume 2 and pitch 0.7 to {_p}

function WorldQuestCompleteSound(p: player):
    loop 4 times:
        set {_pitch} to 1.2 + (loop-value * 0.2)
        play sound "block.note_block.chime" with volume 1.0 and pitch {_pitch} at {_p}
        play sound "ui.button.click" with volume 0.3 and pitch ({_pitch} + 0.5) at {_p}
        wait 1 tick

    wait 1 tick
    play sound "block.trial_spawner.spawn_item" with volume 1.5 and pitch 1.2 at {_p}
    play sound "block.vault.insert_item" with volume 1.2 and pitch 0.8 at {_p}
    play sound "block.amethyst_block.chime" with volume 0.5 and pitch 1.0 at {_p}

    play sound "entity.villager.yes" with volume 2 and pitch 1 to {_p}

function epicWorldQuestCompletionVisual(p: player):
    set {_loc} to location of {_p}
    
    play sound "block.respawn_anchor.ambience" with volume 1.0 and pitch 0.5 at {_p}
    
    loop 15 times:
        set {_pitch} to 0.4 + (loop-value * 0.1)
        play sound "block.amethyst_block.chime" with volume 1.2 and pitch {_pitch} at {_p}
        play sound "entity.warden.heartbeat" with volume 0.5 and pitch ({_pitch} + 0.5) at {_p}

        set {_y} to (loop-value * 0.4)
        set {_angle} to (loop-value * 40)
        set {_radius} to 0.5 + (loop-value * 0.2)
        
        set {_v1} to vector(cos({_angle}) * {_radius}, {_y}, sin({_angle}) * {_radius})
        set {_v2} to vector(cos({_angle} + 180) * {_radius}, {_y}, sin({_angle} + 180) * {_radius})

        draw 5 of witch particle with extra value 0.05 with offset vector(0.1, 0.1, 0.1) at {_loc} ~ {_v1}
        draw 3 of rgb(255, 105, 180) dust particle of size 1.5 that transitions to rgb(255, 255, 255) with extra value 0.02 with offset vector(0.1, 0.1, 0.1) at {_loc} ~ {_v2}
        
        if loop-counter is divisible by 3:
            draw 1 of white flash particle with extra value 0 with offset vector(0, 0, 0) at {_loc} ~ vector(0, {_y}, 0)
            play sound "block.amethyst_block.place" with volume 0.4 and pitch 2.0 at {_loc} ~ vector(0, {_y}, 0)

        wait 1 tick
    set {_top} to {_loc} ~ vector(0, 6, 0)
    play sound "entity.warden.sonic_boom" with volume 1.5 and pitch 2 at {_p}
    play sound "entity.player.levelup" with volume 2.0 and pitch 0 at {_p}

    draw 100 of soul particle with extra value 0.2 with offset vector(3, 3, 3) at {_top}
    draw 100 of dragon breath particle with extra value 0.1 with offset vector(2, 2, 2) at {_top}
    draw 50 of ominous trial spawner detection particle with extra value 0.15 with offset vector(1, 1, 1) at {_top}
    draw 30 of white flash particle with extra value 0.1 with offset vector(0.5, 0.5, 0.5) at {_top}

function rareWorldQuestCompletionVisual(p: player):
    set {_loc} to location of {_p}
    #set {_blueGlass} to Bukkit.createBlockData("blue_stained_glass")

    play sound "block.respawn_anchor.charge" with volume 0.5 and pitch 1.5 at {_p}
    loop 6 times:
        set {_pitch} to 0.8 + (loop-value * 0.2)
        play sound "block.amethyst_block.chime" with volume 1.0 and pitch {_pitch} at {_p}
        play sound "entity.allay.item_thrown" with volume 0.7 and pitch ({_pitch} + 0.3) at {_p}
        
        set {_angle} to (loop-value * 60)
        set {_v} to vector(cos({_angle}) * 1.8, 1.5, sin({_angle}) * 1.8)
        draw 5 of soul fire flame particle with extra value 0.05 with offset vector(0.2, 0.2, 0.2) at {_loc} ~ {_v}
        draw 3 of rgb(95, 218, 237) dust particle of size 1.5 that transitions to rgb(255, 255, 255) with extra value 0.02 with offset vector(0.1, 0.1, 0.1)  at {_loc} ~ {_v}
        wait 3 ticks

    play sound "block.vault.insert_item" with volume 1.5 and pitch 0.6 at {_p}
    play sound "entity.firework_rocket.large_blast" with volume 1.0 and pitch 1.2 at {_p}
    
    draw 40 of soul fire flame particle with extra value 0.1 with offset vector(1.5, 2, 1.5) at {_p} ~ vector(0, 2, 0)
    draw 20 of rgb(95, 218, 237) dust particle of size 1.5 that transitions to rgb(255, 255, 255) with extra value 0.1 with offset vector(1.5, 2, 1.5) at {_p} ~ vector(0, 2, 0)
    draw 20 of blue stained glass block particle with extra value 0.2 with offset vector(1, 1, 1) at {_p} ~ vector(0, 3, 0)

function defineWGRegion(id: string, loc1: location, loc2: location):
    set {_regionContainer} to WorldGuard.getInstance().getPlatform().getRegionContainer()
    set {_adapter} to {_regionContainer}.get(BukkitAdapter.adapt({_loc1}.getWorld()))
    
    stop if {_adapter} is not set

    set {_minV} to BlockVector3.at({_loc1}.getX(), {_loc1}.getY(), {_loc1}.getZ())
    set {_maxV} to BlockVector3.at({_loc2}.getX(), {_loc2}.getY(), {_loc2}.getZ())

    set {_region} to new ProtectedCuboidRegion({_id}, {_minV}, {_maxV})
    {_adapter}.addRegion({_region})

function undefineWGRegion(id: string, world: world):
    set {_regionContainer} to WorldGuard.getInstance().getPlatform().getRegionContainer()
    set {_adapter} to {_regionContainer}.get(BukkitAdapter.adapt({_world}))

    stop if {_adapter} is not set

    {_adapter}.removeRegion({_id})

function DeleteWorldQuestMarkers():
    set {_dynmap} to Bukkit.getPluginManager().getPlugin("dynmap")
    set {_markerApi} to {_dynmap}.getMarkerAPI()
    set {_markerSet} to {_markerApi}.getMarkerSet("WorldQuests")
    
    loop {worldQuestCount} times:
        set {_existingMarker} to {_markerSet}.findMarker("%loop-counter%")
        {_existingMarker}.deleteMarker()
    
    loop {activeWorldQuests::*}:
        set {_WGName} to loop-value
        replace all " " in {_WGName} with ""
        set {_WGRegion} to "WorldQuest_%{_WGName}%"

        set {_loc} to yaml value "World Quests.%loop-value%.Location" in "WorldQuestList"
        set {_world} to world of {_loc}
        undefineWGRegion({_WGRegion}, {_world})

    set {worldQuestCount} to 0

function WorldQuestRegionSpawn(worldQuest: string) :: locations:
    set {_WQLocation} to yaml value "World Quests.%{_worldQuest}%.Location" in "WorldQuestList"
    load yaml "plugins/Skript/worldquests/%{_worldQuest}%" as "WorldQuestLocations%{_worldQuest}%"

    if {_WQLocation} = "random":
        set {_WQLocation} to a random element of (yaml list "Locations" in "WorldQuestLocations%{_worldQuest}%")
    
    set {_WQLocationMin} to {_WQLocation}
    set {_WQLocationMax} to {_WQLocation}

    set {_regionExpand} to yaml value "World Quests.%{_worldQuest}%.Region Expand" in "WorldQuestList"

    increase x of {_WQLocationMin} by -1*{_regionExpand}
    increase y of {_WQLocationMin} by -100
    increase z of {_WQLocationMin} by -1*{_regionExpand}
    increase x of {_WQLocationMax} by {_regionExpand}
    increase y of {_WQLocationMax} by 100
    increase z of {_WQLocationMax} by {_regionExpand}

    set {_WGName} to {_worldQuest}
    replace all " " in {_WGName} with ""
    set {_WGRegion} to "WorldQuest_%{_WGName}%"
    defineWGRegion({_WGRegion}, {_WQLocationMin}, {_WQLocationMax})

    set {_locations::*} to {_WQLocation}, {_WQLocationMin}, {_WQLocationMax}

    return {_locations::*}

function CreateWorldQuest(worldQuests: integer):
    #Remove last week's World Quests
    DeleteWorldQuestMarkers()
    clear {activeWorldQuests::*}
    clear {activeWorldQuestsRewards::*}
    
    set {_worldQuestList::*} to yaml node keys "World Quests" in "WorldQuestList"
    loop {_worldQuests} times:
        stop loop if size of {_worldQuestList::*} = 0
        set {_randomWorldQuest} to a random element of {_worldQuestList::*}
        remove {_randomWorldQuest} from {_worldQuestList::*}
        add {_randomWorldQuest} to {activeWorldQuests::*}

        set {_worldQuestType} to yaml value "World Quests.%{_randomWorldQuest}%.Type" in "WorldQuestList"
        
        set {_WQLocations::*} to WorldQuestRegionSpawn({_randomWorldQuest})

        set {_WQLocation} to {_WQLocations::1}
        set {_WQLocationMin} to {_WQLocations::2}
        set {_WQLocationMax} to {_WQLocations::3}

        set {_plugin} to instance of plugin "Skript"

        loop all chunks within {_WQLocationMin} and {_WQLocationMax}:
            set {_chunk} to loop-chunk
            set {_chunkLoc} to block at 0,0,0 in {_chunk}
            {_chunk}.addPluginChunkTicket({_plugin})
            set {_chunk} to {_chunk}.getWorld().getChunkAtAsync({_chunkLoc})
            set {_actualChunk} to {_chunk}.join()
            wait 1 tick if loop-counter-2 is divisible by 20

        set {_worldQuestRarity} to yaml value "World Quests.%{_randomWorldQuest}%.Rarity" in "WorldQuestList"
        set {_worldQuestGiver} to yaml value "World Quests.%{_randomWorldQuest}%.Quest Giver" in "WorldQuestList"
        set {_worldQuestFaction} to yaml value "Quest Givers.%{_worldQuestGiver}%.Faction" in "WorldQuestList"
        set {_worldQuestLocation} to yaml value "World Quests.%{_randomWorldQuest}%.Location Name" in "WorldQuestList"
        set {_npcIcon} to yaml value "Quest Givers.%{_worldQuestGiver}%.Quest Icon" in "WorldQuestList"
        set {_questText} to yaml value "Quest Text.%{_randomWorldQuest}%.Dialogue" in "WorldQuestList"
        set {_rewards::*} to yaml list "World Quests.%{_randomWorldQuest}%.Rewards" in "WorldQuestList"
        set {_reward} to a random element of {_rewards::*}
        set {activeWorldQuestsRewards::%loop-counter%} to {_reward}
        set {_rewardImage} to yaml value "Rewards.%{_reward}%.Image link" in "WorldQuestList"
        set {_rewardDescription} to yaml value "Rewards.%{_reward}%.Description" in "WorldQuestList"
        set {_EXP} to yaml value "World Quests.%{_randomWorldQuest}%.EXP" in "WorldQuestList"
        set {_reputation} to yaml value "World Quests.%{_randomWorldQuest}%.Reputation" in "WorldQuestList"

        WorldQuestSpawn({_randomWorldQuest})

        if {_worldQuestRarity} = "Normal":
            set {_colour} to "#00ff00"
        else if {_worldQuestRarity} = "Rare":
            set {_colour} to "#0070dd"
        else if {_worldQuestRarity} = "Epic":
            set {_colour} to "#a335ee"

        set {_objectives::*} to getObjectives({_randomWorldQuest}, {_worldQuestType})
        set {_objectiveItems::*} to yaml node keys "Tasks.%{_worldQuestType}%.%{_randomWorldQuest}%" in "WorldQuestList"
        loop {_objectiveItems::*}:
            set {_requirementName} to loop-value-2

        set {_html} to join (yaml list "HTML" in "WorldQuestHTML") by ""
        replace all "{WORLDQUEST}" in {_html} with {_randomWorldQuest}
        replace all "{FACTION}" in {_html} with {_worldQuestFaction}
        replace all "{NPCNAME}" in {_html} with {_worldQuestGiver}
        replace all "{COLOUR}" in {_html} with {_colour}
        replace all "{OBJECTIVE}" in {_html} with (join {_objectives::*} by "<br>")
        replace all "{QUESTTEXT}" in {_html} with {_questText}
        replace all "{NPCICON}" in {_html} with {_npcIcon}
        replace all "{REWARDNAME}" in {_html} with {_reward}
        replace all "{REWARDIMAGE}" in {_html} with {_rewardImage}
        replace all "{REWARDDESCRIPTION}" in {_html} with {_rewardDescription}
        replace all "{EXP}" in {_html} with "%{_EXP}%"
        replace all "{REPUTATION}" in {_html} with "%{_reputation}%"
        replace all "{LOCATION}" in {_html} with {_worldQuestLocation}
        replace all "{NAME}" in {_html} with {_requirementName}
        
        set {_y} to y of {_WQLocation}

        set {worldQuestCount} to {worldQuestCount} + 1
        addDynmapWorldQuestMarker({_html}, {worldQuestCount}, {_WQLocation})
        clear {_objectives::*}

function NewWorldQuests():
    clearAllYamlKeys("plugins/Skript/playerdata/worldquests")
    CreateWorldQuest(10)
    
function addDynmapWorldQuestMarker(label: text, id: integer, WQLocation: location):
    set {_x} to x of {_WQLocation}
    set {_y} to y of {_WQLocation}
    set {_z} to z of {_WQLocation}

    set {_world} to "%world of {_WQLocation}%"

    set {_dynmap} to Bukkit.getPluginManager().getPlugin("dynmap")
    set {_markerApi} to {_dynmap}.getMarkerAPI()

    set {_markerSet} to {_markerApi}.getMarkerSet("WorldQuests")
    set {_icon} to {_markerApi}.getMarkerIcon("questmarker")

    set {_marker} to {_markerSet}.createMarker("%{_id}%", " ", {_world}, {_x}, {_y}, {_z}, {_icon}, true)
    {_marker}.setLabel({_label}, true)
    
command /wqtest:
    trigger:
        loop getActiveWorldQuests():
            set {_l} to loop-value
            replace all " " in {_l} with ""
            loop all players:
                clear metadata value "WorldQuestStarted_%{_l}%" of loop-player

function clearAllYamlKeys(path: string):
    set {_dir} to new File({_path})
    
    if {_dir}.isDirectory() is false:
        broadcast "&c[Error] The path '%{_path}%' is not a valid directory."
        stop

    set {_files::*} to ...{_dir}.listFiles()
    set {_count} to 0
    
    loop {_files::*}:
        set {_file} to loop-value
        set {_name} to {_file}.getName()
        
        set {_writer} to new PrintWriter({_file})
        {_writer}.print("")
        {_writer}.close()
        set {_count} to {_count} + 1

function WorldQuestCombatEngage(e: entity):
    clear boolean tag "NoAI" of nbt of {_e}
    set {_mobType} to string tag "MobType" of custom nbt of {_e}
    replace all " " in {_mobType} with ""
    set {_function} to function named "WorldQuest%{_mobType}%"
    if {_function} is set:
        execute {_function} with arguments {_e}

expression [model] height of %entity%:
    get:
        set {_handle} to (expr-1).getHandle()
        return {_handle}.getBbHeight()

function WorldQuestAzeriteOreMine(p: player, e: entity, typeOfOre: string, objective: string, yamlList: string, completed: string, requirement: integer, worldQuest: string):
    if {_typeOfOre} = "Crystal":
        set {_casttime} to 7 seconds
        set {_above} to 2
        set {_particle} to 20
        set {_sound} to "azerite.collect"
        set {_modelName} to "azeritecrystal"
    else if {_typeOfOre} = "Chunk":
        set {_casttime} to 6 seconds
        set {_above} to 1
        set {_particle} to 12
        set {_sound} to "azerite.collect_small"
    else if {_typeOfOre} = "Shard":
        set {_casttime} to 5 seconds
        set {_above} to 1
        set {_particle} to 8
        set {_sound} to "azerite.collect_small"
    else if {_typeOfOre} = "Chest":
        set {_casttime} to 5 seconds
        set {_above} to 1
        set {_nodeName} to "Wooden Strongbox"
        set {_sound} to "azerite.collect_small"
    else if {_typeOfOre} = "ChestBig":
        set {_casttime} to 6 seconds
        set {_above} to 1
        set {_nodeName} to "Reinforced Chest"
        set {_sound} to "azerite.collect"
    else if {_typeOfOre} = "OldChest":
        set {_casttime} to 6 seconds
        set {_above} to 1
        set {_nodeName} to "Old Chest"
        set {_sound} to "azerite.collect"
    else if {_typeOfOre} = "Sack":
        set {_casttime} to 6 seconds
        set {_above} to 1
        set {_nodeName} to a random element of "Bag of Azerite" and "Azerite Sack"
        set {_sound} to "azerite.collect"
    
    set {_distance} to 6
    set {_castTimeValue} to "%{_casttime}%"
    replace all " seconds" and " second" in {_castTimeValue} with ""
    set {_castTimeValue} to {_castTimeValue} parsed as number
    set {_originalCastTimeValue} to {_castTimeValue}

    if metadata value "cast" of {_p} is not set:
        set metadata value "mining" of {_p} to true
        set metadata value "cast" of {_p} to {_casttime}
        set {_break} to 0
        if {_nonOre::*} contains {_typeOfOre}:
            play sound "azerite.chest_loop" with volume 2 and pitch 1 to {_p}
        while metadata value "mining" of {_p} = true:
            if metadata value "channeling" of {_p} is set:
                clear metadata value "channeling" of {_p}
            if metadata value "cast" of {_p} is not set:
                clear metadata value "mining" of {_p}
                stop sound "azerite.chest_loop" for {_p}
                stop
            if distance between {_p} and {_e} > {_distance}:
                stop sound "azerite.chest_loop" for {_p}
                stop loop
            if {_casttime} > 0 seconds:
                set metadata value "casttimeleft" of {_p} to {_casttime}
                send action bar "Mining... %{_casttime}% " to {_p}
                if {_castTimeValue} is divisible by 1:
                    make {_p} swing their hand
                    add 1/{_originalCastTimeValue} to {_break}

                    set {_nearestModel} to nearest interaction relative to {_e}
                    set {_particleLoc} to location of {_nearestModel}

                    if {_typeOfOre} contains "Chest":
                        play sound "entity.zombie.attack_wooden_door" with volume 2 and pitch 2 at ({_particleLoc})
                        draw 10 of jungle wood block particle with extra value 0.04 with offset vector({_above}/5, {_above}/2, {_above}/5) at location {_above} above {_particleLoc}
                    else if {_typeOfOre} = "Sack":
                        play sound "block.wool.break" with volume 2 and pitch 2 at ({_particleLoc})
                        play sound "block.wool.place" with volume 2 and pitch 2 at ({_particleLoc})
                        play sound "block.wool.step" with volume 2 and pitch 2 at ({_particleLoc})
                        play sound "entity.llama.swag" with volume 2 and pitch 0.5 at ({_particleLoc})
                        draw 10 of brown wool block particle with extra value 0.04 with offset vector({_above}/5, {_above}/2, {_above}/5) at location {_above} above {_particleLoc}
                    else:
                        play sound "misc.mine_ore" with volume 2 and pitch 1 at ({_particleLoc})
                        draw {_particle} of diamond block particle with extra value 0.04 with offset vector({_above}/3.2, {_above}/2, {_above}/3.2) at location {_above} above {_particleLoc}
                        set {_block} to gold block
                        draw {_particle} of {_block} block particle with extra value 0.04 with offset vector({_above}/3.2, {_above}/2, {_above}/3.2) at location {_above} above {_particleLoc}
                    
                wait 0.1 seconds
                remove 0.1 seconds from {_casttime}
                remove 0.1 from {_castTimeValue}
            else:
                clear metadata value "mining" of {_p}
                send action bar "" to {_p}
    else:
        stop
        
    clear metadata value "mining" of {_p}
    clear metadata value "cast" of {_p}
    clear metadata value "casttime" of {_p}
    
    if {_casttime} > 0 seconds:
        send action bar "&cCancelled" to {_p}
        stop sound "azerite.chest_loop" for {_p}
        stop

    set {_uuids::*} to yaml list {_yamlList} in "WorldQuests%{_p}%"
    if {_uuids::*} does not contain (uuid of {_e}):
        set {_uuids::*} to {_uuids::*} and uuid of {_e}
    set yaml list {_yamlList} in "WorldQuests%{_p}%" to {_uuids::*}

    set {_completedEntities} to yaml value {_completed} in "WorldQuests%{_p}%"
    set {_completedEntities} to {_completedEntities} + 1
    set yaml value {_completed} in "WorldQuests%{_p}%" to {_completedEntities}

    save yaml "WorldQuests%{_p}%"

    sendObjectiveProgressionPacket({_p}, {_particleLoc}, {_objective})

    if {_completedEntities} = {_requirement}:
        set {_rarity} to yaml value "World Quests.%{_worldQuest}%.Rarity" in "WorldQuestList"
        completeWorldQuest({_p}, {_worldQuest}, {_rarity})

        set {_WQRegion} to {_worldQuest}
        replace all " " in {_WQRegion} with ""
        set {_region} to "WorldQuest_%{_WQRegion}%"

        set {_regionPoints::*} to getRegionCenterPoint("%{_region}%",{_p}'s world)

        set {_centerPoint} to {_regionPoints::1}
        set {_radius} to {_regionPoints::2}

        loop all entities in radius {_radius} around {_centerPoint}:
            if boolean tag "WorldQuestInteractEntity" of custom nbt of loop-entity is true:
                hide loop-entity for {_p}

    set {_tracker} to EntityTrackerRegistry.registry(uuid of {_e}).tracker({_modelName})
    if {_tracker} is set:
        stop sound "azerite.chest_loop" for {_p}
        if {_typeOfOre} contains "Chest":
            {_tracker}.animate("chestopen")
            play sound "block.chest.open" with volume 2 and pitch 2 at (location of {_e})
            wait {_waitTime}
            play sound "entity.zombie.break_wooden_door" with volume 2 and pitch 2 at (location of {_e})
        else if {_typeOfOre} = "Crystal" or "Chunk":
            play sound "profession.gem.put_down" with volume 2 and pitch 0.5 at (location of {_e})
            play sound "block.ancient_debris.break" with volume 2 and pitch 1.5 at (location of {_e})
            draw {_particle} of ancient debris block particle with extra value 0.04 with offset vector({_above}/3.2, {_above}/2, {_above}/3.2) at location {_above}-1 above {_particleLoc}
            draw {_particle} of ancient debris block particle with extra value 0.04 with offset vector({_above}/3.2, {_above}/2, {_above}/3.2) at location {_above}-1 above {_particleLoc}
        
        play sound {_sound} with volume 2 and pitch 1 at (location of {_e})

    WorldQuestCollectItemVisual({_p}, location {_above}-1 above {_particleLoc})

    hide {_e} for {_p}

on tame:
    if boolean tag "WorldQuestInteractEntity" of custom nbt of event-entity is set:
        if tamer is a player:
            set {_worldQuest} to string tag "WorldQuest" of custom nbt of event-entity
            set {_worldQuestType} to string tag "WorldQuestType" of custom nbt of event-entity

            play sound "entity.horse.armor" with volume 3 and pitch 1.05 to tamer
            set {_entityType} to string tag "WorldQuestInteractEntityType" of custom nbt of event-entity

            set {_elements::*} to yaml node keys "Tasks.%{_worldQuestType}%.%{_worldQuest}%" in "WorldQuestList"
            loop {_elements::*}:
                if yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%loop-value%.Entity" in "WorldQuestList" = {_entityType}:
                    set {_element} to loop-value

                    set {_uuids::*} to yaml list "%{_worldQuestType}%.%{_worldQuest}%.%{_entityType}%.Completed Entities" in "WorldQuests%tamer%"
                    if {_uuids::*} does not contain (uuid of event-entity):
                        set {_uuids::*} to {_uuids::*} and uuid of event-entity
                    set yaml list "%{_worldQuestType}%.%{_worldQuest}%.%{_entityType}%.Completed Entities" in "WorldQuests%tamer%" to {_uuids::*}

                    set {_completedEntities} to yaml value "%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Completed" in "WorldQuests%tamer%"
                    set {_completedEntities} to {_completedEntities} + 1
                    set yaml value "%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Completed" in "WorldQuests%tamer%" to {_completedEntities}

                    save yaml "WorldQuests%tamer%"

                    set {_requirement} to yaml value "Tasks.%{_worldQuestType}%.%{_worldQuest}%.%{_element}%.Requirement" in "WorldQuestList"
                    set {_objective} to "<color:yellow>%{_completedEntities}%/%{_requirement}%%nl%<color:white>%{_element}%"

                    sendObjectiveProgressionPacket(tamer, location of event-entity, {_objective})
                    WorldQuestCollectItemVisual(tamer, location above event-entity)

                    loop 3 times:
                        set {_randomOffset::%loop-counter-2%} to a random number between 0.0 and 1.0
                        draw 8 of heart particle with extra value 0.01 with offset vector({_randomOffset::1}, {_randomOffset::2}, {_randomOffset::3}) at location 0.75 above event-entity

                    make tamer dismount
                    untame event-entity
                    hide event-entity for tamer

                    if {_completedEntities} = {_requirement}:
                        set {_rarity} to yaml value "World Quests.%{_worldQuest}%.Rarity" in "WorldQuestList"
                        completeWorldQuest(tamer, {_worldQuest}, {_rarity})

                        set {_WQRegion} to {_worldQuest}
                        replace all " " in {_WQRegion} with ""
                        set {_region} to "WorldQuest_%{_WQRegion}%"

                        set {_regionPoints::*} to getRegionCenterPoint("%{_region}%", tamer's world)

                        set {_centerPoint} to {_regionPoints::1}
                        set {_radius} to {_regionPoints::2}

                        loop all entities in radius {_radius} around {_centerPoint}:
                            if boolean tag "WorldQuestInteractEntity" of custom nbt of loop-entity is true:
                                if string tag "WorldQuest" of custom nbt of loop-entity = {_worldQuest}:
                                    hide loop-entity for tamer

function EclairGoatCooldown(e: entity):
    set {_id} to entity id of {_e}
    while cooldown "EclairGoatHarvest%uuid of {_e}%" is not finished:
        set {_duration} to seconds of cooldown "EclairGoatHarvest%uuid of {_e}%"
        set {_name} to "%name of {_e}% | (%{_duration}%s)"
        fake {_e}'s name to {_name} for all players in radius 100 around {_e}
        wait 1 second
    if {_e} is alive:
        fake {_e}'s name to (name of {_e}) for all players in radius 100 around {_e}

function EclairGoatInteraction(p: player, e: entity):
    set {_loc} to location 1 above {_e}

    set {_itemDrop} to yaml value "Tasks.Interact With.Eclair Goats.Eclairs obtained.Item Drop" in "WorldQuestList"

    giveItem({_p}'s uuid, {_itemDrop})
    play sound "entity.chicken.egg" with volume 3 and pitch 1 to {_p}
    play sound "entity.goat.milk" with volume 3 and pitch 1 to {_p}
    loop all items in the inventory of {_p}:
        if (1 of loop-item) = {_itemDrop}:
            set {_amount} to item amount of loop-item
            if {_amount} >= 15:
                remove loop-item from {_p}'s inventory
            stop loop

    WorldQuestAddCompletion({_p}, {_loc}, "Eclair Goats", "Interact With", "Eclairs obtained", {_amount})