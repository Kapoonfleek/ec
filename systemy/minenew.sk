on load:
	register block tag named "mining_blocks" using stone block and deepslate block

on rightclick:
	if event-block is tagged with block tag "mining_blocks":
		if player's tool is tagged with minecraft tag "pickaxes":
			if region at player is not set:
				if player is sneaking:
					if {umkilof::%player%} = "PomocnaDłoń":
						if cooldown "HelpingHand%player%" is finished:
							create cooldown "HelpingHand%player%" for 10 seconds
							set {_block} to "%type of clicked block%"
							replace all " block" in {_block} with ""
							minenew(player, {_block}, clicked block)
							break target block naturally using player's held item
							set the cooldown of player's held item for player to 10 seconds
							play sound "block.stone.break" with volume 3 and pitch 1 at clicked block
							if {gornictwo::poszumine::%player%} is true:
								chance of 1%:
									set {_f} to 1
									loop 3 times:
										play sound "block.note_block.xylophone" with volume 3 and pitch 1 to player
										add 0.3 to {_f}
										wait 0.3 seconds
									set {_czkamien} to a random integer between 1 and 11
									if {_czkamien} = 1:
										set event-block to red stained glass
									if {_czkamien} = 2:
										set event-block to lime stained glass
									if {_czkamien} = 3:
										set event-block to green stained glass
									if {_czkamien} = 4:
										set event-block to light blue stained glass
									if {_czkamien} = 5:
										set event-block to orange stained glass
									if {_czkamien} = 6:
										set event-block to yellow stained glass
									if {_czkamien} = 7:
										set event-block to magenta stained glass
									if {_czkamien} = 8:
										set event-block to purple stained glass
									if {_czkamien} = 9:
										set event-block to white stained glass
									if {_czkamien} = 10:
										set event-block to light gray stained glass
									if {_czkamien} = 11:
										set event-block to blue stained glass
									set {czystykamien::%event-block%} to true
									play sound "entity.player.levelup" with volume 3 and pitch 1 to player
									play sound "block.glass.break" with volume 3 and pitch 1.7 to player
						else:
							cancel event
							if {tekstcd::%player%} = true:
								set {_cdd} to cooldown "HelpingHand%player%"
								set the cooldown of player's tool for player to {_cdd}
								send "You must wait %{_cdd}% to use this ability." to player
							stop
					else if {umkilof::%player%} = "Eksplozja":
						if cooldown "ExplosionAbilityPickaxe%player%" is finished:
							set the cooldown of player's held item for player to 2 minutes
							create cooldown "ExplosionAbilityPickaxe%player%" for 2 minutes
							play sound "entity.generic.explode" with volume 3 and pitch 1 at clicked block
							set {_pickaxe} to player's tool
							loop all blocks in radius 3 around clicked block:
								if region at loop-block is not set:
									if loop-block = stone or deepslate:
										set {_block} to "%type of loop-block%"
										replace all " block" in {_block} with ""
										minenew(player, {_block}, loop-block)
										break loop-block naturally using {_pickaxe}
										play sound "block.stone.break" with volume 3 and pitch 0 at loop-block
										if {gornictwo::poszumine::%player%} is true:
											chance of 1%:
												set {_czkamien} to a random integer between 1 and 11
												if {_czkamien} = 1:
													set loop-block to red stained glass
												if {_czkamien} = 2:
													set loop-block to lime stained glass
												if {_czkamien} = 3:
													set loop-block to green stained glass
												if {_czkamien} = 4:
													set loop-block to light blue stained glass
												if {_czkamien} = 5:
													set loop-block to orange stained glass
												if {_czkamien} = 6:
													set loop-block to yellow stained glass
												if {_czkamien} = 7:
													set loop-block to magenta stained glass
												if {_czkamien} = 8:
													set loop-block to purple stained glass
												if {_czkamien} = 9:
													set loop-block to white stained glass
												if {_czkamien} = 10:
													set loop-block to light gray stained glass
												if {_czkamien} = 11:
													set loop-block to blue stained glass
												set {czystykamien::%loop-block%} to true
												play sound "entity.player.levelup" with volume 3 and pitch 1 to player
												play sound "block.glass.break" with volume 3 and pitch 1.7 to player
										wait 1 tick
						else:
							cancel event
							if {tekstcd::%player%} = true:
								set {_cdd} to cooldown "ExplosionAbilityPickaxe%player%"
								set the cooldown of player's tool for player to {_cdd}
								send "You must wait %{_cdd}% to use this ability." to player
							stop
on mine of andesite:
	if player's gamemode = survival:
		set {_otxpAfterMultiplier} to addPlayerXP(player, 0.5)
		add {_otxpAfterMultiplier} to {expkopanie::%player%}
		addMiningXP(player, {_otxp})
		UpdateScoreboard(player)
