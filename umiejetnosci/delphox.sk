#<##f0e359>
on rightclick:
	if boolean tag "Flamethrower" of (custom nbt of player's tool) is set:
		cancel event
		set {_target} to Target(player, 100, false)
		if {_target} is set:
			if {kartaname::%player%} = "Delphox":
				if CanUseAbility(player) != false:
					cancel event
					set {_haste} to Haste(player) 
					set {_cd} to 14/{_haste}
					set {_cd} to "%{_cd}% seconds" parsed as timespan

					if cooldown "Flamethrower%player%-%uuid of {_target}%" is finished:

						Blaze(player, {_target}, "Flamethrower")
						Flamethrower(player, {_target}, true)
						AbilityUse(player, "Flamethrower")

					else:
						cancel event
						if {_target} is set:
							if {tekstcd::%player%} is true:
								if cooldown "FlamethrowerCDText%player%" is finished:
									create cooldown "FlamethrowerCDText%player%" for 1 tick
									set {_cdd} to cooldown "Flamethrower%player%-%uuid of {_target}%"
									send "<##d74327>You can't ignite that target for another %{_cdd}%" to player
					stop
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player
	else if boolean tag "Heat Snap" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Delphox":
			if CanUseAbility(player) != false:
				if cooldown "Heat Snap%player%" is finished:
					set {_haste} to Haste(player)
					set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cd}%%nl%&7Use: &fRMB%nl%<##fa4420>Resets the cooldown of &f <##f2636a>Flamethrower <##fa4420>on all%nl%<##fa4420>targets who have recently been affected%nl%<##fa4420>by the ability and immediately <##f2636a>traps them <##fa4420>in%nl%<##fa4420>an &f <##f2636a>Inferno<##fa4420>, all with the snap of a finger."
					if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Flaming Finale":
						set {_flamingFinaleDamage} to 4 + (Versatility(player)/96) + ({damage::%player%}/32)  + (PrimaryStat(player)/16)
						set {_lore} to "%{_lore}%%nl% %nl%&f <##eb6146>Flaming Finale%nl%<##fa4420>Deals &f%{_flamingFinaleDamage}% <##ff4d00>Fire <##fa4420>damage to all affected targets%nl%<##fa4420>and detonates all &f <##f2636a>Infernos <##fa4420>for &f160%% <##fa4420>of the%nl%<##fa4420>normal damage."
						set {_cd} to "%75/{_haste}% seconds" parsed as timespan
					else:
						set {_cd} to "%45/{_haste}% seconds" parsed as timespan

					set {_snuffedWick} to getRunePower(player, "Snuffed Wick")
					if {_snuffedWick} > 0:
						set {_cd} to {_cd} - ("%{_snuffedWick}% seconds" parsed as timespan)
					create cooldown "Heat Snap%player%" for {_cd}
					set the cooldown of player's held item for player to {_cd}
					AbilityUse(player, "Heat Snap")

					play sound "skill.delphox.heatsnap" with volume 3 and pitch 1 at player
						
					LoreUpdate(player, "Heat Snap", {_lore})
					HeatSnap(player)

				else:
					cancel event
					if {tekstcd::%player%} = true:
						set {_cdd} to cooldown "Heat Snap%player%"
						send "<##fa4420>You must wait &f%{_cdd}% <##fa4420>to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player
							
	else if boolean tag "Inferno" of (custom nbt of player's tool) is set:
		cancel event
		if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) != "Hot Spree":
			if {kartaname::%player%} = "Delphox":
				set {_target} to Target(player, 100, false)
				if {_target} is set:
					if CanUseAbility(player) != false:
						if metadata value "FlamethrowerBurn" of {_target} = true:
							Inferno(player, {_target})
							AbilityUse(player, "Inferno")
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player
		else:
			send "&8[&6Earthcraft&8] &6You can not use Inferno when you have Hot Spree talented." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "Flame Barrier" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Delphox":
			if CanUseAbility(player) != false:

				set {_haste} to Haste(player) 
				set {_cd} to "%130/{_haste}% seconds" parsed as timespan
				set {_barrierDuration} to 6 + ((Resistance(player)/25))

				if cooldown "Flame Barrier%player%" is finished:
					create cooldown "Flame Barrier%player%" for {_cd}
					set the cooldown of player's held item for player to {_cd}
					AbilityUse(player, "Flame Barrier")

					set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cd}%%nl%&7Use: &fRMB%nl%<##fa4420>Surround yourself with a <##f2636a>flame barrier<##fa4420>,%nl%<##f2636a>negating <##fa4420>any incoming damage for the%nl%<##fa4420>next &f%{_barrierDuration}% sec<##fa4420>. The duration of &f <##f2636a>Flame Barrier%nl%<##fa4420>is increased based on your <##f2636a> Resistance<##fa4420>."
					LoreUpdate(player, "Flame Barrier", {_lore})

					set {_duration} to "%{_barrierDuration}% seconds" parsed as timespan

					set metadata value "Flame Barrier" of player to true
					make player invulnerable
					FlameBarrierInfo(player, {_duration})

					play sound "block.beacon.power_select" with volume 5 and pitch 1 at player

					wait {_duration}
					make player vulnerable
					clear metadata value "Flame Barrier" of player

				else:
					cancel event
					if {tekstcd::%player%} = true:
						set {_cdd} to cooldown "Flame Barrier%player%"
						send "<##fa4420>You must wait &f%{_cdd}% <##fa4420>to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

on sneak toggle:
	if {kartaname::%player%} = "Delphox":
		if player is not sneaking:
			if CanUseAbility(player) != false:
				set {_target} to Target(player, 100, false)
				if {_target} is set:
					if metadata value "InfernoTarget%player%" of {_target} is true:
						InfernoDetonate(player, {_target})
						AbilityUse(player, "Inferno (Detonate)")

function InfernoParticles(p: player, target: entity):
	while metadata value "InfernoTarget%{_p}%" of {_target} is true:
		set {_shape} to a sphere with radius 1
		if string tag "Variant" of (custom nbt of {karta::%{_p}%}) = "Winter Delight":
			set particle of {_shape} to snowflake particle
			draw an animation of the shape {_shape} 0.5 above {_target}'s location over 0.5 seconds
			set {_shapeIce} to a sphere with radius 1
			set particle of {_shapeIce} to blue ice item particle
			draw an animation of the shape {_shapeIce} 0.5 above {_target}'s location over 0.5 seconds
		else:
			draw an animation of the shape {_shape} 0.5 above {_target}'s location over 0.5 seconds
		wait 1 second

function FlameBarrierInfo(p: player, duration: timespan):
	while metadata value "Flame Barrier" of {_p} is set:
		if metadata value "Blaze" of {_p} is set:
			set {_blaze} to metadata value "Blaze" of {_p}
		else:
			set {_blaze} to 0
		send action bar "%{_blaze}%  &f|  %{_duration}%" to {_p}

		draw 40 of (flame particle with an extra value of 0.06) with offset vector(0.3, 0.4, 0.3) at location above {_p}

		buffRegister({_p}, "Flame Barrier", 3, "", "-", "-", durationShort("%{_duration}%"))
		wait 1 second
		remove 1 second from {_duration}
	buffClear({_p}, "Flame Barrier")

function Blaze(p: player, target: entity, source: string):
	set {_blaze} to metadata value "Blaze" of {_p}
	set {_blaze} to {_blaze} + 1
	if {_source} = "Flamethrower":
		if string tag "Talents;Row 1" of (custom nbt of {karta::%{_p}%}) = "Pyrotechnics":
			chance of 20%:
				set {_blaze} to {_blaze} + 1
	else if {_source} = "Heat Snap":
		if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Flame Cascade":
			set {_flameCascade} to true

	set metadata value "Blaze" of {_p} to {_blaze}

	set {_pitch} to 0.5 + 0.5*{_blaze}
	play sound "entity.blaze.hurt" with volume 2 and pitch {_pitch} to {_p}

	send action bar "%{_blaze}% " to {_p}

	if metadata value "Blaze" of {_p} >= 3:
		set {_blaze} to metadata value "Blaze" of {_p}
		remove 3 from {_blaze}
		set metadata value "Blaze" of {_p} to {_blaze}
		send action bar "%{_blaze}% " to {_p}

		DelphoxAshenMomentum({_p}, 3)

		if offensiveTrait({_p}, "Delphox", "Pyre Conduit") > 0:
			set metadata value "PyreConduit" of {_p} to 6 seconds
			DelphoxPyreConduitTimer({_p})

		if boolean tag "Constellation;Blazemania" of (custom nbt of {karta::%{_p}%}) is set:
			if metadata value "Blazemania" of {_p} is not set:
				set metadata value "Blazemania" of {_p} to 0
			set metadata value "Blazemania" of {_p} to metadata value "Blazemania" of {_p} + 1
			if metadata value "Blazemania" of {_p} = 9:
				set {_blazemania} to true
				clear metadata value "Blazemania" of {_p}
				buffClear({_p}, "Blazemania")
			else:
				buffRegister({_p}, "Blazemania", 1, "", "Stacks", "%metadata value "Blazemania" of {_p}%", "-")

		set {_loopCount} to 0
		set {_targetsAffected} to 3

		play sound "item.firecharge.use" with volume 1 and pitch 1 at location of {_target}

		set {_loopRadius} to 4 + ({crowdcontrol::%{_p}%}/50)
		set {_entities::*} to LoopEntitiesAroundTarget({_target}, {_loopRadius}, true)

		if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Firespread":
			set {_targetsAffected} to {_targetsAffected} + 2
			set {_targetsHit} to size of {_entities::*}
			if {_targetsHit} > 5:
				set {_targetsHit} to 5
			set {_firespread} to 1 + 0.3*{_targetsHit}

		if metadata value "BlazingTricksReady" of {_p} = true:
			set {_BlazingTricks} to true
			clear metadata value "BlazingTricksReady" of {_p}
		loop {_entities::*}:
			set {_loopCount} to {_loopCount} + 1
			set {_dmgBlaze} to 3 + (Versatility({_p})/180) + ({damage::%{_p}%}/60) + PrimaryStat({_p})/30
			set {_crit} to CriticalHit({_p}) + DelphoxPyrelordCritBonus({_p})
			set {_mastery} to DelphoxMastery({_p})
			if boolean tag "Constellation;Sly as a Fox" of (custom nbt of {karta::%{_p}%}) is set:
				set {_mastery} to {_mastery} + (({_crit}*10)*0.2)/135
			set {_mastery} to DelphoxIncineration({_p}, {_mastery}, loop-value)

			if {_firespread} is set:
				set {_dmgBlaze} to {_dmgBlaze} * {_firespread}
			if {_flameCascade} is set:
				if boolean tag "Constellation;Fire Mastery" of (custom nbt of {karta::%{_p}%}) is set:
					set {_flameCascadeDmgAmp} to 3.3
				else:
					set {_flameCascadeDmgAmp} to 2.7
				set {_dmgBlaze} to {_dmgBlaze} * {_flameCascadeDmgAmp}
			if {_blazemania} = true:
				set {_dmgBlaze} to {_dmgBlaze} * 2.3
			if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Wildfire":
				set {_wildfireDamageAmp} to 1 + metadata value "WildfireDelphox" of {_p}/100
				set {_dmgBlaze} to {_dmgBlaze} * {_wildfireDamageAmp}

			set {_dmgBlaze} to {_dmgBlaze}*(1 + getRunePower({_p}, "Stoked Flames"))
			set {_dmgBlazeBeforeCrit} to {_dmgBlaze}
			set {_dmgBlaze} to Crit({_p}, loop-value, {_crit}, {_dmgBlaze}, {_mastery})
			
			set loop-value's last damage cause to sweep attack
			set metadata value "LastDamageCause" of loop-value to "<##d74327>Blaze"
			set metadata value "Element" of {_p} to "Fire"
			set metadata value "LastDamageCauseLore" of loop-value to {_loreBlaze}
			
			make {_p} damage loop-value by ({_dmgBlaze}*2)
			draw 20 of (flame particle with an extra value of 0.03) with offset vector(0.3, 0.6, 0.3) at location above loop-value

			if {_dmgBlaze} != {_dmgBlazeBeforeCrit}:
				DelphoxBlasterMaster({_p})
				Kindling({_p})
				set metadata value "BonusCritDelphox" of {_p} to 0
				buffClear({_p}, "Critical Mass")
			else:
				if boolean tag "Constellation;Critical Mass" of (custom nbt of {karta::%{_p}%}) is set:
					set metadata value "BonusCritDelphox" of {_p} to metadata value "BonusCritDelphox" of {_p} + 10
					buffRegister({_p}, "Critical Mass", 1, "", "Stacks", "%metadata value "BonusCritDelphox" of {_p}% <##fca417>", "-")

			if {_BlazingTricks} = true:
				if boolean tag "Constellation;Fire Mastery" of (custom nbt of {karta::%{_p}%}) is set:
					set {_infernoPower} to 1.75
				else:
					set {_infernoPower} to 1.5
				Inferno({_p}, loop-value, {_infernoPower})
				
			stop loop if {_loopCount} = {_targetsAffected}

	if metadata value "Blaze" of {_p} > 0:
		buffRegister({_p}, "Blaze", 5, "", "Stacks", "%metadata value "Blaze" of {_p}%", "-")
	else:
		buffClear({_p}, "Blaze")

function HeatSnap(p: player):
	set {_haste} to Haste({_p}) 
	set {_cd} to 14/{_haste}
	set {_cd} to "%{_cd}% seconds" parsed as timespan
	if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Flaming Finale":
		set {_effectiveness} to 1.6
		set {_flamingFinale} to true
		set {_flamingFinaleDamage} to 4 + (Versatility({_p})/96) + ({damage::%{_p}%}/32)  + (PrimaryStat({_p})/16)
		set {_crit} to CriticalHit({_p}) + DelphoxPyrelordCritBonus({_p})
		set {_mastery} to DelphoxMastery({_p})
		if boolean tag "Constellation;Sly as a Fox" of (custom nbt of {karta::%{_p}%}) is set:
			set {_mastery} to {_mastery} + (({_crit}*10)*0.2)/135
		set {_mastery} to DelphoxIncineration({_p}, {_mastery}, {_entity})
		set {_cdHeatSnap} to "%75/{_haste}% seconds" parsed as timespan
		set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cdHeatSnap}%%nl%&7Use: &fRMB%nl%<##fa4420>Resets the cooldown of &f <##f2636a>Flamethrower <##fa4420>on all%nl%<##fa4420>targets who have recently been affected%nl%<##fa4420>by the ability and immediately <##f2636a>traps them <##fa4420>in%nl%<##fa4420>an &f <##f2636a>Inferno<##fa4420>, all with the snap of a finger."
		set {_lore} to "%{_lore}%%nl% %nl%&f <##eb6146>Flaming Finale%nl%<##fa4420>Deals &f%{_flamingFinaleDamage}% <##ff4d00>Fire <##fa4420>damage to all affected targets%nl%<##fa4420>and detonates all &f <##f2636a>Infernos <##fa4420>for &f160%% <##fa4420>of the%nl%<##fa4420>normal damage."
	else:
		set {_effectiveness} to 1

	set {_world} to world of {_p}

	loop {ECMobs::%{_world}%::*}:
		set {_entity} to loop-value parsed as entity
		set {_entityLoc} to location of {_entity}

		if metadata value "RecentlyDamagedDelphox%{_p}%" of {_entity} is set:
			if chunk at {_entityLoc} is loaded:
				if distance between {_entity} and {_p} < 40:

					clear cooldown "Flamethrower%{_p}%-%uuid of {_entity}%"
					create cooldown "Flamethrower%{_p}%-%uuid of {_entity}%" for {_cd}
					
					Blaze({_p}, {_entity}, "Heat Snap")

					DelphoxThermalOverload({_p}, {_entity}, {_crit}, {_mastery})

					if {_flamingFinale} = true:
						set {_damage} to {_flamingFinaleDamage}
						set {_entity}'s last damage cause to sweep attack
						set metadata value "LastDamageCause" of {_entity} to "<##d74327>Flaming Finale"
						set metadata value "Element" of {_p} to "Fire"
						set metadata value "LastDamageCauseLore" of {_entity} to {_lore}
						set {_damageBeforeCrit} to {_damage}
						set {_damage} to Crit({_p}, {_entity}, {_crit}, {_damage}, {_mastery})
						make {_p} damage {_entity} by {_damage}*2

						if {_damageBeforeCrit} != {_damage}:
							DelphoxBlasterMaster({_p})
							set metadata value "BonusCritDelphox" of {_p} to 0
							buffClear({_p}, "Critical Mass")
						else:
							if boolean tag "Constellation;Critical Mass" of (custom nbt of {karta::%{_p}%}) is set:
								set metadata value "BonusCritDelphox" of {_p} to metadata value "BonusCritDelphox" of {_p} + 10
								buffRegister({_p}, "Critical Mass", 1, "", "Stacks", "%metadata value "BonusCritDelphox" of {_p}% <##fca417>", "-")

						if metadata value "InfernoTarget%{_p}%" of {_entity} = true:
							InfernoDetonate({_p}, {_entity}, {_effectiveness})

					Flamethrower({_p}, {_entity}, true)

					Inferno({_p}, {_entity})

function Kindling(p: player):
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Kindling":
		remove 1 second from cooldown "Heat Snap%{_p}%"
		loop all items in the inventory of {_p}:
			if boolean tag "Heat Snap" of (custom nbt of loop-item) is set:
				set the cooldown of loop-item for {_p} to cooldown "Heat Snap%{_p}%"
				stop loop

function Flamethrower(p: player, target: entity, abilityCast: boolean, freeTick: boolean = false):
	set {_haste} to Haste({_p}) 
	set {_cd} to 14/{_haste}
	set {_hasteModifier} to 1/{_haste}
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Flame Accelerant":
		if {_abilityCast} = true:
			if metadata value "DelphoxFlamethrowerUsed" of {_p} is not set:
				FlameAccelerant({_p}, {_cd})
				buffClear({_p}, "Accelerant")
				set {_cd} to {_cd}*0.5
				set {_flameAccelerant} to true
				set {_hasteModifier} to {_hasteModifier}*0.7
			else:
				FlameAccelerant({_p}, {_cd})
	set {_cdd} to {_cd}
	set {_cd} to "%{_cd}% seconds" parsed as timespan

	set {_damage} to 1.25 + (Versatility({_p})/360) + ({damage::%{_p}%}/120) + PrimaryStat({_p})/60
	set {_dmgBlaze} to 3 + (Versatility({_p})/180) + ({damage::%{_p}%}/60) + PrimaryStat({_p})/30

	if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Hot Spree":
		if {_abilityCast} = true:
			set {_hotSpreeCount} to metadata value "HotSpree" of {_p}
			set {_hotSpreeCount} to {_hotSpreeCount} + 1
			if {_hotSpreeCount} = 3:
				set {_hotSpree} to true
				set {_damage} to {_damage} * 1.5
				set {_hotSpreeCount} to -1
				play sound "skill.delphox.hotspree" with volume 1.2 and pitch 1 to {_p}
				buffRegister({_p}, "Hot Spree", 1, "", "Stacks", "ready", "-")
			else if {_hotSpreeCount} >= 0:
				buffRegister({_p}, "Hot Spree", 1, "", "Stacks", "%{_hotSpreeCount}%", "-")
			else:
				buffClear({_p}, "Hot Spree")
				
			set metadata value "HotSpree" of {_p} to {_hotSpreeCount}
	
	if {_hotSpree} != true:
		if {_freeTick} != true:
			create cooldown "Flamethrower%{_p}%-%uuid of {_target}%" for {_cd}
			FlamethrowerCooldownTickDown({_p}, {_target})

	if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Hot Spree":
		set {_damage} to {_damage}*1.6
	
	if {_freeTick} != true:
		set {_baseDuration} to 4 + getRunePower({_p}, "Lingering Embers")
		set {_seconds} to rounded {_baseDuration}/{_hasteModifier}
	else:
		set {_seconds} to 1

	set metadata value "FlamethrowerBurn" of {_target} to true

	set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<##f2636a>Ignites <##fa4420>the target for &f%{_seconds}% sec<##fa4420>, inflicting &f%{_damage}%%nl%<##ff4d00>Fire <##fa4420>damage every &f%{_hasteModifier}% sec <##fa4420>for a total of &f%{_damage}*{_seconds}% <##ff4d00>Fire%nl%<##fa4420>damage. &f <##f2636a>Flamethrower <##fa4420>cannot be used on%nl%<##fa4420>the same target for the next &f%{_cdd}% sec<##fa4420>."
	set {_loreBlaze} to "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<##fa4420>Every &fthird  <##f2636a>Flamethrower <##fa4420>used deals%nl%&f%{_dmgBlaze}% <##ff4d00>Fire <##fa4420>damage to the target and up to%nl%<##fa4420>&ftwo <##fa4420>nearby enemies around the target."
	
	LoreUpdate({_p}, "Blaze", {_loreBlaze})
	play sound "skill.delphox.flamethrower" with volume 2 and pitch 1 at location of {_target}
						
	if metadata value "FlamethrowerTicks%{_p}%" of {_target} is not set:
		set metadata value "FlamethrowerTicks%{_p}%" of {_target} to {_seconds}
		if {_flameAccelerant} is true:
			set metadata value "FlameAccelerantTicks" of {_p} to {_seconds}
		if {_hotSpree} is true:
			set metadata value "HotSpreeTicks" of {_p} to {_seconds}
		ignite {_target} for "%{_seconds}% seconds" parsed as timespan

		while metadata value "FlamethrowerTicks%{_p}%" of {_target} > 0:
			if {_target} is alive:
				set {_damage} to 1.25 + (Versatility({_p})/360) + ({damage::%{_p}%}/120) + PrimaryStat({_p})/60
				if metadata value "AshenMomentum" of {_p} > 0:
					set {_damage} to {_damage} + metadata value "AshenMomentum" of {_p}
				set {_crit} to CriticalHit({_p}) + DelphoxPyrelordCritBonus({_p})
				set {_mastery} to DelphoxMastery({_p})
				if boolean tag "Constellation;Sly as a Fox" of (custom nbt of {karta::%{_p}%}) is set:
					set {_mastery} to {_mastery} + (({_crit}*10)*0.2)/135
				set {_mastery} to DelphoxIncineration({_p}, {_mastery}, {_target})
				set {_haste} to  Haste({_p})
				set {_wait} to "%1/{_haste}% seconds" parsed as timespan

				remove 1 from metadata value "FlamethrowerTicks%{_p}%" of {_target}

				if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Hot Spree":
					set {_damage} to {_damage}*1.6

				if string tag "Talents;Row 1" of (custom nbt of {karta::%{_p}%}) = "Firestarter":
					if health of {_target} >= (0.9 * max health of {_target}):
						set {_crit} to 100
						set {_damage} to {_damage} * 1.5

				if {_flameAccelerant} is true:
					if metadata value "FlameAccelerantTicks" of {_p} > 0:
						set {_flameAccelerantTicks} to metadata value "FlameAccelerantTicks" of {_p}
						remove 1 from {_flameAccelerantTicks}
						set metadata value "FlameAccelerantTicks" of {_p} to {_flameAccelerantTicks}
						set {_damage} to {_damage}*2.2

				if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Oxidizing Flame":
					chance of 20%:	
						play sound "entity.creeper.primed" with volume 1 and pitch 2 at location of {_target}
						set {_damage} to {_damage}*1.3

				if {_hotSpree} is true:
					if metadata value "HotSpreeTicks" of {_p} > 0:
						set {_hotSpreeTicks} to metadata value "HotSpreeTicks" of {_p}
						remove 1 from {_hotSpreeTicks}
						set metadata value "HotSpreeTicks" of {_p} to {_hotSpreeTicks}
						set {_damage} to {_damage}*1.5

				set {_critDmg} to {_mastery}
				if boolean tag "Constellation;Playing with Fire" of (custom nbt of {karta::%{_p}%}) is set:
					set {_critDmg} to {_critDmg} + 0.15

				set {_damageBeforeCrit} to {_damage}
				set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage}, {_critDmg})

				if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Wildfire":
					if metadata value "WildfireDelphox" of {_p} is not set:
						set metadata value "WildfireDelphox" of {_p} to 0
					if metadata value "WildfireDelphox" of {_p} < 600:
						set metadata value "WildfireDelphox" of {_p} to metadata value "WildfireDelphox" of {_p} + 0.5
					buffRegister({_p}, "Wildfire", 2, "", "Stacks", "%metadata value "WildfireDelphox" of {_p}%%%", "-")
				
				if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Will-o-Wisp":
					set {_chanceWilloWisp} to 10
					if boolean tag "Constellation;Fire Mastery" of (custom nbt of {karta::%{_p}%}) is set:
						set {_chanceWilloWisp} to {_chanceWilloWisp} + 2
					chance of {_chanceWilloWisp}%:	
						WilloWisp({_p}, {_target})

				set {_target}'s last damage cause to sweep attack
				set metadata value "LastDamageCause" of {_target} to "<##d74327>Flamethrower"
				set metadata value "Element" of {_p} to "Fire"
				set metadata value "LastDamageCauseLore" of {_target} to {_lore}
				make {_p} damage {_target} by {_damage}*2
				DelphoxRecentlyDamaged({_p}, {_target})
				DelphoxWildfireSpread({_p}, {_target})

				if {_damage} != {_damageBeforeCrit}:
					DelphoxBlasterMaster({_p})
					Kindling({_p})
					set metadata value "BonusCritDelphox" of {_p} to 0
					if boolean tag "Constellation;Playing with Fire" of (custom nbt of {karta::%{_p}%}) is set:
						PlayingWithFireCDReduction({_p}, {_target})
					buffClear({_p}, "Critical Mass")
				else:
					if boolean tag "Constellation;Critical Mass" of (custom nbt of {karta::%{_p}%}) is set:
						set metadata value "BonusCritDelphox" of {_p} to metadata value "BonusCritDelphox" of {_p} + 10
						buffRegister({_p}, "Critical Mass", 1, "", "Stacks", "%metadata value "BonusCritDelphox" of {_p}% <##fca417>", "-")
			else:
				stop loop
			wait {_wait}

		clear metadata value "FlamethrowerBurn" of {_target}
		clear metadata value "FlamethrowerDuration%{_p}%" of {_target}
		clear metadata value "FlamethrowerTicks%{_p}%" of {_target}

	else:
		set {_ticks} to {_seconds}
		set {_ticksTarget} to metadata value "FlamethrowerTicks%{_p}%" of {_target}
		set {_ticksTarget} to {_ticksTarget} + {_ticks}
		set metadata value "FlamethrowerTicks%{_p}%" of {_target} to {_ticksTarget}
		extinguish {_target}
		ignite {_target} for "%{_ticksTarget}% seconds" parsed as timespan			

function Inferno(p: player, target: entity, effectiveness: number = 1):
	if metadata value "InfernoTarget%{_p}%" of {_target} = true:
		InfernoDetonate({_p}, {_target})

	set {_crit} to CriticalHit({_p}) + DelphoxPyrelordCritBonus({_p})
	set {_mastery} to DelphoxMastery({_p})
	if boolean tag "Constellation;Sly as a Fox" of (custom nbt of {karta::%{_p}%}) is set:
		set {_mastery} to {_mastery} + (({_crit}*10)*0.2)/135
	set {_mastery} to DelphoxIncineration({_p}, {_mastery}, {_target})
	set {_damage} to 3.5 + (Versatility({_p})/114) + ({damage::%{_p}%}/38)  + (PrimaryStat({_p})/19)
	set {_stun} to "%2 + (({crowdcontrol::%{_p}%}/60))% seconds" parsed as timespan
	set {_stuntekst} to 2 + (({crowdcontrol::%{_p}%}/60))
	set {_explotekst} to 6 + (Versatility({_p})/52.5) + ({damage::%{_p}%}/17.5) + (PrimaryStat({_p})/8.75)

	clear metadata value "FlamethrowerBurn" of {_target}

	set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB/SHIFT%nl%<##fa4420>RIGHT-CLICK:%nl%<##f2636a>Imprisons <##fa4420>a target affected by &f <##f2636a>Flamethrower%nl%<##fa4420>in a fiery prison, &f <##f2636a>Stunning <##fa4420>them for &f%{_stuntekst}% sec <##fa4420>and%nl%<##fa4420>inflicting &f%{_damage}% <##ff4d00>Fire <##fa4420>damage.%nl% %nl%<##fa4420>SHIFT:%nl%<##f2636a>Detonates <##fa4420>an active &f <##f2636a>Inferno<##fa4420>, dealing &f%{_explotekst}% <##ff4d00>Fire%nl%<##fa4420>damage and <##f2636a>tossing <##fa4420>the enemy into the air."
	LoreUpdate({_p}, "Inferno", {_lore})

	if {_target} is alive:
		if canBeCCed({_target}) = true:
			Stun({_target}, {_stun})

		set metadata value "InfernoTarget%{_p}%" of {_target} to true
		set metadata value "InfernoEffectiveness%{_p}%" of {_target} to {_effectiveness}
		DelphoxPyrelordCrit({_p})

		set {_damageBeforeCrit} to {_damage}
		set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage}, {_mastery})

		set {_target}'s last damage cause to sweep attack
		set metadata value "LastDamageCause" of {_target} to "<##d74327>Inferno"
		set metadata value "Element" of {_p} to "Fire"
		set metadata value "LastDamageCauseLore" of {_target} to {_lore}
		make {_p} damage {_target} by {_damage}*2
		play sound "entity.illusioner.mirror_move" with volume 1 and pitch 1 at location of {_p}
		InfernoParticles({_p}, {_target})

		if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Fire to the Fuse":
			set {_enemies::*} to LoopEntitiesAroundTarget({_target}, 3, true)
			loop {_enemies::*}:
				set loop-value's last damage cause to sweep attack
				set metadata value "LastDamageCause" of loop-value to "<##d74327>Inferno"
				set metadata value "Element" of {_p} to "Fire"
				set metadata value "LastDamageCauseLore" of loop-value to {_lore}
				make {_p} damage loop-value by ({_damage} * 2)*0.5

		if {_damage} != {_damageBeforeCrit}:
			DelphoxBlasterMaster({_p})
			Kindling({_p})
			set metadata value "BonusCritDelphox" of {_p} to 0
			buffClear({_p}, "Critical Mass")
		else:
			if boolean tag "Constellation;Critical Mass" of (custom nbt of {karta::%{_p}%}) is set:
				set metadata value "BonusCritDelphox" of {_p} to metadata value "BonusCritDelphox" of {_p} + 10
				buffRegister({_p}, "Critical Mass", 1, "", "Stacks", "%metadata value "BonusCritDelphox" of {_p}% <##fca417>", "-")

function InfernoDetonate(p: player, target: entity, bonusEffectiveness: number = 0):
	set {_crit} to CriticalHit({_p}) + DelphoxPyrelordCritBonus({_p})
	set {_mastery} to DelphoxMastery({_p})
	if boolean tag "Constellation;Sly as a Fox" of (custom nbt of {karta::%{_p}%}) is set:
		set {_mastery} to {_mastery} + (({_crit}*10)*0.2)/135
	set {_mastery} to DelphoxIncineration({_p}, {_mastery}, {_target})

	set {_damage} to 6 + (Versatility({_p})/60) + ({damage::%{_p}%}/20) + (PrimaryStat({_p})/10)
	set {_effectiveness} to metadata value "InfernoEffectiveness%{_p}%" of {_target}
	set {_damage} to {_damage}*{_effectiveness}
	if {_bonusEffectiveness} > 0:
		set {_damage} to {_damage}*{_bonusEffectiveness}
	set {_damage} to {_damage}*(1 + getRunePower({_p}, "Combustive Core"))
	if metadata value "PyreConduit" of {_p} is set:
		set {_damage} to {_damage} + offensiveTrait({_p}, "Delphox", "Pyre Conduit")
		clear metadata value "PyreConduit" of {_p}
		buffClear({_p}, "Pyre Conduit")
	set metadata value "InfernoTarget%{_p}%" of {_target} to false
	clear metadata value "InfernoEffectiveness%{_p}%" of {_target}

	clear metadata value "Stun" of {_target}
	clear metadata value "InfernoStun%{_p}%" of {_target}

	if boolean tag "Constellation;Sparking Cinders" of (custom nbt of {karta::%{_p}%}) is set:
		Blaze({_p}, {_target}, "Inferno (Detonate)")
	
	set {_knock} to 1 + ({crowdcontrol::%{_p}%}/100)

	set {_damageTrigger} to 3.5 + (Versatility({_p})/114) + ({damage::%{_p}%}/38)  + (PrimaryStat({_p})/19)
	set {_stuntekst} to 2 + (({crowdcontrol::%{_p}%}/60))

	set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB/SHIFT%nl%<##fa4420>RIGHT-CLICK:%nl%<##f2636a>Imprisons <##fa4420>a target affected by &f <##f2636a>Flamethrower%nl%<##fa4420>in a fiery prison, <##f2636a> Stunning <##fa4420>them for &f%{_stuntekst}% sec <##fa4420>and%nl%<##fa4420>inflicting &f%{_damageTrigger}% <##ff4d00>Fire <##fa4420>damage.%nl% %nl%<##fa4420>SHIFT:%nl%<##f2636a>Detonates <##fa4420>an active &f <##f2636a>Inferno<##fa4420>, dealing &f%{_damage}% <##ff4d00>Fire%nl%<##fa4420>damage and <##f2636a>tossing <##fa4420>the enemy into the air."
	LoreUpdate({_p}, "Inferno", {_lore})

	play sound "entity.dragon_fireball.explode" with volume 1 and pitch 1 at location of {_p}
	if canBeCCed({_target}) = true:
		push {_target} upwards with velocity {_knock}

	if string tag "Talents;Row 1" of (custom nbt of {karta::%{_p}%}) = "Hellcaller":
		if metadata value "HellcallerStacks" of {_p} is set:
			set {_hellcallerStacks} to metadata value "HellcallerStacks" of {_p}
			set {_damage} to {_damage} * (1 + (0.125*{_hellcallerStacks}))
		Hellcaller({_p})

	set {_damageBeforeCrit} to {_damage}
	set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage}, {_mastery})

	set {_target}'s last damage cause to sweep attack
	set metadata value "LastDamageCause" of {_target} to "<##d74327>Inferno (Detonate)"
	set metadata value "Element" of {_p} to "Fire"
	set metadata value "LastDamageCauseLore" of {_target} to {_lore}
	make {_p} damage {_target} by {_damage} * 2

	if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Fire to the Fuse":
		set {_enemies::*} to LoopEntitiesAroundTarget({_target}, 3, true)
		loop {_enemies::*}:
			set loop-value's last damage cause to sweep attack
			set metadata value "LastDamageCause" of loop-value to "<##d74327>Inferno (Detonate)"
			set metadata value "Element" of {_p} to "Fire"
			set metadata value "LastDamageCauseLore" of loop-value to {_lore}
			make {_p} damage loop-value by ({_damage} * 2)*0.5

	if {_damage} != {_damageBeforeCrit}:
		DelphoxBlasterMaster({_p})
		Kindling({_p})
		set metadata value "BonusCritDelphox" of {_p} to 0
		buffClear({_p}, "Critical Mass")
	else:
		if boolean tag "Constellation;Critical Mass" of (custom nbt of {karta::%{_p}%}) is set:
			set metadata value "BonusCritDelphox" of {_p} to metadata value "BonusCritDelphox" of {_p} + 10
			buffRegister({_p}, "Critical Mass", 1, "", "Stacks", "%metadata value "BonusCritDelphox" of {_p}% <##fca417>", "-")

	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Convection":
		chance of 10%:
			Inferno({_p}, {_target})

	if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Blazing Tricks":
		if boolean tag "Constellation;Fire Mastery" of (custom nbt of {karta::%{_p}%}) is set:
			set {_infernoRequired} to 12
		else:
			set {_infernoRequired} to 15
		if metadata value "BlazingTricks" of {_p} is not set:
			set metadata value "BlazingTricks" of {_p} to 0
		set metadata value "BlazingTricks" of {_p} to metadata value "BlazingTricks" of {_p} + 1
		buffRegister({_p}, "Tricks", 1, "", "Stacks", "%metadata value "BlazingTricks" of {_p}%", "-")
		if metadata value "BlazingTricks" of {_p} = {_infernoRequired}:
			clear metadata value "BlazingTricks" of {_p}
			set metadata value "BlazingTricksReady" of {_p} to true
			buffRegister({_p}, "Tricks", 1, "", "-", "ready", "-")
	
function InfernoStun(p: player, target: entity):
	set {_stunDuration} to "%2 + (({crowdcontrol::%{_p}%}/60))% seconds" parsed as timespan
	if metadata value "InfernoStun%{_p}%" of {_target} is not set:
		set metadata value "InfernoStun%{_p}%" of {_target} to {_stunDuration}
		while metadata value "InfernoStun%{_p}%" of {_target} > 0 seconds:
			wait 1 second
			set {_duration} to metadata value "InfernoStun%{_p}%" of {_target}
			remove 1 second from {_duration}
			set metadata value "InfernoStun%{_p}%" of {_target} to {_duration}
			if 0 seconds >= metadata value "InfernoStun%{_p}%" of {_target}:
				clear metadata value "InfernoStun%{_p}%" of {_target}
				clear metadata value "Stun" of {_target}
				clear metadata value "InfernoTarget%{_p}%" of {_target}
				stop loop
	else:
		set metadata value "InfernoStun%{_p}%" of {_target} to {_stunDuration}

function DelphoxRecentlyDamaged(p: player, target: entity):
	if metadata value "RecentlyDamagedDelphox%{_p}%" of {_target} is not set:
		set metadata value "RecentlyDamagedDelphox%{_p}%" of {_target} to 20 seconds
		while metadata value "RecentlyDamagedDelphox%{_p}%" of {_target} > 0 seconds:
			wait 1 second
			set {_duration} to metadata value "RecentlyDamagedDelphox%{_p}%" of {_target}
			remove 1 second from {_duration}
			set metadata value "RecentlyDamagedDelphox%{_p}%" of {_target} to {_duration}
			if 0 seconds >= metadata value "RecentlyDamagedDelphox%{_p}%" of {_target}:
				clear metadata value "RecentlyDamagedDelphox%{_p}%" of {_target}
				stop loop
	else:
		set metadata value "RecentlyDamagedDelphox%{_p}%" of {_target} to 20 seconds

function FlameAccelerant(p: player, cd: number):
	if metadata value "DelphoxFlamethrowerUsed" of {_p} is not set:
		set metadata value "DelphoxFlamethrowerUsed" of {_p} to "%{_cd}% seconds" parsed as timespan
		while metadata value "DelphoxFlamethrowerUsed" of {_p} > 0 seconds:
			wait 1 second
			remove 1 second from metadata value "DelphoxFlamethrowerUsed" of {_p}
		clear metadata value "DelphoxFlamethrowerUsed" of {_p}
		if metadata value "ECEngaged" of {_p} is set:
			buffRegister({_p}, "Accelerant", 1, "", "-", "ready", "-")
	else:
		set metadata value "DelphoxFlamethrowerUsed" of {_p} to "%{_cd}% seconds" parsed as timespan

function WilloWisp(p: player, target: entity):
	play sound "skill.delphox.willowisp" with volume 1.5 and pitch 1 at location of {_target}
	WilloWispVisual({_p}, {_target})

	if {_target} is alive:
		if metadata value "FlamethrowerTicks%{_p}%" of {_target} is set:
			set {_ticks} to 1
			if boolean tag "Constellation;Fire Mastery" of (custom nbt of {karta::%{_p}%}) is set:
				set {_ticks} to {_ticks} + 1
			set metadata value "FlamethrowerTicks%{_p}%" of {_target} to metadata value "FlamethrowerTicks%{_p}%" of {_target} + {_ticks}

	set {_damage} to 1.25 + (Versatility({_p})/420) + ({damage::%{_p}%}/140) + PrimaryStat({_p})/70
	set {_crit} to CriticalHit({_p}) + DelphoxPyrelordCritBonus({_p})
	set {_mastery} to DelphoxMastery({_p})
	if boolean tag "Constellation;Sly as a Fox" of (custom nbt of {karta::%{_p}%}) is set:
		set {_mastery} to {_mastery} + (({_crit}*10)*0.2)/135
	set {_mastery} to DelphoxIncineration({_p}, {_mastery}, {_target})
	set {_lore} to "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%&f <##f2636a>Flamethrower <##fa4420>ticks have a &f10%% <##fa4420>chance%nl%<##fa4420>to summon a &f <##eb6146>Will-o-Wisp&7.%nl% %nl%&f <##eb6146>Will-o-Wisp%nl%<##fa4420>Adds an &fadditional tick <##fa4420>of &f <##f2636a>Flamethrower%nl%<##fa4420>to the target and deals an instance of%nl%&f1.25 <##d65a88>Shadowflame &7damage.%nl% %nl%<##d65a88>Shadowflame &8damage consists of both <##ff4d00>Fire%nl%&8and <##431d53>Ghost &8damage. Effects that strengthen%nl%&8either element also apply to <##d65a88>Shadowflame%nl%&8damage."
	
	set {_damageBeforeCrit} to {_damage}
	set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage}, {_mastery})

	wait 1 tick

	set {_target}'s last damage cause to sweep attack
	set metadata value "LastDamageCause" of {_target} to "<##d74327>Will-o-Wisp"
	set metadata value "Element" of {_p} to "Shadowflame"
	set metadata value "LastDamageCauseLore" of {_target} to {_lore}
	make {_p} damage {_target} by {_damage} * 2

	if {_damageBeforeCrit} != {_damage}:
		DelphoxBlasterMaster({_p})
		set metadata value "BonusCritDelphox" of {_p} to 0
		buffClear({_p}, "Critical Mass")
	else:
		if boolean tag "Constellation;Critical Mass" of (custom nbt of {karta::%{_p}%}) is set:
			set metadata value "BonusCritDelphox" of {_p} to metadata value "BonusCritDelphox" of {_p} + 10
			buffRegister({_p}, "Critical Mass", 1, "", "Stacks", "%metadata value "BonusCritDelphox" of {_p}% <##fca417>", "-")

function WilloWispVisual(p: player, target: entity):
	set {_where} to a random integer between 1 and 2
	if {_where} = 1:
		if {_p}'s horizontal facing is north or south:
			set {_loc} to location 0.6 left of {_target}
		else:
			set {_loc} to location 0.6 behind {_target}
	else:
		if {_p}'s horizontal facing is north or south:
			set {_loc} to location 0.6 right of {_target}
		else:
			set {_loc} to location 0.6 in front of {_target}
	set {_loc} to location 1.5 above {_loc}
	set {_yaw} to yaw of {_p} - 180
	set yaw of {_loc} to {_yaw}
	spawn armor stand at {_loc} with nbt from "{Invulnerable:1b,NoGravity:1b,Silent:1b}"
	set name of last spawned armor stand to "willowisp"
	set {_e} to last spawned armor stand
	add nbt from "{Rotation:[%{_yaw}%f,0.0f]}" to nbt of {_e}
	WillowispVisualDelete({_e})

function WillowispVisualDelete(e: entity):
	wait 3 seconds
	kill {_e}

function Hellcaller(p: player):
	if metadata value "Hellcaller" of {_p} is not set:
		set metadata value "Hellcaller" of {_p} to 3 seconds
		set metadata value "HellcallerStacks" of {_p} to 1
		while metadata value "Hellcaller" of {_p} > 0 seconds:
			buffRegister({_p}, "Hellcaller", 1, "", "Stacks", "%metadata value "HellcallerStacks" of {_p}%", durationShort("%metadata value "Hellcaller" of {_p}%"))
			wait 1 second
			if metadata value "Hellcaller" of {_p} is not set:
				stop loop
			remove 1 second from metadata value "Hellcaller" of {_p}
		clear metadata value "Hellcaller" of {_p}
		clear metadata value "HellcallerStacks" of {_p}
		buffClear({_p}, "Hellcaller")
	else:
		set metadata value "HellcallerStacks" of {_p} to metadata value "HellcallerStacks" of {_p} + 1

	if metadata value "HellcallerStacks" of {_p} is set:
		buffRegister({_p}, "Hellcaller", 1, "", "Stacks", "%metadata value "HellcallerStacks" of {_p}%", durationShort("%metadata value "Hellcaller" of {_p}%"))
	else:
		buffClear({_p}, "Hellcaller")

function PlayingWithFireCDReduction(p: player, target: entity):
	set {_cdFlamethrowerTarget} to cooldown "Flamethrower%{_p}%-%uuid of {_target}%"
	set {_cdFlamethrowerTarget} to "%{_cdFlamethrowerTarget}%"
	replace all " seconds" and " second" in {_cdFlamethrowerTarget} with ""
	set {_cdFlamethrowerTarget} to {_cdFlamethrowerTarget} parsed as number
	set {_cdFlamethrowerTarget} to {_cdFlamethrowerTarget}*0.02
	remove ("%{_cdFlamethrowerTarget}% seconds" parsed as timespan) from cooldown "Flamethrower%{_p}%-%uuid of {_target}%"
			
function Pyromaniac(p: player):
	if {pyromaniacbonus::%{_p}%} is true:
		set {pyromaniacbonus::%{_p}%} to false
		while {czaspyromaniac::%{_p}%} > 0 seconds:
			if {_p} is alive:
				remove 1 second from {czaspyromaniac::%{_p}%}
				wait 1 second
				if 0 seconds >= {czaspyromaniac::%{_p}%}:
					clear {pyromaniacstacks::%{_p}%}
					clear {czaspyromaniac::%{_p}%}
					clear {pyromaniacbonus::%{_p}%}
					stop loop
			else:
				clear {pyromaniacstacks::%{_p}%}
				stop loop

function FlamethrowerCooldownTickDown(p: player, target: entity):
	set {_id} to entity id of {_target}
	while cooldown "Flamethrower%{_p}%-%uuid of {_target}%" is not finished:
		set {_remainingCdFlamethrower} to seconds of cooldown "Flamethrower%{_p}%-%uuid of {_target}%"
		set {_name} to "%name of {_target}% &8| &f %{_remainingCdFlamethrower}%s"
		
		set {_meta} to new metadata packet with id {_id}:
			name: {_name}
		send packet {_meta} to {_p}

		wait 1 second
	if {_target} is alive:
		add data from "name %name of {_target}%" to {_meta}
		send packet {_meta} to {_p}
	clear cooldown "Flamethrower%{_p}%-%uuid of {_target}%"

function DelphoxPyrelordCrit(p: player):
	if HasStarforgedBonus({_p}, "Delphox", "Tier I", "2Set") is true:
		if metadata value "PyrelordCrit" of {_p} is not set:
			set metadata value "PyrelordCrit" of {_p} to 5 seconds
			while metadata value "PyrelordCrit" of {_p} > 0 seconds:
				buffRegister({_p}, "Pyrelord", 1, "", "Value", "<##fca417> &f10%% ", durationShort("%metadata value "PyrelordCrit" of {_p}%"))
				wait 1 second
				if metadata value "PyrelordCrit" of {_p} is not set:
					stop loop
				remove 1 second from metadata value "PyrelordCrit" of {_p}
			clear metadata value "PyrelordCrit" of {_p}
			buffClear({_p}, "Pyrelord")
		else:
			set metadata value "PyrelordCrit" of {_p} to 5 seconds

function DelphoxPyrelordCritBonus(p: player) :: number:
	if metadata value "PyrelordCrit" of {_p} is set:
		return 10
	return 0

function DelphoxIncineration(p: player, mastery: number, target: entity) :: number:
	if HasStarforgedBonus({_p}, "Delphox", "Tier I", "4Set") is true:
		if metadata value "InfernoTarget%{_p}%" of {_target} = true:
			set {_mastery} to 2.5 + {_mastery} + 0.3
	return {_mastery}

function DelphoxMastery(p: player) :: number:
	set {_mastery} to 2.5 + ((Mastery({_p})/135))
	set {_searingIntensity} to getRunePower({_p}, "Searing Intensity")
	if {_searingIntensity} > 0:
		set {_mastery} to {_mastery} + ({_searingIntensity}/100)
	return {_mastery}

function DelphoxBlasterMaster(p: player):
	set {_stat} to statTrait({_p}, "Delphox", "Blaster Master")
	if {_stat} > 0:
		if metadata value "BlasterMasterMastery" of {_p} is not set:
			set metadata value "BlasterMasterMastery" of {_p} to 0
		set metadata value "BlasterMasterMastery" of {_p} to (metadata value "BlasterMasterMastery" of {_p}) + {_stat}
		buffRegister({_p}, "Blaster Master", 1, "", "Stacks", "<#f53b98> &f%round(metadata value "BlasterMasterMastery" of {_p}, 0)%", "3 sec")
		wait 3 seconds
		if metadata value "BlasterMasterMastery" of {_p} is set:
			set metadata value "BlasterMasterMastery" of {_p} to (metadata value "BlasterMasterMastery" of {_p}) - {_stat}
		if metadata value "BlasterMasterMastery" of {_p} > 0:
			buffRegister({_p}, "Blaster Master", 1, "", "Stacks", "<#f53b98> &f%round(metadata value "BlasterMasterMastery" of {_p}, 0)%", "3 sec")
		else:
			clear metadata value "BlasterMasterMastery" of {_p}
			buffClear({_p}, "Blaster Master")

function DelphoxAshenMomentum(p: player, blazeConsumed: number):
	set {_dmg} to offensiveTrait({_p}, "Delphox", "Ashen Momentum")
	if {_dmg} > 0:
		set {_bonus} to {_dmg} * {_blazeConsumed}
		if metadata value "AshenMomentum" of {_p} is not set:
			set metadata value "AshenMomentum" of {_p} to 0
		set metadata value "AshenMomentum" of {_p} to (metadata value "AshenMomentum" of {_p}) + {_bonus}
		buffRegister({_p}, "Ashen Momentum", 1, "", "Value", "<#ff4d00> &f+%round(metadata value "AshenMomentum" of {_p}, 1)%", "5 sec")
		wait 5 seconds
		if metadata value "AshenMomentum" of {_p} is set:
			set metadata value "AshenMomentum" of {_p} to (metadata value "AshenMomentum" of {_p}) - {_bonus}
		if metadata value "AshenMomentum" of {_p} > 0.0001:
			buffRegister({_p}, "Ashen Momentum", 1, "", "Value", "<#ff4d00> &f+%round(metadata value "AshenMomentum" of {_p}, 1)%", "5 sec")
		else:
			clear metadata value "AshenMomentum" of {_p}
			buffClear({_p}, "Ashen Momentum")

function DelphoxWildfireSpread(p: player, target: entity):
	set {_dmg} to offensiveTrait({_p}, "Delphox", "Wildfire Spread")
	if {_dmg} > 0:
		chance of 12%:
			set {_spread::*} to LoopEntitiesAroundTarget({_target}, 5, false)
			loop {_spread::*}:
				DelphoxWildfireSpreadTick({_p}, loop-value, {_dmg})
				stop loop

function DelphoxWildfireSpreadTick(p: player, target: entity, dmg: number):
	if metadata value "FlamethrowerTicks%{_p}%" of {_target} is not set:
		Flamethrower({_p}, {_target}, false, true)

	set {_crit} to CriticalHit({_p}) + DelphoxPyrelordCritBonus({_p})
	set {_mastery} to DelphoxIncineration({_p}, DelphoxMastery({_p}), {_target})
	set {_target}'s last damage cause to sweep attack
	set metadata value "LastDamageCause" of {_target} to "<##d74327>Wildfire Spread"
	set metadata value "Element" of {_p} to "Fire"
	set {_dmg} to Crit({_p}, {_target}, {_crit}, {_dmg}, {_mastery})
	make {_p} damage {_target} by {_dmg}*2
	draw 15 of (flame particle with an extra value of 0.03) with offset vector(0.3, 0.5, 0.3) at location above {_target}

function DelphoxThermalOverload(p: player, target: entity, crit: number, mastery: number):
	set {_dmg} to offensiveTrait({_p}, "Delphox", "Thermal Overload")
	if {_dmg} > 0:
		set {_damage} to {_dmg}
		if metadata value "InfernoTarget%{_p}%" of {_target} = true:
			set {_damage} to {_damage}*1.25
		set {_target}'s last damage cause to sweep attack
		set metadata value "LastDamageCause" of {_target} to "<##d74327>Thermal Overload"
		set metadata value "Element" of {_p} to "Fire"
		set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage}, {_mastery})
		make {_p} damage {_target} by {_damage}*2

function DelphoxPyreConduitTimer(p: player):
	if metadata value "PyreConduitLoop" of {_p} is not set:
		set metadata value "PyreConduitLoop" of {_p} to true
		while metadata value "PyreConduit" of {_p} > 0 seconds:
			buffRegister({_p}, "Pyre Conduit", 1, "", "Value", "<#ff4d00> &fready", durationShort("%metadata value "PyreConduit" of {_p}%"))
			wait 1 second
			if metadata value "PyreConduit" of {_p} is not set:
				stop loop
			remove 1 second from metadata value "PyreConduit" of {_p}
		clear metadata value "PyreConduit" of {_p}
		clear metadata value "PyreConduitLoop" of {_p}
		buffClear({_p}, "Pyre Conduit")
