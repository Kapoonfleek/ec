variables:
    {worldQuestCount} = 0

command /testdialogue:
    trigger:
        set {worldQuestCount} to 0
        portraitDialogue(player, "", "Magni Bronzebeard", "Someone's drawin' power from Azerite in this area. Ye need tae stop 'em!")
        set {_dialogue} to "No need tae panic! Though I suppose my entrance was a bit abrupt..."
        #portraitDialogue(player, "", "Magni Bronzebeard", {_dialogue})
        #play sound "npc.magnibronzebeard.heart_introduction" with volume 5 and pitch 1 to player
        set {_citizens} to Bukkit.getPluginManager().getPlugin("Citizens")
        set {_magni} to {_citizens}.getNPCRegistry().getById(6748).getEntity()
        broadcast {_magni}
        

function portraitDialogue(p: player, icon: string, name: string, text: string, faction: string = ""):
    set {_words::*} to {_text} split at " "
    set {_currentLine} to ""
    set {_lineCount} to 1

    if {_faction} != "":
        set {_name} to "<##fdd002>%{_name}%, &7&o%{_faction}%"
    
    loop {_words::*}:
        if length of ("%{_currentLine}% %loop-value%") <= 40:
            if {_currentLine} is "":
                set {_currentLine} to loop-value
            else:
                set {_currentLine} to "%{_currentLine}% %loop-value%"
        else:
            set {_allLines::%{_lineCount}%} to {_currentLine}
            add 1 to {_lineCount}
            set {_currentLine} to loop-value
    
    set {_allLines::%{_lineCount}%} to {_currentLine}

    loop {_allLines::*}:
        if loop-index parsed as integer <= 2:
            set {_textAligned::*} to {_textAligned::*} and loop-value
        else:
            set {_textExtra::*} to {_textExtra::*} and loop-value
    send "" to {_p}
    send "          %{_name}%" to {_p}
    
    loop {_textAligned::*}:
        send "          %loop-value%" to {_p}
    
    if size of {_textAligned::*} is 1:
        send "          " to {_p}

    if {_textExtra::*} is set:
        loop {_textExtra::*}:
            if loop-counter = 1:
                send "%{_icon}% %loop-value%" to {_p}
            else:
                send "          %loop-value%" to {_p}
    else:
        send "%{_icon}%" to {_p}
        
    send " " to {_p}

command /ly:
    trigger:
        if yaml "WorldQuestList" is loaded:
            save yaml "WorldQuestList"
            unload yaml "WorldQuestList"
            broadcast "&cunloaded yaml"
        else:
            load yaml "plugins/Skript/lists/WorldQuestList" as "WorldQuestList"
            broadcast "&bloaded yaml"
command /ly3:
    trigger:
        if yaml "WorldQuestLocations" is loaded:
            save yaml "WorldQuestLocations"
            unload yaml "WorldQuestLocations"
            broadcast "&dunloaded yaml"
        else:
            load yaml "plugins/Skript/worldquests/locations" as "WorldQuestLocations"
            broadcast "&aloaded yaml"

