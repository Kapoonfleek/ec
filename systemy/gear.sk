#STAT ICONS & COLORS:

#PRIMARY:

#AGILITY&a<#59e393#5ee359>
#INTELLECT&b<#59e3c0#59c1e3>
#STRENGTH&c<#e36759#e35959>

#SECONDARY:
#HEALTH<#c0ff02>
#DAMAGE<#f74428>
#RESISTANCE<#ffef45>
#MOBILITY&f
#UTILITY<#ae78d0>
#CROWD CONTROL<#58c3f5>
#VERSATILITY<#e3ebff>
#MASTERY<#f53b98>
#CRITICAL HIT<#fca417>
#ELEMENT<#d5ff57>
#HASTE<#19943e>
#AVOIDANCE<#2154ad>

#ARTIFACT FORMULA
#5 STAR
#Substats: s(x) = 0,186 * 4,7385x



function Artifact(artifactType: string, starLevel: integer, itemLevel: integer) :: item:
    set {_substatValues::*} to 0.186, 0.180, 0.174, 0.162 and 0.150
    set {_substats} to 3
    set {_stats::*} to "<#c0ff02> x Health", "<#f74428> x Damage", "<#ffef45> x Resistance", "&f x Mobility", "<#ae78d0> x Utility", "<#58c3f5> x Crowd Control", "<#e3ebff> x Versatility", "<#f53b98> x Mastery", "<#fca417> x Critical Hit", "<#d5ff57> x Element", "<#19943e> x Haste" and "<#2154ad> x Avoidance"
    set {_chanceBonus} to 33.33333333333

    if {_starLevel} = 1:
        set {_starLevelLore} to "&e★"
        set {_rarity} to "<#cccccc>Common"
        set {_rarityPL} to "<#cccccc>Częsty"
        set {_loreSubstats} to "&8&oby a random value. One star artifacts%nl%&8&oalways start with one substat."
        set {_substats} to 1
    else if {_starLevel} = 2:
        set {_starLevelLore} to "&e★★"
        set {_rarity} to "<#1fef00>Uncommon"
        set {_rarityPL} to "<#1fef00>Nieczęsty"
        set {_loreSubstats} to "&8&oby a random value. Two star artifacts%nl%&8&ostart with one substat and have a%nl%&8&o33.33%% chance to start with two."
        set {_substats} to 1
        chance of {_chanceBonus}%:
            set {_substats} to 2
    else if {_starLevel} = 3:
        set {_starLevelLore} to "&e★★★"
        set {_rarity} to "<#0070dd>Rare"
        set {_rarityPL} to "<#0070dd>Rzadki"
        set {_loreSubstats} to "&8&oby a random value. Three star artifacts%nl%&8&ostart with two substats and have a%nl%&8&o33.33%% chance to start with three."
        set {_substats} to 2
        chance of {_chanceBonus}%:
            set {_substats} to 3
    else if {_starLevel} = 4:
        set {_starLevelLore} to "&e★★★★"
        set {_rarity} to "<#a335ee>Epic"
        set {_rarityPL} to "<#a335ee>Epicki"
        set {_loreSubstats} to "&8&oby a random value. Four star artifacts%nl%&8&oalways start with three substats."
        set {_loreSubstatsPL} to "&8&oo losową wartość. Czterogwiazdkowe artefakty%nl%&8&ozawsze zaczynają z trzema statystykami podrzędnymi."
        set {_substats} to 3
    else if {_starLevel} = 5:
        set {_starLevelLore} to "&e★★★★★"
        set {_rarity} to "<#ff8000>Legendary"
        set {_rarityPL} to "<#ff8000>Legendarny"
        set {_loreSubstats} to "&8&oby a random value. Five star artifacts%nl%&8&ostart with three substats and have a%nl%&8&o33.33%% chance to start with four."
        set {_substats} to 3
        chance of {_chanceBonus}%:
            set {_substats} to 4

    #Make a .yaml with loot table and items --- 21.12.2024

    set {_artifactInfo} to "&fUpgraded: +0%nl%&m&8-------------------------------------------%nl%&7Star Level: &e%{_starLevelLore}%%nl%&8&o(!) Every five upgrades raises a random substat%nl%%{_loreSubstats}%"
    set {_artifactLoreScorched} to "%nl%<#ff7045>2 Set Bonus: <#ff3014>Lava &7and <#ff4d00>Fire &7damage dealt is%nl%&7increased by &f8%%&7.%nl%<#ff7045>4 Set Bonus: &7Using your Ultimate Ability increases%nl%&7your <#f53b98> Mastery &7by &f30%% &7for &f10 sec&7. This effect%nl%&7has a &f20 sec &7cooldown.%nl% %nl%%{_artifactInfo}%"
    set {_artifactLoreArcaneMysteries} to "%nl%<#7154b8>2 Set Bonus: &7Gain &f40 <#f53b98> Mastery &7if it is your highest stat.%nl%<#7154b8>4 Set Bonus: &7Gain a fluctuating &f+2%% &7elemental damage bonus%nl%&7every &f2 sec&7. &7After reaching an increase of &f+16%%&7,%nl%&7the effect will persist for &f5 sec &7before it will rapidly%nl%&7start declining every &f1 sec &7and ultimately reset.%nl% %nl%&7When you use your Ultimate Ability, double the%nl%&7current effect and extend its duration by &f10 sec&7.%nl%&7The elemental damage bonus is halved if your element%nl%&7is not <#512989>Magic&7, <#431d53>Ghost &7or <#333333>Dark&7.%nl% %nl%%{_artifactInfo}%"
    set {_artifactLoreMarksmanship} to "%nl%<#aad372>2 Set Bonus: &7Damage dealt while at least &f20 &7blocks%nl%&7from the target is increased by &f12%%&7.%nl%<#aad372>4 Set Bonus: &7Increases damage dealt by ranged%nl%&7weapons and projectiles by &f35%%&7.%nl% %nl%%{_artifactInfo}%"
    set {_artifactLoreDeepfrost} to "%nl%<#73b7ff>2 Set Bonus: <#add8e6>Ice &7damage dealt is increased by &f15%%&7.%nl%<#73b7ff>4 Set Bonus: <#fca417> Critically Hitting &7an enemy will grant%nl%&7you &f+3%% <#fca417> Critical Damage &7for &f20 sec&7. Each following%nl%<#fca417> Critical Hit &7will increase this bonus by an additional%nl%&f3%%&7, stacking up to &f12 &7times.%nl% %nl%%{_artifactInfo}%"
    
    #Flower Artifacts
    if {_artifactType} = "Scorched Lavaflower":
        set {_artifact} to green dye named "<#fa5320>Scorched Lavaflower" with lore "%{_rarity}% Flower Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Scorched Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[10.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Scorched""}}"
        set {_artifactLore} to {_artifactLoreScorched}
    else if {_artifactType} = "Hushed Nightshade":
        set {_artifact} to green dye named "<#7154b8>Hushed Nightshade" with lore "%{_rarity}% Flower Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Arcane Mysteries Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Arcane Mysteries""}}"
        set {_artifactLore} to {_artifactLoreArcaneMysteries}
    else if {_artifactType} = "Marksman's Anemone":
        set {_artifact} to green dye named "<#aad372>Marksman's Anemone" with lore "%{_rarity}% Flower Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Marksmanship Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[12.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Marksmanship""}}"
        set {_artifactLore} to {_artifactLoreMarksmanship}
    else if {_artifactType} = "Morning Frost":
        set {_artifact} to green dye named "<#73b7ff>Morning Frost" with lore "%{_rarity}% Flower Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Deepfrost Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[13.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Deepfrost""}}"
        set {_artifactLore} to {_artifactLoreDeepfrost}

    #Orb Artifacts
    else if {_artifactType} = "Searing Eye":
        set {_artifact} to firework star named "<#fa5320>Searing Eye" with lore "%{_rarity}% Orb Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Scorched Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Scorched""}}"
        set {_artifactLore} to {_artifactLoreScorched}
    else if {_artifactType} = "Clairvoyance":
        set {_artifact} to firework star named "<#7154b8>Clairvoyance" with lore "%{_rarity}% Orb Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Arcane Mysteries Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Arcane Mysteries""}}"
        set {_artifactLore} to {_artifactLoreArcaneMysteries}
    else if {_artifactType} = "Vision of the Hunt":
        set {_artifact} to firework star named "<#aad372>Vision of the Hunt" with lore "%{_rarity}% Orb Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Marksmanship Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Marksmanship""}}"
        set {_artifactLore} to {_artifactLoreMarksmanship}
    else if {_artifactType} = "Glacial Heart":
        set {_artifact} to firework star named "<#73b7ff>Glacial Heart" with lore "%{_rarity}% Orb Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Deepfrost Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Deepfrost""}}"
        set {_artifactLore} to {_artifactLoreDeepfrost}

    #Phial Artifacts
    else if {_artifactType} = "Charred Contrivance":
        set {_artifact} to glass bottle named "<#fa5320>Charred Contrivance" with lore "%{_rarity}% Phial Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Scorched Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Scorched""}}"
        set {_artifactLore} to {_artifactLoreScorched}
    else if {_artifactType} = "Umbral Conundrum":
        set {_artifact} to glass bottle named "<#7154b8>Umbral Conundrum" with lore "%{_rarity}% Phial Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Arcane Mysteries Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Arcane Mysteries""}}"
        set {_artifactLore} to {_artifactLoreArcaneMysteries}
    else if {_artifactType} = "Archer's Belt Pouch":
        set {_artifact} to glass bottle named "<#aad372>Archer's Belt Pouch" with lore "%{_rarity}% Phial Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Marksmanship Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Marksmanship""}}"
        set {_artifactLore} to {_artifactLoreMarksmanship}
    else if {_artifactType} = "Winter's Eon":
        set {_artifact} to glass bottle named "<#73b7ff>Winter's Eon" with lore "%{_rarity}% Phial Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Deepfrost Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Deepfrost""}}"
        set {_artifactLore} to {_artifactLoreDeepfrost}

    #Scroll Artifacts
    else if {_artifactType} = "Singed Chapter":
        set {_artifact} to book named "<#fa5320>Singed Chapter" with lore "%{_rarity}% Scroll Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Scorched Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Scorched""}}"
        set {_artifactLore} to {_artifactLoreScorched}
    else if {_artifactType} = "Arcanomicon":
        set {_artifact} to book named "<#7154b8>Arcanomicon" with lore "%{_rarity}% Scroll Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Arcane Mysteries Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Arcane Mysteries""}}"
        set {_artifactLore} to {_artifactLoreArcaneMysteries}
    else if {_artifactType} = "Hunter's Manuscript":
        set {_artifact} to book named "<#aad372>Hunter's Manuscript" with lore "%{_rarity}% Scroll Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Marksmanship Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Marksmanship""}}"
        set {_artifactLore} to {_artifactLoreMarksmanship}
    else if {_artifactType} = "Icy Memorial":
        set {_artifact} to book named "<#73b7ff>Icy Memorial" with lore "%{_rarity}% Scroll Artifact%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7Deepfrost Set%nl% %nl%" with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]},""minecraft:custom_data"":{""Artifact"":1b,""ArtifactSet"":""Deepfrost""}}"
        set {_artifactLore} to {_artifactLoreDeepfrost}


    loop {_substats} times:
        set {_randomStat} to a random element of {_stats::*}
        remove {_randomStat} from {_stats::*}
        set {_randomSubstatValue} to a random element of {_substatValues::*}
        set {_statAmount} to rounded (({_randomSubstatValue} * 4.7385*{_itemLevel})/6)
        replace all " x " in {_randomStat} with " +%{_statAmount}% "
        add {_randomStat} to lore of {_artifact}
        set {_nbtText::*} to uncolored {_randomStat} split at " "
        clear {_nbtText::2} and {_nbtText::1} and {_nbtText::0}
        set {_nbtText} to join {_nbtText::*} by " "
        set int tag "Stats;%{_nbtText}%" of (custom nbt of {_artifact}) to {_statAmount}
    add {_artifactLore} to lore of {_artifact}
    set {_statList::*} to "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Control", "Versatility", "Mastery", "Critical Hit", "Element", "Haste" and "Avoidance"
    loop {_statList::*}:
        if int tag "Stats;%loop-value%" of (custom nbt of {_artifact}) is set:
            add loop-value to {_artifactStats::*}
    set {_lore::*} to lore of {_artifact}
    set lore of {_artifact} to {_lore::*}
    set int tag "InitialSubstats" of (custom nbt of {_artifact}) to {_substats}
    set int tag "Upgraded" of (custom nbt of {_artifact}) to 0
    set long tag "Experience" of (custom nbt of {_artifact}) to 0
    set int tag "ItemLevel" of (custom nbt of {_artifact}) to {_itemLevel}
    set int tag "StarLevel" of (custom nbt of {_artifact}) to {_starLevel}
    if string tag "GearId" of (custom nbt of {_artifact}) is not set:
        set string tag "GearId" of (custom nbt of {_artifact}) to "%random uuid%"
    return {_artifact}

function ArtifactStarLore(starLevel: integer) :: text:
    if {_starLevel} = 1:
        return "&e★"
    else if {_starLevel} = 2:
        return "&e★★"
    else if {_starLevel} = 3:
        return "&e★★★"
    else if {_starLevel} = 4:
        return "&e★★★★"
    return "&e★★★★★"

function ArtifactRarityColourText(starLevel: integer) :: text:
    if {_starLevel} = 1:
        return "<#cccccc>Common"
    else if {_starLevel} = 2:
        return "<#1fef00>Uncommon"
    else if {_starLevel} = 3:
        return "<#0070dd>Rare"
    else if {_starLevel} = 4:
        return "<#a335ee>Epic"
    return "<#ff8000>Legendary"

function ArtifactSubstatLore(starLevel: integer) :: text:
    if {_starLevel} = 1:
        return "&8&oby a random value. One star artifacts%nl%&8&oalways start with one substat."
    else if {_starLevel} = 2:
        return "&8&oby a random value. Two star artifacts%nl%&8&ostart with one substat and have a%nl%&8&o33.33%% chance to start with two."
    else if {_starLevel} = 3:
        return "&8&oby a random value. Three star artifacts%nl%&8&ostart with two substats and have a%nl%&8&o33.33%% chance to start with three."
    else if {_starLevel} = 4:
        return "&8&oby a random value. Four star artifacts%nl%&8&oalways start with three substats."
    return "&8&oby a random value. Five star artifacts%nl%&8&ostart with three substats and have a%nl%&8&o33.33%% chance to start with four."

function ArtifactInfoBlock(starLevel: integer, upgraded: integer) :: text:
    set {_starLevelLore} to ArtifactStarLore({_starLevel})
    set {_loreSubstats} to ArtifactSubstatLore({_starLevel})
    return "&fUpgraded: +%{_upgraded}%%nl%&m&8-------------------------------------------%nl%&7Star Level: &e%{_starLevelLore}%%nl%&8&o(!) Every five upgrades raises a random substat%nl%%{_loreSubstats}%"

function ArtifactSetBonusBlock(set: text, info: text) :: text:
    if {_set} = "Scorched":
        return "%nl% %nl%<#ff7045>2 Set Bonus: <#ff3014>Lava &7and <#ff4d00>Fire &7damage dealt is%nl%&7increased by &f8%%&7.%nl%<#ff7045>4 Set Bonus: &7Using your Ultimate Ability increases%nl%&7your <#f53b98> Mastery &7by &f30%% &7for &f10 sec&7. This effect%nl%&7has a &f20 sec &7cooldown.%nl% %nl%%{_info}%"
    else if {_set} = "Arcane Mysteries":
        return "%nl% %nl%<#7154b8>2 Set Bonus: &7Gain &f40 <#f53b98> Mastery &7if it is your highest stat.%nl%<#7154b8>4 Set Bonus: &7Gain a fluctuating &f+2%% &7elemental damage bonus%nl%&7every &f2 sec&7. &7After reaching an increase of &f+16%%&7,%nl%&7the effect will persist for &f5 sec &7before it will rapidly%nl%&7start declining every &f1 sec &7and ultimately reset.%nl% %nl%&7When you use your Ultimate Ability, double the%nl%&7current effect and extend its duration by &f10 sec&7.%nl%&7The elemental damage bonus is halved if your element%nl%&7is not <#512989>Magic&7, <#431d53>Ghost &7or <#333333>Dark&7.%nl% %nl%%{_info}%"
    else if {_set} = "Marksmanship":
        return "%nl% %nl%<#aad372>2 Set Bonus: &7Damage dealt while at least &f20 &7blocks%nl%&7from the target is increased by &f12%%&7.%nl%<#aad372>4 Set Bonus: &7Increases damage dealt by ranged%nl%&7weapons and projectiles by &f35%%&7.%nl% %nl%%{_info}%"
    else if {_set} = "Deepfrost":
        return "%nl% %nl%<#73b7ff>2 Set Bonus: <#add8e6>Ice &7damage dealt is increased by &f15%%&7.%nl%<#73b7ff>4 Set Bonus: <#fca417> Critically Hitting &7an enemy will grant%nl%&7you &f+3%% <#fca417> Critical Damage &7for &f20 sec&7. Each following%nl%<#fca417> Critical Hit &7will increase this bonus by an additional%nl%&f3%%&7, stacking up to &f12 &7times.%nl% %nl%%{_info}%"
    return "%nl% %nl%%{_info}%"

function ArtifactTypeLabel(item: item) :: text:
    set {_base} to type of {_item}
    if {_base} = green dye:
        return "Flower Artifact"
    else if {_base} = firework star:
        return "Orb Artifact"
    else if {_base} = glass bottle:
        return "Phial Artifact"
    else if {_base} = book:
        return "Scroll Artifact"
    return "Artifact"

function ArtifactLoreUpdate(item: item) :: text:
    set {_customNbt} to custom nbt of {_item}
    set {_starLevel} to int tag "StarLevel" of {_customNbt}
    set {_itemLevel} to int tag "ItemLevel" of {_customNbt}
    set {_upgraded} to int tag "Upgraded" of {_customNbt}
    if {_upgraded} is not set:
        set {_upgraded} to 0
    set {_set} to string tag "ArtifactSet" of {_customNbt}

    set {_rarity} to ArtifactRarityColourText({_starLevel})
    set {_typeLabel} to ArtifactTypeLabel({_item})

    set {_lore} to "%{_rarity}% %{_typeLabel}%%nl%<#fdd002>Item Level %{_itemLevel}%%nl%&7%{_set}% Set%nl% "

    set {_statList::*} to "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Control", "Versatility", "Mastery", "Critical Hit", "Element", "Haste" and "Avoidance"
    loop {_statList::*}:
        set {_statAmount} to int tag "Stats;%loop-value%" of {_customNbt}
        if {_statAmount} is set:
            set {_formattedStat} to getFormattedStat(loop-value)
            replace all "{VALUE}" in {_formattedStat} with "+%{_statAmount}%"
            set {_lore} to "%{_lore}%%nl%%{_formattedStat}%"

    set {_info} to ArtifactInfoBlock({_starLevel}, {_upgraded})
    set {_lore} to "%{_lore}%%ArtifactSetBonusBlock({_set}, {_info})%"

    return {_lore}

#Generic formula for calculating secondary stat budget
function statFormula(itemLevel: integer) :: number:
    set {_formula} to (1.0136^({_itemLevel}/3)) * 0.287*{_itemLevel}
    return {_formula}

#Formula for calculating secondary stat budget on Ring, Neck, Bracer, Cloak slots
function accessoryGearFormula(itemLevel: integer) :: number:
    set {_formula} to 1 + 0.2*({_itemLevel}^1.5)/3
    return {_formula}

#Formula for calculating health on gear
function healthFormula(itemLevel: integer) :: number:
    set {_healthFormula} to (((0.0337397 * {_itemLevel}) + 1.981137)*(1.15^((1/13.62)*{_itemLevel})))*1.81108
    return {_healthFormula}

function primaryStatFormula(itemLevel: integer) :: number:
    set {_primaryStatFormula} to 5.16 * (1.26^((1/13.6)*{_itemLevel}))
    return {_primaryStatFormula}

function statMultiplierGear(type: string) :: number:
    if {_type} = "accessory":
        set {_multiplier} to 9/16
    else if {_type} = "minorMain":
        set {_multiplier} to 12/16
    else if {_type} = "majorMain":
        set {_multiplier} to 1
    return {_multiplier}

function GearScoreRarityMultiplier(rarity: text) :: number:
    if {_rarity} = "Common":
        return 1
    else if {_rarity} = "Uncommon":
        return 1.05
    else if {_rarity} = "Rare":
        return 1.12
    else if {_rarity} = "Epic":
        return 1.2
    else if {_rarity} = "Legendary":
        return 1.32
    return 1

function GearScoreSlotMultiplier(slot: text) :: number:
    if {_slot} = "Ring" or "Necklace" or "Bracers" or "Cloak":
        return statMultiplierGear("accessory")
    else if {_slot} = "Boots" or "Shoulders" or "Belt" or "Gloves":
        return statMultiplierGear("minorMain")
    else if {_slot} = "Helmet" or "Chestplate" or "Leggings" or "Weapon":
        return statMultiplierGear("majorMain")
    return 1

function GearScoreGemTypeMultiplier(type: text) :: number:
    if {_type} = "Uncommon":
        return 1
    else if {_type} = "Rare":
        return 1.18
    else if {_type} = "Epic":
        return 1.35
    return 1

function GearScoreStatValue(stat: text, value: number) :: number:
    if {_stat} = "Health":
        return {_value} * 0.08
    else if {_stat} = "Strength":
        return {_value} * 2.6
    else if {_stat} = "Intellect":
        return {_value} * 2.6
    else if {_stat} = "Agility":
        return {_value} * 2.6
    else if {_stat} = "Damage":
        return {_value} * 5.2
    else if {_stat} = "Resistance":
        return {_value} * 4.4
    else if {_stat} = "Mobility":
        return {_value} * 3.3
    else if {_stat} = "Utility":
        return {_value} * 3.4
    else if {_stat} = "Crowd Control":
        return {_value} * 3.8
    else if {_stat} = "Versatility":
        return {_value} * 4.6
    else if {_stat} = "Mastery":
        return {_value} * 4.8
    else if {_stat} = "Critical Hit":
        return {_value} * 5
    else if {_stat} = "Element":
        return {_value} * 5.4
    else if {_stat} = "Haste":
        return {_value} * 4.9
    else if {_stat} = "Avoidance":
        return {_value} * 3.1
    return {_value} * 3

function ArtifactRarityFromStar(starLevel: integer) :: text:
    if {_starLevel} = 1:
        return "Common"
    else if {_starLevel} = 2:
        return "Uncommon"
    else if {_starLevel} = 3:
        return "Rare"
    else if {_starLevel} = 4:
        return "Epic"
    return "Legendary"

function ArtifactRollUnit(itemLevel: integer) :: number:
    return round((0.186 * 4.7385 * {_itemLevel}) / 6, 0)

function ArtifactRollCount(item: item) :: integer:
    set {_stats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    set {_currentSubstats} to size of {_stats::*}
    set {_initialSubstats} to int tag "InitialSubstats" of (custom nbt of {_item})
    if {_initialSubstats} is not set:
        set {_initialSubstats} to {_currentSubstats}
    set {_upgradeLevel} to int tag "Upgraded" of (custom nbt of {_item})
    return {_initialSubstats} + floor({_upgradeLevel} / 5)

function ArtifactCurrentValue(item: item) :: number:
    set {_stats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    loop {_stats::*}:
        set {_value} to int tag "Stats;%loop-value%" of (custom nbt of {_item})
        set {_total} to {_total} + {_value}
    return {_total}

function ArtifactMaxValue(item: item) :: number:
    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_item})
    set {_unit} to ArtifactRollUnit({_itemLevel})
    set {_rollCount} to ArtifactRollCount({_item})
    return {_unit} * {_rollCount}

function ArtifactValueRatio(item: item) :: number:
    set {_currentValue} to ArtifactCurrentValue({_item})
    set {_maxValue} to ArtifactMaxValue({_item})
    if {_maxValue} <= 0:
        return 0
    set {_ratio} to {_currentValue} / {_maxValue}
    if {_ratio} > 1:
        set {_ratio} to 1
    return {_ratio}

function ArtifactJudgePercent(item: item) :: number:
    return round(ArtifactValueRatio({_item}) * 100, 1)

function GearScoreRelic(p: player, relic: item) :: number:
    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_relic})
    if {_itemLevel} is not set:
        set {_itemLevel} to round(RelicAverageItemLevel({_p}), 0)
    set {_upgraded} to int tag "Upgraded" of (custom nbt of {_relic})
    if {_upgraded} is not set:
        set {_upgraded} to 0
    set {_enhanced} to int tag "Enhanced" of (custom nbt of {_relic})
    if {_enhanced} is not set:
        set {_enhanced} to 0
    set {_score} to {_itemLevel} * 4.8
    set {_score} to {_score} * (1 + ({_upgraded} / 125))
    set {_score} to {_score} * (1 + ({_enhanced} * 0.05))
    return {_score}

function CalculateCardGearScore(p: player, saveResult: boolean = true) :: number:
    set {_gearScore} to 0

    loop yaml node keys "Gear" in "activeCard-%{_p}%":
        set {_gearSlot} to loop-value
        set {_gearItem} to yaml value "Gear.%{_gearSlot}%" in "activeCard-%{_p}%"
        if {_gearItem} is set:
            if boolean tag "GearItem" of (custom nbt of {_gearItem}) is set:
                set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_gearItem})
                set {_rarity} to string tag "Rarity" of (custom nbt of {_gearItem})
                set {_slotType} to string tag "GearSlot" of (custom nbt of {_gearItem})
                set {_baseScore} to {_itemLevel} * 6.5
                set {_baseScore} to {_baseScore} * GearScoreSlotMultiplier({_slotType})
                set {_baseScore} to {_baseScore} * GearScoreRarityMultiplier({_rarity})
                set {_gearScore} to {_gearScore} + {_baseScore}

                set {_socketAmount} to int tag "Sockets" of (custom nbt of {_gearItem})
                if {_socketAmount} is set:
                    set {_gearScore} to {_gearScore} + ({_socketAmount} * 40)
                    loop {_socketAmount} times:
                        set {_socketIndex} to loop-number
                        if yaml value "Card.Gear.%{_gearSlot}%.Socket.%{_socketIndex}%.Gem.Name" in "activeCard-%{_p}%" is set:
                            set {_gemRank} to yaml value "Card.Gear.%{_gearSlot}%.Socket.%{_socketIndex}%.Gem.Rank" in "activeCard-%{_p}%"
                            set {_gemType} to yaml value "Card.Gear.%{_gearSlot}%.Socket.%{_socketIndex}%.Gem.Type" in "activeCard-%{_p}%"
                            set {_gemStatKeys::*} to yaml node keys "Card.Gear.%{_gearSlot}%.Socket.%{_socketIndex}%.Gem.Stats" in "activeCard-%{_p}%"
                            loop {_gemStatKeys::*}:
                                set {_gemValue} to yaml value "Card.Gear.%{_gearSlot}%.Socket.%{_socketIndex}%.Gem.Stats.%loop-value-3%" in "activeCard-%{_p}%"
                                set {_gemStatsTotal} to {_gemStatsTotal} + GearScoreStatValue(loop-value-3, {_gemValue})
                            set {_gemScore} to ({_gemStatsTotal} * GearScoreGemTypeMultiplier({_gemType})) + (20 * {_gemRank})
                            set {_gearScore} to {_gearScore} + {_gemScore}
                            clear {_gemStatsTotal}
                            clear {_gemStatKeys::*}

                if yaml value "Card.Gear.%{_gearSlot}%.Socket Bonus.Stats" in "activeCard-%{_p}%" is set:
                    set {_socketBonusKeys::*} to yaml node keys "Card.Gear.%{_gearSlot}%.Socket Bonus.Stats" in "activeCard-%{_p}%"
                    loop {_socketBonusKeys::*}:
                        set {_bonusValue} to yaml value "Card.Gear.%{_gearSlot}%.Socket Bonus.Stats.%loop-value-2%" in "activeCard-%{_p}%"
                        set {_gearScore} to {_gearScore} + GearScoreStatValue(loop-value-2, {_bonusValue})
                    clear {_socketBonusKeys::*}

                if yaml value "Card.Gear.%{_gearSlot}%.Enchant.Name" in "activeCard-%{_p}%" is set:
                    set {_enchantRank} to yaml value "Card.Gear.%{_gearSlot}%.Enchant.Rank" in "activeCard-%{_p}%"
                    set {_enchantKeys::*} to yaml node keys "Card.Gear.%{_gearSlot}%.Enchant.Stats" in "activeCard-%{_p}%"
                    loop {_enchantKeys::*}:
                        set {_enchantValue} to yaml value "Card.Gear.%{_gearSlot}%.Enchant.Stats.%loop-value-2%" in "activeCard-%{_p}%"
                        set {_enchantStatsTotal} to {_enchantStatsTotal} + GearScoreStatValue(loop-value-2, {_enchantValue})
                    set {_gearScore} to {_gearScore} + {_enchantStatsTotal} + (18 * {_enchantRank})
                    clear {_enchantStatsTotal}
                    clear {_enchantKeys::*}

                if yaml value "Card.Gear.%{_gearSlot}%.2Set.Name" in "activeCard-%{_p}%" is set:
                    set {_gearScore} to {_gearScore} + 30

                if yaml value "Card.Gear.%{_gearSlot}%.4Set.Name" in "activeCard-%{_p}%" is set:
                    set {_gearScore} to {_gearScore} + 60

                if yaml value "Card.Gear.%{_gearSlot}%.Starforged.Card" in "activeCard-%{_p}%" is set:
                    set {_gearScore} to {_gearScore} + 90

            else if boolean tag "Artifact" of (custom nbt of {_gearItem}) is set:
                set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_gearItem})
                set {_starLevel} to int tag "StarLevel" of (custom nbt of {_gearItem})
                set {_rarity} to ArtifactRarityFromStar({_starLevel})
                set {_qualityRatio} to ArtifactValueRatio({_gearItem})
                set {_artifactBase} to {_itemLevel} * 4.8
                set {_artifactBase} to {_artifactBase} * GearScoreRarityMultiplier({_rarity})
                set {_artifactBase} to {_artifactBase} * {_qualityRatio}
                set {_gearScore} to {_gearScore} + {_artifactBase}

            else if boolean tag "Relic" of (custom nbt of {_gearItem}) is set:
                set {_gearScore} to {_gearScore} + GearScoreRelic({_p}, {_gearItem})
            else if GearIsRelic({_gearItem}) is true:
                set {_gearScore} to {_gearScore} + GearScoreRelic({_p}, {_gearItem})

    loop yaml node keys "Card.Gear Set Bonuses" in "activeCard-%{_p}%":
        if yaml value "Card.Gear Set Bonuses.%loop-value%.2Set.Active" in "activeCard-%{_p}%" is true:
            set {_gearScore} to {_gearScore} + 70
        if yaml value "Card.Gear Set Bonuses.%loop-value%.4Set.Active" in "activeCard-%{_p}%" is true:
            set {_gearScore} to {_gearScore} + 140

    loop yaml node keys "Card.Starforged Bonus" in "activeCard-%{_p}%":
        loop yaml node keys "Card.Starforged Bonus.%loop-value%" in "activeCard-%{_p}%":
            if yaml value "Card.Starforged Bonus.%loop-value-1%.%loop-value-2%.2Set.Active" in "activeCard-%{_p}%":
                set {_gearScore} to {_gearScore} + 220
            if yaml value "Card.Starforged Bonus.%loop-value-1%.%loop-value-2%.4Set.Active" in "activeCard-%{_p}%":
                set {_gearScore} to {_gearScore} + 420

    loop yaml node keys "Card.Artifact Sets" in "activeCard-%{_p}%":
        set {_count} to yaml value "Card.Artifact Sets.%loop-value%" in "activeCard-%{_p}%"
        if {_count} >= 2:
            set {_twoSetCount} to floor({_count} / 2)
            set {_gearScore} to {_gearScore} + ({_twoSetCount} * 160)

    set {_gearScore} to round({_gearScore}, 0)
    if {_saveResult} is true:
        set yaml value "Card.Gear Score" in "activeCard-%{_p}%" to {_gearScore}
        save yaml "activeCard-%{_p}%"
    return {_gearScore}



function GearIsRelic(item: item) :: boolean:
    if boolean tag "Relic" of (custom nbt of {_item}) is set:
        if string tag "Card" of (custom nbt of {_item}) is set:
            return true
    return false

function GearLoreUpdate(item: item) :: string:
    set {_customNbt} to custom nbt of {_item}

    if GearIsRelic({_item}) is true:
        set {_relic} to RelicLoreUpdate({_item})
        return join (lore of {_relic}) by nl

    if boolean tag "Artifact" of {_customNbt} is set:
        return ArtifactLoreUpdate({_item})

    set {_rarity} to string tag "Rarity" of {_customnbt}
    set {_gearSlot} to string tag "GearSlot" of {_customnbt}
    set {_rarityColour} to yaml value "Rarity Colours.%{_rarity}%" in "GearList"
    set {_rarityString} to formatted "%{_rarityColour}%%{_rarity}% %{_gearSlot}%"
    set {_itemLevel} to int tag "ItemLevel" of {_customnbt}
    set {_source} to string tag "Source" of {_customnbt}
    set {_gearItem} to unformatted name of {_item}

    if string tag "Cardbound" of {_customnbt} is set:
        set {_cardbound} to string tag "Cardbound" of {_customnbt}
        set {_bindString} to "&fCardbound: %{_cardbound}%"
    else:
        set {_bindString} to "&fBinds when equipped"

    set {_lore} to "%{_rarityString}%%nl%%{_bindString}%%nl%<#fdd002>Item Level %{_itemLevel}%"

    set {_health} to int tag "Stats;Health" of {_customnbt}
    if string tag "PrimaryStat" of {_customnbt} is set:
        set {_primaryStat} to string tag "PrimaryStat" of {_customnbt}
        set {_primaryStatFormatted} to getFormattedStat({_primaryStat})
        set {_primaryStatValue} to int tag "Stats;%{_primaryStat}%" of {_customnbt}
        replace all "{VALUE}" in {_primaryStatFormatted} with "+%{_primaryStatValue}%"
        set {_lore} to "%{_lore}%%nl%%{_primaryStatFormatted}%"
    set {_lore} to "%{_lore}%%nl%<#c0ff02> +%{_health}% Health"

    set {_statList::*} to yaml node keys "Gear.%{_source}%.%{_gearItem}%.Stats" in "GearList"
    loop {_statList::*}:
        set {_statAmount} to int tag "Stats;%loop-value%" of {_customnbt}

        set {_formattedStat} to getFormattedStat(loop-value)
        replace "{VALUE}" in {_formattedStat} with "+%{_statAmount}%"
        set {_lore} to "%{_lore}%%nl%%{_formattedStat}%"

    if string tag "Enchant;Name" of {_customnbt} is set:
        set {_lore} to "%{_lore}%%nl%"
        set {_enchantName} to string tag "Enchant;Name" of {_customnbt}
        set {_enchantRank} to int tag "Enchant;Rank" of {_customnbt}
        set {_enchantStats::*} to nbt tags of (compound tag "Enchant;Stats" of {_customnbt})
        
        set {_rankColour} to formatted (yaml value "Rank Colours.%{_enchantRank}%" in "GearList")
        set {_stars} to "★" repeated {_enchantRank} times

        set {_lore} to "%{_lore}%%nl%<#00ff00>✨ Enchanted: %{_enchantName}%"

        loop {_enchantStats::*}:
            set {_enchantStatAmount} to int tag "Enchant;Stats;%loop-value%" of {_customnbt}
            set {_formattedStat} to getFormattedStat(loop-value)
            replace "{VALUE}" in {_formattedStat} with "+%{_enchantStatAmount}%"
            set {_lore} to "%{_lore}%%nl%   &7Rank: %{_rankColour}%%{_stars}% &7| %{_formattedStat}%"

    set {_runes::*} to nbt tags of compound tag "Runes" of {_customnbt}
    if {_runes::*} is set:
        loop {_runes::*}:
            set {_runeCard} to string tag "Runes;%loop-value%;Card" of {_customnbt}
            set {_runeValue} to double tag "Runes;%loop-value%;Value" of {_customnbt}
            set {_runicPower} to double tag "Runes;%loop-value%;Runic Power" of {_customnbt}
            set {_runeDescription} to formatted (yaml value "%{_runeCard}%.%loop-value%.Description" in "RuneList")

            replace all "{VALUE}" in {_runeDescription} with "%{_runeValue}%"
            
            set {_runeCardColour} to formatted (yaml value "Card Colours.%{_runeCard}%.Base" in "CardList")

            set {_runeName} to "<#9a38ab>🌀 Rune: %loop-value% (%{_runeCard}%) [%{_runicPower}%%%]"

            set {_lore} to "%{_lore}%%nl% %nl%%{_runeName}%%nl%   %{_runeDescription}%"

    set {_socketAmount} to int tag "Sockets" of {_customnbt}
    loop {_socketAmount} times:
        if loop-counter = 1:
            set {_lore} to "%{_lore}%%nl% "

        if string tag "Socket;%loop-counter%;Gem;Lore" of {_customnbt} is set:
            set {_socketLore} to string tag "Socket;%loop-counter%;Gem;Lore" of {_customnbt}
            set {_lore} to "%{_lore}%%nl%%{_socketLore}%"
            set {_socketsFilled} to {_socketsFilled} + 1
        else:
            set {_socketType} to string tag "Socket;%loop-counter%;Type" of {_customnbt}
            set {_socketHexColour} to formatted (yaml value "Sockets.%{_socketType}%.Colour" in "GearList")
            set {_socket} to "%{_socketHexColour}% &7%{_socketType}% Socket"
            set {_lore} to "%{_lore}%%nl%%{_socket}%"

        set {_socketLoreLength::*} to {_lore} split at nl
        set int tag "Socket;%loop-counter%;Lore Line" of {_customnbt} to (size of {_socketLoreLength::*})
    
    if yaml value "Gear.%{_source}%.%{_gearItem}%.Socket Bonus.SocketBonusStatDivisor" in "GearList" is set:
        if {_socketsFilled} = {_socketAmount}:
            set {_socketBonusUnlocked} to true

        set {_socketBonuses::*} to nbt tags of (compound tag "SocketBonus" of {_customnbt})
        loop {_socketBonuses::*}:
            set {_socketBonusValue} to int tag "SocketBonus;%loop-value%" of {_customnbt}
            set {_formattedStat} to getFormattedStat(loop-value)
            replace "{VALUE}" in {_formattedStat} with "+%{_socketBonusValue}%"
            if {_socketBonusUnlocked} = true:
                set {_lore} to "%{_lore}%%nl%&fSocket Bonus: %{_formattedStat}%"
            else:
                set {_formattedStat} to unformatted {_formattedStat}
                set {_lore} to "%{_lore}%%nl%&7Socket Bonus: %{_formattedStat}%"

    if string tag "2Set;Name" of {_customnbt} is set:
        set {_2setItemBonus} to string tag "2Set;Name" of {_customnbt}
    else if yaml value "Gear.%{_source}%.%{_gearItem}%.2Set.Name" in "GearList" is set:
        set {_2setItemBonus} to yaml value "Gear.%{_source}%.%{_gearItem}%.2Set.Name" in "GearList"

    if {_2setItemBonus} is set:
        set {_lore} to "%{_lore}%%nl% %nl%&7%{_2setItemBonus}% Set"

        if yaml value "Set Bonuses.%{_2setItemBonus}%.2Set.Description" in "GearList" is set:
            set {_desc} to GearSetDescription({_2setItemBonus}, "2Set", false)
            set {_lore} to "%{_lore}%%nl%&72 Set Bonus: %{_desc}%"

        if yaml value "Set Bonuses.%{_2setItemBonus}%.4Set.Description" in "GearList" is set:
            set {_desc} to GearSetDescription({_2setItemBonus}, "4Set", false)
            set {_lore} to "%{_lore}%%nl%&74 Set Bonus: %{_desc}%"

    if StarforgeApplied({_item}) is true:
        set {_lore} to "%{_lore}%%StarforgeInactiveBlock({_item})%"

    if yaml value "Gear.%{_source}%.%{_gearItem}%.Flavour Text" in "GearList" is set:
        set {_flavourText} to yaml value "Gear.%{_source}%.%{_gearItem}%.Flavour Text" in "GearList"
        replace all "{NL}" in {_flavourText} with nl
        set {_lore} to "%{_lore}%%nl% %nl%%{_flavourText}%"

    set {_-} to "-" repeated 36 times
    set {_lore} to "%{_lore}%%nl%&8&m%{_-}%%nl%&8(!) This item can be equipped in the %{_gearSlot}%%nl%&8slot and becomes Cardbound when equipped."

    return {_lore}

function Gear(gearItem: string, itemType: string, itemLevel: integer, rarity: string, gearType: string, source: string) :: item:
    #"<#ffc830> &7Yellow Socket"
    #Siege of Spawn
    set {_primaryStatFormula} to primaryStatFormula({_itemLevel})
    set {_healthFormula} to healthFormula({_itemLevel})
    set {_formula} to statFormula({_itemLevel})

    if {_itemType} = "Ring" or "Necklace" or "Bracers" or "Cloak":
        set {_formula} to accessoryGearFormula({_itemLevel})
        set {_multiplier} to statMultiplierGear("accessory")  
    else if {_itemType} = "Boots" or "Shoulders" or "Belt" or "Gloves":
        set {_multiplier} to statMultiplierGear("minorMain")
        set {_formula} to {_formula}*{_multiplier}
    else if {_itemType} = "Helmet" or "Chestplate" or "Leggings" or "Weapon":
        set {_multiplier} to statMultiplierGear("majorMain")
        set {_formula} to {_formula}*{_multiplier}

    set {_primaryStat} to {_primaryStatFormula}*{_multiplier}
    set {_secondaryStatBudget} to {_formula}
    set {_health} to {_healthFormula}*{_multiplier}

    if {_gearType} = "Strength":
        set {_primaryIcon} to "<#e35959>"
    else if {_gearType} = "Intellect":
        set {_primaryIcon} to "<#59c1e3>"
    else if {_gearType} = "Agility":
        set {_primaryIcon} to "<#5ee359>"

    set {_rarityUncoloured} to uncoloured {_rarity}

    set {_socketBonusFormula} to 1 + 0.0275*{_itemLevel}
    set {_rarityColour} to formatted (yaml value "Rarity Colours.%{_rarityUncoloured}%" in "GearList")

    set {_item} to (yaml value "Gear.%{_source}%.%{_gearItem}%.Base Item" in "GearList") parsed as item type
    set {_colour} to yaml value "Gear.%{_source}%.%{_gearItem}%.Colour" in "GearList"
    set {_itemType} to yaml value "Gear.%{_source}%.%{_gearItem}%.Type" in "GearList"
    set {_CMD} to yaml value "Gear.%{_source}%.%{_gearItem}%.CustomModelData" in "GearList"
    set {_itemName} to formatted "%{_colour}%%{_gearItem}%"
    set {_rarityString} to formatted "%{_rarityColour}%%{_rarity}% %{_itemType}%"

    set {_item} to {_item} named {_itemName} with nbt from "{""minecraft:custom_model_data"":{floats:[%{_CMD}%.0f]}}"
    
    set int tag "Stats;Health" of (custom nbt of {_item}) to round({_health}, 0)
    set {_stats} to coloured "%{_rarityString}%%nl%&fBinds when equipped%nl%<#fdd002>Item Level %{_itemLevel}%%nl%"
    replace all "<none>" in {_stats} with ""

    if yaml value "Gear.%{_source}%.%{_gearItem}%.Primary Stat" in "GearList" = true:
        set {_stats} to "%{_stats}%%{_primaryIcon}% +%round({_primaryStat}, 0)% %{_gearType}%%nl%"
        set int tag "Stats;%{_gearType}%" of (custom nbt of {_item}) to round({_primaryStat}, 0)
        set string tag "PrimaryStat" of (custom nbt of {_item}) to {_gearType}

    set {_stats} to "%{_stats}%<#c0ff02> +%round({_health}, 0)% Health"
    set {_statDivisor} to yaml value "Gear.%{_source}%.%{_gearItem}%.StatDivisor" in "GearList"
    set {_socketStatDivisor} to yaml value "Gear.%{_source}%.%{_gearItem}%.Socket Bonus.SocketBonusStatDivisor" in "GearList"

    loop yaml node keys "Gear.%{_source}%.%{_gearItem}%.Stats" in "GearList":
        set {_statValue} to yaml value "Gear.%{_source}%.%{_gearItem}%.Stats.%loop-value%" in "GearList"
        set {_statValue} to {_statValue}/{_statDivisor}
        set {_statAmount} to round(({_statValue})*{_secondaryStatBudget}, 0)
        set int tag "Stats;%loop-value%" of (custom nbt of {_item}) to {_statAmount}
        
        set {_formattedStat} to getFormattedStat(loop-value)
        replace "{VALUE}" in {_formattedStat} with "+%{_statAmount}%"
        set {_stats} to "%{_stats}%%nl%%{_formattedStat}%"

    set {_maxSockets} to yaml value "Gear.%{_source}%.%{_gearItem}%.Max Sockets" in "GearList"

    set {_socketColours::*} to yaml node keys "Sockets" in "GearList"
    remove "Uncommon" and "Rare" from {_socketColours::*}

    if {_maxSockets} > 0:
        loop {_maxSockets} times:
            if yaml value "Gear.%{_source}%.%{_gearItem}%.Sockets" in "GearList" >= loop-counter:
                set {_chance} to 100
            else:
                set {_chance} to 10
            chance of {_chance}%:
                set int tag "Sockets" of (custom nbt of {_item}) to (int tag "Sockets" of (custom nbt of {_item})) + 1
                if {_rarityUncoloured} != "Epic":
                    set {_randomSocketInt} to a random integer between 1 and 2
                    if {_randomSocketInt} = 1:
                        set {_randomSocket} to a random element of {_socketColours::*}
                        set {_socketHexColour} to formatted (yaml value "Sockets.%{_randomSocket}%.Colour" in "GearList")
                    else:
                        if {_rarityUncoloured} = "Common" or "Uncommon":
                            set {_socketHexColour} to formatted (yaml value "Sockets.Uncommon.Colour" in "GearList")
                            set {_randomSocket} to "Uncommon"

                        else if {_rarityUncoloured} = "Rare":
                            set {_socketHexColour} to formatted (yaml value "Sockets.Rare.Colour" in "GearList")
                            set {_randomSocket} to "Rare"
                else:
                    set {_randomSocket} to a random element of {_socketColours::*} 
                    set {_socketHexColour} to formatted (yaml value "Sockets.%{_randomSocket}%.Colour" in "GearList")

                set {_socket} to "%{_socketHexColour}% &7%{_randomSocket}% Socket"
                set string tag "Socket;%loop-counter%;Type" of (custom nbt of {_item}) to {_randomSocket}

                if loop-counter = 1:
                    set {_stats} to "%{_stats}%%nl% %nl%%{_socket}%"
                else:
                    set {_stats} to "%{_stats}%%nl%%{_socket}%"

                set {_socketLoreLength::*} to {_stats} split at nl
                set int tag "Socket;%loop-counter%;Lore Line" of (custom nbt of {_item}) to (size of {_socketLoreLength::*})
    
    if int tag "Sockets" of (custom nbt of {_item}) > 0:
        if yaml value "Gear.%{_source}%.%{_gearItem}%.Socket Bonus.SocketBonusStatDivisor" in "GearList" is set:
            loop yaml node keys "Gear.%{_source}%.%{_gearItem}%.Socket Bonus.Stats" in "GearList":
                set {_socketStatValue} to yaml value "Gear.%{_source}%.%{_gearItem}%.Socket Bonus.Stats.%loop-value%" in "GearList"
                set {_socketStatValue} to {_socketStatValue}/{_socketStatDivisor}
                set {_statAmount} to round(({_socketStatValue})* {_socketBonusFormula}, 0)
                
                set {_formattedStat} to uncoloured getFormattedStat(loop-value)
                replace "{VALUE}" in {_formattedStat} with "+%{_statAmount}%"
                set {_formattedStat} to "&7Socket Bonus: %{_formattedStat}%"
                set {_socketBonusString::*} to {_socketBonusString::*} and {_formattedStat}

                set int tag "SocketBonus;%loop-value%" of (custom nbt of {_item}) to {_statAmount}
                set {_stats} to "%{_stats}%%nl%%{_formattedStat}%"

    if yaml value "Gear.%{_source}%.%{_gearItem}%.2Set.Name" in "GearList" is set:
        set {_2setItemBonus} to yaml value "Gear.%{_source}%.%{_gearItem}%.2Set.Name" in "GearList"
        set string tag "2Set;Name" of (custom nbt of {_item}) to {_2setItemBonus}

        loop yaml node keys "Set Bonuses.%{_2setItemBonus}%.2Set.Stats" in "GearList":
            set {_2SetStat} to yaml value "Set Bonuses.%{_2setItemBonus}%.2Set.Stats.%loop-value%" in "GearList"
            set int tag "2Set;Stats;%loop-value%" of (custom nbt of {_item}) to {_2SetStat}

        if yaml value "Set Bonuses.%{_2setItemBonus}%.4Set.Stats" in "GearList" is set:
            loop yaml node keys "Set Bonuses.%{_2setItemBonus}%.4Set.Stats" in "GearList":
                set {_4SetStat} to yaml value "Set Bonuses.%{_2setItemBonus}%.4Set.Stats.%loop-value%" in "GearList"
                set int tag "4Set;Stats;%loop-value%" of (custom nbt of {_item}) to {_4SetStat}

        set {_stats} to "%{_stats}%%nl% %nl%&7%{_2setItemBonus}% Set"

        if yaml value "Set Bonuses.%{_2setItemBonus}%.2Set.Description" in "GearList" is set:
            set {_desc} to GearSetDescription({_2setItemBonus}, "2Set", false)
            set {_stats} to "%{_stats}%%nl%&72 Set Bonus: %{_desc}%"

        if yaml value "Set Bonuses.%{_2setItemBonus}%.4Set.Description" in "GearList" is set:
            set {_desc} to GearSetDescription({_2setItemBonus}, "4Set", false)
            set {_stats} to "%{_stats}%%nl%&74 Set Bonus: %{_desc}%"
    
    if yaml value "Gear.%{_source}%.%{_gearItem}%.Flavour Text" in "GearList" is set:
        set {_flavourText} to yaml value "Gear.%{_source}%.%{_gearItem}%.Flavour Text" in "GearList"
        replace all "{NL}" in {_flavourText} with nl
        set {_stats} to "%{_stats}%%nl% %nl%%{_flavourText}%"

    set {_-} to "-" repeated 36 times
    set {_stats} to "%{_stats}%%nl%&8&m%{_-}%%nl%&8(!) This item can be equipped in the %{_itemType}%%nl%&8slot and becomes Cardbound when equipped."
    add {_stats} to lore of {_item}

    set string tag "GearSlot" of (custom nbt of {_item}) to {_itemType}
    set int tag "ItemLevel" of (custom nbt of {_item}) to {_itemLevel}
    set string tag "Rarity" of (custom nbt of {_item}) to uncolored {_rarity}
    set string tag "Source" of (custom nbt of {_item}) to {_source}
    set boolean tag "GearItem" of (custom nbt of {_item}) to true
    set boolean tag "Disenchantable" of (custom nbt of {_item}) to true

    set {_item} to {_item} with item flag hide attributes
    set max stack size component of {_item} to 1

    if string tag "GearId" of (custom nbt of {_item}) is not set:
        set string tag "GearId" of (custom nbt of {_item}) to "%random uuid%"

    return {_item}


function GearItemLevel(mobLevel: integer, type: string, keystoneLevel: integer) :: integer:
    if {_type} = "dungeon":
        set {_worldMaxItemLevel} to 1 + (({maxCardLevel} + 10) * 0.82)
        set {_itemLevel} to round(({_worldMaxItemLevel} - 12) + ({_keystoneLevel} * 2))    
    else if {_type} = "grandvault":
        set {_itemLevel} to round(({_worldMaxItemLevel} - 12) + (({_keystoneLevel} + 4) * 2.1))
    return {_itemLevel}

function ArtifactStarLevel(starlvl: integer, mobLevel: integer) :: integer:
    if {_starlvl} = 1:
        set {_ilvl} to round(3 + ({_mobLevel}*0.4), 0)
    else if {_starlvl} = 2:
        set {_ilvl} to round(4 + ({_mobLevel}*0.46), 0)
    else if {_starlvl} = 3:
        set {_ilvl} to round(6 + ({_mobLevel}*0.6), 0)
    else if {_starlvl} = 4:
        set {_ilvl} to round(8 + ({_mobLevel}*0.72), 0)
    else if {_starlvl} = 5:
        set {_ilvl} to round(10 + ({_mobLevel}*0.84), 0)
    return {_ilvl}


function CalculateCardAverageItemLevel(p: player, saveResult: boolean = true) :: number:
    set {_average} to RelicAverageItemLevel({_p})
    if {_saveResult} is true:
        set yaml value "Card.Average Item Level" in "activeCard-%{_p}%" to {_average}
        save yaml "activeCard-%{_p}%"
    return {_average}

function RelicTotalGearSlots() :: integer:
    return 17

function RelicAverageItemLevel(p: player) :: number:
    set {_total} to 0
    loop yaml node keys "Card.Gear" in "activeCard-%{_p}%":
        set {_slot} to loop-value
        if {_slot} does not contain "Relic":
            set {_itemLevel} to yaml value "Card.Gear.%{_slot}%.Item Level" in "activeCard-%{_p}%"
            if {_itemLevel} is not set:
                set {_gearItem} to yaml value "Gear.%{_slot}%" in "activeCard-%{_p}%"
                if {_gearItem} is set:
                    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_gearItem})
            if {_itemLevel} is set:
                set {_total} to {_total} + {_itemLevel}
    set {_average} to round({_total} / RelicTotalGearSlots(), 2)
    if {_average} < 1:
        set {_average} to 1
    return {_average}

function RelicUpgradeMultiplier(item: item) :: number:
    set {_upgraded} to int tag "Upgraded" of (custom nbt of {_item})
    if {_upgraded} is not set:
        set {_upgraded} to 0
    return 1 + ({_upgraded} / 125)

function RelicIsPrimaryStat(stat: text) :: boolean:
    if {_stat} = "Strength" or "Agility" or "Intellect":
        return true
    return false

function RelicBaseStat(stat: text, itemLevel: integer) :: integer:
    if RelicIsPrimaryStat({_stat}) is true:
        return round(primaryStatFormula({_itemLevel}), 0)
    return round(statFormula({_itemLevel}), 0)


function RelicEnsureStats(item: item) :: item:
    set {_stats::*} to "Strength", "Agility", "Intellect", "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Control", "Versatility", "Mastery", "Critical Hit", "Element", "Haste" and "Avoidance"
    set {_existing::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    loop {_existing::*}:
        if {_stats::*} does not contain loop-value:
            clear int tag "Stats;%loop-value%" of (custom nbt of {_item})
    set {_existing::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    if size of {_existing::*} <= 0:
        loop lore of {_item}:
            if loop-value does not contain "%%":
                if loop-value does not contain "Special Effect":
                    if loop-value does not contain "Item Level":
                        if loop-value does not contain "Star Level":
                            if loop-value does not contain "Upgraded:":
                                set {_line} to uncolored loop-value
                                replace all "+" in {_line} with ""
                                set {_parts::*} to {_line} split at " "
                                loop {_stats::*}:
                                    if {_line} contains loop-value-2:
                                        loop {_parts::*}:
                                            set {_number} to loop-value-3 parsed as number
                                            if {_number} is set:
                                                set int tag "Stats;%loop-value-2%" of (custom nbt of {_item}) to round({_number}, 0)
                                                stop loop
    set {_existing::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    loop {_existing::*}:
        if int tag "BaseStats;%loop-value%" of (custom nbt of {_item}) is not set:
            set int tag "BaseStats;%loop-value%" of (custom nbt of {_item}) to int tag "Stats;%loop-value%" of (custom nbt of {_item})
    return {_item}

function RelicFormattedStat(stat: text, value: number) :: text:
    if {_stat} = "Health":
        return "<##c0ff02> +%{_value}% Health"
    else if {_stat} = "Damage":
        return "<##f74428> +%{_value}% Damage"
    else if {_stat} = "Resistance":
        return "<##ffef45> +%{_value}% Resist"
    else if {_stat} = "Mobility":
        return "&f +%{_value}% Mobility"
    else if {_stat} = "Utility":
        return "<##ae78d0> +%{_value}% Utility"
    else if {_stat} = "Crowd Control":
        return "<##58c3f5> +%{_value}% Crowd Control"
    else if {_stat} = "Versatility":
        return "<##e3ebff> +%{_value}% Versatility"
    else if {_stat} = "Mastery":
        return "<##f53b98> +%{_value}% Mastery"
    else if {_stat} = "Critical Hit":
        return "<##fca417> +%{_value}% Critical Hit"
    else if {_stat} = "Element":
        return "<##d5ff57> +%{_value}% Element"
    else if {_stat} = "Haste":
        return "<##19943e> +%{_value}% Haste"
    else if {_stat} = "Avoidance":
        return "<##2154ad> +%{_value}% Avoidance"
    else if {_stat} = "Strength":
        return "<##e35959> +%{_value}% Strength"
    else if {_stat} = "Intellect":
        return "<##59c1e3> +%{_value}% Intellect"
    else if {_stat} = "Agility":
        return "<##5ee359> +%{_value}% Agility"
    return ""

function RelicCard(item: item) :: text:
    set {_card} to string tag "Card" of (custom nbt of {_item})
    if {_card} is set:
        return {_card}
    if yaml "DiamondChestList" is loaded:
        loop yaml node keys "Cards" in "DiamondChestList":
            set {_relicItem} to yaml value "Cards.%loop-value%.Relic.Item" in "DiamondChestList"
            if {_relicItem} is set:
                if uncolored name of {_relicItem} = uncolored name of {_item}:
                    return loop-value
    set {_line} to uncolored line 1 of lore of {_item}
    replace all "Legendary " in {_line} with ""
    replace all "Epic " in {_line} with ""
    replace all "Rare " in {_line} with ""
    replace all "Uncommon " in {_line} with ""
    replace all "Common " in {_line} with ""
    replace all " Relic" in {_line} with ""
    if {_line} is set:
        if {_line} is not "":
            return {_line}
    return ""

function RelicCanEquip(p: player, item: item) :: boolean:
    set {_card} to RelicCard({_item})
    if {_card} is "":
        return true
    if {_card} = uncolored name of {_p}'s tool:
        return true
    return false

function RelicCannotEquipMessage(item: item) :: text:
    set {_card} to RelicCard({_item})
    if {_card} is "":
        return "&cThis relic cannot be equipped by this card."
    return "&cThis relic can only be equipped by %{_card}%."

function RelicLoreUpdate(item: item) :: item:
    set {_item} to RelicEnsureStats({_item})
    set boolean tag "Relic" of (custom nbt of {_item}) to true
    set string tag "GearSlot" of (custom nbt of {_item}) to "Relic"
    set {_card} to RelicCard({_item})
    if {_card} is not "":
        set string tag "Card" of (custom nbt of {_item}) to {_card}
        set {_base} to yaml value "Cards.%{_card}%.Relic.Item" in "DiamondChestList"
        if {_base} is set:
            set lore of {_item} to lore of {_base}
    set {_customNbt} to custom nbt of {_item}
    set {_itemLevel} to int tag "ItemLevel" of {_customNbt}
    set {_upgraded} to int tag "Upgraded" of {_customNbt}
    set {_enhanced} to int tag "Enhanced" of {_customNbt}
    if {_itemLevel} is not set:
        set {_itemLevel} to 1
    if {_upgraded} is not set:
        set {_upgraded} to 0
    if {_enhanced} is not set:
        set {_enhanced} to 0
    set {_stats::*} to nbt tags of (compound tag "Stats" of {_customNbt})
    loop lore of {_item}:
        set {_line} to loop-value
        if {_line} contains "<#fdd002>Item Level":
            if {_itemLevelLineSet} is true:
                set {_skipLine} to true
            else:
                set {_line} to "<#fdd002>Item Level %{_itemLevel}%"
                set {_itemLevelLineSet} to true
        else if {_line} contains "Upgraded:":
            set {_line} to "&fUpgraded: +%{_upgraded}% | Enhanced: +%{_enhanced}%"
        else:
            loop {_stats::*}:
                if {_line} contains "+":
                    if {_line} contains loop-value-2:
                        set {_value} to int tag "Stats;%loop-value-2%" of {_customNbt}
                        set {_formattedStat} to RelicFormattedStat(loop-value-2, {_value})
                        if {_formattedStat} is not "":
                            set {_line} to {_formattedStat}
        if {_skipLine} is not true:
            set {_lore::*} to {_lore::*} and {_line}
        clear {_skipLine}
    set lore of {_item} to {_lore::*}
    return {_item}

function RelicApplyScaling(p: player, item: item) :: item:
    if GearIsRelic({_item}) is false:
        return {_item}
    set {_item} to RelicEnsureStats({_item})
    set boolean tag "Relic" of (custom nbt of {_item}) to true
    set string tag "GearSlot" of (custom nbt of {_item}) to "Relic"
    set {_card} to RelicCard({_item})
    if {_card} is not "":
        set string tag "Card" of (custom nbt of {_item}) to {_card}
    set {_itemLevel} to round(RelicAverageItemLevel({_p}), 0)
    set int tag "ItemLevel" of (custom nbt of {_item}) to {_itemLevel}
    set {_multiplier} to RelicUpgradeMultiplier({_item})
    set {_stats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    loop {_stats::*}:
        set {_baseValue} to RelicBaseStat(loop-value, {_itemLevel})
        set {_baseFloor} to int tag "BaseStats;%loop-value%" of (custom nbt of {_item})
        if {_baseFloor} is set:
            if {_itemLevel} <= 1:
                set {_baseValue} to {_baseFloor}
            else if {_baseValue} < {_baseFloor}:
                set {_baseValue} to {_baseFloor}
        set {_value} to round({_baseValue} * {_multiplier}, 0)
        set int tag "Stats;%loop-value%" of (custom nbt of {_item}) to {_value}
    return RelicLoreUpdate({_item})

function ArtifactReqExp(artifact: item) :: integer:
    set {_upgradeLevel} to int tag "Upgraded" of (custom nbt of {_artifact})
    set {_experience} to long tag "Experience" of (custom nbt of {_artifact})
    set {_requiredExp} to floor(min(64, (2.6 * {_upgradeLevel}) + 2))
        
    return {_requiredExp}

function RelicReqExp(relic: item) :: integer:
    set {_upgradeLevel} to int tag "Upgraded" of (custom nbt of {_relic})
    set {_maxUpgradeLevel} to 125
    set {_requiredExp} to rounded (2 * ((sqrt({_upgradeLevel}+1)/sqrt({_maxUpgradeLevel})))*2.515) * ({_upgradeLevel}+1) + 2
    #if {_upgradeLevel} < 25:
    #    set {_requiredExp} to ArtifactReqExp({_relic})
    #else:
    #    set {_requiredExp} to 256
    return {_requiredExp}
#give player purple dye named "<#a335ee>Elemental Lariat" with lore "&6Item Level 350%nl%&fNecklace%nl%&d<#fca417> +141 Critical Hit%nl%<#19943e> +141 Haste%nl% %nl%<#9985ff>Equip: Your spells and abilities have%nl%<#9985ff>a chance to empower one of your%nl%<#9985ff>Card's elemental gems, granting 330%nl%<#9985ff>of their associated stat for 12 sec.%nl% %nl%&f &b +75 Intellect <#fca417> +66 Critical Hit%nl%&f <#fca417> +48 Intellect <#19943e> +23 Haste%nl%&f <#fca417> +48 Intellect <#19943e> +23 Haste"
#give player gold nugget named "<#a335ee>Ring of Forbidden Techniques" with lore  "<#fdd002>Item Level 53%nl%&fRing%nl%<#c0ff02> +7 Health%nl%<#f53b98> +19 Mastery%nl%<#19943e> +5 Haste" with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"

on inventory click:
    if player's current inventory = metadata tag "gearcard" of player:
        cancel event
    if event-inventory = metadata tag "gearcard" of player:
        if event-slot is between 0 and 53:
            cancel event
            set {_possibleSlots::*} to 10, 11, 12, 19, 20, 21, 28, 29, 30, 37, 38, 39, 14, 23, 32, 41, 43
            if {_possibleSlots::*} contains index of event-slot:
                if inventory action != instant move:
                    play sound "block.chest.close" with volume 2 and pitch 1 to player
                    set {_gearSlot} to yaml value "Slot Map.%index of event-slot%" in "GearList"
                    if {_gearSlot} is not set:
                        if index of event-slot = 43:
                            set {_gearSlot} to "Relic"
                    set metadata value "CurrentGearSlot" of player to {_gearSlot}
                    if {_gearSlot} is set:
                        set metadata value "CardGearSlot" of player to chest inventory with 1 row named "Gear Slot - %{_gearSlot}%"
                        set slot 4 of metadata value "CardGearSlot" of player to black stained glass pane named "&f%{_gearSlot}%"
                        set lore of slot 4 of metadata value "CardGearSlot" of player to "&7Click on this slot to pick an%nl%&7item from your inventory and have%nl%&7your card equip it."
                        open metadata value "CardGearSlot" of player to player
                else:
                    if event-slot != air:
                        if string tag "GearSlot" of (custom nbt of event-slot) is set:
                            set {_slot} to event-slot
                        else if boolean tag "Artifact" of (custom nbt of event-slot) is set:
                            set {_slot} to event-slot
                        else if GearIsRelic(event-slot) is true:
                            set {_slot} to event-slot
                        if {_slot} is set:
                            set {_gearItem} to event-slot
                            clear metadata tag "GearConfirm" of player
                            set {_gearSlot} to yaml value "Slot Map.%index of event-slot%" in "GearList"
                            if {_gearSlot} is not set:
                                if index of event-slot = 43:
                                    set {_gearSlot} to "Relic"

                            close player's inventory
                            play sound "block.chest.close" with volume 2 and pitch 1.3 to player
                            play sound "entity.player.levelup" with volume 2 and pitch 0.15 to player

                            set {_customNbtGear} to custom nbt of {_gearItem}
                            set {_customNbtItem} to custom nbt of (player's tool)

                            if string tag "Id" of (custom nbt of {karta::%player%}) is set:
                                set {_id} to cardId(player)

                            if {_gearSlot} contains "Artifact":
                                if string tag "ArtifactSet" of {_customNbtGear} is set:
                                    set {_artifactSet} to string tag "ArtifactSet" of {_customNbtGear}
                                else:
                                    set {_artifactSet} to uncolored line 3 of lore of {_gearItem}
                                    replace all " Set" in {_artifactSet} with ""

                                set {_artifactSetCount} to int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem})

                                remove 1 from {_artifactSetCount}
                                if {_artifactSetCount} = 0:
                                    clear int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem})
                                    clear yaml value "Card.Artifact Sets.%{_artifactSet}%" in "activeCard-%player%"
                                else:
                                    set int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem}) to {_artifactSetCount}
                                    set yaml value "Card.Artifact Sets.%{_artifactSet}%" in "activeCard-%player%" to {_artifactSetCount}

                            if line 2 of lore of {_gearItem} contains "Binds when equipped":
                                set line 2 of lore of event-slot to "&fCardbound: %{_id}%"
                                set string tag "Cardbound" of {_customNbtGear} to {_id}
                            set {_card} to {kartaname::%player%}	

                            set {_returnItem} to event-slot
                            if GearIsRelic({_returnItem}) is true:
                                set {_returnItem} to RelicLoreUpdate({_returnItem})
                            else:
                                set lore of {_returnItem} to GearLoreUpdate({_returnItem})
                            giveItem(player, {_returnItem})

                            loop yaml nodes with keys "Card.Gear.%{_gearSlot}%.Stats" from "activeCard-%player%":
                                set {_loopStatAmount} to yaml value "Card.Gear.%{_gearSlot}%.Stats.%loop-value%" in "activeCard-%player%"
                                set {_statNbt} to int tag "Stats;%loop-value%" of ({_customNbtItem})
                                set {_statNbt} to {_statNbt} - {_loopStatAmount}
                                set int tag "Stats;%loop-value%" of ({_customNbtItem}) to {_statNbt}
                                set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                                set {_statNbtTotal} to {_statNbtTotal} - {_loopStatAmount}
                                set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                                set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                                set {_statNbtTotalGear} to {_statNbtTotalGear} - {_loopStatAmount}
                                set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}
                            
                            if compound tag "Socket" of {_customNbtGear} is set:
                                set {_sockets::*} to nbt tags of compound tag "Socket" of {_customNbtGear}
                                loop {_sockets::*}:
                                    set {_statsType::*} to nbt tags of (compound tag "Socket;%loop-value%;Gem;Stats" of {_customNbtGear})
                                    
                                    if yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem" in "activeCard-%player%" is set:
                                        clear yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem" in "activeCard-%player%"

                                        loop {_statsType::*}:
                                            set {_value} to int tag "Socket;%loop-value-1%;Gem;Stats;%loop-value-2%" of {_customNbtGear}
                                            set yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem.Stats.%loop-value-2%" in "activeCard-%player%" to {_value}

                                            set {_statNbt} to int tag "Stats;%loop-value-2%" of ({_customNbtItem})
                                            set {_statNbt} to {_statNbt} - {_value}
                                            set int tag "Stats;%loop-value-2%" of ({_customNbtItem}) to {_statNbt}
                                            set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                                            set {_statNbtTotal} to {_statNbtTotal} - {_value}
                                            set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                                            set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                                            set {_statNbtTotalGear} to {_statNbtTotalGear} - {_value}
                                            set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}

                                set {_socketAmount} to int tag "Sockets" of {_customNbtGear}
                                loop {_socketAmount} times:
                                    if string tag "Socket;%loop-counter%;Gem;Lore" of {_customNbtGear} is set:
                                        set {_socketsFilled} to {_socketsFilled} + 1

                                if {_socketsFilled} = {_socketAmount}:
                                    set {_socketBonuses::*} to nbt tags of (compound tag "SocketBonus" of {_customNbtGear})
                                    loop {_socketBonuses::*}:
                                        set {_value} to int tag "SocketBonus;%loop-value%" of {_customNbtGear}
                                        clear yaml value "Card.Gear.%{_gearSlot}%.Socket Bonus" in "activeCard-%player%"

                                        set {_statNbt} to int tag "Stats;%loop-value%" of ({_customNbtItem})
                                        set {_statNbt} to {_statNbt} - {_value}
                                        set int tag "Stats;%loop-value%" of ({_customNbtItem}) to {_statNbt}
                                        set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                                        set {_statNbtTotal} to {_statNbtTotal} - {_value}
                                        set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                                        set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                                        set {_statNbtTotalGear} to {_statNbtTotalGear} - {_value}
                                        set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}

                            loop yaml nodes with keys "Card.Gear.%{_gearSlot}%.Enchant.Stats" from "activeCard-%player%":
                                set {_loopStatAmount} to yaml value "Card.Gear.%{_gearSlot}%.Enchant.Stats.%loop-value%" in "activeCard-%player%"
                                set {_statNbt} to int tag "Stats;%loop-value%" of ({_customNbtItem})
                                set {_statNbt} to {_statNbt} - {_loopStatAmount}
                                set int tag "Stats;%loop-value%" of ({_customNbtItem}) to {_statNbt}
                                
                                set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                                set {_statNbtTotal} to {_statNbtTotal} - {_loopStatAmount}
                                set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                                set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                                set {_statNbtTotalGear} to {_statNbtTotalGear} - {_loopStatAmount}
                                set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear} 
                            
                            set {_runes::*} to nbt tags of (compound tag "Runes" of {_customNbtGear})
                            if {_runes::*} is set:
                                loop {_runes::*}:
                                    set {_runeValue} to double tag "Runes;%loop-value%;Value" of {_customNbtGear}
                                    set {_runicPower} to double tag "Runes;%loop-value%;Runic Power" of {_customNbtGear}

                                    removeRune(player, player's tool, loop-value, {_runeValue}, {_runicPower})
                                
                            clear yaml value "Card.Gear.%{_gearSlot}%" in "activeCard-%player%"
                            clear yaml value "Gear.%{_gearSlot}%" in "activeCard-%player%"
                    
                RecalculateRegularGearSets(player)
                RecalculateStarforgedBonuses(player)
                CalculateCardGearScore(player)
                CalculateCardAverageItemLevel(player)

                UpdateCard(player)
                CardStatUpdate(player)
                set max health of player to 25 + ({health::%player%}/5)
                set scaled health of player to 20
                heal the player
                save yaml "activeCard-%player%"

    else if player's current inventory = (metadata value "CardGearSlot" of player):
        if event-slot is between 0 and 8:
            cancel event
            if event-slot is 4:
                set {_slotIndex} to 0

                set {_id} to cardId(player)
                set {_card} to {kartaname::%player%}

                set {_cardLevel} to int tag "Level" of (custom nbt of player's tool)
                set metadata value "gearEquip" of player to chest inventory with 6 rows named "Equip Gear"
                play sound "block.chest.close" with volume 2 and pitch 1.1 to player

                set {_eventSlotType} to uncolored name of event-slot

                loop all items in the player's inventory:
                    if (item amount of loop-item) = 1:
                        set {_customNbt} to custom nbt of loop-item
                        if boolean tag "GeatItem" of {_customNbt} = true:
                            if string tag "GearId" of {_customNbt} is not set:
                                set string tag "GearId" of {_customNbt} to "%random uuid%"

                        if {_eventSlotType} contains "Relic":
                            if GearIsRelic(loop-item) is true:
                                set {_item} to loop-item
                        else if {_eventSlotType} does not contain "Artifact":
                            if {_eventSlotType} contains (string tag "GearSlot" of {_customNbt}):
                                set {_item} to loop-item
                        else:
                            if boolean tag "Artifact" of {_customNbt} is set:
                                if (line 1 of lore of loop-item) contains ({_eventSlotType}):
                                    set {_item} to loop-item

                        if {_item} is set:
                            set slot {_slotIndex} of metadata value "gearEquip" of player to loop-item
                            if GearIsRelic({_item}) is true:
                                set {_canUpgrade} to true
                            else if boolean tag "Artifact" of (custom nbt of {_item}) is not set:
                                set {_itemLevel} to (int tag "ItemLevel" of {_customNbt})
                                if {_cardLevel} >= round(0.6*{_itemLevel}, 0):
                                    set {_canUpgrade} to true
                                else:
                                    if {_cardLevel} >= {maxCardLevel}:
                                        set {_canUpgrade} to true
                            else:
                                set {_canUpgrade} to true
                            
                            set {_slot} to slot {_slotIndex} of metadata value "gearEquip" of player
                            set {_lore::*} to lore of {_slot}

                            if {_canUpgrade} = true:
                                set {_customNbtSlot} to custom nbt of {_slot}
                                if GearIsRelic({_slot}) is true:
                                    if RelicCanEquip(player, {_slot}) is false:
                                        set {_lore::*} to {_lore::*} and "%nl%%RelicCannotEquipMessage({_slot})%"
                                        set {_blockedRelic} to true
                                if {_blockedRelic} is not true:
                                    if string tag "Cardbound" of {_customNbtSlot} is set:
                                        set {_cardBound} to string tag "Cardbound" of {_customNbtSlot}

                                        if {_cardBound} != {_id}:
                                            set {_lore::*} to {_lore::*} and "%nl%&c&oThis item is Cardbound to %{_cardBound}%."

                                        else:
                                            set {_lore::*} to {_lore::*} and "%nl%&f&oClick here to equip this item."
                                            set boolean tag "CanInteract" of {_customNbtSlot} to true
                                    else:
                                        set {_lore::*} to {_lore::*} and "%nl%&f&oClick here to equip this item."
                                        set boolean tag "CanInteract" of {_customNbtSlot} to true
                                clear {_blockedRelic}
                            else:
                                set {_lore::*} to {_lore::*} and "%nl%&c&oCard level is too low."
                            
                            set lore of {_slot} to (join {_lore::*} by nl)
                            set slot {_slotIndex} of metadata value "gearEquip" of player to {_slot}

                            add 1 to {_slotIndex}
                            add 1 to {_items}

                        clear {_item}

                if {_slotIndex} > 0:
                    open metadata value "gearEquip" of player to player
                else:
                    play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                    send "&c&oThere are no Gear items in your inventory." to player

    else if player's current inventory = (metadata value "gearEquip" of player):
        if event-slot is between 0 and 26:
            cancel event
        if boolean tag "CanInteract" of (custom nbt of event-slot) is set:
            clear boolean tag "CanInteract" of (custom nbt of event-slot)
            set {_slot} to event-slot
            set metadata value "GearItemToEquip" of player to event-slot
            loop lore of {_slot}:
                if loop-counter < (size of (lore of {_slot}) - 1):
                    add loop-value to {_lore::*}
            set lore of {_slot} to {_lore::*}

            set metadata tag "GearConfirm" of player to chest inventory with 3 rows named "Gear - Confirm"
            set slot 11 of metadata tag "GearConfirm" of player to {_slot}
            set slot 15 of metadata tag "GearConfirm" of player to lime stained glass pane named "&aConfirm?" with lore "&7Click here to confirm the process and%nl%&7equip this item.%nl%&7This item will be removed from your inventory.%nl% %nl%&c&l(&4&l!&c&l) &c&nWarning!&c &oThis item will become Cardbound%nl%&cwhen equipped."
            open metadata tag "GearConfirm" of player to player
            play sound "block.chest.close" with volume 2 and pitch 1.2 to player
    #Equipping / Replacing gear
    else if player's current inventory = (metadata tag "GearConfirm" of player):
        if event-slot is between 0 and 26:
            cancel event
        if event-slot is 15:
            set {_id} to cardId(player)
            if line 2 of lore of (slot 11 of metadata tag "GearConfirm" of player) contains "Binds when equipped":
                set line 2 of lore of (slot 11 of metadata tag "GearConfirm" of player) to "&fCardbound: %{_id}%"

            set {_gearItem} to slot 11 of metadata tag "GearConfirm" of player
            
            set {_gearId} to string tag "GearId" of (custom nbt of {_gearItem})

            if string tag "ArtifactType" of (custom nbt of {_gearItem}) is not set:
                if line 1 of lore of {_gearItem} contains "Flower Artifact":
                    set string tag "ArtifactType" of (custom nbt of {_gearItem}) to "Flower Artifact"
                else if line 1 of lore of {_gearItem} contains "Orb Artifact":
                    set string tag "ArtifactType" of (custom nbt of {_gearItem}) to "Orb Artifact"
                else if line 1 of lore of {_gearItem} contains "Phial Artifact":
                    set string tag "ArtifactType" of (custom nbt of {_gearItem}) to "Phial Artifact"
                else if line 1 of lore of {_gearItem} contains "Scroll Artifact":
                    set string tag "ArtifactType" of (custom nbt of {_gearItem}) to "Scroll Artifact"
            clear metadata tag "GearConfirm" of player
            
            loop all items in player's inventory:
                if string tag "GearId" of (custom nbt of loop-item) = {_gearId}:
                    remove 1 of loop-item from player's inventory
                    stop loop

            clear metadata value "GearItemToEquip" of player

            close player's inventory
            play sound "block.chest.close" with volume 2 and pitch 1.3 to player
            play sound "entity.player.levelup" with volume 2 and pitch 0.15 to player

            if GearIsRelic({_gearItem}) is true:
                if RelicCanEquip(player, {_gearItem}) is false:
                    send RelicCannotEquipMessage({_gearItem}) to player
                    play sound "entity.villager.no" with volume 2 and pitch 1 to player
                    stop
                set {_gearItem} to RelicApplyScaling(player, {_gearItem})
            set {_customNbtGear} to custom nbt of {_gearItem}
            set {_customNbtItem} to custom nbt of (player's tool)

            if GearIsRelic({_gearItem}) is true:
                set {_gearSlot} to metadata value "CurrentGearSlot" of player
                
            else if boolean tag "Artifact" of {_customNbtGear} is not set:
                set {_gearSlot} to metadata value "CurrentGearSlot" of player

            else if boolean tag "Artifact" of {_customNbtGear} is set:
                set {_gearSlot} to string tag "ArtifactType" of {_customNbtGear}

            if {_id} is set:
                set string tag "Cardbound" of {_customNbtGear} to {_id}
                    
                set {_card} to {kartaname::%player%}

                loop yaml node keys "Slot Map" in "GearList":
                    set {_slotIndex} to loop-value parsed as integer
                    if yaml value "Slot Map.%loop-value%" in "GearList" = {_gearSlot}:
                        set {_checkSlot} to slot {_slotIndex} of metadata tag "gearcard" of player

                if {_gearSlot} contains "Artifact":
                    if string tag "ArtifactSet" of {_customNbtGear} is set:
                        set {_artifactSet} to string tag "ArtifactSet" of {_customNbtGear}
                    else:
                        set {_artifactSet} to uncolored line 3 of lore of {_gearItem}
                        replace all " Set" in {_artifactSet} with ""

                    set {_artifactSetCount} to int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem})
                    set {_artifactSetCount} to {_artifactSetCount} + 1
                    set int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem}) to {_artifactSetCount}

                    set yaml value "Card.Artifact Sets.%{_artifactSet}%" in "activeCard-%player%" to {_artifactSetCount}

                if {_checkSlot} != air:
                    set {_returnItem} to {_checkSlot}
                    if GearIsRelic({_returnItem}) is true:
                        set {_returnItem} to RelicLoreUpdate({_returnItem})
                    else:
                        set lore of {_returnItem} to GearLoreUpdate({_returnItem})
                    giveItem(player, {_returnItem})
                    if boolean tag "Artifact" of (custom nbt of {_checkSlot}) is set:
                        if string tag "ArtifactSet" of (custom nbt of {_checkSlot}) is set:
                            set {_artifactSet} to string tag "ArtifactSet" of (custom nbt of {_checkSlot})
                        else:
                            set {_artifactSet} to uncolored line 3 of lore of {_checkSlot}
                            replace all " Set" in {_artifactSet} with ""
                        
                        set {_artifactSetCount} to int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem})
                        remove 1 from {_artifactSetCount}
                        if {_artifactSetCount} = 0:
                            clear int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem})
                            clear yaml value "Card.Artifact Sets.%{_artifactSet}%" in "activeCard-%player%"
                        else:
                            set int tag "Artifact Sets;%{_artifactSet}%" of ({_customNbtItem}) to {_artifactSetCount}
                            set yaml value "Card.Artifact Sets.%{_artifactSet}%" in "activeCard-%player%" to {_artifactSetCount}

                loop yaml nodes with keys "Card.Gear.%{_gearSlot}%.Stats" from "activeCard-%player%":
                    set {_loopStatAmount} to yaml value "Card.Gear.%{_gearSlot}%.Stats.%loop-value%" in "activeCard-%player%"
                    set {_statNbt} to int tag "Stats;%loop-value%" of ({_customNbtItem})
                    if {_statNbt} - {_loopStatAmount} > 0:
                        set {_statNbt} to {_statNbt} - {_loopStatAmount}
                        set int tag "Stats;%loop-value%" of ({_customNbtItem}) to {_statNbt}
                    else:
                        set int tag "Stats;%loop-value%" of ({_customNbtItem}) to 0
                    set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                    if {_statNbtTotal} - {_loopStatAmount} > 0:
                        set {_statNbtTotal} to {_statNbtTotal} - {_loopStatAmount}
                        set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                    else:
                        set int tag "Stats;Total" of ({_customNbtItem}) to 0
                    set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                    if {_statNbtTotalGear} - {_loopStatAmount} > 0:
                        set {_statNbtTotalGear} to {_statNbtTotalGear} - {_loopStatAmount}
                        set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}
                    else:
                        set int tag "Stats;GearTotal" of ({_customNbtItem}) to 0

                if yaml value "Card.Gear.%{_gearSlot}%" in "activeCard-%player%" is set:
                    clear yaml value "Card.Gear.%{_gearSlot}%" in "activeCard-%player%"
                if yaml value "Gear.%{_gearSlot}%" in "activeCard-%player%" is set:
                    clear yaml value "Gear.%{_gearSlot}%" in "activeCard-%player%"
                    
                set {_statsGear} to compound tag "Stats" of {_customNbtGear}
                set {_statsType::*} to nbt tags of {_statsGear}
                loop {_statsType::*}:
                    set {_value} to int tag "Stats;%loop-value%" of {_customNbtGear}
                    add {_value} to {_statsValue::*}

                set yaml value "Card.Gear.%{_gearSlot}%.Name" in "activeCard-%player%" to (uncolored (name of {_gearItem}))
                set yaml value "Card.Gear.%{_gearSlot}%.Item Level" in "activeCard-%player%" to (int tag "ItemLevel" of {_customNbtGear})

                if string tag "2Set;Name" of {_customNbtGear} is set:
                    set {_setName} to string tag "2Set;Name" of {_customNbtGear}
                    set yaml value "Card.Gear.%{_gearSlot}%.2Set.Name" in "activeCard-%player%" to {_setName}

                loop {_statsType::*}:
                    set yaml value "Card.Gear.%{_gearSlot}%.Stats.%loop-value%" in "activeCard-%player%" to {_statsValue::%loop-index%}
                    set {_statNbt} to int tag "Stats;%loop-value%" of ({_customNbtItem})
                    set {_statNbt} to {_statNbt} + {_statsValue::%loop-index%}
                    set int tag "Stats;%loop-value%" of ({_customNbtItem}) to {_statNbt}
                    set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                    set {_statNbtTotal} to {_statNbtTotal} + {_statsValue::%loop-index%}
                    set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                    set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                    set {_statNbtTotalGear} to {_statNbtTotalGear} + {_statsValue::%loop-index%}
                    set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}
                    
                if compound tag "Socket" of {_customNbtGear} is set:
                    set {_sockets::*} to nbt tags of compound tag "Socket" of {_customNbtGear}
                    loop {_sockets::*}:
                        if loop-value is set:
                            set {_statsType::*} to nbt tags of (compound tag "Socket;%loop-value%;Gem;Stats" of {_customNbtGear})

                            set {_gemIcon} to string tag "Socket;%loop-value%;Gem;Icon" of (custom nbt of {_customNbtGear})
                            set {_gemName} to string tag "Socket;%loop-value%;Gem;Name" of (custom nbt of {_customNbtGear})
                            set {_gemRank} to int tag "Socket;%loop-value%;Gem;Quality" of (custom nbt of {_customNbtGear})
                            set {_gemType} to string tag "Socket;%loop-value%;Gem;Type" of (custom nbt of {_customNbtGear})
                            set {_gemItemLevel} to int tag "Socket;%loop-value%;Gem;ItemLevel" of (custom nbt of {_customNbtGear})

                            set {_gemItemLevel} to 0 if {_gemItemLevel} is not set

                            set yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem.Name" in "activeCard-%player%" to {_gemName}
                            set yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem.Icon" in "activeCard-%player%" to {_gemIcon}
                            set yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem.Rank" in "activeCard-%player%" to {_gemRank}
                            set yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem.Type" in "activeCard-%player%" to {_gemType}
                            set yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem.Item Level" in "activeCard-%player%" to {_gemItemLevel}

                            loop {_statsType::*}:
                                set {_value} to int tag "Socket;%loop-value-1%;Gem;Stats;%loop-value-2%" of {_customNbtGear}
                                set yaml value "Card.Gear.%{_gearSlot}%.Socket.%loop-value-1%.Gem.Stats.%loop-value-2%" in "activeCard-%player%" to {_value}

                                set {_statNbt} to int tag "Stats;%loop-value-2%" of ({_customNbtItem})
                                set {_statNbt} to {_statNbt} + {_value}
                                set int tag "Stats;%loop-value-2%" of ({_customNbtItem}) to {_statNbt}
                                set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                                set {_statNbtTotal} to {_statNbtTotal} + {_value}
                                set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                                set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                                set {_statNbtTotalGear} to {_statNbtTotalGear} + {_value}
                                set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}

                    set {_socketAmount} to int tag "Sockets" of {_customNbtGear}
                    loop {_socketAmount} times:
                        if string tag "Socket;%loop-counter%;Gem;Lore" of {_customNbtGear} is set:
                            set {_socketsFilled} to {_socketsFilled} + 1

                    if {_socketsFilled} = {_socketAmount}:
                        set {_socketBonuses::*} to nbt tags of (compound tag "SocketBonus" of {_customNbtGear})
                        loop {_socketBonuses::*}:
                            set {_value} to int tag "SocketBonus;%loop-value%" of {_customNbtGear}
                            set yaml value "Card.Gear.%{_gearSlot}%.Socket Bonus.Stats.%loop-value%" in "activeCard-%player%" to {_value}

                            set {_statNbt} to int tag "Stats;%loop-value%" of ({_customNbtItem})
                            set {_statNbt} to {_statNbt} + {_value}
                            set int tag "Stats;%loop-value%" of ({_customNbtItem}) to {_statNbt}
                            set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                            set {_statNbtTotal} to {_statNbtTotal} + {_value}
                            set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                            set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                            set {_statNbtTotalGear} to {_statNbtTotalGear} + {_value}
                            set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}
                
                if string tag "Enchant;Name" of {_customNbtGear} is set:
                    set {_enchantName} to string tag "Enchant;Name" of {_customNbtGear}
                    set {_enchantRank} to int tag "Enchant;Rank" of {_customNbtGear}
                    set yaml value "Card.Gear.%{_gearSlot}%.Enchant.Name" in "activeCard-%player%" to {_enchantName}
                    set yaml value "Card.Gear.%{_gearSlot}%.Enchant.Rank" in "activeCard-%player%" to {_enchantRank}

                    loop nbt tags of (compound tag "Enchant;Stats" of {_customNbtGear}):
                        set {_enchantStatAmount} to int tag "Enchant;Stats;%loop-value%" of {_customNbtGear}
                        set yaml value "Card.Gear.%{_gearSlot}%.Enchant.Stats.%loop-value%" in "activeCard-%player%" to {_enchantStatAmount}

                        set {_statNbt} to int tag "Stats;%loop-value%" of ({_customNbtItem})
                        set {_statNbt} to {_statNbt} + {_enchantStatAmount}
                        set int tag "Stats;%loop-value%" of ({_customNbtItem}) to {_statNbt}

                        set {_statNbtTotal} to int tag "Stats;Total" of ({_customNbtItem})
                        set {_statNbtTotal} to {_statNbtTotal} + {_enchantStatAmount}
                        set int tag "Stats;Total" of ({_customNbtItem}) to {_statNbtTotal}
                        set {_statNbtTotalGear} to int tag "Stats;GearTotal" of ({_customNbtItem})
                        set {_statNbtTotalGear} to {_statNbtTotalGear} + {_enchantStatAmount}
                        set int tag "Stats;GearTotal" of ({_customNbtItem}) to {_statNbtTotalGear}

                set {_runes::*} to nbt tags of (compound tag "Runes" of {_customNbtGear})
                if {_runes::*} is set:
                    loop {_runes::*}:
                        set {_runeValue} to double tag "Runes;%loop-value%;Value" of {_customNbtGear}
                        set {_runicPower} to double tag "Runes;%loop-value%;Runic Power" of {_customNbtGear}
                       
                        set yaml value "Card.Gear.%{_gearSlot}%.Runes.%loop-value%.Value" in "activeCard-%player%" to {_runeValue}
                        set yaml value "Card.Gear.%{_gearSlot}%.Runes.%loop-value%.Runic Power" in "activeCard-%player%" to {_runicPower}

                        applyRune(player, player's tool, loop-value, {_runeValue}, {_runicPower})

                set yaml value "Gear.%{_gearSlot}%" in "activeCard-%player%" to {_gearItem}
                StarforgeSaveGearYaml(player, {_gearSlot}, {_gearItem})
            
            RecalculateRegularGearSets(player)
            RecalculateStarforgedBonuses(player)
            CalculateCardGearScore(player)
            CalculateCardAverageItemLevel(player)

            UpdateCard(player)
            CardStatUpdate(player)
            set max health of player to 25 + ({health::%player%}/5)
            set scaled health of player to 20
            heal the player
            close player's inventory

            save yaml "activeCard-%player%"

            #Add stats...
            #Update lore
            #Update Gear score
            #Update .yml stats 
            #Shift click = unequip

function Marksmanship4Set(p: player) :: boolean:
    if int tag "Marksmanship" of (custom nbt of {karta::%{_p}%}) is set:
        set {_setCount} to int tag "Marksmanship" of (custom nbt of {karta::%{_p}%})
        if {_setCount} >= 4:
            set {_bool} to true
    return {_bool}

function GearSetDescription(setName: text, tier: text, active: boolean = false) :: text:
    if {_active} = true:
        set {_description} to formatted (yaml value "Set Bonuses.%{_setName}%.%{_tier}%.Active Description" in "GearList")
    if {_description} is not set:
        set {_description} to formatted (yaml value "Set Bonuses.%{_setName}%.%{_tier}%.Description" in "GearList")

    loop yaml node keys "Set Bonuses.%{_setName}%.%{_tier}%.Stats" in "GearList":
        set {_value} to yaml value "Set Bonuses.%{_setName}%.%{_tier}%.Stats.%loop-value%" in "GearList"
        replace all "{%loop-value%}" in {_description} with "%{_value}%"

    return {_description}

function RecalculateRegularGearSets(p: player):
    set {_customNbtItem} to custom nbt of {_p}'s tool

    loop yaml node keys "Card.Gear Set Bonuses" in "activeCard-%{_p}%":
        set {_setName} to loop-value
        loop yaml node keys "Card.Gear Set Bonuses.%{_setName}%" in "activeCard-%{_p}%":
            set {_tier} to loop-value-2
            loop yaml node keys "Card.Gear Set Bonuses.%{_setName}%.%{_tier}%.Stats" in "activeCard-%{_p}%":
                set {_stat} to loop-value-3
                set {_value} to yaml value "Card.Gear Set Bonuses.%{_setName}%.%{_tier}%.Stats.%{_stat}%" in "activeCard-%{_p}%"
                
                remove {_value} from int tag "Stats;%{_stat}%" of {_customNbtItem}
                remove {_value} from int tag "Stats;Total" of {_customNbtItem}
                remove {_value} from int tag "Stats;GearTotal" of {_customNbtItem}

                if int tag "Stats;%{_stat}%" of {_customNbtItem} < 0:
                    set int tag "Stats;%{_stat}%" of {_customNbtItem} to 0
                if int tag "Stats;Total" of {_customNbtItem} < 0:
                    set int tag "Stats;Total" of {_customNbtItem} to 0
                if int tag "Stats;GearTotal" of {_customNbtItem} < 0:
                    set int tag "Stats;GearTotal" of {_customNbtItem} to 0

    clear yaml value "Card.Gear Set Bonuses" in "activeCard-%{_p}%"

    loop yaml node keys "Card.Gear" in "activeCard-%{_p}%":
        if yaml value "Card.Gear.%loop-value%.2Set.Name" in "activeCard-%{_p}%" is set:
            set {_setName} to yaml value "Card.Gear.%loop-value%.2Set.Name" in "activeCard-%{_p}%"
            set {_setCount::%{_setName}%} to {_setCount::%{_setName}%} + 1

    loop indices of {_setCount::*}:
        set {_setName} to loop-value in strict proper case

        if {_setCount::%{_setName}%} >= 2:
            set yaml value "Card.Gear Set Bonuses.%{_setName}%.2Set.Active" in "activeCard-%{_p}%" to true
            loop yaml node keys "Set Bonuses.%{_setName}%.2Set.Stats" in "GearList":
                set {_stat} to loop-value-2
                set {_value} to yaml value "Set Bonuses.%{_setName}%.2Set.Stats.%{_stat}%" in "GearList"

                set yaml value "Card.Gear Set Bonuses.%{_setName}%.2Set.Stats.%{_stat}%" in "activeCard-%{_p}%" to {_value}

                set int tag "Stats;%{_stat}%" of {_customNbtItem} to int tag "Stats;%{_stat}%" of {_customNbtItem} + {_value}
                set int tag "Stats;Total" of {_customNbtItem} to int tag "Stats;Total" of {_customNbtItem} + {_value}
                set int tag "Stats;GearTotal" of {_customNbtItem} to int tag "Stats;GearTotal" of {_customNbtItem} + {_value}

        if {_setCount::%{_setName}%} >= 4:
            set yaml value "Card.Gear Set Bonuses.%{_setName}%.4Set.Active" in "activeCard-%{_p}%" to true
            loop yaml node keys "Set Bonuses.%{_setName}%.4Set.Stats" in "GearList":
                set {_stat} to loop-value-2
                set {_value} to yaml value "Set Bonuses.%{_setName}%.4Set.Stats.%{_stat}%" in "GearList"

                set yaml value "Card.Gear Set Bonuses.%{_setName}%.4Set.Stats.%{_stat}%" in "activeCard-%{_p}%" to {_value}

                set int tag "Stats;%{_stat}%" of {_customNbtItem} to int tag "Stats;%{_stat}%" of {_customNbtItem} + {_value}
                set int tag "Stats;Total" of {_customNbtItem} to int tag "Stats;Total" of {_customNbtItem} + {_value}
                set int tag "Stats;GearTotal" of {_customNbtItem} to int tag "Stats;GearTotal" of {_customNbtItem} + {_value}

    save yaml "activeCard-%{_p}%"

function EquippedGearLoreUpdate(p: player, item: item) :: text:
    set {_customNbt} to custom nbt of {_item}

    if GearIsRelic({_item}) is true:
        set {_relic} to RelicLoreUpdate({_item})
        return join (lore of {_relic}) by nl

    if boolean tag "Artifact" of {_customNbt} is set:
        return ArtifactLoreUpdate({_item})

    set {_lore} to GearLoreUpdate({_item})

    if string tag "2Set;Name" of {_customNbt} is set:
        set {_setName} to string tag "2Set;Name" of {_customNbt}
        set {_setCount} to 0

        loop yaml node keys "Card.Gear" in "activeCard-%{_p}%":
            if yaml value "Card.Gear.%loop-value%.2Set.Name" in "activeCard-%{_p}%" = {_setName}:
                set {_setCount} to {_setCount} + 1

        set {_inactiveBlock} to "%nl% %nl%&7%{_setName}% Set"

        if yaml value "Set Bonuses.%{_setName}%.2Set.Description" in "GearList" is set:
            set {_desc} to GearSetDescription({_setName}, "2Set", false)
            set {_inactiveBlock} to "%{_inactiveBlock}%%nl%&72 Set Bonus: %{_desc}%"

        if yaml value "Set Bonuses.%{_setName}%.4Set.Description" in "GearList" is set:
            set {_desc} to GearSetDescription({_setName}, "4Set", false)
            set {_inactiveBlock} to "%{_inactiveBlock}%%nl%&74 Set Bonus: %{_desc}%"

        if {_setCount} >= 2:
            set {_setColour} to coloured (yaml value "Set Bonuses.%{_setName}%.Colour" in "GearList")
        else:
            set {_setColour} to "&7"

        set {_activeBlock} to "%nl% %nl%%{_setColour}%%{_setName}% Set"

        if yaml value "Set Bonuses.%{_setName}%.2Set.Description" in "GearList" is set:
            if {_setCount} >= 2:
                set {_desc} to GearSetDescription({_setName}, "2Set", true)
                set {_activeBlock} to "%{_activeBlock}%%nl%&f2 Set Bonus: %{_desc}%"
            else:
                set {_desc} to GearSetDescription({_setName}, "2Set", false)
                set {_activeBlock} to "%{_activeBlock}%%nl%&72 Set Bonus: %{_desc}%"

        if yaml value "Set Bonuses.%{_setName}%.4Set.Description" in "GearList" is set:
            if {_setCount} >= 4:
                set {_desc} to GearSetDescription({_setName}, "4Set", true)
                set {_activeBlock} to "%{_activeBlock}%%nl%&f4 Set Bonus: %{_desc}%"
            else:
                set {_desc} to GearSetDescription({_setName}, "4Set", false)
                set {_activeBlock} to "%{_activeBlock}%%nl%&74 Set Bonus: %{_desc}%"

        replace all {_inactiveBlock} in {_lore} with {_activeBlock}

    if StarforgeApplied({_item}) is true:
        replace all StarforgeInactiveBlock({_item}) in {_lore} with StarforgeActiveBlock({_p}, {_item})

    return {_lore}


function CardStatBarMax(p: player) :: number:
    set {_stats::*} to "Strength", "Agility", "Intellect", "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Control", "Versatility", "Mastery", "Critical Hit", "Element", "Haste" and "Avoidance"
    set {_max} to 0
    loop {_stats::*}:
        set {_value} to int tag "Stats;%loop-value%" of (custom nbt of {_p}'s tool)
        if {_value} is set:
            if {_value} > {_max}:
                set {_max} to {_value}
    if {_max} <= 0:
        set {_max} to 1
    return {_max}

function StatBarUpdate(p: player, statAmount: number, line: integer, statEN: string, statPL: string, colour: string):
    set {_maxStat} to CardStatBarMax({_p})
    set {_kwadraciki} to round(({_statAmount} / {_maxStat}) * 10, 0)
    if {_statAmount} > 0:
        if {_kwadraciki} < 1:
            set {_kwadraciki} to 1
    if {_kwadraciki} > 10:
        set {_kwadraciki} to 10
    set {_stata} to "&7■■■■■■■■■■"
    set {_statas::*} to {_stata} split at ""
    loop {_kwadraciki} times:
        set {_f} to character at 2 + loop-number in {_stata}
        replace all "■" in {_f} with "%{_colour}%■&7"
        set {_statas::%loop-number + 2%} to {_f}
    set {_stata} to join {_statas::*} by ""
    set line {_line} of lore of {_p}'s tool to "&7%{_statEN}%: %{_stata}% &7(%{_colour}%%{_statAmount}%&7)"

function CardStatUpdate(p: player):
    if string tag "PrimaryStat" of (custom nbt of {_p}'s tool) = "Intellect":
        set {_intellect} to int tag "Stats;Intellect" of (custom nbt of {_p}'s tool)
        StatBarUpdate({_p}, {_intellect}, 4, "Intellect", "Intelekt", "<#59c1e3>")
    else if string tag "PrimaryStat" of (custom nbt of {_p}'s tool) = "Agility":
        set {_agility} to int tag "Stats;Agility" of (custom nbt of {_p}'s tool)
        StatBarUpdate({_p}, {_agility}, 4, "Agility", "Zwinność", "<#5ee359>")
    else if string tag "PrimaryStat" of (custom nbt of {_p}'s tool) = "Strength":
        set {_strength} to int tag "Stats;Strength" of (custom nbt of {_p}'s tool)
        StatBarUpdate({_p}, {_strength}, 4, "Strength", "Siła", "<#e35959>")
    set {_health} to int tag "Stats;Health" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_health}, 5, "Health", "Zdrowie", "<#c0ff02>")
    set {_damage} to int tag "Stats;Damage" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_damage}, 6, "Damage", "Obrażenia", "<#f74428>")
    set {_resistance} to int tag "Stats;Resistance" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_resistance}, 7, "Resistance", "Wytrzymałość", "<#ffef45>")
    set {_mobility} to int tag "Stats;Mobility" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_mobility}, 8, "Mobility", "Mobilność", "&f")
    set {_utility} to int tag "Stats;Utility" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_utility}, 9, "Utility", "Użyteczność", "<#ae78d0>")
    set {_crowdcontrol} to int tag "Stats;Crowd Control" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_crowdcontrol}, 10, "Crowd Control", "Kontrola Tłumu", "<#58c3f5>")
    set {_versatility} to int tag "Stats;Versatility" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_versatility}, 11, "Versatility", "Uniwersalność", "<#e3ebff>")
    set {_mastery} to int tag "Stats;Mastery" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_mastery}, 12, "Mastery", "Mistrzostwo", "<#f53b98>")
    set {_criticalhit} to int tag "Stats;Critical Hit" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_criticalhit}, 13, "Critical Hit", "Cios Krytyczny", "<#fca417>")
    set {_element} to int tag "Stats;Element" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_element}, 14, "Element", "Żywioł", "<#d5ff57>")
    set {_haste} to int tag "Stats;Haste" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_haste}, 15, "Haste", "Pośpiech", "<#19943e>")
    set {_avoidance} to int tag "Stats;Avoidance" of (custom nbt of {_p}'s tool)
    StatBarUpdate({_p}, {_avoidance}, 16, "Avoidance", "Unik", "<#2154ad>")