function PapitoIsStardust(item: item) :: boolean:
    if {_item} is air:
        return false
    if (1 of {_item}).isSimilar(1 of {stardust}) is true:
        return true
    set {_name} to uncolored name of {_item}
    set {_stardustName} to uncolored name of {stardust}
    if {_name} contains {_stardustName}:
        return true
    if {_name} contains "Stardust":
        return true
    loop lore of {_item}:
        if uncolored loop-value contains "Stardust":
            return true
    return false

function PapitoStardustInInventory(p: player) :: integer:
    set {_count} to 0
    loop all items in {_p}'s inventory:
        if PapitoIsStardust(loop-value) is true:
            set {_count} to {_count} + loop-value.getAmount()
    return {_count}

function PapitoRemoveStardust(p: player, amount: number) :: boolean:
    if PapitoStardustInInventory({_p}) < {_amount}:
        return false
    set {_remaining} to round({_amount}, 0)
    loop all items in {_p}'s inventory:
        if PapitoIsStardust(loop-value) is true:
            set {_have} to loop-value.getAmount()
            set {_single} to 1 of loop-value
            if {_have} <= {_remaining}:
                remove {_have} of {_single} from {_p}
                set {_remaining} to {_remaining} - {_have}
            else:
                remove {_remaining} of {_single} from {_p}
                set {_remaining} to 0
            if {_remaining} <= 0:
                return true
    return true

function PapitoMaxUpgrade(item: item) :: integer:
    if boolean tag "Artifact" of (custom nbt of {_item}) is set:
        return (int tag "StarLevel" of (custom nbt of {_item})) * 5
    if boolean tag "Relic" of (custom nbt of {_item}) is set:
        return 125
    return 0

function PapitoCostAtLevel(item: item, level: integer) :: integer:
    if boolean tag "Artifact" of (custom nbt of {_item}) is set:
        return floor(min(64, (2.6 * {_level}) + 2))
    if boolean tag "Relic" of (custom nbt of {_item}) is set:
        return rounded (2 * ((sqrt({_level}+1)/sqrt(125)))*2.515) * ({_level}+1) + 2
    return 0

function PapitoCostBetween(item: item, fromLevel: integer, toLevel: integer) :: integer:
    set {_sum} to 0
    if {_toLevel} <= {_fromLevel}:
        return 0
    loop ({_toLevel} - {_fromLevel}) times:
        set {_sum} to {_sum} + PapitoCostAtLevel({_item}, {_fromLevel} + loop-number - 1)
    return {_sum}


function PapitoCleanUpgradeLore(item: item) :: item:
    set {_lore::*} to lore of {_item}
    loop {_lore::*}:
        set {_nextIndex} to loop-index parsed as integer
        set {_nextIndex} to {_nextIndex} + 1
        set {_nextLine} to {_lore::%{_nextIndex}%}
        if loop-value is "" or " ":
            if {_nextLine} contains "Click here to upgrade" or "This item has been fully upgraded" or "Can be upgraded." or "Not enough resources":
                set {_skip} to true
        if {_skip} is not true:
            if loop-value does not contain "Click here to upgrade":
                if loop-value does not contain "This item has been fully upgraded":
                    if loop-value does not contain "Can be upgraded.":
                        if loop-value does not contain "Not enough resources":
                            set {_out::*} to {_out::*} and loop-value
        clear {_skip}
    set {_size} to size of {_out::*}
    loop {_size} times:
        set {_idx} to size of {_out::*}
        if {_idx} <= 0:
            exit loop
        if {_out::%{_idx}%} is "" or " ":
            delete {_out::%{_idx}%}
        else:
            exit loop
    set lore of {_item} to {_out::*}
    return {_item}

function PapitoEnsureGearId(item: item) :: item:
    if string tag "GearId" of (custom nbt of {_item}) is not set:
        set string tag "GearId" of (custom nbt of {_item}) to "%random uuid%"
    return {_item}

function PapitoRemoveOriginal(p: player, original: item) :: boolean:
    set {_original} to PapitoEnsureGearId({_original})
    set {_gearId} to string tag "GearId" of (custom nbt of {_original})
    if {_gearId} is not set:
        return false
    loop all items in {_p}'s inventory:
        if loop-value is not air:
            if string tag "GearId" of (custom nbt of loop-value) = {_gearId}:
                remove (1 of loop-value) from {_p}
                return true
    return false

function PapitoRelicCard(item: item) :: text:
    set {_card} to string tag "Card" of (custom nbt of {_item})
    if {_card} is set:
        return {_card}
    set {_line} to uncolored line 1 of lore of {_item}
    replace all "Legendary " in {_line} with ""
    replace all "Epic " in {_line} with ""
    replace all "Rare " in {_line} with ""
    replace all "Uncommon " in {_line} with ""
    replace all "Common " in {_line} with ""
    replace all " Relic" in {_line} with ""
    if {_line} is set:
        return {_line}
    return ""

function PapitoReforgeSound(p: player):
    play sound "block.amethyst_block.resonate" with volume 3 and pitch 1.2 to {_p}
    wait 3 ticks
    play sound "block.anvil.use" with volume 3 and pitch 1.6 to {_p}
    wait 3 ticks
    play sound "entity.player.levelup" with volume 2 and pitch 1.8 to {_p}


function PapitoReforgeFailSound(p: player):
    play sound "entity.villager.no" with volume 2 and pitch 0.8 to {_p}
    wait 2 ticks
    play sound "block.anvil.land" with volume 2 and pitch 0.5 to {_p}

function PapitoReforgeSelectSound(p: player):
    play sound "block.amethyst_block.chime" with volume 2 and pitch 1.4 to {_p}
    play sound "ui.click_echo" with volume 1 and pitch 1.2 to {_p}

function ArtifactReforgeStatName(stat: text) :: text:
    set {_line} to getFormattedStat({_stat})
    replace all "{VALUE} " in {_line} with ""
    replace all "{VALUE}" in {_line} with ""
    return {_line}

function ArtifactReforgeValueLine(stat: text, value: integer) :: text:
    set {_line} to getFormattedStat({_stat})
    replace all "{VALUE}" in {_line} with "+%{_value}%"
    return {_line}

function ArtifactReforgeStats() :: texts:
    return "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Control", "Versatility", "Mastery", "Critical Hit", "Element", "Haste" and "Avoidance"

function ArtifactRandomRoll(item: item) :: integer:
    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_item})
    set {_substatValues::*} to 0.186, 0.180, 0.174, 0.162 and 0.150
    set {_roll} to a random element of {_substatValues::*}
    return rounded (({_roll} * 4.7385 * {_itemLevel}) / 6)

function ArtifactLineIndex(item: item, stat: text) :: integer:
    loop lore of {_item}:
        if loop-value contains {_stat}:
            return loop-counter
    return 0

function ArtifactSetStatLore(item: item, stat: text, value: integer) :: item:
    set {_line} to getFormattedStat({_stat})
    replace all "{VALUE}" in {_line} with "+%{_value}%"
    set {_idx} to ArtifactLineIndex({_item}, {_stat})
    if {_idx} > 0:
        set line {_idx} of lore of {_item} to {_line}
    return {_item}

function ArtifactRemoveStatLore(item: item, stat: text) :: item:
    set {_idx} to ArtifactLineIndex({_item}, {_stat})
    if {_idx} > 0:
        delete line {_idx} of lore of {_item}
    return {_item}

function ArtifactRollCountForValue(item: item, value: integer) :: integer:
    set {_maxRoll} to PapitoArtifactMaxRoll(int tag "ItemLevel" of (custom nbt of {_item}))
    if {_maxRoll} <= 0:
        return 1
    set {_rolls} to ceil({_value} / {_maxRoll})
    if {_rolls} < 1:
        set {_rolls} to 1
    return {_rolls}

function ArtifactEnsureRollTracking(item: item) :: item:
    set {_stats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    loop {_stats::*}:
        if int tag "Rolls;%loop-value%" of (custom nbt of {_item}) is not set:
            set {_value} to int tag "Stats;%loop-value%" of (custom nbt of {_item})
            set int tag "Rolls;%loop-value%" of (custom nbt of {_item}) to ArtifactRollCountForValue({_item}, {_value})
    return {_item}

function ArtifactReforgeCostKlejnot(item: item) :: integer:
    set {_week} to {artifactReforgeWeek}
    if {_week} is not set:
        set {_week} to 0
    set {_itemWeek} to int tag "ReforgeWeek" of (custom nbt of {_item})
    set {_count} to int tag "ReforgeCount" of (custom nbt of {_item})
    if {_itemWeek} is not {_week}:
        set {_count} to 0
    if {_count} is not set:
        set {_count} to 0
    return 5 * (2 ^ {_count})

function ArtifactReforgeCount(item: item) :: integer:
    set {_week} to {artifactReforgeWeek}
    if {_week} is not set:
        set {_week} to 0
    set {_itemWeek} to int tag "ReforgeWeek" of (custom nbt of {_item})
    set {_count} to int tag "ReforgeCount" of (custom nbt of {_item})
    if {_itemWeek} is not {_week}:
        return 0
    if {_count} is not set:
        return 0
    return {_count}

function ArtifactReforgeAdvance(item: item) :: item:
    set {_week} to {artifactReforgeWeek}
    if {_week} is not set:
        set {_week} to 0
    set {_count} to ArtifactReforgeCount({_item})
    set int tag "ReforgeWeek" of (custom nbt of {_item}) to {_week}
    set int tag "ReforgeCount" of (custom nbt of {_item}) to {_count} + 1
    return {_item}

function ArtifactReforgeFluxCost(item: item, mode: text, stat: text = "") :: integer:
    if {_mode} = "all":
        set {_item} to ArtifactEnsureRollTracking({_item})
        loop nbt tags of (compound tag "Stats" of (custom nbt of {_item})):
            set {_rolls} to int tag "Rolls;%loop-value%" of (custom nbt of {_item})
            set {_total} to {_total} + {_rolls}
        return {_total} * 50
    return 50

function ArtifactReforgeCanPay(p: player, item: item, mode: text, stat: text = "") :: boolean:
    set {_flux} to ArtifactReforgeFluxCost({_item}, {_mode}, {_stat})
    set {_klejnot} to ArtifactReforgeCostKlejnot({_item})
    if {cosmicflux::%{_p}%} < {_flux}:
        return false
    set {_klejnotItem} to yaml value "Klejnot.Item" in "ItemList"
    if {_p} has {_klejnot} of {_klejnotItem}:
        return true
    return false

function ArtifactReforgePay(p: player, item: item, mode: text, stat: text = "") :: boolean:
    if ArtifactReforgeCanPay({_p}, {_item}, {_mode}, {_stat}) is false:
        return false
    set {_flux} to ArtifactReforgeFluxCost({_item}, {_mode}, {_stat})
    set {_klejnot} to ArtifactReforgeCostKlejnot({_item})
    set {cosmicflux::%{_p}%} to {cosmicflux::%{_p}%} - {_flux}

    set {_item} to yaml value "Klejnot.Item" in "ItemList"

    remove {_klejnot} of {_item} from {_p}
    return true

function ArtifactReforgeAll(item: item) :: item:
    set {_item} to ArtifactEnsureRollTracking({_item})
    loop nbt tags of (compound tag "Stats" of (custom nbt of {_item})):
        set {_stat} to loop-value
        set {_rolls} to int tag "Rolls;%{_stat}%" of (custom nbt of {_item})
        set {_oldValue::%{_stat}%} to int tag "Stats;%{_stat}%" of (custom nbt of {_item})
        set {_value} to 0
        loop {_rolls} times:
            set {_value} to {_value} + ArtifactRandomRoll({_item})
        set int tag "Stats;%{_stat}%" of (custom nbt of {_item}) to {_value}
    set lore of {_item} to ArtifactLoreUpdate({_item})
    return ArtifactReforgeAdvance({_item})

function ArtifactReforgeStat(item: item, oldStat: text) :: item:
    set {_item} to ArtifactEnsureRollTracking({_item})
    set {_available::*} to ArtifactReforgeStats()
    loop nbt tags of (compound tag "Stats" of (custom nbt of {_item})):
        remove loop-value from {_available::*}
    if size of {_available::*} <= 0:
        return {_item}
    set {_newStat} to a random element of {_available::*}
    set {_value} to int tag "Stats;%{_oldStat}%" of (custom nbt of {_item})
    set {_rolls} to int tag "Rolls;%{_oldStat}%" of (custom nbt of {_item})
    clear int tag "Stats;%{_oldStat}%" of (custom nbt of {_item})
    clear int tag "Rolls;%{_oldStat}%" of (custom nbt of {_item})
    set int tag "Stats;%{_newStat}%" of (custom nbt of {_item}) to {_value}
    set int tag "Rolls;%{_newStat}%" of (custom nbt of {_item}) to {_rolls}
    set string tag "LastReforgeOldStat" of (custom nbt of {_item}) to {_oldStat}
    set string tag "LastReforgeNewStat" of (custom nbt of {_item}) to {_newStat}
    set lore of {_item} to ArtifactLoreUpdate({_item})
    return ArtifactReforgeAdvance({_item})


function ArtifactReforgeStatItem(stat: text) :: item:
    if {_stat} = "Health":
        return lime stained glass pane
    else if {_stat} = "Damage":
        return red stained glass pane
    else if {_stat} = "Resistance":
        return yellow stained glass pane
    else if {_stat} = "Mobility":
        return white stained glass pane
    else if {_stat} = "Utility":
        return magenta stained glass pane
    else if {_stat} = "Crowd Control":
        return light blue stained glass pane
    else if {_stat} = "Versatility":
        return light gray stained glass pane
    else if {_stat} = "Mastery":
        return magenta stained glass pane
    else if {_stat} = "Critical Hit":
        return orange stained glass pane
    else if {_stat} = "Element":
        return lime stained glass pane
    else if {_stat} = "Haste":
        return green stained glass pane
    else if {_stat} = "Avoidance":
        return blue stained glass pane
    return gray stained glass pane

function ArtifactReforgeCostLore(p: player, item: item, mode: text, stat: text = "") :: texts:
    set {_flux} to ArtifactReforgeFluxCost({_item}, {_mode}, {_stat})
    set {_klejnot} to ArtifactReforgeCostKlejnot({_item})
    set {_count} to ArtifactReforgeCount({_item})
    return "&f⇏ &7Reforging will cost you &f&n%{_flux}%&r &f &7and <#b5e550>&n%{_klejnot}% Klejnot&7.", "&f⇏ &7Weekly Artifact reforges on this item: &f%{_count}%", " ", "&8(&f &8= Cosmic Flux)", "&8Klejnot cost doubles with each weekly reforge.", "&8Costs reset on weekly reset."

#What would you like to do?
#Judge 
#Judges an Artifact or Relic, determining its power and ... from reaching maximum values.
#Upgrade
#Upgrades Gear, Relics or a piece of Artifact
#Reforge
# Reforges an Artifact or Relic, re-randomizing its stats, stat values, or both


on rightclick on a player:
    if clicked player's name = "Papito":
        play sound "entity.villager.yes" with volume 5 and pitch 0.62 to player
        play sound "entity.villager.work_toolsmith" with volume 5 and pitch 0.91 to player
        set {_dialogue} to a random integer between 1 and 2
        if {_dialogue} = 1:
            send "&8[<#b0b0b0>NPC&8] [<#b0b0b0>Papito&8] &f¡Hola, m'hijo! Need anything done?" to player
        else:
            send  "&8[<#b0b0b0>NPC&8] [<#b0b0b0>Papito&8] &fHola! Anything I can do for you today?" to player
        set metadata tag "papito" of player to chest inventory with 1 row named "What would you like to do?"
        set slot 1 of (metadata tag "papito" of player) to smoker named "&7Upgrade" with lore "&fClick here to upgrade an item."
        set slot 2 of (metadata tag "papito" of player) to anvil named "&7Reforge" with lore "&fReforge an Artifact, re-randomizng its stats,%nl%&fstat values, or both. The cost of Reforging%nl%&fincreases with each Reforge and resets%nl%&fon a weekly basis."
        set slot 3 of (metadata tag "papito" of player) to netherite sword named "&7Enhance" with lore "&fUse up a duplicate of a Relic to further%nl%&fenhance your Relic's power." with item flag hide attributes
        set slot 4 of (metadata tag "papito" of player) to netherite helmet named "&7Socket an Item" with lore "&fClick here to add a Gem to a socket." with item flag hide attributes
        set slot 5 of (metadata tag "papito" of player) to netherite ingot named "&7Rate an Artifact" with lore "&fClick here to have your Artifact%nl%&frated by 'Papito'."
        set slot 6 of (metadata tag "papito" of player) to glowstone dust named "&7Starforge" with lore "&fClick here to ✨ Starforge a Gear piece." with nbt from "{""minecraft:custom_model_data"":{floats:[15.0f]}}"
        open (metadata tag "papito" of player) to player
on inventory click:
    if event-inventory = metadata tag "papito" of player:
        cancel event
        if event-slot = 1:
            play sound "block.anvil.place" with volume 5 and pitch 1.61 to player

            set metadata tag "papitoUpgrade" of player to chest inventory with 6 rows named "Papito - Upgrade"

            set {_slotIndex} to 0
            loop all items in the player's inventory:
                if (item amount of loop-item) = 1:
                    clear {_canUpgrade}
                    if line 2 of lore of loop-item contains "Item Level":
                        if line 1 of lore of loop-item contains "Artifact" or "Relic":
                            set loop-item to PapitoEnsureGearId(loop-item)
                            set slot {_slotIndex} of metadata tag "papitoUpgrade" of player to loop-item
                            if boolean tag "Artifact" of (custom nbt of loop-item) is set:
                                set {_starLevel} to int tag "StarLevel" of (custom nbt of loop-item)
                                if (int tag "Upgraded" of (custom nbt of loop-item)) < {_starLevel}*5:
                                    set {_canUpgrade} to true
                            else if boolean tag "Relic" of (custom nbt of loop-item) is set:
                                if (int tag "Upgraded" of (custom nbt of loop-item)) < 125:
                                    set {_canUpgrade} to true
                            if {_canUpgrade} = true:
                                add "%nl%&f&oClick here to upgrade this item." to lore of (slot {_slotIndex} of metadata tag "papitoUpgrade" of player)
                            else:
                                add "%nl%&c&oThis item has been fully upgraded." to lore of (slot {_slotIndex} of metadata tag "papitoUpgrade" of player)
                            add 1 to {_slotIndex}
            if {_slotIndex} > 0:
                open metadata tag "papitoUpgrade" of player to player
            else:
                play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                play sound "block.anvil.place" with volume 5 and pitch 1.176 to player 
                send "&c&oThere are no Artifacts or Relics in your inventory." to player
        else if event-slot = 2:
            play sound "block.anvil.place" with volume 5 and pitch 1.61 to player
            set metadata tag "papitoReforge" of player to chest inventory with 6 rows named "Papito - Reforge"
            set {_slotIndex} to 0
            loop all items in the player's inventory:
                if item amount of loop-item = 1:
                    if boolean tag "Artifact" of (custom nbt of loop-item) is set:
                        set loop-item to PapitoEnsureGearId(loop-item)
                        set {_item} to ArtifactEnsureRollTracking(loop-item)
                        set slot {_slotIndex} of metadata tag "papitoReforge" of player to {_item}
                        add "%nl%&f&oClick here to reforge this Artifact." to lore of slot {_slotIndex} of metadata tag "papitoReforge" of player
                        set {_slotIndex} to {_slotIndex} + 1
            if {_slotIndex} > 0:
                open metadata tag "papitoReforge" of player to player
            else:
                play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                send "&c&oThere are no Artifacts in your inventory." to player
        else if event-slot = 4:
            play sound "block.anvil.place" with volume 5 and pitch 1.61 to player
            set metadata tag "papitoSocket" of player to chest inventory with 6 rows named "Papito - Socket"
            set {_slotIndex} to 0
            loop all items in the player's inventory:
                if (item amount of loop-item) = 1:
                    if nbt tags of (compound tag "Socket" of (custom nbt of loop-item)) is set:
                        set slot {_slotIndex} of metadata value "papitoSocket" of player to loop-item
                        add "%nl%&f&oClick here to socket this item." to (lore of slot {_slotIndex} of metadata value "papitoSocket" of player)
                        add 1 to {_slotIndex}
            if {_slotIndex} > 0:
                open metadata tag "papitoSocket" of player to player
            else:
                play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                send "&c&oThere are no items with a Socket in your inventory." to player
        else if event-slot = 3:
            play sound "block.anvil.place" with volume 5 and pitch 1.81 to player
            
            set metadata tag "papitoEnhance" of player to chest inventory with 6 rows named "Papito - Enhance"

            set {_slotIndex} to 0
            loop all items in the player's inventory:
                set {_lore::*} to lore of loop-item
                if {_lore::2} contains "Item Level":
                    if line 1 of lore of loop-item contains "Relic":
                        set slot {_slotIndex} of metadata tag "papitoEnhance" of player to loop-item
                        if int tag "Enhanced" of (custom nbt of loop-item) < 5:
                            add "%nl%&f&oClick here to enhance this item." to (lore of (slot {_slotIndex} of metadata tag "papitoEnhance" of player))
                        else:
                            add "%nl%&c&oThis item has been fully enhanced." to (lore of (slot {_slotIndex} of metadata tag "papitoEnhance" of player))
                        add 1 to {_slotIndex}
            if {_slotIndex} > 0:
                open metadata tag "papitoEnhance" of player to player
            else:
                play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                play sound "block.anvil.place" with volume 5 and pitch 1.176 to player 
                send "&c&oThere are no Relics in your inventory." to player
        else if event-slot = 5:
            play sound "block.anvil.place" with volume 5 and pitch 1.48 to player
            set metadata tag "papitoJudge" of player to chest inventory with 6 rows named "Papito - Judge"
            set {_slotIndex} to 0
            loop all items in the player's inventory:
                if item amount of loop-item = 1:
                    if boolean tag "Artifact" of (custom nbt of loop-item) is set:
                        set slot {_slotIndex} of metadata tag "papitoJudge" of player to loop-item
                        add "%nl%&f&oClick here to have Papito judge this Artifact." to lore of slot {_slotIndex} of metadata tag "papitoJudge" of player
                        set {_slotIndex} to {_slotIndex} + 1
            if {_slotIndex} > 0:
                open metadata tag "papitoJudge" of player to player
            else:
                play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                send "&c&oThere are no Artifacts in your inventory."
    else if event-inventory = metadata tag "papitoReforge" of player:
        cancel event
        if clicked slot is not air:
            if clicked slot is between 0 and 53:
                set {_artifact} to PapitoCleanUpgradeLore(clicked slot)
                set {_artifact} to PapitoEnsureGearId({_artifact})
                set {_artifact} to ArtifactEnsureRollTracking({_artifact})
                set metadata value "PapitoReforgeOriginal" of player to {_artifact}
                PapitoReforgeSelectSound(player)
                set metadata tag "papitoReforgeItem" of player to chest inventory with 5 rows named "Papito - Reforge Artifact"
                set {_gui} to metadata tag "papitoReforgeItem" of player
                set slots integers between 0 and 44 of {_gui} to black stained glass pane named " "
                set slot 13 of {_gui} to {_artifact}
                set slot 20 of {_gui} to anvil named "&dReroll Values" with lore "&7Rerolls all current stat roll values.", "&7The stats stay the same.", " " and ArtifactReforgeCostLore(player, {_artifact}, "all")
                set int tag "ReforgeMode" of (custom nbt of slot 20 of {_gui}) to 1
                set {_slot} to 29
                loop nbt tags of (compound tag "Stats" of (custom nbt of {_artifact})):
                    set {_stat} to loop-value
                    set {_value} to int tag "Stats;%{_stat}%" of (custom nbt of {_artifact})
                    set {_currentLine} to getFormattedStat({_stat})
                    replace all "{VALUE}" in {_currentLine} with "+%{_value}%"
                    set {_item} to ArtifactReforgeStatItem({_stat}) named "&bReroll %{_stat}%" with lore "&7Changes this stat into a random", "&7missing stat on this Artifact.", " ", "&7Current: %{_currentLine}%", " " and ArtifactReforgeCostLore(player, {_artifact}, "stat", {_stat})
                    set string tag "ReforgeStat" of (custom nbt of {_item}) to {_stat}
                    set int tag "ReforgeMode" of (custom nbt of {_item}) to 2
                    set slot {_slot} of {_gui} to {_item}
                    set {_slot} to {_slot} + 1
                open {_gui} to player

    else if event-inventory = metadata tag "papitoReforgeItem" of player:
        cancel event
        if clicked slot is not air:
            set {_artifact} to slot 13 of event-inventory
            set {_modeId} to int tag "ReforgeMode" of (custom nbt of clicked slot)
            if {_modeId} = 1:
                PapitoReforgeSelectSound(player)
                set {_mode} to "all"
                set {_stat} to ""
            else if {_modeId} = 2:
                PapitoReforgeSelectSound(player)
                set {_mode} to "stat"
                set {_stat} to string tag "ReforgeStat" of (custom nbt of clicked slot)
            else:
                stop
            set metadata value "PapitoReforgeMode" of player to {_mode}
            set metadata value "PapitoReforgeStat" of player to {_stat}
            set metadata tag "papitoReforgeConfirm" of player to chest inventory with 3 rows named "Papito - Confirm Reforge"
            set {_gui} to metadata tag "papitoReforgeConfirm" of player
            set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
            set slot 11 of {_gui} to {_artifact}
            set slot 13 of {_gui} to iron nugget named "&fCost" with lore ArtifactReforgeCostLore(player, {_artifact}, {_mode}, {_stat}) with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
            if ArtifactReforgeCanPay(player, {_artifact}, {_mode}, {_stat}) is true:
                set slot 15 of {_gui} to lime stained glass pane named "&aConfirm Reforge" with lore "&7Click here to reforge this Artifact."
            else:
                set slot 15 of {_gui} to red stained glass pane named "&cNot enough currency" with lore "&7You do not have enough currency", "&7to reforge this Artifact."
            open {_gui} to player

    else if event-inventory = metadata tag "papitoReforgeConfirm" of player:
        cancel event
        if event-slot = 15:
            if clicked slot is not lime stained glass pane:
                PapitoReforgeFailSound(player)
                stop
            if clicked slot is lime stained glass pane:
                set {_artifact} to slot 11 of event-inventory
                set {_original} to metadata value "PapitoReforgeOriginal" of player
                set {_mode} to metadata value "PapitoReforgeMode" of player
                set {_stat} to metadata value "PapitoReforgeStat" of player
                if ArtifactReforgePay(player, {_artifact}, {_mode}, {_stat}) is false:
                    PapitoReforgeFailSound(player)
                    stop
                if PapitoRemoveOriginal(player, {_original}) is not true:
                    send "&cYour original artifact was not found. Refunded currency." to player
                    set {_flux} to ArtifactReforgeFluxCost({_artifact}, {_mode}, {_stat})
                    set {_klejnot} to ArtifactReforgeCostKlejnot({_artifact})
                    set {cosmicflux::%player%} to {cosmicflux::%player%} + {_flux}
                    set {_klejnotItem} to yaml value "Klejnot.Item" in "ItemList"
                    give player {_klejnot} of {_klejnotItem}
                    PapitoReforgeFailSound(player)
                    stop
                if {_mode} = "all":
                    set {_oldStats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_artifact}))
                    loop {_oldStats::*}:
                        set {_oldValue::%loop-value%} to int tag "Stats;%loop-value%" of (custom nbt of {_artifact})
                    set {_artifact} to ArtifactReforgeAll({_artifact})
                    loop {_oldStats::*}:
                        set {_newValue} to int tag "Stats;%loop-value%" of (custom nbt of {_artifact})
                        send "%ArtifactReforgeStatName(loop-value)%&7: %ArtifactReforgeValueLine(loop-value, {_oldValue::%loop-value%})% &7-> %ArtifactReforgeValueLine(loop-value, {_newValue})%" to player
                else:
                    set {_artifact} to ArtifactReforgeStat({_artifact}, {_stat})
                    set {_oldStat} to string tag "LastReforgeOldStat" of (custom nbt of {_artifact})
                    set {_newStat} to string tag "LastReforgeNewStat" of (custom nbt of {_artifact})
                    send "%ArtifactReforgeStatName({_oldStat})% &7-> %ArtifactReforgeStatName({_newStat})%" to player
                    clear string tag "LastReforgeOldStat" of (custom nbt of {_artifact})
                    clear string tag "LastReforgeNewStat" of (custom nbt of {_artifact})
                giveItem(player, {_artifact})
                clear metadata value "PapitoReforgeOriginal" of player
                clear metadata value "PapitoReforgeMode" of player
                clear metadata value "PapitoReforgeStat" of player
                close player's inventory
                PapitoReforgeSound(player)
                send "&d✦ Successfully reforged %name of {_artifact}%&d." to player

    else if event-inventory = metadata tag "papitoSocket" of player:
        if event-slot is between 0 and 53:
            cancel event
            if event-slot is not air:
                set {_customNbt} to custom nbt of event-slot
                set {_sockets::*} to nbt tags of (compound tag "Socket" of ({_customNbt}))
                if nbt tags of (compound tag "Socket" of ({_customNbt})) is set:
                    set {_slot} to event-slot
                    play sound "block.anvil.place" with volume 5 and pitch 1.74 to player
                    set metadata tag "papitoChooseSocket" of player to chest inventory with 3 rows named "Papito - Choose Socket"
                    set {_chooseSocket} to metadata tag "papitoChooseSocket" of player

                    set slot 4 of {_chooseSocket} to {_slot}

                    set {_baseSlot} to 10
                    loop {_sockets::*}:
                        set {_socketType} to string tag "Socket;%loop-value%;Type" of {_customNbt}
                        set {_item} to yaml value "Sockets.%{_socketType}%.Item" in "GemList"
                        set name of {_item} to "&f%loop-counter%. %name of {_item}%"
                        set string tag "SocketType" of (custom nbt of {_item}) to {_socketType}
                        set int tag "SocketIndex" of (custom nbt of {_item}) to loop-counter

                        set slot {_baseSlot} of {_chooseSocket} to {_item}
                        set {_baseSlot} to {_baseSlot} + 2

                    open metadata tag "papitoChooseSocket" of player to player

    else if event-inventory = metadata tag "papitoChooseSocket" of player:
        cancel event
        if event-slot is between 10 and 18:
            if event-slot != air:
                set {_slot} to slot 4 of metadata tag "papitoChooseSocket" of player
                set {_socketType} to string tag "SocketType" of (custom nbt of event-slot)
                set {_socketIndex} to int tag "SocketIndex" of (custom nbt of event-slot)

                if {_slot} != air:
                    play sound "block.anvil.place" with volume 5 and pitch 1.74 to player
                    set metadata tag "papitoSocketItem" of player to chest inventory with 3 rows named "Papito - Socket - %(uncolored name of {_slot})%"

                    loop lore of {_slot}:
                        if loop-counter < (size of (lore of {_slot}) - 1):
                            add loop-value to {_lore::*}
                    set lore of {_slot} to {_lore::*}
                    
                    set slots (integers between 0 and 26) of metadata tag "papitoSocketItem" of player to black stained glass pane named " "
                    set slot 10 of metadata tag "papitoSocketItem" of player to {_slot}
                    set {_socket} to white stained glass pane named "&fSocket" with lore "&7Click here to add a Gem from%nl%&7your inventory and socket this%nl%&7item."
                    set string tag "SocketType" of (custom nbt of {_socket}) to {_socketType}
                    set int tag "SocketIndex" of (custom nbt of {_socket}) to {_socketIndex}

                    set slot 13 of metadata tag "papitoSocketItem" of player to {_socket}
                    set slot 16 of metadata tag "papitoSocketItem" of player to {_slot}
                    set slot 25 of metadata tag "papitoSocketItem" of player to blue stained glass pane named "&9Socket Details" with lore "&fStat Value Details%nl%&7Gems that are &f &7socketed will provide &f100%% &7of the Gem's%nl%&7original value, and the effectiveness of stats provided%nl%&7by a Gem depends on the gear piece's <#fdd002>Item Level&7.%nl% %nl%&fMaximum Value"
                    set {_lore1} to "&7Gear of at least <#a335ee>Epic &7quality, or gear above <#fdd002>Item Level 80%nl%&7will always receive the full value from Gems.%nl%&7Socketing an <#1fef00>Uncommon Gem &7will always provide%nl%&7the full value regardless of the item's <#fdd002>Item Level&7.%nl% %nl%&fHow To Socket%nl%&7Click on the &fwhite stained glass pane &7to choose a Gem from%nl%&7your inventory that will fit the appropriate socket"
                    add {_lore1} to lore of (slot 25 of metadata tag "papitoSocketItem" of player)
                    add "&7type. Once you've chosen a Gem, click on the socketed%nl%&7Gear piece on the right to finish the process." to (lore of (slot 25 of metadata tag "papitoSocketItem" of player))
                    open metadata tag "papitoSocketItem" of player to player

    else if event-inventory = metadata tag "papitoSocketItem" of player:
        if event-slot is between 0 and 26:
            cancel event
            if event-slot != air:
                set {_socketType} to string tag "SocketType" of (custom nbt of (event-slot))
                if {_socketType} is set:
                    play sound "block.anvil.place" with volume 5 and pitch 1.9 to player
                    set {_gearItem} to slot 16 of metadata tag "papitoSocketItem" of player

                    if {_socketType} = "Prismatic":
                        set {_eligibleGems::*} to yaml node keys "Gem Types" in "GemList"

                    else if {_socketType} = "Uncommon":
                        set {_eligibleGems::*} to yaml node keys "Gems.Uncommon" in "GemList"
                    else if {_socketType} = "Rare":
                        set {_eligibleGems::*} to yaml node keys "Gems.Rare" in "GemList"

                    else if {_socketType} = "Blue":
                        set {_eligibleGems::*} to findGemsByColour("Blue")
                    else if {_socketType} = "Red":
                        set {_eligibleGems::*} to findGemsByColour("Red")
                    else if {_socketType} = "Green":
                        set {_eligibleGems::*} to findGemsByColour("Green")
                    else if {_socketType} = "Purple":
                        set {_eligibleGems::*} to findGemsByColour("Purple")
                    
                    set {_gemCount} to 0

                    set metadata value "SocketChooseGem" of player to chest inventory with 5 rows named "Papito - Socket - Choose Gem"
                    loop all items in the inventory of player:
                        if boolean tag "Gem" of (custom nbt of loop-item) is set:
                            if {_eligibleGems::*} contains (uncolored name of loop-item):
                                set slot {_gemCount} of metadata value "SocketChooseGem" of player to (1 of loop-item)
                                add 1 to {_gemCount}
                    
                    if {_gemCount} > 0:
                        open metadata value "SocketChooseGem" of player to player
                        
                    else:
                        send "&cNo gems have been found in your inventory." to player
                        close player's inventory

                else if event-slot = 16:
                    if string tag "GearSlot" of (custom nbt of event-slot) is set:

                        set {_gearItem} to slot 10 of metadata value "papitoSocketItem" of player
                        remove {_gearItem} from player's inventory

                        set {_gemIcon} to string tag "GemIcon" of (custom nbt of (slot 13 of metadata value "papitoSocketItem" of player))
                        send "&e&oSuccessfully socketed a &f%{_gemIcon}% &e&o%uncolored (name of (slot 13 of metadata value "papitoSocketItem" of player))%." to player

                        set slot 10 of metadata value "papitoSocketItem" of player to air
                        set slot 13 of metadata value "papitoSocketItem" of player to air

                        giveItem(player, event-slot)
                        close player's inventory

                        play sound "profession.gem.pick_up" with volume 5 and pitch 1 to player
                        wait 5 ticks
                        play sound "profession.gem.put_down" with volume 5 and pitch 1 to player
                        wait 5 ticks
                        play sound "block.anvil.place" with volume 5 and pitch 2 to player

    else if event-inventory = (metadata value "SocketChooseGem" of player):
        if event-slot is between 0 and 26:
            cancel event
            if boolean tag "Gem" of (custom nbt of event-slot) is set:
                play sound "profession.gem.pick_up" with volume 5 and pitch 1 to player
                set {_gem} to 1 of event-slot
                remove {_gem} from player

                set {_emptySocket} to slot 13 of metadata tag "papitoSocketItem" of player
                set {_socketType} to string tag "SocketType" of (custom nbt of {_emptySocket})
                
                set slot 13 of metadata tag "papitoSocketItem" of player to {_gem}
                set {_indexLore} to 1
                set {_gearItem} to slot 16 of metadata tag "papitoSocketItem" of player

                set {_socketIndex} to int tag "SocketIndex" of (custom nbt of {_emptySocket})
                set {_indexLore} to int tag "Socket;%{_socketIndex}%;Lore Line" of (custom nbt of {_gearItem})

                set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_gearItem})
                
                set {_gemName} to (uncolored name of event-slot)
                set {_gemType} to yaml value "Gem Types.%{_gemName}%.Type" in "GemList"
                set {_rank} to length of (string tag "Quality" of (custom nbt of event-slot))
                set {_statsType::*} to yaml node keys "Gems.%{_gemType}%.%{_gemName}%.Stats.Rank %{_rank}%" in "GemList"
                set {_gemIcon} to yaml value "Gems.%{_gemType}%.%{_gemName}%.Icon" in "GemList"

                loop {_statsType::*}:
                    set {_value} to yaml value "Gems.%{_gemType}%.%{_gemName}%.Stats.Rank %{_rank}%.%loop-value%" in "GemList"

                    if yaml value "Primary Stats.%loop-value%.Icon" in "PrimaryStatList" is set:
                        set {_statIcon} to yaml value "Primary Stats.%loop-value%.Icon" in "PrimaryStatList"
                        set {_statColour} to yaml value "Primary Stats.%loop-value%.Colour" in "PrimaryStatList"
                    else:
                        set {_statIcon} to yaml value "Secondary Stats.%loop-value%.Icon" in "PrimaryStatList"
                        set {_statColour} to yaml value "Secondary Stats.%loop-value%.Colour" in "PrimaryStatList"
                   
                    if (string tag "Rarity" of (custom nbt of {_gearItem})) != "Epic":
                        if (string tag "GemType" of (custom nbt of {_gem})) = "Uncommon":
                            set {_factor} to 1
                        else:
                            if 80 > {_itemLevel}:
                                set {_factor} to {_itemLevel}/80
                            else:
                                set {_factor} to 1
                    else:
                        set {_factor} to 1

                    set {_stat} to round({_factor} * ({_value}), 0)

                    set int tag "Socket;%{_socketIndex}%;Gem;Stats;%loop-value%" of (custom nbt of {_gearItem}) to {_stat}

                    set {_gemLine::*} to {_gemLine::*} and formatted "%{_statColour}%+%{_stat}% %{_statIcon}% %loop-value%"

                    clear {_statIcon}
                    clear {_statColour}
                    clear {_stat}
                    clear {_factor}

                set {_gemline} to "&f%{_gemIcon}% %join {_gemLine::*} by " &f& "%"

                set string tag "Socket;%{_socketIndex}%;Gem;Name" of (custom nbt of {_gearItem}) to {_gemName}
                set string tag "Socket;%{_socketIndex}%;Gem;Icon" of (custom nbt of {_gearItem}) to {_gemIcon}
                set string tag "Socket;%{_socketIndex}%;Gem;Type" of (custom nbt of {_gearItem}) to {_gemType}
                set int tag "Socket;%{_socketIndex}%;Gem;Quality" of (custom nbt of {_gearItem}) to {_rank}
                set string tag "Socket;%{_socketIndex}%;Gem;Lore" of (custom nbt of {_gearItem}) to {_gemline}
                
                set lore of {_gearItem} to GearLoreUpdate({_gearItem})
                set slot 16 of (metadata tag "papitoSocketItem" of player) to {_gearItem}

                open metadata tag "papitoSocketItem" of player to player
                wait 5 ticks
                play sound "profession.gem.put_down" with volume 5 and pitch 1 to player
                wait 5 ticks
                play sound "block.anvil.place" with volume 5 and pitch 2 to player

    else if event-inventory = metadata tag "papitoUpgrade" of player:
        cancel event
        if clicked slot is not air:
            if clicked slot is between 0 and 53:
                if lore of clicked slot does not contain "&c&oThis item has been fully upgraded.":
                    if lore of clicked slot does not contain "&c&oTen przedmiot został w pełni ulepszony.":
                        play sound "block.anvil.place" with volume 5 and pitch 1.176 to player 
                        set {_} to last string color code of name of clicked slot
                        if line 1 of lore of clicked slot contains "Artifact":
                            set {_type} to "Artifact"
                            set metadata tag "papitoUpgradeItem" of player to chest inventory with 5 rows named "Papito - Upgrade - %{_}%Artifact"
                        else if line 1 of lore of clicked slot contains "Relic":
                            set {_type} to "Relic"
                            set metadata tag "papitoUpgradeItem" of player to chest inventory with 5 rows named "Papito - Upgrade - %{_}%Relic"
                        set {_item} to PapitoCleanUpgradeLore(clicked slot)
                        set {_item} to PapitoEnsureGearId({_item})
                        set metadata value "papitoUpgradeOriginal" of player to {_item}
                        set {_artifact} to {_item}
                        set {_upgradeLevel} to int tag "Upgraded" of (custom nbt of {_artifact})
                        set {_experience} to long tag "Experience" of (custom nbt of {_artifact})
                        set {_starLevel} to int tag "StarLevel" of (custom nbt of {_artifact})
                        #add "%nl%&f&oYou are upgrading this item." to lore of {_item}
                        set slot 13 of metadata tag "papitoUpgradeItem" of player to {_item}
                        set {_maxLevel} to PapitoMaxUpgrade({_item})
                        set {_to1} to min({_upgradeLevel} + 1, {_maxLevel})
                        set {_5} to min({_upgradeLevel} + 5, {_maxLevel})
                        set {_25} to min({_upgradeLevel} + 25, {_maxLevel})
                        set {_25minLvl} to {_maxLevel}
                        set {_remaining} to {_maxLevel} - {_upgradeLevel}
                        set {_requiredExp} to PapitoCostBetween({_item}, {_upgradeLevel}, {_to1})
                        set {_requiredExp5Levels} to PapitoCostBetween({_item}, {_upgradeLevel}, {_5})
                        set {_requiredExp25} to PapitoCostBetween({_item}, {_upgradeLevel}, {_25})
                        set {_requiredExp25Levels} to PapitoCostBetween({_item}, {_upgradeLevel}, {_25minLvl})
                        set {_stardustAmount} to PapitoStardustInInventory(player)
                        set {_loreUpgrading} to "&7&oThis process will cost you Stardust&7&o.%nl%&f1 EXP = 1 Stardust.%nl%&fA total of %{_requiredExp25Levels}% EXP is required to fully%nl%&fupgrade this item.%nl% %nl%&fYou currently have %{_stardustAmount}% Stardust in your inventory."
                        set slot 31 of metadata tag "papitoUpgradeItem" of player to smoker named "&8Upgrading" with lore {_loreUpgrading} with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
                        set slot 19 of metadata tag "papitoUpgradeItem" of player to anvil named "&8Upgrade +1" with lore "&fUpgrade Level: +%{_upgradeLevel}% -> +%{_to1}%%nl%&fEXP until Level: %{_requiredExp}%%nl%&fCost: %{_requiredExp}%"
                        set slot 21 of metadata tag "papitoUpgradeItem" of player to anvil named "&8Upgrade +5" with lore "&fUpgrade Level: +%{_upgradeLevel}% -> +%{_5}%%nl%&fEXP until Level: %{_requiredExp5Levels}%%nl%&fCost: %{_requiredExp5Levels}%"
                        set slot 23 of metadata tag "papitoUpgradeItem" of player to anvil named "&8Upgrade +25" with lore "&fUpgrade Level: +%{_upgradeLevel}% -> +%{_25}%%nl%&fEXP until Level: %{_requiredExp25}%%nl%&fCost: %{_requiredExp25}%"
                        set slot 25 of metadata tag "papitoUpgradeItem" of player to anvil named "&8Upgrade +%{_remaining}%" with lore "&fUpgrade Level: +%{_upgradeLevel}% -> +%{_25minLvl}%%nl%&fEXP until Level: %{_requiredExp25Levels}%%nl%&fCost: %{_requiredExp25Levels}%"
                        set double tag "StardustAmount" of (custom nbt of (slot 19 of (metadata tag "papitoUpgradeItem" of player))) to {_requiredExp}
                        set double tag "StardustAmount" of (custom nbt of (slot 21 of (metadata tag "papitoUpgradeItem" of player))) to {_requiredExp5Levels}
                        set double tag "StardustAmount" of (custom nbt of (slot 23 of (metadata tag "papitoUpgradeItem" of player))) to {_requiredExp25}
                        set double tag "StardustAmount" of (custom nbt of (slot 25 of (metadata tag "papitoUpgradeItem" of player))) to {_requiredExp25Levels}
                        set int tag "TargetLevel" of (custom nbt of (slot 19 of (metadata tag "papitoUpgradeItem" of player))) to {_to1}
                        set int tag "TargetLevel" of (custom nbt of (slot 21 of (metadata tag "papitoUpgradeItem" of player))) to {_5}
                        set int tag "TargetLevel" of (custom nbt of (slot 23 of (metadata tag "papitoUpgradeItem" of player))) to {_25}
                        set int tag "TargetLevel" of (custom nbt of (slot 25 of (metadata tag "papitoUpgradeItem" of player))) to {_25minLvl}

                        open metadata tag "papitoUpgradeItem" of player to player
                    else:
                        play sound "block.anvil.land" with volume 5 and pitch 0.23 to player
                else:
                    play sound "block.anvil.land" with volume 5 and pitch 0.23 to player

    else if event-inventory = metadata tag "papitoUpgradeItem" of player:
        cancel event
        if event-slot = 19 or 21 or 23 or 25:
            play sound "block.anvil.place" with volume 5 and pitch 1.41 to player 
            set {_artifact} to slot 13 of player's current inventory
            set {_starLevel} to int tag "StarLevel" of (custom nbt of {_artifact})
            #loop lore of {_item}:
            #    if loop-value does not contain "You are upgrading this item." or "Ulepszasz ten przedmiot.":
            #        add loop-value to {_lore::*}
            #delete {_lore::%size of {_lore::*}%}
            #set lore of {_item} to {_lore::*}
            set {_stardustAmount} to double tag "StardustAmount" of (custom nbt of clicked slot)
            set metadata tag "papitoUpgradeItemConfirm" of player to chest inventory with 3 rows named "Papito - Upgrade - %(last string color code of ({_artifact}'s name))%Artifact"
            set {_itemConfirmGui} to metadata tag "papitoUpgradeItemConfirm" of player
            set slots integers between 0 and 26 of {_itemConfirmGui} to black stained glass pane named " "
            set slot 11 of {_itemConfirmGui} to {_artifact}
            set slot 12 of {_itemConfirmGui} to paper named " " with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
            set slot 14 of {_itemConfirmGui} to paper named " " with nbt from "{""minecraft:custom_model_data"":{floats:[7.0f]}}"
            if {_stardustAmount} < 65:
                set slot 13 of {_itemConfirmGui} to {_stardustAmount} of {stardust}
            else:
                set slot 13 of {_itemConfirmGui} to 64 of {stardust} named "%(last string color code of (name of {stardust}))%%{_stardustAmount}%x %(name of {stardust})%"

            set {_upgradeLevel} to int tag "Upgraded" of (custom nbt of {_artifact})
            set {_experience} to long tag "Experience" of (custom nbt of {_artifact})
            set {_artifactUpgraded} to {_artifact}
            set {_targetLevel} to int tag "TargetLevel" of (custom nbt of clicked slot)
            if {_targetLevel} is not set:
                set {_targetLevel} to min({_upgradeLevel} + 1, PapitoMaxUpgrade({_artifact}))
            set {_upgradeAmount} to {_targetLevel} - {_upgradeLevel}
            set int tag "Upgraded" of (custom nbt of {_artifactUpgraded}) to {_targetLevel}
            set long tag "Experience" of (custom nbt of {_artifactUpgraded}) to {_experience} + {_stardustAmount}
            loop lore of {_artifactUpgraded}:
                add 1 to {_lineCount}
                if loop-value contains "Upgraded:":
                    set {_line} to loop-value
                    replace all "Upgraded: +" and "Ulepszono: +" in {_line} with ""
                    stop loop
            set {_line} to {_line} parsed as integer
            set {_upgradedTag} to int tag "Upgraded" of (custom nbt of {_artifactUpgraded})
            set {_enhancedTag} to int tag "Enhanced" of (custom nbt of {_artifactUpgraded})
            if line 1 of lore of {_artifactUpgraded} contains "Artifact":
                set line {_lineCount} of lore of {_artifactUpgraded} to "&fUpgraded: +%{_upgradedTag}%" 
            else if line 1 of lore of {_artifactUpgraded} contains "Artefakt":
                set line {_lineCount} of lore of {_artifactUpgraded} to "&fUlepszono: +%{_upgradedTag}%"
            if line 1 of lore of {_artifactUpgraded} contains "Relic":
                set line {_lineCount} of lore of {_artifactUpgraded} to "&fUpgraded: +%{_upgradedTag}% | Enhanced: +%{_enhancedTag}%" 
            else if line 1 of lore of {_artifactUpgraded} contains "Relikt":
                set line {_lineCount} of lore of {_artifactUpgraded} to "&fUlepszono: +%{_upgradedTag}% | Wzmocniono: +%{_enhancedTag}%"
            if boolean tag "Artifact" of (custom nbt of {_artifactUpgraded}) is set:
                set {_substats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_artifact}))
                set {_substatAmount} to size of {_substats::*}

                if {_substatAmount} < 4:
                    if int tag "Upgraded" of (custom nbt of {_artifactUpgraded}) >= 5:
                        set {_count} to 0
                        loop lore of {_artifactUpgraded}:
                            if {_count} < 2:
                                if loop-value = " " or "":
                                    add 1 to {_count}
                                if {_count} < 2:
                                    add loop-value to {_lore1::*}
                            else:
                                add loop-value to {_lore2::*}
                        if {_lore1::%size of {_lore1::*}%} = "" or " ":
                            delete {_lore1::%size of {_lore1::*}%}
                        delete {_lore1::%{_replaceLine}%}
                        add "&f&o+ Adds a random secondary stat" to {_lore1::*}
                        add " " to {_lore1::*}
                        set {_lore::*} to {_lore1::*} and {_lore2::*}
                        set lore of {_artifactUpgraded} to {_lore::*}
                        set string tag "SubstatAdded" of (custom nbt of {_artifactUpgraded}) to "True"
            set {_stardustAmountInInv} to PapitoStardustInInventory(player)
            if {_stardustAmountInInv} >= {_stardustAmount}: 
                add "%nl%&a&o✔ Can be upgraded." to lore of {_artifactUpgraded}
            else:
                add "%nl%&c&o✘ Not enough resources." to lore of {_artifactUpgraded}
            set double tag "RequiredStardust" of (custom nbt of {_artifactUpgraded}) to {_stardustAmount}
            set slot 15 of {_itemConfirmGui} to {_artifactUpgraded}
            open {_itemConfirmGui} to player  
    else if event-inventory = metadata tag "papitoUpgradeItemConfirm" of player:
        cancel event
        if event-slot = 15:
            set {_artifactUpgraded} to clicked slot
            set {_currentArtifact} to metadata value "papitoUpgradeOriginal" of player
            if {_currentArtifact} is not set:
                set {_currentArtifact} to slot 11 of player's current inventory
            if lore of clicked slot contains "&a&o✔ Can be upgraded.":
                set {_requiredStardust} to double tag "RequiredStardust" of (custom nbt of {_artifactUpgraded})
                delete double tag "RequiredStardust" of (custom nbt of {_artifactUpgraded})
                if PapitoRemoveStardust(player, {_requiredStardust}) = true:
                    close player's inventory
                    play sound "misc.gearupgrade" with volume 4.1 and pitch 1 at player
                    if PapitoRemoveOriginal(player, {_currentArtifact}) is not true:
                        send "&cYour original artifact was not found in your inventory. Refunded Stardust." to player
                        set {_refund} to round({_requiredStardust}, 0)
                        give player {_refund} of {stardust}
                        stop
                    clear metadata value "papitoUpgradeOriginal" of player
                    set {_maxLevel} to PapitoMaxUpgrade({_artifactUpgraded})
                    if int tag "Upgraded" of (custom nbt of {_artifactUpgraded}) >= 5:
                        if int tag "Upgraded" of (custom nbt of {_artifactUpgraded}) = {_maxLevel}:
                            if int tag "Upgraded" of (custom nbt of {_currentArtifact}) >= 0:
                                set {_difference} to (int tag "Upgraded" of (custom nbt of {_artifactUpgraded})) - (int tag "Upgraded" of (custom nbt of {_currentArtifact}))
                                #if {winterDelightPassLEVEL::%player%} >= 0:
                                    #getMission(player, "Upgrading Artifacts%nl%Ulepszanie Artefaktów", {_difference})
                                loop {_difference} times:
                                    if (int tag "Upgraded" of (custom nbt of {_currentArtifact})) + loop-number is divisible by 5:
                                        add 1 to {_loops}
                            else:
                                set {_loops} to 1
                        else:
                            set {_loops} to 1
                        set {_dif} to (int tag "Upgraded" of (custom nbt of {_artifactUpgraded})) - (int tag "Upgraded" of (custom nbt of {_currentArtifact}))
                        if {_dif} >= 5:
                            set {_addStat} to true
                        else if int tag "Upgraded" of (custom nbt of {_artifactUpgraded}) is divisible by 5:
                            set {_addStat} to true
                        loop {_loops} times:
                            if {_addStat} is true:
                                play sound "block.anvil.use" with volume 4 and pitch 1.45 at player
                                set {_lore::*} to lore of {_artifactUpgraded}
                                set {_stats::*} to "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Control", "Versatility", "Mastery", "Critical Hit", "Element", "Haste" and "Avoidance"
                                if string tag "SubstatAdded" of (custom nbt of {_artifactUpgraded}) is set:
                                    loop {_stats::*}:
                                        if int tag "Stats;%loop-value-2%" of (custom nbt of {_artifactUpgraded}) is set:
                                            remove loop-value-2 from {_stats::*}
                                    loop {_lore::*}:
                                        add 1 to {_index}
                                        if loop-value-2 contains "&f&o+ Adds a random secondary stat":
                                            set {_substatValues::*} to 0.186, 0.180, 0.174, 0.162 and 0.150
                                            set {_ItemLevel} to int tag "ItemLevel" of (custom nbt of {_artifactUpgraded})
                                            set {_randomStat} to a random element of {_stats::*}
                                            set {_randomSubstatValue} to a random element of {_substatValues::*}
                                            set {_statAmount} to rounded (({_randomSubstatValue} * 4.7385*{_ItemLevel})/6)
                                            set int tag "Stats;%{_randomStat}%" of (custom nbt of {_artifactUpgraded}) to {_statAmount}
                                            set {_formattedStat} to getFormattedStat({_randomStat})
                                            replace all "{VALUE}" in {_formattedStat} with "+%{_statAmount}%"
                                            set {_loreline} to loop-value-2
                                            replace all "&f&o+ Adds a random secondary stat" and "&f&o+ Dodaje losową drugorzędną statystykę" in {_loreline} with {_formattedStat}
                                            set line {_index} of lore of {_artifactUpgraded} to {_loreline}
                                            set {_statLoreGained1} to {_formattedStat}
                                            set {_upgradedStats} to true
                                    clear string tag "SubstatAdded" of (custom nbt of {_artifactUpgraded})
                                else:
                                    set {_statText} to compound tag "Stats" of (custom nbt of {_artifactUpgraded})
                                    set {_statList::*} to nbt tags of {_statText}

                                    if boolean tag "Artifact" of (custom nbt of {_artifactUpgraded}) is set:
                                        set {_randomStat2} to a random element of {_statList::*}
                                        loop {_lore::*}:
                                            if loop-value-2 contains {_randomStat2}:
                                                set {_currentStatAmount} to int tag "Stats;%{_randomStat2}%" of (custom nbt of {_artifactUpgraded})
                                                set {_substatValues::*} to 0.186, 0.180, 0.174, 0.162 and 0.150
                                                set {_ItemLevel} to int tag "ItemLevel" of (custom nbt of {_artifactUpgraded})
                                                set {_randomSubstatValue} to a random element of {_substatValues::*}
                                                set {_statAmount} to rounded (({_randomSubstatValue} * 4.7385*{_ItemLevel})/6)
                                                set {_newStatAmount} to {_currentStatAmount} + {_statAmount}
                                                set {_statLore} to getFormattedStat({_randomStat2})
                                                replace all "{VALUE}" in {_statLore} with "+%{_newStatAmount}%"
                                                set {_statLoreGained%loop-number%} to getFormattedStat({_randomStat2})
                                                replace all "{VALUE}" in {_statLoreGained%loop-number%} with "+%{_statAmount}%"
                                                set {_upgradedStats} to true
                                                set {_lore::%loop-index%} to {_statLore}
                                                set int tag "Stats;%{_randomStat2}%" of (custom nbt of {_artifactUpgraded}) to {_newStatAmount}
                                                set {_artifactUpgraded} to {_artifactUpgraded} with lore {_lore::*}
                                                stop loop
                                    else if boolean tag "Relic" of (custom nbt of {_artifactUpgraded}) is set:
                                        set {_upgradedStats} to false
                    set {_artifactUpgraded} to PapitoCleanUpgradeLore({_artifactUpgraded})
                    giveItem(player, {_artifactUpgraded})
                    send "&a✦ Successfully upgraded %name of {_artifactUpgraded}% &ato +%int tag "Upgraded" of (custom nbt of {_artifactUpgraded})%!" to player
                    if {_loreline} is set:
                        send "&aYour artifact gains a new attribute: &r%{_randomStat}%&a!" to player
                    loop {_loops} times:
                        if boolean tag "Artifact" of (custom nbt of {_artifactUpgraded}) is set:
                            if {_upgradedStats} is true:
                                if {_statLoreGained%loop-number%} is set:
                                    send "&aYour artifact gains %{_statLoreGained%loop-number%}%&a!" to player
                            set {_itemUpgraded} to yaml value "Player.Artifacts Times Upgraded" in "data-%player%"
                            add 1 to {_itemUpgraded}
                            set yaml value "Player.Artifacts Times Upgraded" in "data-%player%" to {_itemUpgraded}
                            set {_starLevel} to int tag "StarLevel" of (custom nbt of {_artifactUpgraded})
                            if int tag "Upgraded" of (custom nbt of {_artifactUpgraded}) = 5*{_starLevel}:
                                set {_itemMaxed} to yaml value "Player.Artifacts Times Maxed" in "data-%player%"
                                add 1 to {_itemMaxed}
                                set yaml value "Player.Artifacts Times Maxed" in "data-%player%" to {_itemMaxed}
                        else if boolean tag "Relic" of (custom nbt of {_artifactUpgraded}) is set:
                            set {_itemUpgraded} to yaml value "Player.Relics Times Upgraded" in "data-%player%"
                            if {_itemUpgraded} is not set:
                                set {_itemUpgraded} to 0
                            set {_itemUpgraded} to {_itemUpgraded} + 1
                            set yaml value "Player.Relics Times Upgraded" in "data-%player%" to {_itemUpgraded}
                            if int tag "Upgraded" of (custom nbt of {_artifactUpgraded}) = 125:
                                set {_itemMaxed} to yaml value "Player.Relics Times Maxed" in "data-%player%"
                                if {_itemMaxed} is not set:
                                    set {_itemMaxed} to 0
                                set {_itemMaxed} to {_itemMaxed} + 1
                                set yaml value "Player.Relics Times Maxed" in "data-%player%" to {_itemMaxed}
                    draw 20 of ((lime dust particle) with an extra value of 0.03) with offset vector(0.3, 0.6, 0.3) at (location above player)
                    save yaml "data-%player%"
            else:
                play sound "block.anvil.land" with volume 5 and pitch 0.23 to player
    else if event-inventory = metadata tag "papitoEnhance" of player:
        cancel event
        if clicked slot is not air:
            if lore of clicked slot does not contain "&c&oThis item has been fully enhanced.":
                if lore of clicked slot does not contain "&c&oTen przedmiot został w pełni wzmocniony.":
                    set metadata value "RelicEnhanceId" of player to string tag "Id" of (custom nbt of clicked slot)
                    play sound "block.anvil.place" with volume 5 and pitch 1.55 to player
                    set metadata tag "papitoEnhanceItem" of player to chest inventory with 5 rows named "Papito - Enhance - %(name of clicked slot)%"
                    set slot 13 of metadata tag "papitoEnhanceItem" of player to clicked slot
                    set {_c} to last string color code of name of clicked slot
                    if uncolored (name of clicked slot) contains "Xal'Atath":
                        set {_upgrade} to long tag "EffectValue" of (custom nbt of clicked slot) + 0.5
                        set {_upgradeText} to "%{_c}%Shadow Word: Pain and Vampiric Touch%nl%%{_c}%damage dealt increase:%nl% &f%(long tag "EffectValue" of (custom nbt of clicked slot))%%% -> %{_upgrade}%%%"
                    set slot 22 of metadata tag "papitoEnhanceItem" of player to anvil named "&fEnhance" with lore "&fIncreases the value of the following effect(s):%nl%%{_upgradeText}%"
                    set slot 31 of metadata tag "papitoEnhanceItem" of player to smoker named "Enhancing" with lore "&c&l(&4&l!&c&l) &cWarning: This process will destroy a%nl%&ccopy of the selected Relic.%nl%&fClick ""Enhance"" to proceed."
                    open metadata tag "papitoEnhanceItem" of player to player
                else:
                    play sound "block.anvil.land" with volume 5 and pitch 0.13 to player
            else:
                play sound "block.anvil.land" with volume 5 and pitch 0.13 to player
    else if event-inventory = metadata tag "papitoEnhanceItem" of player:
        cancel event
        if clicked slot is not air:
            if event-slot = 22:
                play sound "block.anvil.place" with volume 5 and pitch 2 to player
                set metadata tag "papitoEnhanceItemRelics" of player to chest inventory with 5 rows named "Papito - Enhance - %name of slot 13 of player's current inventory%"
                set {_slotIndex} to 0
                set {_targetRelic} to slot 13 of player's current inventory
                set {_targetCard} to PapitoRelicCard({_targetRelic})
                set {_targetId} to metadata value "RelicEnhanceId" of player
                loop all items in the player's inventory:
                    set {_lore::*} to lore of loop-item
                    if {_lore::2} contains "Item Level":
                        if line 1 of lore of loop-item contains "Relic":
                            if string tag "Id" of (custom nbt of loop-item) is not {_targetId}:
                                if name of loop-item = name of {_targetRelic}:
                                    if PapitoRelicCard(loop-item) = {_targetCard}:
                                        set slot {_slotIndex} of metadata tag "papitoEnhanceItemRelics" of player to loop-item
                                        add "%nl%&c&l(&4&l!&c&l) &f&oClick here to use this item." to lore of (slot {_slotIndex} of (metadata tag "papitoEnhanceItemRelics" of player))
                                        add 1 to {_slotIndex}
                if {_slotIndex} > 0:
                    open metadata tag "papitoEnhanceItemRelics" of player to player
                else:
                    play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                    play sound "block.anvil.place" with volume 5 and pitch 1.176 to player 
                    send "&c&oThere are no matching Relics in your inventory." to player
    else if event-inventory = metadata tag "papitoEnhanceItemRelics" of player:
        cancel event
        if clicked slot is not air:
            close player's inventory
            loop all items in player's inventory:
                if (string tag "Id" of (custom nbt of loop-item)) = (string tag "Id" of (custom nbt of clicked slot)):
                    set {_relicRemove} to loop-item
                    stop loop
            if {_relicRemove} is set:
                remove (1 of {_relicRemove}) from player
                play sound "entity.ender_dragon.growl" with volume 4 and pitch 2 at player
                loop all items in the inventory of player:
                    if (string tag "Id" of (custom nbt of loop-item)) = (metadata value "RelicEnhanceId" of player):
                        if uncolored name of loop-item = "Xal'Atath":
                            loop lore of loop-item:
                                add 1 to {_index}
                                if loop-value-2 contains "&f%long tag "EffectValue" of (custom nbt of loop-item)%%%":
                                    set {_lineIndex} to {_index}
                                if loop-value-2 contains "Enhanced:":
                                    set {_lineIndex2} to {_index}
                                    stop loop
                            set {_enhanced} to int tag "Enhanced" of (custom nbt of loop-item)
                            replace all "Enhanced: +%{_enhanced}%" in line {_lineindex2} of lore of loop-item with "Enhanced: +%{_enhanced} + 1%"
                            replace all "Wzmocniono: +%{_enhanced}%" in line {_index2} of lore of loop-item with "Wzmocniono: +%{_enhanced} + 1%"
                            set {_effectValue} to long tag "EffectValue" of (custom nbt of loop-item)
                            replace all "%{_effectValue}%%%" in line {_lineIndex} of lore of loop-item with "%{_effectValue} + 0.5%%%"
                            set long tag "EffectValue" of (custom nbt of loop-item) to {_effectValue} + 0.5
                            set int tag "Enhanced" of (custom nbt of loop-item) to {_enhanced} + 1
                            set loop-item to RelicLoreUpdate(loop-item)
                            set loop-item to RelicLoreUpdate(loop-item)
                        stop loop
                set {_relicsEnhanced} to yaml value "Player.Relics Times Enhanced" in "data-%player%"
                if {_relicsEnhanced} is not set:
                    set {_relicsEnhanced} to 0
                set {_relicsEnhanced} to {_relicsEnhanced} + 1
                set yaml value "Player.Relics Times Enhanced" in "data-%player%" to {_relicsEnhanced}
                if {_enhanced} = 5:
                    set {_relicsEnhanceMax} to yaml value "Player.Relics Times Max Enhanced" in "data-%player%"
                    if {_relicsEnhanceMax} is not set:
                        set {_relicsEnhanceMax} to 0
                    set {_relicsEnhanceMax} to {_relicsEnhanceMax} + 1
                    set yaml value "Player.Relics Times Max Enhanced" in "data-%player%" to {_relicsEnhanceMax}
                save yaml "data-%player%"
            else:
                send "&c&oItem not found. The process has been terminated."
    else if event-inventory = metadata tag "papitoJudge" of player:
        cancel event
        if clicked slot is not air:
            if boolean tag "Artifact" of (custom nbt of clicked slot) is set:
                close player's inventory
                PapitoJudgeArtifact(player, clicked slot)
    else if event-inventory = metadata tag "papitoJudgeItem" of player:
        cancel event

on inventory close:
    if event-inventory = (metadata value "papitoSocketItem" of player):
        if boolean tag "Gem" of (custom nbt of (slot 13 of event-inventory)) is set:
            giveItem(player, slot 13 of event-inventory)
            clear metadata value "papitoSocketItem" of player

function PapitoFormatPercent(value: number) :: text:
    set {_whole} to floor({_value})
    set {_decimal} to round((({_value} - {_whole}) * 100), 0)
    if {_decimal} = 100:
        set {_whole} to {_whole} + 1
        set {_decimal} to 0
    if {_decimal} < 10:
        set {_decimalText} to "0%{_decimal}%"
    else:
        set {_decimalText} to "%{_decimal}%"
    return "%{_whole}%.%{_decimalText}%"



function ArtifactEffectiveRollCount(item: item, stat: text) :: integer:
    set {_current} to int tag "Stats;%{_stat}%" of (custom nbt of {_item})
    set {_rolls} to int tag "Rolls;%{_stat}%" of (custom nbt of {_item})
    set {_inferredRolls} to ArtifactRollCountForValue({_item}, {_current})
    if {_rolls} is not set:
        set {_rolls} to {_inferredRolls}
    if {_rolls} < {_inferredRolls}:
        set {_rolls} to {_inferredRolls}
    if {_rolls} < 1:
        set {_rolls} to 1
    return {_rolls}

function ArtifactTotalEffectiveRolls(item: item) :: integer:
    loop nbt tags of (compound tag "Stats" of (custom nbt of {_item})):
        set {_rolls} to ArtifactEffectiveRollCount({_item}, loop-value)
        set {_total} to {_total} + {_rolls}
    if {_total} is not set:
        set {_total} to 0
    return {_total}

function PapitoArtifactMinRoll(itemLevel: integer) :: number:
    return round((0.150 * 4.7385 * {_itemLevel}) / 6, 0)

function PapitoArtifactMaxRoll(itemLevel: integer) :: number:
    return round((0.186 * 4.7385 * {_itemLevel}) / 6, 0)

function PapitoArtifactMinInitialSubstats(starLevel: integer) :: integer:
    if {_starLevel} = 1:
        return 1
    if {_starLevel} = 2:
        return 1
    if {_starLevel} = 3:
        return 2
    if {_starLevel} = 4:
        return 3
    return 3

function PapitoArtifactMaxInitialSubstats(starLevel: integer) :: integer:
    if {_starLevel} = 1:
        return 1
    if {_starLevel} = 2:
        return 2
    if {_starLevel} = 3:
        return 3
    if {_starLevel} = 4:
        return 3
    return 4

function PapitoArtifactInitialSubstats(item: item) :: integer:
    set {_initialSubstats} to int tag "InitialSubstats" of (custom nbt of {_item})
    if {_initialSubstats} is set:
        return {_initialSubstats}
    set {_stats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_item}))
    return size of {_stats::*}

function PapitoArtifactRollCount(item: item) :: integer:
    set {_trackedRolls} to ArtifactTotalEffectiveRolls({_item})
    if {_trackedRolls} > 0:
        return {_trackedRolls}
    set {_upgradeLevel} to int tag "Upgraded" of (custom nbt of {_item})
    if {_upgradeLevel} is not set:
        set {_upgradeLevel} to 0
    return PapitoArtifactInitialSubstats({_item}) + floor({_upgradeLevel} / 5)

function PapitoArtifactMinValue(item: item) :: number:
    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_item})
    set {_rollCount} to PapitoArtifactRollCount({_item})
    return PapitoArtifactMinRoll({_itemLevel}) * {_rollCount}

function PapitoArtifactMaxValue(item: item) :: number:
    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_item})
    set {_starLevel} to int tag "StarLevel" of (custom nbt of {_item})
    set {_upgradeLevel} to int tag "Upgraded" of (custom nbt of {_item})
    if {_upgradeLevel} is not set:
        set {_upgradeLevel} to 0
    set {_maxRollCount} to PapitoArtifactMaxInitialSubstats({_starLevel}) + floor({_upgradeLevel} / 5)
    return PapitoArtifactMaxRoll({_itemLevel}) * {_maxRollCount}

function PapitoArtifactRollQuality(item: item) :: number:
    set {_currentValue} to ArtifactCurrentValue({_item})
    set {_minValue} to PapitoArtifactMinValue({_item})
    set {_maxValue} to PapitoArtifactMaxValue({_item})
    if {_maxValue} <= {_minValue}:
        return 100
    set {_ratio} to ({_currentValue} - {_minValue}) / ({_maxValue} - {_minValue})
    if {_ratio} < 0:
        set {_ratio} to 0
    if {_ratio} > 1:
        set {_ratio} to 1
    return {_ratio} * 100

function PapitoArtifactInitialSubstatQuality(item: item) :: number:
    set {_starLevel} to int tag "StarLevel" of (custom nbt of {_item})
    set {_initial} to PapitoArtifactInitialSubstats({_item})
    set {_minInitial} to PapitoArtifactMinInitialSubstats({_starLevel})
    set {_maxInitial} to PapitoArtifactMaxInitialSubstats({_starLevel})
    if {_maxInitial} <= {_minInitial}:
        return 100
    set {_ratio} to ({_initial} - {_minInitial}) / ({_maxInitial} - {_minInitial})
    if {_ratio} < 0:
        set {_ratio} to 0
    if {_ratio} > 1:
        set {_ratio} to 1
    return {_ratio} * 100

function PapitoArtifactJudgePercent(item: item) :: number:
    return round(PapitoArtifactRollQuality({_item}), 1)

function ArtifactStatJudgePercent(item: item, stat: text) :: number:
    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_item})
    set {_current} to int tag "Stats;%{_stat}%" of (custom nbt of {_item})
    if {_current} <= 0:
        return 0
    set {_rolls} to ArtifactEffectiveRollCount({_item}, {_stat})
    set {_minimum} to PapitoArtifactMinRoll({_itemLevel}) * {_rolls}
    set {_maximum} to PapitoArtifactMaxRoll({_itemLevel}) * {_rolls}
    if {_maximum} <= {_minimum}:
        return 100
    set {_ratio} to ({_current} - {_minimum}) / ({_maximum} - {_minimum})
    if {_ratio} < 0:
        set {_ratio} to 0
    if {_ratio} > 1:
        set {_ratio} to 1
    return {_ratio} * 100

function PapitoJudgeArtifact(p: player, item: item):
    set {_artifact} to {_item}
    set {_artifactName} to name of {_artifact}
    send "&8[<#b0b0b0>NPC&8] [<#b0b0b0>Papito&8] &fHmm... let me think." to {_p}
    play sound "entity.villager.ambient" with volume 4 and pitch 0.8 to {_p}
    play sound "entity.villager.work_toolsmith" with volume 4 and pitch 0.95 to {_p}
    wait 25 ticks
    send "&8[<#b0b0b0>NPC&8] [<#b0b0b0>Papito&8] &f..." to {_p}
    play sound "entity.villager.ambient" with volume 3 and pitch 0.6 to {_p}
    wait 30 ticks
    send "&8[<#b0b0b0>NPC&8] [<#b0b0b0>Papito&8] &fYour %{_artifactName}% &f... ahh, I see it now, m'hijo." to {_p}
    play sound "entity.villager.yes" with volume 4 and pitch 0.8 to {_p}
    wait 25 ticks

    set {_stats::*} to nbt tags of (compound tag "Stats" of (custom nbt of {_artifact}))
    loop {_stats::*}:
        set {_percent} to ArtifactStatJudgePercent({_artifact}, loop-value)
        set {_formattedPercent} to PapitoFormatPercent({_percent})
        set {_formattedStat} to getFormattedStat(loop-value)
        set {_stats} to int tag "Stats;%loop-value%" of (custom nbt of {_artifact})
        replace all "{VALUE}" in {_formattedStat} with "+%{_stats}%"
        send "&8[<#b0b0b0>NPC&8] [<#b0b0b0>Papito&8] &fThis %{_formattedStat}% &froll... &f%{_formattedPercent}%%%&f." to {_p}
        play sound "entity.villager.ambient" with volume 3 and pitch 0.9 to {_p}
        wait 6 ticks

    set {_overallPercent} to PapitoArtifactJudgePercent({_artifact})
    set {_overallText} to PapitoFormatPercent({_overallPercent})
    wait 10 ticks
    send "&8[<#b0b0b0>NPC&8] [<#b0b0b0>Papito&8] &fOverall, m'hijo... this one has &f&l%{_overallText}%%% &fof its possible value." to {_p}
    play sound "entity.villager.celebrate" with volume 4 and pitch 0.85 to {_p}
    wait 8 ticks
    set metadata tag "papitoJudgeItem" of {_p} to chest inventory with 3 rows named "Papito - Rate Artifact"
    set {_gui} to metadata tag "papitoJudgeItem" of {_p}
    set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
    set slot 11 of {_gui} to {_artifact}
    set slot 15 of {_gui} to netherite ingot named "&7Artifact Value" with lore ArtifactJudgeValueLore({_artifact})
    open {_gui} to {_p}

function ArtifactJudgeValueLore(item: item) :: texts:
    set {_currentValue} to ArtifactCurrentValue({_item})
    set {_minValue} to PapitoArtifactMinValue({_item})
    set {_maxValue} to PapitoArtifactMaxValue({_item})
    set {_percent} to PapitoArtifactJudgePercent({_item})
    set {_rollQuality} to PapitoArtifactRollQuality({_item})
    set {_initialQuality} to PapitoArtifactInitialSubstatQuality({_item})
    set {_rollCount} to PapitoArtifactRollCount({_item})
    set {_initialSubstats} to PapitoArtifactInitialSubstats({_item})
    set {_starLevel} to int tag "StarLevel" of (custom nbt of {_item})
    set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_item})
    if {_percent} >= 95:
        set {_rating} to "&6Transcendent"
    else if {_percent} >= 85:
        set {_rating} to "&dExceptional"
    else if {_percent} >= 70:
        set {_rating} to "&bExcellent"
    else if {_percent} >= 55:
        set {_rating} to "&aPromising"
    else if {_percent} >= 40:
        set {_rating} to "&eAverage"
    else:
        set {_rating} to "&cPoor"
    set {_percentText} to PapitoFormatPercent({_percent})
    set {_lore::*} to "&7Papito judges this Artifact using", "&7normalized roll quality.", " ", "&7Star Level: &f%{_starLevel}%", "&7Item Level: &f%{_itemLevel}%", "&7Initial Substats: &f%{_initialSubstats}%", "&7Roll Count: &f%{_rollCount}%", "&7Current Value: &f%round({_currentValue}, 0)%", "&7Minimum Value: &f%round({_minValue}, 0)%", "&7Maximum Value: &f%round({_maxValue}, 0)%", "&7Quality: &f%{_percentText}%%%", "&7Rating: %{_rating}%"
    return {_lore::*}

function findGemsByColour(gemColour: string) :: strings:
    loop yaml node keys "Gems" in "GemList":
        loop yaml node keys "Gems.%loop-value%" in "GemList":
            set {_colour} to yaml value "Gems.%loop-value-1%.%loop-value-2%.Colour" in "GemList"
            if {_colour} = {_gemColour}:
                set {_eligibleGems::*} to {_eligibleGems::*} and loop-value-2

    return {_eligibleGems::*}
                

on inventory click:
    if event-inventory = metadata tag "papito" of player:
        if event-slot = 6:
            cancel event
            set metadata tag "papitoStarforge" of player to chest inventory with 6 rows named "Papito - Starforge"
            set {_slotIndex} to 0
            loop all items in the player's inventory:
                if item amount of loop-item = 1:
                    if StarforgeEligibleGear(loop-item) is true:
                        set {_item} to loop-item
                        set {_item} to StarforgeLoreUpdate(player, {_item})
                        set slot {_slotIndex} of metadata tag "papitoStarforge" of player to {_item}
                        add "%nl%&f&oClick here to choose a Starforged Sigil." to lore of slot {_slotIndex} of metadata tag "papitoStarforge" of player
                        add 1 to {_slotIndex}
            if {_slotIndex} > 0:
                StarforgePlayMenuSound(player)
                open metadata tag "papitoStarforge" of player to player
            else:
                play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                send "&c&oThere are no eligible gear pieces in your inventory." to player

on inventory click:
    if event-inventory = metadata tag "papitoStarforge" of player:
        cancel event
        if event-slot is not air:
            set {_gear} to event-slot
            set {_gearId} to string tag "GearId" of (custom nbt of {_gear})
            set metadata value "PapitoStarforgeGearId" of player to {_gearId}
            set metadata value "PapitoStarforgeGear" of player to {_gear}
            set metadata tag "papitoStarforgeSigils" of player to chest inventory with 6 rows named "Papito - Starforge - Choose Sigil"
            set slot 49 of metadata tag "papitoStarforgeSigils" of player to StarforgeLoreUpdate(player, {_gear})
            set {_slotIndex} to 0
            loop all items in the player's inventory:
                if item amount of loop-item >= 1:
                    if StarforgeIsSigil(loop-item) is true:
                        set {_reason} to StarforgeApplyFailure(player, {_gear}, loop-item)
                        if {_reason} = "":
                            set {_item} to loop-item
                            add "%nl%&f&oClick here to apply this Starforged Sigil." to lore of {_item}
                            set slot {_slotIndex} of metadata tag "papitoStarforgeSigils" of player to {_item}
                            add 1 to {_slotIndex}
            if {_slotIndex} > 0:
                StarforgePlayMenuSound(player)
                open metadata tag "papitoStarforgeSigils" of player to player
            else:
                play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                send "&c&oThere are no applicable Starforged Sigils in your inventory." to player

on inventory click:
    if event-inventory = metadata tag "papitoStarforgeSigils" of player:
        cancel event
        if event-slot is not air:
            if StarforgeIsSigil(event-slot) is true:
                set {_gear} to metadata value "PapitoStarforgeGear" of player
                set {_sigil} to event-slot
                set {_reason} to StarforgeApplyFailure(player, {_gear}, {_sigil})
                if {_reason} != "":
                    play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
                    send {_reason} to player
                    stop
                set metadata value "PapitoStarforgeSigilCard" of player to string tag "DiamondSourceCard" of (custom nbt of {_sigil})
                set metadata value "PapitoStarforgeSigilTier" of player to string tag "DiamondSourceTier" of (custom nbt of {_sigil})
                if StarforgeApplied({_gear}) is true:
                    set metadata tag "papitoStarforgeOverwrite" of player to chest inventory with 3 rows named "Papito - Starforge - Replace"
                    set {_gui} to metadata tag "papitoStarforgeOverwrite" of player
                    set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
                    set slot 10 of {_gui} to StarforgeLoreUpdate(player, {_gear})
                    set slot 12 of {_gui} to StarforgeDisplayItem(string tag "Starforged;Card" of (custom nbt of {_gear}), string tag "Starforged;Tier" of (custom nbt of {_gear}), true)
                    set slot 14 of {_gui} to StarforgeDisplayItem(string tag "DiamondSourceCard" of (custom nbt of {_sigil}), string tag "DiamondSourceTier" of (custom nbt of {_sigil}), false)
                    set slot 16 of {_gui} to lime stained glass pane named "&aConfirm Replace" with lore "&7Click here to apply the new Starforged Sigil." and "&7This will consume the selected Sigil." and " " and "&cWarning: this will replace the old" and "&cStarforged effect."
                    StarforgePlayMenuSound(player)
                    open {_gui} to player
                else:
                    set metadata tag "papitoStarforgeConfirm" of player to chest inventory with 3 rows named "Papito - Starforge - Confirm"
                    set {_gui} to metadata tag "papitoStarforgeConfirm" of player
                    set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
                    set slot 10 of {_gui} to StarforgeLoreUpdate(player, {_gear})
                    set slot 13 of {_gui} to StarforgeDisplayItem(string tag "DiamondSourceCard" of (custom nbt of {_sigil}), string tag "DiamondSourceTier" of (custom nbt of {_sigil}), false)
                    set slot 16 of {_gui} to lime stained glass pane named "&aConfirm Starforge" with lore "&7Click here to apply the selected" and "&7Starforged Sigil to this gear piece." and "&7This will consume the selected Sigil."
                    StarforgePlayMenuSound(player)
                    open {_gui} to player

on inventory click:
    if event-inventory = metadata tag "papitoStarforgeConfirm" of player:
        cancel event
        if event-slot = 16:
            set {_gear} to metadata value "PapitoStarforgeGear" of player
            set {_card} to metadata value "PapitoStarforgeSigilCard" of player
            set {_tier} to metadata value "PapitoStarforgeSigilTier" of player
            set {_updated} to StarforgeApplyToItem(player, {_gear}, {_card}, {_tier})
            StarforgeConsumeAndGive(player, {_updated}, {_card}, {_tier})
            close player's inventory
            play sound "block.amethyst_cluster.break" with volume 5 and pitch 1.25 to player
            play sound "entity.player.levelup" with volume 4 and pitch 1.15 to player
            send "&b✦ Successfully Starforged %name of {_updated}%&b." to player

on inventory click:
    if event-inventory = metadata tag "papitoStarforgeOverwrite" of player:
        cancel event
        if event-slot = 16:
            set {_gear} to metadata value "PapitoStarforgeGear" of player
            set {_card} to metadata value "PapitoStarforgeSigilCard" of player
            set {_tier} to metadata value "PapitoStarforgeSigilTier" of player
            set {_updated} to StarforgeApplyToItem(player, {_gear}, {_card}, {_tier})
            StarforgeConsumeAndGive(player, {_updated}, {_card}, {_tier})
            close player's inventory
            play sound "block.amethyst_cluster.break" with volume 5 and pitch 1.1 to player
            play sound "entity.player.levelup" with volume 4 and pitch 1.05 to player
            send "&b✦ Successfully replaced the Starforged effect on %name of {_updated}%&b." to player

on inventory open:
    if event-inventory = metadata tag "gearcard" of player:
        wait 1 tick
        loop yaml node keys "Slot Map" in "GearList":
            set {_slotIndex} to loop-value parsed as integer
            set {_gearItem} to slot {_slotIndex} of event-inventory
            if {_gearItem} is not air:
                if StarforgeApplied({_gearItem}) is true:
                    set {_gearItem} to StarforgeLoreUpdate(player, {_gearItem}, true)
                    set slot {_slotIndex} of event-inventory to {_gearItem}

on inventory click:
    if player's current inventory = metadata tag "gearcard" of player:
        if inventory action = instant move:
            if event-slot is not air:
                if StarforgeApplied(event-slot) is true:
                    set {_gearId} to string tag "GearId" of (custom nbt of event-slot)
                    wait 1 tick
                    loop integers between 0 and 40:
                        set {_item} to slot loop-value of player
                        if {_item} is not air:
                            if string tag "GearId" of (custom nbt of {_item}) = {_gearId}:
                                set {_item} to StarforgeLoreUpdate(player, {_item})
                                set slot loop-value of player to {_item}
                                stop

function StarforgePlayMenuSound(p: player):
    play sound "block.anvil.place" with volume 5 and pitch 1.92 to {_p}
    play sound "block.amethyst_block.resonate" with volume 4 and pitch 1.65 to {_p}
    play sound "block.amethyst_cluster.break" with volume 4 and pitch 1.3 to {_p}

function StarforgeEligibleGear(item: item) :: boolean:
    if boolean tag "GearItem" of (custom nbt of {_item}) is not set:
        return false
    set {_gearSlot} to string tag "GearSlot" of (custom nbt of {_item})

    set {_slots::*} to "Helmet", "Chestplate", "Leggings" and "Boots"

    if {_slots::*} contains {_gearSlot}:
        return true

    return false

function StarforgeIsSigil(item: item) :: boolean:
    set {_type} to string tag "DiamondFeaturedType" of (custom nbt of {_item})
    if {_type} = "TierSet":
        return true
    if {_type} = "Sigil":
        return true
    return false

function StarforgeApplied(item: item) :: boolean:
    if string tag "Starforged;Card" of (custom nbt of {_item}) is set:
        return true
    return false

function StarforgeBoundCard(id: text) :: text:
    loop yaml node keys "Card Colours" in "CardList":
        if yaml file "plugins/Skript/playerdata/karty/%loop-value%/%{_id}%.yml" exists:
            return loop-value
    loop yaml node keys "Cards" in "StellarChestList":
        if yaml file "plugins/Skript/playerdata/karty/%loop-value%/%{_id}%.yml" exists:
            return loop-value
    return ""

function StarforgeApplyFailure(p: player, gear: item, sigil: item) :: text:
    if StarforgeEligibleGear({_gear}) is false:
        return "&cThis item cannot be Starforged."
    if StarforgeIsSigil({_sigil}) is false:
        return "&cThis item is not a Starforged Sigil."
    set {_sigilCard} to string tag "DiamondSourceCard" of (custom nbt of {_sigil})
    if {_sigilCard} is not set:
        return "&cThis Sigil is missing its source Card."
    if string tag "Cardbound" of (custom nbt of {_gear}) is set:
        set {_boundId} to string tag "Cardbound" of (custom nbt of {_gear})
        set {_boundCard} to StarforgeBoundCard({_boundId})
        if {_boundCard} is set:
            if {_boundCard} != {_sigilCard}:
                return "&cThis gear is Cardbound to %{_boundCard}%&c."
    return ""

function StarforgeSetName(card: text, tier: text) :: text:
    set {_name} to yaml value "%{_card}%.%{_tier}%.Name" in "TierSetList"
    return {_name}

function StarforgeSetDisplay(card: text, tier: text, active: boolean = false) :: text:
    return StarforgeSetName({_card}, {_tier})

function StarforgeSetDescription(p: player, card: text, tier: text, setTier: text, active: boolean = false) :: text:
    set {_description} to formatted yaml value "%{_card}%.%{_tier}%.%{_setTier}%" in "TierSetList"

    set {_valueNames::*} to yaml node keys "%{_card}%.%{_tier}%" in "TierSetList"
    loop {_valueNames::*}:
        if {_setTier} = "2SET":
            if loop-value contains "2SETVALUE":
                set {_value} to yaml value "%{_card}%.%{_tier}%.%loop-value%" in "TierSetList"
                replace all "{%loop-value%}" in {_description} with "%{_value}%"

        else if {_setTier} = "4SET":
            if loop-value contains "4SETVALUE":
                set {_value} to yaml value "%{_card}%.%{_tier}%.%loop-value%" in "TierSetList"
                replace all "{%loop-value%}" in {_description} with "%{_value}%"

    replace all "{NL}" in {_description} with nl
    set {_description} to ReplaceTalentPlaceholders({_p}, {_card}, {_description}, {_tier})

    if {_active} is false:
        set {_description} to uncoloured {_description}
        replace all nl in {_description} with "%nl%&8"
        set {_description} to "&8%{_description}%"

    return {_description}

function StarforgeLeadColour(card: text) :: text:
    set {_colour} to yaml value "%{_card}%.Classic.Colour.Primary" in "VariantList"
    return {_colour}

function StarforgeInactiveBlock(item: item) :: text:
    set {_card} to string tag "Starforged;Card" of (custom nbt of {_item})
    set {_tier} to string tag "Starforged;Tier" of (custom nbt of {_item})
    if {_card} is not set:
        return ""
    set {_name} to mini message from (yaml value "%{_card}%.%{_tier}%.Gradient Name" in "TierSetList")
    
    set {_twoSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "2SET", false)
    set {_fourSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "4SET", false)
    set {_block} to "%nl% %nl%<#9fe7ff>&o✨ Starforged: &f%{_name}%"
    set {_block} to "%{_block}%%nl%&8✨ 2-set Effect: %{_twoSet}%"
    set {_block} to "%{_block}%%nl%&8✨ 4-set Effect: %{_fourSet}%"
    return {_block}

function StarforgeActiveBlock(p: player, item: item) :: text:
    set {_card} to string tag "Starforged;Card" of (custom nbt of {_item})
    set {_tier} to string tag "Starforged;Tier" of (custom nbt of {_item})
    if {_card} is not set:
        return ""
    set {_count} to StarforgeSetCount({_p}, {_card}, {_tier})
    
    set {_name} to mini message from (yaml value "%{_card}%.%{_tier}%.Gradient Name" in "TierSetList")

    set {_leadColour} to StarforgeLeadColour({_card})
    set {_block} to "%nl% %nl%<#9fe7ff>&o✨ Starforged: &f%{_name}%"
    if {_count} >= 2:
        set {_twoSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "2SET", true)
        set {_block} to coloured "%{_block}%%nl%%{_leadColour}%✨ 2-set Effect: %{_twoSet}%"
    else:
        set {_twoSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "2SET", false)
        set {_block} to "%{_block}%%nl%&8✨ 2-set Effect: %{_twoSet}%"
    if {_count} >= 4:
        set {_fourSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "4SET", true)
        set {_block} to coloured "%{_block}%%nl%%{_leadColour}%✨ 4-set Effect: %{_fourSet}%"
    else:
        set {_fourSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "4SET", false)
        set {_block} to "%{_block}%%nl%&8✨ 4-set Effect: %{_fourSet}%"
    return {_block}

function StarforgeSaveGearYaml(p: player, gearSlot: text, gear: item):
    clear yaml value "Card.Gear.%{_gearSlot}%.Starforged" in "activeCard-%{_p}%"
    if StarforgeApplied({_gear}) is true:
        set {_card} to string tag "Starforged;Card" of (custom nbt of {_gear})
        set {_tier} to string tag "Starforged;Tier" of (custom nbt of {_gear})
        set {_name} to StarforgeSetName({_card}, {_tier})
        set yaml value "Card.Gear.%{_gearSlot}%.Starforged.Card" in "activeCard-%{_p}%" to {_card}
        set yaml value "Card.Gear.%{_gearSlot}%.Starforged.Tier" in "activeCard-%{_p}%" to {_tier}
        set yaml value "Card.Gear.%{_gearSlot}%.Starforged.Name" in "activeCard-%{_p}%" to {_name}
        set yaml value "Card.Gear.%{_gearSlot}%.Starforged Bonus.Name" in "activeCard-%{_p}%" to {_name}
        set yaml value "Card.Gear.%{_gearSlot}%.Starforged Bonus.2Set.Description" in "activeCard-%{_p}%" to StarforgeSetDescription({_p}, {_card}, {_tier}, "2SET", true)
        set yaml value "Card.Gear.%{_gearSlot}%.Starforged Bonus.4Set.Description" in "activeCard-%{_p}%" to StarforgeSetDescription({_p}, {_card}, {_tier}, "4SET", true)

function StarforgeEligibleGearSlot(slot: text) :: boolean:
    if {_slot} = "Helmet" or "Chestplate" or "Leggings" or "Boots":
        return true
    return false

function RecalculateStarforgedBonuses(p: player):
    clear yaml value "Card.Starforged Bonus" in "activeCard-%{_p}%"
    loop yaml node keys "Card.Gear" in "activeCard-%{_p}%":
        if StarforgeEligibleGearSlot(loop-value) is true:
            if yaml value "Card.Gear.%loop-value%.Starforged.Card" in "activeCard-%{_p}%" is set:
                set {_card} to yaml value "Card.Gear.%loop-value%.Starforged.Card" in "activeCard-%{_p}%"
                set {_tier} to yaml value "Card.Gear.%loop-value%.Starforged.Tier" in "activeCard-%{_p}%"
                set {_count::%{_card}%::%{_tier}%} to {_count::%{_card}%::%{_tier}%} + 1
    loop yaml node keys "Card.Gear" in "activeCard-%{_p}%":
        if StarforgeEligibleGearSlot(loop-value) is true:
            clear yaml value "Card.Gear.%loop-value%.Starforged Bonus.2Set.Active" in "activeCard-%{_p}%"
            clear yaml value "Card.Gear.%loop-value%.Starforged Bonus.4Set.Active" in "activeCard-%{_p}%"
            if yaml value "Card.Gear.%loop-value%.Starforged.Card" in "activeCard-%{_p}%" is set:
                set {_card} to yaml value "Card.Gear.%loop-value%.Starforged.Card" in "activeCard-%{_p}%"
                set {_tier} to yaml value "Card.Gear.%loop-value%.Starforged.Tier" in "activeCard-%{_p}%"
                set {_name} to yaml value "Card.Gear.%loop-value%.Starforged.Name" in "activeCard-%{_p}%"
                set {_countValue} to {_count::%{_card}%::%{_tier}%}
                set yaml value "Card.Gear.%loop-value%.Starforged Bonus.Name" in "activeCard-%{_p}%" to {_name}
                set yaml value "Card.Gear.%loop-value%.Starforged Bonus.2Set.Description" in "activeCard-%{_p}%" to StarforgeSetDescription({_p}, {_card}, {_tier}, "2SET", true)
                set yaml value "Card.Gear.%loop-value%.Starforged Bonus.4Set.Description" in "activeCard-%{_p}%" to StarforgeSetDescription({_p}, {_card}, {_tier}, "4SET", true)
                set yaml value "Card.Gear.%loop-value%.Starforged Bonus.Count" in "activeCard-%{_p}%" to {_countValue}
                set yaml value "Card.Starforged Bonus.%{_card}%.%{_tier}%.Name" in "activeCard-%{_p}%" to {_name}
                set yaml value "Card.Starforged Bonus.%{_card}%.%{_tier}%.Count" in "activeCard-%{_p}%" to {_countValue}
                set yaml value "Card.Starforged Bonus.%{_card}%.%{_tier}%.2Set.Description" in "activeCard-%{_p}%" to StarforgeSetDescription({_p}, {_card}, {_tier}, "2SET", true)
                set yaml value "Card.Starforged Bonus.%{_card}%.%{_tier}%.4Set.Description" in "activeCard-%{_p}%" to StarforgeSetDescription({_p}, {_card}, {_tier}, "4SET", true)
                if {_countValue} >= 2:
                    set yaml value "Card.Gear.%loop-value%.Starforged Bonus.2Set.Active" in "activeCard-%{_p}%" to true
                    set yaml value "Card.Starforged Bonus.%{_card}%.%{_tier}%.2Set.Active" in "activeCard-%{_p}%" to true
                if {_countValue} >= 4:
                    set yaml value "Card.Gear.%loop-value%.Starforged Bonus.4Set.Active" in "activeCard-%{_p}%" to true
                    set yaml value "Card.Starforged Bonus.%{_card}%.%{_tier}%.4Set.Active" in "activeCard-%{_p}%" to true
    save yaml "activeCard-%{_p}%"

function StarforgeSetCount(p: player, card: text, tier: text) :: integer:
    loop yaml node keys "Card.Gear" in "activeCard-%{_p}%":
        if StarforgeEligibleGearSlot(loop-value) is true:
            if yaml value "Card.Gear.%loop-value%.Starforged.Card" in "activeCard-%{_p}%" = {_card}:
                if yaml value "Card.Gear.%loop-value%.Starforged.Tier" in "activeCard-%{_p}%" = {_tier}:
                    add 1 to {_count}
    return {_count}

function StarforgeLoreLines(p: player, item: item, equipped: boolean = false) :: texts:
    set {_inactive::*} to StarforgeInactiveBlock({_item}) split at nl
    if {_equipped} is true:
        set {_active::*} to StarforgeActiveBlock({_p}, {_item}) split at nl
        return {_active::*}
    return {_inactive::*}

function StarforgeLoreUpdate(p: player, item: item, equipped: boolean = false) :: item:
    set {_updated} to {_item}
    if {_equipped} is true:
        set lore of {_updated} to EquippedGearLoreUpdate({_p}, {_updated})
    else:
        set lore of {_updated} to GearLoreUpdate({_updated})
    return {_updated}

function StarforgeDisplayItem(card: text, tier: text, current: boolean = false) :: item:
    set {_itemType} to (yaml value "%{_card}%.%{_tier}%.Item" in "TierSetList") parsed as item type
    set {_cmd} to yaml value "%{_card}%.%{_tier}%.CustomModelData" in "TierSetList"
    set {_name} to mini message from (yaml value "%{_card}%.%{_tier}%.Gradient Name" in "TierSetList")
    set {_leadColour} to StarforgeLeadColour({_card})
    if {_current} is true:
        set {_title} to "&bCurrent Starforge"
    else:
        set {_title} to "&bNew Starforge"

    set {_twoSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "2SET", true)
    set {_fourSet} to StarforgeSetDescription({_p}, {_card}, {_tier}, "4SET", true)

    if {_cmd} is set:
        set {_item} to {_itemType} named "<#9fe7ff>%{_tier}%: &f%{_name}%" with lore coloured "%{_title}%%nl%&7Card: &f%{_card}%%nl% %nl%%{_leadColour}%✨ 2-set Effect: %{_twoSet}%%nl%%{_leadColour}%✨ 4-set Effect: %{_fourSet}%" with nbt from "{""minecraft:custom_model_data"":{floats:[%{_cmd}%.0f]}}"
    else:
        set {_item} to {_itemType} named "<#9fe7ff>%{_tier}%: &f%{_name}%" with lore coloured "%{_title}%%nl%&7Card: &f%{_card}%%nl% %nl%%{_leadColour}%✨ 2-set Effect: %{_twoSet}%%nl%%{_leadColour}%✨ 4-set Effect: %{_fourSet}%"
    
    return {_item}

function StarforgeApplyToItem(p: player, gear: item, card: text, tier: text) :: item:
    set string tag "Starforged;Card" of (custom nbt of {_gear}) to {_card}
    set string tag "Starforged;Tier" of (custom nbt of {_gear}) to {_tier}
    set string tag "Starforged;SetName" of (custom nbt of {_gear}) to StarforgeSetName({_card}, {_tier})
    return StarforgeLoreUpdate({_p}, {_gear})

function StarforgeConsumeAndGive(p: player, gear: item, card: text, tier: text):
    set {_gearId} to string tag "GearId" of (custom nbt of (metadata value "PapitoStarforgeGear" of {_p}))
    loop all items in {_p}'s inventory:
        if string tag "GearId" of (custom nbt of loop-item) = {_gearId}:
            remove 1 of loop-item from {_p}
            stop loop
    loop all items in {_p}'s inventory:
        if StarforgeIsSigil(loop-item) is true:
            if string tag "DiamondSourceCard" of (custom nbt of loop-item) = {_card}:
                if string tag "DiamondSourceTier" of (custom nbt of loop-item) = {_tier}:
                    remove 1 of loop-item from {_p}
                    stop loop
    giveItem({_p}, {_gear})
    clear metadata value "PapitoStarforgeGear" of {_p}
    clear metadata value "PapitoStarforgeGearId" of {_p}
    clear metadata value "PapitoStarforgeSigilCard" of {_p}
    clear metadata value "PapitoStarforgeSigilTier" of {_p}