            save yaml "%{_island}%Properties"
            unload yaml "%{_island}%Properties"

function IslandMobInfoAssignments(mob: entity, enemy: string, path: string, scale: number, yamlName: string = "IslandEnemyList"):
    set {_customNbt} to (custom nbt of {_mob})
    set {_height} to yaml value "%{_path}%.Nameplate Height" in "%{_yamlName}%"
    if {_height} is not set:
        if double tag "ECModelHeight" of {_customNbt} is set:
            set {_height} to double tag "ECModelHeight" of {_customNbt}
    if {_height} is not set:
        set {_height} to {_mob}.getBoundingBox().getHeight() + 0.35

    set double tag "ECNameplateHeight" of {_customNbt} to {_height}
    set string tag "MobType" of {_customNbt} to {_enemy}

    set {_rank} to yaml value "%{_path}%.Type" in "%{_yamlName}%"
    set {_name} to "&f%{_enemy}%"

    set {_nameplate} to yaml value "Azerite Map.Azerite.%{_rank}%" in "%{_yamlName}%"
    set {_name} to "&f%{_enemy}%"
    if {_nameplate} is set:
        set {_name} to "<#ffd447>★ &f%{_name}%"

    set {_level} to int tag "ECLvl" of {_customNbt}

    set {_nameLoc} to location of {_mob}
    set y of {_nameLoc} to (y of {_nameLoc}) + {_height}

    set {_levelLoc} to {_nameLoc}
    set y of {_levelLoc} to (y of {_nameLoc}) + 0.25

    set {_healthLoc} to {_nameLoc}
    set y of {_healthLoc} to (y of {_nameLoc}) - 0.25

    set {_nbt} to "{Marker:1b,Invulnerable:1b,Invisible:1b,CustomNameVisible:1b,NoGravity:1b}"

    push {_mob} upwards with velocity 0.01

    spawn 1 armor stand at {_healthLoc} with nbt from {_nbt}
    set display name of last spawned armor stand to "&a|||||||||| &f(100%%)"
    set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true
    set string tag "ECTextAbove" of {_customNbt} to uuid of last spawned armor stand
    set boolean tag "PersistenceRequired" of (nbt of last spawned armor stand) to true

    spawn 1 armor stand at {_nameLoc} with nbt from {_nbt}
    set display name of last spawned armor stand to {_name}
    set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true
    set string tag "ECCustomName" of {_customNbt} to uuid of last spawned armor stand
    set boolean tag "PersistenceRequired" of (nbt of last spawned armor stand) to true

    spawn 1 armor stand at {_levelLoc} with nbt from {_nbt}
    set display name of last spawned armor stand to "&4Level %{_level}%"
    set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true
    set string tag "ECTextAboveLevel" of {_customNbt} to uuid of last spawned armor stand
    set boolean tag "PersistenceRequired" of (nbt of last spawned armor stand) to true

    updateIslandMobNameplate({_mob})
    wait 1 tick
    updateIslandMobNameplate({_mob})

function IslandExpeditionBodyMobPull(x: entity, mob: entity):
    set {_attackerInstance} to metadata value "IslandExpeditionInstance" of {_x}
    set {_victimInstance} to metadata value "IslandExpeditionInstance" of {_mob}
    if {_victimInstance} is not set:
        set {_victimInstance} to string tag "IslandExpeditionInstance" of (custom nbt of {_mob})
    if {_attackerInstance} = {_victimInstance}:
        set target of {_mob} to {_x}
        if metadata value "ECPulled" of {_mob} is not set:
            set metadata value "ECPulled" of {_mob} to 1
            clear boolean tag "NoAI" of nbt of {_mob}
            UpdateTarget({_mob}, {_x}, "dynamic")

function updateIslandMobNameplate(e: entity):
    set {_customNbt} to (custom nbt of {_e})

    if string tag "ECTextAbove" of {_customNbt} is not set:
        stop

    if double tag "ECNameplateHeight" of {_customNbt} is set:
        set {_height} to double tag "ECNameplateHeight" of {_customNbt}
    else:
        set {_height} to {_e}.getBoundingBox().getHeight() + 0.35

    set {_baseLoc} to location of {_e}
    set {_x} to x of {_baseLoc}
    set {_y} to y of {_baseLoc}
    set {_z} to z of {_baseLoc}
    set {_w} to world of {_baseLoc}

    set {_nameLoc} to location({_x}, {_y} + {_height}, {_z}, {_w})
    set {_healthLoc} to location({_x}, {_y} + {_height} - 0.25, {_z}, {_w})
    set {_levelLoc} to location({_x}, {_y} + {_height} + 0.25, {_z}, {_w})

    set {_entity} to string tag "ECTextAbove" of {_customNbt} parsed as entity
    if {_entity} is set:
        teleport {_entity} to {_healthLoc}

    if string tag "ECCustomName" of {_customNbt} is set:
        set {_entity} to string tag "ECCustomName" of {_customNbt} parsed as entity
        if {_entity} is set:
            teleport {_entity} to {_nameLoc}

    if string tag "ECTextAboveLevel" of {_customNbt} is set:
        set {_entity} to string tag "ECTextAboveLevel" of {_customNbt} parsed as entity
        if {_entity} is set:
            teleport {_entity} to {_levelLoc}

function safeMobSpawnLocation(loc: location, range: integer = 16) :: location:
    set {_world} to world of {_loc}
    set {_x} to x of {_loc}
    set {_z} to z of {_loc}
    set {_baseY} to y of {_loc}

    loop {_range} times:
        set {_upY} to {_baseY} + loop-number
        set {_upLoc} to location({_x}, {_upY}, {_z}, {_world}, yaw of {_loc}, pitch of {_loc})

        if block below {_upLoc} is solid:
            if block at {_upLoc} is not solid:
                if block above {_upLoc} is not solid:
                    return location({_x}, {_upY}, {_z}, {_world}, yaw of {_loc}, pitch of {_loc})

        set {_downY} to {_baseY} - loop-number
        set {_downLoc} to location({_x}, {_downY}, {_z}, {_world}, yaw of {_loc}, pitch of {_loc})

        if block below {_downLoc} is solid:
            if block at {_downLoc} is not solid:
                if block above {_downLoc} is not solid:
                    return location({_x}, {_downY}, {_z}, {_world}, yaw of {_loc}, pitch of {_loc})

    return {_loc}

command /ieencounter [<string>] [<number>] [<integer>] [<integer>] [<string>]:
    trigger:
        if player's name != "Pehrek":
            send "&cYou cannot use this command." to player
            stop

        if arg-1 is not set:
            send "&cUsage: /ieencounter <IslandName> <Radius> <MinCount> <MaxCount> [SpotName]" to player
            stop
        if arg-2 is not set:
            send "&cRadius must be provided." to player
            stop
        if arg-3 is not set:
            send "&cMin count must be provided." to player
            stop
        if arg-4 is not set:
            send "&cMax count must be provided." to player
            stop

        if arg-5 is not set:
            send "&cName must be provided" to player

        set {_island} to arg-1
        set {_radius} to arg-2
        set {_min} to arg-3
        set {_max} to arg-4
        set {_loc} to location of player

        load yaml "plugins/Skript/islandexpeditions/%{_island}%/Enemies" as "%{_island}%Enemies-%player%"

        set {_spot} to arg-5

        set yaml value "EncounterSpots.%{_spot}%.Location.X" in "%{_island}%Enemies-%player%" to x of {_loc}
        set yaml value "EncounterSpots.%{_spot}%.Location.Y" in "%{_island}%Enemies-%player%" to y of {_loc}
        set yaml value "EncounterSpots.%{_spot}%.Location.Z" in "%{_island}%Enemies-%player%" to z of {_loc}
        set yaml value "EncounterSpots.%{_spot}%.Location.Pitch" in "%{_island}%Enemies-%player%" to pitch of {_loc}
        set yaml value "EncounterSpots.%{_spot}%.Location.Yaw" in "%{_island}%Enemies-%player%" to yaw of {_loc}
        set yaml value "EncounterSpots.%{_spot}%.Radius" in "%{_island}%Enemies-%player%" to {_radius}
        set yaml value "EncounterSpots.%{_spot}%.Count.Min" in "%{_island}%Enemies-%player%" to {_min}
        set yaml value "EncounterSpots.%{_spot}%.Count.Max" in "%{_island}%Enemies-%player%" to {_max}

        save yaml "%{_island}%Enemies-%player%"
        unload yaml "%{_island}%Enemies-%player%"

        send "&aSet encounter spot &f%{_spot}% &afor &f%{_island}% &aat &f%{_loc}%&a." to player

on tab complete of "/ieencounter":
    set {_islands::*} to getIslandWorlds()
    set tab completions for position 1 to {_islands::*}
    set tab completions for position 2 to "4", "6", "8", "10", "12", "16", "20", "24" and "32"
    set tab completions for position 3 to "1", "2", "3", "4", "5", "6", "8" and "10"
    set tab completions for position 4 to "3", "4", "5", "6", "8", "10", "12" and "16"
    set tab completions for position 5 to "Town1", "Town2", "Shore1", "Shore2", "Cave1", "Camp1", "Ruins1" and "Dock1"

function islandAIScheduleArrival(instance: string, island: string, difficulty: string, loc: location):
    if metadata value "IslandAISpawned" of {_loc}.getWorld() is set:
        stop
    set {_threshold} to random integer between 45 and 75
    set {_pressure} to 0
    set {_seconds} to 0
    set {_firstAzerite} to false
    while metadata value "IslandAISpawned" of {_loc}.getWorld() is not set:
        if metadata value "IslandExpeditionEnded" of {_loc}.getWorld() is set:
            stop
        if Bukkit.getWorld("%{_island}%-%{_instance}%") is not set:
            stop
        set {_pressure} to {_pressure} + random integer between 3 and 8
        set {_seconds} to {_seconds} + 10
        if {azeriteCollectedAlly::%{_instance}%} > 0:
            if {_firstAzerite} is false:
                set {_pressure} to {_pressure} + random integer between 15 and 25
                set {_firstAzerite} to true
        if {azeriteCollectedAlly::%{_instance}%} >= 500:
            set {_pressure} to {_pressure} + random integer between 8 and 18
        if {_seconds} >= 60:
            set {_pressure} to {_pressure} + random integer between 10 and 20
        if {_pressure} >= {_threshold}:
            set metadata value "IslandAISpawned" of {_loc}.getWorld() to true
            islandAISpawnTeam({_instance}, {_island}, {_difficulty}, {_loc}, "Ghazan")
            stop
        wait 10 seconds

function islandAISpawnTeam(instance: string, island: string, difficulty: string, loc: location, team: string):
    send "<#ff4747>An enemy crew has landed on the island." to all players in world of {_loc}
    loop yaml node keys "Teams.%{_team}%.Members" in "IslandAITeams":
        set {_path} to "Teams.%{_team}%.Members.%loop-value%"
        set {_name} to yaml value "%{_path}%.Name" in "IslandAITeams"
        set {_class} to yaml value "%{_path}%.Class" in "IslandAITeams"
        set {_role} to yaml value "%{_path}%.Role" in "IslandAITeams"
        set {_baseMob} to yaml value "%{_path}%.Base Mob" in "IslandAITeams"
        set {_model} to yaml value "%{_path}%.Model" in "IslandAITeams"
        set {_scale} to yaml value "%{_path}%.Scale" in "IslandAITeams"
        set {_health} to yaml value "%{_path}%.Health" in "IslandAITeams"
        set {_item} to yaml value "%{_path}%.Item" in "IslandAITeams"
        set {_allowShoot} to yaml value "%{_path}%.Allow Shoot" in "IslandAITeams"

        set {_model} to yaml value "%{_path}%.Model" in "IslandAITeams"
        set {_element} to yaml value "%{_path}%.Element" in "IslandAITeams"
        set {_disguises::*} to yaml list "%{_path}%.Disguise" in "IslandAITeams"
        if {_disguises::*} is not set:
            set {_disguises::*} to yaml value "%{_path}%.Disguise" in "IslandAITeams"

        if {_baseMob} is not set:
            set {_baseMob} to "adult zombie"
        
        set {_enemy} to {_baseMob} parsed as entity type

        if {_enemy} is not set:
            set {_enemy} to "adult zombie" parsed as entity type

        if {_scale} is not set:
            set {_scale} to 1

        set {_spawnLoc} to islandAICoastSpawnLocation({_loc}, 80)
        
        spawn {_enemy} at {_spawnLoc}
        set {_mob} to last spawned entity
        set boolean tag "PersistenceRequired" of (nbt of {_mob}) to true

        set {_customNbt} to (custom nbt of {_mob})
        if {_health} is not set:
            set {_health} to 20
        set {_mob}'s max health to {_health}
        heal {_mob}

        set boolean tag "ECMob" of {_customNbt} to true
        set int tag "ECLvl" of {_customNbt} to {maxCardLevel}
        set boolean tag "ECIslandEnemy" of {_customNbt} to true
        set boolean tag "RemoveOnReset" of {_customNbt} to true
        set string tag "ECElement" of {_customNbt} to {_element}
        set string tag "IslandExpeditionInstance" of {_customNbt} to {_instance}
        set string tag "IslandName" of {_customNbt} to {_island}
        set string tag "IslandEnemyName" of {_customNbt} to {_name}
        set string tag "IslandAIClass" of {_customNbt} to {_class}
        set string tag "IslandAITeam" of {_customNbt} to {_team}
        if {_allowShoot} is true:
            set boolean tag "IslandAllowShoot" of {_customNbt} to true
        set metadata value "IslandAIEnemy" of {_mob} to true
        set metadata value "IslandExpeditionInstance" of {_mob} to {_instance}
        set metadata value "IslandName" of {_mob} to {_island}
        set metadata value "IslandAIState" of {_mob} to "Scouting"
        set metadata value "IslandAIRole" of {_mob} to {_role}
        set metadata value "IslandAIClass" of {_mob} to {_class}
        set metadata value "IslandAITeam" of {_mob} to {_team}
        set metadata value "IslandAIWorth" of {_mob} to 0
        set metadata value "IslandAIPath" of {_mob} to {_path}
        set metadata value "IslandAIDifficulty" of {_mob} to {_difficulty}
        set metadata value "IslandAIBaseMob" of {_mob} to {_baseMob}
        set metadata value "IslandAIScale" of {_mob} to {_scale}
        set metadata value "IslandAIHealth" of {_mob} to {_health}
        set metadata value "IslandAIItem" of {_mob} to {_item}
        set metadata value "IslandAIModel" of {_mob} to {_model}
        set metadata value "IslandAIElement" of {_mob} to {_element}
        set metadata value "IslandAIAllowShoot" of {_mob} to {_allowShoot}
        set metadata value "ECMobSpawnLoc" of {_mob} to {_spawnLoc}
        set metadata value "IslandEnemyName" of {_mob} to {_name}

        if {_disguises::*} is set:
            if size of {_disguises::*} > 1:
                set {_disguise} to a random element of {_disguises::*}
            else:
                set {_disguise} to {_disguises::1}

            set metadata value "IslandAIDisguise" of {_mob} to {_disguise}
            disguise {_mob} as saved disguise "%{_disguise}%"

        if {_model} is set:
            set string tag "ECModeledEntity" of {_customNbt} to {_model}
            modelApply({_mob}, {_model}, {_scale})

        if {_mob} is a skeleton:
            set {_mob}'s tool to bow

        if {_item} is set:
            set {_mob}'s tool to {_item}

        onECMobSpawn({_mob})
        islandAIThink({_mob})
        azeriteTeamMemberWorth({_mob})

        IslandMobInfoAssignments({_mob}, {_name}, {_path}, {_scale}, "IslandAITeams")

function islandAIRespawnMob(dead: entity):
    if metadata value "IslandAIEnemy" of {_dead} is not true:
        stop

    set {_instance} to metadata value "IslandExpeditionInstance" of {_dead}
    set {_island} to metadata value "IslandName" of {_dead}
    set {_name} to metadata value "IslandEnemyName" of {_dead}
    set {_class} to metadata value "IslandAIClass" of {_dead}
    set {_team} to metadata value "IslandAITeam" of {_dead}
    set {_role} to metadata value "IslandAIRole" of {_dead}
    set {_path} to metadata value "IslandAIPath" of {_dead}
    set {_difficulty} to metadata value "IslandAIDifficulty" of {_dead}
    set {_baseMob} to metadata value "IslandAIBaseMob" of {_dead}
    set {_scale} to metadata value "IslandAIScale" of {_dead}
    set {_health} to metadata value "IslandAIHealth" of {_dead}
    set {_item} to metadata value "IslandAIItem" of {_dead}
    set {_model} to metadata value "IslandAIModel" of {_dead}
    set {_element} to metadata value "IslandAIElement" of {_dead}
    set {_allowShoot} to metadata value "IslandAIAllowShoot" of {_dead}
    set {_disguise} to metadata value "IslandAIDisguise" of {_dead}
    set {_spawnLoc} to metadata value "ECMobSpawnLoc" of {_dead}

    if {_spawnLoc} is not set:
        stop
    if {_instance} is not set:
        stop

    wait 30 seconds

    if Bukkit.getWorld("%world of {_spawnLoc}%") is not set:
        stop
    if metadata value "IslandExpeditionEnded" of world of {_spawnLoc} is set:
        stop

    set {_entity} to {_baseMob} parsed as entity type
    if {_entity} is not set:
        set {_entity} to "adult zombie" parsed as entity type

    spawn {_entity} at {_spawnLoc}
    set {_mob} to last spawned entity
    set boolean tag "PersistenceRequired" of (nbt of {_mob}) to true

    set {_customNbt} to (custom nbt of {_mob})
    if {_health} is not set:
        set {_health} to 20
    if {_scale} is not set:
        set {_scale} to 1

    set {_mob}'s max health to {_health}
    heal {_mob}
    set scale attribute of {_mob} to {_scale}

    set boolean tag "ECMob" of {_customNbt} to true
    set int tag "ECLvl" of {_customNbt} to {maxCardLevel}
    set boolean tag "ECIslandEnemy" of {_customNbt} to true
    set boolean tag "RemoveOnReset" of {_customNbt} to true
    set string tag "ECElement" of {_customNbt} to {_element}
    set string tag "IslandExpeditionInstance" of {_customNbt} to {_instance}
    set string tag "IslandName" of {_customNbt} to {_island}
    set string tag "IslandEnemyName" of {_customNbt} to {_name}
    set string tag "IslandAIClass" of {_customNbt} to {_class}
    set string tag "IslandAITeam" of {_customNbt} to {_team}
    if {_allowShoot} is true:
        set boolean tag "IslandAllowShoot" of {_customNbt} to true

    set metadata value "IslandAIEnemy" of {_mob} to true
    set metadata value "IslandExpeditionInstance" of {_mob} to {_instance}
    set metadata value "IslandName" of {_mob} to {_island}
    set metadata value "IslandAIState" of {_mob} to "Scouting"
    set metadata value "IslandAIRole" of {_mob} to {_role}
    set metadata value "IslandAIClass" of {_mob} to {_class}
    set metadata value "IslandAITeam" of {_mob} to {_team}
    set metadata value "IslandAIWorth" of {_mob} to 0
    set metadata value "IslandAIPath" of {_mob} to {_path}
    set metadata value "IslandAIDifficulty" of {_mob} to {_difficulty}
    set metadata value "IslandAIBaseMob" of {_mob} to {_baseMob}
    set metadata value "IslandAIScale" of {_mob} to {_scale}
    set metadata value "IslandAIHealth" of {_mob} to {_health}
    set metadata value "IslandAIItem" of {_mob} to {_item}
    set metadata value "IslandAIModel" of {_mob} to {_model}
    set metadata value "IslandAIElement" of {_mob} to {_element}
    set metadata value "IslandAIAllowShoot" of {_mob} to {_allowShoot}
    set metadata value "ECMobSpawnLoc" of {_mob} to {_spawnLoc}
    set metadata value "IslandEnemyName" of {_mob} to {_name}

    if {_disguise} is set:
        set metadata value "IslandAIDisguise" of {_mob} to {_disguise}
        disguise {_mob} as saved disguise "%{_disguise}%"

    if {_model} is set:
        set string tag "ECModeledEntity" of {_customNbt} to {_model}
        modelApply({_mob}, {_model}, {_scale})

    set {_mob}'s tool to air
    set {_mob}'s helmet to air
    set {_mob}'s boots to air
    set {_mob}'s leggings to air
    set {_mob}'s chestplate to air

    if {_mob} is a skeleton:
        set {_mob}'s tool to bow

    if {_item} is set:
        set {_mob}'s tool to {_item}

    onECMobSpawn({_mob})
    islandAIThink({_mob})
    azeriteTeamMemberWorth({_mob})
    IslandMobInfoAssignments({_mob}, {_name}, {_path}, {_scale}, "IslandAITeams")

function islandAITeleportMobToAI(ai: entity, target: entity):
    if {_ai} is not alive:
        stop
    if {_target} is not alive:
        stop
    set {_loc} to location of {_ai}
    teleport {_target} to {_loc}
    set target of {_target} to {_ai}
    set metadata value "ECPulled" of {_target} to 1
    clear metadata value "IslandAICombatTarget" of {_ai}
    clear metadata value "IslandAICombatTargetTime" of {_ai}
    play sound "entity.enderman.teleport" with volume 1.5 and pitch 0.8 at {_loc}
    draw 18 of smoke particle with extra value 0.05 with offset vector(0.6, 0.6, 0.6) at {_loc}

function islandAITeleportToAzerite(ai: entity, target: entity):
    if {_ai} is not alive:
        stop
    if string tag "AzeriteInstance" of (custom nbt of {_target}) is not set:
        stop
    set {_loc} to location of {_target}
    teleport {_ai} to {_loc}
    clear target of {_ai}
    clear metadata value "IslandAIAzeriteTargetTime" of {_ai}
    play sound "entity.enderman.teleport" with volume 1.5 and pitch 1.2 at {_loc}
    draw 18 of smoke particle with extra value 0.05 with offset vector(0.6, 0.6, 0.6) at {_loc}

function islandAIThink(ai: entity):
    while {_ai} is alive:
        if metadata value "IslandExpeditionEnded" of world of {_ai} is set:
            stop
        if metadata value "IslandAIEnemy" of {_ai} is not true:
            stop
        set {_instance} to metadata value "IslandExpeditionInstance" of {_ai}
        if {_instance} is not set:
            stop

        if metadata value "IslandAICasting" of {_ai} is set:
            set {_castingStarted} to metadata value "IslandAICastingStarted" of {_ai}
            if {_castingStarted} is set:
                if difference between {_castingStarted} and now > 10 seconds:
                    islandAICancelCast({_ai})
            else:
                islandAICancelCast({_ai})
            wait 1 second
            continue

        if metadata value "IslandAIMining" of {_ai} is set:
            set {_playerTarget} to islandAINearestPlayer({_ai}, {_instance}, 18)
            set {_mobTarget} to islandAINearestEnemyMob({_ai}, {_instance}, 16)
            if {_playerTarget} is set:
                islandAICancelMining({_ai})
            else if {_mobTarget} is set:
                islandAICancelMining({_ai})
            else:
                set {_targetTime} to metadata value "IslandAIAzeriteTargetTime" of {_ai}
                if {_targetTime} is set:
                    if difference between {_targetTime} and now > 20 seconds:
                        islandAICancelMining({_ai})
                    else:
                        wait 1 second
                        continue
                else:
                    islandAICancelMining({_ai})

        set {_playerTarget} to islandAINearestPlayer({_ai}, {_instance}, 18)
        if {_playerTarget} is set:
            clear metadata value "IslandAICombatTarget" of {_ai}
            clear metadata value "IslandAICombatTargetTime" of {_ai}
            set metadata value "IslandAIState" of {_ai} to "FightingPlayer"
            set target of {_ai} to {_playerTarget}
            islandAICombat({_ai}, {_playerTarget})
            wait 2 seconds
            continue
            
        set {_mobTarget} to islandAINearestEnemyMob({_ai}, {_instance}, 16)
        if {_mobTarget} is set:
            set {_targetId} to uuid of {_mobTarget}
            if metadata value "IslandAICombatTarget" of {_ai} != {_targetId}:
                set metadata value "IslandAICombatTarget" of {_ai} to {_targetId}
                set metadata value "IslandAICombatTargetTime" of {_ai} to now
            else:
                set {_targetTime} to metadata value "IslandAICombatTargetTime" of {_ai}
                if {_targetTime} is set:
                    if difference between {_targetTime} and now > 6 seconds:
                        if distance between {_ai} and {_mobTarget} > 4:
                            islandAITeleportMobToAI({_ai}, {_mobTarget})

            set metadata value "IslandAIState" of {_ai} to "FightingMob"
            set target of {_ai} to {_mobTarget}
            make {_ai} pathfind to {_mobTarget}
            islandAICombat({_ai}, {_mobTarget})
            wait 2 seconds
            continue
        else:
            clear metadata value "IslandAICombatTarget" of {_ai}
            clear metadata value "IslandAICombatTargetTime" of {_ai}

        set {_azeriteTarget} to islandAINearestAzerite({_ai}, {_instance}, 80)
        if {_azeriteTarget} is set:
            clear {_ai}'s target
            set metadata value "IslandAIState" of {_ai} to "MovingToAzerite"

            set {_nodeId} to uuid of {_azeriteTarget}
            if metadata value "IslandAIAzeriteTarget" of {_ai} != {_nodeId}:
                set metadata value "IslandAIAzeriteTarget" of {_ai} to {_nodeId}
                set metadata value "IslandAIAzeriteTargetTime" of {_ai} to now

            make {_ai} pathfind to {_azeriteTarget}

            if distance between {_ai} and {_azeriteTarget} <= 3:
                AzeriteOreMine({_ai}, {_azeriteTarget}, "Enemy")
                wait 2 seconds
                continue

            set {_targetTime} to metadata value "IslandAIAzeriteTargetTime" of {_ai}
            if {_targetTime} is set:
                if difference between {_targetTime} and now > 12 seconds:
                    islandAITeleportToAzerite({_ai}, {_azeriteTarget})
                    wait 1 second
                    AzeriteOreMine({_ai}, {_azeriteTarget}, "Enemy")
                    wait 2 seconds
                    continue

            wait 2 seconds
            continue
        set metadata value "IslandAIState" of {_ai} to "Scouting"
        islandAIScout({_ai})
        wait 2 seconds

function islandAINearestPlayer(ai: entity, instance: string, radius: number) :: player:
    set {_bestDistance} to 9999
    loop {IslandPlayers::%{_instance}%::*}:
        if loop-value is online:
            if metadata value "IslandExpeditionInstance" of loop-value = {_instance}:
                if loop-value's gamemode is survival:
                    if loop-value does not have invisibility:
                        set {_distance} to distance between loop-value and {_ai}
                        if {_distance} <= {_radius}:
                            if {_distance} < {_bestDistance}:
                                set {_bestDistance} to {_distance}
                                set {_best} to loop-value
    return {_best}

function islandAINearestEnemyMob(ai: entity, instance: string, radius: number) :: entity:
    set {_world} to "%world of {_ai}%"
    set {_bestDistance} to 9999
    loop {ECMobs::%{_world}%::*}:
        set {_mob} to loop-value parsed as entity
        if {_mob} is set:
            if {_mob} != {_ai}:
                if metadata value "IslandEnemy" of {_mob} is true:
                    if metadata value "IslandExpeditionInstance" of {_mob} = {_instance}:
                        if {_mob} is alive:
                            set {_distance} to distance between {_mob} and {_ai}
                            if {_distance} <= {_radius}:
                                if {_distance} < {_bestDistance}:
                                    set {_bestDistance} to {_distance}
                                    set {_best} to {_mob}
    return {_best}

function islandAINearestAzerite(ai: entity, instance: string, radius: number) :: entity:
    set {_bestDistance} to 999999
    loop {IslandAzerite::%{_instance}%::*}:
        if loop-value is set:
            if string tag "AzeriteInstance" of (custom nbt of loop-value) = {_instance}:
                if boolean tag "AzeriteLoaded" of (custom nbt of loop-value) is true:
                    set {_distance} to distance between {_ai} and loop-value
                    if {_distance} < {_bestDistance}:
                        set {_bestDistance} to {_distance}
                        set {_best} to loop-value
    return {_best}

function islandAIScout(ai: entity):
    set {_instance} to metadata value "IslandExpeditionInstance" of {_ai}
    set {_world} to world of {_ai}
    set {_points::*} to islandExpeditionEnemyPoints(metadata value "IslandName" of {_ai}, {_world})
    if {_points::*} is set:
        set {_loc} to a random element of {_points::*}
        make {_ai} pathfind to {_loc}

function islandAICombat(ai: entity, target: entity):
    if metadata value "IslandExpeditionEnded" of world of {_ai} is set:
        stop
    if metadata value "IslandAICasting" of {_ai} is set:
        stop

    set {_class} to metadata value "IslandAIClass" of {_ai}
    if {_class} is not set:
        stop

    if {_class} = "Ghazan":
        if metadata value "IslandAILavaSurge" of {_ai} is set:
            clear metadata value "IslandAILavaSurge" of {_ai}
            islandAIUseAbility({_ai}, {_target}, "Lava Burst", true)
            stop

    set {_ability} to islandAIChooseAbility({_ai}, {_class}, {_target})
    if {_ability} is not set:
        if distance between {_ai} and {_target} > 5:
            clear target of {_ai}
        stop

    islandAIUseAbility({_ai}, {_target}, {_ability})

function islandAIChooseAbility(ai: entity, class: string, target: entity) :: string:
    set {_total} to 0
    loop yaml node keys "Classes.%{_class}%.Abilities" in "IslandAITeams":
        set {_ability} to loop-value
        set {_range} to yaml value "Classes.%{_class}%.Abilities.%{_ability}%.Range" in "IslandAITeams"
        if {_range} is not set:
            set {_range} to 20
        if distance between {_ai} and {_target} <= {_range}:
            if cooldown "IslandAI%uuid of {_ai}%%{_ability}%" is finished:
                set {_weight} to yaml value "Classes.%{_class}%.Abilities.%{_ability}%.Weight" in "IslandAITeams"
                if {_weight} is not set:
                    set {_weight} to 1
                set {_total} to {_total} + {_weight}
                set {_abilities::*} to {_abilities::*} and {_ability}
                set {_weights::%size of {_abilities::*}%} to {_weight}
    if {_total} <= 0:
        if {_class} contains "Ember":
            if distance between {_ai} and {_target} <= 22:
                if cooldown "IslandAI%uuid of {_ai}%Lava Bolt" is finished:
                    return "Lava Bolt"
        return {_none}
    set {_roll} to random number between 0 and {_total}
    set {_current} to 0
    loop {_abilities::*}:
        set {_current} to {_current} + {_weights::%loop-counter%}
        if {_roll} <= {_current}:
            return loop-value
    return {_abilities::1}

function islandAICastBar(progress: integer) :: text:
    set {_bar} to ""
    loop 10 times:
        if loop-number <= {_progress}:
            set {_bar} to "%{_bar}%<#ff7a24>|"
        else:
            set {_bar} to "%{_bar}%<#4a2b22>|"
    return {_bar}

function islandAICastDisplayLocation(ai: entity) :: location:
    set {_customNbt} to (custom nbt of {_ai})
    set {_height} to double tag "ECNameplateHeight" of {_customNbt}
    if {_height} is not set:
        set {_height} to {_ai}.getBoundingBox().getHeight() + 0.35
    set {_loc} to location of {_ai}
    set y of {_loc} to y of {_loc} + {_height} + 0.5
    return {_loc}

function islandAICastDisplay(ai: entity, ability: string, progress: integer):
    set {_oldId} to metadata value "IslandAICastDisplayId" of {_ai}
    set {_partyMembers::*} to all players in world "%{_ai}'s world%"

    if {_oldId} is set:
        remove fake entity with id {_oldId} for {_partyMembers::*}

    set {_id} to random integer between 0 and 999999
    set metadata value "IslandAICastDisplayId" of {_ai} to {_id}

    spawn fake text display entity at islandAICastDisplayLocation({_ai}) for {_partyMembers::*} with id {_id}

    set {_bar} to islandAICastBar({_progress})
    set {_text} to mini message from "<#ffb347>%{_ability}%<newline>%{_bar}%"

    set {_packet} to new metadata packet with id {_id}:
        display text: {_text}
        display billboard: center
        display brightness block: 15
        display brightness sky: 15
        display seethrough: true
    send packet {_packet} to {_partyMembers::*}

function islandAIClearCastDisplay(ai: entity):
    wait 1 tick
    set {_id} to metadata value "IslandAICastDisplayId" of {_ai}
    if {_id} is set:
        set {_partyMembers::*} to all players in world "%{_ai}'s world%"
        remove fake entity with id {_id} for {_partyMembers::*}
    clear metadata value "IslandAICastDisplayId" of {_ai}

function islandAICancelCast(ai: entity):
    islandAIClearCastDisplay({_ai})
    clear metadata value "IslandAICasting" of {_ai}
    clear metadata value "IslandAIQueuedSpell" of {_ai}
    clear metadata value "IslandAICastingStarted" of {_ai}

function islandAIAbilityNumber(ai: entity, ability: string, key: string, defaultValue: number) :: number:
    set {_class} to metadata value "IslandAIClass" of {_ai}
    set {_value} to yaml value "Classes.%{_class}%.Abilities.%{_ability}%.%{_key}%" in "IslandAITeams"
    if {_value} is not set:
        return {_defaultValue}
    return {_value}

function islandAIUseAbility(ai: entity, target: entity, ability: string, surge: boolean = false):
    if metadata value "IslandExpeditionEnded" of world of {_ai} is set:
        stop
    if {_ai} is not alive:
        stop
    if {_target} is not alive:
        stop

    set {_class} to metadata value "IslandAIClass" of {_ai}
    if {_class} is not set:
        stop

    set metadata value "IslandAICasting" of {_ai} to true
    set metadata value "IslandAIQueuedSpell" of {_ai} to {_ability}
    set metadata value "IslandAICastingStarted" of {_ai} to now

    if {_surge} is not true:
        set {_castTime} to yaml value "Classes.%{_class}%.Abilities.%{_ability}%.Cast Time" in "IslandAITeams"
        if {_castTime} is not set:
            if {_ability} = "Lava Burst":
                set {_castTime} to 2
            else if {_ability} = "Lava Bolt":
                set {_castTime} to 1.2
        if {_castTime} is set:
            if {_ability} = "Lava Burst":
                play sound "skill.ghazan.lava_burst_precast" with volume 2 and pitch 1 at {_ai}
            else if {_ability} contains "Lava":
                play sound "entity.blaze.shoot" with volume 2 and pitch 0.7 at {_ai}
            set {_castTime} to "%{_castTime}% seconds" parsed as timespan
            set {_ticks} to "%{_castTime}%"
            replace all " seconds" and " second" in {_ticks} with ""
            set {_ticks} to ({_ticks} parsed as number) * 10
            islandAICastDisplay({_ai}, {_ability}, 0)

            loop {_ticks} times:
                if metadata value "IslandExpeditionEnded" of world of {_ai} is set:
                    islandAICancelCast({_ai})
                    stop
                if {_ai} is not alive:
                    islandAICancelCast({_ai})
                    stop
                if {_target} is not alive:
                    islandAICancelCast({_ai})
                    stop
                if distance between {_ai} and {_target} > 28:
                    islandAICancelCast({_ai})
                    stop
                if metadata value "IslandAICasting" of {_ai} is not set:
                    stop
                clear target of {_ai}
                set {_progress} to round((loop-number / {_ticks}) * 10, 0)
                islandAICastDisplay({_ai}, {_ability}, {_progress})
                draw 6 of flame particle with extra value 0.02 with offset vector(0.25, 0.45, 0.25) at location 1.5 above {_ai}
                wait 0.1 seconds

    if {_ability} = "Molten Lava":
        GhazanAIMoltenLava({_ai}, {_target})
    else if {_ability} = "Lava Burst":
        GhazanAILavaBurst({_ai}, {_target}, {_surge})

    else if {_ability} = "Lava Bolt":
        islandAIEmberLavaBolt({_ai}, {_target})
    else if {_ability} = "Lava Ball":
        islandAIEmberLavaBolt({_ai}, {_target})
    else if {_ability} = "Lava Meteor":
        islandAIEmberLavaBolt({_ai}, {_target})
    else if {_ability} = "Meteor":
        islandAIEmberLavaBolt({_ai}, {_target})
    else if {_ability} = "Ember Meteor":
        islandAIEmberLavaBolt({_ai}, {_target})

    if {_surge} is not true:
        set {_cooldown} to yaml value "Classes.%{_class}%.Abilities.%{_ability}%.Cooldown" in "IslandAITeams"
        if {_cooldown} is not set:
            if {_ability} = "Lava Burst":
                set {_cooldown} to 8
            else if {_ability} = "Lava Bolt":
                set {_cooldown} to 8
            else if {_ability} = "Lava Ball":
                set {_cooldown} to 8
            else if {_ability} = "Lava Meteor":
                set {_cooldown} to 8
            else if {_ability} = "Meteor":
                set {_cooldown} to 8
            else if {_ability} = "Ember Meteor":
                set {_cooldown} to 8
            else:
                set {_cooldown} to 5
        create cooldown "IslandAI%uuid of {_ai}%%{_ability}%" for "%{_cooldown}% seconds" parsed as timespan

    clear target of {_ai}
    islandAICancelCast({_ai})

function islandAIEmberLavaBolt(ai: entity, target: entity):
    if metadata value "IslandExpeditionEnded" of world of {_ai} is set:
        stop
    set {_impact} to location of {_target}
    set {_sky} to location 8 above {_impact}
    play sound "entity.blaze.shoot" with volume 3 and pitch 0.8 at {_ai}
    draw 20 of falling lava particle with extra value 0.04 with offset vector(1.2, 0.2, 1.2) at {_sky}
    wait 0.35 seconds
    set {_shape} to a line from {_sky} to {_impact}
    set particle of {_shape} to lava particle
    draw shape {_shape} at {_sky} ~ {_impact}
    draw 20 of lava particle with extra value 0.03 with offset vector(0.8, 0.25, 0.8) at {_impact}
    draw 12 of flame particle with extra value 0.04 with offset vector(0.7, 0.35, 0.7) at {_impact}
    play sound "block.lava.pop" with volume 3 and pitch 0.7 at {_impact}
    loop all entities in radius 2 around {_impact}:
        if loop-entity != {_ai}:
            if metadata value "IslandExpeditionInstance" of loop-entity = metadata value "IslandExpeditionInstance" of {_ai}:
                if loop-entity is a player:
                    set {_damage} to islandAIAbilityNumber({_ai}, "Lava Bolt", "Player Damage", 16)
                    set metadata value "LastDamageCause" of loop-entity to "<#b03228>Lava Bolt"
                    make {_ai} damage loop-entity by {_damage}
                else if metadata value "IslandEnemy" of loop-entity is true:
                    set {_damage} to islandAIAbilityNumber({_ai}, "Lava Bolt", "Damage", 32)
                    set metadata value "LastDamageCause" of loop-entity to "<#b03228>Lava Bolt"
                    make {_ai} damage loop-entity by {_damage}

function GhazanAILavaTechnique(ai: entity, target: entity):
    set {_key} to "IslandAILavaTechnique%uuid of {_ai}%"
    set metadata value "%{_key}%Duration" of {_target} to 16 seconds

    if metadata value "%{_key}%Stacks" of {_target} is not set:
        set metadata value "%{_key}%Stacks" of {_target} to 0

    set {_stacks} to metadata value "%{_key}%Stacks" of {_target}
    if {_stacks} < 10:
        set metadata value "%{_key}%Stacks" of {_target} to {_stacks} + 1

    if metadata value "%{_key}%Active" of {_target} is not set:
        set metadata value "%{_key}%Active" of {_target} to true
        while metadata value "%{_key}%Duration" of {_target} > 0 seconds:
            wait 1 second
            remove 1 second from metadata value "%{_key}%Duration" of {_target}
            if {_target} is not alive:
                clear metadata value "%{_key}%Stacks" of {_target}
                clear metadata value "%{_key}%Duration" of {_target}
                clear metadata value "%{_key}%Active" of {_target}
                stop
        clear metadata value "%{_key}%Stacks" of {_target}
        clear metadata value "%{_key}%Duration" of {_target}
        clear metadata value "%{_key}%Active" of {_target}

function GhazanAILavaTechniqueMultiplier(ai: entity, target: entity) :: number:
    set {_key} to "IslandAILavaTechnique%uuid of {_ai}%"
    set {_stacks} to metadata value "%{_key}%Stacks" of {_target}
    if {_stacks} is not set:
        set {_stacks} to 0
    return 1 + ({_stacks} * 0.05)

function GhazanAILavaBurst(ai: entity, target: entity, surge: boolean = false):
    set {_damage} to islandAIAbilityNumber({_ai}, "Lava Burst", "Damage", 55)
    set {_damage} to {_damage} * GhazanAILavaTechniqueMultiplier({_ai}, {_target})

    if metadata value "IslandAIMoltenLava%uuid of {_ai}%" of block under {_target} is set:
        set {_damage} to {_damage} * 1.35

    GhazanAILavaTechnique({_ai}, {_target})

    set {_loc} to location 1.5 above {_ai}
    set {_targetLoc} to location 1 above {_target}
    set {_shape} to a line from {_loc} to {_targetLoc}
    set particle of {_shape} to lava particle
    draw shape {_shape} at {_loc} ~ {_targetLoc}

    play sound "skill.ghazan.lava_burst_cast" with volume 3 and pitch 1 at {_ai}
    wait 0.25 seconds
    play sound "skill.ghazan.lava_burst_impact" with volume 3 and pitch 1 at {_target}

    draw 20 of lava particle with extra value 0.02 with offset vector(0.4, 0.6, 0.4) at {_targetLoc}
    draw 12 of flame particle with extra value 0.04 with offset vector(0.5, 0.5, 0.5) at {_targetLoc}

    set {_target}'s last damage cause to sweep attack
    set metadata value "LastDamageCause" of {_target} to "<#b03228>Lava Burst"
    set metadata value "Element" of {_ai} to "Lava"
    make {_ai} damage {_target} by {_damage}

function GhazanAIMoltenLava(ai: entity, target: entity):
    set {_center} to block under {_target}
    if {_center} is not solid:
        set {_center} to block under {_center}

    play sound "block.lava.ambient" with volume 4 and pitch 1 at location of {_center}
    play sound "block.lava.extinguish" with volume 4 and pitch 1.25 at location of {_center}

    loop all blocks in radius 2 around {_center}:
        if loop-block is solid:
            if y of loop-block >= y of {_center}:
                if metadata value "IslandAIMoltenLava%uuid of {_ai}%" of loop-block is not set:
                    if metadata value "IslandAIMoltenLava" of loop-block is not set:
                        set metadata value "IslandAIMoltenLava" of loop-block to 0
                    set metadata value "IslandAIMoltenLava%uuid of {_ai}%" of loop-block to 30 seconds
                    set metadata value "IslandAIMoltenLava" of loop-block to metadata value "IslandAIMoltenLava" of loop-block + 1
                    islandAIMoltenLavaSee({_ai}, location of loop-block)
                    islandAIMoltenLavaTick({_ai}, location of loop-block)
        wait 1 tick if loop-counter is divisible by 4

function islandAIMoltenLavaSee(ai: entity, loc: location):
    loop all players in world of {_ai}:
        if distance between loop-player and {_loc} < 100:
            make loop-player see block at {_loc} as magma block

function islandAILavaSurgeRoll(ai: entity):
    set {_class} to metadata value "IslandAIClass" of {_ai}
    set {_surgeChance} to yaml value "Classes.%{_class}%.Lava Surge Chance" in "IslandAITeams"
    if {_surgeChance} is not set:
        set {_surgeChance} to 4
    if cooldown "IslandAILavaSurge%uuid of {_ai}%" is finished:
        chance of {_surgeChance}%:
            set metadata value "IslandAILavaSurge" of {_ai} to true
            create cooldown "IslandAILavaSurge%uuid of {_ai}%" for 6 seconds

function islandAIMoltenLavaTick(ai: entity, loc: location):
    while metadata value "IslandAIMoltenLava%uuid of {_ai}%" of block at {_loc} > 0 seconds:
        if metadata value "IslandExpeditionEnded" of world of {_ai} is set:
            stop
        wait 1 second
        remove 1 second from metadata value "IslandAIMoltenLava%uuid of {_ai}%" of block at {_loc}

        loop all entities in radius 1.2 around {_loc}:
            if loop-entity is a player:
                if metadata value "IslandExpeditionInstance" of loop-entity = metadata value "IslandExpeditionInstance" of {_ai}:
                    set {_damage} to islandAIAbilityNumber({_ai}, "Molten Lava", "Damage", 18)
                    set metadata value "LastDamageCause" of loop-entity to "<#b03228>Molten Lava"
                    make {_ai} damage loop-entity by {_damage}
                    islandAILavaSurgeRoll({_ai})
            else if metadata value "IslandEnemy" of loop-entity is true:
                if metadata value "IslandExpeditionInstance" of loop-entity = metadata value "IslandExpeditionInstance" of {_ai}:
                    set {_damage} to islandAIAbilityNumber({_ai}, "Molten Lava", "Damage", 18)
                    set metadata value "LastDamageCause" of loop-entity to "<#b03228>Molten Lava"
                    make {_ai} damage loop-entity by {_damage}
                    islandAILavaSurgeRoll({_ai})

        draw 6 of lava particle with extra value 0.02 with offset vector(0.4, 0.15, 0.4) at {_loc}

    clear metadata value "IslandAIMoltenLava%uuid of {_ai}%" of block at {_loc}
    remove 1 from metadata value "IslandAIMoltenLava" of block at {_loc}
    if metadata value "IslandAIMoltenLava" of block at {_loc} <= 0:
        make all players in world of {_ai} see block at {_loc} as block at {_loc}
        clear metadata value "IslandAIMoltenLava" of block at {_loc}

function islandAICoastSpawnLocation(shipLoc: location, maxRadius: integer = 80) :: location:
    set {_world} to world of {_shipLoc}
    set {_baseX} to x of {_shipLoc}
    set {_baseZ} to z of {_shipLoc}
    set {_baseY} to y of {_shipLoc}

    set {_whitelistedBlocks::*} to sand, grass block, stone, cobblestone

    loop {_maxRadius} times:
        set {_r} to loop-number

        loop 16 times:
            set {_angle} to loop-number-2 * 22.5
            set {_x} to {_baseX} + cos({_angle}) * {_r}
            set {_z} to {_baseZ} + sin({_angle}) * {_r}

            set {_testLoc} to location({_x}, {_baseY}, {_z}, {_world}, yaw of {_shipLoc}, pitch of {_shipLoc})
            set {_safe} to safeMobSpawnLocation({_testLoc}, 48)

            if {_safe} is set:
                if block below {_safe} is solid:
                    if block at {_safe} is not solid:
                        if block above {_safe} is not solid:
                            if block below {_safe} is not water:
                                if block at {_safe} is not water:
                                    if block above {_safe} is not water:
                                        if {_whitelistedBlocks::*} contains (type of block below {_safe}):
                                            return {_safe}

    return {_shipLoc}

function islandAICancelChannel(ai: entity):
    clear metadata value "IslandAIChannelStarted" of {_ai}
