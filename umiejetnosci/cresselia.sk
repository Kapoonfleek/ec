function CresseliaSpendAstralPower(p: player, amount: number):
	set {_dmg} to offensiveTrait({_p}, "Cresselia", "Lunar Firmament")
	if {_dmg} > 0:
		if metadata value "LunarFirmamentAPSpent%{_p}%" of {_p} is not set:
			set metadata value "LunarFirmamentAPSpent%{_p}%" of {_p} to 0
		set {_spent} to metadata value "LunarFirmamentAPSpent%{_p}%" of {_p}
		set {_spent} to {_spent} + {_amount}
		while {_spent} >= 50:
			set {_spent} to {_spent} - 50
			if metadata value "LunarFirmamentStacks%{_p}%" of {_p} is not set:
				set metadata value "LunarFirmamentStacks%{_p}%" of {_p} to 0
			set metadata value "LunarFirmamentStacks%{_p}%" of {_p} to (metadata value "LunarFirmamentStacks%{_p}%" of {_p} + 1)
		set metadata value "LunarFirmamentAPSpent%{_p}%" of {_p} to {_spent}

function CresseliaAstralPowerGen(p: player, amount: number) :: number:
	if metadata value "SurgingRhythmPrimary" of {_p} is set:
		set {_amount} to {_amount} * 1.3
	return {_amount}
variables:
	{astralpower::%player%} = 50

function ShootingStars(p: player):
	wait 1 tick
	while metadata value "ECEngaged" of {_p} is set:
		if {_p} is alive:
			set {_chance} to 8 + getRunePower({_p}, "Astral Cascade")
			if boolean tag "Constellation;Stellar Command" of (custom nbt of {karta::%{_p}%}) is set:
				set {_chance} to {_chance} + 2
			if metadata value "CelestialAlignment" of {_p} is set:
				set {_chance} to {_chance}*2
			if metadata value "Solstice" of {_p} is set:
				set {_chance} to {_chance}*3
			chance of {_chance}%:
				ShootingStar({_p})
		stop loop if metadata value "ECEngaged" of {_p} is not set
		set {_haste} to Haste({_p})
		set {_wait} to "%1/{_haste}% seconds" parsed as timespan
		wait {_wait}

function ShootingStar(p: player):
	set {_id} to cardId({_p})

	set {_loops} to 1
	set {_astralInvocationChance} to 10
	set {_damage} to (0.8 + (({damage::%{_p}%}/61) + (Versatility({_p})/183) + PrimaryStat({_p})/30.5)) * (1 + (Mastery({_p})/108))
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Crashing Star":
		chance of 15%:
			set {_damage} to (2.4 + (({damage::%{_p}%}/41) + (Versatility({_p})/123) + PrimaryStat({_p})/20.5)) * (1 + (Mastery({_p})/108))
			set {_crashingStar} to true
			set {_astralInvocationChance} to 20
	set {_crit} to 0 + (CriticalHit({_p})/10)
	if metadata value "CelestialAlignment" of {_p} is set:
		set {_crit} to {_crit} + 15
	set {_haste} to Haste({_p})

	if metadata value "CelestialAlignment" of {_p} is set:
		set {_damage} to {_damage}*1.15
		set {_damage} to {_damage}*7

	if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Whirling Stars":
		set {_astralpower} to 3
		set {_damage} to {_damage}*1.09
	else:
		set {_astralpower} to 2
	if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Stellar Collision":
		set {_damage} to {_damage}*1.15
		chance of 20%:
			set {_loops} to 2

	if {_crashingStar} is true:
		set {_astralpower} to {_astralpower}*2

	set {_world} to world of {_p}

	loop {ECMobs::%{_world}%::*}:
		set {_entity} to loop-value parsed as entity
		set {_entityLoc} to location of {_entity}

		if chunk at {_entityLoc} is loaded:
			if distance between {_p} and {_entity} < 30:
				if boolean tag "ECMob" of (custom nbt of {_entity}) is set:
					if metadata value "ECPulled" of {_entity} is set:
						if metadata value "RecentlyDamagedCresselia%{_p}%" of {_entity} is set:
							set {_enti::*} to {_enti::*} and {_entity}

	set {_primCol} to coloured getPrimaryCardColour({_p})
	set {_secCol} to coloured getSecondaryCardColour({_p})
	
	if size of {_enti::*} > 0:
		set {_target} to a random element of {_enti::*}
		if metadata value "Stellar Command%{_p}%" of {_target} is set:
			set {_damage} to {_damage}*1.3

		set {_chanceShooting} to 8
		if boolean tag "Constellation;Stellar Command" of (custom nbt of {karta::%{_p}%}) is set:
			set {_chanceShooting} to {_chanceShooting} + 2
		if metadata value "CelestialAlignment" of {_p} is set:
			set {_chanceShooting} to {_chanceShooting}*2
		if metadata value "Solstice" of {_p} is set:
			set {_chanceShooting} to {_chanceShooting}*3

		set {_valueNames::*} to "CHANCE", "DAMAGE", "ASTRALPOWER"
		set {_values::*} to {_chanceShooting}, {_damage}, {_astralpower}
		set {_loreShootingStars} to GetAbilityDescription({_p}, "Cresselia", "Shooting Stars", {_valueNames::*}, {_values::*})
		set {_lore} to {_loreShootingStars}

		if {_crashingStar} is true:
			set {_starSpeed} to 0.2*{_haste}
			set {_damageCause} to "%{_primCol}%Crashing Star"
			set {_shootingStar} to ShootingStarSpawn({_target}, true)
			set {_pitch} to 0.25
			set {_bonusY} to 1.8
			set {_valueNames::*} to "CHANCE", "DAMAGE"
			set {_values::*} to 15, {_damage}
			set {_lore} to GetAbilityDescription({_p}, "Cresselia", "Crashing Star", {_valueNames::*}, {_values::*})
			play sound "entity.ender_dragon.shoot" with volume 4 and pitch 0 at location of {_target}
		else:
			set {_starSpeed} to 0.45*{_haste}
			set {_damageCause} to "%{_primCol}%Shooting Stars"
			set {_shootingStar} to ShootingStarSpawn({_target})
			set {_pitch} to 1.5
			set {_bonusY} to 0.9
			set {_lore} to {_loreShootingStars}
			CresseliaShootingStarSound({_p}, {_target})
			LoreUpdate({_p}, "Shooting Stars", {_lore})

		set {_y} to 0
		set {_locStar} to location of {_shootingStar}
		set {_count} to 0
		while {_shootingStar} is alive:
			set {_targetLoc} to location 0.5 below {_target}
			set {_vec} to vector between {_locStar} and {_targetLoc}
			set {_loc} to location of {_shootingStar}
			add {_bonusY} to y of {_loc}
			if {_crashingStar} is true:
				draw 1 of firework particle at {_loc}
			
			shootingStarsVisual({_p}, {_loc})

			set vector length of {_vec} to {_count} * {_starSpeed}
			teleport {_shootingStar} to {_locStar} ~ {_vec}
			add nbt from "{Rotation:[%{_y}%.0f,%{_y}%.0f]}" to nbt of {_shootingStar}

			if distance between {_shootingStar} and {_target} < 1:
				set {_hit} to true
				stop loop

			wait 1 tick
			set {_count} to {_count} + 1
			set {_y} to {_y} + 10

		kill {_shootingStar}

		stop if {_hit} != true
		
		CresseliaShootingStarHitSound({_p}, {_target}, {_pitch})

		if {_crashingStar} = true:
			draw 25 of (firework particle with an extra value of 0.015) with offset vector(1.25, 0.5, 1.25) at (location above {_target})

		set {_critModifier} to 2
		if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%{_p}%}) is set:
			set {_critModifier} to {_critModifier} + 0.2

		set {_primCol} to coloured getPrimaryCardColour({_p})
		set {_secCol} to coloured getSecondaryCardColour({_p})
		
		loop {_loops} times:
			set {_shootingStarsDamage} to {_damage}
			set {_target}'s last damage cause to sweep attack
			set metadata value "LastDamageCause" of {_target} to {_damageCause}
			set metadata value "LastDamageCauseLore" of {_target} to {_lore}
			set metadata value "Element" of {_p} to "Astral"
			set {_shootingStarsDamage} to Crit({_p}, {_target}, {_crit}, {_shootingStarsDamage}, {_critModifier})
			make {_p} damage {_target} by {_shootingStarsDamage}

			if metadata value "StarfallActive%{_p}%" of {_p} > 0:
				set {_shrapnelDmg} to offensiveTrait({_p}, "Cresselia", "Lunar Shrapnel")
				if {_shrapnelDmg} > 0.000001:
					set {_shrapnelDmgFinal} to Crit({_p}, {_target}, {_crit}, {_shrapnelDmg}, {_critModifier})
					loop LoopEntitiesAroundTarget({_target}, 4, false):
						set (loop-value-2)'s last damage cause to sweep attack
						set metadata value "LastDamageCause" of (loop-value-2) to "%{_primCol}%Lunar Shrapnel"
						set metadata value "LastDamageCauseLore" of loop-value-2 to "Lunar Shrapnel"
						set metadata value "Element" of {_p} to "Astral"
						make {_p} damage (loop-value-2) by {_shrapnelDmgFinal}
						shootingStarsVisual({_p}, (location 0.5 above loop-value-2))


			chance of {_astralInvocationChance}%:
				AstralInvocation({_p})

			if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Astral Communion":
				set {_astralPowerCap} to 120
			else:
				set {_astralPowerCap} to 100

			set {_astralpower} to CresseliaAstralPowerGen({_p}, {_astralpower})
			if {astralpower::%{_p}%} + {_astralpower} <= {_astralPowerCap}:
				set {astralpower::%{_p}%} to {astralpower::%{_p}%} + {_astralpower}
			else:
				set {astralpower::%{_p}%} to {_astralPowerCap}

			AstralPowerUpdate({_p})

			if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Orbit Breaker":
				if metadata value "OrbitBreaker" of {_p} is not set:
					set metadata value "OrbitBreaker" of {_p} to 0

				set {_orbitBreaker} to metadata value "OrbitBreaker" of {_p}
				set {_orbitBreaker} to {_orbitBreaker} + 1
				
				if {_orbitBreaker} >= 30:
					set {_orbitBreaker} to 0
					FullMoon({_p}, {_target})
					broadcast "as"
				set metadata value "OrbitBreaker" of {_p} to {_orbitBreaker}
			wait 1 tick
		clear {_enti::*}
		
function ShootingStarSpawn(target: entity, crashingStar: boolean = false) :: entity:
	set {_randomYcoordinate} to a random number between 8 and 35
	set {_l} to location of block {_randomYcoordinate} blocks above {_target}
	spawn an armor stand at {_l} with nbt from "{Invulnerable:1b,Invisible:1b,NoGravity:1b,Silent:1b,Pose:{Head:[180.0f,0.0f,0.0f]}}"
	set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true
	if {_crashingStar} = true:
		modelApply(last spawned armor stand, "shootingstar", 4.0)
	else:
		modelApply(last spawned armor stand, "shootingstar", 1.25)
	set {_shootingStar} to last spawned armor stand
	ShootingStarKill({_shootingStar})
	return {_shootingStar}

function ShootingStarKill(e: entity):
	wait 20 seconds
	kill {_e}

function AstralPower(p: player):
	wait 1 tick
	set {_pospiech} to Haste({_p})
	set {_wait} to "%3/{_pospiech}% seconds" parsed as timespan
	set {_astralPowerCap} to 100
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Astral Communion":
		set {_astralPowerCap} to 120
	while metadata value "ECEngaged" of {_p} is set:
		if {_p} is alive:
			set {_astralpower} to 2 * (1 + getRunePower({_p}, "Astral Flow") / 100)

			set {_astralpower} to CresseliaAstralPowerGen({_p}, {_astralpower})
			if {astralpower::%{_p}%} + {_astralpower} <= {_astralPowerCap}:
				set {astralpower::%{_p}%} to {astralpower::%{_p}%} + {_astralpower}
			else:
				set {astralpower::%{_p}%} to {_astralPowerCap}
			AstralPowerUpdate({_p})
		stop loop if metadata value "ECEngaged" of {_p} is not set
		wait {_wait}

function AstralPowerUpdate(p: player):
	set {_primCol} to coloured getPrimaryCardColour({_p})
	set {_secCol} to coloured getSecondaryCardColour({_p})
	set {_APIcon} to getCardIcon({_p}, "Astral Power")
	set {_CAIcon} to getCardIcon({_p}, "Celestial Alignment")

	if metadata value "casting" of {_p} is not set:
		set {_message} to "&f%{_APIcon}% %{_primCol}%%rounded down {astralpower::%{_p}%}%"
		if metadata value "CelestialAlignment" of {_p} is set:
			set {_remainingCADuration} to durationShort("%metadata value "CelestialAlignment" of {_p}%")
			set {_message} to "%{_message}% &f| %{_CAIcon}% %{_primCol}%CA: &f%{_remainingCADuration}%"
		send action bar {_message} to {_p}
	
	set {_apGen} to 3/Haste({_p})
	set {_ap} to 2 * (1 + getRunePower({_p}, "Astral Flow") / 100)
	set {_invocChance} to 10

	set {_valueNames::*} to "APGEN", "AP", "INVOCATIONCHANCE"
	set {_values::*} to {_apGen}, {_ap}, {_invocChance}
	set {_lore} to GetAbilityDescription({_p}, "Cresselia", "Boundless Moonlight", {_valueNames::*}, {_values::*})
	LoreUpdate({_p}, "Boundless Moonlight", {_lore})

function AstralPowerAdd(p: player, astralPower: number):
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Astral Communion":
		set {_astralPowerCap} to 120
	else:
		set {_astralPowerCap} to 100
	set {_astralPower} to CresseliaAstralPowerGen({_p}, {_astralPower})
	if {astralpower::%{_p}%} + {_astralPower} <= {_astralPowerCap}:
		set {astralpower::%{_p}%} to {astralpower::%{_p}%} + {_astralPower}
	else:
		set {astralpower::%{_p}%} to {_astralPowerCap}

on rightclick:
	if player's tool is magenta dye:
		if boolean tag "Starsurge" of (custom nbt of player's tool) is set:
			if {kartaname::%player%} = "Cresselia":
				set {_target} to Target(player, 100, false)
				if {_target} is set:
					if CanUseAbility(player) != false:
						set {_primCol} to coloured getPrimaryCardColour(player)
						set {_secCol} to coloured getSecondaryCardColour(player)
						if metadata value "casting" of player is not set:
							if cooldown "StarsurgeDoublecast%player%" is finished:
								create cooldown "StarsurgeDoublecast%player%" for 1 tick
								
								set {_astralPowerCost} to 30
								if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Astral Communion":
									if metadata value "CelestialAlignment" of player is set:
										set {_astralPowerCost} to 20

								set {_damage} to 5.5 + ({damage::%player%}/12) + (Versatility(player)/36) + (PrimaryStat(player)/6)

								if boolean tag "Constellation;Rattle the Stars" of (custom nbt of {karta::%player%}) is set:
									set {_astralPowerCost} to {_astralPowerCost}*0.9
									set {_damage} to {_damage}*1.08
								
								if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Starweaver":
									if metadata value "Starweaver" of player = "Starsurge":

										set {_astralPowerCost} to 0

										clear metadata value "Starweaver" of player
										loop all items in the inventory of player:
											if boolean tag "Starsurge" of (custom nbt of loop-item) is set:
												set item amount of loop-item to 1

								if ({astralpower::%player%} >= {_astralPowerCost}):
									set {astralpower::%player%} to {astralpower::%player%} - {_astralPowerCost}
									CresseliaSpendAstralPower(player, {_astralPowerCost})

									AstralPowerUpdate(player)
									AbilityUse(player, "Starsurge")
									CresseliaCosmicRipple(player)
									CresseliaStreakingStars(player, {_target}, "Starsurge")
									
									CresseliaStarsurgeCastSound(player)

									if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Primordial Arcanic Pulsar":
										PrimordialArcanicPulsar(player, {_astralPowerCost})

									set {_crit} to 0 + (CriticalHit(player)/10)
									if metadata value "CelestialAlignment" of player is set:
										set {_damage} to {_damage}*1.15
										set {_crit} to {_crit} + 15
									if metadata value "UmbralInspiration" of player is set:
										set {_damage} to {_damage}*1.3

									if boolean tag "Constellation;Starlord" of (custom nbt of {karta::%player%}) is set:
										Starlord(player)

									if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Aetherial Kindling":
										if metadata value "CelestialAlignment" of player is set:
											if metadata value "AetherialKindlingExtension" of player is not set:
												set metadata value "AetherialKindlingExtension" of player to 0

											set {_currentExtension} to metadata value "AetherialKindlingExtension" of player
											set {_add} to 3

											if {_currentExtension} + {_add} > 15:
												set {_add} to 15 - {_currentExtension}

											set {_addSeconds} to "%{_add}% seconds" parsed as timespan

											if {_add} > 0:
												set metadata value "AetherialKindlingExtension" of player to ({_currentExtension} + {_add})
												set metadata value "CelestialAlignment" of player to (metadata value "CelestialAlignment" of player + {_addSeconds})

									else if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Starweaver":
										chance of 20%:
											set metadata value "Starweaver" of player to "Starfall"
											loop all items in the inventory of player:
												if boolean tag "Starfall" of (custom nbt of loop-item) is set:
													set item amount of loop-item to 2

									CresseliaStarsurgeVisual(player, {_target})

									set {_starsurgeBonusMax} to 2
									if boolean tag "Constellation;Stellar Amplification" of (custom nbt of {karta::%player%}) is set:
										set {_starsurgeBonusMax} to 4

									if metadata value "StarsurgeStacks%player%" of {_target} is not set:
										set metadata value "StarsurgeStacks%player%" of {_target} to 0

									set {_starsurgeStacks} to metadata value "StarsurgeStacks%player%" of {_target}

									set {_starsurgeMultiplier} to (0.15 + getRunePower(player, "Stellar Compression")) + (0.25 * (Haste(player) - 1))

									set {_starsurgeBonus} to 1+({_starsurgeMultiplier}*{_starsurgeStacks})
									set {_damage} to {_damage}*{_starsurgeBonus}

									if metadata value "StarsurgeStacks%player%" of {_target} < {_starsurgeBonusMax}:
										set metadata value "StarsurgeStacks%player%" of {_target} to (metadata value "StarsurgeStacks%player%" of {_target} + 1)

									set metadata value "StarsurgeTime%player%" of {_target} to 12 seconds
									if metadata value "StarsurgeBonus%player%" of {_target} is not set:
										set metadata value "StarsurgeBonus%player%" of {_target} to true
										StarsurgeBonus(player, {_target})
								
									if boolean tag "Constellation;Stellar Command" of (custom nbt of {karta::%player%}) is set:
										StellarCommand(player, {_target})

									set {_critModifier} to 2
									if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%player%}) is set:
										set {_critModifier} to {_critModifier} + 0.2
									
									set {_target}'s last damage cause to sweep attack
									
									set {_valueNames::*} to "COST", "DAMAGE", "AMP", "MAXSTACKS"
									set {_values::*} to {_astralPowerCost}, {_damage}, ({_starsurgeMultiplier}*100), {_starsurgeBonusMax}
									set {_lore} to GetAbilityDescription(player, "Cresselia", "Starsurge", {_valueNames::*}, {_values::*})

									set metadata value "LastDamageCause" of {_target} to "%{_primCol}%Starsurge"
									set metadata value "LastDamageCauseLore" of {_target} to {_lore}
									
									set metadata value "Element" of player to "Astral"
									set {_damage} to Crit(player, {_target}, {_crit}, {_damage}, {_critModifier})
									make player damage {_target} by {_damage}

									CresseliaRecentlyDamaged(player, {_target})

									CresseliaStarsurgeImpactSound(player, {_target})

									LoreUpdate(player, "Starsurge", {_lore})
								else:
									if {tekstcd::%player%} = true:
										send action bar "%{_primCol}%You must have at least %{_astralPowerCost}% Astral Power to use this ability." to player
										play sound "entity.villager.no" with volume 3 and pitch 1 to player

			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if player's tool is purple dye:
		if boolean tag "Starfall" of (custom nbt of player's tool) is set:
			if {kartaname::%player%} = "Cresselia":
				if CanUseAbility(player) != false:
					if metadata value "casting" of player is not set:
						if cooldown "StarfallDoublecast%player%" is finished:
							create cooldown "StarfallDoublecast%player%" for 1 tick

							set {_astralPowerCost} to 50
							if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Astral Communion":
								if metadata value "CelestialAlignment" of player is set:
									set {_astralPowerCost} to 40

							if boolean tag "Constellation;Rattle the Stars" of (custom nbt of {karta::%player%}) is set:
								set {_astralPowerCost} to {_astralPowerCost}*0.9

							if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Starweaver":
								if metadata value "Starweaver" of player = "Starfall":
									clear metadata value "Starweaver" of player

									set {_astralPowerCost} to 0

									loop all items in the inventory of player:
										if boolean tag "Starfall" of (custom nbt of loop-item) is set:
											set item amount of loop-item to 1

							if ({astralpower::%player%} >= {_astralPowerCost}):
								set {astralpower::%player%} to {astralpower::%player%} - {_astralPowerCost}
								CresseliaSpendAstralPower(player, {_astralPowerCost})
								
								AstralPowerUpdate(player)
								AbilityUse(player, "Starfall")
								set {_lastDamagedTarget} to (metadata value "MostRecentlyDamagedEnemy" of player)
								CresseliaStreakingStars(player, {_lastDamagedTarget}, "Starfall")
								CresseliaStarfallSound(player)

								Starfall(player, 1, {_astralPowerCost})

							else:
								if {tekstcd::%player%} = true:
									send action bar "%{_primCol}%You must have at least %{_astralPowerCost}% Astral Power to use this ability." to player
									play sound "entity.villager.no" with volume 3 and pitch 1 to player
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if player's tool = white dye:
		if boolean tag "Starfire" of (custom nbt of player's tool) is set:
			if {kartaname::%player%} = "Cresselia":
				set {_target} to Target(player, 100, false)
				if {_target} is set:
					set {_primCol} to coloured getPrimaryCardColour(player)
					set {_secCol} to coloured getSecondaryCardColour(player)
					if CanUseAbility(player) != false:
						if metadata value "AstralInvocation" of player is not set:
							if cooldown "Global Cooldown Interrupted Cast%player%" is finished:
								set {_pospiech} to Haste(player)
								set {_baseCastTime} to 2.25
								if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%player%}) is set:
									if metadata value "CelestialAlignment" of player is set:
										set {_baseCastTime} to {_baseCastTime} - 0.25

								set {_dh} to statTrait(player, "Cresselia", "Dawning Horizon")
								if {_dh} > 0:
									set {_baseCastTime} to {_baseCastTime} * 0.85

								if metadata value "AstronomicalImpact" of player is set:
									set {_astronomicalImpact} to true
									set {_baseCastTime} to {_baseCastTime}/1.6

								set {_casttime} to "%round(({_baseCastTime}/{_pospiech}), 1)% seconds" parsed as timespan
								if metadata value "cast" of player is not set:
									set metadata value "casttimemax" of player to {_casttime}

									CresseliaStarfirePrecastSound(player)
									
									set metadata value "casting" of player to true
									if metadata value "channeling" of player is set:
										clear metadata value "channeling" of player
									set metadata value "cast" of player to {_casttime}
									while metadata value "casting" of player = true:
										if metadata value "cast" of player is not set:
											clear metadata value "casting" of player
											stop
										if {_casttime} > 0 seconds:
											set {_cst} to "%{_casttime}%"

											set {_APIcon} to getCardIcon(player, "Astral Power")
											set {_CAIcon} to getCardIcon(player, "Celestial Alignment")

											set metadata value "casttimeleft" of player to {_casttime}
											set {_message} to "Casting... %{_cst}% | &f%{_APIcon}% %{_primCol}%%rounded down {astralpower::%player%}%"
											if metadata value "CelestialAlignment" of player is set:
												set {_remainingCADuration} to durationShort("%metadata value "CelestialAlignment" of player%")
												set {_message} to "%{_message}% &f| %{_CAIcon}% %{_primCol}%CA: &f%{_remainingCADuration}%"

											send action bar {_message} to player
											wait 0.1 seconds
											remove 0.1 seconds from {_casttime}
										else:
											clear metadata value "casting" of player
											send action bar "" to player
								else:
									stop
								clear metadata value "casting" of player
								clear metadata value "cast" of player
								clear metadata value "casttimeleft" of player
								clear metadata value "casttimemax" of player

								CresseliaStarfirePrecastSoundStop(player)
								
								if {_casttime} > 0 seconds:
									send action bar "&cInterrupted" to player
									stop

								if metadata value "AstronomicalImpact" of player is set:
									set {_astronomicalImpact} to true
									remove 1 from metadata value "AstronomicalImpact" of player
									if metadata value "AstronomicalImpact" of player <= 0:
										clear metadata value "AstronomicalImpact" of player

								if {_astronomicalImpact} = true:
									Starfire(player, {_target}, true)
								else:
									Starfire(player, {_target})

								AbilityUse(player, "Starfire")
								CresseliaStreakingStars(player, {_target}, "Starfire")

							else:
								if {tekstcd::%player%} = true:
									set {_cdd} to cooldown "Global Cooldown Interrupted Cast%player%"
									send "%{_primCol}%You must wait &f%{_cdd}%%{_primCol}% to use this ability." to player
								stop
						else:
							if metadata value "casting" of player is not set:
								if cooldown "StarfireDoublecast%player%" is finished:
									create cooldown "StarfireDoublecast%player%" for 1 tick

									if metadata value "AstronomicalImpact" of player is set:
										set {_astronomicalImpact} to true
										remove 1 from metadata value "AstronomicalImpact" of player
										if metadata value "AstronomicalImpact" of player <= 0:
											clear metadata value "AstronomicalImpact" of player

									if {_astronomicalImpact} = true:
										Starfire(player, {_target}, true)
									else:
										Starfire(player, {_target})

									AbilityUse(player, "Starfire")
									CresseliaStreakingStars(player, {_target}, "Starfire")
									
									clear metadata value "AstralInvocation" of player
									clear metadata value "AstralInvocationUUID" of player
									send title " " with subtitle " " to player for 1 tick with fade in 0.0 second and fade out 0.0 second
									if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) = "Umbral Inspiration":
										UmbralInspiration(player)
					else:
						send action bar "%{_primCol}%You can not use this ability right now." to player
						play sound "entity.villager.no" with volume 3 and pitch 1 to player
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player
	else if player's tool is light blue dye:
		if boolean tag "Celestial Alignment" of (custom nbt of player's tool) is set:
			set {_primCol} to coloured getPrimaryCardColour(player)
			set {_secCol} to coloured getSecondaryCardColour(player)
			if cooldown "Celestial Alignment%player%" is finished:
				if metadata value "casting" of player is not set:
					set {_cd} to 3 minutes
					if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%player%}) is set:
						set {_cd} to {_cd} - 30 seconds
					create cooldown "Celestial Alignment%player%" for {_cd}
					set the cooldown of player's held item for player to {_cd}

					CresseliaCelestialAlignmentCastSound(player)
					AbilityUse(player, "Celestial Alignment")
					CelestialAlignment(player, 20 seconds)

					set {_astralPower} to 40

					AstralPowerAdd(player, {_astralPower})
					AstralPowerUpdate(player)

					celestialAlignmentVisual(player)

					set {_valueNames::*} to "COOLDOWN", "ASTRALPOWER", "CRIT", "DURATION", "SHOOTINGSTARSFREQUENCY", "SHOOTINGSTARSDAMAGE"
					set {_values::*} to {_cd}, 40, 15, 20, 100, 600
					set {_lore} to GetAbilityDescription(player, "Cresselia", "Celestial Alignment", {_valueNames::*}, {_values::*})
					LoreUpdate(player, "Celestial Alignment", {_lore})

			else:
				if {tekstcd::%player%} = true:
					set {_cdd} to cooldown "Celestial Alignment%player%"
					send "%{_primCol}%You must wait &f%{_cdd}%%{_primCol}% to use this ability." to player
				stop

	else if player's tool is blue dye:
		if boolean tag "Innervate" of (custom nbt of player's tool) is set:
			set {_primCol} to coloured getPrimaryCardColour(player)
			set {_secCol} to coloured getSecondaryCardColour(player)
			if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Innervate":
				if {kartaname::%player%} = "Cresselia":
					if cooldown "Innervate%player%" is finished:
						if CanUseAbility(player) != false:
							set {_cd} to 3 minutes
							create cooldown "Innervate%player%" for {_cd}
							set the cooldown of player's held item for player to {_cd}

							set {_target} to FriendlyTarget(player, 100, false, true)
							AbilityUse(player, "Innervate")
							CresseliaSurgingRhythm(player)
							if {_target} != player:
								set {_cdReduction} to 40 seconds
								set {_lastusedability} to metadata value "lastspell" of {_target}

								if cooldown "%{_lastusedability}%%{_target}%" is not finished:
									remove {_cdReduction} from cooldown "%{_lastusedability}%%{_target}%"
									send "&f Innervate %{_primCol}%lowered the cooldown of your &f%{_lastusedability}% %{_primCol}%by &f %{_cdreduction}%%{_primCol}%!" to {_target}
									play sound "skill.cresselia.innervate_cast" with volume 2 and pitch 1 to {_target}
									play sound "block.beacon.power_select" with volume 2 and pitch 2 to {_target}
									loop all items in the inventory of {_target}:
										if boolean tag {_lastusedability} of (custom nbt of loop-item) is set:
											set the cooldown of loop-item for {_target} to cooldown "%{_lastusedability}%%{_target}%"
								else:
									set {_useOnSelf} to true
							else:
								set {_useOnSelf} to true

							if {_useOnSelf} = true:
								if cooldown "Celestial Alignment%player%" is not finished:
									set {_cdReduction} to 30 seconds
									remove {_cdReduction} from cooldown "Celestial Alignment%player%"

									send "&f Innervate %{_primCol}%lowered the cooldown of your &fCelestial Alignment %{_primCol}%by &f %{_cdReduction}%%{_primCol}%!" to player

								loop all items in the inventory of player:
									if boolean tag "Celestial Alignment" of (custom nbt of loop-item) is set:
										set the cooldown of loop-item for player to cooldown "Celestial Alignment%player%"
								
							play sound "skill.cresselia.innervate_cast" with volume 2 and pitch 1 to player
							play sound "block.beacon.power_select" with volume 2 and pitch 2 to player	

							set {_astralPower} to 100

							AstralPowerAdd(player, {_astralPower})
							AstralPowerUpdate(player)

							set {_valueNames::*} to "COOLDOWN", "ALLYCDREDUCTION", "SELFCDREDUCTION", "ASTRALPOWER"
							set {_values::*} to {_cd}, 40, 30, 100
							set {_lore} to GetAbilityDescription(player, "Cresselia", "Innervate", {_valueNames::*}, {_values::*})
							LoreUpdate(player, "Innervate", {_lore})
					else: 
						cancel event
						if {tekstcd::%player%} = true:
							set {_cdd} to cooldown "Innervate%player%"
							send "%{_primCol}%You must wait &f%{_cdd}%%{_primCol}% to use this ability." to player
						stop
				else:
					send "&8[&6Earthcraft&8] &6You don't have the required talent to use this ability." to player
					play sound "block.glass.break" with volume 3 and pitch 0 to player
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player

function Starfire(p: player, target: entity, astronomicalImpact: boolean = false):
	CresseliaStarfireCastSound({_p})

	set {_astralPower} to 8
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Astral Communion":
		set {_astralPowerCap} to 120
	else:
		set {_astralPowerCap} to 100

	set {_enemies::*} to LoopEntitiesAroundTarget({_target}, 5, true)

	set {_primCol} to coloured getPrimaryCardColour({_p})
	set {_secCol} to coloured getSecondaryCardColour({_p})

	if boolean tag "Constellation;Soul of the Cosmos" of (custom nbt of {karta::%{_p}%}) is set:
		if metadata value "CelestialAlignment" of {_p} is set:

			set {_extraTargets} to size of {_enemies::*} - 1

			if {_extraTargets} < 0:
				set {_extraTargets} to 0

			if {_extraTargets} > 3:
				set {_extraTargets} to 3

			set {_soulOfTheCosmos} to 1 + (0.2 * {_extraTargets})
			set {_astralPower} to {_astralPower} * {_soulOfTheCosmos}

	set {_astralPower} to CresseliaAstralPowerGen({_p}, {_astralPower})
	if {astralpower::%{_p}%} + {_astralPower} <= {_astralPowerCap}:
		set {astralpower::%{_p}%} to {astralpower::%{_p}%} + {_astralPower}
	else:
		set {astralpower::%{_p}%} to {_astralPowerCap}
	AstralPowerUpdate({_p})
	
	set {_baseCastTime} to 2.25
	
	if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%{_p}%}) is set:
		if metadata value "CelestialAlignment" of {_p} is set:
			set {_baseCastTime} to {_baseCastTime} - 0.25

	set {_dh} to statTrait({_p}, "Cresselia", "Dawning Horizon")
	if {_dh} > 0:
		set {_baseCastTime} to {_baseCastTime} * 0.85

	set {_haste} to Haste({_p})
	if metadata value "AstronomicalImpact" of {_p} is set:
		set {_baseCastTime} to {_baseCastTime}/1.6
	set {_casttime} to "%round(({_baseCastTime}/{_haste}), 1)% seconds" parsed as timespan

	set {_critModifier} to 2
	if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%{_p}%}) is set:
		set {_critModifier} to {_critModifier} + 0.2

	set {_damageAoeMod} to 0.6

	loop {_enemies::*}:
		set {_damage} to 1.5 + (({damage::%{_p}%}/30) + (Versatility({_p})/90) + PrimaryStat({_p})/15)
		set {_crit} to 0 + (CriticalHit({_p})/10)
		if metadata value "CelestialAlignment" of {_p} is set:
			if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Aetherial Kindling":
				set {_damage} to {_damage}*1.15
			set {_crit} to {_crit} + 15

		if {_astronomicalImpact} = true:
			set {_damage} to {_damage}*1.6

		if {_soulOfTheCosmos} is set:
			set {_damage} to {_damage}*{_soulOfTheCosmos}
		set {_damageMainTarget} to {_damage}
		if loop-value != {_target}:
			set {_damage} to {_damage}*{_damageAoeMod}
			if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Aetherial Kindling":
				if metadata value "CelestialAlignment" of {_p} is set:
					set {_damage} to {_damage}*1.3

			StarfireVisual({_p}, loop-value)
		else:
			StarfireVisual({_p}, loop-value, true)
		
		set {_valueNames::*} to "CASTTIME", "DAMAGE", "AOEDAMAGE"
		set {_values::*} to ({_baseCastTime}/Haste({_p})), {_damageMainTarget}, ({_damageAoeMod}*{_damage})
		set {_lore} to GetAbilityDescription({_p}, "Cresselia", "Starfire", {_valueNames::*}, {_values::*})

		set loop-value's last damage cause to sweep attack
		set metadata value "LastDamageCause" of loop-value to "%{_primCol}%Starfire"
		set metadata value "LastDamageCauseLore" of loop-value to {_lore}
		set metadata value "Element" of {_p} to "Astral"
		set {_damageBeforeCrit} to {_damage}
		set {_damage} to Crit({_p}, loop-value, {_crit}, {_damage}, {_critModifier})
		make {_p} damage loop-value by {_damage}

		if {_damage} != {_damageBeforeCrit}:
			CresseliaDawningHorizon({_p})

		LoreUpdate({_p}, "Starfire", {_lore})

function StarfireVisual(p: player, target: entity, mainTarget: boolean = false):
	set {_l} to location 8 above {_target}
	set {_v} to vector between {_l} and {_target}

	set {_variant} to getCurrentVariant({_p}, "Cresselia")
	
	if {_variant} = "Arctic Lights":
		set {_sky} to location 9 above {_target}
		add a random number between -1.5 and 1.5 to x of {_sky}
		add a random number between -1.5 and 1.5 to z of {_sky}

		set {_end} to {_target}'s head
		set {_beamVec} to vector between {_sky} and {_end}
		set {_distance} to distance between {_sky} and {_end}

		set {_outerRing} to a star with 4 points, inner radius 0.75, and outer radius 2.21
		
		set {_particle} to (rgb(0, 255, 180) dust particles of size 1.1 that transitions to rgb(0, 240, 255)) with an extra value of 0.03
		set particle of {_outerRing} to {_particle}
		rotate shape {_outerRing} around x axis by 90 degrees
		rotate shape {_outerRing} around y axis by a random number between 0 and 360 degrees
		rotate shape {_outerRing} around z axis by a random number between 0 and 360 degrees
		draw shape {_outerRing} at {_sky} for 0.75 seconds

		set {_innerRing} to a circle of radius 1.25
		set particle of {_innerRing} to (rgb(0, 240, 255) dust particle of size 0.9 with an extra value of 0.03)
		rotate shape {_innerRing} around x axis by 90 degrees
		rotate shape {_innerRing} around y axis by a random number between 0 and 360 degrees
		draw shape {_innerRing} at {_sky}

		draw 8 of (end rod particle with an extra value of 0.02) with offset vector(0.55, 0.15, 0.55) at {_sky}
		draw 12 of (rgb(50, 255, 80) dust particle of size 1.2 with an extra value of 0.04) with offset vector(0.9, 0.15, 0.9) at {_sky}
		draw 10 of (rgb(252, 43, 120) dust particle of size 0.85 with an extra value of 0.035) with offset vector(0.75, 0.1, 0.75) at {_sky}

		loop 3 times:
			set {_starLoc} to {_sky}
			add a random number between -2.4 and 2.4 to x of {_starLoc}
			add a random number between -0.4 and 0.6 to y of {_starLoc}
			add a random number between -2.4 and 2.4 to z of {_starLoc}

			set {_starShape} to a star with 5 points, inner radius 0.18, and outer radius 0.65

			if loop-number = 1:
				set particle of {_starShape} to (rgb(125, 255, 129) dust particle of size 0.9 with an extra value of 0.04)
			else if loop-number = 2:
				set particle of {_starShape} to (rgb(0, 240, 255) dust particle of size 0.9 with an extra value of 0.04)
			else:
				set particle of {_starShape} to (rgb(252, 43, 120) dust particle of size 0.8 with an extra value of 0.04)

			rotate shape {_starShape} around x axis by a random number between 0 and 360 degrees
			rotate shape {_starShape} around y axis by a random number between 0 and 360 degrees
			rotate shape {_starShape} around z axis by a random number between 0 and 360 degrees
			draw shape {_starShape} at {_starLoc}

			wait 1 tick

		loop round({_distance} / 0.32) times:
			set {_progress} to loop-value / (round({_distance} / 0.32))

			set {_beamVec} to vector between {_sky} and {_end}
			set vector length of {_beamVec} to loop-value * 0.32
			set {_base} to {_sky} ~ {_beamVec}

			set {_swayPower} to (1 - {_progress}) * 0.85
			set {_swayX} to sin(loop-value * 0.7) * {_swayPower}
			set {_swayZ} to cos(loop-value * 0.55) * {_swayPower}

			set {_loc1} to {_base} ~ vector({_swayX}, 0, {_swayZ})
			set {_loc2} to {_base} ~ vector(0 - {_swayX}, 0, 0 - {_swayZ})

			draw 1 of (rgb(255, 255, 255) dust particle of size 0.9 with an extra value of 0.01) with offset vector(0.05, 0.05, 0.05) at {_base}
			draw 1 of (end rod particle with an extra value of 0.01) with offset vector(0.03, 0.03, 0.03) at {_base}

			if {_progress} < 0.22:
				draw 2 of (rgb(50, 255, 80) dust particle of size 1.15 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_loc1}
				draw 1 lime wool item particle with offset random vector at {_loc1}
				draw 1 lime concrete powder item particle with offset random vector at {_loc2}

			else if {_progress} < 0.42:
				draw 2 of (rgb(0, 255, 180) dust particle of size 1.1 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_loc1}
				draw 1 cyan wool item particle with offset random vector at {_loc1}
				draw 1 cyan concrete powder item particle with offset random vector at {_loc2}

			else if {_progress} < 0.62:
				draw 2 of (rgb(0, 240, 255) dust particle of size 1.05 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_loc1}
				draw 1 light blue wool item particle with offset random vector at {_loc1}
				draw 1 light blue concrete powder item particle with offset random vector at {_loc2}

			else if {_progress} < 0.82:
				draw 2 of (rgb(40, 100, 255) dust particle of size 0.95 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_loc1}
				draw 1 blue wool item particle with offset random vector at {_loc1}
				draw 1 blue concrete powder item particle with offset random vector at {_loc2}

			else:
				draw 2 of (rgb(252, 43, 120) dust particle of size 0.85 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_loc1}
				draw 1 magenta wool item particle with offset random vector at {_loc1}
				draw 1 magenta concrete powder item particle with offset random vector at {_loc2}

			if loop-number is divisible by 7:
				set {_tinyStar} to a solid star with 5 points, inner radius 0.25, and outer radius 0.75
				set particle of {_tinyStar} to (rgb(255, 255, 255) dust particle of size 0.7 with an extra value of 0.02)
				rotate shape {_tinyStar} around x axis by a random number between 0 and 360 degrees
				rotate shape {_tinyStar} around y axis by a random number between 0 and 360 degrees
				rotate shape {_tinyStar} around z axis by a random number between 0 and 360 degrees
				draw shape {_tinyStar} at {_base}

		set {_impact} to location 0.8 above {_target}

		if {_mainTarget} = true:
			draw 1 of lime flash particle at {_impact}
			draw 1 of white flash particle at {_impact}

		set {_impactRing} to a circle of radius 1.35
		set particle of {_impactRing} to (rgb(0, 255, 180) dust particle of size 1.1 with an extra value of 0.04)
		rotate shape {_impactRing} around x axis by 90 degrees
		rotate shape {_impactRing} around y axis by a random number between 0 and 360 degrees
		draw shape {_impactRing} at {_impact}

		set {_impactStar} to a star with 5 points, inner radius 0.25, and outer radius 1.15
		set particle of {_impactStar} to (rgb(252, 43, 120) dust particle of size 0.95 with an extra value of 0.05)
		rotate shape {_impactStar} around x axis by a random number between 0 and 360 degrees
		rotate shape {_impactStar} around y axis by a random number between 0 and 360 degrees
		rotate shape {_impactStar} around z axis by a random number between 0 and 360 degrees
		draw shape {_impactStar} at {_impact}

		draw 18 of (rgb(125, 255, 129) dust particle of size 1.2 with an extra value of 0.04) with offset vector(0.9, 0.35, 0.9) at {_impact}
		draw 16 of (rgb(0, 240, 255) dust particle of size 1.1 with an extra value of 0.04) with offset vector(0.8, 0.25, 0.8) at {_impact}
		draw 10 of (rgb(252, 43, 120) dust particle of size 0.9 with an extra value of 0.04) with offset vector(0.7, 0.2, 0.7) at {_impact}

		draw 3 lime wool item particle with offset random vector at {_impact}
		draw 3 cyan wool item particle with offset random vector at {_impact}
		draw 2 light blue wool item particle with offset random vector at {_impact}
		draw 2 magenta wool item particle with offset random vector at {_impact}

	else:
		draw 15 of ((rgb(177, 170, 242) dust particle of size 1) with an extra value of 0.03) with offset vector(0.5, 0.5, 0.5) at (location above {_target})
		loop round(distance between {_l} and {_target}) / 0.45 times:
			set {_v} to vector between {_l} and {_target}'s head
			set vector length of {_v} to loop-value * 0.45
			if {_mainTarget} = true:
				draw 1 of white flash particle at {_l} ~ {_v}
			draw 1 of ((rgb(255, 255, 255) dust particle of size 1) with an extra value of 0.01) with offset vector(0.1, 0.1, 0.1) at ({_l} ~ {_v})
			draw 1 pink wool item particle at {_l} ~ {_v}
			draw 1 of ((rgb(96, 146, 219) dust particle of size 1) with an extra value of 0.01) with offset random vector at ({_l} ~ {_v})
			draw 2 of ((rgb(177, 170, 242) dust particle of size 1) with an extra value of 0.02) with offset vector(0.25, 0.1, 0.25) at ({_l} ~ {_v})
			if loop-number > 14:
				draw 2 of ((rgb(145, 164, 255) dust particle of size 1) with an extra value of 0.06) with offset vector(0.6, 0.25, 0.6) at ({_l} ~ {_v})
				draw 2 of ((rgb(231, 145, 255) dust particle of size 1) with an extra value of 0.06) with offset vector(0.6, 0.25, 0.6) at ({_l} ~ {_v})

function Starfall(p: player, effectiveness: number, astralPowerCost: number = 0):
	if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Primordial Arcanic Pulsar":
		PrimordialArcanicPulsar({_p}, {_astralPowerCost})
	
	set {_astralRain} to "%getRunePower({_p}, "Astral Rain")% seconds" parsed as timespan
	set {_starfallDuration} to 8 seconds + {_astralRain}

	if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Hail of Stars":
		set {_pospiech} to Haste({_p}, 3.6)
		set {_starfallDuration} to {_starfallDuration} + 3 seconds
	else:
		set {_pospiech} to Haste({_p})
	if boolean tag "Constellation;Stellar Amplification" of (custom nbt of {karta::%{_p}%}) is set:
		set {_starfallDuration} to {_starfallDuration} + 3 seconds
		
	set {_wait} to "%1/{_pospiech}% seconds" parsed as timespan
	
	set {_baseStarfallDuration} to 8

	set {_starfallDurationSeconds} to "%{_starfallDuration}%"
	replace all " seconds" and " second" in {_starfallDurationSeconds} with ""
	set {_starfallDurationSeconds} to {_starfallDurationSeconds} parsed as number

	set {_durationScalarStrength} to 0.22
	set {_durationRatio} to {_starfallDurationSeconds} / {_baseStarfallDuration}

	set {_starfallDurationScalar} to 1 / (1 + ({_durationScalarStrength} * ({_durationRatio} - 1)))

	if boolean tag "Constellation;Starlord" of (custom nbt of {karta::%{_p}%}) is set:
		Starlord({_p})

	if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Aetherial Kindling":
		if metadata value "CelestialAlignment" of {_p} is set:
			if metadata value "AetherialKindlingExtension" of {_p} is not set:
				set metadata value "AetherialKindlingExtension" of {_p} to 0
				
			set {_currentExtension} to metadata value "AetherialKindlingExtension" of {_p}
			set {_add} to 3

			if {_currentExtension} + {_add} > 15:
				set {_add} to 15 - {_currentExtension}

			set {_addSeconds} to "%{_add}% seconds" parsed as timespan

			if {_add} > 0:
				set metadata value "AetherialKindlingExtension" of {_p} to ({_currentExtension} + {_add})
				set metadata value "CelestialAlignment" of {_p} to (metadata value "CelestialAlignment" of {_p} + {_addSeconds})

	else if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Starweaver":
		chance of 40%:
			set metadata value "Starweaver" of {_p} to "Starsurge"
			loop all items in the inventory of {_p}:
				if boolean tag "Starsurge" of (custom nbt of loop-item) is set:
					set item amount of loop-item to 2

	set {_world} to world of {_p}

	loop {ECMobs::%{_world}%::*}:
		set {_entity} to loop-value parsed as entity

		if distance between {_p} and {_entity} < 100:

			set {_entityLoc} to location of {_entity}

			if chunk at {_entityLoc} is loaded:
				if metadata value "ECPulled" of {_entity} is set:
					set {_enemies::*} to {_enemies::*} and {_entity}


	set {_starfallDamage} to (1 + ((({damage::%{_p}%}/48) + (Versatility({_p})/144) + PrimaryStat({_p})/24)))

	set {_primCol} to coloured getPrimaryCardColour({_p})
	set {_secCol} to coloured getSecondaryCardColour({_p})

	if metadata value "CelestialAlignment" of {_p} is set:
		set {_starfallDamage} to {_starfallDamage}*1.15
	if metadata value "UmbralInspiration" of {_p} is set:
		set {_starfallDamage} to {_starfallDamage}*1.3
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Stellar Drift":
		set {_starfallDamage} to {_starfallDamage}*1.3
	if boolean tag "Constellation;Rattle the Stars" of (custom nbt of {karta::%{_p}%}) is set:
		set {_starfallDamage} to {_starfallDamage}*1.08

	set {_starfallDamage} to {_starfallDamage} * rounded ({_starfallDurationSeconds}/(1/{_pospiech}))

	set {_valueNames::*} to "COST", "DAMAGE", "DURATION"
	set {_values::*} to {_astralPowerCost}, {_starfallDamage}, {_starfallDurationSeconds}
	set {_lore} to GetAbilityDescription({_p}, "Cresselia", "Starfall", {_valueNames::*}, {_values::*})
	LoreUpdate({_p}, "Starfall", {_lore})


	if {_enemies::*} is set:
		set {_duration} to now
		wait 1 tick

		if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Stellar Drift":
			StellarDrift({_p}, {_starfallDuration})

		if metadata value "StarfallActive%{_p}%" of {_p} is not set:
			set metadata value "StarfallActive%{_p}%" of {_p} to 0

		set metadata value "StarfallActive%{_p}%" of {_p} to (metadata value "StarfallActive%{_p}%" of {_p} + 1)

		while (difference between {_duration} and now) < {_starfallDuration}:
			#15.08.2024 -> Maybe increase the amount of stars falling based on amount enemies in the list?
			#starfall would scale with the amount of enemies dynamically
			set {_randomEnemy} to a random element of {_enemies::*}
			set {_randomIncrease} to a random number between 8 and 35
			set {_loc} to location of {_randomEnemy}
			set y of {_loc} to (y of (location at {_randomEnemy}) + {_randomIncrease})

			spawn an armor stand at {_loc} with nbt from "{Invulnerable:1b,Invisible:1b,Silent:1b,NoGravity:1b,Pose:{Head:[180.0f,0.0f,0.0f]}}"
			set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true
			set {_starfallStar} to last spawned armor stand
			modelApply({_starfallStar}, "starfallmodel", 1)
			StarfallStarKill({_starfallStar})
			StarfallStarTravel({_p}, {_starfallStar}, {_randomEnemy}, {_starfallDuration}, {_pospiech}, {_effectiveness}, false, {_starfallDurationScalar}, {_astralPowerCost})

			wait {_wait}
			stop loop if (difference between {_duration} and now) >= {_starfallDuration}
			stop loop if metadata value "ECEngaged" of {_p} is not set
			#WSZYSCY LOSOWO
		
		set metadata value "StarfallActive%{_p}%" of {_p} to (metadata value "StarfallActive%{_p}%" of {_p} - 1)

function StarsurgeBonus(p: player, target: entity):
	if metadata value "StarsurgeBonus%{_p}%" of {_target} = true:
		set metadata value "StarsurgeBonus%{_p}%" of {_target} to false
		set {_id} to entity id of {_target}
		set {_icon} to getCardIcon({_p}, "Starsurge")
		
		while metadata value "StarsurgeTime%{_p}%" of {_target} > 0 seconds:
			if {_target} is alive:
				set {_stacks} to metadata value "StarsurgeStacks%{_p}%" of {_target}
				set {_duration} to seconds of (metadata value "StarsurgeTime%{_p}%" of {_target})
				set {_name} to "%name of {_target}% &8| &f %{_stacks}%x (%{_duration}%s)"
				set {_meta} to new metadata packet with id {_id}:
					name: {_name}
				send packet {_meta} to {_p}
				wait 1 second
				remove 1 second from metadata value "StarsurgeTime%{_p}%" of {_target}
				if 0 seconds >= metadata value "StarsurgeTime%{_p}%" of {_target}:
					clear metadata value "StarsurgeStacks%{_p}%" of {_target}
					clear metadata value "StarsurgeTime%{_p}%" of {_target}
					clear metadata value "StarsurgeBonus%{_p}%" of {_target}
					stop loop
			else:
				clear metadata value "StarsurgeStacks%{_p}%" of {_target}
				clear metadata value "StarsurgeTime%{_p}%" of {_target}
				clear metadata value "StarsurgeBonus%{_p}%" of {_target}
				stop loop
		if {_target} is alive:
			set {_name} to name of {_target}
			set {_meta} to new metadata packet with id {_id}:
				name: {_name}
			send packet {_meta} to {_p}

function CresseliaCelestialAlignmentCastSound(p: player):
	if getCurrentVariant({_p}, "Cresselia") = "Arctic Lights":
		play sound "skill.cresselia.celestial_alignment.arcticlights" with volume 4 and pitch 1 at location of {_p}
	else:
		play sound "skill.cresselia.celestial_alignment_cast" with volume 4 and pitch 1 at location of {_p}

