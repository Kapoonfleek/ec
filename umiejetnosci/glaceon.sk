					if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Icicle Storm":
						set {_target} to metadata value "MostRecentlyDamagedEnemy" of player
						if {_target} is not set:
							set {_target} to Target(player, 100, false)
						IcicleStorm(player, {_target})
					if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Freezing Winds":
						FreezingWinds(player)
					while metadata value "Icy Veins" of player is true:
						if metadata value "cast" of player is not set:
							send action bar ": %{_czas}%" to player
						if {_czas} >= 1 second:
							wait 1 second
						else:
							wait {_czas}
						if metadata value "ExtraSecondsIcyVeins" of player > 0 seconds:
							set {_czas} to {_czas} + metadata value "ExtraSecondsIcyVeins" of player
							clear metadata value "ExtraSecondsIcyVeins" of player
						remove 1 second from {_czas}
						if 0 seconds >= {_czas}:
							stop loop
						else if metadata value "IcyVeinsReapply" of player is set:
							clear metadata value "IcyVeinsReapply" of player
							stop
					set metadata value "Icy Veins" of player to false
					remove {_haste} from {haste::%player%}
				else:
					cancel event
					if {tekstcd::%player%} = true:
						set {_cdd} to cooldown "Icy Veins%player%"
						set the cooldown of player's tool for player to {_cdd}
						send "<##4bbfe2>You must wait &f%{_cdd}%<##4bbfe2> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if player's tool is prismarine crystals:
		if boolean tag "Glacial Spike" of (custom nbt of player's tool) is set:
			cancel event
			if {kartaname::%player%} = "Glaceon":
				if CanUseAbility(player) != false:
					if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Glacial Spike":
						if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%player%}) is set:
							set {_damageicicles} to {_damageicicles}*1.2
							set {_iciclesCap} to 7
						else:
							set {_iciclesCap} to 5

						set {_canCast} to false
						if {icicles::%player%} = {_iciclesCap}:
							set {_canCast} to true
						if metadata value "GlacialSpikeFreeActive" of player is true:
							set {_canCast} to true

						if {_canCast} is true:
							set {_target} to Target(player, 100, false)
							if {_target} is set:
								if metadata value "cast" of player is not set:
									set {_crit} to 25 + ({criticalhit::%player%}/10)
									set {_pospiech} to Haste(player)
									set {_baseCastTime} to 2.75
									if HasStarforgedBonus(player, "Glaceon", "Tier I", "2Set") is true:
										set {_baseCastTime} to {_baseCastTime} - 0.25
									set {_casttime} to "%round(({_baseCastTime}/{_pospiech}), 1)% seconds" parsed as timespan
									set {_baseDamage} to 5.0
									set {_damageScaling} to 7.0
									set {_damage} to {_baseDamage} + {damage::%player%}/14 + {versatility::%player%}/42 + {primarystat::%player%}/{_damageScaling}

									if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Chilled to the Core":
										if metadata value "Icy Veins" of player is true:
											set {_damage} to {_damage}*1.2
											set {_damageicicles} to {_damageicicles}*1.2
									if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Splitting Ice":
										set {_damage} to {_damage}*1.05
										set {_damageicicles} to {_damageicicles}*1.05

									set {_loreicicles} to "&7Użycie <##4bbfe2>Frostbolt &7przyzna ci <##4bbfe2>Sopelek&7. Użycie%nl%&7<##4bbfe2>Lodowej Lancy &7wystrzeli wszystkie przechowane%nl%<##4bbfe2>Sopelki &7w cel, każdy zadając &f%{_damageicicles}% &7obrażeń <##add8e6>Lodu&7.%nl% %nl%&7Maksymalnie %{_iciclesCap}% <##4bbfe2>Sopelków &7może być przechowane,%nl%&7a każdy wygenerowany <##4bbfe2>Sopelek &7w nadmiarze%nl%&7zostanie natychmiastowo wystrzelony."
									set {_lore} to "&8Umiejętność Talentu%nl%&f%{_casttime}% cast%nl%&7Brak cooldownu%nl%&7Użycie: &fPPM%nl%<##4bbfe2>Tworzy ogromny kolec lodu i łączy z nim%nl%<##4bbfe2>wszystkie twoje posiadane Sopelki. Lodowcowy Kolec%nl%<##4bbfe2>nadziewa twój cel, zadając &f%{_damage}% <##4bbfe2>obrażeń <##add8e6>Lodu<##4bbfe2>,plus%nl%<##4bbfe2>wszystkie obrażenia przechowane w Sopelkach.%nl% %nl%<##4bbfe2>Wymaga %{_iciclesCap}% Sopelków do użycia.%nl% %nl%<##4bbfe2>Pasywnie: Lodowa Lanca nie wystrzela już Sopelków."
									if cooldown "Glacial Spike%player%" is finished:
										if metadata value "cast" of player is not set:
											play sound "skill.glaceon.glacial_spike_precast" with volume 3 and pitch 1 to player
											set metadata value "casting" of player to true
											set metadata value "cast" of player to {_casttime}
											set {_freeGS} to metadata value "GlacialSpikeFreeActive" of player
											if {_freeGS} is true:
												set {_freeGSBool} to true
											GlacialSpikeForm(player, {_crit}, {_target}, {_freeGSBool})
											set {_totaldmgicicles} to metadata value "IciclesTotalDmg" of player
											clear metadata value "IciclesTotalDmg" of player
											while metadata value "casting" of player = true:
												if metadata value "cast" of player is not set:
													clear metadata value "casting" of player
													stop
												if player can not see {_target}:
													clear metadata value "casting" of player
													stop
												if {_casttime} > 0 seconds:
													set {_cst} to "%{_casttime}%"
													send action bar "Casting... %{_cst}%" to player
													wait 0.1 seconds
													remove 0.1 seconds from {_casttime}
												else:
													clear metadata value "casting" of player
													send action bar "" to player
													stop loop
										else:
											stop
										clear metadata value "casting" of player
										clear metadata value "cast" of player
										stop sound "skill.glaceon.glacial_spike_precast" for player
										if {_casttime} > 0 seconds:
											send action bar "&cInterrupted" to player
											stop						
										AbilityUse(player, "Glacial Spike")
										if metadata value "WintersChill%player%" of {_target} > 0:
											set metadata value "WintersChill%player%" of {_target} to metadata value "WintersChill%player%" of {_target} - 1
											if metadata value "WintersChill%player%" of {_target} = 0:
												clear metadata value "WintersChill%player%" of {_target}
											set {_frozen} to true
										if {_frozen} is true:
											set {_crit} to {_crit} + 50
											if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%player%}) is set:
												set {_damage} to {_damage}*1.05
										play sound "skill.glaceon.glacial_spike_cast" with volume 3 and pitch 1 at location of player
										set {_glacialspike} to metadata value "GlacialSpike" of player
										clear metadata value "GlacialSpike" of player
										GlacialSpikeHurl(player, {_glacialspike}, {_target})

										if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%player%}) is set:
											set {_critModifier} to 2.2
										else:
											set {_critModifier} to 2

										if {_freeGSBool} is true:
											set {_damage} to {_damage} * 1.25
											clear metadata value "GlacialSpikeFreeActive" of player
											set metadata value "GlacialSpikeFreeCounter" of player to 0
											loop all items in player's inventory:
												if boolean tag "Glacial Spike" of (custom nbt of loop-item) is set:
													set item amount of loop-item to 1

										set {_damage} to {_damage} + {_totaldmgicicles}
										set {_damageBeforeCrit} to {_damage}

										set {_target}'s last damage cause to sweep attack
										set metadata value "Element" of player to "Ice"
										set metadata value "LastDamageCause" of {_target} to "<##4bbfe2>Glacial Spike"
										set metadata value "LastDamageCauseLore" of {_target} to {_lore}
										set {_damage} to Crit(player, {_target}, {_crit}, {_damage}, {_critModifier})
										make player damage {_target} by {_damage}

										play sound "skill.glaceon.glacial_spike_impact" with volume 3 and pitch 1 at location of player
										play sound "skill.glaceon.glacial_spike_hit" with volume 3 and pitch 1 at location of player

										if {_damage} != {_damageBeforeCrit}:
											if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%player%}) is set:
												if metadata value "Icy Veins" of player is true:
													remove 0.75 seconds from cooldown "Icy Veins%player%"

										if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Splitting Ice":
											loop all entities in radius 5 around {_target}:
												if boolean tag "ECMob" of custom nbt of loop-entity is set:
													set loop-entity's last damage cause to sweep attack
													set metadata value "Element" of player to "Ice"
													set metadata value "LastDamageCause" of loop-entity to "<##4bbfe2>Glacial Spike"
													set metadata value "LastDamageCauseLore" of loop-entity to {_lore}
													if {_damage} != {_damageBeforeCrit}:
														CritVisual(loop-entity)
														set metadata value "Crit%player%" of loop-entity to true
													make player damage loop-entity by 0.2*({_damage})
									else: 
										cancel event
										if {tekstcd::%player%} = true:
											set {_cdd} to cooldown "Ice Lance%player%"
											set the cooldown of player's tool for player to {_cdd}
											send "<##4bbfe2>You must wait &f%{_cdd}%<##4bbfe2> to use this ability." to player
										stop
						else:
							if metadata value "cast" of player is not set:
								send action bar "&fYou must have %{_iciclesCap}% Icicles." to player
								play sound "block.glass.break" with volume 3 and pitch 1.65 to player
					else:
						send "&8[&6Earthcraft&8] &6You don't have the required talent to use this ability." to player
						play sound "block.glass.break" with volume 3 and pitch 0 to player
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player

function WintersChillDebuff(p: player, target: entity):
	if metadata value "WintersChill%{_p}%" of {_target} is not set:
		set metadata value "WintersChill%{_p}%Duration" of {_target} to 8 seconds
		while metadata value "WintersChill%{_p}%" of {_target} > 0:
			remove 1 second from metadata value "WintersChill%{_p}%Duration" of {_target}
			wait 1 second
			stop loop if {_target} is not alive
		clear metadata value "WintersChill%{_p}%" of {_target}
		clear metadata value "WintersChill%{_p}%Duration" of {_target}
	else:
		set metadata value "WintersChill%{_p}%Duration" of {_target} to 8 seconds

function Frostbolt(p: player, target: entity, crit: number, damage: number, slowtime: timespan):
	if {_p} is alive:
		set {_l} to location 0.3 blocks below {_p}'s head
		set {_l} to location 0.4 blocks right of {_l}
		set {_v} to vector between {_l} and {_target}'s head
		loop round(distance between {_l} and {_target}) / 0.9 times:
			set {_v} to vector between {_l} and {_target}'s head
			set vector length of {_v} to loop-value * 0.9
			if vector length of {_v} < 6:
				#ZAMIENIĆ PARTICLE JAK BĘDZIE SKDRAGON
				draw 1 of ((rgb 52, 119, 235) dust particle of size 1) at {_l} ~ {_v}
				#drawDot count 1, particle "redstone", RGB 52, 119, 235, center {_l} ~ {_v}, rainbowMode false, visibleRange 32, pulseDelay 0, keepFor 5 ticks
			if vector length of {_v} > 4:
				#ZAMIENIĆ PARTICLE JAK BĘDZIE SKDRAGON
				draw 1 of ((rgb 119, 164, 242) dust particle of size 1) at {_l} ~ {_v}
				#drawDot count 1, particle "redstone", RGB 119, 164, 242, center {_l} ~ {_v}, rainbowMode false, visibleRange 32, pulseDelay 0, keepFor 5 ticks
			draw 1 of light blue stained glass block particle at {_l} ~ {_v}
			draw 1 of ice block particle at {_l} ~ {_v}
			wait 1 tick

		if metadata value "WintersChill%{_p}%" of {_target} > 0:
			remove 1 from metadata value "WintersChill%{_p}%" of {_target}
			if metadata value "WintersChill%{_p}%" of {_target} = 0:
				clear metadata value "WintersChill%{_p}%" of {_target}
			set {_frozen} to true
		if {_frozen} is true:
			set {_crit} to {_crit} + 50
			if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
				set {_damage} to {_damage}*1.05
		
		if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
			set {_critModifier} to 2.2
		else:
			set {_critModifier} to 2

		set {_damageBeforeCrit} to {_damage}
		set {_target}'s last damage cause to sweep attack
		set metadata value "Element" of {_p} to "Ice"
		set metadata value "LastDamageCause" of {_target} to "<##4bbfe2>Frostbolt"
		set metadata value "LastDamageCauseLore" of {_target} to {_lore}
		set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage}, {_critModifier})
		make {_p} damage {_target} by {_damage}
		if canBeCCed({_target}) = true:
			apply an ambient potion effect of slowness of tier 2.67 to {_target} for {_slowtime}:
				hide the particles

		frostboltHitSound({_target})

		if {_damage} != {_damageBeforeCrit}:
			if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%{_p}%}) is set:
				if metadata value "Icy Veins" of {_p} is true:
					remove 0.75 seconds from cooldown "Icy Veins%{_p}%"
		
		clear {_damageBeforeCrit}

function GlacialSpikeForm(p: player, crit: number, target: entity, free: boolean = false):
	if {_p} is alive:
		if metadata value "WintersChill%{_p}%" of {_target} > 0:
			set {_crit} to {_crit} + 50
		set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "BASEDAMAGE")
		set {_damageScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "DAMAGESCALING")
		set {_damageicicles} to ({_baseDamage} + ({damage::%{_p}%}/75) + ({versatility::%{_p}%}/225) + ({primarystat::%{_p}%}/{_damageScaling})) * (1 + ({mastery::%{_p}%}/3.75/100))
		set {_rune} to getRunePower({_p}, "Glacial Wrath")
		set {_damageicicles} to {_damageicicles} * (1 + ({_rune} * {icicles::%{_p}%})/100)
		set {_flashFreezeDmg} to offensiveTrait({_p}, "Glaceon", "Flash Freeze")
		set {_damageicicles} to {_damageicicles} + {_flashFreezeDmg}

		if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Chilled to the Core":
			if metadata value "Icy Veins" of {_p} is true:
				set {_damageicicles} to {_damageicicles}*1.2
		if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Splitting Ice":
			set {_damageicicles} to {_damageicicles}*1.05
		if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Ice Nine":
			set {icicleCount::%{_p}%} to {icicleCount::%{_p}%} + 1

		if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is set:
			set {_damageicicles} to {_damageicicles}*1.2

		if metadata value "WintersChill%{_p}%" of {_target} > 0:
			if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
				set {_damageicicles} to {_damageicicles}*1.05

		if {icicleCount::%{_p}%} = 9:
			set {_damageicicles} to {_damageicicles}*1.9
			set {icicleCount::%{_p}%} to 0

		chance of {_crit}%:
			if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
				set {_damageicicles} to {_damageicicles}*2.2
			else:
				set {_damageicicles} to {_damageicicles}*2
				
			if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%{_p}%}) is set:
				if metadata value "Icy Veins" of {_p} is true:
					remove 0.75 seconds from cooldown "Icy Veins%{_p}%"

		if getTrait({_p}, "Flash Freeze") is set:
			chance of 5%:
				if metadata value "Fingers of Frost" of {_p} < 2:
					set metadata value "Fingers of Frost" of {_p} to metadata value "Fingers of Frost" of {_p} + 1
				if metadata value "Fingers of Frost" of {_p} = 1:
					if metadata value "BrainFreeze" of {_p} is true:
						send title " " with subtitle "           " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
					else:
						send title " " with subtitle "                     " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
				if metadata value "Fingers of Frost" of {_p} = 2:
					if metadata value "BrainFreeze" of {_p} is true:
						send title " " with subtitle "    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
					else:
						send title " " with subtitle "                    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second

		set {_numIcicles} to {icicles::%{_p}%}
		set {_totaldmgicicles} to {_damageicicles} * {_numIcicles}

		if HasStarforgedBonus({_p}, "Glaceon", "Tier I", "2Set") is true:
			set {_totaldmgicicles} to {_totaldmgicicles} * 1.4

		if {_free} is not true:
			loop {_numIcicles} times:
				set {_icicleVisual} to {icicle%{icicles::%{_p}%}%::%{_p}%}
				clear {icicle%{icicles::%{_p}%}%::%{_p}%}
				set {icicles::%{_p}%} to {icicles::%{_p}%} - 1
				GlacialSpikeFormAnimation({_p}, {_icicleVisual})

		set metadata value "GlacialSpike" of {_p} to GlacialSpike({_p})
		GlacialSpikeMove({_p}, metadata value "GlacialSpike" of {_p})

		set metadata value "IciclesTotalDmg" of {_p} to {_totaldmgicicles}
function GlacialSpikeFormAnimation(p: player, icicleVisual: entity):
	set {_loc} to {_p}'s location
	increase {_loc}'s y-coordinate by 0.2
	set {_speed} to 0.15 / Haste({_p})
	set {_wait} to "%0.1 / Haste({_p})% seconds" parsed as timespan
	set {_l} to location of {_icicleVisual}
	set {_yaw} to yaw of {_p}
	set {_pitch} to pitch of {_p}
	set yaw of {_l} to {_yaw}
	set pitch of {_l} to {_pitch}
	loop round(distance between {_l} and {_loc}) / {_speed} times:
		set {_loc} to {_p}'s location
		increase {_loc}'s y-coordinate by 0.2
		set yaw of {_loc} to 90
		set {_vec} to vector between {_l} and {_loc}
		set vector length of {_vec} to loop-value * {_speed}
		teleport {_icicleVisual} to {_l} ~ {_vec}
		wait {_wait}
	kill {_icicleVisual}
	
function FrigidGrasp(p: player):
	wait 15 seconds
	remove {frigiddmg::%{_p}%} from {damage::%{_p}%}
	clear {frigiddmg::%{_p}%}

function FreezingWinds(p: player):
	wait 1 tick
	while metadata value "Icy Veins" of {_p} is true:
		wait 3 seconds
		if metadata value "Fingers of Frost" of {_p} < 2:
			set metadata value "Fingers of Frost" of {_p} to metadata value "Fingers of Frost" of {_p} + 1
		if metadata value "Fingers of Frost" of {_p} = 1:
			if metadata value "BrainFreeze" of {_p} is true:
				send title " " with subtitle "           " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
			else:
				send title " " with subtitle "                     " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
		else if metadata value "Fingers of Frost" of {_p} = 2:
			if metadata value "BrainFreeze" of {_p} is true:
				send title " " with subtitle "    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second

function HurlIcicle(p: player, target: entity, iciclesCap: integer):
	set {_extraamount} to {icicles::%{_p}%} - {_iciclesCap}
	loop {_extraamount} times:
		stop loop if {_target} is not alive
		set {icicles::%{_p}%} to {icicles::%{_p}%} - 1
		set {_icicleVisual} to {icicle1::%{_p}%}
		clear {icicle1::%{_p}%}
		loop {_iciclesCap} times:
			set {_next} to loop-number-2 + 1
			set {icicle%loop-number-2%::%{_p}%} to {icicle%{_next}%::%{_p}%}

		set {_icicleToClear} to {_iciclesCap} + 1
		clear {icicle%{_icicleToClear}%::%{_p}%}

		set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "BASEDAMAGE")
		set {_damageScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "DAMAGESCALING")
		set {_damageicicles} to ({_baseDamage} + ({damage::%{_p}%}/75) + ({versatility::%{_p}%}/225) + ({primarystat::%{_p}%}/{_damageScaling})) * (1 + ({mastery::%{_p}%}/3.75/100))
		set {_rune} to getRunePower({_p}, "Glacial Wrath")
		set {_damageicicles} to {_damageicicles} * (1 + ({_rune} * {icicles::%{_p}%})/100)
		set {_flashFreezeDmg} to offensiveTrait({_p}, "Glaceon", "Flash Freeze")
		set {_damageicicles} to {_damageicicles} + {_flashFreezeDmg}

		set {_crit} to 25 + ({criticalhit::%{_p}%}/10)
		if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
			set {_damageicicles} to {_damageicicles}*1.05
		if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Chilled to the Core":
			if metadata value "Icy Veins" of {_p} is true:
				set {_damageicicles} to {_damageicicles}*1.2
		if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Splitting Ice":
			set {_damageicicles} to {_damageicicles}*1.05
		if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Ice Nine":
			set {icicleCount::%{_p}%} to {icicleCount::%{_p}%} + 1
		if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is set:
			set {_damageicicles} to {_damageicicles}*1.2

		set {_rgb} to (rgb 106, 184, 230)
		if boolean tag "BlackIce" of custom nbt of {_icicleVisual} = true:
			set {_damageicicles} to {_damageicicles}*1.7
			set {_rgb} to (rgb 28, 28, 28)

		if {_rgb} = (rgb 28, 28, 28):
			play sound "skill.glaceon.icelance_hurl" with volume 3 and pitch 0.7 at location of {_p}
		else:
			play sound "skill.glaceon.icelance_hurl" with volume 3 and pitch 1.5 at location of {_p}

		if metadata value "WintersChill%{_p}%" of {_target} > 0:
			set {_frozen} to true
		if {_frozen} is true:
			set {_crit} to {_crit} + 50
			if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
				set {_damageicicles} to {_damageicicles}*1.05

		set {_locIce} to location of {_icicleVisual}
		set {_yaw} to yaw of {_p}
		set {_pitch} to pitch of {_p}
		set yaw of {_locIce} to {_yaw}
		set pitch of {_locIce} to {_pitch}
		set {_targetLoc} to location 0.5 below {_target}
		set {_loop} to round((distance between {_locIce} and {_targetLoc}) / 1)
		loop {_loop} times:
			set {_targetLoc} to location 0.5 below {_target}
			set {_vec} to vector between {_locIce} and {_targetLoc}
			set vector length of {_vec} to loop-value-2 * 1
			teleport {_icicleVisual} to {_locIce} ~ {_vec}
			set {_icicleVisualLoc} to location of {_icicleVisual}
			increase y-coordinate of {_icicleVisualLoc} by 2 
			draw 1 of ({_rgb} dust particle of size 1) at {_icicleVisualLoc}
			wait 1 tick
		kill {_icicleVisual}

		if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
			set {_critModifier} to 2.2
		else:
			set {_critModifier} to 2

		set {_damageBeforeCrit} to {_damageicicles}
		set {_target}'s last damage cause to sweep attack
		set metadata value "Element" of {_p} to "Ice"
		set metadata value "LastDamageCause" of {_target} to "<##4bbfe2>Icicles"
		set metadata value "LastDamageCauseLore" of {_target} to {_lore}
		set {_damageicicles} to Crit({_p}, {_target}, {_crit}, {_damageicicles}, {_critModifier})
		make {_p} damage {_target} by ({_damageicicles})

		if {_damageicicles} != {_damageBeforeCrit}:
			if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%{_p}%}) is set:
				if metadata value "Icy Veins" of {_p} is true:
					remove 0.75 seconds from cooldown "Icy Veins%{_p}%"

		if getTrait({_p}, "Flash Freeze") is set:
			chance of 5%:
				if metadata value "Fingers of Frost" of {_p} < 2:
					set metadata value "Fingers of Frost" of {_p} to metadata value "Fingers of Frost" of {_p} + 1
				if metadata value "Fingers of Frost" of {_p} = 1:
					if metadata value "BrainFreeze" of {_p} is true:
						send title " " with subtitle "           " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
					else:
						send title " " with subtitle "                     " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
				if metadata value "Fingers of Frost" of {_p} = 2:
					if metadata value "BrainFreeze" of {_p} is true:
						send title " " with subtitle "    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
					else:
						send title " " with subtitle "                    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
		clear {_damageicicles}
		if {_extraamount} > 1:
			wait 2 ticks
function HurlIcicleIceLance(p: player, target: entity, frozen: boolean):
	if {icicles::%{_p}%} > 0:
		if metadata value "IcicleLaunch" of {_p} is not false:
			set metadata value "IcicleLaunch" of {_p} to false
			set {_totaldmgicicles} to 0
			set {_current} to {icicles::%{_p}%}
			loop {_current} times:
				set {_idx} to loop-number
				set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "BASEDAMAGE")
				set {_damageScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "DAMAGESCALING")
				set {_damageicicles} to ({_baseDamage} + ({damage::%{_p}%}/75) + ({versatility::%{_p}%}/225) + ({primarystat::%{_p}%}/{_damageScaling})) * (1 + ({mastery::%{_p}%}/3.75/100))
				set {_rune} to getRunePower({_p}, "Glacial Wrath")
				set {_damageicicles} to {_damageicicles} * (1 + ({_rune} * {icicles::%{_p}%})/100)
				set {_flashFreezeDmg} to offensiveTrait({_p}, "Glaceon", "Flash Freeze")
				set {_damageicicles} to {_damageicicles} + {_flashFreezeDmg}

				if {_frozen} is true:
					if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
						set {_damageicicles} to {_damageicicles}*1.05
				if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Chilled to the Core":
					if metadata value "Icy Veins" of {_p} is true:
						set {_damageicicles} to {_damageicicles}*1.2
				if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Splitting Ice":
					set {_damageicicles} to {_damageicicles}*1.05
				if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Ice Nine":
					set {icicleCount::%{_p}%} to {icicleCount::%{_p}%} + 1
				set {_rgb} to (rgb 106, 184, 230)
				if boolean tag "BlackIce" of custom nbt of {icicle%{_idx}%::%{_p}%} = true:
					set {_damageicicles} to {_damageicicles}*1.7
					set {_rgb} to (rgb 28, 28, 28)
				set {_rgb::%{_idx}%} to {_rgb}
				if {_rgb} = (rgb 28, 28, 28):
					play sound "skill.glaceon.icelance_hurl" with volume 3 and pitch 0.7 at location of {_p}
				else:
					play sound "skill.glaceon.icelance_hurl" with volume 3 and pitch 1.5 at location of {_p}

				if {icicleCount::%{_p}%} = 9:
					set {_damageicicles} to {_damageicicles}*1.9
					set {icicleCount::%{_p}%} to 0

				if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
					set {_critModifier} to 2.2
				else:
					set {_critModifier} to 2

				set {_damageBeforeCrit} to {_damageicicles}
				set {_target}'s last damage cause to sweep attack
				set metadata value "Element" of {_p} to "Ice"
				set metadata value "LastDamageCause" of {_target} to "<##4bbfe2>Icicles"
				set metadata value "LastDamageCauseLore" of {_target} to {_lore}
				set {_damageicicles} to Crit({_p}, {_target}, {_crit}, {_damageicicles}, {_critModifier})
				make {_p} damage {_target} by ({_damageicicles})

				if {_damageicicles} != {_damageBeforeCrit}:
					if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%{_p}%}) is set:
						if metadata value "Icy Veins" of {_p} is true:
							remove 0.75 seconds from cooldown "Icy Veins%{_p}%"

				if getTrait({_p}, "Flash Freeze") is set:
					chance of 5%:
						if metadata value "Fingers of Frost" of {_p} < 2:
							set metadata value "Fingers of Frost" of {_p} to metadata value "Fingers of Frost" of {_p} + 1
						if metadata value "Fingers of Frost" of {_p} = 1:
							if metadata value "BrainFreeze" of {_p} is true:
								send title " " with subtitle "           " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
							else:
								send title " " with subtitle "                     " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
						if metadata value "Fingers of Frost" of {_p} = 2:
							if metadata value "BrainFreeze" of {_p} is true:
								send title " " with subtitle "    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
							else:
								send title " " with subtitle "                    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second

				set {_totaldmgicicles} to {_totaldmgicicles} + {_damageicicles}
				if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Splitting Ice":
					loop all entities in radius 5 around {_target}:
						if boolean tag "ECMob" of custom nbt of loop-entity is set:
							set loop-entity's last damage cause to sweep attack
							set metadata value "Element" of {_p} to "Ice"
							set metadata value "LastDamageCause" of loop-entity to "<##4bbfe2>Icicles"
							set metadata value "LastDamageCauseLore" of loop-entity to {_lore}
							if {_damageicicles} != {_damageBeforeCrit}:
								CritVisual(loop-entity)
								set metadata value "Crit%{_p}%" of loop-entity to true
							make {_p} damage loop-entity by 0.2*({_damageicicles})
				clear {_damageicicles}
				clear {_damageBeforeCrit}
				wait 2 ticks

		clear metadata value "IcicleLaunch" of {_p}
		set {_kept} to 0
		loop {_current} times:
			set {_idx} to {_current} - loop-value + 1
			set {_iceCycle} to false
			if string tag "Talents;Row 1" of (custom nbt of {karta::%{_p}%}) = "Ice Cycle":
				chance of 5%:
					set {_iceCycle} to true
			if {_iceCycle} is false:
				set {_icicleVisual} to {icicle%{_idx}%::%{_p}%}
				clear {icicle%{_idx}%::%{_p}%}
				IcicleHurl({_p}, {_icicleVisual}, {_target}, {_rgb::%{_idx}%})
			else:
				set {_kept} to {_kept} + 1
				set {_keptIcicles::%{_kept}%} to {icicle%{_idx}%::%{_p}%}
				clear {icicle%{_idx}%::%{_p}%}

		set {icicles::%{_p}%} to {_kept}
		loop {_kept} times:
			set {icicle%loop-value%::%{_p}%} to {_keptIcicles::%loop-value%}

		send action bar " Icicles: %{icicles::%{_p}%}%" to {_p}
	wait 1 tick
	if boolean tag "Constellation;Hailstones" of (custom nbt of {karta::%{_p}%}) is set:
		if {_frozen} is true:
			set {icicles::%{_p}%} to {icicles::%{_p}%} + 1
			TrackIcicleGeneration({_p}, {_target})
			send action bar " Icicles: %{icicles::%{_p}%}%" to {_p}
function IcicleStorm(p: player, target: entity):
	set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "BASEDAMAGE")
	set {_damageScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "DAMAGESCALING")
	set {_damageicicles} to 0.5 * ({_baseDamage} + ({damage::%{_p}%}/75) + ({versatility::%{_p}%}/225) + ({primarystat::%{_p}%}/{_damageScaling})) * (1 + ({mastery::%{_p}%}/3.75/100))
	set {_loops} to 20

	loop {_loops} times:
		set {_crit} to 25 + ({criticalhit::%{_p}%}/10)
		set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "BASEDAMAGE")
		set {_damageScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "DAMAGESCALING")
		set {_damageicicles} to 0.5 * ({_baseDamage} + ({damage::%{_p}%}/75) + ({versatility::%{_p}%}/225) + ({primarystat::%{_p}%}/{_damageScaling})) * (1 + ({mastery::%{_p}%}/3.75/100))
		set {_randomIcicle} to a random integer between 1 and {_iciclesCap}
		set {_rgb} to (rgb 106, 184, 230)
		if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Black Ice":
			chance of 30%:
				set {_damageicicles} to {_damageicicles}*1.7
				set {_rgb} to (rgb 28, 28, 28)
				set {_blackIce} to true
		set {_icicle} to IcicleFormIcicleStorm({_p}, {_randomIcicle}, {_blackIce})
		if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Chilled to the Core":
			if metadata value "Icy Veins" of {_p} is true:
				set {_damageicicles} to {_damageicicles}*1.2
		if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Splitting Ice":
			set {_damageicicles} to {_damageicicles}*1.05
		if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Ice Nine":
			set {icicleCount::%{_p}%} to {icicleCount::%{_p}%} + 1
		if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is set:
			set {_iciclesCap} to 7
			set {_damageicicles} to {_damageicicles}*1.2
		else:
			set {_iciclesCap} to 5
		if metadata value "WintersChill%{_p}%" of {_target} > 0:
			if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
				set {_damageicicles} to {_damageicicles}*1.05

		if {_rgb} = (rgb 28, 28, 28):
			play sound "skill.glaceon.icelance_hurl" with volume 3 and pitch 0.7 at location of {_p}
		else:
			play sound "skill.glaceon.icelance_hurl" with volume 3 and pitch 1.5 at location of {_p}
		IcicleHurl({_p}, {_icicle}, {_target}, {_rgb})

		if {icicleCount::%{_p}%} = 9:
			set {_damageicicles} to {_damageicicles}*1.9
			set {icicleCount::%{_p}%} to 0
		
		if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%{_p}%}) is set:
			set {_critModifier} to 2.2
		else:
			set {_critModifier} to 2

		set {_damageBeforeCrit} to {_damageicicles}

		set {_target}'s last damage cause to sweep attack
		set metadata value "Element" of {_p} to "Ice"
		set metadata value "LastDamageCause" of {_target} to "<##4bbfe2>Icicles"
		set metadata value "LastDamageCauseLore" of {_target} to {_lore}
		set {_damageicicles} to Crit({_p}, {_target}, {_crit}, {_damageicicles}, {_critModifier})
		make {_p} damage {_target} by ({_damageicicles})

		if {_damageicicles} != {_damageBeforeCrit}:
			if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%{_p}%}) is set:
				if metadata value "Icy Veins" of {_p} is true:
					remove 0.75 seconds from cooldown "Icy Veins%{_p}%"

		clear {_damageBeforeCrit}

		chance of {_chanceicicles}%:
			if metadata value "Fingers of Frost" of {_p} < 2:
				set metadata value "Fingers of Frost" of {_p} to metadata value "Fingers of Frost" of {_p} + 1
			if metadata value "Fingers of Frost" of {_p} = 1:
				if metadata value "BrainFreeze" of {_p} is true:
					send title " " with subtitle "           " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
				else:
					send title " " with subtitle "                     " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
			if metadata value "Fingers of Frost" of {_p} = 2:
				if metadata value "BrainFreeze" of {_p} is true:
					send title " " with subtitle "    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
				else:
					send title " " with subtitle "                    " to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
		clear {_damageicicles}
		wait 5 ticks

function ChainReaction(p: player):
	if {chainreac::%{_p}%} is true:
		set {chainreac::%{_p}%} to false
		while {czaschain::%{_p}%} > 0 seconds:
			remove 1 second from {czaschain::%{_p}%}
			wait 1 second
			if 0 seconds >= {czaschain::%{_p}%}:
				set {chainreaction::%{_p}%} to 0
				clear {czaschain::%{_p}%}
				clear {chainreac::%{_p}%}
				stop loop
on disconnect:
	clear metadata value "cast" of player
	wait 60 seconds
	if player is offline:
		if metadata value "Icy Veins" of player is true:
			clear metadata value "Icy Veins" of player
		if {frigiddmg::%player%} is set:
			clear {frigiddmg::%player%}
		clear {czaschain::%player%}
		clear {chainreaction::%player%}
		clear {chainreac::%player%}
		clear metadata value "ExtraSecondsIcyVeins" of player
		clear {icicleCount::%player%}
		clear {slickIce::%player%}
		clear metadata value "MostRecentlyDamagedEnemy" of player
		loop 7 times:
			clear {icicle%loop-number%::%player%}
		clear {iciclehave::%player%}

on skript stop:
	loop all offline players:
		if {tunnelofice::count::%loop-offline player%} is set:
			clear {tunnelofice::count::%loop-offline player%}
		if {tunnelofice::%loop-offline player%} is set:
			clear {tunnelofice::%loop-offline player%}
		if {lastspell::%loop-offline player%} is set:
			clear {lastspell::%loop-offline player%}
		if {frigiddmg::%loop-offline player%} is set:
			clear {frigiddmg::%loop-offline player%}
		clear {czaschain::%loop-offline player%}
		clear {chainreaction::%loop-offline player%}
		clear {chainreac::%loop-offline player%}
		clear {thermalVoidSeconds::%loop-offline player%}
		clear {icicleCount::%loop-offline player%}
		clear {slickIce::%loop-offline player%}
		clear {lastDamagedTarget::%loop-offline player%}

on world change:
	wait 1 tick
	loop 7 times:
		set {_icicle} to {icicle%loop-number%::%player%}
		if {_icicle} is set:
			teleport {_icicle} to player
		clear {_icicle}

function GlacialAssaultComet(p: player, target: entity, damage: number):
	set {_skyLoc} to location 8 above {_target}
	set {_targetLoc} to location 0.5 below {_target}
	play sound "block.glass.break" with volume 2 and pitch 0.5 at {_target}
	loop 8 times:
		set {_vec} to vector between {_skyLoc} and {_targetLoc}
		set vector length of {_vec} to loop-value * 1.0
		draw 15 of (((snowball item particle) with an extra value of 0.05) with offset vector(0.2, 0.2, 0.2)) at ({_skyLoc} ~ {_vec})
		draw 15 of (((ice block particle) with an extra value of 0.03) with offset vector(0.15, 0.15, 0.15)) at ({_skyLoc} ~ {_vec})
		wait 1 tick
	play sound "entity.elder_guardian.death" with volume 3 and pitch 1.8 at {_target}
	draw 40 of (((snowflake particle) with an extra value of 0.08) with offset vector(0.6, 0.6, 0.6)) at ({_target})
	loop LoopEntitiesAroundTarget({_target}, 6, true):
		if boolean tag "ECMob" of (custom nbt of loop-entity) is set:
			set loop-entity's last damage cause to sweep attack
			set metadata value "Element" of {_p} to "Ice"
			set metadata value "LastDamageCause" of loop-entity to "<##4bbfe2>Glacial Assault"
			set metadata value "LastDamageCauseLore" of loop-entity to "A freezing comet crashed from the sky."
			make {_p} damage loop-entity by {_damage}

function TrackIcicleGeneration(p: player, target: entity):
	if HasStarforgedBonus({_p}, "Glaceon", "Tier I", "4Set") is true:
		set {_gsCounter} to metadata value "GlacialSpikeFreeCounter" of {_p}
		if {_gsCounter} is not set:
			set {_gsCounter} to 0
		set {_gsCounter} to {_gsCounter} + 1
		set metadata value "GlacialSpikeFreeCounter" of {_p} to {_gsCounter}
		if {_gsCounter} = 50:
			set metadata value "GlacialSpikeFreeActive" of {_p} to true
			play sound "entity.player.levelup" with volume 3 and pitch 1.8 to {_p}
			loop all items in {_p}'s inventory:
				if boolean tag "Glacial Spike" of (custom nbt of loop-item) is set:
					set item amount of loop-item to 2

	if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is set:
		set {_iciclesCap} to 7
	else:
		set {_iciclesCap} to 5
	if {icicles::%{_p}%} > {_iciclesCap}:
		HurlIcicle({_p}, {_target}, {_iciclesCap})
	else:
		IcicleForm({_p}, {icicles::%{_p}%})


