import:
	kr.toxicity.model.api.BetterModel
	kr.toxicity.model.api.tracker.EntityTrackerRegistry
	kr.toxicity.model.api.tracker.Tracker
	kr.toxicity.model.api.tracker.TrackerModifier
	org.bukkit.Bukkit
	java.lang.System

function AzeriteChannel(p: player, l: location):
	loop 40 times:
		set {_loc} to location of {_p}
		increase y of {_loc} by 1.4
		set {_vec} to vector between {_loc} and {_l}
		loop round(distance between {_loc} and {_l}) / 0.5 times:
			set {_vec} to vector between {_loc} and {_l}
			set vector length of {_vec} to loop-value-2 * 0.5
			draw 1 of rgb(132, 175, 245) dust particle of size 1 at {_loc} ~ {_vec}
			draw 1 of rgb(242, 204, 121) dust particle of size 1 at {_loc} ~ {_vec}
		wait 2 ticks
		
function AzeriteBurst(p: player, l: location, l2: location):
	set {_vec} to vector between {_l} and {_l2}
	loop round(distance between {_l} and {_l2}) / 0.25 times:
		set {_vec} to vector between {_l} and {_l2}
		set vector length of {_vec} to loop-value * 0.25
		draw 1 of rgb(132, 175, 245) dust particle of size 1 at {_l} ~ {_vec}
		draw 1 of rgb(242, 204, 121) dust particle of size 1 at {_l} ~ {_vec}

function chamberOfHeartAmbience():
    set {_loc} to location(9112, -58, 1642, world "world")
    set {_locUp} to location(9112, -12, 1642, world "world")
    set {_locWide} to location(9112, -23.5, 1642, world "world")
    while online player count > 0:
        draw 90 of end rod particle with extra value 0.01 with offset vector(5, 6, 5) at {_loc}
        draw 90 of end rod particle with extra value 0.01 with offset vector(6, 4, 6) at {_locUp}
        draw 90 of end rod particle with extra value 0.01 with offset vector(24, 0, 24) at {_locWide}
        draw 80 of end rod particle with extra value 0.01 with offset vector(19, 0, 19) at location above {_locWide}
        draw 70 of end rod particle with extra value 0.01 with offset vector(14, 0, 14) at location 2 above {_locWide}
        draw 60 of end rod particle with extra value 0.01 with offset vector(11, 0, 11) at location 3 above {_locWide}
        wait 2 seconds

