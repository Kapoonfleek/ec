

function addMiningStat(p: player, stat: text, amount: number = 1) :: number:
	set {_value} to yaml value "Statistics.Mining.%{_stat}%" in "data-%{_p}%"
	if {_value} is not set:
		set {_value} to 0
	set {_value} to {_value} + {_amount}
	set yaml value "Statistics.Mining.%{_stat}%" in "data-%{_p}%" to {_value}
	return {_value}

function getMiningStat(p: player, stat: text) :: number:
	set {_value} to yaml value "Statistics.Mining.%{_stat}%" in "data-%{_p}%"
	if {_value} is not set:
		set {_value} to 0
	return {_value}

function minenew(p: player, t: text, b: block):
	if {_t} = "deepslate":
		set {_blok} to 2
		set {deepslate::%{_p}%} to {deepslate::%{_p}%} + 1
		addMiningStat({_p}, "Deepslate Mined")

		set {_deepslateCount} to yaml value "Weekly Progression.Mining.Deepslate" in "data-%{_p}%"
		if {_deepslateCount} is not set:
			set {_deepslateCount} to 0
		set yaml value "Weekly Progression.Mining.Deepslate" in "data-%{_p}%" to {_deepslateCount} + 1
		save yaml "data-%{_p}%"

	else if {_t} = "stone":
		set {_blok} to 1
		set {stone::%{_p}%} to {stone::%{_p}%} + 1
		addMiningStat({_p}, "Stone Mined")

	#if {event} = "Winter Delight":
	#	if {winterDelightPassLEVEL::%{_p}%} >= 0:
	#		getMission({_p}, "Festive Mining", "Świąteczne Kopanie", {_blok})

	loop {_blok} times:
		set {_stoneAndDeepslate} to ({stone::%{_p}%} + ({deepslate::%{_p}%}*2))

		set {_stoneCount} to yaml value "Weekly Progression.Mining.Stone" in "data-%{_p}%"
		if {_stoneCount} is not set:
			set {_stoneCount} to 0
		set yaml value "Weekly Progression.Mining.Stone" in "data-%{_p}%" to {_stoneCount} + 1
		save yaml "data-%{_p}%"

		set {_yamlValue} to "Achievement.Mining.Stone.100"
		achievementYaml({_p}, "Mining", "Stone+100", {_stoneAndDeepslate})
		set {_yamlValue} to "Achievement.Mining.Stone.1000"
		achievementYaml({_p}, "Mining", "Stone+1000", {_stoneAndDeepslate})
		set {_yamlValue} to "Achievement.Mining.Stone.10000"
		achievementYaml({_p}, "Mining", "Stone+10000", {_stoneAndDeepslate})
		set {_yamlValue} to "Achievement.Mining.Stone.100000"
		achievementYaml({_p}, "Mining", "Stone+100000", {_stoneAndDeepslate})
		set {_yamlValue} to "Achievement.Mining.Stone.1000000"
		achievementYaml({_p}, "Mining", "Stone+1000000", {_stoneAndDeepslate})
		addPlayerXP({_p}, 1, 1, "mining")
		addMiningXP({_p}, 1)
		set {expkopanie::%{_p}%} to {expkopanie::%{_p}%} + 1
		set {weeklyStoneMined::%{_p}%} to {weeklyStoneMined::%{_p}%} + 1
		set {totalStoneMined::%{_p}%} to {totalStoneMined::%{_p}%} + 1
		set {_data} to data()
		chance of 1%:
			set {skrzynka::%{_p}%} to {skrzynka::%{_p}%} + 1
			addMiningStat({_p}, "Chests Found")
			set {_otxp} to 6
			set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
			add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
			addMiningXP({_p}, {_otxp})
			if {_otxpAfterMultiplier} > {_otxp}:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
			else:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

			drop {skrzynka} at {_b}
			send "&8[&6Earthcraft&8] &7Congratulations! You found a &9Chest&7! %{_xpmsg}%" to {_p}

			set {_yamlValue} to "Achievement.Mining.Chest.100"
			achievementYaml({_p}, "Mining", "Chest+100", {skrzynka::%{_p}%})
			set {_yamlValue} to "Achievement.Mining.Chest.1000"
			achievementYaml({_p}, "Mining", "Chest+1000", {skrzynka::%{_p}%})
		chance of 0.3%:
			set {skrzynkaluksus::%{_p}%} to {skrzynkaluksus::%{_p}%} + 1
			addMiningStat({_p}, "Luxurious Chests Found")
			set {_otxp} to 14
			set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
			add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
			addMiningXP({_p}, {_otxp})
			if {_otxpAfterMultiplier} > {_otxp}:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
			else:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

			drop {skrzynkaluksusowa} at {_b}
			send "&8[&6Earthcraft&8] &7Congratulations! You found a &9Luxurious Chest&7! %{_xpmsg}%" to {_p}

			set {_yamlValue} to "Achievement.Mining.LuxuriousChest.100"
			achievementYaml({_p}, "Mining", "LuxuriousChest+100", {skrzynkaluksus::%{_p}%})
			set {_yamlValue} to "Achievement.Mining.LuxuriousChest.1000"
			achievementYaml({_p}, "Mining", "LuxuriousChest+1000", {skrzynkaluksus::%{_p}%})
		
		if {diademdrop::%{_p}%} = "esencje":
			set {_che} to 2 + ({bonusesencja::%{_p}%}*4)
		else:
			set {_che} to 0.5 + {bonusesencja::%{_p}%}
		if int tag "Enchant;Essence Reaver" of (custom nbt of {_p}'s tool) = 1:
			set {_che} to {_che}*1.04
		
		chance of {_che}%:
			loop yaml node keys "" in "ItemList":
				if loop-value-2 contains " Essence":
					set {_essences::*} to {_essences::*} and yaml value "%loop-value-2%.Item" in "ItemList"

			set {_essence} to a random element of {_essences::*}
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Essenceful", "Esencyjność", {_damount})
			loop {_damount} times:
				drop {_essence} at {_b}
				set {_essencesFound} to addMiningStat({_p}, "Essences Found")
				if {_essencesFound} = 100:
					set {_yamlValue} to "Achievement.Mining.Essences.100"
					achievementYaml({_p}, "Mining", "Essences+100", {_essencesFound})
				else if {_essencesFound} = 1000:
					set {_yamlValue} to "Achievement.Mining.Essences.1000"
					achievementYaml({_p}, "Mining", "Essences+1000", {_essencesFound})
				addMiningStat({_p}, "Essences.%{_essenceName}%")
				set {_otxp} to 12
				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})
				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"
				send "&8[&6Earthcraft&8] &7Congratulations! You found a %name of {_essence}%&7! %{_xpmsg}%" to {_p}

		set {_chanceSapphire} to 2
		chance of {_chanceSapphire}%:
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Christmas Baubles", "Świąteczne Ozdoby", {_damount})
			loop {_damount} times:
				set {_sapphire} to addMiningStat({_p}, "Sapphire")

				if {_sapphire} = 100:
					set {_yamlValue} to "Achievement.Mining.Sapphire.100"
					achievementYaml({_p}, "Mining", "Sapphire+100", {_sapphire})
				else if {_sapphire} = 1000:
					set {_yamlValue} to "Achievement.Mining.Sapphire.1000"
					achievementYaml({_p}, "Mining", "Sapphire+1000", {_sapphire})

				set {_otxp} to 2.5

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

				set {_item} to yaml value "Sapphire.Item" in "ItemList"
				drop {_item} at {_b}
				send "&8[&6Earthcraft&8] &7Congratulations! You found a <##025b95>Sapphire&7! %{_xpmsg}%" to {_p}

		set {_chanceKlejnot} to 1 #+ {bonusklejnot::%{_p}%} + {rangaklejnot::%{_p}%}
		#if int tag "Enchant;Treasure Seeker" of (custom nbt of {_p}'s tool) = 1:
			#set {_chk} to {_chk}*1.05
			
		chance of {_chanceKlejnot}%:
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Klejnots for Stavros", "Klejnoty dla Stavrosa", {_damount})
			loop {_damount} times:
				#if {klejnot::%{_p}%} = 300:
				#	set {rangaklejnot::%{_p}%} to 0.5
				#	broadcast "&8[&6Earthcraft&8] &7Gracz &6%{_p}% &7osiągnął &6rangę 1 &7[&e&l✰&8&l✰✰&7] &7na <##b5e550>Klejnocie&7!"
				#	soundRankup({_p})
				#if {klejnot::%{_p}%} = 600:
				#	set {rangaklejnot::%{_p}%} to 1
				#	broadcast "&8[&6Earthcraft&8] &7Gracz &6%{_p}% &7osiągnął &6rangę 2 &7[&e&l✰✰&8&l✰&7] &7na <##b5e550>Klejnocie&7!"
				#	soundRankup({_p})
				#if {klejnot::%{_p}%} = 1200:
				#	set {rangaklejnot::%{_p}%} to 1.5
				#	broadcast "&8[&6Earthcraft&8] &7Gracz &6%{_p}% &7osiągnął &6rangę 3 &7[&e&l✰✰✰&7] &7na <##b5e550>Klejnocie&7!"
				#	soundRankup({_p})

				set {_klejnot} to addMiningStat({_p}, "Klejnot")

				if {_klejnot} = 100:
					set {_yamlValue} to "Achievement.Mining.Klejnot.100"
					achievementYaml({_p}, "Mining", "Klejnot+100", {_klejnot})
				else if {_klejnot} = 1000:
					set {_yamlValue} to "Achievement.Mining.Klejnot.1000"
					achievementYaml({_p}, "Mining", "Klejnot+1000", {_klejnot})

				set {_otxp} to 5

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

				set {_item} to yaml value "Klejnot.Item" in "ItemList"
				drop {_item} at {_b}
				send "&8[&6Earthcraft&8] &7Congratulations! You found a <##b5e550>Klejnot&7! %{_xpmsg}%" to {_p}

		set {_chanceAzerite} to 2
		chance of {_chanceAzerite}%:
			set {_heart} to getHeartOfEarthcraft({_p})
			if {_p}'s chestplate = {_heart}:
				set {_randomAzerite} to a random integer between 1 and 15
				addAzerite({_p}, {_randomAzerite})
				set {_azerite} to addMiningStat({_p}, "Azerite", {_randomAzerite})

				achievementYaml({_p}, "Mining", "Azerite+1000", {_randomAzerite})
				achievementYaml({_p}, "Mining", "Azerite+100000", {_randomAzerite})

				set {_otxp} to 2.5

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "azerite")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

		set {_chanceRuby} to 0.5
		chance of {_chanceRuby}%:
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Christmas Baubles", "Świąteczne Ozdoby", {_damount})
			loop {_damount} times:
				set {_ruby} to addMiningStat({_p}, "Ruby")

				if {_ruby} = 100:
					set {_yamlValue} to "Achievement.Mining.Ruby.100"
					achievementYaml({_p}, "Mining", "Ruby+100", {_ruby})
				else if {_ruby} = 1000:
					set {_yamlValue} to "Achievement.Mining.Ruby.1000"
					achievementYaml({_p}, "Mining", "Ruby+1000", {_ruby})

				set {_otxp} to 10

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

				set {_item} to yaml value "Ruby.Item" in "ItemList"
				drop {_item} at {_b}
				send "&8[&6Earthcraft&8] &7Congratulations! You found a <##ff0000>Ruby&7! %{_xpmsg}%" to {_p}

		set {_chanceAmethyst} to 0.25
		chance of {_chanceAmethyst}%:
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Christmas Baubles", "Świąteczne Ozdoby", {_damount})
			loop {_damount} times:
				set {_amethyst} to addMiningStat({_p}, "Amethyst")

				if {_amethyst} = 100:
					set {_yamlValue} to "Achievement.Mining.Amethyst.100"
					achievementYaml({_p}, "Mining", "Amethyst+100", {_amethyst})
				else if {_amethyst} = 1000:
					set {_yamlValue} to "Achievement.Mining.Amethyst.1000"
					achievementYaml({_p}, "Mining", "Amethyst+1000", {_amethyst})

				set {_otxp} to 20

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

				set {_item} to yaml value "Amethyst.Item" in "ItemList"
				drop {_item} at {_b}
				send "&8[&6Earthcraft&8] &7Congratulations! You found a <##ae78d0>Amethyst&7! %{_xpmsg}%" to {_p}

		set {_chanceTopaz} to 0.125
		chance of {_chanceTopaz}%:
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Christmas Baubles", "Świąteczne Ozdoby", {_damount})
			loop {_damount} times:
				set {_topaz} to addMiningStat({_p}, "Topaz")

				if {_topaz} = 100:
					set {_yamlValue} to "Achievement.Mining.Topaz.100"
					achievementYaml({_p}, "Mining", "Topaz+100", {_topaz})
				else if {_topaz} = 1000:
					set {_yamlValue} to "Achievement.Mining.Topaz.1000"
					achievementYaml({_p}, "Mining", "Topaz+1000", {_topaz})

				set {_otxp} to 40

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

				set {_item} to yaml value "Topaz.Item" in "ItemList"
				drop {_item} at {_b}
				send "&8[&6Earthcraft&8] &7Congratulations! You found a <##ffe505>Topaz&7! %{_xpmsg}%" to {_p}

		set {_chanceAquamarine} to 0.0625
		chance of {_chanceAquamarine}%:
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Christmas Baubles", "Świąteczne Ozdoby", {_damount})
			loop {_damount} times:
				set {_aquamarine} to addMiningStat({_p}, "Aquamarine")

				if {_aquamarine} = 100:
					set {_yamlValue} to "Achievement.Mining.Aquamarine.100"
					achievementYaml({_p}, "Mining", "Aquamarine+100", {_aquamarine})
				else if {_aquamarine} = 1000:
					set {_yamlValue} to "Achievement.Mining.Aquamarine.1000"
					achievementYaml({_p}, "Mining", "Aquamarine+1000", {_aquamarine})

				set {_otxp} to 80

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

				set {_item} to yaml value "Aquamarine.Item" in "ItemList"
				drop {_item} at {_b}
				send "&8[&6Earthcraft&8] &7Congratulations! You found a <##11d7d8>Aquamarine&7! %{_xpmsg}%" to {_p}

		set {_chancePeridot} to 0.03125
		chance of {_chancePeridot}%:
			set {_damount} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_damount} to 2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Christmas Baubles", "Świąteczne Ozdoby", {_damount})
			loop {_damount} times:
				set {_peridot} to addMiningStat({_p}, "Peridot")

				if {_peridot} = 100:
					set {_yamlValue} to "Achievement.Mining.Peridot.100"
					achievementYaml({_p}, "Mining", "Peridot+100", {_peridot})
				else if {_peridot} = 1000:
					set {_yamlValue} to "Achievement.Mining.Peridot.1000"
					achievementYaml({_p}, "Mining", "Peridot+1000", {_peridot})

				set {_otxp} to 160

				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxpAfterMultiplier} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})

				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"

				set {_item} to yaml value "Peridot.Item" in "ItemList"
				drop {_item} at {_b}
				send "&8[&6Earthcraft&8] &7Congratulations! You found a <##c0ff02>Peridot&7! %{_xpmsg}%" to {_p}
		
		set {_chanceAmber} to 0.2
		if int tag "Enchant;Archeologist" of (custom nbt of {_p}'s tool) = 1:
			set {_chanceAmber} to {_chanceAmber}*1.03
		chance of {_chanceAmber}%:
			set {_preznal} to 1
			if {podwojnydrop::%{_p}%} = true:
				set {_preznal} to {_preznal}*2
			if {gornictwo::preznal::%{_p}%} is true:
				chance of 20%:
					set {_preznal} to {_preznal}*2
			#if {winterDelightPassLEVEL::%{_p}%} >= 0:
			#	getMission({_p}, "Magnus's Request", "Prośba Magnusa", {_preznal})
			loop {_preznal} times:
				set {_amber} to addMiningStat({_p}, "Amber")

				if {_amber} = 100:
					set {_yamlValue} to "Achievement.Mining.Amber.100"
					achievementYaml({_p}, "Mining", "Amber+100", {_amber})
				else if {_amber} = 1000:
					set {_yamlValue} to "Achievement.Mining.Amber.1000"
					achievementYaml({_p}, "Mining", "Amber+1000", {_amber})

				set {_otxp} to 30
				set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxp} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})
				drop {bursztyn} at {_b}

			if {_preznal} > 1:
				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "(<##ffab24>x%{_preznal}%&7) (+%{_otxpAfterMultiplier}*{_preznal}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "(<##ffab24>x%{_preznal}%&7) (+%{_otxpAfterMultiplier}*{_preznal}% &7XP)"
			else:
				if {_otxpAfterMultiplier} > {_otxp}:
					set {_xpmsg} to "(+%{_otxpAfterMultiplier}*{_preznal}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
				else:
					set {_xpmsg} to "(+%{_otxpAfterMultiplier}*{_preznal}% &7XP)"
			send "&8[&6Earthcraft&8] &7Congratulations! You found an <##ffab24>Amber&7! %{_xpmsg}%" to {_p}
		#DIAMONDSHARD
		#chance of 0.05%:
			#set {diamondshards::%{_p}%} to {diamondshards::%{_p}%} + 1
			#set {_yamlValue} to "Achievement.Mining.Diamondshards.100"
			#achievementYaml({_p}, "plugins/Skript/playerdata/achievements", "Achievements", {_yamlValue}, "ADiamond Specialist", "Find 100 Diamond Shards when mining.")
			#set {_otxpAfterMultiplier} to 60
			#set {_otxpAfterMultiplier} to addPlayerXP({_p}, {_otxp}, 1, "mining")
			#if {language::%{_p}%} = "English":
				#drop {diamondshard} at {_b}
				#send "&8[&6Earthcraft&8] &7Congratulations! You found a &bDiamond Shard&7! %{_xpmsg}%" to {_p}
			#else:
				#drop {diamondshard} at {_b}
				#send "&8[&6Earthcraft&8] &7Gratulacje! Wykopałeś/aś &bDiamentowy Odłamek&7! %{_xpmsg}%" to {_p}
		if {szafirowafigurka::%{_p}%} is true:
			chance of 2%:
				drop {szafirowafigurka} at {_p}
				set {szafirowefigurki::%{_p}%} to {szafirowefigurki::%{_p}%} + 1
				if {szafirowefigurki::%{_p}%} = 100:
					strike lightning effect at {_p}
					set {osiagniecie.100szaffig::%{_p}%} to true
					loop all players:
						send formatted "&fGracz %{_p}% właśnie zdobył osiągnięcie <tooltip:&aWykop 100 szafirowych figurek>&a[Kolekcjoner]" to loop-player
				set {_otxp} to 2.5
				set {_otxp} to addPlayerXP({_p}, {_otxp}, 1, "mining")
				add {_otxp} to {expkopanie::%{_p}%}
				addMiningXP({_p}, {_otxp})
				send "&8[&6Earthcraft&8] &7Gratulacje! Wykopałeś/aś <##025b95>Szafirową Figurkę&7! &7(+%{_otxp}% &7XP)" to {_p}
		UpdateScoreboard({_p})

		if yaml "data-%{_p}%" is loaded:
			set {_allTimeStone} to yaml value "Player.All Time.Stone Mined" in "data-%{_p}%"
			set {_allTimeStone} to {_allTimeStone} + {_blok}
			set yaml value "Player.All Time.Stone Mined" in "data-%{_p}%" to {_allTimeStone}

			set {_updateStone} to yaml value "Player.Per Update.%{currentUpdate}%.Stone Mined" in "data-%{_p}%"
			set {_updateStone} to {_updateStone} + {_blok}
			set yaml value "Player.Per Update.%{currentUpdate}%.Stone Mined" in "data-%{_p}%" to {_updateStone}

			save yaml "data-%{_p}%"
variables:
	#{kolorek1::%{_p}%} = "&6"
	{poziom::%player%} = 0
	{poziomgornictwo::%player%} = 0

on entity breed:
	set {%event-entity%::%breeder%} to {%event-entity%::%breeder%} + 1
	set {_xp} to addPlayerXP(breeder, 3)
	add {_xp} to {expbreeding::%player%}
	UpdateScoreboard(breeder)

on form of stone:
	cancel event

on join:
	UpdateScoreboard(player)
on rightclick:
	if "%region at player%" does not contain "spawn" or "oldspawn":
		if player is not sneaking:
			if clicked block is sweet berry bush:
				if block data tag "age" of clicked block = 3:
					add 2 to {berry::%player%}
					set {_xp} to addPlayerXP(player, 0.4)
					add {_xp} to {expharvest::%player%}
					UpdateScoreboard(player)
				if block data tag "age" of clicked block = 2:
					set {berry::%player%} to {berry::%player%} + 1
					set {_xp} to addPlayerXP(player, 0.2)
					add {_xp} to {expharvest::%player%}
					UpdateScoreboard(player)
	if player's tool is bone meal:
		if block data tag "age" of clicked block < 7:
			if "%region at player%" does not contain "spawn" or "oldspawn":
				set {bonemeal::%player%} to {bonemeal::%player%} + 1
				set {_xp} to addPlayerXP(player, 0.3)
				add {_xp} to {expbonemeal::%player%}
				UpdateScoreboard(player)

on mine:
	if player's gamemode is survival:
		if region at event-location is not set:
			if event-block = cobblestone:
				set {cobblestone::%player%} to {cobblestone::%player%} + 1
				set {_xp} to addPlayerXP(player, 0.5)
				set {expkopanie::%player%} to {expkopanie::%player%} + {_xp}
			else if event-block = nether gold ore:
				set {nethergold::%player%} to {nethergold::%player%} + 1
				set {_xp} to addPlayerXP(player, 1.75)
				set {expkopanie::%player%} to {expkopanie::%player%} + {_xp}
			else if event-block = obsidian:
				set {obsidian::%player%} to {obsidian::%player%} + 1
				set {_xp} to addPlayerXP(player, 4)
				set {expkopanie::%player%} to {expkopanie::%player%} + {_xp}
			else if event-block = dirt:
				set {dirt::%player%} to {dirt::%player%} + 1
				set {_xp} to addPlayerXP(player, 0.5)
				add {_xp} to {expdigging::%player%}
			else if event-block = end stone:
				set {endstone::%player%} to {endstone::%player%} + 1
				set {_xp} to addPlayerXP(player, 1)
				set {expkopanie::%player%} to {expkopanie::%player%} + {_xp}
			else if event-block = gravel:
				set {gravel::%player%} to {gravel::%player%} + 1
				set {_xp} to addPlayerXP(player, 0.5)
				add {_xp} to {expdigging::%player%}
			else if event-block = sand:
				set {sand::%player%} to {sand::%player%} + 1
				set {_xp} to addPlayerXP(player, 0.5)
				add {_xp} to {expdigging::%player%}
			else if event-block = netherrack:
				set {netherrack::%player%} to {netherrack::%player%} + 1
				set {_xp} to addPlayerXP(player, 0.1)
				set {expkopanie::%player%} to {expkopanie::%player%} + {_xp}
			else if event-block is beetroots:
				if age of event-block = 3:
					set {beetroot::%player%} to {beetroot::%player%} + 1
					set {_xp} to addPlayerXP(player, 0.5)
					add {_xp} to {expharvest::%player%}
			else if event-block is carrots:
				if age of event-block = 7:
					set {carrot::%player%} to {carrot::%player%} + 1
					set {_xp} to addPlayerXP(player, 0.5)
					add {_xp} to {expharvest::%player%}
			else if event-block is wheat:
				if age of event-block = 7:
					set {wheat::%player%} to {wheat::%player%} + 1
					set {_xp} to addPlayerXP(player, 0.5)
					add {_xp} to {expharvest::%player%}
			else if event-block is potatoes:
				if age of event-block = 7:
					set {potato::%player%} to {potato::%player%} + 1
					set {_xp} to addPlayerXP(player, 0.5)
					add {_xp} to {expharvest::%player%}
			else if event-block is tagged with tag "wood":
				set {%event-block%::%player%} to {%event-block%::%player%} + 1
				set {_xp} to addPlayerXP(player, 1)
				add {_xp} to {expwood::%player%}
			else if event-block is tagged with tag "logs":
				set {%event-block%::%player%} to {%event-block%::%player%} + 1
				set {_xp} to addPlayerXP(player, 1)
				add {_xp} to {expwood::%player%}
			else if event-block is tagged with tag "stripped_logs":
				set {%event-block%::%player%} to {%event-block%::%player%} + 1
				set {_xp} to addPlayerXP(player, 1)
				add {_xp} to {expwood::%player%}
			else if event-block is tagged with tag "leaves":
				set {%event-block%::%player%} to {%event-block%::%player%} + 1
				set {_xp} to addPlayerXP(player, 0.25)
				add {_xp} to {expleaves::%player%}
			UpdateScoreboard(player)
	

on break of melon:
	if region at event-location is not set:
		set {melon::%player%} to {melon::%player%} + 1
		set {_xp} to addPlayerXP(player, 3)
		add {_xp} to {expharvest::%player%}
		UpdateScoreboard(player)
on break of pumpkin:
	if region at event-location is not set:
		set {pumpkin::%player%} to {pumpkin::%player%} + 1
		set {_xp} to addPlayerXP(player, 3)
		add {_xp} to {expharvest::%player%}
		UpdateScoreboard(player)
		
on death:
	if attacker is a player:
		if {passivemobs::*} contains "%type of victim%":
			if boolean tag "ECMob" of custom nbt of victim is not set:
				set {_xp} to addPlayerXP(attacker, 2)
				add {_xp} to {%type of victim%::%attacker%}
				UpdateScoreboard(victim)
on block place:
	if event-block is tagged with block tag "glass_panes":
		if name of player's tool is set:
			cancel event

	else if event-block is tagged with paper tag "ores":
		set {placed::%event-block%} to true
		if player's gamemode is survival:
			if (player's offhand item) is tagged with paper tag "ores":
				cancel event

	if event is not cancelled:
		set {_bannedBlocks::*} to stone and deepslate and player head
		if {_bannedBlocks::*} does not contain (1 of player's offhand item):
			set {blocksplaced::%player%} to {blocksplaced::%player%} + 1
			if cooldown "place%player%" is not finished:
				stop
			else:
				create cooldown "place%player%" for 0.25 seconds
				set {_xp} to addPlayerXP(player, 1, 1, "Building")
				add {_xp} to {expbudowanie::%player%}
				UpdateScoreboard(player)
				#if {winterDelightPassLEVEL::%player%} >= 0:
					#getMission(player, "Building the World", "Budowanie Świata", 1)
			
function KolorekScoreboard(p: player) :: string:
	if {poziom::%{_p}%} >= 100:
		set {_kolorek} to formatted {kolorek1::%{_p}%}
	else if {poziom::%{_p}%} is smaller than 10:
		set {_kolorek} to "&6"
	else if {poziom::%{_p}%} is smaller than 20:
		if {poziom::%{_p}%} is bigger than 9:
			set {_kolorek} to "&b"
	else if {poziom::%{_p}%} is smaller than 30:
		if {poziom::%{_p}%} is bigger than 19:
			set {_kolorek} to "&c"
	else if {poziom::%{_p}%} is smaller than 40:
		if {poziom::%{_p}%} is bigger than 29:
			set {_kolorek} to "&d"
	else if {poziom::%{_p}%} is smaller than 50:
		if {poziom::%{_p}%} is bigger than 39:
			set {_kolorek} to "&a"
	else if {poziom::%{_p}%} is smaller than 60:
		if {poziom::%{_p}%} is bigger than 49:
			set {_kolorek} to "&9"
	else if {poziom::%{_p}%} is smaller than 70:
		if {poziom::%{_p}%} is bigger than 59:
			set {_kolorek} to "&e"
	else if {poziom::%{_p}%} is smaller than 80:
		if {poziom::%{_p}%} is bigger than 69:
			set {_kolorek} to "&5"
	else if {poziom::%{_p}%} is smaller than 90:
		if {poziom::%{_p}%} is bigger than 79:
			set {_kolorek} to "&3"
	else if {poziom::%{_p}%} is smaller than 100:
		if {poziom::%{_p}%} is bigger than 89:
			set {_kolorek} to "&4"
	return {_kolorek}

function UpdateScoreboard(p: player):
	if metadata value "ECEngaged" of {_p} is not set:
		if metadata value "DungeonInstance" of {_p} is not set:
			if metadata value "IslandExpeditionInstance" of {_p} is not set:
				if {scorepl::%{_p}%} is not false:
					set {_kolorek} to KolorekScoreboard({_p})
					if title of {_p}'s fastboard is set:
						if title of {_p}'s fastboard != "&f&l«-───▬ %{_kolorek}%&lEC &f&l▬───-»":
							clear {_p}'s fastboard
					set {_e} to uncolored {kartaname::%{_p}%}
					set title of {_p}'s fastboard to "&f&l«-───▬ %{_kolorek}%&lEC &f&l▬───-»"
					set line 2 of {_p}'s fastboard to ""
					set line 3 of {_p}'s fastboard to " %{_kolorek}%&l* &f&lPLAYER:"
					set line 4 of {_p}'s fastboard to " &fCard: %{_kolorek}%%{_e}%"
					set line 5 of {_p}'s fastboard to " &fStone Mined: %{_kolorek}%%{stone::%{_p}%} + {deepslate::%{_p}%}*2%"
					set line 6 of {_p}'s fastboard to " &fLevel: %{_kolorek}%%{poziom::%{_p}%}%"
					set line 7 of {_p}'s fastboard to " &fXP: %{_kolorek}%%{exp::%{_p}%}%&8/%{_kolorek}%%100*{poziom::%{_p}%}%"
					set {_c} to rounded down {exp::%{_p}%}/({poziom::%{_p}%}*100)*10
					if {_c} = 0:
						set line 8 of {_p}'s fastboard to "    &8&l■■■■■■■■■■"
					if {_c} = 1:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■&8&l■■■■■■■■■"
					if {_c} = 2:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■&8&l■■■■■■■■"
					if {_c} = 3:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■&8&l■■■■■■■"
					if {_c} = 4:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■■&8&l■■■■■■"
					if {_c} = 5:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■■■&8&l■■■■■"
					if {_c} = 6:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■■■■&8&l■■■■"
					if {_c} = 7:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■■■■■&8&l■■■"
					if {_c} = 8:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■■■■■■&8&l■■"
					if {_c} = 9:
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■■■■■■■&8&l■"
					if {_c} = 10:	
						set line 8 of {_p}'s fastboard to "    %{_kolorek}%&l■■■■■■■■■■"
					set line 9 of {_p}'s fastboard to ""
					set line 10 of {_p}'s fastboard to "  &f&l«-───▬ %{_kolorek}%&lEC &f&l▬───-»"
			else:
				islandExpeditionFastboard({_p})
function soundRankup(p:player):
	play sound "entity.generic.explode" with volume 5 and pitch 1 at {_p}
	play sound "block.note_block.harp" with volume 5 and pitch 2 at {_p}

on mine of stone:
	set {_x} to int tag "minecraft:enchantments;levels;minecraft:efficiency" of (nbt of player's tool)
	if {_x} > 5:
		set int tag "minecraft:enchantments;levels;minecraft:efficiency" of (nbt of player's tool) to 5
	if player has haste:
		remove haste from player
	if player's gamemode is survival:
		if metadata value "StoneDropDisabled" of player = true:
			clear drops
		if {umkilof::%player%} = "Instalacje Ogrzewcze":
			clear drops
			drop 1 stone at event-block
		if "%region at event-block%" contains "NewPlayerArea":
			StoneRefresh(event-location)
			StoneTutorial(player)	
		else:
			minenew(player, "stone", event-block)
		if {gornictwo::poszumine::%player%} is true:
			chance of 1%:
				set {_f} to 1
				loop 3 times:
					play sound "block.note_block.xylophone" with volume 3 and pitch 1 to player
					add 0.3 to {_f}
					wait 0.3 seconds
				set {_czkamien} to a random integer between 1 and 11
				if {_czkamien} = 1:
					set event-block to red stained glass
				if {_czkamien} = 2:
					set event-block to lime stained glass
				if {_czkamien} = 3:
					set event-block to green stained glass
				if {_czkamien} = 4:
					set event-block to light blue stained glass
				if {_czkamien} = 5:
					set event-block to orange stained glass
				if {_czkamien} = 6:
					set event-block to yellow stained glass
				if {_czkamien} = 7:
					set event-block to magenta stained glass
				if {_czkamien} = 8:
					set event-block to purple stained glass
				if {_czkamien} = 9:
					set event-block to white stained glass
				if {_czkamien} = 10:
					set event-block to light gray stained glass
				if {_czkamien} = 11:
					set event-block to blue stained glass
				set {czystykamien::%event-block%} to true
				play sound "entity.player.levelup" with volume 3 and pitch 1 to player
				play sound "block.glass.break" with volume 3 and pitch 1.7 to player
on mine of deepslate:
	if region at event-location is not set:
		set {_x} to int tag "minecraft:enchantments;levels;minecraft:efficiency" of (nbt of player's tool)
		if {_x} > 5:
			set int tag "minecraft:enchantments;levels;minecraft:efficiency" of (nbt of player's tool) to 5
		if player has haste:
			remove haste from player
		if player's gamemode is survival:
			if metadata value "StoneDropDisabled" of player = true:
				clear drops
			minenew(player, "deepslate", event-block)
			if {gornictwo::poszumine::%player%} is true:
				chance of 2%:
					set {_f} to 1
					loop 3 times:
						play sound "block.note_block.xylophone" with volume 3 and pitch 1 to player
						add 0.3 to {_f}
						wait 0.3 seconds
					set {_czkamien} to a random integer between 1 and 11
					if {_czkamien} = 1:
						set event-block to red stained glass
					if {_czkamien} = 2:
						set event-block to lime stained glass
					if {_czkamien} = 3:
						set event-block to green stained glass
					if {_czkamien} = 4:
						set event-block to light blue stained glass
					if {_czkamien} = 5:
						set event-block to orange stained glass
					if {_czkamien} = 6:
						set event-block to yellow stained glass
					if {_czkamien} = 7:
						set event-block to magenta stained glass
					if {_czkamien} = 8:
						set event-block to purple stained glass
					if {_czkamien} = 9:
						set event-block to white stained glass
					if {_czkamien} = 10:
						set event-block to light gray stained glass
					if {_czkamien} = 11:
						set event-block to blue stained glass
					set {czystykamien::%event-block%} to true
					play sound "entity.player.levelup" with volume 3 and pitch 1 to player
					play sound "block.glass.break" with volume 3 and pitch 1.7 to player
on mine of iron ore:
	if player's gamemode is survival:
		if {umkilof::%player%} = "Magnes":
			loop all blocks in radius 4 around event-block:
				if loop-block is iron ore:
					if {placed::%loop-block%} is not true:
						set loop-block to air
						drop iron ore at loop-block
						set {_wyk} to {_wyk} + 1
						if {poziomgornictwo::%player%} > 44:
							set {_otxp} to 5
						else:
							set {_otxp} to 4
						set {_otxpAfterMultiplier} to addPlayerXP(player, {_otxp}, 1, "mining")
						add {_otxpAfterMultiplier} to {expkopanie::%player%}
						addMiningXP(player, {_otxp})
						add {_otxp} to {_otxpT}
						add {_otxpAfterMultiplier} to {_otxpAfterMultiplierT}
						set {zelazo::%player%} to {zelazo::%player%} + 1
						set {zelazocount::%player%} to {zelazocount::%player%} + 1
						if {zelazocount::%player%} > 2:
							if player can hold iron ingot:
								give 1 iron ingot to player
							else:
								drop 1 iron ingot at player
							play sound "block.anvil.place" with volume 3 and pitch 1.8 to player
							remove 3 from {zelazocount::%player%}
						play sound "block.note_block.iron_xylophone" with volume 3 and pitch 0.6 at player
						if {gornictwo::stardust::%player%} is true:
							set {_dr} to a random integer between 2 and 3
							add {_dr} to {stardust::%player%}
							add {_dr} to {_otst}
			if {_otxpAfterMultiplierT} > {_otxpT}:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplierT}% &7XP) (&fx%{_otxpAfterMultiplierT}/{_otxpT}%&7)"
			else:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplierT}% &7XP)"
			if {_wyk} = 1:
				send "&8[&6Earthcraft&8] &7Congratulations! You receive an &6Iron Ore&7! %{_xpmsg}%" to player
			else:
				if {_wyk} is set:
					send "&8[&6Earthcraft&8] &7Congratulations! You receive &6%{_wyk}% &6Iron Ores&7! %{_xpmsg}%" to player
			if {_wyk} is set:
				send "&8[&6Earthcraft&8] &7You receive &6%{_otst}% &r%{stardust}'s name%u &7from the ores mined&7!" to player
				play sound "entity.experience_orb.pickup" with volume 3 and pitch 1.3 at player
				#create a hologram at block above event-block with the id "sd-%location of event-block%"
				#add line "&e+%{_otst}% <##6518ba>S<##942cce>t<##a925d9>a<##f346d1>r<##f37646>d<##f38646>u<##f18d18>s<##f3d846>t" to the hologram with id "sd-%location of event-block%"
				#wait 2 seconds
				#delete the hologram with the id "sd-%location of event-block%"
on block break:
	if player's gamemode is survival:
		if "%region at player%" contains "spawn":
			if event-block is not stone:
				cancel event
on rightclick:
	if player's gamemode is survival:
		if "%region at player%" contains "spawn":
			if clicked player does not exist:
				if player's tool is not a fishing rod:
					if clicked block is not tagged with tag "doors":
						cancel event
on mine:
	if event-block is tagged with paper tag "ores":
		if {placed::%event-block%} is not true:
			if region at event-location is not set:
				if player's gamemode is survival:
					if event-block is diamond ore:
						set {_otxp} to 8
						set {diamenty::%player%} to {diamenty::%player%} + 1
						set {_otxpAfterMultiplier} to addPlayerXP(player, {_otxp}, 1, "mining")
						add {_otxpAfterMultiplier} to {expkopanie::%player%}
						addMiningXP(player, {_otxp})
						if {_otxpAfterMultiplier} > {_otxp}:
							set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
						else:
							set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"
						send "&8[&6Earthcraft&8] &7You mine a <##bfbfff>Diamond Ore&7. %{_xpmsg}%" to player
					else if event-block is emerald ore:
						set {_otxp} to 16
						set {emerald::%player%} to {emerald::%player%} + 1
						set {_otxpAfterMultiplier} to addPlayerXP(player, {_otxp}, 1, "mining")
						add {_otxpAfterMultiplier} to {expkopanie::%player%}
						addMiningXP(player, {_otxp})
						if {_otxpAfterMultiplier} > {_otxp}:
