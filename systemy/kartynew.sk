variables:
	{maxCardLevel} = 60
	{baseMaxCardLevel} = 50

import:
	java.io.File

function newCardAssignments(p: player, card: item, ele: string, prim: string, icon: string = "") :: item:
	set {_y} to data()
	set {_id} to random 8 char string from charset `0-9` `a-z`
	add "&8Id: %{_id}%" to lore of {_card}
	add "&8Dropped: %{_y}%" to lore of {_card}

	set {_customNbt} to custom nbt of {_card}

	set string tag "Element" of {_customNbt} to {_ele}
	set boolean tag "Card" of {_customNbt} to true

	set int tag "Stats;%{_prim}%" of {_customNbt} to 0
	set int tag "Stats;Health" of {_customNbt} to 0
	set int tag "Stats;Damage" of {_customNbt} to 0
	set int tag "Stats;Resistance" of {_customNbt} to 0
	set int tag "Stats;Mobility" of {_customNbt} to 0
	set int tag "Stats;Utility" of {_customNbt} to 0
	set int tag "Stats;Crowd Control" of {_customNbt} to 0
	set int tag "Stats;Versatility" of {_customNbt} to 0
	set int tag "Stats;Mastery" of {_customNbt} to 0
	set int tag "Stats;Critical Hit" of {_customNbt} to 0
	set int tag "Stats;Element" of {_customNbt} to 0
	set int tag "Stats;Haste" of {_customNbt} to 0
	set int tag "Stats;Avoidance" of {_customNbt} to 0

	set string tag "PrimaryStat" of {_customNbt} to {_prim}

	set string tag "CardIcon" of {_customNbt} to {_icon}

	set string tag "OriginalOwner" of {_customNbt} to {_p}'s name

	set int tag "MaxLevel" of {_customNbt} to 60
	set int tag "EquippedGems" of {_customNbt} to 0

	set string tag "Id" of {_customNbt} to {_id}

	set int tag "StellarPower" of {_customNbt} to 0


	return {_card}
	
on rightclick:
	if boolean tag "Card" of (custom nbt of player's tool) is not set:
		if line 19 of lore of player's tool contains "&8Id:":
			set boolean tag "Card" of (custom nbt of player's tool) to true
	else:
		if string tag "Id" of (custom nbt of player's tool) is set:
			cancel event if clicked entity is not item frame
			if target of player is a player:
				if target of player is not online:
					if (distance between (target of player) and player) < 7:
						stop

			else if metadata value "InstanceType" of player is set:
				cancel event
				set {_instanceType} to metadata value "InstanceType" of player
				send "&9You can't open the card menu while in a%{_instanceType}% instance." to player
				play sound "block.glass.break" with volume 3 and pitch 1 to player
				stop

			if player is alive:
				if metadata value "ECEngaged" of player is set:
					send "&9You can't open the card menu during combat." to player
					play sound "block.glass.break" with volume 3 and pitch 1 to player
					stop

				set {_id} to string tag "Id" of (custom nbt of player's tool)

				if {karta::%player%} is set:
					set {_idPreviousCard} to string tag "Id" of (custom nbt of {karta::%player%})
					if {_id} != {_idPreviousCard}:
						save yaml "activeCard-%player%"
						unload yaml "activeCard-%player%"
						load yaml "plugins/Skript/playerdata/karty/%uncolored (name of player's tool)%/%{_id}%.yml" as "activeCard-%player%"
				else:
					load yaml "plugins/Skript/playerdata/karty/%uncolored (name of player's tool)%/%{_id}%.yml" as "activeCard-%player%"

				SetPlayerStats(player) #Sets player stats to current selected card's stats (funkcje.sk)
				
				set {_cardName} to uncolored (name of player's tool)

				set {_currentVariant} to getCurrentVariant(player, {_cardName})

				if {_currentVariant} is not set:
					setCurrentVariant(player, {_cardName}, "Classic")
					set {_currentVariant} to "Classic"

				set {kartaname::%player%} to {_cardName}
				
				if yaml value "%{_cardName}%.%{_currentVariant}%.Colour.Primary" in "VariantList" is set:
					set {kartacolor::%player%} to yaml value "%{_cardName}%.%{_currentVariant}%.Colour.Primary" in "VariantList"
				else:
					set {kartacolor::%player%} to last string color code of (player's tool's name)

				set {_customNbt} to custom nbt of player's tool
				
				set {_cardLevel} to yaml value "Card.Level" in "activeCard-%player%"

				set {karta::%{_id}%} to {kartaname::%player%}
				set string tag "Owner" of {_customnbt} to "%player%"

				set {_elementText} to string tag "Element" of {_customnbt}
				set string tag "ECElement" of (custom nbt of player) to {_elementText} #Card's Element when receiving damage

				
				set {_primaryStatType} to string tag "PrimaryStat" of {_customnbt}
				set metadata value "PrimaryStatType" of player to {_primaryStatType}

				if string tag "OriginalOwner" of {_customnbt} is not set:
					set string tag "OriginalOwner" of {_customnbt} to player's name

				set string tag "Owner" of {_customNbt} to player's name

				set {_primarystat} to int tag "Stats;%{_primaryStatType}%" of {_customnbt}
				set {_health} to int tag "Stats;Health" of {_customnbt}
				set {_damage} to int tag "Stats;Damage" of {_customnbt}
				set {_resistance} to int tag "Stats;Resistance" of {_customnbt}
				set {_mobility} to int tag "Stats;Mobility" of {_customnbt}
				set {_utility} to int tag "Stats;Utility" of {_customnbt}
				set {_crowdcontrol} to int tag "Stats;Crowd Control" of {_customnbt}
				set {_versatility} to int tag "Stats;Versatility" of {_customnbt}
				set {_mastery} to int tag "Stats;Mastery" of {_customnbt}
				set {_criticalhit} to int tag "Stats;Critical Hit" of {_customnbt}
				set {_element} to int tag "Stats;Element" of {_customnbt}
				set {_haste} to int tag "Stats;Haste" of {_customnbt}
				set {_avoidance} to int tag "Stats;Avoidance" of {_customnbt}

				set {_total} to {_primarystat} + {_health} + {_damage} + {_resistance} + {_mobility} + {_utility} + {_crowdcontrol} + {_versatility} + {_mastery} + {_criticalhit} + {_element} + {_haste} + {_avoidance}

				set int tag "Stats;Total" of {_customnbt} to {_total}

				loop 12 times:
					if {trait::%{_id}%::%loop-number%} is set:
						set {hearttrait::%player%::%loop-number%} to {trait::%{_id}%::%loop-number%}
					
				set {_cardIcon} to getCardGlobalIcon(player)
				set string tag "CardIcon" of {_customnbt} to {_cardIcon}
				set {cardicon::%player%} to {_cardIcon}

				if name of player's tool contains "Brother Therold":
					set string tag "CardIcon" of {_customnbt} to ""
				else if name of player's tool contains "Glaceon":
					set string tag "CardIcon" of {_customnbt} to ""
					set metadata value "Fingers of Frost" of player to 0
				else if name of player's tool contains "Umbreon":
					set string tag "CardIcon" of {_customnbt} to ""
				else if name of player's tool contains "Delphox":
					set string tag "CardIcon" of {_customnbt} to ""
				else if name of player's tool contains "Buckshot":
					set string tag "CardIcon" of {_customnbt} to ""
				else if name of player's tool contains "Drogoz":
					set string tag "CardIcon" of {_customnbt} to ""
				else if name of player's tool contains "Shenhe":
					set string tag "CardIcon" of {_customnbt} to ""
				else if name of player's tool contains "Vaporeon":
					set string tag "CardIcon" of {_customnbt} to ""
				else if name of player's tool contains "Espeon":
					set string tag "CardIcon" of {_customnbt} to ""

				SetCardIcon(player)
				UpdateCard(player)
				UpdateScoreboard(player)

				if {damage::dealt::%{_id}%} is not set:
					set {damage::dealt::%{_id}%} to 0
				if {damage::taken::%{_id}%} is not set:
					set {damage::taken::%{_id}%} to 0

				if {kartaname::%player%} = "Umbreon":
					if boolean tag "Constellation;Featherfoot" of (custom nbt of {karta::%player%}) is set:
						if (time in world "world") is between 10:00 PM and 4:00 AM:
							set metadata value "UmbreonFeatherfoot" of player to 150
						else:
							set metadata value "UmbreonFeatherfoot" of player to 100
				else:
					clear metadata value "UmbreonFeatherfoot" of player

				set max health of player to 25 + ({health::%player%}/5)
				set scaled health of player to 20
				heal the player
				playerMoveSpeedUpdate(player)
				updateAzeriteArmorLore(player)

				if {mobskilled::%{kartaname::%player%}%::%{_id}%} is not set:
					set {mobskilled::%{kartaname::%player%}%::%{_id}%} to 0
				if {deaths::%{kartaname::%player%}%::%{_id}%} is not set:
					set {deaths::%{kartaname::%player%}%::%{_id}%} to 0

				set {_mobsK} to {mobskilled::%{kartaname::%player%}%::%{_id}%}
				set {_deaths} to {deaths::%{kartaname::%player%}%::%{_id}%}
				set {_damagedealt} to {damage::dealt::%{kartaname::%player%}%::%{_id}%}
				set {_damagetaken} to {damage::taken::%{kartaname::%player%}%::%{_id}%}

				set {_k} to {kartacolor::%player%}
				set metadata tag "kartagui" of player to chest inventory with 3 rows named "%uncolored (name of player's tool)% - Select Category"
				set {_gui} to (metadata tag "kartagui" of player)
				set slot integers between 0 and 26 of {_gui} to black stained glass pane named " "
				set slot 4 of {_gui} to player's tool with lore (lore of player's tool) and "&7&oYour current card"

				loop 5 times:
					if yaml value "Card.Talents.Row %loop-number%" in "activeCard-%player%" is not set:
						if loop-number <= 2:
							if (int tag "Level" of {_customnbt}) >= 15*loop-number:
								add 1 to {_talentPointsAvailable}
						else if loop-number = 3:
							if (int tag "Level" of {_customnbt}) >= 40:
								add 1 to {_talentPointsAvailable}
						else if loop-number = 4:
							if (int tag "Level" of {_customnbt}) >= 45:
								add 1 to {_talentPointsAvailable}
						else:
							if (int tag "Level" of {_customnbt}) >= 50:
								add 1 to {_talentPointsAvailable}

				set slot 9 of {_gui} to blue stained glass pane named "&9Cards Explained" with lore "&7Cards are &fcollectible playable characters &7that%nl%&7can be used in combat by the player.%nl% %nl%&7Cards can be &fleveled &7and may have their &fpower%nl%&fincreased &7through features including:%nl%&f- &6Talents &9(unlocked at certain levels)%nl%&f- &cConstellations &9(unlocked by collecting copies)%nl%&f- &eGear &9(dropped from mobs and endgame content)%nl%&f- &5Ability Levels &9(unlocked by expending materials)%nl%&f- &bAzerite Powers &9(found on Azerite Gear)%nl%&f- &aSpecializations &9(capstones unlocked at level caps)%nl% %nl%&6&nThe current max Card Level is&r &f60&7.%nl%&f- <#9fe7ff>Starforging &9(dropped from the Diamond Chest)%nl%&f- &dRelics &9(rare drop from the Diamond Chest)"
				set slot 11 of {_gui} to diamond named "&eAbilities" with lore "&7Click here to view your Card's%nl%&7abilities and mastery bonus.%nl% %nl%&eAbilities%nl%&7Sets of skills that can be used in both%nl%&7PVE and PVP combat. Abilities can be%nl%&7further upgraded by spending materials." with nbt from "{""minecraft:custom_model_data"":{floats:[50.0f]}}"
				set slot 12 of {_gui} to glowstone dust named "&cConstellation" with lore "&7Click here to check your Card's%nl%&7constellation and constellation bonuses.%nl% %nl%&cConstellations%nl%&7Powerful sequential bonuses unlocked%nl%&7by collecting multiple copies of a Card." with nbt from "{""minecraft:custom_model_data"":{floats:[15.0f]}}"
				set slot 13 of {_gui} to gold nugget named "&eGear" with lore "&7Click here to manage your Card's gear.%nl% %nl%&eGear%nl%&7Armour that can be equipped by your Card.%nl%&7Gear provides stats and can come with%nl%&7additional unique effects or set bonuses." with nbt from "{""minecraft:custom_model_data"":{floats:[13.0f]}}"
				set {_specPoints} to 0
				set slot 14 of {_gui} to diamond named "&cSpecializations" with lore "&7Click here to view or select your%nl%&7Card's specialization.%nl% %nl%&cSpecializations%nl%&7Special &fcapstones &7unlocked with each new &fmax%nl%&flevel &7reached by your Card. Specializations%nl%&7are impactful powers capable of elevating%nl%&7and adding uniqueness to your very own playstyle.%nl% %nl%&f%{_specPoints}% Available Specialization Points%nl% %nl%&7Coming in &f8.4.0: Tournament of Elements%nl%&c&l❌ Not Yet Available" with nbt from "{""minecraft:custom_model_data"":{floats:[31.0f]}}"
				set slot 15 of {_gui} to book named "&6Talents" with lore "&7Click here to view and learn%nl%&7your Card's talents.%nl% %nl%&6Talents%nl%&7Powerful bonuses learned at set Card Levels.%nl%&7Talents are designed to create unique playstyles,%nl%&7anlock new abilities and add versatility and extra%nl%&7fun to the combat prowess of a Card.%nl% %nl%&f- &7Left Click to see &flearned &7Talent rows%nl%&f- &7Shift Click to see &fall &7Card Talents%nl% %nl%&f%{_talentPointsAvailable}% Available Talent Points" with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
				set {_loreStats2} to "&7shielding and supportive buffs.%nl%<#58c3f5> Crowd Control&7: Improves most CC (stuns, knockups, etc.)%nl%&7and increases the range of most abilities.%nl%<#e3ebff> Versatility&7: Damage, Resistance and Utility all%nl%&7in one stat at 33%% effectiveness each.%nl%<#f53b98> Mastery&7: Differs per card and provides an additional%nl%&7passive effect.%nl%<#fca417> Critical Hit&7: Chance to deal increased damage.%nl%<#d5ff57> Element&7: Increases damage dealt and reduces damage%nl%&7taken by supereffective and ineffective attacks.%nl%<#19943e> Haste&7: Decreases most cooldowns and tick times of abilities.%nl%<#2154ad> Avoidance&7: Increases the chance to avoid an attack."
				set {_loreStats} to "<#f74428> Damage&7: Increases the damage of most abilities.%nl%<#ffef45> Resistance&7: Reduces the damage taken by attacks.%nl%&f Mobility&7: Increases movement and flying speed.%nl%<#ae78d0> Utility&7: Increases the effectiveness of most healing,%nl%%{_loreStats2}%"
				set slot 17 of {_gui} to blue stained glass pane named "&9Stats Explained" with lore "&fPrimary Stats:%nl%<#5ee359> Agility&7, <#59c1e3>  Intellect &7and <#e35959> Strength &7are main stats%nl%&7and all greatly increase the damage and healing.%nl%<#5ee359> Agility &7is the stat of most ranged users,%nl%<#59c1e3> Intellect &7is the stat of most magic users, while%nl%<#e35959> Strength &7is the stat of most melee Cards.%nl% %nl%&fSecondary Stats:%nl%<#c0ff02> Health&7: Increases the amount of HP (hearts).%nl%%{_loreStats}%"
				set slot 21 of {_gui} to orange dye named "&6Variants" with lore "&7Click here to view and manage%nl%&7this Card's variants.%nl% %nl%&6Variants%nl%&7Cosmetic appearances enriching or changing%nl%&7the theme, visual appearance and sound%nl%&7effects of Card abilities." with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
				set slot 23 of {_gui} to book named "&5Combat Profile" with lore "&7Click here to view your Card's combat profile.%nl% %nl%&5Combat Profile%nl%&7Displays Gear Score, combat statistics and%nl%&7players with the highest achievements for%nl%&7each entry server-wide." with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
				open {_gui} to player

				loop {gem::%{_id}%::*}:
					set {_r} to "%loop-value%"
					loop lore of loop-value:
						if loop-value-2 contains "Quality" or "Jakość":
							set {_x} to uncolored loop-value-2
							replace all "Jakość: ★★★" and "Quality: ★★★" in {_x} with "(R3)"
							replace all "Jakość: ★★" and "Quality: ★★" in {_x} with "(R2)"
							replace all "Jakość: ★" and "Quality: ★" in {_x} with "(R1)"
							replace all "★" in {_x} with ""
					replace all "diamond named " in {_r} with ""
					set {_r} to uncolored {_r}
					add "%{_r}% %{_x}%" to {_gemy::*}
				set {_agStats::*} to {_primarystat}, {_health}, {_damage}, {_resistance}, {_mobility}, {_utility}, {_crowdcontrol}, {_versatility}, {_mastery}, {_criticalhit}, {_element}, {_haste}, {_avoidance} and {_total}
				set {_ag::*} to "%{_primaryStatType}%", "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Ctrl", "Versatility", "Mastery", "Critical Hit", "Element", "Haste", "Avoidance", "Total"
				loop 12 times:
					if {trait::%{_id}%::%loop-number%} is set:
						set {_ce::%loop-number%} to uncolored {trait::%{_id}%::%loop-number%}
					else:
						set {_ce::%loop-number%} to "Not set"
				set {_dr} to uncolored line 20 of lore of player's tool
				set {_cardname} to uncolored (name of player's tool)
				set {_color} to raw (name of player's tool)
				loop 5 times:
					if string tag "Talents;Row %loop-number%" of (nbt compound of player's tool) is set:
						add string tag "Talents;Row %loop-number%" of (nbt compound of player's tool) to {_talents::*}
				#replace all """", "{" and "}" in {_talents} with ""
				#replace all ":" in {_talents} with " ("
				#set {_talents::*} to {_talents} split at ","
				#set {_numBer} to 1
				#loop {_talents::*}:
				#	set {_talents::%{_num}%} to "%loop-value%)"
				#	add 1 to {_numBer}
				replace all (uncolored (name of player's tool)) in {_color} with ""
				replace all "<" and ">" in {_color} with ""
				replace all "Dropped: " and "Wydropiono: " in {_dr} with ""


				set yaml value "Card.Card" in "activeCard-%player%" to {_cardname}
				set yaml value "Card.Owner" in "activeCard-%player%" to player
				set yaml value "Card.Dropped" in "activeCard-%player%" to {_dr}
				set yaml value "Card.Colour" in "activeCard-%player%" to {_color}
				set yaml value "Card.Level" in "activeCard-%player%" to {_cardLevel}
				set yaml value "Card.Id" in "activeCard-%player%" to {_id}

				if yaml value "Card.Level" in "activeCard-%player%" is not set:
					set yaml value "Card.Level" in "activeCard-%player%" to 0
				if yaml value "Card.Exp" in "activeCard-%player%" is not set:
					set yaml value "Card.Exp" in "activeCard-%player%" to 0
				if yaml value "Card.XP Above Limit" in "activeCard-%player%" is not set:
					set yaml value "Card.XP Above Limit" in "activeCard-%player%" to 0

				#set yaml value "Card.Exp" in "activeCard-%player%" to round({expkarta::%{_id}%}, 2)
				set yaml value "Card.Element" in "activeCard-%player%" to {_elementText}
				#set yaml value "Card.Ascension" in "activeCard-%player%" to {wyniesienie::%{_id}%}
				if yaml value "Card.Constellation" in "activeCard-%player%" is not set:
					set yaml value "Card.Constellation" in "activeCard-%player%" to 0
				if yaml value "Card.Gear Score" in "activeCard-%player%" is not set:
					set yaml value "Card.Gear Score" in "activeCard-%player%" to 0
				if yaml value "Card.Variant" in "activeCard-%player%" is not set:
					set yaml value "Card.Variant" in "activeCard-%player%" to "Classic"
				set {_agIndex} to 1
				loop {_ag::*}:
					set yaml value "Card.Stats.%loop-value%" in "activeCard-%player%" to {_agStats::%{_agIndex}%}
					add 1 to {_agIndex}
				set yaml list "Card.Talents" in "activeCard-%player%" to {_talents::*}
				set yaml list "Card.Gems" in "activeCard-%player%" to {_gemy::*}
				set yaml list "Card.Traits" in "activeCard-%player%" to {_ce::*}

				if yaml list "Card.Gear.Artifacts" in "activeCard-%player%" is set:
					set {_gear::*} to yaml list "Card.Gear.Artifacts" in "activeCard-%player%"
					set yaml list "Card.Gear.Artifacts" in "activeCard-%player%" to {_gear::*}
				if {_gear::*} is set:
					loop {_gear::*}:
						set yaml value "Card.Gear.Artifacts.%loop-value%.Item Level" in "activeCard-%player%" to 50
						set yaml list "Card.Gear.Artifacts.%loop-value%.Stats" in "activeCard-%player%" to "25 Damage", "7 Utility", "25 Haste" and "31 Critical Hit"
						set yaml value "Card.Gear.Artifacts.%loop-value%.Upgrade Level" in "activeCard-%player%" to 25

				save yaml "activeCard-%player%"
				CardBackup(player, uncolored (name of player's tool), {_id})
	
function CardBackup(p: player, name: string, id: string):
	load yaml "plugins/Skript/backups/cards/%{_name}%/%{_id}%.yml" as "cardbackup-%{_id}%"
	set yaml value "Card" in "cardbackup-%{_id}%" to {_p}'s tool
	save yaml "cardbackup-%{_id}%"
	unload yaml "cardbackup-%{_id}%"

on leave:
	clear metadata value "gemadd" of player
	clear {rgem::%player%}

on inventory click:
	if player's current inventory is (metadata tag "topkigui" of player):
		cancel event
	else if player's current inventory is (metadata tag "combatprofilegui" of player):
		cancel event
	else if player's current inventory is (metadata tag "kartagui2" of player):
		cancel event
	else if player's current inventory is (metadata tag "kartagui" of player):
		cancel event
		set {_customNbt} to custom nbt of {karta::%player%}

		if event-inventory is (metadata tag "kartagui" of player):
			set {_id} to cardId(player)

			if index of event-slot = 23:
				if name of event-slot contains "&5Combat Profile":
					CombatProfileMenu(player)
					play sound "skill.buckshot.supernova" with volume 1 and pitch 0.6 to player
			#GEMY
			if index of event-slot is 14:
				set metadata tag "gemykarta" of player to chest inventory with 6 rows named "Gems"
				open (metadata tag "gemykarta" of player) to player
				play sound "ui.click_echo" with volume 1 and pitch 1 to player
				loop 54 times:
					add 1 to {_loopnumber}
					if {gem::%{_id}%::%{_loopnumber}%} is not set:
						if (loop-number - 1) = 0:
							set {_slot} to purple stained glass pane named "<#a335ee>Epic Gem" with lore "&fSlot %{_loopnumber}%" and "&7An epic Gem will fit in this slot."
						else:
							if {slotgem::%{_id}%::%{_loopnumber}%} = true:
								if {raregem::%{_id}%::%{_loopnumber}%} = true:
									set {_slot} to blue stained glass pane named "<#0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
								else:
									set {_slot} to lime stained glass pane named "<#1eff00>Uncommon Gem" with lore "&fSlot %{_loopnumber}%" and "&7An uncommon Gm will fit in this slot." and " " and "&7Upgrade this slot to <#0070dd>Rare &7quality" and "&7by talking to Zach."
							else:
								if {_loopnumber} > 4:
									if int tag "Level" of {_customnbt} >= ({_loopnumber}*8-32):
										if {raregem::%{_id}%::%{_loopnumber}%} = true:
											set {_slot} to blue stained glass pane named "<#0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
										else:
											set {_slot} to lime stained glass pane named "<#1eff00>Uncommon Gem" with lore "&fSlot %{_loopnumber}%" and "&7An uncommon Gem will fit in this slot." and " " and "&7Upgrade this slot to <#0070dd>Rare &7quality" and "&7by talking to Zach."
									else:
										set {_slot} to red stained glass pane named "&cLocked Slot" with lore "&7Reach level &f%{_loopnumber}*8-32% &7on your card" and "&7to unlock this slot."
								else:
									if {_loopnumber} is not 2:
										if {raregem::%{_id}%::%{_loopnumber}%} = true:
											set {_slot} to blue stained glass pane named "<#0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
										else:
											set {_slot} to lime stained glass pane named "<#1eff00>Uncommon Gem" with lore "&fSlot %{_loopnumber}%" and "&7An uncommon Gem will fit in this slot." and " " and "&7Upgrade this slot to <#0070dd>Rare &7quality" and "&7by talking to Zach."
									else:
										set {_slot} to blue stained glass pane named "<#0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
					else:
						set {_gem} to {gem::%{_id}%::%{_loopnumber}%}
						add " " and "&cClick to destroy this gem" to lore of {_gem}
						set {_slot} to {_gem}
					set {_LN} to loop-number
					set {_page} to rounded down (loop-number/55)
					if {_page} >= 1:
						set {_LN} to loop-number - (loop-number/{_page})
					set slot ({_LN} - 1) of metadata tag "gemykarta" of player to {_slot}
					clear {_slot}
				stop
			else if index of event-slot is 11:
				if name of event-slot contains "Abilities":
					play sound "entity.armadillo.scute_drop" with volume 1 and pitch 1 to player
					set {_hasteTt} to Haste(player)
					set metadata tag "abilitygui" of player to chest inventory with 4 rows named "%uncolored (name of player's tool)% - Abilities"
					set {_gui} to metadata tag "abilitygui" of player
					set {_id} to line 19 of lore of player's tool
					set {_pospiech} to Haste(player)
					set {_crowdcontrol} to CrowdControlStat(player)
					set slot 0 of {_gui} to magenta stained glass pane named "<#f53b98>Mastery" with lore "&7All Mastery bonuses of this Card."
					set slot 9 of {_gui} to lime stained glass pane named "&aPassive Abilities" with lore "&7All Passive abilities of this Card."
					set slot 18 of {_gui} to blue stained glass pane named "&9Basic Abilities" with lore "&7All Basic Abilities of this Card."
					set slot 27 of {_gui} to red stained glass pane named "&cUltimate Abilities" with lore "&7All Ultimate Abilities of this Card."

					set {_primCol} to coloured getPrimaryCardColour(player)
					set {_secCol} to coloured getSecondaryCardColour(player)

					#set slot 36 of {_gui} to orange stained glass pane named "&6Talent Abilities" with lore "&7All Talent Abilities and Talent Passives%nl%&7of this Card."
					if uncolored (name of player's tool) = "Glaceon":
						set {_damageicicles} to (0.4 + {damage::%player%}/75 + Versatility(player)/225 + {primarystat::%player%}/37.5) * (1 + (Mastery(player)/3.75/100))
						set {_casttimeFB} to round((3/{_pospiech}), 1)
						set {_damageFB} to 2 + {damage::%player%}/40 + Versatility(player)/120 + {primarystat::%player%}/20
						set {_slowtime} to "%2 + ({crowdcontrol::%player%}/100)% sec"
						set {_slow} to 40
						set {_BonuschanceFoF} to 0
						set {_cdIceLance} to 1.5/{_pospiech}
						set {_damageIL} to 2.5 + {damage::%player%}/34 + Versatility(player)/102 + {primarystat::%player%}/17
						set {_hasteTt} to 750
						set {_hasteTt} to ({_hasteTt}/25)
						set {_seconds} to 20
						set {_brainFreezeChance} to 30

						set {_flurryCastTime} to round((3/{_pospiech}), 1)
						set {_slowFlurry} to 40
						set {_slowtimeFlurry} to "%2 + ({crowdcontrol::%player%}/100)% sec"
						set {_damageFlurry} to (2 + (({damage::%player%}/36) + (Versatility(player)/108) + ({primarystat::%player%}/18)))
						set {_flurryDmgIncrease} to 50

						set {_cdIcyVeins} to "180 seconds" parsed as timespan
						set {_icyVeinsHaste} to 120

						if string tag "Talents;Row 1" of {_customnbt} = "Clarity of Thought":
							add 5 to {_brainFreezeChance}

						set {_glacialSpikeCast} to "%round(2.75/{_pospiech}, 1)% sec"
						set {_damageGlacialSpike} to 5 + {damage::%player%}/14 + Versatility(player)/42 + {primarystat::%player%}/7

						if boolean tag "Constellation;Eternal Winter" of {_customnbt} is set:
							set {_icicleCap} to 7
						else:
							set {_icicleCap} to 5

						set {_item} to diamond named "<#4bbfe2>Mastery: Icicles" with lore GlaceonAbilityUpgradePreviewLore(player, "Icicles", AbilityUpgradeLevel(player, "Icicles"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[45.0f]}}"
						set slot 1 of {_gui} to {_item}

						set {_item} to diamond named "<#4bbfe2>Shatter" with lore GlaceonAbilityUpgradePreviewLore(player, "Shatter", AbilityUpgradeLevel(player, "Shatter"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[32.0f]}}"
						set slot 10 of {_gui} to {_item}

						set {_item} to blue dye named "<#4bbfe2>Frostbolt" with lore GlaceonAbilityUpgradePreviewLore(player, "Frostbolt", AbilityUpgradeLevel(player, "Frostbolt"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 19 of {_gui} to {_item}

						set {_item} to light blue dye named "<#4bbfe2>Ice Lance" with lore GlaceonAbilityUpgradePreviewLore(player, "Ice Lance", AbilityUpgradeLevel(player, "Ice Lance"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
						set slot 20 of {_gui} to {_item}

						set {_item} to prismarine shard named "<#4bbfe2>Flurry" with lore GlaceonAbilityUpgradePreviewLore(player, "Flurry", AbilityUpgradeLevel(player, "Flurry"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[12.0f]}}"
						set slot 21 of {_gui} to {_item}

						set {_item} to lapis lazuli named "<#4bbfe2>Icy Veins" with lore GlaceonAbilityUpgradePreviewLore(player, "Icy Veins", AbilityUpgradeLevel(player, "Icy Veins"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 28 of {_gui} to {_item}
						
						if string tag "Talents;Row 5" of {_customnbt} = "Glacial Spike":
							set {_item} to prismarine crystals named "<#4bbfe2>Glacial Spike" with lore GlaceonAbilityPreviewLore(player, "Glacial Spike") with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
							set slot 29 of {_gui} to {_item}
					
					else if uncolored (name of player's tool) = "Buckshot":
						set slot 1 of {_gui} to arrow named "<#866da4>Mastery: Portal Mastery" with lore BuckshotAbilityPreviewLore(player, "Portal Mastery") with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 10 of {_gui} to magenta dye named "<#866da4>Mystic Shots" with lore BuckshotAbilityPreviewLore(player, "Mystic Shots") with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 19 of {_gui} to bow named "<#866da4>Starbolt" with lore BuckshotAbilityPreviewLore(player, "Starbolt") with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 20 of {_gui} to purple dye named "<#866da4>Magic Portals" with lore BuckshotAbilityPreviewLore(player, "Magic Portals") with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 21 of {_gui} to popped chorus fruit named "<#866da4>Binding Shot" with lore BuckshotAbilityPreviewLore(player, "Binding Shot") with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
						set slot 28 of {_gui} to pink dye named "<#866da4>G.O.A.T" with lore BuckshotAbilityPreviewLore(player, "GOAT") with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
						
					else if uncolored (name of player's tool) = "Ghazan":
						set {_item} to red dye named "<#b03228>Mastery: Lava Technique" with lore GhazanAbilityUpgradePreviewLore(player, "Lava Technique", AbilityUpgradeLevel(player, "Lava Technique"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 1 of {_gui} to {_item}

						set {_item} to magma cream named "<#b03228>Lava Surge" with lore GhazanAbilityUpgradePreviewLore(player, "Lava Surge", AbilityUpgradeLevel(player, "Lava Surge"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 10 of {_gui} to {_item}

						set {_item} to red dye named "<#b03228>Lava Burst" with lore GhazanAbilityUpgradePreviewLore(player, "Lava Burst", AbilityUpgradeLevel(player, "Lava Burst"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 19 of {_gui} to {_item}

						set {_item} to orange dye named "<#b03228>Molten Lava" with lore GhazanAbilityUpgradePreviewLore(player, "Molten Lava", AbilityUpgradeLevel(player, "Molten Lava"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 20 of {_gui} to {_item}

						set {_item} to blaze powder named "<#b03228>Rain of Lava" with lore GhazanAbilityUpgradePreviewLore(player, "Rain of Lava", AbilityUpgradeLevel(player, "Rain of Lava"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
						set slot 28 of {_gui} to {_item}

						if string tag "Talents;Row 2" of {_customnbt} = "Ascendance":
							set {_item} to yellow dye named "<#b03228>Ascendance" with lore GhazanAbilityPreviewLore(player, "Ascendance") with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
							set slot 29 of {_gui} to {_item}
						
						if string tag "Talents;Row 3" of {_customnbt} is set:
							if string tag "Talents;Row 3" of {_customnbt} = "Lava Wave":
								set {_item} to brown dye named "<#b03228>Lava Wave" with lore GhazanAbilityUpgradePreviewLore(player, "Lava Wave", AbilityUpgradeLevel(player, "Lava Wave"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
								set slot 21 of {_gui} to {_item}
							else if string tag "Talents;Row 3" of {_customnbt} = "Lavakeeper":
								set {_item} to brown dye named "<#b03228>Lavakeeper" with lore GhazanAbilityUpgradePreviewLore(player, "Lavakeeper", AbilityUpgradeLevel(player, "Lavakeeper"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
								set slot 21 of {_gui} to {_item}
							else:
								set {_item} to brown dye named "<#b03228>Lavafury" with lore GhazanAbilityUpgradePreviewLore(player, "Lavafury", AbilityUpgradeLevel(player, "Lavafury"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
								set slot 21 of {_gui} to {_item}
					if uncolored (name of player's tool) = "Brother Therold": #<#542c7a>
						if string tag "Talents;Row 1" of {_customnbt} = "Shadow Word: Void":
							set {_item} to light gray dye named "<#613e82>Shadow Word: Void"
							set custom model data of {_item} to 3
							set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Shadow Word: Void", AbilityUpgradeLevel(player, "Shadow Word: Void"), "&f")
							set boolean tag "Shadow Word: Void" of (custom nbt of {_item}) to true
						else:
							set {_item} to light gray dye named "<#613e82>Mind Blast"
							set custom model data of {_item} to 3
							set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Mind Blast", AbilityUpgradeLevel(player, "Mind Blast"), "&f")
							set boolean tag "Mind Blast" of (custom nbt of {_item}) to true
						set slot 19 of {_gui} to {_item}

						set {_item} to light gray dye named "<#613e82>Madness"
						set custom model data of {_item} to 3
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Madness", AbilityUpgradeLevel(player, "Madness"), "&f")
						set slot 1 of {_gui} to {_item}

						set {_item} to popped chorus fruit named "<#613e82>Voidform"
						set custom model data of {_item} to 3
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Voidform", AbilityUpgradeLevel(player, "Voidform"), "&f")
						set slot 10 of {_gui} to {_item}

						set {_item} to purple dye named "<#613e82>Shadowy Apparitions"
						set custom model data of {_item} to 3
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Shadowy Apparitions", AbilityUpgradeLevel(player, "Shadowy Apparitions"), "&f")
						set slot 11 of {_gui} to {_item}

						set {_item} to orange dye named "<#613e82>Shadow Word: Pain"
						set custom model data of {_item} to 5
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Shadow Word: Pain", AbilityUpgradeLevel(player, "Shadow Word: Pain"), "&f")
						set slot 20 of {_gui} to {_item}

						set {_item} to gray dye named "<#613e82>Vampiric Touch"
						set custom model data of {_item} to 2
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Vampiric Touch", AbilityUpgradeLevel(player, "Vampiric Touch"), "&f")
						set slot 21 of {_gui} to {_item}

						set {_item} to cyan dye named "<#613e82>Mind Flay"
						set custom model data of {_item} to 3
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Mind Flay", AbilityUpgradeLevel(player, "Mind Flay"), "&f")
						set slot 22 of {_gui} to {_item}

						set {_item} to yellow dye named "<#613e82>Shadow Word: Death"
						set custom model data of {_item} to 6
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Shadow Word: Death", AbilityUpgradeLevel(player, "Shadow Word: Death"), "&f")
						set slot 23 of {_gui} to {_item}

						set {_item} to purple dye named "<#613e82>Void Eruption"
						set custom model data of {_item} to 9
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Void Eruption", AbilityUpgradeLevel(player, "Void Eruption"), "&f")
						set slot 28 of {_gui} to {_item}

						set {_item} to black dye named "<#613e82>Void Bolt"
						set custom model data of {_item} to 3
						set lore of {_item} to TheroldAbilityUpgradePreviewLore(player, "Void Bolt", AbilityUpgradeLevel(player, "Void Bolt"), "&f")
						set slot 29 of {_gui} to {_item}

						if string tag "Talents;Row 5" of {_customnbt} = "Surrender to Madness":
							set slot 30 of {_gui} to popped chorus fruit named "<#613e82>Surrender to Madness" with lore GetAbilityDescription(player, "Brother Therold", "Surrender to Madness", "", 0) with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
					else if uncolored (name of player's tool) = "Cresselia":

						set {_item} to AbilityItem(player, "Shooting Stars", pink dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Shooting Stars", AbilityUpgradeLevel(player, "Shooting Stars"), "&f")
						set slot 1 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Boundless Moonlight", glowstone dust)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Boundless Moonlight", AbilityUpgradeLevel(player, "Boundless Moonlight"), "&f")
						set slot 10 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Starfire", white dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Starfire", AbilityUpgradeLevel(player, "Starfire"), "&f")
						set slot 19 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Starsurge", magenta dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Starsurge", AbilityUpgradeLevel(player, "Starsurge"), "&f")
						set slot 20 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Starfall", purple dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Starfall", AbilityUpgradeLevel(player, "Starfall"), "&f")
						set slot 21 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Celestial Alignment", light blue dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Celestial Alignment", AbilityUpgradeLevel(player, "Celestial Alignment"), "&f")
						set slot 28 of {_gui} to {_item}

						if string tag "Talents;Row 4" of {_customnbt} = "Innervate":
							set {_innervateCooldown} to 3 minutes
							set {_innervateAllyCdReduction} to 40
							set {_innervateSelfCdReduction} to 30
							set {_innervateAstralPower} to 100
							set {_valueNames::*} to "COOLDOWN", "ALLYCDREDUCTION", "SELFCDREDUCTION", "ASTRALPOWER"
							set {_values::*} to {_innervateCooldown}, {_innervateAllyCdReduction}, {_innervateSelfCdReduction}, {_innervateAstralPower}
							set {_item} to AbilityItem(player, "Innervate", blue dye)
							set lore of {_item} to GetAbilityDescription(player, "Cresselia", "Innervate", {_valueNames::*}, {_values::*})
							set slot 29 of {_gui} to {_item}

					else if uncolored (name of player's tool) = "Shenhe":
						set {_baseResShred} to 30
						set {_mastery} to 10 + Mastery(player)/4
						set {_resShred} to {_baseResShred} + {_mastery}
						set slot 1 of {_gui} to light blue dye named "<#8c9db9>Mastery: Deific Embrace" with lore "&8Mastery Bonus%nl%&fInstant cast%nl%&7Cooldown: &fnone%nl%&7Use: &fPassive%nl%<#8c9db9>Increases the <#add8e6>Ice <#ffef45> Resistance <#8c9db9>shred for enemies%nl%<#8c9db9>provided by <#abc0d9>Divine Maiden's Deliverance <#8c9db9>by &f10<#8c9db9>.%nl%&8&m-------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 10 of {_gui} to light blue dye named "<#8c9db9>Spirit Communion Seal" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown: &fnone%nl%&7Use: &fPassive%nl%<#8c9db9>After Shenhe uses <#abc0d9>Spring Spirit Summoning<#8c9db9>, she%nl%<#8c9db9>will grant all nearby allies or party members%nl%<#8c9db9>the following effects:%nl% %nl%<#8c9db9>Left Click: <#add8e6>Ice <#8c9db9>Ability and Ultimate Ability damage%nl%<#8c9db9>increased by &f15%% <#8c9db9>for &f10 sec<#8c9db9>.%nl% %nl%<#8c9db9>Right Click: <#abc0d9>Spring Spirit Summoning <#8c9db9>will grant &f2 <#8c9db9>additional%nl%<#bdd1f2>Icy Quills <#8c9db9>to each affected ally and <#bdd1f2>Icy Quills <#8c9db9>will last &f2%nl%<#8c9db9>additional &fsec<#8c9db9>.%nl%&8&m-------------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 19 of {_gui} to light blue dye named "<#8c9db9>Dawnstar Piercer" with lore "&8Ability%nl%&fInstant cast%nl%&7Cooldown: &f4 seconds%nl%&7Use: &fRMB%nl%<#8c9db9>Deal &f2 <#add8e6>Ice <#8c9db9>or <#cecece>Metal <#8c9db9>damage to the enemy, depending%nl%<#8c9db9>on their element. If the enemy is neutral to both%nl%<#8c9db9>elements, deal <#add8e6>Ice <#8c9db9>damage.%nl%&8&m-------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 20 of {_gui} to light blue dye named "<#8c9db9>Spring Spirit Summoning" with lore "&8Ability%nl%&fInstant cast%nl%&7Cooldown: &f18 seconds%nl%&7Use: &fLMB&7/&fRMB%nl%<#8c9db9>The frosted dew, silvery and dense, shall exorcise all demons.%nl%<#8c9db9>Grants all nearby allies or party members the <#bdd1f2>Icy Quill <#8c9db9>effect%nl%<#8c9db9>and deals <#add8e6>Ice <#8c9db9>damage in different ways based on whether this%nl%<#8c9db9>ability is &fleft <#8c9db9>or &fright <#8c9db9>clicked.%nl% %nl%<#8c9db9>Left Click: Commands the <#abc0d9>Talisman Spirit <#8c9db9>to deal &f4 <#add8e6>Ice <#8c9db9>damage%nl%<#8c9db9>in an area around Shenhe.%nl% %nl%<#8c9db9>Right Click: Rushes toward a target with a <#abc0d9>Talisman Spirit,%nl%<#8c9db9>dealing &f2 <#add8e6>Ice <#8c9db9>damage to all enemies around the target.%nl% %nl%<#bdd1f2>Icy Quill%nl%<#8c9db9>When Abilities, Ultimate Abilities and Weapon Attacks deal <#add8e6>Ice%nl%<#8c9db9>damage to opponents, the damage dealt is increased based%nl%<#8c9db9>on Shenhe's offensive statistics.%nl% %nl%<#bdd1f2>Icy Quills <#8c9db9>currently add an extra &f0.45 <#8c9db9>damage each and%nl%<#8c9db9>have a duration of &f10 sec<#8c9db9>.%nl%&8&m----------------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 28 of {_gui} to light blue dye named "<#8c9db9>Divine Maiden's Deliverance" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &f70 seconds%nl%&7Use: &fRMB%nl%<#8c9db9>Unleashes the power of the <#abc0d9>Talisman Spirit<#8c9db9>, allowing%nl%<#8c9db9>it to roam free in this plane, dealing &f8 <#add8e6>Ice <#8c9db9>damage%nl%<#8c9db9>to all enemies within an area. The <#abc0d9>Talisman Spirit <#8c9db9>then%nl%<#8c9db9>creates a field for &f12 sec <#8c9db9>that decreases the <#add8e6>Ice%nl%<#8c9db9>and <#cecece>Metal <#ffef45> Resistance <#8c9db9>of opponents within it by &f%{_resShred}%<#8c9db9>.%nl%<#8c9db9>It also deals two instances of periodic &f0.8 <#add8e6>Ice <#8c9db9>damage%nl%<#8c9db9>every &f2 sec <#8c9db9>for the duration of the field.%nl%&8&m----------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						#Talent for spear damage, spear damage increases by x%% per strike, up to 5 times
					else if uncolored (name of player's tool) = "Delphox":
						set {_item} to charcoal named "<#fa4420>Mastery: Incineration" with lore DelphoxAbilityUpgradePreviewLore(player, "Incineration", AbilityUpgradeLevel(player, "Incineration"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 1 of {_gui} to {_item}

						set {_item} to red dye named "<#fa4420>Blaze" with lore DelphoxAbilityUpgradePreviewLore(player, "Blaze", AbilityUpgradeLevel(player, "Blaze"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 10 of {_gui} to {_item}

						set {_item} to blaze rod named "<#fa4420>Flamethrower" with lore DelphoxAbilityUpgradePreviewLore(player, "Flamethrower", AbilityUpgradeLevel(player, "Flamethrower"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 19 of {_gui} to {_item}

						set {_item} to blaze powder named "<#fa4420>Inferno" with lore DelphoxAbilityUpgradePreviewLore(player, "Inferno", AbilityUpgradeLevel(player, "Inferno"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 20 of {_gui} to {_item}

						if string tag "Talents;Row 5" of {_customnbt} = "Hot Spree":
							set slot 29 of {_gui} to blaze rod named "<#fa4420>Hot Spree" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<#fa4420>Every third &f <#f2636a>Flamethrower <#fa4420>will not incur%nl%<#fa4420>a cooldown. When a &ffree  <#f2636a>Flamethrower%nl%<#fa4420>is used, its damage is increased by &f50%%<#fa4420>.%nl% %nl%<#fa4420>Damage dealt by &f <#f2636a>Flamethrower <#fa4420>is%nl%<#fa4420>increased by &f60%%<#fa4420>.%nl% %nl%<#fa4420>Replaces &f <#f2636a>Inferno<#fa4420>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						else:
							set {_item} to glowstone dust named "<#fa4420>Heat Snap" with lore DelphoxAbilityUpgradePreviewLore(player, "Heat Snap", AbilityUpgradeLevel(player, "Heat Snap"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
							set slot 29 of {_gui} to {_item}

						set {_item} to flint named "<#fa4420>Flame Barrier" with lore DelphoxAbilityUpgradePreviewLore(player, "Flame Barrier", AbilityUpgradeLevel(player, "Flame Barrier"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 28 of {_gui} to {_item}

					else if uncolored (name of player's tool) = "Vaporeon":
						set {_item} to iron nugget named "<#7cafbf>Mastery: Water Cycles" with lore VaporeonAbilityUpgradePreviewLore(player, "Water Cycles", AbilityUpgradeLevel(player, "Water Cycles"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[14.0f]}}"
						set slot 1 of {_gui} to {_item}

						set {_item} to cyan dye named "<#7cafbf>Circle of Water" with lore VaporeonAbilityUpgradePreviewLore(player, "Circle of Water", AbilityUpgradeLevel(player, "Circle of Water"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						set slot 10 of {_gui} to {_item}

						set {_item} to lapis lazuli named "<#7cafbf>Undertow" with lore VaporeonAbilityUpgradePreviewLore(player, "Undertow", AbilityUpgradeLevel(player, "Undertow"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
						set slot 19 of {_gui} to {_item}

						set {_item} to blue dye named "<#7cafbf>Healing Stream" with lore VaporeonAbilityUpgradePreviewLore(player, "Healing Stream", AbilityUpgradeLevel(player, "Healing Stream"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 20 of {_gui} to {_item}

						set {_item} to clay ball named "<#7cafbf>Explosive Bubble" with lore VaporeonAbilityUpgradePreviewLore(player, "Explosive Bubble", AbilityUpgradeLevel(player, "Explosive Bubble"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						set slot 21 of {_gui} to {_item}

						set {_item} to light blue dye named "<#7cafbf>Reversal" with lore VaporeonAbilityUpgradePreviewLore(player, "Reversal", AbilityUpgradeLevel(player, "Reversal"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[10.0f]}}"
						set slot 28 of {_gui} to {_item}

						if string tag "Talents;Row 2" of {_customnbt} is set:
							set {_item} to white dye named "<#7cafbf>Tidal Waves" with lore VaporeonAbilityUpgradePreviewLore(player, "Tidal Waves", AbilityUpgradeLevel(player, "Tidal Waves"), "&f") with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
							set slot 11 of {_gui} to {_item}
					else if uncolored (name of player's tool) = "Umbreon":
						set {_damage} to 5 + ({damage::%player%}/30) + (Versatility(player)/90) + ({primarystat::%player%}/20)
						set {_baseCd} to 3
						
						if string tag "Talents;Row 1" of {_customnbt} = "Quick Claw":
							set {_damage} to {_damage}*0.75
							set {_baseCd} to {_baseCd}*0.5
						else if string tag "Talents;Row 1" of {_customnbt} = "Heavy Claw":
							set {_damage} to {_damage}*1.875
							set {_baseCd} to {_baseCd}*1.25
						else if string tag "Talents;Row 1" of {_customnbt} = "Sharp Claw":
							set {_damage} to {_damage}*1.5
						set {_cd} to "%{_baseCd}/{_pospiech}% seconds" parsed as timespan
						set {_cdd} to {_baseCd}/{_pospiech}

						set {_cdMO} to 16/{_pospiech}
						set {_damageMO} to 2 + ({damage::%player%}/90) + (Versatility(player)/270 + {primarystat::%player%}/45)
						set {_radiusMO} to 3 + CrowdControlStat(player)/20

						if string tag "Talents;Row 3" of {_customnbt} = "Supermoon":
							set {_damageMO} to {_damageMO} * 5

						set {_cdEG} to "%600/{_pospiech}% seconds" parsed as timespan
						set {_range} to 3 + CrowdControlStat(player)/30

						set {_shadowClawsDMG} to 6 + ({damage::%player%}/12) + (Versatility(player)/36) + ({primarystat::%player%}/6)
						set {_shadowClawsDmgTotal} to 0
						set {_shadowClawsCD} to 30 seconds

						set {_garroteCd} to "%16/{_pospiech}% seconds" parsed as timespan
						set {_garroteDMG} to 1.25 + ({damage::%player%}/70) + (Versatility(player)/210) + ({primarystat::%player%}/35)
						if string tag "Talents;Row 4" of {_customnbt} = "Scent of Blood":
							set {_garroteDmg} to {_garroteDmg} * 1.2
						set {_garroteDur} to 18
						set {_garroteTickTime} to 2/{_pospiech}
						set {_garroteTotalDMG} to ({_garroteDur}/{_garroteTickTime})*{_garroteDmg}

						set {_mastery} to (0.15 + ((Mastery(player)/130)))
						if string tag "Talents;Row 2" of {_customnbt} = "Chosen of the Night":
							add 0.1 to {_mastery}

						set {_damageEndGame} to 50 + ({damage::%player%}/0.24) + (Versatility(player)/0.72) + ({primarystat::%player%}/0.12)
						set {_executionThreshold} to 25

						if string tag "Talents;Row 5" of {_customnbt} = "Inevitable End":
							add 5 to {_executionThreshold}
							set {_damageEndGame} to {_damageEndGame} * 1.25


						set slot 1 of {_gui} to charcoal named "<#555555>Mastery: Assassination" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#555555>Increases damage done%nl%<#555555>while &f <#999999>Invisible <#555555>by &f%{_mastery}*100%%%<#555555>." with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 10 of {_gui} to black dye named "<#555555>Night Hunter" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#555555>When <#999999>Umbreon <#555555>deals a <#999999>killing blow%nl%<#555555>to an enemy, she enters &f <#999999>Stealth%nl%<#555555>for &f5 sec<#555555>.%nl% %nl%<#555555>Deal &f10%% <#555555>increased damage during%nl%<#999999>Nighttime <#555555>(22:00 until 4:00 CEST)." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						set slot 19 of {_gui} to blaze rod named "<#555555>Night Slash" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdd}% seconds%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>slashes her target with her claw%nl%<#555555>at short range, dealing &f%{_damage}% <#333333>Dark <#555555>damage.%nl% %nl%<#555555>The enemy will take &f7.5%% <#555555>increased damage%nl%<#555555>from your upcoming &f <#999999>Night Slash <#555555>attacks%nl%<#555555>for the next &f6 sec<#555555>. This effect stacks." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 20 of {_gui} to glowstone dust named "<#555555>Moonlight Orb" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdMO}% seconds%nl%&7Radius area: &f%{_radiusMO}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>creates a zone of &f <#999999>Moonlight <#555555>at the%nl%<#555555>target location, inflicting &f%{_damageMO}% <#d9d5a7>Moonlight <#555555>damage to%nl%<#555555>enemies caught in its radius and <#999999> Slowing%nl%<#555555>them by &f30%% <#555555>until they leave the area.%nl% %nl%<#999999>Umbreon<#555555> becomes &f <#999999>Invisible <#555555>while she%nl%<#555555>remains inside a &f <#999999>Moonlight <#555555>zone.%nl% %nl%&f <#999999>Moonlight <#555555>zones last &f8 sec<#555555>." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 21 of {_gui} to iron ingot named "<#555555>Garrote" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_garroteCd}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>garrotes the enemy, causing the%nl%<#555555>target to <#999999>Bleed <#555555>for &f%{_garroteDMG}% <#333333>Dark <#555555>every &f%{_garroteTickTime}% sec%nl%<#555555>for a total of &f%{_garroteTotalDMG}% <#333333>Dark <#555555>damage over &f%{_garroteDur}% sec<#555555>.%nl% %nl%<#555555>This ability increases all <#999999>damage taken <#555555>by%nl%<#555555>the target from your abilities by &f10%% <#555555>for%nl%<#555555>its duration." with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
						set slot 28 of {_gui} to glow ink sac named "<#555555>End Game" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdEG}%%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>attempts to <#999999>execute <#555555>all enemies%nl%<#555555>below &f%{_executionThreshold}%%% <#999999>health <#555555>in an enormous radius.%nl% %nl%<#555555>All enemies in range are <#999999> Blinded%nl%<#555555>for &f10 sec<#555555>.%nl% %nl%<#555555>This ability instead deals &f%{_damageEndGame}% <#333333>Dark <#555555>damage%nl%<#555555>to all <#999999>Boss <#555555>enemies." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 29 of {_gui} to purple dye named "<#555555>Shadow Claws" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_shadowClawsCD}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>draws upon the surrounding shadows to%nl%<#999999>empower <#555555>her claws and deal &f%{_shadowClawsDMG}% <#333333>Dark <#555555>damage for%nl%<#555555>each &f <#999999>Damage Amp <#555555>effect applied <#999999>on the target%nl%<#555555>by her abilities.%nl% %nl%<#555555>Deals a total of &f%{_shadowClawsDmgTotal}% <#333333>Dark <#555555>damage against your%nl%<#555555>current target.%nl% %nl%<#555555>This ability consumes all &f <#999999>Damage Modifications%nl%<#555555>used to <#999999>empower <#555555>the ability in the process." with nbt from "{""minecraft:custom_model_data"":{floats:[12.0f]}}"

						if string tag "Talents;Row 3" of {_customnbt} = "Shadowstep":
							set {_shadowstepCd} to "%20/{_pospiech}% seconds" parsed as timespan
							set {_shadowstepDmg} to 2 + ({damage::%player%}/100 + Versatility(player)/300 + {primarystat::%player%}/50)
							set {_shadowstepDmgIncrease} to 8
							set {_shadowstepDuration} to 6
							set {_shadowstepRange} to 6 + CrowdControlStat(player)/30
							set slot 22 of {_gui} to black dye named "<#555555>Shadowstep" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_shadowstepCd}%%nl%&7Range: &f%{_shadowstepRange}% blocks%nl%&7Use: &fRMB%nl%<#999999>Blink <#555555>behind a target, dealing &f%{_shadowstepDmg}% <#333333>Dark%nl%<#555555>damage and increasing <#999999>all damage they%nl%<#999999>take <#555555>from you by &f%{_shadowstepDmgIncrease}%%% <#555555>for &f%{_shadowstepDuration}% sec<#555555>." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						
						else if string tag "Talents;Row 3" of {_customnbt} = "Vanish":
							set {_vanishCd} to "%30/{_pospiech}% seconds" parsed as timespan
							set {_vanishDuration} to 10
							set {_vanishMovementSpeed} to 50
							set slot 22 of {_gui} to black dye named "<#555555>Vanish" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_vanishCd}%%nl%&7Use: &fRMB%nl%<#555555>Blend into the shadows, <#999999>vanishing <#555555>from%nl%<#555555>sight and becoming &f <#999999>Invisible <#555555>for &f%{_vanishDuration}% sec<#555555>.%nl% %nl%&f <#999999>Vanish <#555555>increases your <#999999> Movement%nl%<#999999>Speed <#555555>by &f%{_vanishMovementSpeed}%%% <#555555>for the duration." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"

					else if uncolored (name of player's tool) = "Shaymin":
						set {_cdUlt} to 30 seconds
						set {_masteryHeal} to 0.6
						set {_masteryDamage} to 1.2
						set {_masteryChance} to 12.5

						set {_bonusDMG} to 12
						set {_utilityGain} to 50
						set {_mobilityGain} to 70

						set {_seedFlareCD} to 8 seconds
						set {_seedFlareCastTime} to 2 seconds
						set {_seedFlareCast} to "%{_seedFlareCastTime}%"
						set {_seedFlareRadius} to 6 + CrowdControlStat(player)/20
						replace all "seconds" in {_seedFlareCast} with "second"

						set {_airSlashCD} to 5 seconds
						set {_airSlashRadius} to 4 + CrowdControlStat(player)/25
						set {_airSlashDMG} to damageScalingSpell(player, 3, 8)

						set {_seedFlareDMG} to 1
						set {_seedFlareHeal} to 2

						set {_skyBlastCast} to "%3/{_pospiech}% seconds" parsed as timespan
						replace all "seconds" in {_skyBlastCast} with "second"
						set {_skyBlastDMG} to 8
						set {_skyBlastCD} to 20 seconds
						set {_skyBlastRadius} to 3 + CrowdControlStat(player)/30

						set slot 1 of {_gui} to slime ball named "<#dbef9e>Mastery: Seed Barrage" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown:  &fnone%nl%&7Use: &fPassive%nl%<#dbef9e>When damaging or healing spells successfully%nl%<#dbef9e>hit their target, <#f8ffe3>Shaymin <#dbef9e>has a &f%{_masteryChance}%%% <#dbef9e>chance%nl%<#dbef9e>to fire a seed towards the affected target,%nl%<#dbef9e>dealing &f%{_masteryDamage}% <#607c3c>Nature <#dbef9e>damage to an enemy or%nl%<#dbef9e>restoring &f%{_masteryHeal}% <#dbef9e>HP to an ally." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 10 of {_gui} to lime dye named "<#dbef9e>Serene Grace" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown:  &fnone%nl%&7Use: &fPassive%nl%<#dbef9e>Gain a burst of stats on &f <#f8ffe3>Swap Forme%nl%<#dbef9e>for &f6 sec<#dbef9e>. The type of stat gained%nl%<#dbef9e>depends on the <#f8ffe3>Forme Shaymin <#dbef9e>swaps to.%nl%<#dbef9e>Stat gain can only trigger once per <#f8ffe3>Forme<#dbef9e>.%nl% %nl%&f <#f8ffe3>Land: <#ae78d0> +%{_utilityGain}% Utility%nl%&f <#f8ffe3>Sky: &f +%{_mobilityGain}% Mobility%nl% %nl%<#dbef9e>Gaining a new bonus overrides the%nl%<#dbef9e>current stat bonus from the active%nl%<#f8ffe3>forme.%nl% %nl%<#dbef9e>Deal &f%{_bonusDMG}%%% <#dbef9e>increased damage in%nl%<#f8ffe3>Sky Forme <#dbef9e>based on &f Mobility<#dbef9e>.%nl% %nl%<#f8ffe3>Shaymin <#dbef9e>is immune to fall damage." with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 19 of {_gui} to lime dye named "<#dbef9e>Seed Flare" with lore "&8Basic Ability%nl%&f%{_seedFlareCast}% cast%nl%&7Cooldown:  &f%{_seedFlareCD}%%nl%&7Radius: &f%{_seedFlareRadius}% blocks%nl%&7Use: &fRMB%nl%<#f8ffe3>Shaymin <#dbef9e>emits a seed shockwave from his%nl%<#dbef9e>body, dealing &f%{_seedFlareDMG}% <#607c3c>Nature <#dbef9e>damage to all%nl%<#dbef9e>enemies in a short radius and healing%nl%<#dbef9e>allies for &f0.5 HP<#dbef9e>.%nl% %nl%&fRequires Land Forme." with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 21 of {_gui} to sugar named "<#f8fff5>Air Slash" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_airslashCD}%%nl%&7Range: &f%{_airSlashRadius}% blocks%nl%&7Use: &fRMB%nl%<#f8fff5>Slashes the target with air, dealing &f%{_airSlashDMG}% Air%nl%<#f8fff5>damage. This ability deals &f20%% <#f8fff5>increased%nl%<#f8fff5>damage to airborne targets or targets%nl%<#f8fff5>vulnerable to the &fAir <#f8fff5>element.%nl% %nl%&fRequires Sky Forme." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 22 of {_gui} to white dye named "<#f8fff5>Sky Blast" with lore "&8Basic Ability%nl%&f%{_skyBlastCast}% cast%nl%&7Cooldown: &8 &f%{_skyBlastCD}%%nl%&7Radius of impact: &f%{_skyBlastRadius}% blocks%nl%&7Use: &fRMB%nl%<#f8fff5>Shoots out a giant ball of air, dealing %{_skyBlastDMG}% &fAir%nl%<#f8fff5>damage and knocking up all enemies caught%nl%<#f8fff5>in its radius of impact.%nl% %nl%<#f8fff5>Each cast of &fAir Slash <#f8fff5>reduces the%nl%<#f8fff5>cooldown of &fSky Blast <#f8fff5>by &f1.0 sec<#f8fff5>.%nl% %nl%&fRequires Sky Forme." with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 28 of {_gui} to feather named "<#dbef9e>Swap Forme" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cdUlt}%%nl%&7Use: &fRMB%nl%<#dbef9e>Activates <#f8ffe3>Sky Forme <#dbef9e>for the next &f15 sec<#dbef9e>,%nl%<#dbef9e>assuming the &fAir <#dbef9e>element, allowing <#f8ffe3>flight%nl%<#dbef9e>and granting <#f8ffe3>Shaymin <#dbef9e>a new set of abilities.%nl% %nl%<#f8ffe3>Shaymin <#dbef9e>may freely switch between <#f8ffe3>Formes%nl%<#dbef9e>while this ability is active. Swapping to a%nl%<#dbef9e>different <#f8ffe3>Forme <#dbef9e>does not refresh the %nl%<#dbef9e>duration of this ability.%nl% %nl%<#dbef9e>When this ability ends, <#f8ffe3>Shaymin <#dbef9e>reverts%nl%<#dbef9e>back to <#f8ffe3>Land Forme<#dbef9e>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
					else if uncolored (name of player's tool) = "Espeon":
						set {_intellectGain} to 0.5 + Mastery(player)/40
						set {_hasteGain} to 1.5 + Mastery(player)/16

						set {_psyWaveCd} to "%60/{_pospiech}% seconds" parsed as timespan
						set {_futureSightCd} to "%10/{_pospiech}% seconds" parsed as timespan
						set {_mindTransferCd} to "%5/{_pospiech}% seconds" parsed as timespan
						set {_hypercognitionCd} to 300 seconds
						set {_timeWarpCd} to 300 seconds

						set {_futureSightDamage} to 16 + (({damage::%player%}/3.5) + (Versatility(player)/10.5) + ({primarystat::%player%}/1.75))
						set {_futureSightFall} to "%20/{_pospiech}% sec"

						set {_mindTransferCastTime} to "%2/{_pospiech}% seconds" parsed as timespan
						set {_maxStacks} to 50
						set {_stacksAdd} to 1
						set {_radiusmindTransfer} to 30
						set {_radiusHypercognition} to 30
						set {_extraDurationAdd} to "10 sec"
						set {_silenceDuration} to "%2 + ({_crowdcontrol}/35)%"

						set {_timeWarpHaste} to 120
						set {_timeWarpDuration} to 40
						set {_timeWarpRadius} to 50

						set {_intHypercognition} to 4
						set {_dmgHypercognition} to 8 + (({damage::%player%}/6) + (Versatility(player)/18) + ({primarystat::%player%}/3))

						set {_loreFutureSight} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_futureSightCd}%%nl%&7Use: &fRMB%nl%<#d48bc3>Prepares an attack on a target enemy that%nl%<#d48bc3>deals &f%{_futureSightDamage}% <#d84af7>Psychic <#d48bc3>damage after &f%{_futureSightFall}%<#d48bc3>.%nl% %nl%<#d48bc3>If &f <#f7b2e7>Future Sight <#d48bc3>is used on an enemy that%nl%<#d48bc3>already has the spell <#d48bc3>applied on them, it%nl%<#d48bc3>refreshes the duration, but does not add%nl%<#d48bc3>a stack."

						set {_loremindTransfer3} to "<#d48bc3>If &f <#f7b2e7>Future Sight <#d48bc3>detonates while held by%nl%<#d48bc3>Espeon, they will take all &fdamage <#d48bc3>instead.%nl%<#d48bc3>Taking control of over &f%{_maxStacks}% stacks <#d48bc3>at once%nl%<#d48bc3>will overwhelm Espeon and cause their mind%nl%<#d48bc3>to explode."
						set {_loremindTransfer2} to "<#d48bc3>ability transfers all &f <#f7b2e7>Future Sight &fstacks%nl%<#d48bc3>from targets within &f%{_radiusmindTransfer}% blocks <#d48bc3>onto Espeon.%nl% %nl%<#d48bc3>The next &f <#f7b2e7>Future Sight <#d48bc3>used afterward%nl%<#d48bc3>will add &fall stacks <#d48bc3>from Espeon to the &fstack%nl%&fcount <#d48bc3>of the select target.%nl% %nl%%{_loremindTransfer3}%"
						set {_loremindTransfer} to "&8Basic Ability%nl%&fInstant cast &7| &f%{_mindTransferCastTime}% cast%nl%&7Cooldown:  &f%{_mindTransferCd}%%nl%&7Use: &fRMB &7| &fSNEAK + RMB%nl%<#d48bc3>Increases the &f <#f7b2e7>Future Sight &fstack count%nl%<#d48bc3>on the target by &f%{_stacksAdd}% <#d48bc3>and adds an additional%nl%&f%{_extraDurationAdd}% <#d48bc3>to the fall duration of the spell.%nl% %nl%<#d48bc3>If &f <#f7b2e7>Mind Transfer <#d48bc3>is used while &fsneaking<#d48bc3>, this%nl%%{_loremindTransfer2}%"
						set {_loreHypercognition2} to "<#d48bc3>When this ability &fends <#d48bc3>or Espeon &ffails <#d48bc3>to complete%nl%<#d48bc3>a task set, Espeon releases a psychic shockwave,%nl%<#d48bc3>dealing &f%{_dmgHypercognition}% <#d84af7>Psychic <#d48bc3>damage in a &f%{_radiusHypercognition}% block <#d48bc3>radius <#d48bc3>and%nl%<#d48bc3>gaining &f %{_intHypercognition}% <#f7b2e7>Intellect <#d48bc3>per &f <#f7b2e7>Hypercognition <#d48bc3>stack.%nl%<#d48bc3>On &ftask failure<#d48bc3>, receive &f50%% <#d48bc3>of the accumulated%nl%<#d48bc3>damage.%nl% %nl%&f <#f7b2e7>Hypercognition <#d48bc3>will pause &fall active &f <#f7b2e7>Future Sight%nl%<#d48bc3>effects and &fdisable ability usage <#d48bc3>for the duration.%nl%<#d48bc3>Espeon will become &finvulnerable <#d48bc3>during this spell.%nl% %nl%&f <#f7b2e7>Hypercognition State:%nl%<#d48bc3>Espeon will gain a &fspecified amount of time <#d48bc3>to complete%nl%<#d48bc3>a randomly selected &fset of tasks <#d48bc3>in order from &fleft%nl%&fto right<#d48bc3>. If all tasks are completed successfully,%nl%<#d48bc3>a new list of tasks is chosen and Espeon gains a%nl%&fstack <#d48bc3>of &f <#f7b2e7>Hypercognition<#d48bc3>."
						
						set slot 1 of {_gui} to purple dye named "<#d48bc3>Mastery: Mental Agility" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown:  &fnone%nl%&7Use: &fPASSIVE%nl%<#d48bc3>For each stack of &f <#f7b2e7>Future Sight <#d48bc3>that%nl%<#d48bc3>exists on the field, gain &f %{_intellectGain}% <#f7b2e7>Intellect%nl%<#d48bc3>and &f %{_hasteGain}% <#f7b2e7>Haste<#d48bc3>." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 10 of {_gui} to ender pearl named "<#d48bc3>Psy Wave" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_psyWaveCd}%%nl%&7Use: &fSNEAK + LMB%nl%<#d48bc3>Espeon can use &fsneak + left click <#d48bc3>to%nl%<#d48bc3>send out a psy wave towards an enemy%nl%<#d48bc3>and &fInterrupt <#d48bc3>their spell cast. &f <#f7b2e7>Psy Wave%nl%<#d48bc3>will additionally &f Silence <#d48bc3>the enemy for%nl%&f%{_silenceDuration}% sec <#d48bc3>on successful &fInterrupt<#d48bc3>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						
						set slot 19 of {_gui} to pink dye named "<#d48bc3>Future Sight" with lore {_loreFutureSight} with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
						set slot 20 of {_gui} to fermented spider eye named "<#d48bc3>Mind Transfer" with lore {_loremindTransfer} with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						
						set slot 28 of {_gui} to magenta dye named "<#d48bc3>Hypercognition" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_hypercognitionCd}%%nl%&7Use: &fRMB%nl%<#d48bc3>Espeon enters a <#f7b2e7>state of &f <#f7b2e7>Hypercognition<#d48bc3>, gaining%nl%<#d48bc3>transcendental mental powers and allowing them to%nl%<#d48bc3>perform &fsequential tasks <#d48bc3>to gain increased power.%nl% %nl%%{_loreHypercognition2}%" with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 29 of {_gui} to glass bottle named "<#d48bc3>Time Warp" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_timeWarpCd}%%nl%&7Use: &fRMB%nl%<#d48bc3>Warp the flow of time, increasing &f <#f7b2e7>Haste%nl%<#d48bc3>by &f%{_timeWarpHaste}% <#d48bc3>for all party <#d48bc3>members for &f%{_timeWarpDuration}% sec<#d48bc3>.%nl% %nl%<#d48bc3>If the player is not in a party or no party%nl%<#d48bc3>members can be found, grant the &f <#f7b2e7>Haste%nl%<#d48bc3>bonus to all allies within &f%{_timeWarpRadius}% blocks <#d48bc3>instead." with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
					open {_gui} to player
					stop
			#COMBAT STATS

			#MISCELLANEOUS

			#TOPKI
			if index of event-slot is 4:
				if {language::%player%} = "English":
					set {_top} to "Top"
					set {_sl1} to "&7Top levels:"
					set {_sl6} to "&7Top stats:"
					set {_na1} to "%{kartacolor::%player%}%Card"
					set {_sl2} to "&7Top kills:"
					set {_sl5} to "&7Top deaths:"
					set {_na2} to "%{kartacolor::%player%}%Combat"
					set {_sl3} to "&7Top damage dealt:"
					set {_sl4} to "&7Top damage taken:"
					set {_na3} to "%{kartacolor::%player%}%Damage"
					set {_na4} to "%{kartacolor::%player%}%Power"
					set {_sl7} to "&7Top gems:"
					set {_sl8} to "&7Top ascenscions:"
					set {_sl9} to "&7Top damage healed:"
				else:
					set {_top} to "Topki"
					set {_sl1} to "&7Top poziomy:"
					set {_sl6} to "&7Top staty:"
					set {_na1} to "%{kartacolor::%player%}%Karta"
					set {_na2} to "%{kartacolor::%player%}%Combat"
					set {_sl2} to "&7Top zabójstwa:"
					set {_sl5} to "&7Top śmierci:"
					set {_sl3} to "&7Top zadane obrażenia:"
					set {_sl4} to "&7Top otrzymane obrażenia:"
					set {_na3} to "%{kartacolor::%player%}%Obrażenia"
					set {_na4} to "%{kartacolor::%player%}%Ulepszenia"
					set {_sl7} to "&7Top gemy:"
					set {_sl8} to "&7Top wyniesienia:"
					set {_sl9} to "&7Top wyleczone obrażenia:"
				set (metadata tag "topkigui" of player) to chest inventory with 1 row named "%{_top}% %player's held item's name%"
				set {_item} to type of player's tool with blank nbt compound
				delete tag "CustomModelData" of nbt compound of {_item}
				set slot 1 of (metadata tag "topkigui" of player) to {_item} named {_na1} with lore " " and {_sl1} and topDesc(3, "poziomkarta::%{kartaname::%player%}%") and " " and {_sl6} and topDesc(4, "stattotal::%{kartaname::%player%}%")
				set slot 3 of (metadata tag "topkigui" of player) to {_item} named {_na2} with lore " " and {_sl2} and topDesc(3, "mobskilled::%{kartaname::%player%}%") and " " and {_sl5} and topDesc(4, "deaths::%{kartaname::%player%}%")
				set slot 5 of (metadata tag "topkigui" of player) to {_item} named {_na3} with lore " " and {_sl3} and topDesc(3, "damage::dealt::%{kartaname::%player%}%") and " " and {_sl4} and topDesc(4, "damage::taken::%{kartaname::%player%}%")
				set slot 7 of (metadata tag "topkigui" of player) to {_item} named {_na4} with lore " " and {_sl7} and topDesc(3, "gemyequipped::%{kartaname::%player%}%") and " " and {_sl8} and topDesc(4, "wyniesienie::%{kartaname::%player%}%")
				if {kartaname::%player%} = "Vaporeon":
					if {healcard::%{kartaname::%player%}%::%{_id}%} is not set:
						set {healcard::%{kartaname::%player%}%::%{_id}%} to 0
					add " " and {_sl9} and topDesc(4, "healcard::%{kartaname::%player%}%") to lore of slot 5 of (metadata tag "topkigui" of player)
				open (metadata tag "topkigui" of player) to player
			#GEAR
			else if index of event-slot is 13:
				set metadata tag "gearcard" of player to chest inventory with 6 rows named "&fGear"
				if line 19 of lore of {karta::%player%} contains "Id: ":
					set {_id} to uncolored line 19 of lore of {karta::%player%}
					replace all "Id: " in {_id} with ""
					set {_card} to {kartaname::%player%}

					loop yaml node keys "Slot Map" in "GearList":
						set {_slotIndex} to loop-value parsed as integer
						set {_gearSlot} to yaml value "Slot Map.%loop-value%" in "GearList"
						set {_gearItem} to yaml value "Gear.%{_gearSlot}%" in "activeCard-%player%"

						if {_gearItem} is set:
							set lore of {_gearItem} to EquippedGearLoreUpdate(player, {_gearItem})
							set slot {_slotIndex} of metadata tag "gearcard" of player to {_gearItem}
							
					set {_relic} to yaml value "Gear.Relic" in "activeCard-%player%"
					if {_relic} is set:
						set lore of {_relic} to EquippedGearLoreUpdate(player, {_relic})
						set slot 43 of metadata tag "gearcard" of player to {_relic}
				open (metadata tag "gearcard" of player) to player
				play sound "block.anvil.use" with volume 2 and pitch 1.65 to player

	if player's current inventory is (metadata tag "abilitygui" of player):
		cancel event
		#ABILITIES
		if index of event-slot is between 0 and 35:
			if name of event-slot does not contain "Next Page" or "Last Page":
				if event-slot is not air:
					play sound "entity.armadillo.scute_drop" with volume 1 and pitch 1 to player
					set metadata tag "abilitymenu" of player to chest inventory with 1 rows named "%uncolored (name of player's tool)% - %uncolored (name of clicked slot)%"
					set {_gui} to metadata tag "abilitymenu" of player
					set {_ele} to line 17 of lore of player's tool
					replace all "&7Element: " in {_ele} with ""
					set {_color} to last string color code of {_ele}
					set {_ability::*} to "&8Basic Ability", "&8Mastery Bonus", "&8Passive Ability" and "&8Ultimate Ability"
					loop {_ability::*}:
						loop lore of clicked slot:
							if loop-value-2 = loop-value-1:
								set {_isAbility} to true
								stop loop
						if {_isAbility} is true:
							set {_slot} to clicked slot
							loop lore of {_slot}:
								stop loop if {_true} is true
								if loop-value-2 contains "&7Ability Level:":
									set {_true} to true
								add loop-value-2 to {_lorelines::*}
							set {_lore} to join {_lorelines::*} by nl
							set {_clickedSlot} to clicked slot with lore {_lore}
							set {_customNbtClickedSlot} to custom nbt of {_clickedSlot}
							set {_nbt} to (uncolored name of (clicked slot))
							replace all "Mastery: " in {_nbt} with ""
							set boolean tag {_nbt} of {_customNbtClickedSlot} to true
							set boolean tag "Ability" of {_customNbtClickedSlot} to true
							set metadata tag "ClickedAbility" of player to {_clickedSlot}
							stop loop
					clear {_lore}

					set {_clickedAbilityName} to uncolored name of (metadata tag "ClickedAbility" of player)
					replace all "Mastery: " in {_clickedAbilityName} with ""
					set {_cardName} to uncolored name of player's tool
					if AbilityUpgradeable({_cardName}, {_clickedAbilityName}) is true:
						set slot 3 of {_gui} to (heart of the sea named "&bUpgrade Ability") with lore "&7Spend resources &7to upgrade this ability%nl%&7and increase its power." and {_lore}
					else:
						set slot 3 of {_gui} to gray stained glass pane named "&8Upgrade Unavailable" with lore "&7This ability cannot be upgraded."
					set slot 5 of {_gui} to (shulker shell named "&dObtain Ability") with lore "&7Click here to obtain the ability%nl%&7in case you've lost it or accidentally%nl%&7deleted it.%nl% %nl%&7&oKeep in mind that this ability is not%nl%&7&ousable without the %(name of player's tool)% &7&ocard."
					if AbilityUpgradeable({_cardName}, {_clickedAbilityName}) is true:
						set slot 4 of {_gui} to (magma cream named "&cModifiers") with lore "&7View the modifiers of this ability."
					else:
						set slot 4 of {_gui} to (gray stained glass pane named "&8Modifiers Unavailable") with lore "&7This ability has no upgradeable modifiers."
					if {_info} is set:
						set slot 6 of {_gui} to gunpowder named "Info" with lore {_info}
					open {_gui} to player
	if player's current inventory is (metadata tag "abilitymenu" of player):
		cancel event
		#ABILITIES
		if index of event-slot is between 0 and 8:
			if name of event-slot contains "&bUpgrade Ability":
				AbilityUpgradeMenu(player)
				play sound "block.enchantment_table.use" with volume 2 and pitch 1.4 to player
			else if index of event-slot = 4:
				AbilityModifiersMenu(player)
				play sound "block.amethyst_block.chime" with volume 2 and pitch 1.4 to player
			else if event-slot = shulker shell named "&dObtain Ability":
				set {_clickedAbility} to metadata tag "ClickedAbility" of player
				if cooldown "%uncolored name of {_clickedAbility}%-Obtain%player%" is finished:
					create cooldown "%uncolored name of {_clickedAbility}%-Obtain%player%" for 5 minutes
					set string tag "Card" of (custom nbt of {_clickedAbility}) to (uncolored name of (player's tool))
					give player {_clickedAbility}
				else:
					set {_cdd} to cooldown "%uncolored (name of {_clickedAbility})%-Obtain%player%"
					send "&c&oYou must wait &f&o%{_cdd}% &c&obefore you can obtain this ability again." to player
					play sound "entity.villager.no" with volume 2 and pitch 1 to player
				open metadata tag "abilitygui" of player to player
				play sound "entity.armadillo.scute_drop" with volume 1 and pitch 1.5 to player


	if player's current inventory is (metadata tag "abilityupgrademenu" of player):
		cancel event
		if event-slot = 16:
			set {_ability} to metadata tag "AbilityUpgradeAbility" of player
			set {_card} to metadata tag "AbilityUpgradeCard" of player
			set {_nextLevel} to metadata tag "AbilityUpgradeNextLevel" of player
			if AbilityUpgradeCanAfford(player, {_card}, {_nextLevel}) is true:
				AbilityUpgradeTakeCost(player, {_card}, {_nextLevel})
				AbilityUpgradeApply(player, {_card}, {_ability}, {_nextLevel})
				play sound "entity.player.levelup" with volume 3 and pitch 1.6 to player
				send "&a✦ Successfully upgraded &9%{_ability}% &ato &9Level %{_nextLevel}%&a!" to player
				loop all players:
					send "&a✦ &f%player% &aSuccessfully upgraded their &9%{_ability}% &aability to &9Level %{_nextLevel}%&a!" to player
				AbilityUpgradeMenu(player)
				play sound "ui.toast.challenge_complete" with volume 5 and pitch 2 at player
			else:
				play sound "entity.villager.no" with volume 2 and pitch 1 to player
				send "&cYou do not have enough materials to upgrade this ability." to player

	if player's current inventory is (metadata tag "abilitymodifiersmenu" of player):
		cancel event



function BuckshotAbilityPreviewLore(p: player, ability: text) :: text:
	set {_customnbt} to custom nbt of {karta::%{_p}%}
	set {_haste} to Haste({_p})
	set {_cc} to CrowdControlStat({_p})

	set {_mastery} to (180 + (Mastery({_p})/7.25))

	set {_cdPortals} to round((9/{_haste}), 1)
	set {_portalDuration} to 40
	set {_portalCharges} to 2
	set {_portalRange} to 4 + {_cc}/25
	set {_portalMaxBounces} to 3

	set {_bindingShotDamage} to 5 + ({damage::%{_p}%}/11) + (Versatility({_p})/33) + ({primarystat::%{_p}%}/5.5)
	if string tag "Talents;Row 5" of {_customnbt} = "Dimensional Damage":
		set {_portalDuration} to {_portalDuration} + 10
		set {_bindingShotDamage} to {_bindingShotDamage} * 1.5
	set {_bindingShotDuration} to 10
	set {_bindingShotDurationPull} to 10
	set {_bindingShotCooldown} to 25

	set {_damage} to 2 + ({damage::%{_p}%}/33) + (Versatility({_p})/99) + ({primarystat::%{_p}%}/16.5)
	set {_spreadShotArrows} to 5
	set {_spreadShotEffectiveness} to 60
	if boolean tag "Constellation;And For My Next Trick" of {_customnbt} is set:
		set {_spreadShotArrows} to {_spreadShotArrows} + 1
	if string tag "Talents;Row 1" of {_customnbt} = "Wideshot":
		set {_spreadShotArrows} to {_spreadShotArrows} + 1

	set {_goatDuration} to 20
	set {_goatCooldown} to 240
	set {_goatPortals} to 12
	if string tag "Talents;Row 3" of {_customnbt} = "Hail of Portals":
		set {_goatCooldown} to {_goatCooldown} - 60
		set {_goatPortals} to {_goatPortals} + 4
	set {_goatDistance} to 15

	if {_ability} = "Portal Mastery":
		return GetAbilityDescription({_p}, "Buckshot", "Portal Mastery", "MASTERY", {_mastery})
	else if {_ability} = "Mystic Shots":
		return GetAbilityDescription({_p}, "Buckshot", "Mystic Shots", "", 0)
	else if {_ability} = "Starbolt":
		set {_valueNames::*} to "DAMAGE", "ARROWS", "EFFECTIVENESS"
		set {_values::*} to {_damage}, {_spreadShotArrows}, {_spreadShotEffectiveness}
		return GetAbilityDescription({_p}, "Buckshot", "Starbolt", {_valueNames::*}, {_values::*})
	else if {_ability} = "Magic Portals":
		set {_valueNames::*} to "CHARGES", "COOLDOWN", "RANGE", "DURATION", "BOUNCES"
		set {_values::*} to {_portalCharges}, {_cdPortals}, {_portalRange}, {_portalDuration}, {_portalMaxBounces}
		return GetAbilityDescription({_p}, "Buckshot", "Magic Portals", {_valueNames::*}, {_values::*})
	else if {_ability} = "Binding Shot":
		set {_valueNames::*} to "COOLDOWN", "DURATION", "DURATIONPULL", "DAMAGE"
		set {_values::*} to {_bindingShotCooldown}, {_bindingShotDuration}, {_bindingShotDurationPull}, {_bindingShotDamage}
		return GetAbilityDescription({_p}, "Buckshot", "Binding Shot", {_valueNames::*}, {_values::*})
	else if {_ability} = "GOAT":
		set {_valueNames::*} to "COOLDOWN", "PORTALCOUNT", "DISTANCE", "DURATION"
		set {_values::*} to {_goatCooldown}, {_goatPortals}, {_goatDistance}, {_goatDuration}
		return GetAbilityDescription({_p}, "Buckshot", "GOAT", {_valueNames::*}, {_values::*})
	return ""

function GhazanAbilityPreviewLore(p: player, ability: text) :: text:
	if {_ability} = "Lava Technique":
		broadcast "helllo"
		return GhazanLavaTechniqueDescription({_p})
	else if {_ability} = "Lava Surge":
		return GhazanLavaSurgeDescription({_p})
	else if {_ability} = "Lava Burst":
		return GhazanLavaBurstDescription({_p})
	else if {_ability} = "Molten Lava":
		return GhazanMoltenLavaDescription({_p})
	else if {_ability} = "Rain of Lava":
		return GhazanRainOfLavaDescription({_p})
	else if {_ability} = "Ascendance":
		return GhazanAscendanceDescription({_p})
	else if {_ability} = "Lava Wave":
		return GhazanLavaWaveDescription({_p})
	else if {_ability} = "Lavakeeper":
		return GhazanLavakeeperDescription({_p})
	else if {_ability} = "Lavafury":
		return GhazanLavafuryDescription({_p})
	return ""

function AbilityModifierLore(p: player, card: text, ability: text) :: text:
	set {_level} to AbilityUpgradeLevel({_p}, {_ability})
	set {_lore} to "&9Ability Modifiers%nl%&7Current Ability Level: &f%{_level}%%nl% %nl%&7These are the values held by%nl%&7this ability. Upgrading awakens%nl%&7stronger values for these modifiers.%nl% "
	loop yaml list "Card.%{_card}%.%{_ability}%.Upgrades.Display" in "SpellList":
		set {_entry::*} to loop-value split at "|"
		set {_label} to {_entry::1}
		set {_modifier} to {_entry::2}
		set {_format} to {_entry::3}
		set {_value} to AbilityUpgradeValue({_p}, {_card}, {_ability}, {_modifier}, {_level})
		set {_valueText} to AbilityUpgradeFormatValue({_value}, {_format})
		set {_lore} to "%{_lore}%%nl%&8✦ &7%{_label}%: &f%{_valueText}%"
	return {_lore}

function AbilityModifiersMenu(p: player):
	set {_card} to uncolored name of {_p}'s tool
	set {_ability} to uncolored name of (metadata tag "ClickedAbility" of {_p})
	replace all "Mastery: " in {_ability} with ""
	if AbilityUpgradeable({_card}, {_ability}) is not true:
		stop
	set metadata tag "abilitymodifiersmenu" of {_p} to chest inventory with 3 rows named "%{_card}% - %{_ability}% Modifiers"
	set {_gui} to metadata tag "abilitymodifiersmenu" of {_p}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
	set {_item} to metadata tag "ClickedAbility" of {_p}
	set lore of {_item} to AbilityModifierLore({_p}, {_card}, {_ability})
	set slot 13 of {_gui} to {_item}
	open {_gui} to {_p}

function AbilityUpgradeMaxLevel(card: text, ability: text) :: integer:
	set {_max} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Max Level" in "SpellList"
	if {_max} is not set:
		set {_max} to 5
	return {_max}

function AbilityUpgradeLevel(p: player, ability: text) :: integer:
	set {_level} to yaml value "Card.Ability Levels.%{_ability}%" in "activeCard-%{_p}%"
	if {_level} is not set:
		set {_level} to 0
	return {_level}

function AbilityUpgradeable(card: text, ability: text) :: boolean:
	set {_enabled} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Enabled" in "SpellList"
	if {_enabled} is true:
		return true
	return false

function AbilityUpgradeValue(p: player, card: text, ability: text, modifier: text, level: integer = -1) :: number:
	if {_level} < 0:
		set {_level} to AbilityUpgradeLevel({_p}, {_ability})
	set {_currentLevel} to AbilityUpgradeLevel({_p}, {_ability})
	if {_level} = {_currentLevel}:
		set {_value} to yaml value "Card.Ability Modifiers.%{_ability}%.%{_modifier}%" in "activeCard-%{_p}%"
	if {_value} is not set:
		set {_value} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Levels.%{_level}%.%{_modifier}%" in "SpellList"
	if {_value} is not set:
		set {_value} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Levels.0.%{_modifier}%" in "SpellList"
	if {_value} is not set:
		if {_ability} = "Glacial Spike":
			if {_modifier} = "CASTTIME":
				set {_value} to 2.75
			else if {_modifier} = "BASEDAMAGE":
				set {_value} to 5.0
			else if {_modifier} = "DAMAGESCALING":
				set {_value} to 7.0
	if {_value} is not set:
		set {_value} to 0
	return {_value}

function AbilityUpgradeFormatValue(value: number, valueFormat: text) :: text:
	if {_valueFormat} = "scaling":
		set {_text} to "%round((1 / {_value}) * 100, 2)%%%"
	else if {_valueFormat} = "percent":
		set {_text} to "%{_value}%%%"
	else if {_valueFormat} = "multiplier":
		set {_text} to "%round({_value} * 100, 2)%%%"
	else if {_valueFormat} = "sec":
		set {_text} to "%{_value}% sec"
	else:
		set {_text} to "%{_value}%"
	return {_text}


function AbilityUpgradeDescription(p: player, card: text, ability: text, valueNames: texts, values: objects) :: text:
	set {_description::*} to yaml list "%{_card}%.%{_ability}%.Description" in "AbilityDescriptionList"
	set {_description} to (join {_description::*} by nl)

	set {_primCol} to getPrimaryCardColour({_p})
	set {_secCol} to getSecondaryCardColour({_p})

	replace all "{COLOUR:primary}" in {_description} with {_primCol}
	replace all "{COLOUR:secondary}" in {_description} with {_secCol}

	loop {_valueNames::*}:
		if loop-value = "COOLDOWN":
			set {_timespanText} to "%{_values::%loop-counter%}%"

			replace all "seconds" in {_timespanText} with "sec"
			replace all "second" in {_timespanText} with "sec"
			replace all "minute" in {_timespanText} with "min"
			replace all "minutes" in {_timespanText} with "min"
			
			replace all "{COOLDOWN}" in {_description} with {_timespanText}
		else:
			replace all "{%loop-value%}" in {_description} with "%{_values::%loop-counter%}%"	

	set {_variant} to getCurrentVariant({_p}, {_card})
	set {_cardAbilities::*} to yaml node keys "Card.%{_card}%" in "SpellList"

	loop {_cardAbilities::*}:
		set {_icon} to yaml value "Card.%{_card}%.%loop-value%.Icons.%{_variant}%" in "SpellList"
		replace all "{ICON:%loop-value%}" in {_description} with {_icon}

	set {_description} to ReplaceTalentPlaceholders({_p}, {_card}, {_description})
	set {_description} to coloured {_description}
	return {_description}

function GlaceonAbilityPreviewLore(p: player, ability: text) :: text:
	set {_customnbt} to custom nbt of {karta::%{_p}%}
	set {_hasteTt} to Haste({_p})
	set {_pospiech} to Haste({_p})

	if {_ability} = "Glacial Spike":
		set {_baseCastTime} to 2.75
		if HasStarforgedBonus({_p}, "Glaceon", "Tier I", "2Set") is true:
			set {_baseCastTime} to {_baseCastTime} - 0.25
		set {_castTime} to "%round({_baseCastTime}/{_hasteTt}, 1)% sec"
		set {_damage} to 5.0 + ({damage::%{_p}%}/14) + (Versatility({_p})/42) + ({primarystat::%{_p}%}/7.0)
		if boolean tag "Constellation;Eternal Winter" of {_customnbt} is set:
			set {_icicleCap} to 7
		else:
			set {_icicleCap} to 5
		set {_valueNames::*} to "CASTTIME", "DAMAGE", "ICICLECAP"
		set {_values::*} to {_castTime}, {_damage}, {_icicleCap}
		set {_description} to AbilityUpgradeDescription({_p}, "Glaceon", "Glacial Spike", {_valueNames::*}, {_values::*})
		return {_description}

function GlaceonAbilityUpgradePreviewLore(p: player, ability: text, level: integer, colour: text, compareLevel: integer = -1) :: text:
	set {_customnbt} to custom nbt of {karta::%{_p}%}
	set {_hasteTt} to Haste({_p})
	set {_pospiech} to Haste({_p})
	set {_levelLine} to "&9Level %{_level}%"

	if {_ability} = "Shatter":
		set {_baseCrit} to AbilityUpgradeValue({_p}, "Glaceon", "Shatter", "CRITCHANCE", {_level})
		set {_chillCrit} to AbilityUpgradeValue({_p}, "Glaceon", "Shatter", "CHILLCRIT", {_level})
		set {_oldBaseCrit} to {_baseCrit}
		set {_oldChillCrit} to {_chillCrit}
		if {_compareLevel} >= 0:
			set {_oldBaseCrit} to AbilityUpgradeValue({_p}, "Glaceon", "Shatter", "CRITCHANCE", {_compareLevel})
			set {_oldChillCrit} to AbilityUpgradeValue({_p}, "Glaceon", "Shatter", "CHILLCRIT", {_compareLevel})
		set {_valueNames::*} to "CRITCHANCE", "CHILLCRIT"
		set {_values::*} to AbilityUpgradePreviewValue({_baseCrit}, {_colour}, {_oldBaseCrit}), AbilityUpgradePreviewValue({_chillCrit}, {_colour}, {_oldChillCrit})
		set {_description} to AbilityUpgradeDescription({_p}, "Glaceon", "Shatter", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Icicles":
		set {_baseHeal} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "BASEDAMAGE", {_level})
		set {_scaling} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "DAMAGESCALING", {_level})
		set {_dmg} to ({_baseHeal} + ({damage::%{_p}%}/75) + (Versatility({_p})/225) + ({primarystat::%{_p}%}/{_scaling})) * (1 + (Mastery({_p})/3.75/100))
		set {_oldDmg} to {_dmg}
		set {_oldScaling} to {_scaling}
		if {_compareLevel} >= 0:
			set {_oldBaseHeal} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "BASEDAMAGE", {_compareLevel})
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Icicles", "DAMAGESCALING", {_compareLevel})
			set {_oldDmg} to ({_oldBaseHeal} + ({damage::%{_p}%}/75) + (Versatility({_p})/225) + ({primarystat::%{_p}%}/{_oldScaling})) * (1 + (Mastery({_p})/3.75/100))
		if boolean tag "Constellation;Eternal Winter" of {_customnbt} is set:
			set {_icicleCap} to 7
		else:
			set {_icicleCap} to 5
		set {_valueNames::*} to "DAMAGE", "MAX"
		set {_values::*} to AbilityUpgradePreviewValue({_dmg}, {_colour}, {_oldDmg}), {_icicleCap}
		set {_description} to AbilityUpgradeDescription({_p}, "Glaceon", "Icicles", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Frostbolt":
		set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "BASEDAMAGE", {_level})
		set {_baseDamage} to 2.0 if {_baseDamage} <= 0
		set {_scaling} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "DAMAGESCALING", {_level})
		set {_scaling} to 20.0 if {_scaling} <= 0
		set {_damage} to {_baseDamage} + ({damage::%{_p}%}/40) + (Versatility({_p})/120) + ({primarystat::%{_p}%}/{_scaling})
		set {_baseCastTime} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "CASTTIME", {_level})
		set {_baseCastTime} to 2.0 if {_baseCastTime} <= 0
		set {_castTime} to "%round(({_baseCastTime}/{_hasteTt}), 1)% sec"
		set {_slowtime} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "SLOWTIME", {_level})
		set {_slowtime} to 2.0 if {_slowtime} <= 0
		set {_slowtimeText} to "%{_slowtime} + ({crowdcontrol::%{_p}%}/100)% sec"
		set {_chance} to 15 + getRunePower({_p}, "Piercing Cold")
		set {_brainFreezeChance} to 30
		if string tag "Talents;Row 1" of {_customnbt} = "Clarity of Thought":
			set {_brainFreezeChance} to {_brainFreezeChance} + 5
		set {_oldDamage} to {_damage}
		set {_oldSlowtime} to {_slowtimeText}
		set {_oldCastTimeText} to {_castTime}
		if {_compareLevel} >= 0:
			set {_oldBaseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "BASEDAMAGE", {_compareLevel})
			set {_oldBaseDamage} to 2.0 if {_oldBaseDamage} <= 0
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "DAMAGESCALING", {_compareLevel})
			set {_oldScaling} to 20.0 if {_oldScaling} <= 0
			set {_oldDamage} to {_oldBaseDamage} + ({damage::%{_p}%}/40) + (Versatility({_p})/120) + ({primarystat::%{_p}%}/{_oldScaling})
			set {_oldSlowtimeNum} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "SLOWTIME", {_compareLevel})
			set {_oldSlowtimeNum} to 2.0 if {_oldSlowtimeNum} <= 0
			set {_oldSlowtime} to "%{_oldSlowtimeNum} + ({crowdcontrol::%{_p}%}/100)% sec"
			set {_oldBaseCastTime} to AbilityUpgradeValue({_p}, "Glaceon", "Frostbolt", "CASTTIME", {_compareLevel})
			set {_oldBaseCastTime} to 2.0 if {_oldBaseCastTime} <= 0
			set {_oldCastTimeText} to "%round(({_oldBaseCastTime}/{_hasteTt}), 1)% sec"
		set {_valueNames::*} to "CASTTIME", "DAMAGE", "SLOWTIME", "CHANCE", "BRAINFREEZECHANCE"
		set {_values::*} to AbilityUpgradePreviewValue({_castTime}, {_colour}, {_oldCastTimeText}), AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage}), AbilityUpgradePreviewValue({_slowtimeText}, {_colour}, {_oldSlowtime}), {_chance}, {_brainFreezeChance}
		set {_description} to AbilityUpgradeDescription({_p}, "Glaceon", "Frostbolt", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Ice Lance":
		set {_baseCd} to 1.5
		set {_cooldown} to "%{_baseCd}/{_hasteTt}% seconds" parsed as timespan
		set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Ice Lance", "BASEDAMAGE", {_level})
		set {_scaling} to AbilityUpgradeValue({_p}, "Glaceon", "Ice Lance", "DAMAGESCALING", {_level})
		set {_damage} to {_baseDamage} + ({damage::%{_p}%}/34) + (Versatility({_p})/102) + ({primarystat::%{_p}%}/{_scaling})
		set {_freezeBonus} to AbilityUpgradeValue({_p}, "Glaceon", "Ice Lance", "FREEZEBONUS", {_level})
		set {_oldCooldown} to {_cooldown}
		set {_oldDamage} to {_damage}
		set {_oldFreezeBonus} to {_freezeBonus}
		if {_compareLevel} >= 0:
			set {_oldDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Ice Lance", "BASEDAMAGE", {_compareLevel}) + ({damage::%{_p}%}/34) + (Versatility({_p})/102) + ({primarystat::%{_p}%}/{_scaling})
			set {_oldFreezeBonus} to AbilityUpgradeValue({_p}, "Glaceon", "Ice Lance", "FREEZEBONUS", {_compareLevel})
		set {_valueNames::*} to "COOLDOWN", "DAMAGE", "FREEZEBONUS"
		set {_values::*} to AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage}), AbilityUpgradePreviewValue({_freezeBonus}, {_colour}, {_oldFreezeBonus})
		set {_description} to AbilityUpgradeDescription({_p}, "Glaceon", "Ice Lance", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Flurry":
		set {_baseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "BASEDAMAGE", {_level})
		set {_scaling} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "DAMAGESCALING", {_level})
		set {_damage} to {_baseDamage} + ({damage::%{_p}%}/36) + (Versatility({_p})/108) + ({primarystat::%{_p}%}/{_scaling})
		set {_castTime} to "%round(3/{_hasteTt}, 1)% sec"
		set {_slowtime} to "%2 + ({crowdcontrol::%{_p}%}/100)% sec"
		set {_bfBonus} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "BRAINFREEZEBONUS", {_level})
		set {_slow} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "SLOW", {_level})
		set {_hits} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "HITS", {_level})
		set {_oldDamage} to {_damage}
		set {_oldBfBonus} to {_bfBonus}
		set {_oldSlow} to {_slow}
		set {_oldHits} to {_hits}
		if {_compareLevel} >= 0:
			set {_oldBaseDamage} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "BASEDAMAGE", {_compareLevel})
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "DAMAGESCALING", {_compareLevel})
			set {_oldDamage} to {_oldBaseDamage} + ({damage::%{_p}%}/36) + (Versatility({_p})/108) + ({primarystat::%{_p}%}/{_oldScaling})
			set {_oldBfBonus} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "BRAINFREEZEBONUS", {_compareLevel})
			set {_oldSlow} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "SLOW", {_compareLevel})
			set {_oldHits} to AbilityUpgradeValue({_p}, "Glaceon", "Flurry", "HITS", {_compareLevel})
		set {_valueNames::*} to "CASTTIME", "DAMAGE", "SLOWTIME", "BRAINFREEZEBONUS", "SLOW", "HITS"
		set {_values::*} to {_castTime}, AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage}), {_slowtime}, AbilityUpgradePreviewValue({_bfBonus}, {_colour}, {_oldBfBonus}), AbilityUpgradePreviewValue({_slow}, {_colour}, {_oldSlow}), AbilityUpgradePreviewValue({_hits}, {_colour}, {_oldHits})
		set {_description} to AbilityUpgradeDescription({_p}, "Glaceon", "Flurry", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Icy Veins":
		set {_baseCd} to AbilityUpgradeValue({_p}, "Glaceon", "Icy Veins", "COOLDOWN", {_level}) - getRunePower({_p}, "Deep Freeze")
		set {_cooldown} to "%{_baseCd}% seconds" parsed as timespan
		set {_duration} to AbilityUpgradeValue({_p}, "Glaceon", "Icy Veins", "DURATION", {_level})
		set {_haste} to AbilityUpgradeValue({_p}, "Glaceon", "Icy Veins", "HASTE", {_level})
		set {_oldCooldown} to {_cooldown}
		set {_oldDuration} to {_duration}
		set {_oldHaste} to {_haste}
		if {_compareLevel} >= 0:
			set {_oldBaseCd} to AbilityUpgradeValue({_p}, "Glaceon", "Icy Veins", "COOLDOWN", {_compareLevel}) - getRunePower({_p}, "Deep Freeze")
			set {_oldCooldown} to "%{_oldBaseCd}% seconds" parsed as timespan
			set {_oldDuration} to AbilityUpgradeValue({_p}, "Glaceon", "Icy Veins", "DURATION", {_compareLevel})
			set {_oldHaste} to AbilityUpgradeValue({_p}, "Glaceon", "Icy Veins", "HASTE", {_compareLevel})
		set {_valueNames::*} to "COOLDOWN", "DURATION", "HASTE"
		set {_values::*} to AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_duration}, {_colour}, {_oldDuration}), AbilityUpgradePreviewValue({_haste}, {_colour}, {_oldHaste})
		set {_description} to AbilityUpgradeDescription({_p}, "Glaceon", "Icy Veins", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	
function VaporeonAbilityUpgradePreviewLore(p: player, ability: text, level: integer, colour: text, compareLevel: integer = -1) :: text:
	set {_customnbt} to custom nbt of {karta::%{_p}%}
	set {_hasteTt} to Haste({_p})
	set {_pospiech} to Haste({_p})
	set {_levelLine} to "&9Level %{_level}%"

	if {_ability} = "Water Cycles":
		set {_baseHeal} to AbilityUpgradeValue({_p}, "Vaporeon", "Water Cycles", "BASEHEAL", {_level})
		set {_baseShield} to AbilityUpgradeValue({_p}, "Vaporeon", "Water Cycles", "BASESHIELD", {_level})
		set {_scaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Water Cycles", "SCALING", {_level})
		set {_oldBaseHeal} to {_baseHeal}
		set {_oldBaseShield} to {_baseShield}
		set {_oldScaling} to {_scaling}
		if {_compareLevel} >= 0:
			set {_oldBaseHeal} to AbilityUpgradeValue({_p}, "Vaporeon", "Water Cycles", "BASEHEAL", {_compareLevel})
			set {_oldBaseShield} to AbilityUpgradeValue({_p}, "Vaporeon", "Water Cycles", "BASESHIELD", {_compareLevel})
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Water Cycles", "SCALING", {_compareLevel})
		set {_valueNames::*} to "BASEHEAL", "BASESHIELD", "SCALING"
		set {_values::*} to AbilityUpgradePreviewValue({_baseHeal}, {_colour}, {_oldBaseHeal}), AbilityUpgradePreviewValue({_baseShield}, {_colour}, {_oldBaseShield}), AbilityUpgradePreviewValue({_scaling}, {_colour}, {_oldScaling})
		set {_description} to AbilityUpgradeDescription({_p}, "Vaporeon", "Water Cycles", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Circle of Water":
		set {_baseHeal} to AbilityUpgradeValue({_p}, "Vaporeon", "Circle of Water", "BASEHEAL", {_level})
		set {_scaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Circle of Water", "HEALSCALING", {_level})
		set {_rune} to getRunePower({_p}, "Soothing Ripple")
		set {_heal} to {_baseHeal} + ({utility::%{_p}%}/100) + (Versatility({_p})/300) + ({primarystat::%{_p}%}/{_scaling})
		set {_heal} to {_heal} * (1 + {_rune}/100)
		set {_oldHeal} to {_heal}
		if {_compareLevel} >= 0:
			set {_oldBaseHeal} to AbilityUpgradeValue({_p}, "Vaporeon", "Circle of Water", "BASEHEAL", {_compareLevel})
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Circle of Water", "HEALSCALING", {_compareLevel})
			set {_oldHeal} to {_oldBaseHeal} + ({utility::%{_p}%}/100) + (Versatility({_p})/300) + ({primarystat::%{_p}%}/{_oldScaling})
			set {_oldHeal} to {_oldHeal} * (1 + {_rune}/100)
		set {_valueNames::*} to "DAMAGE"
		set {_values::*} to AbilityUpgradePreviewValue({_heal}, {_colour}, {_oldHeal})
		set {_description} to AbilityUpgradeDescription({_p}, "Vaporeon", "Circle of Water", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Tidal Waves":
		set {_healBonus} to AbilityUpgradeValue({_p}, "Vaporeon", "Tidal Waves", "HEALBONUS", {_level})
		set {_oldHealBonus} to {_healBonus}
		if {_compareLevel} >= 0:
			set {_oldHealBonus} to AbilityUpgradeValue({_p}, "Vaporeon", "Tidal Waves", "HEALBONUS", {_compareLevel})
		if string tag "Talents;Row 4" of {_customnbt} = "Coalescing Tides":
			set {_maxStacks} to 4
		else:
			set {_maxStacks} to 2
		set {_valueNames::*} to "HEALBONUS", "MAXSTACKS"
		set {_values::*} to AbilityUpgradePreviewValue({_healBonus}, {_colour}, {_oldHealBonus}), {_maxStacks}
		set {_description} to AbilityUpgradeDescription({_p}, "Vaporeon", "Tidal Waves", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Undertow":
		set {_baseCd} to AbilityUpgradeValue({_p}, "Vaporeon", "Undertow", "COOLDOWN", {_level})
		set {_cdSeconds} to {_baseCd} / {_hasteTt}
		set {_cooldown} to "%{_cdSeconds}% seconds" parsed as timespan
		set {_baseDamage} to AbilityUpgradeValue({_p}, "Vaporeon", "Undertow", "BASEDAMAGE", {_level})
		set {_scaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Undertow", "DAMAGESCALING", {_level})
		set {_rune} to getRunePower({_p}, "Abyssal Pull")
		set {_damage} to {_baseDamage} + ({damage::%{_p}%}/65) + (Versatility({_p})/195) + ({primarystat::%{_p}%}/{_scaling})
		if HasStarforgedBonus({_p}, "Vaporeon", "Tier I", "2Set") is true:
			set {_damage} to {_damage} * 1.2
		set {_damage} to {_damage} * (1 + {_rune}/100)
		set {_castTime} to "%round(1.5/{_hasteTt}, 1)% sec"
		set {_oldCooldown} to {_cooldown}
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldBaseCd} to AbilityUpgradeValue({_p}, "Vaporeon", "Undertow", "COOLDOWN", {_compareLevel})
			set {_oldCdSeconds} to {_oldBaseCd} / {_hasteTt}
			set {_oldCooldown} to "%{_oldCdSeconds}% seconds" parsed as timespan
			set {_oldBaseDamage} to AbilityUpgradeValue({_p}, "Vaporeon", "Undertow", "BASEDAMAGE", {_compareLevel})
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Undertow", "DAMAGESCALING", {_compareLevel})
			set {_oldDamage} to {_oldBaseDamage} + ({damage::%{_p}%}/65) + (Versatility({_p})/195) + ({primarystat::%{_p}%}/{_oldScaling})
			if HasStarforgedBonus({_p}, "Vaporeon", "Tier I", "2Set") is true:
				set {_oldDamage} to {_oldDamage} * 1.2
			set {_oldDamage} to {_oldDamage} * (1 + {_rune}/100)
		set {_valueNames::*} to "CASTTIME", "COOLDOWN", "DAMAGE"
		set {_values::*} to {_castTime}, AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage})
		set {_description} to AbilityUpgradeDescription({_p}, "Vaporeon", "Undertow", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Healing Stream":
		set {_baseCd} to AbilityUpgradeValue({_p}, "Vaporeon", "Healing Stream", "COOLDOWN", {_level})
		set {_runeCd} to getRunePower({_p}, "Murmuring Springs")
		set {_cdSeconds} to ({_baseCd} / {_hasteTt}) - {_runeCd}
		if {_cdSeconds} < 0.5:
			set {_cdSeconds} to 0.5
		set {_cooldown} to "%{_cdSeconds}% seconds" parsed as timespan
		set {_baseHeal} to AbilityUpgradeValue({_p}, "Vaporeon", "Healing Stream", "BASEHEAL", {_level})
		set {_scaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Healing Stream", "HEALSCALING", {_level})
		set {_heal} to {_baseHeal} + ({utility::%{_p}%}/80) + (Versatility({_p})/240) + ({primarystat::%{_p}%}/{_scaling})
		if string tag "Talents;Row 1" of {_customnbt} = "Undulation":
			set {_charges} to 3
		else:
			set {_charges} to 2
		set {_oldCooldown} to {_cooldown}
		set {_oldHeal} to {_heal}
		if {_compareLevel} >= 0:
			set {_oldBaseCd} to AbilityUpgradeValue({_p}, "Vaporeon", "Healing Stream", "COOLDOWN", {_compareLevel})
			set {_oldCdSeconds} to ({_oldBaseCd} / {_hasteTt}) - {_runeCd}
			if {_oldCdSeconds} < 0.5:
				set {_oldCdSeconds} to 0.5
			set {_oldCooldown} to "%{_oldCdSeconds}% seconds" parsed as timespan
			set {_oldBaseHeal} to AbilityUpgradeValue({_p}, "Vaporeon", "Healing Stream", "BASEHEAL", {_compareLevel})
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Healing Stream", "HEALSCALING", {_compareLevel})
			set {_oldHeal} to {_oldBaseHeal} + ({utility::%{_p}%}/80) + (Versatility({_p})/240) + ({primarystat::%{_p}%}/{_oldScaling})
		set {_valueNames::*} to "CHARGES", "COOLDOWN", "DAMAGE"
		set {_values::*} to {_charges}, AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_heal}, {_colour}, {_oldHeal})
		set {_description} to AbilityUpgradeDescription({_p}, "Vaporeon", "Healing Stream", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Explosive Bubble":
		set {_cdtarget} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "COOLDOWN", {_level}) / {_hasteTt}
		set {_cooldown} to "%{_cdtarget}% seconds" parsed as timespan
		set {_baseShield} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "BASESHIELD", {_level})
		set {_shieldScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "SHIELDSCALING", {_level})
		set {_baseDamage} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "BASEDAMAGE", {_level})
		set {_damageScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "DAMAGESCALING", {_level})
		set {_rune} to getRunePower({_p}, "Pearlescent Shell")
		set {_shield} to {_baseShield} + ({utility::%{_p}%}/52) + (Versatility({_p})/156) + (PrimaryStat({_p})/{_shieldScaling})
		set {_shield} to {_shield} * (1 + {_rune}/100)
		set {_damage} to {_baseDamage} + ({damage::%{_p}%}/60) + (Versatility({_p})/180) + (PrimaryStat({_p})/{_damageScaling})
		set {_cdBubble} to "%round(1.5/{_hasteTt}, 1)% sec"
		set {_wait} to round(8/{_hasteTt}, 1)
		set {_oldCooldown} to {_cooldown}
		set {_oldShield} to {_shield}
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldCdtarget} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "COOLDOWN", {_compareLevel}) / {_hasteTt}
			set {_oldCooldown} to "%{_oldCdtarget}% seconds" parsed as timespan
			set {_oldBaseShield} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "BASESHIELD", {_compareLevel})
			set {_oldShieldScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "SHIELDSCALING", {_compareLevel})
			set {_oldBaseDamage} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "BASEDAMAGE", {_compareLevel})
			set {_oldDamageScaling} to AbilityUpgradeValue({_p}, "Vaporeon", "Explosive Bubble", "DAMAGESCALING", {_compareLevel})
			set {_oldShield} to {_oldBaseShield} + ({utility::%{_p}%}/52) + (Versatility({_p})/156) + (PrimaryStat({_p})/{_oldShieldScaling})
			set {_oldShield} to {_oldShield} * (1 + {_rune}/100)
			set {_oldDamage} to {_oldBaseDamage} + ({damage::%{_p}%}/60) + (Versatility({_p})/180) + (PrimaryStat({_p})/{_oldDamageScaling})
		set {_valueNames::*} to "CDBUBBLE", "COOLDOWN", "SHIELD", "WAIT", "DAMAGE"
		set {_values::*} to {_cdBubble}, AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_shield}, {_colour}, {_oldShield}), {_wait}, AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage})
		set {_description} to AbilityUpgradeDescription({_p}, "Vaporeon", "Explosive Bubble", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Reversal":
		set {_baseCd} to AbilityUpgradeValue({_p}, "Vaporeon", "Reversal", "COOLDOWN", {_level})
		set {_runeCd} to getRunePower({_p}, "Ebbing Tide")
		set {_cdSeconds} to ({_baseCd} / {_hasteTt}) - {_runeCd}
		if {_cdSeconds} < 10:
			set {_cdSeconds} to 10
		set {_cooldown} to "%{_cdSeconds}% seconds" parsed as timespan
		set {_effectiveness} to AbilityUpgradeValue({_p}, "Vaporeon", "Reversal", "EFFECTIVENESS", {_level})
		set {_oldCooldown} to {_cooldown}
		set {_oldEffectiveness} to {_effectiveness}
		if {_compareLevel} >= 0:
			set {_oldBaseCd} to AbilityUpgradeValue({_p}, "Vaporeon", "Reversal", "COOLDOWN", {_compareLevel})
			set {_oldCdSeconds} to ({_oldBaseCd} / {_hasteTt}) - {_runeCd}
			if {_oldCdSeconds} < 10:
				set {_oldCdSeconds} to 10
			set {_oldCooldown} to "%{_oldCdSeconds}% seconds" parsed as timespan
			set {_oldEffectiveness} to AbilityUpgradeValue({_p}, "Vaporeon", "Reversal", "EFFECTIVENESS", {_compareLevel})
		set {_valueNames::*} to "COOLDOWN", "EFFECTIVENESS"
		set {_values::*} to AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_effectiveness}, {_colour}, {_oldEffectiveness})
		set {_description} to AbilityUpgradeDescription({_p}, "Vaporeon", "Reversal", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"


function AbilityUpgradeModifierLore(p: player, card: text, ability: text, level: integer, colour: text, bold: boolean = false, compareLevel: integer = -1) :: text:
	if {_bold} = true:
		set {_lore} to "&9Level %{_level}% &8(Max)"
	else:
		set {_lore} to "&9Level %{_level}%"
	loop yaml list "Card.%{_card}%.%{_ability}%.Upgrades.Display" in "SpellList":
		set {_entry::*} to loop-value split at "|"
		set {_label} to {_entry::1}
		set {_modifier} to {_entry::2}
		set {_format} to {_entry::3}
		set {_value} to AbilityUpgradeValue({_p}, {_card}, {_ability}, {_modifier}, {_level})
		set {_valueText} to AbilityUpgradeFormatValue({_value}, {_format})
		if {_compareLevel} >= 0:
			set {_oldValue} to AbilityUpgradeValue({_p}, {_card}, {_ability}, {_modifier}, {_compareLevel})
			set {_oldValueText} to AbilityUpgradeFormatValue({_oldValue}, {_format})
			set {_lore} to "%{_lore}%%nl%&7%{_label}%: &e%{_oldValueText}% &f-> &a%{_valueText}%"
		else if {_bold} = true:
			set {_lore} to "%{_lore}%%nl%&7%{_label}%: %{_colour}%%{_valueText}%"
		else:
			set {_lore} to "%{_lore}%%nl%&7%{_label}%: %{_colour}%%{_valueText}%"
	return {_lore}

function AbilityUpgradeItem(p: player, card: text, ability: text, level: integer, colour: text, bold: boolean = false, compareLevel: integer = -1) :: item:
	set {_item} to metadata tag "AbilityUpgradeClickedAbility" of {_p}
	if {_card} = "Cresselia":
		set lore of {_item} to CresseliaAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else if {_card} = "Ghazan":
		set lore of {_item} to GhazanAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else if {_card} = "Brother Therold":
		set lore of {_item} to TheroldAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else if {_card} = "Delphox":
		set lore of {_item} to DelphoxAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else if {_card} = "Vaporeon":
		set lore of {_item} to VaporeonAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else if {_card} = "Glaceon":
		set lore of {_item} to GlaceonAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else:
		set lore of {_item} to AbilityUpgradeModifierLore({_p}, {_card}, {_ability}, {_level}, {_colour}, {_bold}, {_compareLevel})
	return {_item}

function AbilityUpgradePrismCost(level: integer) :: integer:
	if {_level} >= 5:
		return 2
	return 1

function getCardElement(card: text) :: text:
	set {_element} to yaml value "Cards.%{_card}%.Element" in "StellarChestList"
	return {_element}

function AbilityUpgradeCostLore(p: player, card: text, level: integer) :: text:
	set {_prismCost} to AbilityUpgradePrismCost({_level})
	set {_essenceCost} to 40 + (({_level} - 1) * 10)
	set {_fluxCost} to 500 * {_level}
	set {_peridotCost} to 30 * {_level}
	set {_cardStoneCost} to 200 * {_level}

	set {_element} to getCardElement({_card})
	set {_primCol} to getPrimaryCardColour({_p})
	set {_colour} to yaml value "%{_card}%.Classic.Colour.Primary" in "VariantList"
	set {_cardstone} to yaml value "Cardstone.Item" in "ItemList"
	set {_cardstoneName} to name of {_cardstone}

	return coloured "&7Cost:%nl%&f%{_prismCost}% <##f79eff>Magic <##9ed5ff>Prism%nl%&f%{_cardstoneCost}% %{_colour}%%{_card}% %{_cardstoneName}%%nl%&f%{_essenceCost}% %{_primCol}%%{_element}% Essence%nl%&f%{_fluxCost}% &f &7Cosmic Flux%nl%&f%{_peridotCost}% <#c0ff02>Peridot"

function AbilityUpgradeCanAfford(p: player, card: text, level: integer) :: boolean:
	set {_prismCost} to AbilityUpgradePrismCost({_level})
	set {_essenceCost} to 40 + (({_level} - 1) * 10)
	set {_fluxCost} to 500 * {_level}
	set {_peridotCost} to 30 * {_level}
	set {_cardStoneCost} to 200 * {_level}

	set {_peridotItem} to yaml value "Peridot.Item" in "ItemList"
	set {_element} to getCardElement({_card})
	set {_essenceItem} to yaml value "%{_element}% Essence.Item" in "ItemList"
	if {_p} has {_prismCost} of {magicznypryzmat}:
		if {_p} has {_essenceCost} of {_essenceItem}:
			if {_p} has {_peridotCost} of {_peridotItem}:
				if {cosmicflux::%{_p}%} >= {_fluxCost}:
					loop all items in the inventory of {_p}:
						if boolean tag "Cardstone" of (custom nbt of loop-item) = true:
							if string tag "Card" of (custom nbt of loop-item) = {_card}:
								set {_cardstone} to loop-item
								if {_p} has {_cardstoneCost} of {_cardstone}:
									return true
	return false

function AbilityUpgradeTakeCost(p: player, card: text, level: integer):
	set {_prismCost} to AbilityUpgradePrismCost({_level})
	set {_essenceCost} to 40 + (({_level} - 1) * 10)
	set {_fluxCost} to 500 * {_level}
	set {_peridotCost} to 30 * {_level}
	set {_peridotItem} to yaml value "Peridot.Item" in "ItemList"
	set {_element} to getCardElement({_card})
	set {_essenceItem} to yaml value "%{_element}% Essence.Item" in "ItemList"
	remove {_prismCost} of {magicznypryzmat} from {_p}'s inventory
	remove {_essenceCost} of {_essenceItem} from {_p}'s inventory
	remove {_peridotCost} of {_peridotItem} from {_p}'s inventory
	set {cosmicflux::%{_p}%} to {cosmicflux::%{_p}%} - {_fluxCost}

function AbilityUpgradeApply(p: player, card: text, ability: text, level: integer):
	loop yaml node keys "Card.%{_card}%.%{_ability}%.Upgrades.Levels.%{_level}%" in "SpellList":
		set {_value} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Levels.%{_level}%.%loop-value%" in "SpellList"
		set yaml value "Card.Ability Modifiers.%{_ability}%.%loop-value%" in "activeCard-%{_p}%" to {_value}
	set yaml value "Card.Ability Levels.%{_ability}%" in "activeCard-%{_p}%" to {_level}
	save yaml "activeCard-%{_p}%"

function AbilityUpgradeMenu(p: player):
	if metadata tag "ClickedAbility" of {_p} is set:
		set {_card} to uncolored name of {_p}'s tool
		set {_ability} to uncolored name of (metadata tag "ClickedAbility" of {_p})
		replace all "Mastery: " in {_ability} with ""
		set metadata tag "AbilityUpgradeAbility" of {_p} to {_ability}
		set metadata tag "AbilityUpgradeCard" of {_p} to {_card}
		set metadata tag "AbilityUpgradeClickedAbility" of {_p} to metadata tag "ClickedAbility" of {_p}
	else:
		set {_ability} to metadata tag "AbilityUpgradeAbility" of {_p}
		set {_card} to metadata tag "AbilityUpgradeCard" of {_p}
	if AbilityUpgradeable({_card}, {_ability}) is not true:
		stop
	set metadata tag "abilityupgrademenu" of {_p} to chest inventory with 3 rows named "%{_card}% - Upgrade %{_ability}%"
	set {_gui} to metadata tag "abilityupgrademenu" of {_p}
	set {_level} to AbilityUpgradeLevel({_p}, {_ability})
	set {_maxLevel} to AbilityUpgradeMaxLevel({_card}, {_ability})
	if {_level} >= {_maxLevel}:
		set slot 10 of {_gui} to AbilityUpgradeItem({_p}, {_card}, {_ability}, {_level}, "&f", true)
		set slot 16 of {_gui} to blue stained glass pane named "<#8bbdf0>Fully Awakened" with lore "&7This ability has reached its current%nl%&7celestial apex. Its power sleeps no%nl%&7longer, though the stars may answer%nl%&7in a future calling."
	else:
		set {_nextLevel} to {_level} + 1
		set metadata tag "AbilityUpgradeNextLevel" of {_p} to {_nextLevel}
		set slot 10 of {_gui} to AbilityUpgradeItem({_p}, {_card}, {_ability}, {_level}, "&f")
		set slot 13 of {_gui} to AbilityUpgradeItem({_p}, {_card}, {_ability}, {_nextLevel}, "&a", false, {_level})
		set {_confirmLore} to "&7Upgrade &f%{_ability}% &7to &fLevel %{_nextLevel}%&7.%nl% %nl%%AbilityUpgradeCostLore({_p}, {_card}, {_nextLevel})%"
		if AbilityUpgradeCanAfford({_p}, {_card}, {_nextLevel}) is true:
			set slot 16 of {_gui} to lime stained glass pane named "&aAwaken Power" with lore "%{_confirmLore}%%nl% %nl%&fClick here to upgrade ability."
		else:
			set slot 16 of {_gui} to red stained glass pane named "&cAwaken Power" with lore "%{_confirmLore}%%nl% %nl%&cInsufficient materials."
	open {_gui} to {_p}

function CombatProfileMenu(p: player):
	set metadata tag "combatprofilegui" of {_p} to (chest inventory with 3 rows named "%uncolored (name of {_p}'s tool)% - Combat Profile")
	set {_gui} to metadata tag "combatprofilegui" of {_p}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
	set {_card} to uncolored (name of {_p}'s tool)
	set {_gearScore} to CalculateCardGearScore({_p})
	set {_gearScoreItem} to netherite chestplate named "&8Gear Score" with item flag hide attributes
	set {_gearTop::*} to CombatProfileTopList({_card}, "Card.Gear Score")
	set lore of {_gearScoreItem} to "&f✨ What is Gear Score?", "&7Gear Score measures the overall strength", "&7of your equipped gear. It is primarily", "&7based on weighted item level and rarity,", "&7then increased by sockets, gems, enchants,", "&7built-in set bonuses and Starforged bonuses.", " ", "&7Your Gear Score: &f%{_gearScore}%", " " and {_gearTop::*}
	set slot 0 of {_gui} to {_gearScoreItem}
	set slot 1 of {_gui} to CombatProfileStatItem(iron sword, "&6Damage Dealt", "&7Shows the top damage dealt for %{_card}%.", {_card}, "Combat Data.Total Damage Dealt") with item flag hide attributes
	set slot 2 of {_gui} to CombatProfileStatItem(shield, "&bDamage Shielded", "&7Shows the top damage shielded for %{_card}%.", {_card}, "Combat Data.Total Damage Shielded", true) with item flag hide attributes
	set slot 3 of {_gui} to CombatProfileStatItem(potion, "&aHealing Done", "&7Shows the top healing done for %{_card}%.", {_card}, "Combat Data.Total Healing Done")
	set slot 4 of {_gui} to CombatProfileStatItem(diamond sword, "&cKilling Blows", "&7Shows the top killing blows for %{_card}%.", {_card}, "Combat Data.Total Killing Blows") with item flag hide attributes
	set slot 5 of {_gui} to CombatProfileStatItem(golden sword, "&eOverall Kills", "&7Shows the top overall kills for %{_card}%.", {_card}, "Combat Data.Total Overall Kills") with item flag hide attributes
	set slot 6 of {_gui} to CombatProfileStatItem(totem of undying, "&dAssists", "&7Shows the top assists for %{_card}%.", {_card}, "Combat Data.Total Assists")
	set slot 7 of {_gui} to CombatProfileStatItem(flint, "&6Critical Hits", "&7Shows the top critical hits for %{_card}%.", {_card}, "Combat Data.Total Critical Hits")
	set slot 8 of {_gui} to CombatProfileStatItem(clock, "&fCombat Time", "&7Shows the top combat time for %{_card}%.", {_card}, "Combat Data.Total Combat Time")
	set slot 9 of {_gui} to CombatProfileStatItem(wither skeleton skull, "&8Deaths", "&7Shows the top deaths for %{_card}%.", {_card}, "Combat Data.Total Deaths")
	set {_averageItemLevel} to CalculateCardAverageItemLevel({_p})
	set {_averageItemLevelTop::*} to CombatProfileTopList({_card}, "Card.Average Item Level")
	set {_averageItemLevelItem} to spyglass named "&bTop Item Levels" with item flag hide attributes
	set lore of {_averageItemLevelItem} to "&7Shows the top average item levels", "&7for %{_card}%.", " ", "&7Your Average Item Level: &f%CombatProfileFormatDecimal({_averageItemLevel})%", " " and {_averageItemLevelTop::*}
	set slot 10 of {_gui} to {_averageItemLevelItem}
	open {_gui} to {_p}

function CombatProfileStatItem(itemType: item type, title: text, description: text, card: text, yamlNode: text, hideAttributes: boolean = false) :: item:
	set {_item} to {_itemType} named {_title}
	set {_top::*} to CombatProfileTopList({_card}, {_yamlNode})
	set lore of {_item} to {_description}, " " and {_top::*}
	if {_hideAttributes} is true:
		set {_item} to {_item} with item flag hide attributes
	return {_item}

function CombatProfileFormatDecimal(value: number) :: text:
	set {_whole} to floor({_value})
	set {_decimal} to round(({_value} - {_whole}) * 100, 0)
	if {_decimal} = 100:
		set {_whole} to {_whole} + 1
		set {_decimal} to 0
	if {_decimal} < 10:
		set {_decimalText} to "0%{_decimal}%"
	else:
		set {_decimalText} to "%{_decimal}%"
	return "%{_whole}%.%{_decimalText}%"

function CombatProfileDisplayValue(yamlNode: text, value: number) :: text:
	if {_yamlNode} = "Combat Data.Total Combat Time":
		set {_timespan} to "%{_value}% seconds" parsed as timespan
		return "%{_timespan}%"
	if {_yamlNode} = "Card.Average Item Level":
		return CombatProfileFormatDecimal({_value})

	return "%{_value}%"

function CombatProfileTopList(card: text, yamlNode: text, p: player = null) :: texts:
	set {_dir} to new File("plugins/Skript/playerdata/karty/%{_card}%")
	if {_dir}.isDirectory() is false:
		loop 5 times:
			set {_top::*} to {_top::*} and "&7%loop-number%. &8..."
		if {_p} is set:
			set {_top::*} to {_top::*} and "%last string color code of name of {_p}'s tool%&7-"
		set {_top::*} to {_top::*} and "&8&o0 more..."
		return {_top::*}

	if {_p} is set:
		set {_playerLineColour} to last string color code of name of {_p}'s tool
	else:
		set {_playerLineColour} to "&f"

	set {_files::*} to ...{_dir}.listFiles()
	loop {_files::*}:
		set {_file} to loop-value
		if {_file}.isFile() is true:
			set {_fileName} to {_file}.getName()
			set {_nameLength} to length of {_fileName}
			if {_nameLength} > 4:
				set {_extension} to subtext of {_fileName} from ({_nameLength} - 3) to {_nameLength}
				if {_extension} = ".yml":
					set {_yamlId} to "combatprofile-%random 8 char string from charset `0-9` `a-z`%"
					load yaml "plugins/Skript/playerdata/karty/%{_card}%/%{_fileName}%" as {_yamlId}

					set {_value} to yaml value "%{_yamlNode}%" in {_yamlId}
					if {_value} is not set:
						set {_value} to 0

					if {_value} > 0:
						set {_owner} to yaml value "Card.Owner" in {_yamlId}
						if {_owner} is not set:
							set {_owner} to "Unknown"

						set {_cardId} to yaml value "Card.Id" in {_yamlId}
						if {_cardId} is not set:
							set {_cardId} to subtext of {_fileName} from 1 to ({_nameLength} - 4)

						set {_labels::*} to {_labels::*} and "%{_owner}% (%{_cardId}%)"
						set {_values::*} to {_values::*} and {_value}
						set {_owners::*} to {_owners::*} and {_owner}
						set {_positiveCount} to {_positiveCount} + 1

					unload yaml {_yamlId}

	if {_values::*} is set:
		loop size of {_values::*} times:
			clear {_max}
			clear {_index}

			loop {_values::*}:
				if {_used::*} does not contain loop-index:
					if {_max} is not set:
						set {_max} to loop-value-2
						set {_index} to loop-index
					else if loop-value-2 > {_max}:
						set {_max} to loop-value-2
						set {_index} to loop-index

			if {_index} is set:
				set {_used::*} to {_used::*} and {_index}
				set {_rankedLabel::%loop-number%} to {_labels::%{_index}%}
				set {_rankedValue::%loop-number%} to {_max}

				if {_p} is set:
					if {_owners::%{_index}%} = "%{_p}%":
						set {_playerRank} to loop-number
						set {_playerRankValue} to {_max}
						set {_playerRankLabel} to {_labels::%{_index}%}

		loop 5 times:
			if {_rankedLabel::%loop-number%} is set:
				set {_displayValue} to CombatProfileDisplayValue({_yamlNode}, {_rankedValue::%loop-number%})

				if all:
					{_p} is set
					{_playerRank} is set
					{_playerRank} = loop-number
				then:
					set {_top::*} to {_top::*} and "%{_playerLineColour}%%loop-number%. %{_rankedLabel::%loop-number%}%: &f%{_displayValue}%"
				else:
					set {_top::*} to {_top::*} and "&7%loop-number%. %{_rankedLabel::%loop-number%}%: &f%{_displayValue}%"
			else:
				set {_top::*} to {_top::*} and "&7%loop-number%. &8..."

		if {_p} is set:
			if {_playerRank} is not set:
				loop size of {_values::*} times:
					clear {_max}
					clear {_index}

					loop {_values::*}:
						if {_usedPlayer::*} does not contain loop-index:
							if {_max} is not set:
								set {_max} to loop-value-2
								set {_index} to loop-index
							else if loop-value-2 > {_max}:
								set {_max} to loop-value-2
								set {_index} to loop-index

					if {_index} is set:
						set {_usedPlayer::*} to {_usedPlayer::*} and {_index}
						if {_owners::%{_index}%} = "%{_p}%":
							set {_playerRank} to loop-number
							set {_playerRankValue} to {_max}
							set {_playerRankLabel} to {_labels::%{_index}%}
							stop loop

			if {_playerRank} is set:
				if {_playerRank} > 5:
					set {_playerDisplayValue} to CombatProfileDisplayValue({_yamlNode}, {_playerRankValue})
					set {_top::*} to {_top::*} and "%{_playerLineColour}%%{_playerRank}%. %{_playerRankLabel}%: &f%{_playerDisplayValue}%"

		set {_shown} to {_positiveCount}
		if {_shown} > 5:
			set {_shown} to 5

		set {_remaining} to {_positiveCount} - {_shown}
		if {_playerRank} is set:
			if {_playerRank} > 5:
				set {_remaining} to {_remaining} - 1

		if {_remaining} < 0:
			set {_remaining} to 0

		set {_top::*} to {_top::*} and "&8&o+%{_remaining}% more..."
		return {_top::*}

	loop 5 times:
		set {_top::*} to {_top::*} and "&7%loop-number%. &8..."
	set {_top::*} to {_top::*} and "&8&o+0 more..."
	return {_top::*}


on inventory close:
	if player's current inventory is (metadata tag "combatprofilegui" of player):
		clear metadata tag "combatprofilegui" of player
	if player's current inventory is (metadata tag "kartagui" of player):
		clear (metadata tag "kartagui" of player)	
	if player's current inventory is (metadata tag "abilitymenu" of player):
		clear metadata tag "abilitymenu" of player
		clear metadata tag "ClickedAbility" of player
	if player's current inventory is (metadata tag "abilityupgrademenu" of player):
		clear metadata tag "abilityupgrademenu" of player
	if player's current inventory is (metadata tag "abilitymodifiersmenu" of player):
		clear metadata tag "abilitymodifiersmenu" of player
		
function topDesc(n: number, v: text) :: string:
	loop 5 times:
		set {_%{_n}%::%loop-number%} to (loop-number)th element of (createTop("%{_v}%", 5, "&e##[I] &7> &f[P] &7(&a[V]&7)"))
		set {_list::*} to {_%{_n}%::%loop-number%} split at " "
		set {_list::3} to "&8Id:"
		set {_idowner} to join {_list::3} and {_list::4} by " "
		set {_idowner} to {_idowner} in lowercase
		replace all "id:" in {_idowner} with "Id:"
		set {_owner} to "&f%{kartaowner::%{_idowner}%}%"
		if {_owner} contains "<none>":
			set {_owner} to "&f&oUnknown"
		set {_list::3} to {_owner}
		clear {_list::4}
		set {_%{_n}%::%loop-number%} to join {_list::*} by " "
	set {_r} to join {_%{_n}%::*} by nl
	return "%{_r}%"
	
#Wyniesienie
#linear 1-5 500/1000/1500/2000/2500
#od 5 (poprzedni level)*1.25 lub 1.3

#gem::%{_id}%::%player%::*
