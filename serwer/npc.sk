on join:
	if {completionreward::%player%::*} is set:
		wait 6 seconds
		play sound "block.note_block.pling" with volume 3 and pitch 1.6 to player
		if {language::%player%} = "English":
			send "&e> You have %size of {completionreward::%player%::*}% unclaimed completion rewards."
		else:
			send "&e> Masz %size of {completionreward::%player%::*}% nieodebranych nagród za skompletowanie kolekcji."
	else:
		if {secretwonderscomplete::%player%} is not true:
			loop 14 times:
				if {carddrop::sw::%player%::%loop-number%} is set:
					add 1 to {_complete}
			if {_complete} = 14:
				add "Secret Wonders" to {completionreward::%player%::*}
				set {secretwonderscomplete::%player%} to true
		else if {majesticdawncomplete::%player%} is not true:
			loop 14 times:
				if {carddrop::md::%player%::%loop-number%} is set:
					add 1 to {_complete}
			if {_complete} = 14:
				add "Majestic Dawn" to {completionreward::%player%::*}
				set {majesticdawncomplete::%player%} to true
		else if {unseenforcescomplete::%player%} is not true:
			loop 14 times:
				if {carddrop::uf::%player%::%loop-number%} is set:
					add 1 to {_complete}
			if {_complete} = 14:
				add "Unseen Forces" to {completionreward::%player%::*}
				set {unseenforcescomplete::%player%} to true
		else if {plasmafreezecomplete::%player%} is not true:
			loop 14 times:
				if {carddrop::pf::%player%::%loop-number%} is set:
					add 1 to {_complete}
			if {_complete} = 14:
				add "Plasma Freeze" to {completionreward::%player%::*}
				set {plasmafreezecomplete::%player%} to true

on rightclick on a player:
	if clicked player is not online:
			#if "%regions at player%" contains "spawn":
				#if {winterDelightPassLEVEL::%player%} >= 0:
					#getMission(player, "Happy Winter Delight!", "Wesołego Zimowego Zachwytu!", 1)
					
		if clicked player's name = "Maggie":
			set {_x} to a random integer between 1 and 4
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
			if {_x} = 1:
				send "&8[<##b08dff>NPC&8] [<##b08dff>Maggie&8] &fIm just reading..." to player
			if {_x} = 2:
				send "&8[<##b08dff>NPC&8] [<##b08dff>Maggie&8] &fShhh... We are in a library." to player
			if {_x} = 3:
				send "&8[<##b08dff>NPC&8] [<##b08dff>Maggie&8] &fThanks to books, I know that my <##de85d1>Candy &fis actually an artifact!" to player
			if {_x} = 4:
				send "&8[<##b08dff>NPC&8] [<##b08dff>Maggie&8] &fDid you know that <##025b95>Sapphire &fwas once the least valuable Gemstone?" to player
			#if x = 5
			#krążą plotki że cress....
		else if clicked player's name = "Krysta":
			play sound "entity.villager.no" with volume 4 and pitch 1 to player
			set {_x} to a random integer between 1 and 4
			if {_x} = 1:
				send "&8[<##9a5398>NPC&8] [<##9a5398>Krysta&8] &fCome back to me when you've made 543 friends." to player
			else if {_x} = 2:
				send "&8[<##9a5398>NPC&8] [<##9a5398>Krysta&8] &fI have 1721 followers on Earthagram." to player
			else if {_x} = 3:
				send "&8[<##9a5398>NPC&8] [<##9a5398>Krysta&8] &fHave you heard that Akasaka has a crush on Czarek? How scandalous." to player
			else if {_x} = 4:
				send "&8[<##9a5398>NPC&8] [<##9a5398>Krysta&8] &fThey say I have ears and a trunk like an elephant, but I think they are just jealous of my beauty." to player
		else if clicked player's name = "Mała Damba":
			play sound "entity.wolf.whine" with volume 4 and pitch 1 to player
			set {_x} to a random integer between 1 and 4
			if {_x} = 1:
				send "&8[<##6ce957>NPC&8] [<##6ce957>Mała Damba&8] &fOne day I will be just like Mal'Damba..." to player
			else if {_x} = 2:
				send "&8[<##6ce957>NPC&8] [<##6ce957>Mała Damba&8] &fI know I'm not Mal'Damba... But please treat me the same as you would him......" to player
			else if {_x} = 3:
				send "&8[<##6ce957>NPC&8] [<##6ce957>Mała Damba&8] &fDo you also like Mal'Damba...?" to player
			else if {_x} = 4:
				send "&8[<##6ce957>NPC&8] [<##6ce957>Mała Damba&8] &fMal'Damba will give me strength..." to player
		else if clicked player's name = "Soldier":
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
			play sound "entity.experience_orb.pickup" with volume 4 and pitch 1 at player
			send "&8[<##94683a>NPC&8] [<##94683a>Soldier&8] &fGreetings! These are the current chest drops:" to player
			send "&8[ &7&lChests:" to player
			send "&8[ &71x Sapphire: <##94683a>56%%" to player
			send "&8[ &71x Klejnot: <##94683a>28%%" to player
			send "&8[ &71x Ruby: <##94683a>14%%" to player
			send "&8[ &71x Amethyst: <##94683a>7%%" to player
			send "&8[ &71x Topaz: <##94683a>3.5%%" to player
			send "&8[ &71x Aquamarine: <##94683a>1.75%%" to player
			send "&8[ &71x Peridot: <##94683a>0.875%%" to player
			send "&8[ &71x Random Booster: <##94683a>0.6%%" to player
			send "&8[ &73x Random Booster: <##94683a>0.2%%" to player
			send "&8[ &71x Star Shard: <##94683a>0.11%%" to player
			send "&8[ &71x Chaotic Potion: <##94683a>0.4%%" to player
			send "&8[ &71x Prismatic Lens: <##94683a>0.18%%" to player
			send "&8[ &71x Jar of Experience: <##94683a>7%%" to player
			send "&8[ &71x Chest: <##94683a>4.5%%" to player
			send "&8[ &71x Luxury Chest: <##94683a>1%%" to player
			send "&8[ &71x Random Essence: <##94683a>3.5%%" to player
			send "&8[ &71x Diamond Shard: <##94683a>0.33%%" to player
			send " " to player
			send "&8[ &7&lLuxurious Chests:" to player
			send "&8[ &71x Sapphire: <##94683a>85%%" to player
			send "&8[ &71x Klejnot: <##94683a>42.5%%" to player
			send "&8[ &71x Ruby: <##94683a>21.25%%" to player
			send "&8[ &71x Amethyst: <##94683a>10.625%%" to player
			send "&8[ &71x Topaz: <##94683a>5.3125%%" to player
			send "&8[ &71x Aquamarine: <##94683a>2.65625%%" to player
			send "&8[ &71x Peridot: <##94683a>1.328125%%" to player
			send "&8[ &71x Random Booster: <##94683a>2.2%%" to player
			send "&8[ &73x Random Booster: <##94683a>0.7%%" to player
			send "&8[ &71x Star Shard: <##94683a>0.33%%" to player
			send "&8[ &71x Chaotic Potion: <##94683a>1.1%%" to player
			send "&8[ &71x Prismatic Lens: <##94683a>0.39%%" to player
			send "&8[ &71x Jar of Experience: <##94683a>12%%" to player
			send "&8[ &71x Chest: <##94683a>9%%" to player
			send "&8[ &71x Luxury Chest: <##94683a>2.5%%" to player
			send "&8[ &71x Random Essence: <##94683a>8%%" to player
			send "&8[ &73x Random Essence: <##94683a>2.8%%" to player
			send "&8[ &71x Enchanted Prismatic Lens: <##94683a>0.13%%" to player
			send "&8[ &71x Klejnot Rain: <##94683a>0.48%%" to player
			send "&8[ &71x Token of Gratitude: <##94683a>0.6%%" to player
			send "&8[ &71x Diamond Shard: <##94683a>0.99%%" to player

		else if clicked player's name = "August":
			openBoosterCompletionMenu(player)
			
		else if clicked player's name = "Odyn":
			play sound "entity.villager.ambient" with volume 4 and pitch 0.6 to player
			set {_x} to a random integer between 1 and 2
			if {_x} = 1:
				send "&8[<##9e8672>NPC&8] [<##9e8672>Odyn&8] &f..." to player
			else if {_x} = 2:
				send "&8[<##9e8672>NPC&8] [<##9e8672>Odyn&8] &fHmm?" to player
		else if clicked player's name = "Archie":
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
			set {_x} to a random integer between 1 and 2
			if {_x} = 1:
				send "&8[&9NPC&8] &9Archie says: &fGot any orders from the boss?!" to player
			else if {_x} = 2:
				send "&8[&9NPC&8] &9Archie says: &fAye?" to player
		else if clicked player's name = "Castella":
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
			set {_x} to a random integer between 1 and 4
			if {_x} = 1:
				send "&8[<##ffde73>NPC&8] [<##ffde73>Castella&8] &fWhat's your favourite card? Mine is <##fae664>Emolga&f!" to player
			if {_x} = 2:
				send "&8[<##ffde73>NPC&8] [<##ffde73>Castella&8] &fI have 2632 cards in my collection and I won't hesitate to use them!" to player
			if {_x} = 3:
				send "&8[<##ffde73>NPC&8] [<##ffde73>Castella&8] &fWould you like to trade cards?" to player
			else if {_x} = 4:
				send "&8[<##ffde73>NPC&8] [<##ffde73>Castella&8] &fDid you know that <##ffde73>%{totalCardsDropped}% &fcards have been dropped on Earthcraft?! WOW!!!" to player
		else if clicked player's name = "":
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
			send "&8[<##755a49>NPC&8] [<##755a49>'Bearded' Zachary&8] &fHello! Can I help you with something?" to player
			set metadata tag "brodatyzachary" of player to chest inventory with 1 row named "What would you like to do?"
			set slot 3 of (metadata tag "brodatyzachary" of player) to iron pickaxe named "&fChoose Pickaxe Skill" with lore "&7Click here to choose%nl%&7a pickaxe skill." with nbt from "{HideFlags:127}"
			set slot 5 of (metadata tag "brodatyzachary" of player) to iron block named "&fCheck Mining Skill" with lore "&7Click to check your proficiency%nl%&7in Mining."
			play sound "block.note_block.pling" with volume 4 and pitch 2 to player
			open metadata tag "brodatyzachary" of player to player
		else if clicked player's name = "Dust Star":
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
		else if clicked player's name = "Ciscra":
			if line 19 of lore of player's tool contains "&8Id: ":
				cancel event
				set metadata tag "Constellation" of player to chest inventory with 3 rows named "Constellation"
				set {_constellation} to Constellation(player, false)
				if {_constellation} is not set:
					set {_constellation} to 0
				set {_constellationName} to name of slot 16 of metadata tag "kartagui" of player
				set {_lore} to (join lore of slot 16 of metadata tag "kartagui" of player by nl)
				set slot 4 of metadata tag "Constellation" of player to nether star named {_constellationName} with lore {_lore}
				loop slots integers between 10 and 15 of metadata tag "kartagui" of player:
					if {_constellation} >= (index of loop-slot) - 9:
						add "%last string color code of name of player's tool%%uncolored name of loop-value%" to {_constList::*}
					else:
						add "&8%uncolored name of loop-value%" to {_constList::*}
				set {_constList} to join {_constList::*} by "%nl%&7- "
				set slot 11 of metadata tag "Constellation" of player to white stained glass pane named "&fCurrent Constellation" with lore "&7- %{_constList}%"
				if {_constellation} < 6:
					set slot 15 of metadata tag "Constellation" of player to white stained glass pane named "&fUnlock Constellation" with lore "&7Click here to exchange a copy of held%nl%&7card and increase the constellation."
				else:
					set slot 15 of metadata tag "Constellation" of player to white stained glass pane named "&fUnlock Stellar Power" with lore "&7This card's full potential has been unlocked.%nl%&7Click here to advance the Stellar Power level."
				open metadata tag "Constellation" of player to player
				loop 4 times:
					set {_pitch} to 0.5 + (loop-number*0.2)
					play sound "entity.experience_orb.pickup" with volume 3 and pitch {_pitch} to player
					wait 3 ticks
					if loop-number = 2:
						wait 3 ticks
				play sound "block.end_portal_frame.fill" with volume 1 and pitch 1 to player
			else:
				play sound "block.glass.break" with volume 3 and pitch 0.2 to player
				send "&c&oYou must hold a card in your hand to interact with this NPC." to player
		else if clicked player's name = "Malicia":
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
			set metadata tag "Teams" of player to chest inventory with 5 rows named "Teams"	
			if {teamPoison::*} is not set:
				set {_membersPoison} to " &fnone"
			else:
				set {_membersPoison} to join {teamPoison::*} by "%nl% &f- "

			if {teamAqua::*} is not set:
				set {_membersAqua} to " &fnone"
			else:
				set {_membersAqua} to join {teamPoison::*} by "%nl% &f- "
			set slot 13 of metadata tag "Teams" of player to black stained glass pane named "&fTeam Count" with lore "&7Team Poison member count: &f%size of {teamPoison::*}%%nl%&7Team Aqua member count: &f&f%size of {teamAqua::*}%%nl%&7Sideless: &f%size of {teamSideless::*}%"
			set slot 20 of metadata tag "Teams" of player to purple wool named "&5Team Poison" with lore "&fTeam Poison needs you!%nl% %nl%&7Description:%nl%&7&oMischievous and sly, Team Poison has a fondness for%nl%&7&omaking all sorts of plans and schemes and misleading%nl%&7&othe opposing team into traps. Their expansive bases%nl%&7&ohave endless corridors and secrets, and the team%nl%&7&ois famously known for their laboratory, where its%nl%&7&omembers find various discoveries and conduct%nl%&7&oresearch on new species found on Earthcraft.%nl% %nl%&7Members:%nl%%{_membersPoison}%"
			
			set slot 24 of metadata tag "Teams" of player to light blue wool named "&bTeam Aqua" with lore "&fTeam Aqua needs you!%nl% %nl%&7&oDescription:%nl%&7&oAdaptible and investigative, Team Aqua has a history%nl%&7&oof finding bases effectively, acquiring and collecting%nl%&7&oevidence and secret items, as well as quickly unfolding%nl%&7&othe opposing team's plans. They are especially known for%nl%&7&onever letting their guard down and being exceptionally%nl%&7&ogood at protecting what must be hidden from the public eye.%nl% %nl%&7Members:%nl%%{_membersAqua}%"
			
			set slot 31 of metadata tag "Teams" of player to white wool named "&fImpartial" with lore "&7Don't feel like joining any team?%nl%&7You can choose to remain impartial%nl%&7by clicking on this panel.%nl% %nl%&fClick here if you want to remain impartial."
			if {team::%player%} is not set:
				add "%nl%&fClick here to join Team Poison." to lore of slot 20 of metadata tag "Teams" of player	
				add "%nl%&fClick here to join Team Aqua." to lore of slot 24 of metadata tag "Teams" of player	
			open metadata tag "Teams" of player to player
		else if clicked player's name = "Guadalupe":
			play sound "entity.villager.yes" with volume 4 and pitch 1 to player
			send "&8[<##edf261>NPC&8] [<##edf261>Guadalupe&8] &fGood day to you!" to player
			set metadata tag "guadalupe" of player to chest inventory with 5 rows named "Reset Talents"
			if {karta::%player%} is set:
				if int tag "Level" of (custom nbt of {karta::%player%}) >= 15:
					if nbt tags of (compound tag "Talents" of (custom nbt of {karta::%player%})) is set:
						set slot 20 of (metadata tag "guadalupe" of player) to {karta::%player%} with lore (lore of {karta::%player%}) and "%nl%&f&oThis is your current Card."
						if {cosmicflux::%player%} >= 500:
							set slot 22 of (metadata tag "guadalupe" of player) to lime stained glass pane named "&aReset Talents" with lore "&7Click &o&nhere &7to reset this%nl%&7Card's Talents."
						else:
							set slot 22 of (metadata tag "guadalupe" of player) to red stained glass pane named "&cNot enough currency" with lore "&7You do not have enough Cosmic Flux%nl%&7to reset this Card's Talents."
						set slot 24 of (metadata tag "guadalupe" of player) to iron nugget named "&fCost" with lore "%nl%&f⇏ &7Resetting Talents will cost you &f&n500&r &f&7.%nl%&f⇏ &7All Talents will be reset.%nl% %nl%&8(&f &8= Cosmic Flux)%nl%&8This currency will be subtracted from%nl%&8your Player account upon expenditure." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						play sound "block.note_block.pling" with volume 4 and pitch 2 to player
						open metadata tag "guadalupe" of player to player
					else:
						send "&c&oYour Card must be at least Level 15 and have one Talent selected to perform this action." to player
						play sound "entity.villager.no" with volume 3 and pitch 0.8 to player
						teleport player to player's location
				else:
					send "&c&oYour Card must be at least Level 15 and have one Talent selected to perform this action." to player
					play sound "entity.villager.no" with volume 3 and pitch 0.8 to player
					teleport player to player's location
			else:
				send "&c&oYou do not have an active Card selected." to player
				play sound "entity.villager.no" with volume 3 and pitch 0.8 to player
				teleport player to player's location

on inventory click:
	if event-inventory = metadata tag "Teams" of player:
		cancel event
	else if event-inventory = metadata tag "guadalupe" of player:
		cancel event
		if index of event-slot = 22:
			if event-slot is a lime stained glass pane:
				teleport player to player's location
				remove 500 from {cosmicflux::%player%}
				clear compound tag "Talents" of custom nbt of player's tool
				play sound "entity.player.levelup" with volume 3 and pitch 1 to player
				set {_l} to int tag "Level" of custom nbt of player's tool
				send "&e&oSuccessfully reset all Talents for %uncolored name of {karta::%player%}% (Level %{_l}%)" to player
	else if event-inventory = metadata tag "brodatyzachary" of player:
		cancel event
		if index of event-slot = 3:
			play sound "entity.bat.takeoff" with volume 5 and pitch 0.92 to player
			if {language::%player%} = "English":
				set metadata tag "brodatyzacharyChoosePickaxe" of player to chest inventory with 1 row named "Pickaxe Skills"
				set {_0} to stone named "&8Standard Mining" with lore "&7Pick this if you want to experience%nl%&7classic mining."
				set {_1} to cobblestone named "&8Helping Hand" with lore "&8Pickaxe Upgrade" and "&7Cooldown: &f10 seconds" and "&7Immediately &fbreaks &7the target block." and "&7Blocks broken in this way behave" and "&7as if mined normally."
				set {_2} to tnt named "&cExplosion" with lore "&8Pickaxe Upgrade" and "&7Cooldown: &f2 minutes" and "&7Detonate all blocks in radius &f3 &7around" and "&7the target block. Blocks broken in this" and "&7way behave as if mined normally."
				set {_3} to beacon named "&bIgnition" with lore "&8Pickaxe Upgrade" and "&7Cooldown: &fNone" and "&7Mining stone or deepslate has a &f8%%" and "&7chance to drop an &fIgnition Orb&7." and "&7Collecting &f20 Orbs &7will grant &f40%%" and "&f Mining Haste &7for &f4 sec&7."
				set {_4} to blast furnace named "&6Heating Systems" with lore "&8Pickaxe Upgrade" and "&7Cooldown: &fNone" and "&7Mining &fore&7, &fstone &7or &fdeepslate%nl%&7automatically smelts the received ore."
				set {_5} to iron block named "&7Magnet" with lore "&8Pickaxe Upgrade" and "&7Cooldown: &fNone" and "&7Mining &fIron &7will automatically mine%nl%&7all adjacent &fIron Ore&7. &7Every &f3 Iron Ore &7mined%nl%&7in this way will grant the player an%nl%&7additional &fIron Ingot&7." and "&7sztabkę żelaza."
				if {umkilof::%player%} = "Brak":
					add "&aSELECTED" to lore of {_0}
				else:
					add "&fClick to select." to lore of {_0}
				set slot 0 and 8 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_0}
				if {poziomgornictwo::%player%} > 0:
					if {umkilof::%player%} = "PomocnaDłoń":
						add "&aSELECTED" to lore of {_1}
					else:
						add "&fClick to select." to lore of {_1}
				else:
					add "&cNOT UNLOCKED" to lore of {_1}
				set slot 2 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_1}
				if {poziomgornictwo::%player%} > 9:
					if {umkilof::%player%} = "Eksplozja":
						add "&aSELECTED" to lore of {_2}
					else:
						add "&fClick to select." to lore of {_2}
				else:
					add "&cNOT UNLOCKED" to lore of {_2}
				set slot 3 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_2}
				if {poziomgornictwo::%player%} > 19:
					if {umkilof::%player%} = "Zapłon":
						add "&aSELECTED" to lore of {_3}
					else:
						add "&fClick to select." to lore of {_3}
				else:
					add "&cNOT UNLOCKED" to lore of {_3}
				set slot 4 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_3}
				if {poziomgornictwo::%player%} > 29:
					if {umkilof::%player%} = "Instalacje Ogrzewcze":
						add "&aSELECTED" to lore of {_4}
					else:
						add "&fClick to select." to lore of {_4}
				else:
					add "&cNOT UNLOCKED" to lore of {_4}
				set slot 5 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_4}
				if {poziomgornictwo::%player%} > 39:
					if {umkilof::%player%} = "Magnes":
						add "&aSELECTED" to lore of {_5}
					else:
						add "&fClick to select." to lore of {_5}
				else:
					add "&cNOT UNLOCKED" to lore of {_5}
				set slot 6 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_5}
			else:
				set metadata tag "brodatyzacharyChoosePickaxe" of player to chest inventory with 1 row named "Umiejętności Kilofu"
				set {_0} to stone named "&8Standardowe Kopanie" with lore "&7Wybierz, jeśli chcesz doświadczyć" and "&7klasycznego kopania."
				set {_1} to cobblestone named "&8Pomocna Dłoń" with lore "&8Ulepszenie Kilofu" and "&7Cooldown: &f10 sekund" and "&7Natychmiastowo wykopuje kliknięty blok." and "&7Zniszczone bloki tym ulepszeniem liczą" and "&7i zachowują się jako wykopane."
				set {_2} to tnt named "&cEksplozja" with lore "&8Ulepszenie Kilofu" and "&7Cooldown: &f2 minuty" and "&7Powoduje eksplozję na obszarze 3 kratek." and "&7Zniszczone bloki liczą się jako" and "&7wykopane i zachowują się jak wykopane."
				set {_3} to beacon named "&bZapłon" with lore "&8Ulepszenie Kilofu" and "&7Cooldown: &fBrak" and "&7Wykopanie kamienia ma 8%% szans na" and "&7wypadnięcie kuli zapłonu." and "&7Zebranie 20 kul zapewnia o 40%%" and "&7szybsze kopanie na 4 sekundy."
				set {_4} to blast furnace named "&6Instalacje Ogrzewcze" with lore "&8Ulepszenie Kilofu" and "&7Cooldown: &fBrak" and "&7Wykopanie kamienia ma 20%% szans" and "&7na automatyczne przepalenie go."
				set {_5} to iron block named "&7Magnes" with lore "&8Ulepszenie Kilofu" and "&7Cooldown: &fBrak" and "&7Wykopanie rudy żelaza automatycznie" and "&7wykopie i przyciągnie sąsiadujące rudy." and "&7Za każde 3 rudy przyciągnięte" and "&7w ten sposób otrzymujesz dodatkową" and "&7sztabkę żelaza."
				if {umkilof::%player%} = "Brak":
					add "&aWYBRANO" to lore of {_0}
				else:
					add "&fKliknij, by wybrać." to lore of {_0}
				set slot 0 and 8 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_0}
				if {poziomgornictwo::%player%} > 0:
					if {umkilof::%player%} = "PomocnaDłoń":
						add "&aWYBRANO" to lore of {_1}
					else:
						add "&fKliknij, by wybrać." to lore of {_1}
				else:
					add "&cNIE ODBLOKOWANO" to lore of {_1}
				set slot 2 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_1}
				if {poziomgornictwo::%player%} > 9:
					if {umkilof::%player%} = "Eksplozja":
						add "&aWYBRANO" to lore of {_2}
					else:
						add "&fKliknij, by wybrać." to lore of {_2}
				else:
					add "&cNIE ODBLOKOWANO" to lore of {_2}
				set slot 3 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_2}
				if {poziomgornictwo::%player%} > 19:
					if {umkilof::%player%} = "Zapłon":
						add "&aWYBRANO" to lore of {_3}
					else:
						add "&fKliknij, by wybrać." to lore of {_3}
				else:
					add "&cNIE ODBLOKOWANO" to lore of {_3}
				set slot 4 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_3}
				if {poziomgornictwo::%player%} > 29:
					if {umkilof::%player%} = "Instalacje Ogrzewcze":
						add "&aWYBRANO" to lore of {_4}
					else:
						add "&fKliknij, by wybrać." to lore of {_4}
				else:
					add "&cNIE ODBLOKOWANO" to lore of {_4}
				set slot 5 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_4}
				if {poziomgornictwo::%player%} > 39:
					if {umkilof::%player%} = "Magnes":
						add "&aWYBRANO" to lore of {_5}
					else:
						add "&fKliknij, by wybrać." to lore of {_5}
				else:
					add "&cNIE ODBLOKOWANO" to lore of {_5}
				set slot 6 of (metadata tag "brodatyzacharyChoosePickaxe" of player) to {_5}
			open metadata tag "brodatyzacharyChoosePickaxe" of player to player
	else if event-inventory = metadata tag "brodatyzacharyChoosePickaxe" of player:
		cancel event
		if {language::%player%} = "English":
			set {_success} to "&a&oSuccessfully selected the %uncolored name of event-slot% pickaxe ability!"
			set {_fail} to "&c&oYou do not have this pickaxe ability unlocked."
			set {_already} to "&e&oYou already have this pickaxe ability selected."
		else:
			set {_success} to "&a&oPomyślnie wybrano umiejętność kilofu %uncolored name of event-slot%!"
			set {_fail} to "&c&oNie odblokowano jeszcze tej umiejętności kilofu."
			set {_already} to "&e&oTa umiejętność kilofu jest już aktywna."
		if index of event-slot = 2:
			if {poziomgornictwo::%player%} > 0:
				if {umkilof::%player%} != "PomocnaDłoń":
					set {umkilof::%player%} to "PomocnaDłoń"
					set {_event} to true
				else:
					send {_already} to player
			else:
				set {_event} to false
		else if index of event-slot = 3:
			if {poziomgornictwo::%player%} >= 9:
				if {umkilof::%player%} != "Eksplozja":
					set {umkilof::%player%} to "Eksplozja"
					set {_event} to true
				else:
					send {_already} to player
			else:
				set {_event} to false
		if {_event} = true:
			send {_success} to player
			play sound "entity.bat.takeoff" with volume 4 and pitch 1.35 at player
		else if {_event} = false:
			send {_fail} to player
			play sound "entity.chest.close" with volume 4 and pitch 0.8 at player
	else if event-inventory = metadata tag "Constellation" of player:
		if player's current inventory = metadata tag "Constellation" of player:
			cancel event
			if index of clicked slot = 15:
				teleport the player to player's location
				set metadata tag "ConstellationAdd" of player to chest inventory with 3 rows named "Constellation"
				set {_slotIndex} to 0
				loop all items in the player's inventory:
					if line 19 of lore of loop-item contains "&8Id: ":
						if line 19 of lore of loop-item != line 19 of lore of player's tool:
							if int tag "Version" of (custom nbt of loop-item) >= 830:
								if name of loop-item = name of player's tool:
									set slot {_slotIndex} of metadata tag "ConstellationAdd" of player to loop-item
									add "%nl%&c&l(&4&l!&c&l) &f&oClick here to exchange this item." to lore of slot {_slotIndex} of metadata tag "ConstellationAdd" of player
									add 1 to {_slotIndex}
				if {_slotIndex} > 0:
					open metadata tag "ConstellationAdd" of player to player
				else:
					play sound "entity.villager.no" with volume 5 and pitch 0.62 to player
					play sound "block.glass.break" with volume 5 and pitch 1.176 to player
					send "&c&oThere are no identical cards in your inventory." to player

	else if event-inventory = metadata tag "ConstellationAdd" of player:
		cancel event
		if index of clicked slot is between 0 and 26:
			if clicked slot is not air:
				set metadata tag "ConstellationAddConfirm" of player to chest inventory with 3 rows named "Constellation - Confirm"
				set slot 11 of metadata tag "ConstellationAddConfirm" of player to clicked slot
				set slot 15 of metadata tag "ConstellationAddConfirm" of player to lime stained glass pane named "&aConfirm?" with lore "&7Click here to confirm the process and%nl%&7advance the constellation level.%nl% %nl%&c&l(&4&l!&c&l) &c&nWarning!&c &oThis action will delete the card."
				open metadata tag "ConstellationAddConfirm" of player to player
	else if event-inventory = metadata tag "ConstellationAddConfirm" of player:
		cancel event
		if index of clicked slot is between 0 and 26:
			if clicked slot is not air:
				if clicked slot is lime stained glass pane named "&aConfirm?":

					loop lore of slot 11 of metadata tag "ConstellationAddConfirm" of player:
						if loop-value != "":
							if uncolored loop-value does not contain "(!)":
								add loop-value to {_loreItem::*}

					set {_card} to slot 11 of metadata tag "ConstellationAddConfirm" of player with lore {_loreItem::*}
					loop all items in player's inventory:
						if loop-item = {_card}:
							set {_id} to string tag "Id" of custom nbt of loop-item
							set {_name} to uncolored name of loop-item

							unload yaml "plugins/Skript/playerdata/karty/%{_name}%/%{_id}%.yml"
							delete yaml "plugins/Skript/playerdata/karty/%{_name}%/%{_id}%.yml"

							remove loop-item from player
							teleport the player to player's location
							set {_idCard} to string tag "Id" of custom nbt of player's tool

							set {_constellation} to yaml value "Card.Constellation" in "activeCard-%player%"
							if {_constellation} < 6:
								add 1 to {_constellation}
								set yaml value "Card.Constellation" in "activeCard-%player%" to {_constellation}
								set {_slot} to slot (9 + {_constellation}) of metadata tag "kartagui" of player
								set boolean tag "Constellation;%uncolored name of {_slot}%" of custom nbt of player's tool to true
							else:
								add 1 to int tag "StellarPower" of custom nbt of player's tool

							save yaml "activeCard-%player%"

							load yaml "plugins/Skript/playerdata/%uuid of player%.yml" as "playerDataConstellation-%player%"
							set {_constellations} to yaml value "Player.Total Constellations" in "playerDataConstellation-%player%"
							set {_stellarPowerCount} to yaml value "Player.Total Stellar Power" in "playerDataConstellation-%player%"

							if {_constellations} is not set:
								set {_constellations} to 0
							if {_stellarPowerCount} is not set:
								set {_stellarPowerCount} to 0

							if {_constellation} < 6:
								add 1 to {_constellations}
								set yaml value "Player.Total Constellations" in "playerData-%player%" to {_constellations}
							else:
								add 1 to {_stellarPowerCount}
								set yaml value "Player.Total Stellar Power" in "playerData-%player%" to {_stellarPowerCount}

							save yaml "playerDataConstellation-%player%"
							unload yaml "playerDataConstellation-%player%"
							play sound "entity.player.levelup" with volume 3 and pitch 0.1 at player
							play sound "entity.firework_rocket.launch" with volume 3 and pitch 0.42 at player
							if 6 >= {_constellation}:
								send "&b&l&l✨ &b&oSuccesfully advanced the Constellation level of %name of player's tool%&b&o." to player
							else:
								send "&b&l&l✨ &b&oSuccesfully advanced the Stellar Power level of %name of player's tool%&b&o." to player
							loop 3 times:
								play sound "block.glass.break" with volume 3 and pitch 1.7+(loop-number*0.1) at player
							stop loop

