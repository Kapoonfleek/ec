#Spawn - Mine Elevator
on rightclick on oak button:
    set {_locUpper} to location(9164.5, 48.5, 1752.5, world "world", -180, 0)
    set {_locLower} to location(9165.5, 2.5, 1750.5, world "world", -180, 0)

    set {_locUpperChamber} to location(9112.5, -7.5, 1676.5, world "world", 0, 0)
    set {_locLowerChamber} to location(9112.5, -40.5, 1678.5, world "world", -180, 0)
    if block under player is waxed exposed copper grate:
        if location of event-block = {_locUpper}:
            set {_locElevator} to location(9165.5, 1.0, 1749.5, world "world")
            teleport player to {_locElevator}
            play sound "block.piston.contract" with volume 3 and pitch 1 at event-block
            wait 1 tick
            play sound "block.piston.contract" with volume 3 and pitch 1 at {_locElevator}
        else if location of event-block = {_locLower}:
            set {_locElevator} to location(9164.5, 47.0, 1751.5, world "world")
            teleport player to {_locElevator}
            play sound "block.piston.contract" with volume 3 and pitch 1 at event-block
            wait 1 tick
            play sound "block.piston.contract" with volume 3 and pitch 1 at {_locElevator}
        else if location of event-block = {_locUpperChamber}:
            set {_locElevator} to location(9112.5, -42, 1677, world "world", 0, -5)
            teleport player to {_locElevator}
            play sound "block.piston.contract" with volume 3 and pitch 1 at event-block
            wait 1 tick
            play sound "block.piston.contract" with volume 3 and pitch 1 at {_locElevator}
        else if location of event-block = {_locLowerChamber}:
            set {_locElevator} to location(9112.5, -9, 1677, world "world", -180, 5)
            teleport player to {_locElevator}
            play sound "block.piston.contract" with volume 3 and pitch 1 at event-block
            wait 1 tick
            play sound "block.piston.contract" with volume 3 and pitch 1 at {_locElevator}

every 1 minute:
    if {worldTimePaused} != true:
        set time in world "world" to SyncedWorldTimeWarsaw() parsed as time

on sound packet:
    if event.getId() = "minecraft:entity.cat.purreow":
        set {_pitch} to a random number between 0 and 2.0
        play sound "misc.gamestillcold" in jukebox category with volume 1 and pitch {_pitch} to player
        event.setCancelled(true)
        

function WarsawTimeToSeconds(time: text) :: number:
    set {_parts::*} to {_time} split at ":"
    set {_hours} to {_parts::1} parsed as number
    set {_minutes} to {_parts::2} parsed as number
    set {_seconds} to {_parts::3} parsed as number
    return ({_hours} * 3600) + ({_minutes} * 60) + {_seconds}

function RefreshWarsawSunTimes():
    set {_json} to text from "https://api.sunrisesunset.io/json?lat=52.2297&lng=21.0122&timezone=Europe/Warsaw&time_format=24"
    set {_splitSunrise::*} to {_json} split at '"sunrise":"'
    set {_sunrisePart::*} to {_splitSunrise::2} split at '"'
    set {warsawSunriseText} to {_sunrisePart::1}
    set {_splitSunset::*} to {_json} split at '"sunset":"'
    set {_sunsetPart::*} to {_splitSunset::2} split at '"""'
    set {warsawSunsetText} to {_sunsetPart::1}
    set {warsawSunriseSeconds} to WarsawTimeToSeconds({warsawSunriseText})
    set {warsawSunsetSeconds} to WarsawTimeToSeconds({warsawSunsetText})

function SyncedWorldTimeWarsaw() :: number:
    if {warsawSunriseSeconds} is not set:
        RefreshWarsawSunTimes()
    set {_hours} to now formatted as "HH" parsed as number
    set {_minutes} to now formatted as "mm" parsed as number
    set {_seconds} to now formatted as "ss" parsed as number
    set {_nowSeconds} to ({_hours} * 3600) + ({_minutes} * 60) + {_seconds}
    set {_sunrise} to {warsawSunriseSeconds}
    set {_sunset} to {warsawSunsetSeconds}

    if all:
        {_nowSeconds} >= {_sunrise}
        {_nowSeconds} < {_sunset}
    then:
        set {_progress} to ({_nowSeconds} - {_sunrise}) / ({_sunset} - {_sunrise})
        set {_ticks} to {_progress} * 12000
    else:
        set {_nightLength} to (86400 - {_sunset}) + {_sunrise}
        if {_nowSeconds} >= {_sunset}:
            set {_nightProgress} to ({_nowSeconds} - {_sunset}) / {_nightLength}
        else:
            set {_nightProgress} to ((86400 - {_sunset}) + {_nowSeconds}) / {_nightLength}
        set {_ticks} to 12000 + ({_nightProgress} * 12000)

    if {_ticks} >= 24000:
        set {_ticks} to {_ticks} - 24000

    return round({_ticks}, 0)

on load:
    RefreshWarsawSunTimes()

every 30 minutes:
    RefreshWarsawSunTimes()
