function StellarPityChance(p: player) :: number:
	set {_pityStellar} to yaml value "Player.Stellar Pity" in "data-%{_p}%"
	if {_pityStellar} is not set:
		set {_pityStellar} to 0
	if {_pityStellar} >= 30:
		if {_pityStellar} < 32:
			set {_chance} to 2.5*((({_pityStellar} - 30) + 1)) + ((({_pityStellar} - 30) + 1)*1.5)
		else:
			set {_pt} to (({_pityStellar} - 30) + 1)
			set {_chance} to 8 + ((1.4*({_pt}-3))*(({_pt}-2)*1.11))
	else:
		set {_chance} to yaml value "Settings.Base Card Chance" in "StellarChestList"
		if {_chance} is not set:
			set {_chance} to 2.5
	return {_chance}

function StellarCurrentCycle() :: number:
	set {_cycle} to yaml value "Settings.Cycle" in "StellarChestList"
	if {_cycle} is not set:
		set {_cycle} to 1
	return {_cycle}

function StellarFatedCard(p: player) :: text:
	set {_cycle} to StellarCurrentCycle()
	set {_playerCycle} to yaml value "Player.Fated Card Cycle" in "data-%{_p}%"
	if {_playerCycle} != {_cycle}:
		clear yaml value "Player.Fated Card" in "data-%{_p}%"
		clear yaml value "Player.Fated Card Cycle" in "data-%{_p}%"
		save yaml "data-%{_p}%"
		return ""
	set {_card} to yaml value "Player.Fated Card" in "data-%{_p}%"
	if {_card} is not set:
		return ""
	return {_card}

function StellarSetFatedCard(p: player, card: text):
	set yaml value "Player.Fated Card" in "data-%{_p}%" to {_card}
	set yaml value "Player.Fated Card Cycle" in "data-%{_p}%" to StellarCurrentCycle()
	save yaml "data-%{_p}%"

function StellarWeeklyCard() :: text:
	set {_cards::*} to yaml list "Weekly Rotation.Cards" in "StellarChestList"
	set {_index} to yaml value "Weekly Rotation.Current Index" in "StellarChestList"
	if {_index} is not set:
		set {_index} to 1
	if {_cards::%{_index}%} is not set:
		set {_index} to 1
		set yaml value "Weekly Rotation.Current Index" in "StellarChestList" to {_index}
		save yaml "StellarChestList"
	return {_cards::%{_index}%}

function StellarDroppedCard(p: player) :: text:
	set {_fated} to StellarFatedCard({_p})
	set {_weekly} to StellarWeeklyCard()
	if {_fated} is not set:
		return {_weekly}
	if {_fated} = "":
		return {_weekly}
	set {_preferredChance} to yaml value "Settings.Preferred Chance" in "StellarChestList"
	if {_preferredChance} is not set:
		set {_preferredChance} to 50
	chance of {_preferredChance}%:
		return {_fated}
	return {_weekly}

function StellarCardItem(card: text) :: item:
	set {_material} to yaml value "Cards.%{_card}%.Material" in "StellarChestList"
	set {_name} to coloured (yaml value "Cards.%{_card}%.Name" in "StellarChestList")
	set {_subtitle} to yaml value "Cards.%{_card}%.Subtitle" in "StellarChestList"
	set {_primaryStat} to yaml value "Cards.%{_card}%.Primary Stat" in "StellarChestList"
	set {_element} to coloured (yaml value "Cards.%{_card}%.Element" in "StellarChestList")
	set {_elementString} to coloured (yaml value "Cards.%{_card}%.Element String" in "StellarChestList")
	set {_sourceString} to coloured (yaml value "Cards.%{_card}%.Source String" in "StellarChestList")
	set {_cmd} to yaml value "Cards.%{_card}%.CustomModelData" in "StellarChestList"

	if {_material} is not set:
		return barrier named "&cMissing card material: %{_card}%"

	set {_itemType} to {_material} parsed as item type
	set {_cardColour} to last string color code of {_name}
	set {_statsCard} to "&7Level: %{_cardColour}%0 &7| &7Exp: %{_cardColour}%0"

	set {_item} to {_itemType} named {_name} with lore {_subtitle} and {_statsCard} and {_elementString} and {_sourceString} with nbt compound from "{""minecraft:custom_model_data"":{floats:[%{_cmd}%.0f]}}"

	set string tag "PrimaryStat" of nbt of {_item} to {_primaryStat}
	set string tag "Element" of nbt of {_item} to {_element}

	return {_item}

function StellarCardPreview(card: text) :: item:
    set {_material} to yaml value "Cards.%{_card}%.Material" in "StellarChestList"
    set {_name} to yaml value "Cards.%{_card}%.Name" in "StellarChestList"
    set {_cmd} to yaml value "Cards.%{_card}%.CustomModelData" in "StellarChestList"

    set {_previewType} to yaml value "Cards.%{_card}%.Preview Type" in "StellarChestList"
    set {_description::*} to yaml list "Cards.%{_card}%.Preview Description" in "StellarChestList"
    set {_difficulty} to yaml value "Cards.%{_card}%.Difficulty" in "StellarChestList"
    set {_abilities::*} to yaml list "Cards.%{_card}%.Preview Abilities" in "StellarChestList"

    set {_itemType} to {_material} parsed as item type
    set {_item} to {_itemType} named (colored {_name}) with nbt compound from "{""minecraft:custom_model_data"":{floats:[%{_cmd}%.0f]}}"

    set {_lore::*} to {_previewType}

    loop {_description::*}:
        set {_lore::*} to {_lore::*} and loop-value

    set {_lore::*} to {_lore::*} and " "
    set {_lore::*} to {_lore::*} and {_difficulty}
    set {_lore::*} to {_lore::*} and " "
    set {_lore::*} to {_lore::*} and "&7Abilities:"

    loop {_abilities::*}:
        set {_lore::*} to {_lore::*} and loop-value

    set {_cardChance} to yaml value "Settings.Base Card Chance" in "StellarChestList"
    if {_cardChance} is not set:
        set {_cardChance} to 2.5

    set {_lore::*} to {_lore::*} and " "
    set {_lore::*} to {_lore::*} and "&7Base probability: &f%{_cardChance}%%%"

    set lore of {_item} to {_lore::*}

    return {_item}

function StellarRandomBooster(amount: number) :: item:
	set {_boosters::*} to {boostersecretwonders}, {boostermajesticdawn}, {boosterunseenforces}, {boosterplasmafreeze} and {boosterteampoisonvsteamaqua}
	set {_booster} to a random element of {_boosters::*}
	set {_item} to {_amount} of {_booster}
	return {_item}

function StellarRewardItem(reward: text, p: player) :: item:
	set {_type} to yaml value "Rewards.%{_reward}%.Type" in "StellarChestList"
	set {_amount} to yaml value "Rewards.%{_reward}%.Amount" in "StellarChestList"
	if {_amount} is not set:
		set {_amount} to 1
	if {_type} = "RandomBooster":
		set {_item} to StellarRandomBooster({_amount})
	else if {_type} = "Klejnot":
		set {_item} to 1 of emerald named "<#b5e550>%{_amount}%x Klejnot" with lore "&7Bring this item to Agnes the Cow" and "&7at spawn in order to exchange it."
	else if {_type} = "DiamondShard":
		set {_item} to {_amount} of {diamondshard}
	else if {_type} = "Stardust":
		set {_item} to 1 of {stardust} named "&e%{_amount}% %{stardust}'s name%" with lore "&7Bring this item to Agnes the Cow" and "&7at spawn in order to exchange it."
	else if {_type} = "LuxuriousChest":
		set {_item} to {_amount} of {skrzynkaluksusowa}
	else if {_type} = "SageExpBook":
		set {_item} to {_amount} of {sageexpbook}
	else if {_type} = "MagicPrism":
		set {_item} to {magicznypryzmat}
	else:
		set {_item} to barrier named "&cUnknown reward: %{_reward}%"
	return {_item}

function StellarRewardDisplay(reward: text, item: item) :: text:
	set {_display} to yaml value "Rewards.%{_reward}%.Display" in "StellarChestList"
	if {_display} is not set:
		set {_display} to coloured (name of {_item})
	replace all "{ITEM}" in {_display} with (coloured name of {_item})
	return {_display}

function StellarRollReward() :: text:
	set {_total} to 0
	loop yaml node keys "Rewards" in "StellarChestList":
		set {_chance} to yaml value "Rewards.%loop-value%.Chance" in "StellarChestList"
		if {_chance} is set:
			set {_total} to {_total} + {_chance}
	set {_roll} to a random number between 0 and {_total}
	set {_current} to 0
	loop yaml node keys "Rewards" in "StellarChestList":
		set {_chance} to yaml value "Rewards.%loop-value%.Chance" in "StellarChestList"
		if {_chance} is set:
			set {_current} to {_current} + {_chance}
			if {_roll} <= {_current}:
				return loop-value
	set {_fallback::*} to yaml node keys "Rewards" in "StellarChestList"
	return {_fallback::1}

function StellarPoolItems(p: player) :: items:
    loop yaml node keys "Rewards" in "StellarChestList":
        set {_item} to StellarRewardItem(loop-value, {_p})
        if {_item} is set:
            set {_pool::*} to {_pool::*} and {_item}

    set {_fated} to StellarFatedCard({_p})
    if {_fated} is set:
        if {_fated} != "":
            set {_item} to StellarCardItem({_fated})
            if {_item} is set:
                set {_pool::*} to {_pool::*} and {_item}

    set {_weekly} to StellarWeeklyCard()
    if {_weekly} is set:
        set {_item} to StellarCardItem({_weekly})
        if {_item} is set:
            set {_pool::*} to {_pool::*} and {_item}

    return {_pool::*}

function StellarFatedCardMenu(p: player):
    set metadata tag "stelarnaskrzynkacardcourse" of {_p} to chest inventory with 3 rows named "Choose Fated Card"
    set {_m} to metadata tag "stelarnaskrzynkacardcourse" of {_p}
    set {_slot} to 10

    loop yaml list "Weekly Rotation.Cards" in "StellarChestList":
        set {_preview} to StellarCardPreview(loop-value)
        if {_preview} is set:
            set {_selectLore::*} to colored lore of {_preview}
            set {_selectLore::*} to {_selectLore::*} and " "
            set {_selectLore::*} to {_selectLore::*} and "&2&l(&a!&2&l) &aClick here to choose this Card"
            set {_selectLore::*} to {_selectLore::*} and "&aas your Fated Card for this Stellar cycle."
            set lore of {_preview} to {_selectLore::*}

            set string tag "StellarCard" of (custom nbt of {_preview}) to loop-value
            set slot {_slot} of {_m} to {_preview}

            set {_slot} to {_slot} + 1
            if {_slot} = 17:
                set {_slot} to 22

    open {_m} to {_p}

function StellarSpinAnimation(p: player, finalItem: item):
    set {_inv} to metadata tag "stelarnaskrzynka" of {_p}
    open {_inv} to {_p}

    set {_pool::*} to StellarPoolItems({_p})
    if {_pool::*} is not set:
        set {_pool::*} to {_finalItem}

    set slots integers between 0 and 8 of {_inv} to red stained glass pane named " "
    set slots integers between 18 and 26 of {_inv} to red stained glass pane named " "
    set slots 4 and 22 of {_inv} to white stained glass pane named " "

    set {_frames} to 52
    set {_reelSize} to {_frames} + 8

    loop {_reelSize} times:
        set {_reel::%loop-number%} to a random element of {_pool::*}

    set {_reel::5} to {_finalItem}

    loop {_frames} times:
        set {_frame} to loop-number
        set {_slot} to 9

        loop 9 times:
            set {_index} to ({_frames} - {_frame}) + loop-number-2
            set slot {_slot} of {_inv} to {_reel::%{_index}%}
            set {_slot} to {_slot} + 1

        play sound "block.small_amethyst_bud.break" with volume 2 and pitch 2 to {_p}
        play sound "block.small_amethyst_cluster.break" with volume 2 and pitch 1.5 to {_p}

        if {_frame} <= 20:
            wait 1 tick
        else if {_frame} <= 34:
            wait 2 ticks
        else if {_frame} <= 44:
            wait 3 ticks
        else:
            wait 5 ticks

    set slot 13 of {_inv} to {_finalItem}
    play sound "entity.experience_orb.pickup" with volume 2 and pitch 1.3 to {_p}

    wait 10 ticks

    set metadata tag "stelarnaskrzynkaopen" of {_p} to chest inventory with 3 rows named "Stelarna Skrzynka"
    set {_openInv} to metadata tag "stelarnaskrzynkaopen" of {_p}

    set slots integers between 9 and 12 of {_openInv} to white stained glass pane
    set slots integers between 14 and 17 of {_openInv} to white stained glass pane
    set slots integers between 0 and 8 of {_openInv} to red stained glass pane named " "
    set slots integers between 18 and 26 of {_openInv} to red stained glass pane named " "

    set slot 13 of {_openInv} to {_finalItem}
    open {_openInv} to {_p}

    clear {stellaropening::%{_p}%}

function StellarPrepareCard(p: player, card: text) :: item:
    set {_it} to StellarCardItem({_card})
    set {_y} to data()
    set {_id} to random 8 char string from charset `0-9` `a-z`

    add "&8Id: %{_id}%" to lore of {_it}
    add "&8Dropped: %{_y}%" to lore of {_it}

    set {_primaryStat} to string tag "PrimaryStat" of nbt of {_it}

    add nbt from "{Stats:{%{_primaryStat}%:0,Health:0,Damage:0,Resistance:0,Mobility:0,Utility:0,'Crowd Control':0,Versatility:0,Mastery:0,'Critical Hit':0,Element:0,Haste:0,Avoidance:0,Total:0}}" to nbt of {_it}

    return {_it}

function StellarBlankStats(primaryStat: text) :: text:
    if {_primaryStat} = "Intellect":
        set {_primaryLine} to "&7Intellect: &7■■■■■■■■■■ &7(<#59c1e3>0&7)"
    else if {_primaryStat} = "Strength":
        set {_primaryLine} to "&7Strength: &7■■■■■■■■■■ &7(<#e35959>0&7)"
    else if {_primaryStat} = "Agility":
        set {_primaryLine} to "&7Agility: &7■■■■■■■■■■ &7(<#5ee359>0&7)"

    set {_stats} to "%nl%&7Statistics:%nl%%{_primaryLine}%"
    set {_stats} to "%{_stats}%%nl%&7Health: <#c0ff02>&7■■■■■■■■■■ &7(<#c0ff02>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Damage: <#f74428>&7■■■■■■■■■■ &7(<#f74428>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Resistance: <#ffef45>&7■■■■■■■■■■ &7(<#ffef45>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Mobility: &f&7■■■■■■■■■■ &7(&f0&7)"
    set {_stats} to "%{_stats}%%nl%&7Utility: <#ae78d0>&7■■■■■■■■■■ &7(<#ae78d0>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Crowd Control: <#58c3f5>&7■■■■■■■■■■ &7(<#58c3f5>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Versatility: <#e3ebff>&7■■■■■■■■■■ &7(<#e3ebff>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Mastery: <#f53b98>&7■■■■■■■■■■ &7(<#f53b98>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Critical Hit: <#fca417>&7■■■■■■■■■■ &7(<#fca417>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Element: <#d5ff57>&7■■■■■■■■■■ &7(<#d5ff57>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Haste: <#19943e>&7■■■■■■■■■■ &7(<#19943e>0&7)"
    set {_stats} to "%{_stats}%%nl%&7Avoidance: <#2154ad>&7■■■■■■■■■■ &7(<#2154ad>0&7)"

    return {_stats}

on load:
	set {_x} to block at location(-1209.5, 96, -1815, world "world")
	while {_x} is set:
		loop 2250 times:
			if chunk at {_x} is loaded:
				draw 15 of (red dust particles of size 1 that transitions to white) with offset vector(0.6, 0.3, 0.6) at location of {_x}
				wait 1.6 second
		wait 1 hour

on load:
	set {_x} to block at location(-1209.5, 96, -1815, world "world")
	while {_x} is set:
		set {_y} to 0
		loop 600 times:
			if chunk at {_x} is loaded:
				loop 120 times:
					set {_v} to vector(1, 0, 1)
					rotate {_v} around y-axis by {_y}
					set {_y} to {_y} + 4
					draw 1 of (red dust particle of size 1) at {_x} ~ {_v}
					wait 1 tick
		wait 1 hour

on rightclick on red stained glass:
	if "%region at event-block%" contains "klifywyniesienia":
		if {dailyResetSoon} is not set:
			play sound "block.amethyst_block.resonate" with volume 5 and pitch 2 to player
			if StellarFatedCard(player) = "":
				StellarFatedCardMenu(player)
				stop
			set {_shards::*} to {odlamekgwiazdy}
			if {_shards::*} contains 1 of player's held item:
				if player is alive:
					if {stellaropening::%player%} is not set:
						set metadata tag "stelarnaskrzynka" of player to chest inventory with 3 rows named "Open?"
						set slot 12 of metadata tag "stelarnaskrzynka" of player to 1 of player's tool with lore (lore of player's held item) and "%nl%&7You have this item."
						set slot 14 of metadata tag "stelarnaskrzynka" of player to lime stained glass pane named "&aClick here to open" with lore "&7Click here to spend 1 &cStar Shard%nl%&7and open the &cStellar Chest&7."
						open metadata tag "stelarnaskrzynka" of player to player
						loop 3 times:
							play sound "block.amethyst_block.resonate" with volume 5 and pitch 2 to player
							wait 0.1 second
						play sound "block.amethyst_cluster.break" with volume 5 and pitch 1.8 to player
					else:
						send "&c&oYou are currently opening the Stellar Chest. You must wait until the process has ended to open the chest again." to player
						play sound "block.beacon.deactivate" with volume 2 and pitch 0 to player
			else:
				send "&cThe Stellar Chest doesn't respond..." to player
				play sound "block.beacon.deactivate" with volume 2 and pitch 0 to player
		else:
			send "&cThe Stellar Chest lies dormant." to player
			send "&cPlease wait until the server reset (6:00AM server time) to open the Stellar Chest." to player
		play sound "block.beacon.deactivate" with volume 2 and pitch 0 to player

on inventory click:
	if player's current inventory = metadata tag "stelarnaskrzynkaopen" of player:
		if index of event-slot is 13:
			if event-slot is not air:
				play sound "entity.player.levelup" with volume 5 and pitch 1.3 at player
		else:
			if clicked slot is not air:
				cancel event
	else if player's current inventory = metadata tag "stelarnaskrzynkacardcourse" of player:
		cancel event
		if clicked slot is not air:
			set {_card} to string tag "StellarCard" of custom nbt of clicked slot
			if {_card} is set:
				StellarSetFatedCard(player, {_card})
				send "&4&l(&c!&4&l) &cYou chose &f%{_card}% &cas your Fated Card for this Stellar cycle!" to player
				play sound "entity.player.levelup" with volume 3 and pitch 1.45 to player
				close player's inventory
	if player's current inventory = metadata tag "stelarnaskrzynka" of player:
		cancel event
		set {_slots::*} to lime stained glass pane named "&aClick here to open" and lime stained glass pane named "&aKliknij tutaj, by otworzyć"
		if {_slots::*} contains clicked slot:
			set {_shard} to 1 of player's tool
			remove 1 of player's tool from player
			set {stellarchestsOpened::%player%} to {stellarchestsOpened::%player%} + 1
			set {stellaropening::%player%} to true
			if {stellarchestsOpened::%player%} = 1:
				set {_yamlValue} to "Achievement.Stellar Chest.Open.1"
				achievementYaml(player, "plugins/Skript/playerdata/achievements", "Achievements", {_yamlValue}, "Stellar", "Open the Stellar Chest.")
			else if {stellarchestsOpened::%player%} = 100:
				set {_yamlValue} to "Achievement.Stellar Chest.Open.100"
				achievementYaml(player, "plugins/Skript/playerdata/achievements", "Achievements", {_yamlValue}, "Stellar Chest: 100", "Open the Stellar Chest 100 times.")
			if {language::%player%} = "English":
				set metadata tag "stelarnaskrzynka" of player to chest inventory with 3 rows named "Stellar Chest"
			else:
				set metadata tag "stelarnaskrzynka" of player to chest inventory with 3 rows named "Stelarna Skrzynka"
			open metadata tag "stelarnaskrzynka" of player to player
			set {_num} to a random number between 1 and 100
			set {_dr1} to StellarPityChance(player)
			if {_num} <= {_dr1}:
				set {_droppedCard} to StellarDroppedCard(player)
				set {_it} to StellarPrepareCard(player, {_droppedCard})
				set {nagrodastelarna::%player%} to coloured (name of {_it})
				set {_cardName} to uncolored name of {_it}
				set {%{_cardName}%::collected::%player%} to {%{_cardName}%::collected::%player%} + 1
				if {%{_cardName}%::collected::%player%} = 1:
					set {_yamlValue} to "Achievement.Card Collection.%{_cardName}%"
					achievementYaml(player, "plugins/Skript/playerdata/achievements", "Achievements", {_yamlValue}, {_cardName}, "Obtain the %{_cardName}% Card.")
				if {kolekcja::karty::%player%::*} does not contain uncolored name of {_it}:
					set {kolekcja::karty::%player%::*} to {kolekcja::karty::%player%::*} and uncolored name of {_it}
				loop all players:
					play sound "entity.ender_dragon.death" with volume 3 and pitch 1 to loop-player
					send "&c&kSTELARNA SKRZYNKA STELARNA SKRZYNKA STELARNA SKRZYNKA" to loop-player
					send "&f&l%player% &cdropped %{nagrodastelarna::%player%}% &cfrom the &c&lStellar Chest!" to loop-player
					send "&c&kSTELARNA SKRZYNKA STELARNA SKRZYNKA STELARNA SKRZYNKA" to loop-player
				set {_pityBefore} to yaml value "Player.Stellar Pity" in "data-%player%"
				if {_dr1} > 2.5:
					set {_sPD} to yaml value "Player.Stellar Pity Drops" in "data-%player%"
					if {_sPD} is not set:
						set {_sPD} to 0
					set {_sPD} to {_sPD} + 1
					set yaml value "Player.Stellar Pity Drops" in "data-%player%" to {_sPD}
					log "%data()% %player% Dropped %uncolored name of {_it}%! (%{_pityBefore}% Pity)" to "logi/stellarchest/cards/carddrops.log"
				else:
					set {_sPD} to yaml value "Player.Stellar Normal Drops" in "data-%player%"
					if {_sPD} is not set:
						set {_sPD} to 0
					set {_sPD} to {_sPD} + 1
					set yaml value "Player.Stellar Normal Drops" in "data-%player%" to {_sPD}
					log "%data()% %player% Dropped %uncolored name of {_it}%! (Normal Drop)" to "logi/stellarchest/carddrops.log"
				set yaml value "Player.Stellar Pity" in "data-%player%" to 0
				StellarCardDiscord(player, uncolored name of {_it})
			else:
				set {_pityStellar} to yaml value "Player.Stellar Pity" in "data-%player%"
				if {_pityStellar} is set:
					set {_pityStellar} to {_pityStellar} + 1
				else:
					set {_pityStellar} to 1
				set yaml value "Player.Stellar Pity" in "data-%player%" to {_pityStellar}
				set {_reward} to StellarRollReward()
				set {_it} to StellarRewardItem({_reward}, player)
				set {nagrodastelarna::%player%} to StellarRewardDisplay({_reward}, {_it})
				log "%data()% %player% Dropped %uncolored name of {_it}%!" to "logi/stellarchest/otherdrops.log"
			set {_totalDrops} to yaml value "Player.Stellar Total Drops" in "data-%player%"
			if {_totalDrops} is not set:
				set {_totalDrops} to 0
			set {_totalDrops} to {_totalDrops} + 1
			set yaml value "Player.Stellar Total Drops" in "data-%player%" to {_totalDrops}
			save yaml "data-%player%"

			StellarSpinAnimation(player, {_it})

on inventory close:
	if player's current inventory = metadata tag "stelarnaskrzynkaopen" of player:
		if {stellarRewardClaimed::%player%} is true:
			stop
		set {stellarRewardClaimed::%player%} to true

		if (slot 13 of metadata tag "stelarnaskrzynkaopen" of player) is air:
			set {_message} to "&cStellar Chest >>> &fCongratulations! You receive: %{nagrodastelarna::%player%}%&f!"
			send {_message} to player
		else:
			set {_item} to slot 13 of metadata tag "stelarnaskrzynkaopen" of player
			giveItem(player, {_item})

			set slot 13 of metadata tag "stelarnaskrzynkaopen" of player to air

			set {_message} to "&cStellar Chest >>> &fCongratulations! You receive: %{nagrodastelarna::%player%}%&f!"
			send {_message} to player

		clear {nagrodastelarna::%player%}
		clear {stellarRewardClaimed::%player%}

on rightclick on armor stand:
	loop all blocks in radius 1.5 around clicked armor stand:
		if loop-block is red stained glass:
			if location of loop-block is {stelarnaloc}:
				cancel event

on leftclick on red stained glass:
	if "%region at event-block%" contains "klifywyniesienia":
		if player is alive:
			set metadata tag "stelarnaskrzynkapreview" of player to chest inventory with 2 rows named "Stellar Chest"
			set {_menu} to metadata tag "stelarnaskrzynkapreview" of player
			set {_fated} to StellarFatedCard(player)
			set {_weekly} to StellarWeeklyCard()
			if {_fated} = "":
				set slot 0 of {_menu} to black stained glass pane named "&8No Fated Card" with lore "&7&oYou have not yet chosen your%nl%&7&oFated Card for this Stellar cycle.%nl%&7&oRight-click on the Stellar Chest to do it."
			else:
				set {_preview} to StellarCardPreview({_fated})
				if {_preview} is set:
					set slot 0 of {_menu} to {_preview}
			set {_weeklyPreview} to StellarCardPreview({_weekly})
			if {_weeklyPreview} is set:
				set slot 8 of {_menu} to {_weeklyPreview} with lore (lore of {_weeklyPreview}) and "%nl%&7Weekly Rotation Card"
			open {_menu} to player

on inventory click:
	if player's current inventory = metadata tag "stelarnaskrzynkapreview" of player:
		cancel event

on rightclick on armor stand:
	loop all blocks in radius 1.5 around clicked armor stand:
		if loop-block is red stained glass:
			if location of loop-block is {stelarnaloc}:
				cancel event
