
#PASYWKA - ZWIĘKSZA SIŁĘ TARCZ NA SOJUSZNIKACH KTÓRZY MAJĄ +70% HP O 10% 
#- ZWIĘKSZA SIŁĘ LECZENIA NA SOJUSZNIKACH KTÓRZY MAJĄ -30% HP O 10%
#UM 2 - DISPELL - usuwa szkodliwy efekt z sojusznika taki jak trucizny lub klątwy, lub pomocniczy z przeciwnika tj. enrage jeśli został użyty na wrogu
#um 3 REVERSAL - odwraca wszystkie tarcze na mapie na leczenie
#Circle of Water: leczenie przywołuje koło wody wokół uleczonego celu. healing stream zdetonuje koło i uleczy cel o dodatkowe 0.2 hp


#Vaporeon rework
#- Użycie tarczy na sojuszniku, który już posiada tarcze, zamiast ustawiać wartość tarczy na nowo dodaje wartość do istniejącej tarczy.
#- Zmieniono mastery z Wydłuża czas trwania Wybuchowego Bąbelka o 0.25 + mastery/80 sekund na
#- Water Cycle: Zwiększa siłę tarcz na sojusznikach, którzy mają powyżej 50% zdrowia o 15%. Zwiększa siłę leczenia na sojusznikach którzy mają poniżej 50% zdrowia o 15%.
#- Wybuchowy Bąbelek teraz ma 3 sekundowy cooldown i ustawia cooldown na cel, zamiast mieć 26 sekundowy globalny cooldown.
#- Wybuchowy Bąbelek chroni teraz x obrażeń i zadaje x obrażeń
#- Nowa umiejętność: 


on load:
	set {traits::Vaporeon::*} to "Bound Molecules", "Cascade", "Downpour", "Flow of Water", "Heavy Bubbles", "High Tide", "Hydrodance", "Hydrotherapy", "Riversplit" and "Saving Drops"
	set {Bound Molecules} to ""
	set {Cascade} to ""
	set {Downpour} to ""
	set {Flow of Water} to ""
	set {Heavy Bubbles} to ""
	set {High Tide} to ""
	set {Hydrodance} to ""
	set {Hydrotherapy} to ""
	set {Riversplit} to ""
	set {Saving Drops} to ""

on join:
	if {kolekcja::karty::%player%::*} contains "Vaporeon":
		loop 10 times:
			set {_r} to {traits::Vaporeon::%loop-number%}
			set {_x%loop-number%} to {trait::Vaporeon::%{_r}%::%player%}
		if {language::%player%} = "English":
			set {traits::Vaporeon::1::opis::%player%} to "<#7cafbf>Healing Stream &7heals all allies with%nl%<#7cafbf>Circle of Water &7active by &f%0.3*{_x1}% &7health."
			set {traits::Vaporeon::2::opis::%player%} to "&7Detonating <#7cafbf>Circle of Water &7reduces%nl%&7the cooldown of <#7cafbf>Explosive Bubble &7on the%nl%&7affected ally by &f%0.2*{_x2}% seconds&7."
			set {traits::Vaporeon::3::opis::%player%} to "&7When you cast <#7cafbf>Explosive Bubble &7on an ally, you%nl%&7summon healing rain above them, restoring%nl%&7&f%0.5*{_x3}% &7of their HP."
			set {traits::Vaporeon::4::opis::%player%} to "<#7cafbf>Circle of Water &7has &f%4.5*{_x4}%%% &7chance%nl%&7to not become detonated when%nl%&7you cast <#7cafbf>Healing Stream&7."
			set {traits::Vaporeon::5::opis::%player%} to "<#7cafbf>Explosive Bubble &7deals an additional &f%0.15*{_x5}% &7damage%nl%&7for each 1 shield point&7."
			set {traits::Vaporeon::6::opis::%player%} to "<#7cafbf>Reversal &7heals allies by an additional%nl%&f%0.8*{_x6}% &7HP on top of the reversed value&7."
			set {traits::Vaporeon::7::opis::%player%} to "&7Overhaling will heal the nearest ally to your target%nl%&7by &f%5*{_x7}%%% &7of the overhaling value."
			set {traits::Vaporeon::8::opis::%player%} to "<#7cafbf>Reversal &7restores &f%2*{_x8}% HP &7to a random%nl%&7nearby ally for each shield reversed."
			set {traits::Vaporeon::9::opis::%player%} to "<#7cafbf>Healing stream &7heals the nearest ally to%nl%&7your target for &f%5*{_x9}%%% &7of its value."
			set {traits::Vaporeon::10::opis::%player%} to "&7Detonating <#7cafbf>Circle of Water &7has &f%2.75*{_x10}%%% &7chance%nl%&7to grant you a charge of <#7cafbf>Healing Stream&7."
		else:
			if {_x9} > 1:
				set {_tekst} to "sekundy"
			else:
				set {_tekst} to "sekundę"
			if {_x9} = 4:
				set {_tekst2} to "obrażenia"
			else:
				set {_tekst2} to "obrażeń"
			set {traits::Vaporeon::1::opis::%player%} to "<#7cafbf>Uzdrawiający Strumień &leczy wszystkich sojuszników%nl%&7z aktywnym <#7cafbf>Kołem Wody &7o &f%0.3*{_x1}% &7zdrowia."
			set {traits::Vaporeon::2::opis::%player%} to "&7Zdetonowanie <#7cafbf>Koła Wody &7zredukuje cooldown%nl%<#7cafbf>Wybuchowego Bąbelka &7na celu o &f%0.2*{_x2}% sekundy&7."
			set {traits::Vaporeon::3::opis::%player%} to "&7Kiedy używasz <#7cafbf>Wybuchowego Bąbelka &7na sojuszniku,%nl%&7przywołujesz leczniczy deszcz, przywracając%nl%&7&f%0.5*{_x3}% &7zdrowia temu sojusznikowi."
			set {traits::Vaporeon::4::opis::%player%} to "<#7cafbf>Koło Wody &7ma &f%4.5*{_x4}%%% &7szans na%nl%&7nie zostanie zdetonowanym, kiedy%nl%&7używasz <#7cafbf>Uzdrowiającego Strumienia&7."
			set {traits::Vaporeon::5::opis::%player%} to "<#7cafbf>Wybuchowy Bąbelek &7zadaje dodatkowe &f%0.15*{_x5}% &7dobrażeń%nl%&7za każdy 1 punkt tarczy&7."
			set {traits::Vaporeon::6::opis::%player%} to "<#7cafbf>Reversal &7leczy sojuszników o dodatkowe%nl%&f%0.8*{_x6}% &7HP."
			set {traits::Vaporeon::7::opis::%player%} to "&7Overhalowanie uleczy najbliższego sojusznika od%nl%&7twojego celu o &f%5*{_x7}%%% &7od wartości overheal'u."
			set {traits::Vaporeon::8::opis::%player%} to "<#7cafbf>Reversal &7przywraca &f%2*{_x8}% HP &7losowemu%nl%&7pobliskiemu sojusznikowi za każdą%nl%&7odwróconą tarczę."
			set {traits::Vaporeon::9::opis::%player%} to "<#7cafbf>Uzdrawiający Strumień &7leczy najbliższego sojusznika%nl%&7od twojego celu o &f%5*{_x9}%%% &7jego wartości."
			set {traits::Vaporeon::10::opis::%player%} to "&7Zdetonowanie <#7cafbf>Koła Wody &7ma &f%2.75*{_x10}%%% &7szans%nl%&7na przyznanie ci ładunku <#7cafbf>Uzdrawiającego Strumienia&7."

on leave:
	if {kolekcja::karty::%player%::*} contains "Vaporeon":
		loop 10 times:
			clear {traits::Vaporeon::%loop-number%::opis::%player%}

function Overhealing(p: player, target: entity, overheal: number, ability: text):
	if {_overheal} > ((max health of {_target}) - (health of {_target})):
		set {_overheal} to {_overheal} - ((max health of {_target}) - (health of {_target}))

		if {kartaname::%{_p}%} = "Vaporeon":
			loop all players in radius 20 of {_target}:
				if uuid of loop-player != uuid of {_target}:
					if health of loop-player < (max health of loop-player):
						set {_players::*} to {_players::*} and loop-player
			if {_players::*} is not set:
				loop all living entities in radius 20 of {_target} where [input is not a player]:
					if boolean tag "ECMob" of (custom nbt of loop-entity) is not set:
						if health of loop-entity < (max health of loop-entity):
							set {_players::*} to {_players::*} and loop-entity
				if {_players::*} is not set:
					loop all entities in radius 20 of {_target}:
						if boolean tag "ECMob" of (custom nbt of loop-entity) is set:
							set {_players::*} to {_players::*} and loop-entity

			loop {_players::*}:
				set {_maxhealth::%uuid of loop-value%} to (health of loop-value/max health of loop-value)

			set {_targets::*} to sorted indices of {_maxhealth::*} in ascending order
			set {_entity} to {_targets::1} parsed as entity

			if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Hydrodance":
				set {_overheal} to 0.3*{_overheal}

				set {_lore} to "<#7cafbf>Overhealing heals the nearest ally%nl%<#7cafbf>by &f30%% <#7cafbf>of the overheal value. If no%nl%<#7cafbf>eligible allies are nearby, overhealing%nl%<#7cafbf>will instead &fdamage <#7cafbf>nearby enemies%nl%<#7cafbf>by &f20%% <#7cafbf>of the value."
				if boolean tag "ECMob" of (custom nbt of {_entity}) is not set:
					Heal({_p}, {_entity}, {_overheal}, "Hydrodance", "<#7cafbf>", {_lore})
				else:
					set {_entity}'s last damage cause to sweep attack
					set metadata value "LastDamageCause" of {_entity} to "<#7cafbf>Hydrodance"
					set metadata value "LastDamageCauseLore" of {_entity} to {_lore}
					set metadata value "Element" of {_p} to "Water"
					make {_p} damage {_entity} by {_overheal}
				play sound "entity.generic.swim" with volume 2.5 and pitch 1.25 at {_entity}
				draw 40 of (((fishing particle) with an extra value of 0.05) with offset vector(0.45, 0.55, 0.45)) at ({_entity})
		else:
			set {_overheal} to {_overheal} - ((max health of {_target}) - (health of {_target}))

on rightclick:
	if boolean tag "Healing Stream" of (custom nbt of player's tool) is set:
		cancel event
		if metadata value "HealingStreamCharges" of player is not set:
			if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) = "Undulation":
				set {_maxCharges} to 3
			else:
				set {_maxCharges} to 2
			set metadata value "HealingStreamCharges" of player to {_maxCharges}
		set {_x} to TargetHealingStream(player, 100, false)
		if {_x} is set:
			if {kartaname::%player%} = "Vaporeon":
				if isCastableVaporeon(player) = true:
					if CanUseAbility(player) != false:
						if cooldown "Healing StreamDoublePrevent%player%" is finished:
							create cooldown "Healing StreamDoublePrevent%player%" for 1 tick
							set {_id} to cardId(player)
							set {_crit} to CriticalHit(player)
							set {_pospiech} to Haste(player)
							set {_cd} to "%8/{_pospiech}% seconds" parsed as timespan

							set {_versatility} to Versatility(player)
							set {_heal} to 1.5 + ({utility::%player%}/80) + ({_versatility}/240) + ({primarystat::%player%}/40)

							AbilityUse(player, "Healing Stream")
							set {_am} to item amount of player's tool
							if {_am} > 1:
								remove 1 of player's tool from player
							#SAVING DROPS
							loop {_loreheart::*}:
								loop-value contains "Saving Drops":
									add (2.75*{trait::Vaporeon::Saving Drops::%player%}) to {_savingdrops}
							chance of {_savingdrops}%:
								set {_drops} to true

							remove 1 from metadata value "HealingStreamCharges" of player
							HealingStreamRecharge(player, {_cd})
							set {_charges} to metadata value "HealingStreamCharges" of player

							if {_charges} = 1:
								set {_chargesLore} to "%{_charges}% Charge"
							else:
								set {_chargesLore} to "%{_charges}% Charges"

							set {_lore} to "&8Ability%nl%&f%{_chargesLore}%%nl%&fInstant cast%nl%&7Cooldown: &f%{_cd}%%nl%&7Use: &fRMB%nl%<#7cafbf>Sends a healing stream towards an ally.%nl%<#7cafbf>Upon reaching its target, the stream will%nl%<#7cafbf>restore &f%{_heal}% <#7cafbf>HP to the affected ally."
							loop all items in the inventory of player:
								if boolean tag "Healing Stream" of (custom nbt of (1 of loop-item)) is set:
									set lore of loop-item to {_lore}
									if {_charges} > 0:
										set item amount of loop-item to {_charges}
										create cooldown "Healing Stream%player%" for {_cd}
									else:
										set the cooldown of loop-item for player to {_cd}
									stop loop							
							set {_id} to cardId(player)
							set {_pospiech} to Haste(player)

							play sound "block.water.ambient" with volume 3 and pitch 1 at (location of player)
							play sound "skill.vaporeon_healingstream_cast" with volume 3 and pitch 1 at (location of player)

							if metadata value "TidalWaves" of player is set:
								set {_tidalWaves} to metadata value "TidalWaves" of player
								clear metadata value "TidalWaves" of player
								send title " " with subtitle " " to player for 1 second with fade in 0.0 second and fade out 0.0 second
							loop blocks between player and {_x}:
								draw 3 of (((rgb 47, 69, 235) dust particle of size 1) with an extra value of 0.03) with offset vector(0.15, 0.15, 0.15) at location of loop-block
								draw 3 of ((bubble particle) with an extra value of 0.03) with offset vector(0.15, 0.15, 0.15) at location of loop-block
								wait 1 tick
							if {_x} is alive:
								if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) = "Undulation":
									set {_heal} to {_heal}*1.15
								if {_tidalWaves} is set:
									tidalWavesSound(location of player)
									set {_tidalWavesBonus} to 1.3
									if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "High Tide":
										set {_tidalWavesBonus} to {_tidalWavesBonus}*1.4
									set {_heal} to {_heal}*{_tidalWavesBonus}^{_tidalWaves}
									if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Coalescing Tides":
										set {_coalescingTides} to true
									if boolean tag "Constellation;Wave Mastery" of (custom nbt of {karta::%player%}) is set:
										set {_cdbubble} to 20/{_pospiech}
										set {_cdredWaveMastery} to {_cdbubble}*0.0125
										remove ("%{_cdredWaveMastery}% seconds" parsed as timespan) from cooldown "Explosive Bubble%player%-%(uuid of {_x})%"
										remove 1.25 seconds from cooldown "Reversal%player%"
										loop all items in the inventory of player:
											if boolean tag "Reversal" of (custom nbt of (1 of loop-item)):
												set {_reversalRemainingCd} to cooldown "Reversal%player%"
												set the cooldown of loop-item for player to {_reversalRemainingCd}

								if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Tidewaters":
									Tidewaters(player, {_x}, {_heal})
								if metadata value "Undercurrent" of player > 0:
									set {_undercurrent} to metadata value "Undercurrent" of player
									set {_heal} to {_heal}*(1 + 0.08*{_undercurrent})
								play sound "skill.vaporeon_healingstream_hit" with volume 5 and pitch 1 at location of {_x}
								
								if boolean tag "ECMob" of (custom nbt of {_x}) is not set:
									Heal(player, {_x}, {_heal}, "Healing Stream", "<#7cafbf>", {_lore})
									if {_coalescingTides} is true:
										play sound "entity.generic.splash" with volume 3 and pitch 1 at location of {_x}
										set {_lore} to "&8Ability%nl%&f%{_charges}% Charges%nl%&fInstant cast%nl%&7Cooldown: &f%{_cd}%%nl%&7Use: &fRMB%nl%<#7cafbf>Sends a healing stream towards an ally.%nl%<#7cafbf>Upon reaching its target, the stream will%nl%<#7cafbf>restore &f%{_heal}*0.3% <#7cafbf>HP to the affected ally."
										set {_coalescingRadius} to 5
										coalescingTides(player, {_x}, {_coalescingRadius}, {_heal}, {_lore}, "heal")
										#RIVERSPLIT
									loop {_loreheart::*}:
										loop-value contains "Riversplit":
											add (5*{trait::Vaporeon::Riversplit::%player%}) to {_riversplit}
									if {_riversplit} is set:
										set {_heal} to ({_riversplit}/100)*{_heal}
										loop all living entities in radius 15 around {_x}:
											if boolean tag "ECMob" of (custom nbt of loop-entity) is not set:
												if loop-entity is a player:
													if loop-entity is not player:
														if loop-entity is not {_x}:
															set {_random} to loop-entity
										if {_random} is not set:
											loop all living entities in radius 15 around {_x}:
												if boolean tag "ECMob" of (custom nbt of loop-entity) is not set:
													if loop-entity is not a player:
														if loop-entity is not {_x}:
															set {_random} to loop-entity
										Overhealing(player, {_random}, {_heal}, "123")
										if {_heal} > ((max health of {_random}) - (health of {_random})):
											set {_heal} to ((max health of {_random}) - (health of {_random}))
											if {_heal} < 0:
												set {_heal} to 0
										if {_heal} > 0:
											heal {_random} by {_heal}
											HealAssist(player, {_random})
											HealRefresh(player, {_heal})
											if metadata value "DungeonInstance" of player is set:
												DungeonHeal(player, {_random}, {_heal}, "Healing Stream")
											if {_random} is a player:
												send formatted "%{kartacolor::%player%}%%player% &fhealed you. <tooltip:<#7cafbf>Healing Stream%nl%%{_lore}%>(<#baff8c>+%{_heal}% HP&f)" to {_random}
										if {_heal} > 0:
											set {healtotal::%player%} to {healtotal::%player%} + {_heal}
											set {healcard::%{kartaname::%player%}%::%{_id}%} to {healcard::%{kartaname::%player%}%::%{_id}%} + {_heal}
											set {healcard::%{kartaname::%player%}%::%{_id}%::Healing Stream} to {healcard::%{kartaname::%player%}%::%{_id}%::Healing Stream} + {_heal}
								else:
									set {_damage} to Crit(player, {_x}, {_crit}, {_heal})
									set {_lore} to "&8Ability%nl%&f%{_chargesLore}%%nl%&fInstant cast%nl%&7Cooldown: &f%{_cd}%%nl%&7Use: &fRMB%nl%<#7cafbf>Sends a healing stream towards an ally.%nl%<#7cafbf>Upon reaching its target, the stream will%nl%<#7cafbf>restore &f%{_damage}% <#7cafbf>HP to the affected ally."

									set {_x}'s last damage cause to sweep attack
									set metadata value "LastDamageCause" of {_x} to "<#7cafbf>Healing Stream"
									set metadata value "LastDamageCauseLore" of {_x} to {_lore}
									set metadata value "Element" of player to "Water"
									make player damage {_x} by {_damage}

									if {_coalescingTides} is true:
										play sound "entity.generic.splash" with volume 3 and pitch 1 at location of {_x}
										set {_lore} to "&8Ability%nl%&f%{_charges}% Charges%nl%&fInstant cast%nl%&7Cooldown: &f%{_cd}%%nl%&7Use: &fRMB%nl%<#7cafbf>Sends a healing stream towards an ally.%nl%<#7cafbf>Upon reaching its target, the stream will%nl%<#7cafbf>restore &f%{_damage}*0.3% <#7cafbf>HP to the affected ally."
										set {_coalescingRadius} to 5
										coalescingTides(player, {_x}, {_coalescingRadius}, {_damage}, {_lore}, "damage")
				else:
					if {tekstcd::%player%} = true:
						set {_charges} to metadata value "HealingStreamCharges" of player
						if {_charges} = 0:
							set {_cdd} to cooldown "Healing Stream%player%"
							send "<#7cafbf>You must wait &f%{_cdd}% <#7cafbf>to use this ability." to player
					stop
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player
	else if boolean tag "Explosive Bubble" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Vaporeon":
			if CanUseAbility(player) != false:
				if cooldown "Explosive Bubble%player%" is finished:
					if target of player is set:
						if player's target is a player:
							set {_target} to target of player
						else:
							set {_target} to player
					else:
						set {_target} to player
						
					ExplosiveBubble(player, {_target})
				else:
					cancel event
					if {tekstcd::%player%} = true:
						set {_cdd} to cooldown "Explosive Bubble%player%"
						send "<#7cafbf>You must wait &f%{_cdd}%<#7cafbf> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "Undertow" of (custom nbt of player's tool) is set:
		if {kartaname::%player%} = "Vaporeon":
			set {_target} to Target(player, 100, false)
			if {_target} is set:
				if CanUseAbility(player) != false:
					if cooldown "Global Cooldown Interrupted Cast%player%" is finished:
						if cooldown "Undertow%player%" is finished:
							set {_haste} to Haste(player)
							set {_baseCastTime} to 1.5
							set {_baseCd} to 3
							set {_casttime} to "%round(({_baseCastTime}/{_haste}), 1)% seconds" parsed as timespan
							set {_casttimeLore} to "%round(({_baseCastTime}/{_haste}), 1)% sec"

							if metadata value "cast" of player is not set:
								set metadata value "casttimemax" of player to {_casttime}
								play sound "skill.vaporeon_undertow_precast" with volume 3 and pitch 1 to player
								set metadata value "casting" of player to true
								if metadata value "channeling" of player is set:
									clear metadata value "channeling" of player
								set metadata value "cast" of player to {_casttime}
								while metadata value "casting" of player = true:
									if metadata value "cast" of player is not set:
										clear metadata value "casting" of player
										stop
									if {_casttime} > 0 seconds:
										set {_cst} to "%{_casttime}%"
										set metadata value "casttimeleft" of player to {_casttime}
										set {_message} to "Casting... %{_cst}%"
										send action bar {_message} to player
										wait 0.1 seconds
										remove 0.1 seconds from {_casttime}
									else:
										clear metadata value "casting" of player
										send action bar "" to player
							else:
								stop
							clear metadata value "casting" of player
							clear metadata value "cast" of player
							clear metadata value "casttimeleft" of player
							clear metadata value "casttimemax" of player
							stop sound "skill.vaporeon_undertow_precast" for player
							if {_casttime} > 0 seconds:
								send action bar "&cInterrupted" to player
								stop
						
							set {_cd} to "%{_baseCd}/{_haste}% seconds" parsed as timespan
							set {_cdLore} to "%{_baseCd}/{_haste}% sec"
							create cooldown "Undertow%player%" for {_cd}
							AbilityUse(player, "Undertow")
							play sound "skill.vaporeon_undertow_cast" with volume 3 and pitch 1 at (location of player)

							loop all items in the inventory of player:
								if boolean tag "Undertow" of (custom nbt of (1 of loop-item)):
									set the cooldown of loop-item for player to {_cd}
							
							set {_crit} to CriticalHit(player)
							set {_damage} to 1 + ({damage::%player%}/65) + (Versatility(player)/195) + {primarystat::%player%}/32.5
							set {_damage} to Crit(player, {_target}, {_crit}, {_damage})
							set {_lore} to "&8Basic Ability%nl%&f%{_casttimeLore}% cast%nl%&7Cooldown:  &f%{_cdLore}%%nl%&7Use: &fRMB%nl%<#7cafbf>Deal &f%{_damage}% <#1ebbd7>Water <#7cafbf>damage to the target."

							set {_target}'s last damage cause to sweep attack
							set metadata value "LastDamageCause" of {_target} to "<#7cafbf>Undertow"
							set metadata value "LastDamageCauseLore" of {_target} to {_lore}
							set metadata value "Element" of player to "Water"
							make player damage {_target} by {_damage}

							set {_shape} to a circle with radius 1
							set particle of {_shape} to rain particle
							draw shape {_shape} at {_target}

					else:
						if {tekstcd::%player%} = true:
							set {_cdd} to cooldown "Global Cooldown Interrupted Cast%player%"
							send "<#7cafbf>You must wait &f%{_cdd}%<#7cafbf>to use this ability." to player
						stop
	else if boolean tag "Reversal" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Vaporeon":
			if CanUseAbility(player) != false:
				set {_id} to cardId(player)
				set {_crit} to CriticalHit(player)
				set {_pospiech} to Haste(player)
				set {_cd} to "%300/{_pospiech}% seconds" parsed as timespan
				set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cd}%%nl%&7Use: &fRMB%nl%<#7cafbf>Reverses all <#ffef45> Shields <#7cafbf>to <#ae78d0> Healing <#7cafbf>in a huge%nl%<#7cafbf>radius around the player. &f <#8bbdf0>Reversal <#7cafbf>dispels all%nl%&fCurse<#7cafbf>, &fDisease<#7cafbf>, &fMagic <#7cafbf>and &fPoison <#7cafbf>debuffs from%nl%<#7cafbf>affected allies."
				LoreUpdate(player, "Reversal", {_lore})
				if cooldown "Reversal%player%" is finished:
					set the cooldown of player's held item for player to {_cd}
					create cooldown "Reversal%player%" for {_cd}
					AbilityUse(player, "Reversal")
					play sound "block.note_block.chime" with volume 5 and pitch 1 at (location of player)
					play sound "entity.elder_guardian.curse" with volume 5 and pitch 2 at (location of player)
					SixStar(player)
					play sound "entity.dragon_fireball.explode" with volume 5 and pitch 1.5 at (location of player)

					set {_oceanicUnisonHPStep} to 0.005
					set {_oceanicUnisonMasteryPerStep} to 1.5
					set {_oceanicUnisonDuration} to 10 seconds

					loop (all living entities in radius 100 around the player) where [getAllShieldsOnEntity(input) is set]:
						if loop-entity is alive:
							loop getAllShieldsOnEntity(loop-entity):
								set {_shield} to "%loop-value-2%" parsed as number
								set {_index} to loop-index parsed as integer
								shieldExpire(loop-entity, {_index})
							
							set {_heal} to {_shield}
							if metadata value "Undercurrent" of player > 0:
								set {_undercurrent} to metadata value "Undercurrent" of player
								set {_heal} to {_heal}*(1 + 0.08*{_undercurrent})

							if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Oceanic Unison":
								set {_heal} to {_heal}*2
							
							set {_HPBeforeHeal} to health of loop-entity
							Heal(player, loop-entity, {_heal}, "Reversal", "<#7cafbf>", {_lore})

							if loop-entity is a player:
								send action bar " " to loop-entity
								set {_percentMaxHealthHealed} to (health of loop-entity - {_HPBeforeHeal})/(max health of loop-entity)
								set {_percentMaxHealthHealedTotal} to {_percentMaxHealthHealedTotal} + ({_percentMaxHealthHealed}*100)
								if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Oceanic Unison":
									set {_bonusMastery} to ({_oceanicUnisonMasteryPerStep} * ({_percentMaxHealthHealed}/{_oceanicUnisonHPStep}))
									OceanicUnison(player, loop-entity, {_bonusMastery}, {_oceanicUnisonDuration})

								if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Turn of the Tide":
									ExplosiveBubble(player, loop-entity, true)

						clear {_heal}

					if boolean tag "Constellation;Riptide Refresh" of (custom nbt of {karta::%player%}) is set:
						if {_percentMaxHealthHealedTotal} > 0:
							if {_percentMaxHealthHealedTotal} > 120:
								set {_percentMaxHealthHealedTotal} to 120
							remove ("%{_percentMaxHealthHealedTotal}% seconds" parsed as timespan) from (cooldown "Reversal%player%")

							loop all items in the inventory of player:
								if boolean tag "Reversal" of (custom nbt of (1 of loop-item)):
									set the cooldown of loop-item for player to (cooldown "Reversal%player%")
				else:
					cancel event
					if {tekstcd::%player%} = true:
						set {_cdd} to cooldown "Reversal%player%"
						send "<#7cafbf>You must wait &f%{_cdd}%<#7cafbf> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

function HealingStreamRecharge(p: player, cd: timespan):
	wait {_cd}
	set {_charges} to metadata value "HealingStreamCharges" of {_p}
	add 1 to {_charges}
	set metadata value "HealingStreamCharges" of {_p} to {_charges}
	loop all items in the inventory of {_p}:
		if boolean tag "Healing Stream" of (custom nbt of (1 of loop-item)) is set:
			if {_charges} > 0:
				set item amount of loop-item to {_charges}
				if {_charges} = 1:
					set line 2 of lore of loop-item to "&f%{_charges}% Charge"
				else:
					set line 2 of lore of loop-item to "&f%{_charges}% Charges"
				reset item cooldown of loop-item for {_p}
				clear cooldown "Healing Stream%{_p}%"
			else:
				set line 2 of lore of loop-item to "&f%{_charges}% Charges"
			stop loop

function ExplosiveBubble(p: player, target: entity, turnOfTheTide: boolean = false):
	set {_id} to cardId({_p})
	set {_crit} to CriticalHit({_p})
	set {_pospiech} to Haste({_p})
	set {_cd} to "%1.5/{_pospiech}%"
	set {_cdtarget} to "%20/{_pospiech}%"

	set {_cdLore} to "%{_cd}% sec"
	set {_cdtargetLore} to "%{_cdtarget}% sec"

	set {_wait} to 8/{_pospiech}

	set {_versatility} to Versatility({_p})
	set {_shield} to 6 + ({utility::%{_p}%}/52) + ({_versatility}/156) + {primarystat::%{_p}%}/26
	set {_damage} to 1 + ({damage::%{_p}%}/60) + ({_versatility}/180) + {primarystat::%{_p}%}/30
	
	if {_target} is set:
		set {_uuid} to uuid of {_target}
		if {_turnOfTheTide} != true:
			if cooldown "Explosive Bubble%{_p}%-%{_uuid}%" is finished:
				create cooldown "Explosive Bubble%{_p}%" for ("%{_cd}% seconds" parsed as timespan)
				create cooldown "Explosive Bubble%{_p}%-%{_uuid}%" for ("%{_cdtarget}% seconds" parsed as timespan)
			else:
				if {tekstcd::%{_p}%} = true:
					set {_cdd} to cooldown "Explosive Bubble%{_p}%-%{_uuid}%"
					send "<#7cafbf>You must wait &f%{_cdd}%<#7cafbf> to use this ability on that target." to {_p}
				stop

		AbilityUse({_p}, "Explosive Bubble")
		if string tag "Talents;Row 1" of (custom nbt of {karta::%{_p}%}) = "Undercurrent":
			set {_undercurrent} to metadata value "Undercurrent" of {_p}
			add 1 to {_undercurrent}
			set metadata value "Undercurrent" of {_p} to {_undercurrent}


		if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) is set:
			send title " " with subtitle "" to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
			set {_tidalWaves} to metadata value "TidalWaves" of {_p}
			if {_tidalWaves} is not set:
				set {_tidalWaves} to 0
			if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Coalescing Tides":
				set {_tidalWavesMax} to 4
			else:
				set {_tidalWavesMax} to 2
			if {_tidalWaves} < {_tidalWavesMax}:
				add 1 to {_tidalWaves}
			set metadata value "TidalWaves" of {_p} to {_tidalWaves}
			play sound "skill.vaporeon_tidalwaves" with volume 3 and pitch 1 to {_p}

		set {_lore} to  "&8Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdLore}% | %{_cdtargetLore}% per target%nl%&7Use: &fRMB%nl%<#7cafbf>Wraps an ally in an explosive bubble, which%nl%<#7cafbf>absorbs &f%{_shield}% <#7cafbf>damage. <#7cafbf>After &f%{_wait}% sec<#7cafbf>, the bubble%nl%<#7cafbf>explodes, <#7cafbf>dealing &f%{_damage}% + (remaining shield value)%nl%<#7cafbf>as <#1ebbd7>Water <#7cafbf>damage to nearby enemies.%nl% %nl%<#7cafbf>When <#7cafbf>Explosive Bubble <#7cafbf>is reapplied, the shield%nl%<#7cafbf>amount will be added to the existing shield,%nl%<#7cafbf>but the duration will not be refreshed."
		loop all items in the inventory of {_p}:
			if boolean tag "Explosive Bubble" of (custom nbt of (1 of loop-item)):
				if cooldown "Explosive Bubble%{_p}%-%{_uuid}%" is not finished:
					set the cooldown of loop-item for {_p} to ("%{_cd}% seconds" parsed as timespan)
				set lore of loop-item to {_lore}	

		set {_shieldNumber} to Shield({_p}, {_target}, {_shield} + 0.00, "Explosive Bubble", "<#7cafbf>", {_lore}, 0, true, true)
		set {_shieldID} to findShieldID({_target}, {_shieldNumber})
		play sound "block.bubble_column.whirlpool_inside" with volume 3 and pitch 1 at location of {_target}
		set {_waitTime} to ("%{_wait}% seconds" parsed as timespan)
		explosiveBubbleParticles({_p}, {_target}, {_waitTime})

		if {_turnOfTheTide} = true:
			set {_resistanceIncrease} to 90
			set {bonusResistance::%{_target}%} to {bonusResistance::%{_target}%} + {_resistanceIncrease}
		
		wait {_waitTime}

		#HEAVY BUBBLES
		loop {_loreheart::*}:
			loop-value contains "Heavy Bubbles":
				add (0.15*{trait::Vaporeon::Heavy Bubbles::%{_p}%}) to {_heavybubbles}

		if yaml value "Shields.%{_shieldNumber}%" in "Shields%uuid of {_target}%" is set:
			if yaml value "Shields.%{_shieldNumber}%.ID" in "Shields%uuid of {_target}%" = {_shieldID}:
				play sound "entity.dragon_fireball.explode" with volume 3 and pitch 1 at location of {_target}
				set {_shieldTarget} to yaml value "Shields.%{_shieldNumber}%.Amount" in "Shields%uuid of {_target}%"
				loop all living entities in radius 10 around {_target}:
					if boolean tag "ECMob" of (custom nbt of loop-entity) is set:
						set {_versatility} to Versatility({_p})
						set {_damage} to 1 + ({damage::%{_p}%}/60) + ({_versatility}/180) + {primarystat::%{_p}%}/30

						set {_damage} to Crit({_p}, loop-entity, {_crit}, {_damage})

						if {_heavybubbles} is true:
							set {_dmg} to (({_shieldTarget} + {_damage}) + ({_shieldTarget}*{_heavybubbles}))
						else:
							set {_dmg} to ({_shieldTarget} + {_damage})
						set loop-entity's last damage cause to sweep attack
						set metadata value "LastDamageCause" of loop-entity to "<#7cafbf>Explosive Bubble"
						set metadata value "LastDamageCauseLore" of loop-entity to {_lore}
						set metadata value "Element" of {_p} to "Water"
						make {_p} damage loop-entity by {_dmg}

						play sound "entity.player.hurt" with volume 3 and pitch 1 at loop-entity
				shieldExpire({_target}, {_shieldNumber})
				send action bar " " to {_target}
				
				if string tag "Talents;Row 1" of (custom nbt of {karta::%{_p}%}) = "Undercurrent":
					set {_undercurrent} to metadata value "Undercurrent" of {_p}
					remove 1 from {_undercurrent}
					set metadata value "Undercurrent" of {_p} to {_undercurrent}

		if {_resistanceIncrease} is set:
			set {bonusResistance::%{_target}%} to {bonusResistance::%{_target}%} - {_resistanceIncrease}

		if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Downpour":
			set {_downpour} to {_shieldTarget}*0.55

			set {_lore} to "<#7cafbf>When an Explosive Bubble detonates, a%nl%<#7cafbf>healing rain is summoned above the target,%nl%<#7cafbf>restoring &f25%% <#7cafbf>of the remaining shield value%nl%<#7cafbf>as HP to the ally."
			Heal({_p}, {_target}, {_downpour}, "Downpour", "<#7cafbf>", {_lore})
			
			draw 20 of (((cloud particle) with an extra value of 0.02) with offset vector(0.05, 0.01, 0.05)) at (location 3 above {_target})
			draw 20 of (((rain particle) with an extra value of 0.02) with offset vector(0.05, 0.01, 0.05)) at (location 2 above {_target})
			draw 30 of (((dripping water particle) with an extra value of 0.1) with offset vector(0.4, 0.05, 0.4)) at (location 2.5 above {_target})

function isCastableVaporeon(p: player) :: boolean:
    if metadata value "HealingStreamCharges" of {_p} > 0:
        set {_castable} to true
    if {_castable} is not set:
        set {_castable} to false
    return {_castable}
						
function CircleOfWater(e: entity, p: player):
	while metadata value "CircleOfWater%{_p}%" of {_e} is true:
		if {_e} is alive:
			set {_y} to 0
			loop 45 times:
				set {_x} to {_e}'s location
				increase {_x}'s y-coordinate by 1
				set {_v} to vector 1, 0, 1
				rotate {_v} around y-axis by {_y}
				add 8 to {_y}
				draw 1 of (blue dust particle of size 1) at location of {_x} ~ {_v}
				draw 1 of (rain particle) with offset vector(0.5, 0, 0.5) at location of {_x} ~ {_v}
				draw 1 of (dripstone dripping water particle) at location of {_x} ~ {_v}
				stop loop if metadata value "CircleOfWater%{_p}%" of {_e} is not true
				wait 1 tick
		else:
			stop loop

function Tidewaters(p: player, x: entity, heal: number):
	set {_haste} to Haste({_p})
	set {_cd} to "%3/{_haste}% seconds" parsed as timespan
	set {_healValue} to {_heal}*0.35
	wait {_cd}
	play sound "skill.vaporeon_healingstream_cast" with volume 3 and pitch 1.8 at {_p}
	loop blocks between {_p} and {_x}:
		draw 2 of (((rgb 47, 69, 235) dust particle of size 1) with an extra value of 0.01) with offset vector(0.05, 0.05, 0.05) at location of loop-block
		draw 2 of ((bubble particle) with an extra value of 0.03) with offset vector(0.15, 0.15, 0.15) at location of loop-block
		wait 1 tick
	if {_x} is alive:
		play sound "skill.vaporeon_healingstream_hit" with volume 5 and pitch 1.8 at location of {_x}
		set {_lore} to "&8Talent%nl%&fInstant cast%nl%&7Cooldown: &fnone%nl%&7Use: &fPassive%nl%<#7cafbf>Healing Stream sends a second stream of%nl%<#7cafbf>revitalising waters at the affected ally after%nl%&f%{_cd}%<#7cafbf>, reduced by <#19943e> Haste<#7cafbf>. The second%nl%<#7cafbf>stream restores &f35%% <#7cafbf>of the initial value as HP%nl%<#7cafbf>to the ally."
		if boolean tag "ECMob" of (custom nbt of {_x}) is not set:
			Heal({_p}, {_x}, {_healValue}, "Tidewaters", "<#7cafbf>", {_lore})
		else:
			set {_x}'s last damage cause to sweep attack
			set metadata value "LastDamageCause" of {_x} to "<#7cafbf>Tidewaters"
			set metadata value "LastDamageCauseLore" of {_x} to {_lore}
			set metadata value "Element" of {_p} to "Water"
			make {_p} damage {_x} by {_healValue}

function CircleOfWaterApply(p: player, x: entity, ability: string):
	if metadata value "CircleOfWater%{_p}%" of {_x} is not set:
		if {_ability} != "Circle of Water":
			set metadata value "CircleOfWater%{_p}%" of {_x} to true
			CircleOfWater({_x}, {_p})
	else:
		if {_ability} = "Healing Stream":
			CircleOfWaterDetonate({_p}, {_x})
		else:
			if boolean tag "Constellation;Water of Life" of (custom nbt of {karta::%{_p}%}) is set:
				if {_ability} != "Circle of Water":
					CircleOfWaterDetonate({_p}, {_x}, 0.5)
		
function CircleOfWaterDetonate(p: player, x: entity, effectiveness: number = 1):
	set {_versatility} to Versatility({_p})
	set {_healcircle} to 0.8 + ({utility::%{_p}%}/100) + ({_versatility}/300) + ({primarystat::%{_p}%}/50)

	set {_crit} to CriticalHit({_p})

	clear metadata value "CircleOfWater%{_p}%" of {_x}

	set {_healcircle} to {_healcircle} * {_effectiveness}

	if metadata value "Undercurrent" of {_p} > 0:
		set {_undercurrent} to metadata value "Undercurrent" of {_p}
		set {_healcircle} to {_healcircle}*(1 + 0.08*{_undercurrent})

	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Watercycles":
		set {_healcircle} to {_healcircle}*1.4
		set {_versatilityGain} to 30
		Watercycles({_p}, {_versatilityGain}, 4 seconds)

	set {_lore} to "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown: &fnone%nl%&7Use: &fPassive%nl%<#7cafbf>Healing surrounds your target with a%nl%<#8bbdf0>Circle of Water<#7cafbf>. <#7cafbf>Using <#8bbdf0>Healing Stream <#7cafbf>on%nl%<#7cafbf>an ally affected by <#8bbdf0>Circle of Water <#7cafbf>will%nl%<#7cafbf>detonate the circle, healing its target%nl%<#7cafbf>by an additional &f%{_healcircle}% <#7cafbf>HP." 
	Heal({_p}, {_x}, {_healcircle}, "Circle of Water", "<#7cafbf>", {_lore})
	play sound "entity.player.splash.high_speed" with volume 3 and pitch 1 at location of {_x}
	draw 3 of (heart particle) with offset vector(0.6, 0.9, 0.6) at location 0.5 above {_x}
	
function SyncCardHealingYaml(p: player, spell: text, amount: number):
	if {_amount} <= 0:
		stop
	if yaml "activeCard-%{_p}%" is loaded:
		set {_totalHealing} to yaml value "Combat Data.Total Healing Done" in "activeCard-%{_p}%"
		if {_totalHealing} is not set:
			set {_totalHealing} to 0
		add {_amount} to {_totalHealing}
		set yaml value "Combat Data.Total Healing Done" in "activeCard-%{_p}%" to {_totalHealing}
		set {_spellHealing} to yaml value "Combat Data.By Source.%{_spell}%.Healing Done" in "activeCard-%{_p}%"
		if {_spellHealing} is not set:
			set {_spellHealing} to 0
		add {_amount} to {_spellHealing}
		set yaml value "Combat Data.By Source.%{_spell}%.Healing Done" in "activeCard-%{_p}%" to {_spellHealing}
		save yaml "activeCard-%{_p}%"

function SyncCardShieldYaml(p: player, spell: text, amount: number):
	if {_amount} <= 0:
		stop
	if yaml "activeCard-%{_p}%" is loaded:
		set {_totalShielded} to yaml value "Combat Data.Total Damage Shielded" in "activeCard-%{_p}%"
		if {_totalShielded} is not set:
			set {_totalShielded} to 0
		add {_amount} to {_totalShielded}
		set yaml value "Combat Data.Total Damage Shielded" in "activeCard-%{_p}%" to {_totalShielded}
		set {_spellShielded} to yaml value "Combat Data.By Source.%{_spell}%.Damage Shielded" in "activeCard-%{_p}%"
		if {_spellShielded} is not set:
			set {_spellShielded} to 0
		add {_amount} to {_spellShielded}
		set yaml value "Combat Data.By Source.%{_spell}%.Damage Shielded" in "activeCard-%{_p}%" to {_spellShielded}
		save yaml "activeCard-%{_p}%"
	SyncCardHealingYaml({_p}, {_spell}, {_amount})

function Heal(p: player, x: entity, heal: number, spell: text, col: text, lore: text, sendMessage: boolean = true):
	if {_x} is alive:
		set {_id} to cardId({_p})
		
		set {_heal} to cardHealModifiers({_p}, {_x}, {_heal}, {_spell})
		set {_healBeforeOverheal} to {_heal}

		Overhealing({_p}, {_x}, {_heal}, {_spell})
		if {_heal} > ((max health of {_x}) - (health of {_x})):
			healAboveMaxHealth({_p}, {_x}, ((max health of {_x}) - (health of {_x})-{_heal}))
			set {_heal} to ((max health of {_x}) - (health of {_x}))
			if {_heal} < 0:
				set {_heal} to 0

		heal {_x} by {_heal}
		HealAssist({_p}, {_x})
		HealRefresh({_p}, {_heal})
		if metadata value "DungeonInstance" of {_p} is set:
			DungeonHeal({_p}, {_x}, {_heal}, "%{_spell}%")

		onAnyHealEvent({_p}, {_x}, {_spell}, {_heal}, {_healBeforeOverheal})

		if {_heal} > 0.0001:
			onHealEvents({_p}, {_x}, {_spell}, {_heal})
			if {_x} is a player:
				if {_sendMessage} != false:
					send formatted "%{kartacolor::%{_p}%}%%{_p}% &fhealed you. <tooltip:%{_col}%%{_spell}%%nl%%{_lore}%>(<#baff8c>+%{_heal}% HP&f)" to {_x}
					if {_p} != {_x}:
						send formatted "&fYou healed %{kartacolor::%{_p}%}%%{_x}%&f. <tooltip:%{_col}%%{_spell}%%nl%%{_lore}%>(<#baff8c>+%{_heal}% HP&f)" to {_p}
			set {healtotal::%{_p}%} to {healtotal::%{_p}%} + {_heal}
			set {healcard::%{kartaname::%{_p}%}%::%{_id}%} to {healcard::%{kartaname::%{_p}%}%::%{_id}%} + {_heal}
			set {healcard::%{kartaname::%{_p}%}%::%{_id}%::%{_spell}%} to {healcard::%{kartaname::%{_p}%}%::%{_id}%::%{_spell}%} + {_heal}
			SyncCardHealingYaml({_p}, {_spell}, {_heal})

function cardHealModifiers(p: player, x: entity, heal: number, spell: text) :: number:
	set {_healBeforeModifiers} to {_heal}
	set {_nbt} to (custom nbt of {karta::%{_p}%})

	if {kartaname::%{_p}%} = "Vaporeon":

		set {_masteryScaling} to 370
		if string tag "Talents;Row 3" of {_nbt} = "Overflow":
			set {_masteryScaling} to {_masteryScaling}/1.2

		set {_mastery} to 1.1 + (Mastery({_p})/{_masteryScaling})
		
		if all:
			{_spell} = "Circle of Water"
			string tag "Talents;Row 3" of {_nbt} = "Overflow"
		then:
			set {_heal} to {_heal}*{_mastery}

		else if health of {_x} < (0.5*max health of {_x}):
			set {_heal} to {_heal}*{_mastery}

		if boolean tag "Constellation;Water of Life" of {_nbt} is set:
			set {_heal} to {_heal}*1.2

		if boolean tag "Constellation;Deluge" of (custom nbt of {karta::%{_p}%}) is set:
			if shieldFind({_p}, {_x}, "Explosive Bubble", true) is set:
				set {_heal} to {_heal}*1.12

	set {_critChance} to CriticalHit({_p})
	set {_critModifier} to 2
	
	chance of {_critChance}%:
		set {_heal} to {_heal}*{_critModifier}
		set {_crit} to true

		if {kartaname::%{_p}%} = "Vaporeon":
			if {_spell} = "Circle of Water":
				if string tag "Talents;Row 1" of {_nbt} = "Flow of the Tides":
					set {_heal} to {_heal} + {_heal}*1.3

				if string tag "Talents;Row 4" of {_nbt} = "Searage":
					chance of 30%:
						set metadata value "SearageReapply%{_p}%" of {_x} to true
						play sound "ambient.underwater.exit" with volume 2.5 and pitch 2 at location of {_x}

	set {_healModifier} to {_heal}/{_healBeforeModifiers}

	healText({_p}, {_x}, {_heal}, {_crit}, {_healModifier})

	return {_heal}

function onHealEvents(p: player, e: entity, spell: string, heal: number): #applies on successful heal
	if {kartaname::%{_p}%} = "Vaporeon":
		if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Current Control":
			set {_haste} to Haste({_p})
			set {_cd} to (20/{_haste})*0.025
			set {_uuid} to uuid of {_e}
			if cooldown "Explosive Bubble%{_p}%-%{_uuid}%" is set:

				remove ("%{_cd}% seconds" parsed as timespan) from cooldown "Explosive Bubble%{_p}%-%{_uuid}%"

function onAnyHealEvent(p: player, e: entity, spell: string, heal: number, healBeforeOverheal: number): #applies on any heal, even at value 0
	if {kartaname::%{_p}%} = "Vaporeon":
		CircleOfWaterApply({_p}, {_e}, {_spell})

		if {_spell} = "Circle of Water":

			if metadata value "SearageReapply%{_p}%" of {_e} is set:
				clear metadata value "SearageReapply%{_p}%" of {_e}
				CircleOfWaterApply({_p}, {_e}, "Searage")
				play sound "ambient.underwater.exit" with volume 2.5 and pitch 2 at location of {_e}

			if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Searage":
				loop LoopEntitiesAroundTarget({_e}, 6, false):
					set loop-entity's last damage cause to sweep attack
					set metadata value "LastDamageCause" of loop-entity to "<#7cafbf>Circle of Water"
					set metadata value "LastDamageCauseLore" of loop-entity to {_lore}
					set metadata value "Element" of {_p} to "Water"
					make {_p} damage loop-entity by {_healBeforeOverheal}
					draw 15 of (((bubble pop particle) with an extra value of 0.03) with offset vector(0.6, 0.45, 0.6)) at (location above loop-entity)

function cardShieldModifiers(p: player, x: entity, shield: number, spell: string) :: number:
	set {_shieldBeforeModifiers} to {_shield}

	if {kartaname::%{_p}%} = "Vaporeon":

		set {_masteryScaling} to 370
		if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Overflow":
			set {_masteryScaling} to {_masteryScaling}/1.2
		set {_mastery} to 1.1 + (Mastery({_p})/{_masteryScaling})

		if health of {_x} > (0.5*max health of {_x}):
			set {_shield} to {_shield}*{_mastery}

	set {_critChance} to CriticalHit({_p})
	set {_critModifier} to CritHealing({_p})
	
	chance of {_critChance}%:
		set {_shield} to {_shield}*{_critModifier}
		set {_crit} to true

	set {_shieldModifier} to {_shield}/{_shieldBeforeModifiers}

	shieldText({_p}, {_x}, {_shield}, {_crit}, {_shieldModifier})

	return {_shield}

function selfHealModifiers(p: entity, heal: number) :: number:
	if {kartaname::%{_p}%} = "Brother Therold":
		if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Body and Soul":
			set {_heal} to {_heal}*1.06
	return {_heal}

function healAboveMaxHealth(p: player, x: entity, heal: number):
	if {_heal} < 0:
		set {_heal} to {_heal}*-1
	if {_p} = {_x}:
		if {kartaname::%{_p}%} = "Brother Therold":
			if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Mental Fortitude":
				set {_mentalFortitude} to ({_p}'s max health/4.25)-3 + {primarystat::%{_p}%}/8.75
				set {_lore} to "&8Talent%nl%&fInstant cast%nl%&7Cooldown: &fnone%nl%&7Use: &fPassive%nl%<#613e82>Healing from Vampiric Touch when you are at%nl%<#613e82>maximum health will shield you for the same%nl%<#613e82>amount. Shield cannot exceed &f%{_mentalFortitude}% <#613e82>damage%nl%<#613e82>absorbed."
				Shield({_p}, {_x}, {_heal} + 0.00, "Mental Fortitude", "<#613e82>", {_lore}, {_mentalFortitude}, false, true)
				if yaml value "ShieldsActive" in "Shields%uuid of {_x}%" > 0:
					set {_shieldsActive} to yaml value "ShieldsActive" in "Shields%uuid of {_x}%"
					loop {_shieldsActive} times:
						if yaml "Shields%uuid of {_x}%" is not loaded:
							load yaml "plugins/Skript/combat/Shields/%uuid of {_x}%" as "Shields%uuid of {_x}%"
						if yaml value "Shields.%loop-number%.Name" in "Shields%uuid of {_x}%" = "Mental Fortitude":
							set {_shieldTotal} to yaml value "Shields.%loop-number%.Amount" in "Shields%uuid of {_x}%"
							stop loop
					buffRegister({_p}, "Mental", 3, "", "Value", " %{_shieldTotal}%", "-")

function Shield(p: player, x: entity, shield: number, spell: text, col: text, lore: text, maxShield: number, sendMessage: boolean, sendActionBar: boolean) :: integer:
	if {_x} is alive:
		HealAssist({_p}, {_x})
		HealRefresh({_p}, 0)
		if {_x} != {_p}:
			if {_x} is a player:
				HealRefresh({_x}, 0)
		
				
		set {_existingShield} to metadata value "ShieldTotal" of {_x}
		if yaml "Shields%uuid of {_x}%" is not loaded:
			load yaml "plugins/Skript/combat/Shields/%uuid of {_x}%" as "Shields%uuid of {_x}%"

		set {_shieldsActive} to yaml value "ShieldsActive" in "Shields%uuid of {_x}%"

		set {_shield} to cardShieldModifiers({_p}, {_x}, {_shield}, {_spell})

		loop {_shieldsActive} times:
			if yaml value "Shields.%loop-number%.Caster" in "Shields%uuid of {_x}%" = {_p}:
				if yaml value "Shields.%loop-number%.Name" in "Shields%uuid of {_x}%" = {_spell}:
					set {_shieldAlreadyActive} to true
					set {_amount} to yaml value "Shields.%loop-number%.Amount" in "Shields%uuid of {_x}%"
					if {_maxShield} > 0:
						if {_amount} + {_shield} > {_maxShield}:
							set {_shield} to {_maxShield} - {_amount}
						if {_shield} < 0:
							set {_shield} to 0
					add {_shield} to {_amount}
					add {_shield} to {_existingShield}
					set metadata value "ShieldTotal" of {_x} to {_existingShield}
					set yaml value "Shields.%loop-number%.Amount" in "Shields%uuid of {_x}%" to {_amount}
					stop loop

		if {_shieldAlreadyActive} != true:
			add 1 to {_shieldsActive}
			set yaml value "Shields.%{_shieldsActive}%.Name" in "Shields%uuid of {_x}%" to {_spell}
			set yaml value "Shields.%{_shieldsActive}%.Caster" in "Shields%uuid of {_x}%" to {_p}
			set yaml value "Shields.%{_shieldsActive}%.Amount" in "Shields%uuid of {_x}%" to {_shield}
			set yaml value "Shields.%{_shieldsActive}%.ID" in "Shields%uuid of {_x}%" to (random 8 char string from charset `0-9` `a-z`)
			set metadata value "ShieldTotal" of {_x} to {_shield}

		set yaml value "ShieldsActive" in "Shields%uuid of {_x}%" to {_shieldsActive}
		if metadata value "ShieldTotal" of {_x} < 0:
			set metadata value "ShieldTotal" of {_x} to 0

		set {_shieldTotal} to metadata value "ShieldTotal" of {_x}

		if {_x} is a player:
			if {_sendMessage} != false:
				send formatted "%{kartacolor::%{_p}%}%%{_p}% &fshielded you. <tooltip:%{_col}%%{_spell}%%nl%%{_lore}%>(<#baff8c>+%{_shield}% Shield&f)" to {_x}
			if {_sendActionBar} != false:
				send action bar "%{kartacolor::%{_p}%}% Shield: &f%{_shieldTotal}%" to {_x}
		save yaml "Shields%uuid of {_x}%"
	return {_shieldsActive}

function shieldFind(p: entity, x: entity, shield: text, global: boolean = false) :: integer:
	if yaml "Shields%uuid of {_x}%" is not loaded:
		load yaml "plugins/Skript/combat/Shields/%uuid of {_x}%" as "Shields%uuid of {_x}%"
		
	set {_shieldsActive} to yaml value "ShieldsActive" in "Shields%uuid of {_x}%"

	loop {_shieldsActive} times:
		if yaml value "Shields.%loop-number%.Name" in "Shields%uuid of {_x}%" = {_shield}:
			if {_global} = true:
				set {_num} to {_shieldsActive}
				stop loop
			else:
				if yaml value "Shields.%loop-number%.Caster" in "Shields%uuid of {_x}%" = {_p}:
					set {_num} to {_shieldsActive}
					stop loop
	return {_num}

function findShieldID(x: entity, num: integer) :: string:
	if yaml "Shields%uuid of {_x}%" is not loaded:
		load yaml "plugins/Skript/combat/Shields/%uuid of {_x}%" as "Shields%uuid of {_x}%"

	set {_id} to yaml value "Shields.%{_num}%.ID" in "Shields%uuid of {_x}%"
	return {_id}
	

function getAllShieldsOnEntity(x: entity) :: numbers:
	if yaml "Shields%uuid of {_x}%" is not loaded:
		load yaml "plugins/Skript/combat/Shields/%uuid of {_x}%" as "Shields%uuid of {_x}%"
	
	loop yaml node keys "Shields" in "Shields%uuid of {_x}%":
		set {_shieldAmount} to yaml value "Shields.%loop-value%.Amount" in "Shields%uuid of {_x}%"
		set {_shields::%loop-value%} to {_shieldAmount}

	return {_shields::*}

function shieldExpire(x: entity, num: integer):
	if yaml "Shields%uuid of {_x}%" is not loaded:
		load yaml "plugins/Skript/combat/Shields/%uuid of {_x}%" as "Shields%uuid of {_x}%"

	set {_amount} to yaml value "Shields.%{_num}%.Amount" in "Shields%uuid of {_x}%"
	clear yaml value "Shields.%{_num}%" in "Shields%uuid of {_x}%"
	set {_shieldsActive} to yaml value "ShieldsActive" in "Shields%uuid of {_x}%"
	remove 1 from {_shieldsActive}
	set yaml value "ShieldsActive" in "Shields%uuid of {_x}%" to {_shieldsActive}
	set {_totalShields} to metadata value "ShieldTotal" of {_x}
	remove {_amount} from {_totalShields}
	set metadata value "ShieldTotal" of {_x} to {_totalShields}
	save yaml "Shields%uuid of {_x}%"

function shieldsClear(x: entity):
	if yaml "Shields%uuid of {_x}%" is loaded:
		set {_amount} to yaml value "ShieldsActive" in "Shields%uuid of {_x}%"
		loop {_amount} times:
			if yaml value "Shield.%loop-number%.Name" in "Shields%uuid of {_x}%" is set:
				clear yaml value "Shields.%loop-number%.Amount" in "Shields%uuid of {_x}%"
				clear yaml value "Shields.%loop-number%.Name" in "Shields%uuid of {_x}%"
				clear yaml value "Shields.%loop-number%.Caster" in "Shields%uuid of {_x}%"
				clear yaml value "Shields.%loop-number%.ID" in "Shields%uuid of {_x}%"
				clear yaml value "Shields.%loop-number%" in "Shields%uuid of {_x}%"
		save yaml "Shields%uuid of {_x}%"
	clear metadata value "ShieldTotal" of {_x}

function shieldDamageEvent(x: entity, dmg: number) :: number:
	if yaml "Shields%uuid of {_x}%" is not loaded:
		load yaml "plugins/Skript/combat/Shields/%uuid of {_x}%" as "Shields%uuid of {_x}%"

	set {_shieldsActive} to yaml value "ShieldsActive" in "Shields%uuid of {_x}%"

	set {_num} to 1
	while {_oldestShield} is not set:
		if yaml value "Shields.%{_num}%.Amount" in "Shields%uuid of {_x}%" is set:
			set {_oldestShield} to {_num}
			set {_shieldCaster} to (yaml value "Shields.%{_num}%.Caster" in "Shields%uuid of {_x}%")
			set {_shieldAmount} to (yaml value "Shields.%{_num}%.Amount" in "Shields%uuid of {_x}%")
			set {_shieldName} to (yaml value "Shields.%{_num}%.Name" in "Shields%uuid of {_x}%")
		add 1 to {_num}
	if ({_shieldAmount}-{_dmg}) > 0:
		set {_shieldTotal} to metadata value "ShieldTotal" of {_x}
		set {_shieldTotal} to {_shieldTotal} - {_dmg}
		set metadata value "ShieldTotal" of {_x} to {_shieldTotal}
		if {_shieldCaster} is a player:
			set {_id} to cardId({_shieldCaster})
			set {healtotal::%{_shieldCaster}%} to {healtotal::%{_shieldCaster}%} + {_dmg}
			set {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} to {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} + {_dmg}
			set {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} to {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} + {_dmg}
			set {shieldtotal::%{_shieldCaster}%} to {shieldtotal::%{_shieldCaster}%} + {_dmg}
			set {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} to {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} + {_dmg}
			set {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} to {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} + {_dmg}
			SyncCardShieldYaml({_shieldCaster}, {_shieldName}, {_dmg})
			HealAssist({_shieldCaster}, {_x})
			HealRefresh({_shieldCaster}, {_dmg})
		remove {_dmg} from {_shieldAmount}
		set yaml value "Shields.%{_oldestShield}%.Amount" in "Shields%uuid of {_x}%" to {_shieldAmount}
		if metadata value "DungeonInstance" of {_x} is set:
			DungeonShield({_shieldCaster}, {_x}, {_dmg}, {_shieldName})
		set {_dmg} to 0
	else:
		set {_dmg} to {_dmg}-{_shieldAmount}
		if {_shieldCaster} is a player:
			set {_id} to cardId({_shieldCaster})
			set {healtotal::%{_shieldCaster}%} to {healtotal::%{_shieldCaster}%} + {_shieldAmount}
			set {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} to {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} + {_shieldAmount}
			set {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} to {healcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} + {_shieldAmount}
			set {shieldtotal::%{_shieldCaster}%} to {shieldtotal::%{_shieldCaster}%} + {_shieldAmount}
			set {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} to {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%} + {_shieldAmount}
			set {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} to {shieldcard::%{kartaname::%{_shieldCaster}%}%::%{_id}%::%{_shieldName}%} + {_shieldAmount}
			SyncCardShieldYaml({_shieldCaster}, {_shieldName}, {_shieldAmount})
			HealAssist({_shieldCaster}, {_x})
			HealRefresh({_shieldCaster}, {_shieldAmount})
		if metadata value "DungeonInstance" of {_x} is set:
			DungeonShield({_shieldCaster}, {_x}, {_shieldAmount}, {_shieldName})
		set metadata value "ShieldTotal" of {_x} to 0
		shieldExpire({_x}, {_oldestShield})
	if metadata value "ShieldTotal" of {_x} > 0:
		set {_shield} to metadata value "ShieldTotal" of {_x}
		send action bar "%{kartacolor::%{_x}%}% SHIELD: &f%{_shield}%" to {_x}
		play sound "item.shield.block" with volume 3 and pitch 0.5 to {_x}
	else:
		send action bar "%{kartacolor::%{_x}%}% &fSHIELD BROKEN" to {_x}
		play sound "item.shield.break" with volume 3 and pitch 1 to {_x}
	if {_dmg} is not set:
		set {_dmg} to 0
	save yaml "Shields%uuid of {_x}%"
	return {_dmg}

function explosiveBubbleParticles(p: player, e: entity, wait: timespan):
	while shieldFind({_p}, {_e}, "Explosive Bubble") > 0:
		set {_shape} to a sphere with radius 2
		set particle of {_shape} to bubble particle
		draw shape {_shape} at {_e}

		set {_shape} to a sphere with radius 2
		set particle of {_shape} to splash particle
		draw shape {_shape} at {_e}
		wait 0.65 seconds
	set {_shape} to a sphere with radius 2
	set particle of {_shape} to cloud particle
	draw shape {_shape} at {_e}

function TargetHealingStream(p: player, length: number, passThrough: boolean) :: entity:
	set {_x} to 0
	set {_l} to 0
	loop {_length} times:
		add 1 to {_x}
		add 0.25 to {_l}
		set {_rg%{_x}%} to location {_l} meters infront of {_p}
		set {_rg%{_x}%} to location 1.25 meters above {_rg%{_x}%}
	set {_x} to 0
	loop {_length} times:
		add 1 to {_x}
		loop entities in radius 1 around {_rg%{_x}%}:
			if loop-entity is not {_p}:
				if loop-entity is not an armor stand:
					if loop-entity is a living entity:
						if loop-entity is not an arrow:
							if loop-entity is alive:
								if boolean tag "ECMob" of (custom nbt of loop-entity) is not set:
									set {_entity} to loop-entity
									return {_entity}
								else:
									if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Tidebringer":
										set {_entity} to loop-entity
										return {_entity}
		if {_entity} is not set:
			set {_entity} to {_p}

	return {_entity}

function coalescingTides(p: player, x: entity, radius: number, heal: number, lore: string, type: string):
	set {_heal} to {_heal}*0.3
	if {_type} = "heal":
		set {_allies::*} to loopAlliesAroundTarget({_x}, {_radius}, false)
		if size of {_allies::*} > 0:
			loop {_allies::*}:
				draw 15 of ((rain particle) with an extra value of 0.03) with offset vector(0.5, 0.5, 0.5) at (location above loop-value)
				Heal({_p}, loop-value, {_heal}*0.3, "Healing Stream", "<#7cafbf>", {_lore})
		else:
			draw 15 of ((rain particle) with an extra value of 0.03) with offset vector(0.5, 0.5, 0.5) at (location above {_x})
			Heal({_p}, {_x}, {_heal}*0.3, "Healing Stream", "<#7cafbf>", {_lore})
	else:
		set {_enemies::*} to LoopEntitiesAroundTarget({_x}, {_radius}, false)
		wait 1 tick
		if size of {_enemies::*} > 0:
			loop {_enemies::*}:
				if loop-value is alive:
					draw 15 of ((rain particle) with an extra value of 0.03) with offset vector(0.5, 0.5, 0.5) at (location above loop-value)
					set loop-value's last damage cause to sweep attack
					set metadata value "LastDamageCause" of loop-value to "<#7cafbf>Healing Stream"
					set metadata value "LastDamageCauseLore" of loop-value to {_lore}
					set metadata value "Element" of {_p} to "Water"
					make {_p} damage loop-value by {_heal}
		else:
			if {_x} is alive:
				draw 15 of ((rain particle) with an extra value of 0.03) with offset vector(0.5, 0.5, 0.5) at (location above {_x})
				set {_x}'s last damage cause to sweep attack
				set metadata value "LastDamageCause" of {_x} to "<#7cafbf>Healing Stream"
				set metadata value "LastDamageCauseLore" of {_x} to {_lore}
				set metadata value "Element" of {_p} to "Water"
				make {_p} damage {_x} by {_heal}

function Watercycles(p: player, versatilityGain: number, duration: timespan):
	set {bonusVersatility::%{_p}%} to {bonusVersatility::%{_p}%} + {_versatilityGain}
	wait {_duration}
	set {bonusVersatility::%{_p}%} to {bonusVersatility::%{_p}%} - {_versatilityGain}

function OceanicUnison(p: player, target: entity, mastery: number, duration: timespan):
	if metadata value "OceanicUnisonDuration%{_p}%" of {_target} is not set:
		set metadata value "OceanicUnison%{_p}%" of {_target} to {_mastery}
		set metadata value "OceanicUnisonDuration%{_p}%" of {_target} to {_duration}
		set {bonusMastery::%{_target}%} to {bonusMastery::%{_target}%} + {_mastery}

		set {_dur} to metadata value "OceanicUnisonDuration%{_p}%" of {_target}
		set {_durShort} to durationShort("%{_dur}%")
		set {_currentMasteryBonus} to metadata value "OceanicUnison%{_p}%" of {_target}
		buffRegister({_target}, "Unison", 1, "", "-", "-", "<#f53b98> &f| %{_currentMasteryBonus}% %{_durShort}%")

		while metadata value "OceanicUnisonDuration%{_p}%" of {_target} > 0 seconds:
			wait 1 second
			remove 1 second from metadata value "OceanicUnisonDuration%{_p}%" of {_target}
			set {_dur} to metadata value "OceanicUnisonDuration%{_p}%" of {_target}
			set {_durShort} to durationShort("%{_dur}%")

			set {_currentMasteryBonus} to metadata value "OceanicUnison%{_p}%" of {_target}
			buffRegister({_target}, "Unison", 1, "", "-", "-", "<#f53b98> &f| %{_currentMasteryBonus}% %{_durShort}%")

		clear metadata value "OceanicUnisonDuration%{_p}%" of {_target}
		remove (metadata value "OceanicUnison%{_p}%" of {_target}) from {bonusMastery::%{_target}%}
		clear metadata value "OceanicUnison%{_p}%" of {_target}
		buffClear({_target}, "Unison")

	else:
		set {_currentMasteryBonus} to metadata value "OceanicUnisonDuration%{_p}%" of {_target}
		remove {_currentMasteryBonus} from {bonusMastery::%{_target}%}

		set metadata value "OceanicUnisonDuration%{_p}%" of {_target} to {_duration}
		set metadata value "OceanicUnison%{_p}%" of {_target} to {_mastery}
		set {bonusMastery::%{_target}%} to {bonusMastery::%{_target}%} + {_mastery}

function RestorativeDroplets(p: player, entity: player, effectiveness: number, partyMembers: players, victim: entity):
	loop {_partyMembers::*}:
		set {_heal} to (0.005 * {_effectiveness}) * (loop-value's max health)
		DropletsHeal({_p}, {_entity}, {_heal}, loop-value, {_victim})

function DropletsHeal(p: player, entity: player, heal: number, partyMember: player, victim: entity):
	set {_duration} to 3 seconds
	set {_lore} to "&7When you or your allies deal <#d5ff57> Supereffective%nl%&7damage, conjure &f <#7cafbf>Restorative Droplets&7.%nl% %nl%&7The droplets heal all party members for &f0.5%% &7of%nl%&7their max HP every &f1.0 sec &7for &f3.0 sec&7. One%nl%&7droplet can be created per player every%nl%&f3.0 sec&7, reduced by <#19943e> Haste&7.%nl% %nl%&7Healing is increased by &f200%% &7when &f <#7cafbf>Restorative%nl%<#7cafbf>Droplets &7are formed by <#7cafbf>Vaporeon&7."
	while {_duration} > 0 seconds:
		wait 1 second
		stop if {_victim} is not alive
		set {_duration} to {_duration} - 1 second
		Heal({_p}, {_partyMember}, {_heal}, "Restorative Droplets", "<#7cafbf>", {_lore})
		draw 30 of (((fishing particle) with an extra value of 0.06) with offset vector(0.1, 0, 0.1)) at (location above {_partyMember})
		play sound "entity.axolotl.swim" with volume 1 and pitch 2 to {_partyMember}

function tidalWavesSound(loc: location):
	play sound "entity.boat.paddle_water" with volume 2 and pitch 0.5 at {_loc}
	play sound "entity.boat.paddle_water" with volume 2 and pitch 1.5 at {_loc}
	play sound "item.bucket.fill" with volume 2 and pitch 1.25 at {_loc}
	play sound "entity.axolotl.splash" with volume 2 and pitch 0.5 at {_loc}
	play sound "entity.axolotl.splash" with volume 2 and pitch 1.5 at {_loc}
	play sound "block.amethyst_block.resonate" with volume 2 and pitch 2 at {_loc}
	wait 1 tick
	play sound "block.amethyst_block.resonate" with volume 2 and pitch 1.65 at {_loc}