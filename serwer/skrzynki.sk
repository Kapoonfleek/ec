on rightclick:
	set {_am} to (item amount of player's tool)
	if 1 of player's tool = {skrzynka}:
		cancel event
		remove 1 of player's tool from player

		set {openedchests::%player%} to {openedchests::%player%} + 1

		#if {winterDelightPassLEVEL::%player%} >= 0:
		#	getMission(player, "Chest Opening", "Opening Skrzynek", 1)
		play sound "block.wooden_button.click_off" with volume 3 and pitch 1 at player
		set {_xp} to addPlayerXP(player, 3)
		set {exp::skrzynki::%player%} to {exp::skrzynki::%player%} + {_xp}
		add 1 to {otworzoneskrzynki::%player%}

		loop yaml node keys "Chest" in "ChestList":
			if loop-value contains "Azerite":
				if yaml value "Player.OwnsHeart" in "data-%player%" = true:
					set {_droppableItems::*} to {_droppableItems::*} and loop-value
			else:
				set {_droppableItems::*} to {_droppableItems::*} and loop-value

		loop {_droppableItems::*}:
			set {_chance} to yaml value "Chest.%loop-value%.Chance" in "ChestList"
			chance of {_chance}%:
				set {_amount} to yaml value "Chest.%loop-value%.Amount" in "ChestList"

				if loop-value does not contain "Azerite":
					set {_item} to a random element of (yaml list "Chest.%loop-value%.Items" in "ChestList")
					if {_item} is not set:
						if loop-value = "Random Essence":
							loop yaml node keys "" in "ItemList":
								if loop-value-2 contains " Essence":
									set {_essences::*} to {_essences::*} and yaml value "%loop-value-2%.Item" in "ItemList"
									set {_item} to (uncolored name of (random element of {_essences::*}))
						else if loop-value = "Random Booster":
							set {_item} to StellarRandomBooster(1)
						else:
							set {_item} to loop-value

					if {_item} is not an item:
						set {_item} to yaml value "%{_item}%.Item" in "ItemList"

					give player {_amount} of {_item}
					if {_item} is not set:
						broadcast "%loop-value%"
					send "&9Chest >> &7Congratulations! You receive &f%{_amount}%&7x &f%name of {_item}%&7!" to player


				else:
					if "%{_amount}%" contains "-":
						set {_amount::*} to {_amount} split at "-"
						loop {_amount::*}:
							set {_amountNum::*} to {_amountNum::*} and loop-value-2 parsed as integer

						set {_amount} to a random integer between {_amountNum::1} and {_amountNum::2}
						
					addAzerite(player, {_amount})

				set {_dropped} to true

			set {_droppedTotal} to yaml value "Chests.Chest.%loop-value%" in "data-%player%"
			set {_droppedTotal} to {_droppedTotal} + 1
			set yaml value "Chests.Chest.%loop-value%" in "data-%player%" to {_droppedTotal}

			clear {_item}
			clear {_amount}

		if {_dropped} is not set:
			set {_drop} to acacia button named "<#855441>Scrap Wood" with lore "<#db7046>Component%nl%&7This material is found in%nl%&7empty chests.%nl%&7Exchangeable for Chests."
			giveItem(player's uuid, {_drop})

		else:
			play sound "entity.experience_orb.pickup" with volume 3 and pitch 1 at player

		UpdateScoreboard(player)

	else if 1 of player's tool = {skrzynkaluksusowa}:
		cancel event
		remove 1 of player's tool from player

		set {openedchests::%player%} to {openedchests::%player%} + 1

		#if {winterDelightPassLEVEL::%player%} >= 0:
		#	getMission(player, "Chest Opening", "Opening Skrzynek", 1)
		play sound "block.wooden_button.click_off" with volume 3 and pitch 1 at player
		set {_xp} to addPlayerXP(player, 9)
		set {exp::skrzynki::%player%} to {exp::skrzynki::%player%} + {_xp}
		add 1 to {otworzoneskrzynkiluksus::%player%}

		loop yaml node keys "Luxurious Chest" in "ChestList":
			if loop-value contains "Azerite":
				if yaml value "Player.OwnsHeart" in "data-%player%" = true:
					set {_droppableItems::*} to {_droppableItems::*} and loop-value
			else:
				set {_droppableItems::*} to {_droppableItems::*} and loop-value

		loop {_droppableItems::*}:
			set {_chance} to yaml value "Luxurious Chest.%loop-value%.Chance" in "ChestList"
			chance of {_chance}%:
				set {_amount} to yaml value "Luxurious Chest.%loop-value%.Amount" in "ChestList"

				if loop-value does not contain "Azerite":
					set {_item} to a random element of (yaml list "Luxurious Chest.%loop-value%.Items" in "ChestList")
					if {_item} is not set:
						if loop-value = "Random Essence":
							loop yaml node keys "" in "ItemList":
								if loop-value-2 contains " Essence":
									set {_essences::*} to {_essences::*} and yaml value "%loop-value-2%.Item" in "ItemList"
									set {_item} to (uncolored name of (random element of {_essences::*}))

						else if loop-value = "Random Booster":
							set {_item} to StellarRandomBooster(1)
						else:
							set {_item} to loop-value

					if {_item} is not an item:
						set {_item} to yaml value "%{_item}%.Item" in "ItemList"

					give player {_amount} of {_item}
					send "&9Luxurious Chest >> &7Congratulations! You receive &f%{_amount}%&7x &f%name of {_item}%&7!" to player

				else:
					if "%{_amount}%" contains "-":
						set {_amount::*} to {_amount} split at "-"
						loop {_amount::*}:
							set {_amountNum::*} to {_amountNum::*} and loop-value-2 parsed as integer

						set {_amount} to a random integer between {_amountNum::1} and {_amountNum::2}
						
					addAzerite(player, {_amount})

				set {_dropped} to true

			set {_droppedTotal} to yaml value "Luxurious Chests.Luxurious Chest.%loop-value%" in "data-%player%"
			set {_droppedTotal} to {_droppedTotal} + 1
			set yaml value "Luxurious Chests.Luxurious Chest.%loop-value%" in "data-%player%" to {_droppedTotal}

			clear {_item}
			clear {_amount}

		if {_dropped} is not set:
			set {_drop} to acacia button named "<#855441>Scrap Wood" with lore "<#db7046>Component%nl%&7This material is found in%nl%&7empty Luxurious Chests.%nl%&7Exchangeable for Luxurious Chests."
			giveItem(player's uuid, {_drop})

		else:
			play sound "entity.experience_orb.pickup" with volume 3 and pitch 1 at player

		UpdateScoreboard(player)
			
	#Chest exchange @spawn 3 Chests = 1 Luxurious chest


	# Drop rates:
	
	# Chests:
	#
	# Random Gemstone: 25%
	# 3x Random Gemstone: 8%
	# 1x Klejnot 28%
	# SW Booster: 0.6%
	# 3x SW Booster:  0.2%
	# Star Shard: 0.11%
	# Chaotic Potion: 0.4%
	# Prismatic Lens: 0.18%
	# Jar of Experience: 7%
	# Chest 4.5%
	# Luxury Chest 1%
	# Random Essence 3.5%
	
	# Luxurious Chests:
	#
	# Random Gemstone: 48%
	# 3x Random Gemstone: 24%
	# 1x Klejnot 65%
	# SW Booster: 2.2%
	# 3x SW Booster:  0.7%
	# Star Shard: 0.33%
	# Chaotic Potion: 1.1%
	# Prismatic Lens: 0.39%
	# Jar of Experience: 12%
	# Chest 9%
	# Luxury Chest 2.5%
	# Random Essence 8%
	# 3x Random Essence 2.8%
	# Enchanted Prismatic Lens: 0.13%
	# Klejnot Rain 0.48%
	# 1x Token of Gratitude 0.6%