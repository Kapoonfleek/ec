												else if metadata value "WintersChill%player%" of {_target} < 2:
													set metadata value "WintersChill%player%" of {_target} to metadata value "WintersChill%player%" of {_target} + 1
												WintersChillDebuff(player, {_target})

											if canBeCCed({_target}) = true:
												apply an ambient potion effect of slowness of tier 4.67 to {_target} for {_slowtime}:
													hide the particles
											play sound "skill.glaceon.flurry_impact" with volume 3 and pitch 1 at location of {_target}
											wait 6 ticks
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "Icy Veins" of (custom nbt of player's tool) is set:
