import:
    org.dynmap.markers.MarkerAPI
    org.dynmap.markers.MarkerDescription
    org.dynmap.markers.MarkerIcon
    org.dynmap.markers.MarkerSet
    org.dynmap.DynmapCommonAPI
    org.dynmap.DynmapCommonAPIListener
    org.bukkit.Bukkit
    org.dynmap.bukkit.DynmapPlugin
    java.lang.Math
    kr.toxicity.model.api.BetterModel
    kr.toxicity.model.api.tracker.EntityTrackerRegistry

variables:
    {worldQuestCount} = 0

command /testdialogue:
    trigger:
        set {worldQuestCount} to 0
        portraitDialogue(player, "", "Magni Bronzebeard", "Someone's drawin' power from Azerite in this area. Ye need tae stop 'em!")
        set {_dialogue} to "No need tae panic! Though I suppose my entrance was a bit abrupt..."
        #portraitDialogue(player, "", "Magni Bronzebeard", {_dialogue})
        #play sound "npc.magnibronzebeard.heart_introduction" with volume 5 and pitch 1 to player
        set {_citizens} to Bukkit.getPluginManager().getPlugin("Citizens")
        set {_magni} to {_citizens}.getNPCRegistry().getById(6748).getEntity()
        broadcast {_magni}
        

function portraitDialogue(p: player, icon: string, name: string, text: string):
    if length of {_text} > 32:
        set {_length} to (length of {_text})/32
        set {_length} to rounded down {_length}
        set {_counter} to 1
        loop {_length} times:
            set {_min} to 1 + (({_counter}-1)*32)
            if loop-counter = {_length}:
                set {_max} to length of {_text}
            else:
                set {_max} to {_counter}*32
            if {_counter} < 3:
                set {_textAligned::*} to {_textAligned::*} and (subtext of {_text} from character {_min} to character {_max})
            else:
                set {_text::*} to {_text::*} and (subtext of {_text} from character {_min} to character {_max})
            add 1 to {_counter}
    else:
        set {_textAligned::*} to {_text}
    send "" to {_p}
    send "          <##fdd002>%{_name}%" to {_p}
    loop {_textAligned::*}:
        send "          %loop-value%" to {_p}
    if {_text::*} is set:
        loop {_text::*}:
            if loop-counter = (size of {_text::*}):
                send "%{_icon}% %loop-value%" to {_p}
            else:
                send "          %loop-value%" to {_p}
    else:
        send "%{_icon}%" to {_p}
    send " " to {_p}

command /ly:
    trigger:
        if yaml "WorldQuestList" is loaded:
            save yaml "WorldQuestList"
            unload yaml "WorldQuestList"
            broadcast "&cunloaded yaml"
        else:
            load yaml "plugins/Skript/lists/WorldQuestList" as "WorldQuestList"
            broadcast "&bloaded yaml"

command /wq [<text>]:
    trigger:
        if arg-1 = "task":
            set yaml value "Mobs.Drowned.Item" in "WorldQuestList" to player's tool
        if arg-1 = "register":
            set yaml value "World Quests.The Narrow Passage.Location" in "WorldQuestList" to player's location
            set yaml value "World Quests.The Narrow Passage.Location Name" in "WorldQuestList" to "Riptide Reach"
            set yaml value "World Quests.The Narrow Passage.Type" in "WorldQuestList" to "Slay Mobs"
            set yaml value "World Quests.The Narrow Passage.Quest Giver" in "WorldQuestList" to "Philippe 'Rumford'"
            set yaml value "World Quests.The Narrow Passage.EXP" in "WorldQuestList" to 100
            set yaml value "World Quests.The Narrow Passage.Reputation" in "WorldQuestList" to 20
            set yaml list "World Quests.The Narrow Passage.Rewards" in "WorldQuestList" to "Radiant Azerite Fragment"
        if arg-1 = "spawn":
            set {_wq} to "The Narrow Passage"
            WorldQuestSpawn({_wq})
        if arg-1 = "slay":
            loop all entities in radius 70 of player:
                if boolean tag "RemoveOnReset" of custom nbt of loop-entity = true:
                    kill loop-entity

        save yaml "WorldQuestList"
        save yaml "WorldQuestLocations"

#1. Every friday, 10 random World Quests are randomized.
#2. On init, load chunks around the locations of the world quests.
#3. Spawn mobs, make players see x as y and place things for pick up.
#4. Always 1 "rarer, more difficult world ques, usually slay a boss"
#5. Mobs etc. respawns after some time
#6. Place markers on the map.
        
function WorldQuestSpawn(wq: string):
    set {_wqType} to yaml value "World Quests.%{_wq}%.Type" in "WorldQuestList"
    if {_wqType} = "Slay Mobs":
        set {_mobType} to yaml value "Tasks.%{_wqType}%.%{_wq}%.Mob" in "WorldQuestList"
        set {_entity} to (yaml value "Mobs.%{_mobType}%.Entity" in "WorldQuestList")
        set {_entity} to "adult %{_entity}%" parsed as entity type

        set {_health} to yaml value "Mobs.%{_mobType}%.Health" in "WorldQuestList"
        set {_level} to yaml value "Mobs.%{_mobType}%.Level" in "WorldQuestList"
        set {_element} to yaml value "Mobs.%{_mobType}%.Element" in "WorldQuestList"
        set {_modelHeight} to yaml value "Mobs.%{_mobType}%.Model Height" in "WorldQuestList"
        set {_item} to yaml value "Mobs.%{_mobType}%.Item" in "WorldQuestList"

        set {_spawnLocations::*} to yaml list "%{_wqType}%.%{_wq}%.Locations" in "WorldQuestLocations"
        loop {_spawnLocations::*}:
            set {_loc} to loop-value
            spawn {_entity} at {_loc}
            set {_mob} to last spawned entity
            set display name of {_mob} to "&f%{_mobType}%"

            set {_mob}'s max health to {_health} * Math.pow(1.072, ({_level}))
            heal {_mob}

            set boolean tag "ECMob" of custom nbt of {_mob} to true
            set int tag "ECLvl" of custom nbt of {_mob} to {_level}
            set boolean tag "RemoveOnReset" of custom nbt of {_mob} to true
            set string tag "ECElement" of custom nbt of {_mob} to {_element}
            set long tag "ECModelHeight" of custom nbt of {_mob} to {_modelHeight}
            set boolean tag "ECWorldQuestMob" of custom nbt of {_mob} to true
            set boolean tag "Silent" of nbt of {_mob} to true

            set metadata value "ECSpawnLocation" of {_mob} to loop-value
            if {_item} is set:
                set {_mob}'s held item to {_item}
            if yaml list "Mobs.%{_mobType}%.Sounds" in "WorldQuestList" is set:
                set {_sounds::*} to yaml list "Mobs.%{_mobType}%.Sounds" in "WorldQuestList"
                WorldQuestMobSounds({_mob}, {_sounds::*})

            set {_scale} to yaml value "Mobs.%{_mobType}%.Scale" in "WorldQuestList"
            set scale attribute of {_mob} to {_scale}

            if yaml value "Mobs.%{_mobType}%.Model" in "WorldQuestList" != "none":
                set {_modelName} to yaml value "Mobs.%{_mobType}%.Model" in "WorldQuestList"
                set {_model} to BetterModel.model({_modelName}).get().getOrCreate({_mob})
                {_model}.registry().reload()

            MobInfoAssignments({_mob}, {_loc})

function WorldQuestRespawnMob(mob: entity):
    broadcast metadata value "ECSpawnLocation" of {_mob}
    clear metadata value "ECSpawnLocation" of {_mob}

function WorldQuestMobSounds(mob: entity, sounds: strings):
    while {_mob} is alive:
        set {_randomCd} to a random number between 5.0 and 10.0
        set {_wait} to "%{_randomCd}% seconds" parsed as timespan
        set {_sound} to a random element of {_sounds::*}
        play sound {_sound} with volume 3 and pitch 1 at location of {_mob}
        wait {_wait}

function MobInfoAssignments(mob: entity, loc: location):
    loop 2 times:
        spawn an armor stand at {_loc}
        set boolean tag "Marker" of nbt of last spawned armor stand to true
        set boolean tag "Invulnerable" of nbt of last spawned armor stand to true
        set boolean tag "Invisible" of nbt of last spawned armor stand to true
        set boolean tag "CustomNameVisible" of nbt of last spawned armor stand to true
        set boolean tag "NoGravity" of nbt of last spawned armor stand to true

        set boolean tag "RemoveOnReset" of custom nbt of last spawned armor stand to true

        if loop-counter = 1:
            set display name of last spawned armor stand to "&a|||||||||| &f(100%%)"
            set string tag "ECTextAbove" of custom nbt of {_mob} to uuid of last spawned armor stand
        else:
            set {_mobLevel} to int tag "ECLvl" of custom nbt of {_mob}
            set display name of last spawned armor stand to "&4Level %{_mobLevel}%"
            set string tag "ECTextAboveLevel" of custom nbt of {_mob} to uuid of last spawned armor stand

        push {_mob} upwards with velocity 0.01

function CreateWorldQuest(worldQuests: integer):
    set {_worldQuestList::*} to yaml node keys "World Quests" in "WorldQuestList"
    remove "Helping the Test" from {_worldQuestList::*}
    loop {_worldQuests} times:
        stop loop if size of {_worldQuestList::*} = 0
        set {_randomWorldQuest} to a random element of {_worldQuestList::*}
        remove {_randomWorldQuest} from {_worldQuestList::*}

        set {_WQLocation} to yaml value "World Quests.%{_randomWorldQuest}%.Location" in "WorldQuestList"
        set {_WQLocationMin} and {_WQLocationMax} to {_WQLocation}

        increase x-coordinate of {_WQLocationMin} by -100
        increase z-coordinate of {_WQLocationMin} by -100
        increase x-coordinate of {_WQLocationMax} by 100
        increase z-coordinate of {_WQLocationMax} by 100

        set {_plugin} to instance of plugin "Skript"
        loop all chunks within {_WQLocationMin} and {_WQLocationMax}:
            set {_chunk} to loop-chunk
            set {_chunkLoc} to block at 0,0,0 in {_chunk}
            {_chunk}.addPluginChunkTicket({_plugin})
            {_chunk}.getWorld().getChunkAtAsync({_chunkLoc})
            wait 1 tick if loop-counter-2 is divisible by 20

        set {_worldQuestRarity} to yaml value "World Quests.%{_randomWorldQuest}%.Rarity" in "WorldQuestList"
        set {_worldQuestGiver} to yaml value "World Quests.%{_randomWorldQuest}%.Quest Giver" in "WorldQuestList"
        set {_worldQuestType} to yaml value "World Quests.%{_randomWorldQuest}%.Type" in "WorldQuestList"
        set {_worldQuestFaction} to yaml value "Quest Givers.%{_randomWorldQuest}%.Faction" in "WorldQuestList"

        if {_worldQuestRarity} = "Normal":
            set {_colour} to "#00ff00"
        else if {_worldQuestRarity} = "Rare":
            set {_colour} to "#0070dd"
        else if {_worldQuestRarity} = "Epic":
            set {_colour} to "#a335ee"

        set {_objectiveItems::*} to yaml node keys "Tasks.%{_worldQuestType}%.%{_randomWorldQuest}%" in "WorldQuestList"
        loop {_objectiveItems::*}:
            set {_requirement} to yaml value "Tasks.%{_worldQuestType}%.%{_randomWorldQuest}%.%loop-value-2%.Requirement" in "WorldQuestList"
            set {_objective} to yaml value "Tasks.%{_worldQuestType}%.Objective" in "WorldQuestList"
            replace all "{COMPLETED}" in {_objective} with "0"
            replace all "{MOBNAME}" in {_objective} with loop-value-2
            replace all "{REQUIREMENT}" in {_objective} with {_requirement}
            add "- %{_objective}%" to {_objectives::*}

        set {_x} to x-coordinate of {_WQLocation}
        set {_y} to y-coordinate of {_WQLocation}
        set {_z} to z-coordinate of {_WQLocation}

        set {_htmlWQName} to "<p style=color:%{_colour}%;>%{_randomWorldQuest}%</p>"
        set {_worldQuestFaction} to "<p style=color:#fdd002;>%{_worldQuestFaction}%</p>"

        set {_rewards} to "<p style=color:#fdd002;>Rewards</p>"
        set {_objectives} to join {_objectives::*} by "<br>"

        set {_imageLink} to "https://wow.zamimg.com/images/wow/icons/large/inv_radientazeritefragment.jpg"
        set {_reward} to "<div style=display:flex; width:200px><p><img src=%{_imageLink}% alt=Radiant Azerite Fragment  style=background:transparent;float:left;width:32px;height:32px/>"
        set {_reward} to "%{_reward}%<div style=background:transparent;><p style=color:%{_colour}%;>Radiant Azerite Fragment</p>"
        set {_reward} to "%{_reward}%<p style=color:#fdd002;>Grants 650 Artifact Power to your<br>Heart of Earthcraft.</p></div></div>"

        set {_description} to "%{_worldQuestFaction}%%{_objectives}%"
        set {_worldQuestText} to "%{_htmlWQName}%%{_description}%%{_rewards}%%{_reward}%%{_test}%"
        
        set {_y} to y-coordinate of {_WQLocation}
        
        add 1 to {worldQuestCount}

        execute console command "dmarker add set:WorldQuests x:%{_x}% y:%{_y}% z:%{_z}% world:world icon:questmarker label:""%{_worldQuestText}%"" markup:true id:%{worldQuestCount}%"

