						set {_SWDlore} to "&8Basic Ability%nl%&f%{_SWDchargesLore}%%nl%&fInstant Cast%nl%&7Global Cooldown:  &f%{_gcd}%%nl%&7Recharge Time:  &f%{_SWDCD}%%nl%&7Use: &fRMB%nl%<#613e82>A word of dark binding that inflicts%nl%&f%{_damageSWD}%  <#431d53>Ghost <#613e82>damage to the target. Only%nl%<#613e82>usable on enemies that have less%nl%<#613e82>than &f%{_SWDThreshold}%%% <#8165a6>health<#613e82>.%nl% %nl%&fGenerates 15 Insanity, or 30 Insanity%nl%&fif the target dies."

						set slot 1 of {_gui} to light gray dye named "<#613e82>Madness" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#613e82>Increases the damage of your &f <#8165a6>Mind Flay<#613e82>,%nl%&f <#8165a6>Void Eruption<#613e82>, &f <#8165a6>Void Bolt<#613e82>, &f <#8165a6>Vampiric Touch<#613e82>,%{_madness}%" with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 11 of {_gui} to purple dye named "<#613e82>Shadowy Apparitions" with lore "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#613e82>When your &f <#8165a6>Shadow Word: Pain <#613e82>damage%nl%<#613e82>over time <#8165a6> Critically Strikes<#613e82>, you also create%nl%<#613e82>a shadowy version of yourself that floats%nl%<#613e82>towards the target and deals &f%{_shadowyApparitionsDamage}%  <#431d53>Ghost%nl%<#613e82>damage." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 10 of {_gui} to popped chorus fruit named "<#613e82>Voidform" with lore "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#613e82>Activated by casting &f <#8165a6>Void Eruption<#613e82>.%nl%<#613e82>Increases all damage you deal by &f20%% <#613e82>and%nl%<#613e82>grants an additional &f1%% <#8165a6> Haste <#613e82>every &f1 sec<#613e82>.%nl%<#613e82>Your &f <#8165a6>Insanity <#613e82>will drain increasingly fast until%nl%<#613e82>it reaches &f0 <#613e82>and &f <#8165a6>Voidform <#613e82>ends." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 19 of {_gui} to {_MBorSWV}
						set slot 20 of {_gui} to orange dye named "<#613e82>Shadow Word: Pain" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Global Cooldown:  &f%{_gcd}%%nl%&7Use: &fRMB%nl%<#613e82>A word of darkness that causes%nl%&f%{_SWPdamage}%  <#431d53>Ghost <#613e82>damage instantly, and%nl%<#613e82>an additional &f%1 + (round({_SWPDuration}/(2/{_pospiech}), 0))*{_damageSWPTicks}%  <#431d53>Ghost <#613e82>damage%nl%<#613e82>over &f%{_SWPDuration}% sec<#613e82>.%nl% %nl%&fGenerates 3 Insanity." with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 21 of {_gui} to gray dye named "<#613e82>Vampiric Touch" with lore "&8Basic Ability%nl%&f%{_casttimeVT}% second cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<#613e82>A touch of darkness that causes &f%1 + (round({_VTDuration}/{_tickTimeVT}, 0))*{_VTDamage}%  <#431d53>Ghost%nl%<#613e82>damage over &f%{_VTDuration}% sec<#613e82>, and <#8165a6>heals <#613e82>the priest for%nl%&f10%% <#613e82>of damage dealt.%nl% %nl%&fGenerates 6 Insanity." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						set slot 22 of {_gui} to cyan dye named "<#613e82>Mind Flay" with lore "&8Basic Ability%nl%&fChanneled%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<#613e82>Assaults the target's mind with shadow%nl%<#613e82>energy, causing &f%{_MFDamage}*(rounded up 3/(({_channelTimeMF}/4)/{_MFHaste}))%  <#431d53>Ghost <#613e82>damage over%nl%&f%{_channelTimeMF}% sec <#613e82>and <#8165a6>slowing <#613e82>their movement speed%nl%<#613e82>by &f50%%<#613e82>.%nl% %nl%&fGenerates %2*(rounded up 3/(({_channelTimeMF}/4)/{_MFHaste}))% Insanity over the duration." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 23 of {_gui} to yellow dye named "<#613e82>Shadow Word: Death" with lore {_SWDlore} with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
						set slot 28 of {_gui} to purple dye named "<#613e82>Void Eruption" with lore "&8Ultimate Ability%nl%&f%{_casttimeVE}% cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<#613e82>Releases an explosive blast of pure void%nl%<#613e82>energy, activating &f <#8165a6>Voidform <#613e82>and causing%nl%&f%{_damageVE}%  <#431d53>Ghost <#613e82>damage to all enemies afflicted by%nl%<#613e82>your &f <#8165a6>Shadow Word: Pain <#613e82>or &f <#8165a6>Vampiric Touch.%nl% %nl%<#613e82>During &f <#8165a6>Voidform<#613e82>, this ability is replaced%nl%<#613e82>by &f <#8165a6>Void Bolt<#613e82>.%nl% %nl%&fRequires %{_reqInsanity}% Insanity to activate." with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
						set slot 29 of {_gui} to black dye named "<#613e82>Void Bolt" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_voidBoltCD}% seconds%nl%&7Use: &fRMB%nl%<#613e82>Sends a bolt of pure void energy at the%nl%<#613e82>enemy, causing &f%{_voidBoltDMG}%  <#431d53>Ghost <#613e82>damage and%nl%<#8165a6>extending <#613e82>the duration of &f <#8165a6>Shadow Word:%nl%<#8165a6>Pain <#613e82>and &f <#8165a6>Vampiric Touch <#613e82>to their original%nl%<#613e82>duration.%nl% %nl%<#613e82>Requires &f <#8165a6>Voidform<#613e82>.%nl% %nl%&fGenerates 16 Insanity." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						if string tag "Talents;Row 5" of {_customnbt} = "Surrender to Madness":
							set slot 30 of {_gui} to popped chorus fruit named "<#613e82>Surrender to Madness" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f10 minutes%nl%&7Use: &fRMB%nl%<#613e82>Surrender your soul to the <#8165a6>Old Gods<#613e82>, sacrificing%nl%<#613e82>your soul for <#8165a6>ultimate power<#613e82>.%nl% %nl%<#613e82>All your &f <#8165a6>Insanity-generating <#613e82>abilities generate%nl%&f200%% <#613e82>more &f <#8165a6>Insanity <#613e82>until you exit &f <#8165a6>Voidform<#613e82>.%nl% %nl%<#613e82>Then you die. Horribly." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
					else if uncolored (name of player's tool) = "Cresselia":

						set {_item} to AbilityItem(player, "Shooting Stars", pink dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Shooting Stars", AbilityUpgradeLevel(player, "Shooting Stars"), "&f")
						set slot 1 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Boundless Moonlight", glowstone dust)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Boundless Moonlight", AbilityUpgradeLevel(player, "Boundless Moonlight"), "&f")
						set slot 10 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Starfire", white dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Starfire", AbilityUpgradeLevel(player, "Starfire"), "&f")
						set slot 19 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Starsurge", magenta dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Starsurge", AbilityUpgradeLevel(player, "Starsurge"), "&f")
						set slot 20 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Starfall", purple dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Starfall", AbilityUpgradeLevel(player, "Starfall"), "&f")
						set slot 21 of {_gui} to {_item}

						set {_item} to AbilityItem(player, "Celestial Alignment", light blue dye)
						set lore of {_item} to CresseliaAbilityUpgradePreviewLore(player, "Celestial Alignment", AbilityUpgradeLevel(player, "Celestial Alignment"), "&f")
						set slot 28 of {_gui} to {_item}

						if string tag "Talents;Row 4" of {_customnbt} = "Innervate":
							set {_innervateCooldown} to 3 minutes
							set {_innervateAllyCdReduction} to 40
							set {_innervateSelfCdReduction} to 30
							set {_innervateAstralPower} to 100
							set {_valueNames::*} to "COOLDOWN", "ALLYCDREDUCTION", "SELFCDREDUCTION", "ASTRALPOWER"
							set {_values::*} to {_innervateCooldown}, {_innervateAllyCdReduction}, {_innervateSelfCdReduction}, {_innervateAstralPower}
							set {_item} to AbilityItem(player, "Innervate", blue dye)
							set lore of {_item} to GetAbilityDescription(player, "Cresselia", "Innervate", {_valueNames::*}, {_values::*})
							set slot 29 of {_gui} to {_item}

					else if uncolored (name of player's tool) = "Shenhe":
						set {_baseResShred} to 30
						set {_mastery} to 10 + Mastery(player)/4
						set {_resShred} to {_baseResShred} + {_mastery}
						set slot 1 of {_gui} to light blue dye named "<#8c9db9>Mastery: Deific Embrace" with lore "&8Mastery Bonus%nl%&fInstant cast%nl%&7Cooldown: &fnone%nl%&7Use: &fPassive%nl%<#8c9db9>Increases the <#add8e6>Ice <#ffef45> Resistance <#8c9db9>shred for enemies%nl%<#8c9db9>provided by <#abc0d9>Divine Maiden's Deliverance <#8c9db9>by &f10<#8c9db9>.%nl%&8&m-------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 10 of {_gui} to light blue dye named "<#8c9db9>Spirit Communion Seal" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown: &fnone%nl%&7Use: &fPassive%nl%<#8c9db9>After Shenhe uses <#abc0d9>Spring Spirit Summoning<#8c9db9>, she%nl%<#8c9db9>will grant all nearby allies or party members%nl%<#8c9db9>the following effects:%nl% %nl%<#8c9db9>Left Click: <#add8e6>Ice <#8c9db9>Ability and Ultimate Ability damage%nl%<#8c9db9>increased by &f15%% <#8c9db9>for &f10 sec<#8c9db9>.%nl% %nl%<#8c9db9>Right Click: <#abc0d9>Spring Spirit Summoning <#8c9db9>will grant &f2 <#8c9db9>additional%nl%<#bdd1f2>Icy Quills <#8c9db9>to each affected ally and <#bdd1f2>Icy Quills <#8c9db9>will last &f2%nl%<#8c9db9>additional &fsec<#8c9db9>.%nl%&8&m-------------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 19 of {_gui} to light blue dye named "<#8c9db9>Dawnstar Piercer" with lore "&8Ability%nl%&fInstant cast%nl%&7Cooldown: &f4 seconds%nl%&7Use: &fRMB%nl%<#8c9db9>Deal &f2 <#add8e6>Ice <#8c9db9>or <#cecece>Metal <#8c9db9>damage to the enemy, depending%nl%<#8c9db9>on their element. If the enemy is neutral to both%nl%<#8c9db9>elements, deal <#add8e6>Ice <#8c9db9>damage.%nl%&8&m-------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 20 of {_gui} to light blue dye named "<#8c9db9>Spring Spirit Summoning" with lore "&8Ability%nl%&fInstant cast%nl%&7Cooldown: &f18 seconds%nl%&7Use: &fLMB&7/&fRMB%nl%<#8c9db9>The frosted dew, silvery and dense, shall exorcise all demons.%nl%<#8c9db9>Grants all nearby allies or party members the <#bdd1f2>Icy Quill <#8c9db9>effect%nl%<#8c9db9>and deals <#add8e6>Ice <#8c9db9>damage in different ways based on whether this%nl%<#8c9db9>ability is &fleft <#8c9db9>or &fright <#8c9db9>clicked.%nl% %nl%<#8c9db9>Left Click: Commands the <#abc0d9>Talisman Spirit <#8c9db9>to deal &f4 <#add8e6>Ice <#8c9db9>damage%nl%<#8c9db9>in an area around Shenhe.%nl% %nl%<#8c9db9>Right Click: Rushes toward a target with a <#abc0d9>Talisman Spirit,%nl%<#8c9db9>dealing &f2 <#add8e6>Ice <#8c9db9>damage to all enemies around the target.%nl% %nl%<#bdd1f2>Icy Quill%nl%<#8c9db9>When Abilities, Ultimate Abilities and Weapon Attacks deal <#add8e6>Ice%nl%<#8c9db9>damage to opponents, the damage dealt is increased based%nl%<#8c9db9>on Shenhe's offensive statistics.%nl% %nl%<#bdd1f2>Icy Quills <#8c9db9>currently add an extra &f0.45 <#8c9db9>damage each and%nl%<#8c9db9>have a duration of &f10 sec<#8c9db9>.%nl%&8&m----------------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 28 of {_gui} to light blue dye named "<#8c9db9>Divine Maiden's Deliverance" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &f70 seconds%nl%&7Use: &fRMB%nl%<#8c9db9>Unleashes the power of the <#abc0d9>Talisman Spirit<#8c9db9>, allowing%nl%<#8c9db9>it to roam free in this plane, dealing &f8 <#add8e6>Ice <#8c9db9>damage%nl%<#8c9db9>to all enemies within an area. The <#abc0d9>Talisman Spirit <#8c9db9>then%nl%<#8c9db9>creates a field for &f12 sec <#8c9db9>that decreases the <#add8e6>Ice%nl%<#8c9db9>and <#cecece>Metal <#ffef45> Resistance <#8c9db9>of opponents within it by &f%{_resShred}%<#8c9db9>.%nl%<#8c9db9>It also deals two instances of periodic &f0.8 <#add8e6>Ice <#8c9db9>damage%nl%<#8c9db9>every &f2 sec <#8c9db9>for the duration of the field.%nl%&8&m----------------------------------------------%nl%&7Ability Level: &8★★★★★%nl% %nl%&7&o--- Click here to read details." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						#Talent for spear damage, spear damage increases by x%% per strike, up to 5 times
					else if uncolored (name of player's tool) = "Delphox":
						set {_masteryBonus} to (2.5 + ((Mastery(player)/165)))*100
						set {_blazeDamage} to 3 + (Versatility(player)/180) + ({damage::%player%}/60) + {primarystat::%player%}/30
						set {_baseDuration} to 4
						set {_flamethrowerDamage} to 1.25 + (Versatility(player)/360) + ({damage::%player%}/120) + {primarystat::%player%}/60
						set {_flamethrowerTicks} to rounded {_baseDuration}/(1/{_hasteTt})
						set {_tick} to 1/{_hasteTt}
						set {_flamethrowerCooldown} to 14/{_hasteTt}
						set {_flamethrowerTotalDamage} to {_flamethrowerDamage} * {_flamethrowerTicks}
						set {_infernoCastDamage} to 3.5 + (Versatility(player)/120) + ({damage::%player%}/40)  + ({primarystat::%player%}/20)
						set {_infernoDetonationDamage} to 6 + (Versatility(player)/60) + ({damage::%player%}/20) + ({primarystat::%player%}/10)
						set {_flameBarrierDuration} to 6 + ((Resistance(player)/25))
						set {_stunDuration} to 2 + (CrowdControlStat(player)/60) 
						set {_flameBarrierCd} to "%130/{_pospiech}% seconds" parsed as timespan
						set slot 1 of {_gui} to charcoal named "<#fa4420>Mastery: Incineration" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#fa4420>Delphox's <#f2636a> Critical Strikes <#fa4420>inflict &f%{_masteryBonus}%%%%nl%<#fa4420>damage instead of the standard &f200%%<#fa4420>." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 10 of {_gui} to red dye named "<#fa4420>Blaze" with lore "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#fa4420>Every &fthird  <#f2636a>Flamethrower <#fa4420>used deals%nl%&f%{_blazeDamage}% <#ff4d00>Fire <#fa4420>damage to the target and up to%nl%<#fa4420>&ftwo <#fa4420>nearby enemies around the target." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 19 of {_gui} to blaze rod named "<#fa4420>Flamethrower" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_flamethrowerCooldown}% seconds per target%nl%&7Use: &fRMB%nl%<#f2636a>Ignites <#fa4420>the target for &f4 sec<#fa4420>, inflicting &f%{_flamethrowerDamage}%%nl%<#ff4d00>Fire <#fa4420>damage every &f%{_tick}% sec <#fa4420>for a total of &f%{_flamethrowerTotalDamage}% <#ff4d00>Fire%nl%<#fa4420>damage. &f <#f2636a>Flamethrower <#fa4420>cannot be used on%nl%<#fa4420>the same target for the next &f%{_flamethrowerCooldown}% sec<#fa4420>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 20 of {_gui} to blaze powder named "<#fa4420>Inferno" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB/SHIFT%nl%<#fa4420>RIGHT-CLICK:%nl%<#f2636a>Imprisons <#fa4420>a target affected by &f <#f2636a>Flamethrower%nl%<#fa4420>in a fiery prison, <#f2636a> Stunning <#fa4420>them for &f%{_stunDuration}% sec <#fa4420>and%nl%<#fa4420>inflicting &f%{_infernoCastDamage}% <#ff4d00>Fire <#fa4420>damage.%nl% %nl%<#fa4420>SHIFT:%nl%<#f2636a>Detonates <#fa4420>an active &f <#f2636a>Inferno<#fa4420>, dealing &f%{_infernoDetonationDamage}% <#ff4d00>Fire%nl%<#fa4420>damage and <#f2636a>tossing <#fa4420>the enemy into the air." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						if string tag "Talents;Row 5" of {_customnbt} = "Flaming Finale":
							set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f1 minute and 15 seconds%nl%&7Use: &fRMB%nl%<#fa4420>Resets the cooldown of &f <#f2636a>Flamethrower <#fa4420>on all%nl%<#fa4420>targets who have recently been affected%nl%<#fa4420>by the ability and immediately <#f2636a>traps them <#fa4420>in%nl%<#fa4420>an &f <#f2636a>Inferno<#fa4420>, all with the snap of a finger.%nl% %nl%&f <#eb6146>Flaming Finale%nl%<#fa4420>Deals &f4 <#ff4d00>Fire <#fa4420>damage to all affected targets%nl%<#fa4420>and detonates all &f <#f2636a>Infernos <#fa4420>for &f160%% <#fa4420>of the%nl%<#fa4420>normal damage."
						else:
							if string tag "Talents;Row 5" of {_customnbt} = "Hot Spree":
								set slot 11 of {_gui} to blaze rod named "<#fa4420>Hot Spree" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<#fa4420>Every third &f <#f2636a>Flamethrower <#fa4420>will not incur%nl%<#fa4420>a cooldown. When a &ffree  <#f2636a>Flamethrower%nl%<#fa4420>is used, its damage is increased by &f50%%<#fa4420>.%nl% %nl%<#fa4420>Damage dealt by &f <#f2636a>Flamethrower <#fa4420>is%nl%<#fa4420>increased by &f60%%<#fa4420>.%nl% %nl%<#fa4420>Replaces &f <#f2636a>Inferno<#fa4420>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
							set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f45 seconds%nl%&7Use: &fRMB%nl%<#fa4420>Resets the cooldown of &f <#f2636a>Flamethrower <#fa4420>on all%nl%<#fa4420>targets who have recently been affected%nl%<#fa4420>by the ability and immediately <#f2636a>traps them <#fa4420>in%nl%<#fa4420>an &f <#f2636a>Inferno<#fa4420>, all with the snap of a finger."
						set slot 29 of {_gui} to glowstone dust named "<#fa4420>Heat Snap" with lore {_lore} with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
						set slot 28 of {_gui} to flint named "<#fa4420>Flame Barrier" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_flameBarrierCd}%%nl%&7Use: &fRMB%nl%<#fa4420>Surround yourself with a <#f2636a>flame barrier<#fa4420>,%nl%<#f2636a>negating <#fa4420>any incoming damage for the%nl%<#fa4420>next &f%{_flameBarrierDuration}% sec<#fa4420>. The duration of &f <#f2636a>Flame Barrier%nl%<#fa4420>is increased based on your <#f2636a> Resistance<#fa4420>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
					else if uncolored (name of player's tool) = "Vaporeon":
						set {_mastery} to 1.1 + (Mastery(player)/370)
						set {_masteryBonus} to ({_mastery}-1)*100
						set {_healcircle} to 0.8 + ({utility::%player%}/100) + (Versatility(player)/300) + ({primarystat::%player%}/50)
						set {_cd} to "%8/{_hasteTt}% seconds" parsed as timespan
						set {_heal} to 1.5 + ({utility::%player%}/80) + (Versatility(player)/240) + ({primarystat::%player%}/40)
						if string tag "Talents;Row 1" of {_customnbt} = "Undulation":
							set {_charges} to 3
						else:
							set {_charges} to 2
						set {_cdBubble} to "%1.5/{_pospiech}% sec"
						set {_cdtarget} to "%20/{_pospiech}% sec"
						set {_shield} to 6 + ({utility::%player%}/52) + (Versatility(player)/156) + {primarystat::%player%}/26
						set {_damage} to 1 + ({damage::%player%}/60) + (Versatility(player)/180) + {primarystat::%player%}/30

						set {_undertowDamage} to 1 + ({damage::%player%}/65) + (Versatility(player)/195) + {primarystat::%player%}/32.5
						set {_undertowCD} to "%3/{_pospiech}% sec"
						set {_undertowCastTime} to "%1.5/{_pospiech}% sec"

						set {_wait} to 8/{_pospiech}
						set {_cdReversal} to "%300/{_hasteTt}% seconds" parsed as timespan
						set slot 1 of {_gui} to iron nugget named "<#7cafbf>Mastery: Water Cycles" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPassive%nl%<#7cafbf>Increases <#ffef45> Shield Strength <#7cafbf>against%nl%<#7cafbf>targets above &f50%% <#7cafbf>health by &f%{_masteryBonus}%%%%nl%<#7cafbf>and <#ae78d0> Healing Done <#7cafbf>against targets%nl%<#7cafbf>below &f50%% <#7cafbf>health by &f%{_masteryBonus}%%%<#7cafbf>." with nbt from "{""minecraft:custom_model_data"":{floats:[14.0f]}}"
						set slot 10 of {_gui} to cyan dye named "<#7cafbf>Circle of Water" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPassive%nl%<#7cafbf>Healing surrounds your target with a%nl%&f <#8bbdf0>Circle of Water<#7cafbf>. <#7cafbf>Using &f <#8bbdf0>Healing Stream <#7cafbf>on%nl%<#7cafbf>an ally affected by &f <#8bbdf0>Circle of Water <#7cafbf>will%nl%<#7cafbf>detonate the circle, healing its target%nl%<#7cafbf>by &f%{_healcircle}% <#7cafbf>HP." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						set slot 19 of {_gui} to lapis lazuli named "<#7cafbf>Undertow"  with lore "&8Basic Ability%nl%&f%{_undertowCastTime}% cast%nl%&7Cooldown:  &f%{_undertowCD}%%nl%&7Use: &fRMB%nl%<#7cafbf>Deal &f%{_undertowDamage}% <#1ebbd7>Water <#7cafbf>damage to the target.%nl%<#7cafbf>You may use other spells while casting%nl%<#7cafbf>this ability." with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
						set slot 20 of {_gui} to blue dye named "<#7cafbf>Healing Stream" with lore "&8Basic Ability%nl%&f%{_charges}% Charges%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cd}%%nl%&7Use: &fRMB%nl%<#7cafbf>Sends a healing stream towards an ally.%nl%<#7cafbf>Upon reaching its target, the stream will%nl%<#7cafbf>restore &f%{_heal}% <#7cafbf>HP to the affected ally." with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 21 of {_gui} to clay ball named "<#7cafbf>Explosive Bubble" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdBubble}% | %{_cdtarget}% per target%nl%&7Use: &fRMB%nl%<#7cafbf>Wraps an ally in an explosive bubble, which%nl%<#7cafbf>absorbs &f%{_shield}% <#7cafbf>damage. <#7cafbf>After &f%{_wait}% sec<#7cafbf>, the bubble%nl%<#7cafbf>explodes, <#7cafbf>dealing &f%{_damage}% + (remaining shield value)%nl%<#7cafbf>as <#1ebbd7>Water <#7cafbf>damage to nearby enemies.%nl% %nl%<#7cafbf>When &f <#8bbdf0>Explosive Bubble <#7cafbf>is reapplied, the shield%nl%<#7cafbf>amount will be added to the existing shield,%nl%<#7cafbf>but the duration will not be refreshed." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						set slot 28 of {_gui} to light blue dye named "<#7cafbf>Reversal" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cdReversal}%%nl%&7Use: &fRMB%nl%<#7cafbf>Reverses all <#ffef45> Shields <#7cafbf>to <#ae78d0> Healing <#7cafbf>in a huge%nl%<#7cafbf>radius around the player. &f <#8bbdf0>Reversal <#7cafbf>dispels all%nl%&fCurse<#7cafbf>, &fDisease<#7cafbf>, &fMagic <#7cafbf>and &fPoison <#7cafbf>debuffs from%nl%<#7cafbf>affected allies." with nbt from "{""minecraft:custom_model_data"":{floats:[10.0f]}}"
						if string tag "Talents;Row 4" of {_customnbt} = "Coalescing Tides":
							set {_maxStacks} to 4
						else:
							set {_maxStacks} to 2
						if string tag "Talents;Row 2" of {_customnbt} is set:
							set slot 11 of {_gui} to white dye named "<#7cafbf>Tidal Waves" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPassive%nl%<#7cafbf>Casting &f <#8bbdf0>Explosive Bubble <#7cafbf>grants &f1 <#7cafbf>stack of%nl%&f <#8bbdf0>Tidal Waves<#7cafbf>. &f <#8bbdf0>Tidal Waves <#7cafbf>increases the healing%nl%<#7cafbf>of your next &f <#8bbdf0>Healing Stream <#7cafbf>by &f30%%<#7cafbf>. Stacks up%nl%<#7cafbf>to &f%{_maxStacks}% <#7cafbf>times." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
					else if uncolored (name of player's tool) = "Umbreon":
						set {_damage} to 5 + ({damage::%player%}/30) + (Versatility(player)/90) + ({primarystat::%player%}/20)
						set {_baseCd} to 3
						
						if string tag "Talents;Row 1" of {_customnbt} = "Quick Claw":
							set {_damage} to {_damage}*0.75
							set {_baseCd} to {_baseCd}*0.5
						else if string tag "Talents;Row 1" of {_customnbt} = "Heavy Claw":
							set {_damage} to {_damage}*1.875
							set {_baseCd} to {_baseCd}*1.25
						else if string tag "Talents;Row 1" of {_customnbt} = "Sharp Claw":
							set {_damage} to {_damage}*1.5
						set {_cd} to "%{_baseCd}/{_pospiech}% seconds" parsed as timespan
						set {_cdd} to {_baseCd}/{_pospiech}

						set {_cdMO} to 16/{_pospiech}
						set {_damageMO} to 2 + ({damage::%player%}/90) + (Versatility(player)/270 + {primarystat::%player%}/45)
						set {_radiusMO} to 3 + CrowdControlStat(player)/20

						if string tag "Talents;Row 3" of {_customnbt} = "Supermoon":
							set {_damageMO} to {_damageMO} * 5

						set {_cdEG} to "%600/{_pospiech}% seconds" parsed as timespan
						set {_range} to 3 + CrowdControlStat(player)/30

						set {_shadowClawsDMG} to 6 + ({damage::%player%}/12) + (Versatility(player)/36) + ({primarystat::%player%}/6)
						set {_shadowClawsDmgTotal} to 0
						set {_shadowClawsCD} to 30 seconds

						set {_garroteCd} to "%16/{_pospiech}% seconds" parsed as timespan
						set {_garroteDMG} to 1.25 + ({damage::%player%}/70) + (Versatility(player)/210) + ({primarystat::%player%}/35)
						if string tag "Talents;Row 4" of {_customnbt} = "Scent of Blood":
							set {_garroteDmg} to {_garroteDmg} * 1.2
						set {_garroteDur} to 18
						set {_garroteTickTime} to 2/{_pospiech}
						set {_garroteTotalDMG} to ({_garroteDur}/{_garroteTickTime})*{_garroteDmg}

						set {_mastery} to (0.15 + ((Mastery(player)/130)))
						if string tag "Talents;Row 2" of {_customnbt} = "Chosen of the Night":
							add 0.1 to {_mastery}

						set {_damageEndGame} to 50 + ({damage::%player%}/0.24) + (Versatility(player)/0.72) + ({primarystat::%player%}/0.12)
						set {_executionThreshold} to 25

						if string tag "Talents;Row 5" of {_customnbt} = "Inevitable End":
							add 5 to {_executionThreshold}
							set {_damageEndGame} to {_damageEndGame} * 1.25


						set slot 1 of {_gui} to charcoal named "<#555555>Mastery: Assassination" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#555555>Increases damage done%nl%<#555555>while &f <#999999>Invisible <#555555>by &f%{_mastery}*100%%%<#555555>." with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 10 of {_gui} to black dye named "<#555555>Night Hunter" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#555555>When <#999999>Umbreon <#555555>deals a <#999999>killing blow%nl%<#555555>to an enemy, she enters &f <#999999>Stealth%nl%<#555555>for &f5 sec<#555555>.%nl% %nl%<#555555>Deal &f10%% <#555555>increased damage during%nl%<#999999>Nighttime <#555555>(22:00 until 4:00 CEST)." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						set slot 19 of {_gui} to blaze rod named "<#555555>Night Slash" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdd}% seconds%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>slashes her target with her claw%nl%<#555555>at short range, dealing &f%{_damage}% <#333333>Dark <#555555>damage.%nl% %nl%<#555555>The enemy will take &f7.5%% <#555555>increased damage%nl%<#555555>from your upcoming &f <#999999>Night Slash <#555555>attacks%nl%<#555555>for the next &f6 sec<#555555>. This effect stacks." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 20 of {_gui} to glowstone dust named "<#555555>Moonlight Orb" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdMO}% seconds%nl%&7Radius area: &f%{_radiusMO}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>creates a zone of &f <#999999>Moonlight <#555555>at the%nl%<#555555>target location, inflicting &f%{_damageMO}% <#d9d5a7>Moonlight <#555555>damage to%nl%<#555555>enemies caught in its radius and <#999999> Slowing%nl%<#555555>them by &f30%% <#555555>until they leave the area.%nl% %nl%<#999999>Umbreon<#555555> becomes &f <#999999>Invisible <#555555>while she%nl%<#555555>remains inside a &f <#999999>Moonlight <#555555>zone.%nl% %nl%&f <#999999>Moonlight <#555555>zones last &f8 sec<#555555>." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 21 of {_gui} to iron ingot named "<#555555>Garrote" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_garroteCd}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>garrotes the enemy, causing the%nl%<#555555>target to <#999999>Bleed <#555555>for &f%{_garroteDMG}% <#333333>Dark <#555555>every &f%{_garroteTickTime}% sec%nl%<#555555>for a total of &f%{_garroteTotalDMG}% <#333333>Dark <#555555>damage over &f%{_garroteDur}% sec<#555555>.%nl% %nl%<#555555>This ability increases all <#999999>damage taken <#555555>by%nl%<#555555>the target from your abilities by &f10%% <#555555>for%nl%<#555555>its duration." with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
						set slot 28 of {_gui} to glow ink sac named "<#555555>End Game" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdEG}%%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>attempts to <#999999>execute <#555555>all enemies%nl%<#555555>below &f%{_executionThreshold}%%% <#999999>health <#555555>in an enormous radius.%nl% %nl%<#555555>All enemies in range are <#999999> Blinded%nl%<#555555>for &f10 sec<#555555>.%nl% %nl%<#555555>This ability instead deals &f%{_damageEndGame}% <#333333>Dark <#555555>damage%nl%<#555555>to all <#999999>Boss <#555555>enemies." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 29 of {_gui} to purple dye named "<#555555>Shadow Claws" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_shadowClawsCD}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>draws upon the surrounding shadows to%nl%<#999999>empower <#555555>her claws and deal &f%{_shadowClawsDMG}% <#333333>Dark <#555555>damage for%nl%<#555555>each &f <#999999>Damage Amp <#555555>effect applied <#999999>on the target%nl%<#555555>by her abilities.%nl% %nl%<#555555>Deals a total of &f%{_shadowClawsDmgTotal}% <#333333>Dark <#555555>damage against your%nl%<#555555>current target.%nl% %nl%<#555555>This ability consumes all &f <#999999>Damage Modifications%nl%<#555555>used to <#999999>empower <#555555>the ability in the process." with nbt from "{""minecraft:custom_model_data"":{floats:[12.0f]}}"

						if string tag "Talents;Row 3" of {_customnbt} = "Shadowstep":
							set {_shadowstepCd} to "%20/{_pospiech}% seconds" parsed as timespan
							set {_shadowstepDmg} to 2 + ({damage::%player%}/100 + Versatility(player)/300 + {primarystat::%player%}/50)
							set {_shadowstepDmgIncrease} to 8
							set {_shadowstepDuration} to 6
							set {_shadowstepRange} to 6 + CrowdControlStat(player)/30
							set slot 22 of {_gui} to black dye named "<#555555>Shadowstep" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_shadowstepCd}%%nl%&7Range: &f%{_shadowstepRange}% blocks%nl%&7Use: &fRMB%nl%<#999999>Blink <#555555>behind a target, dealing &f%{_shadowstepDmg}% <#333333>Dark%nl%<#555555>damage and increasing <#999999>all damage they%nl%<#999999>take <#555555>from you by &f%{_shadowstepDmgIncrease}%%% <#555555>for &f%{_shadowstepDuration}% sec<#555555>." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						
						else if string tag "Talents;Row 3" of {_customnbt} = "Vanish":
							set {_vanishCd} to "%30/{_pospiech}% seconds" parsed as timespan
							set {_vanishDuration} to 10
							set {_vanishMovementSpeed} to 50
							set slot 22 of {_gui} to black dye named "<#555555>Vanish" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_vanishCd}%%nl%&7Use: &fRMB%nl%<#555555>Blend into the shadows, <#999999>vanishing <#555555>from%nl%<#555555>sight and becoming &f <#999999>Invisible <#555555>for &f%{_vanishDuration}% sec<#555555>.%nl% %nl%&f <#999999>Vanish <#555555>increases your <#999999> Movement%nl%<#999999>Speed <#555555>by &f%{_vanishMovementSpeed}%%% <#555555>for the duration." with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"

					else if uncolored (name of player's tool) = "Shaymin":
						set {_cdUlt} to 30 seconds
						set {_masteryHeal} to 0.6
						set {_masteryDamage} to 1.2
						set {_masteryChance} to 12.5

						set {_bonusDMG} to 12
						set {_utilityGain} to 50
						set {_mobilityGain} to 70

						set {_seedFlareCD} to 8 seconds
						set {_seedFlareCastTime} to 2 seconds
						set {_seedFlareCast} to "%{_seedFlareCastTime}%"
						set {_seedFlareRadius} to 6 + CrowdControlStat(player)/20
						replace all "seconds" in {_seedFlareCast} with "second"

						set {_airSlashCD} to 5 seconds
						set {_airSlashRadius} to 4 + CrowdControlStat(player)/25
						set {_airSlashDMG} to damageScalingSpell(player, 3, 8)

						set {_seedFlareDMG} to 1
						set {_seedFlareHeal} to 2

						set {_skyBlastCast} to "%3/{_pospiech}% seconds" parsed as timespan
						replace all "seconds" in {_skyBlastCast} with "second"
						set {_skyBlastDMG} to 8
						set {_skyBlastCD} to 20 seconds
						set {_skyBlastRadius} to 3 + CrowdControlStat(player)/30

						set slot 1 of {_gui} to slime ball named "<#dbef9e>Mastery: Seed Barrage" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown:  &fnone%nl%&7Use: &fPassive%nl%<#dbef9e>When damaging or healing spells successfully%nl%<#dbef9e>hit their target, <#f8ffe3>Shaymin <#dbef9e>has a &f%{_masteryChance}%%% <#dbef9e>chance%nl%<#dbef9e>to fire a seed towards the affected target,%nl%<#dbef9e>dealing &f%{_masteryDamage}% <#607c3c>Nature <#dbef9e>damage to an enemy or%nl%<#dbef9e>restoring &f%{_masteryHeal}% <#dbef9e>HP to an ally." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 10 of {_gui} to lime dye named "<#dbef9e>Serene Grace" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown:  &fnone%nl%&7Use: &fPassive%nl%<#dbef9e>Gain a burst of stats on &f <#f8ffe3>Swap Forme%nl%<#dbef9e>for &f6 sec<#dbef9e>. The type of stat gained%nl%<#dbef9e>depends on the <#f8ffe3>Forme Shaymin <#dbef9e>swaps to.%nl%<#dbef9e>Stat gain can only trigger once per <#f8ffe3>Forme<#dbef9e>.%nl% %nl%&f <#f8ffe3>Land: <#ae78d0> +%{_utilityGain}% Utility%nl%&f <#f8ffe3>Sky: &f +%{_mobilityGain}% Mobility%nl% %nl%<#dbef9e>Gaining a new bonus overrides the%nl%<#dbef9e>current stat bonus from the active%nl%<#f8ffe3>forme.%nl% %nl%<#dbef9e>Deal &f%{_bonusDMG}%%% <#dbef9e>increased damage in%nl%<#f8ffe3>Sky Forme <#dbef9e>based on &f Mobility<#dbef9e>.%nl% %nl%<#f8ffe3>Shaymin <#dbef9e>is immune to fall damage." with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 19 of {_gui} to lime dye named "<#dbef9e>Seed Flare" with lore "&8Basic Ability%nl%&f%{_seedFlareCast}% cast%nl%&7Cooldown:  &f%{_seedFlareCD}%%nl%&7Radius: &f%{_seedFlareRadius}% blocks%nl%&7Use: &fRMB%nl%<#f8ffe3>Shaymin <#dbef9e>emits a seed shockwave from his%nl%<#dbef9e>body, dealing &f%{_seedFlareDMG}% <#607c3c>Nature <#dbef9e>damage to all%nl%<#dbef9e>enemies in a short radius and healing%nl%<#dbef9e>allies for &f0.5 HP<#dbef9e>.%nl% %nl%&fRequires Land Forme." with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 21 of {_gui} to sugar named "<#f8fff5>Air Slash" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_airslashCD}%%nl%&7Range: &f%{_airSlashRadius}% blocks%nl%&7Use: &fRMB%nl%<#f8fff5>Slashes the target with air, dealing &f%{_airSlashDMG}% Air%nl%<#f8fff5>damage. This ability deals &f20%% <#f8fff5>increased%nl%<#f8fff5>damage to airborne targets or targets%nl%<#f8fff5>vulnerable to the &fAir <#f8fff5>element.%nl% %nl%&fRequires Sky Forme." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 22 of {_gui} to white dye named "<#f8fff5>Sky Blast" with lore "&8Basic Ability%nl%&f%{_skyBlastCast}% cast%nl%&7Cooldown: &8 &f%{_skyBlastCD}%%nl%&7Radius of impact: &f%{_skyBlastRadius}% blocks%nl%&7Use: &fRMB%nl%<#f8fff5>Shoots out a giant ball of air, dealing %{_skyBlastDMG}% &fAir%nl%<#f8fff5>damage and knocking up all enemies caught%nl%<#f8fff5>in its radius of impact.%nl% %nl%<#f8fff5>Each cast of &fAir Slash <#f8fff5>reduces the%nl%<#f8fff5>cooldown of &fSky Blast <#f8fff5>by &f1.0 sec<#f8fff5>.%nl% %nl%&fRequires Sky Forme." with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						set slot 28 of {_gui} to feather named "<#dbef9e>Swap Forme" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cdUlt}%%nl%&7Use: &fRMB%nl%<#dbef9e>Activates <#f8ffe3>Sky Forme <#dbef9e>for the next &f15 sec<#dbef9e>,%nl%<#dbef9e>assuming the &fAir <#dbef9e>element, allowing <#f8ffe3>flight%nl%<#dbef9e>and granting <#f8ffe3>Shaymin <#dbef9e>a new set of abilities.%nl% %nl%<#f8ffe3>Shaymin <#dbef9e>may freely switch between <#f8ffe3>Formes%nl%<#dbef9e>while this ability is active. Swapping to a%nl%<#dbef9e>different <#f8ffe3>Forme <#dbef9e>does not refresh the %nl%<#dbef9e>duration of this ability.%nl% %nl%<#dbef9e>When this ability ends, <#f8ffe3>Shaymin <#dbef9e>reverts%nl%<#dbef9e>back to <#f8ffe3>Land Forme<#dbef9e>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
					else if uncolored (name of player's tool) = "Espeon":
						set {_intellectGain} to 0.5 + Mastery(player)/40
						set {_hasteGain} to 1.5 + Mastery(player)/16

						set {_psyWaveCd} to "%60/{_pospiech}% seconds" parsed as timespan
						set {_futureSightCd} to "%10/{_pospiech}% seconds" parsed as timespan
						set {_mindTransferCd} to "%5/{_pospiech}% seconds" parsed as timespan
						set {_hypercognitionCd} to 300 seconds
						set {_timeWarpCd} to 300 seconds

						set {_futureSightDamage} to 16 + (({damage::%player%}/3.5) + (Versatility(player)/10.5) + ({primarystat::%player%}/1.75))
						set {_futureSightFall} to "%20/{_pospiech}% sec"

						set {_mindTransferCastTime} to "%2/{_pospiech}% seconds" parsed as timespan
						set {_maxStacks} to 50
						set {_stacksAdd} to 1
						set {_radiusmindTransfer} to 30
						set {_radiusHypercognition} to 30
						set {_extraDurationAdd} to "10 sec"
						set {_silenceDuration} to "%2 + ({_crowdcontrol}/35)%"

						set {_timeWarpHaste} to 120
						set {_timeWarpDuration} to 40
						set {_timeWarpRadius} to 50

						set {_intHypercognition} to 4
						set {_dmgHypercognition} to 8 + (({damage::%player%}/6) + (Versatility(player)/18) + ({primarystat::%player%}/3))

						set {_loreFutureSight} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_futureSightCd}%%nl%&7Use: &fRMB%nl%<#d48bc3>Prepares an attack on a target enemy that%nl%<#d48bc3>deals &f%{_futureSightDamage}% <#d84af7>Psychic <#d48bc3>damage after &f%{_futureSightFall}%<#d48bc3>.%nl% %nl%<#d48bc3>If &f <#f7b2e7>Future Sight <#d48bc3>is used on an enemy that%nl%<#d48bc3>already has the spell <#d48bc3>applied on them, it%nl%<#d48bc3>refreshes the duration, but does not add%nl%<#d48bc3>a stack."

						set {_loremindTransfer3} to "<#d48bc3>If &f <#f7b2e7>Future Sight <#d48bc3>detonates while held by%nl%<#d48bc3>Espeon, they will take all &fdamage <#d48bc3>instead.%nl%<#d48bc3>Taking control of over &f%{_maxStacks}% stacks <#d48bc3>at once%nl%<#d48bc3>will overwhelm Espeon and cause their mind%nl%<#d48bc3>to explode."
						set {_loremindTransfer2} to "<#d48bc3>ability transfers all &f <#f7b2e7>Future Sight &fstacks%nl%<#d48bc3>from targets within &f%{_radiusmindTransfer}% blocks <#d48bc3>onto Espeon.%nl% %nl%<#d48bc3>The next &f <#f7b2e7>Future Sight <#d48bc3>used afterward%nl%<#d48bc3>will add &fall stacks <#d48bc3>from Espeon to the &fstack%nl%&fcount <#d48bc3>of the select target.%nl% %nl%%{_loremindTransfer3}%"
						set {_loremindTransfer} to "&8Basic Ability%nl%&fInstant cast &7| &f%{_mindTransferCastTime}% cast%nl%&7Cooldown:  &f%{_mindTransferCd}%%nl%&7Use: &fRMB &7| &fSNEAK + RMB%nl%<#d48bc3>Increases the &f <#f7b2e7>Future Sight &fstack count%nl%<#d48bc3>on the target by &f%{_stacksAdd}% <#d48bc3>and adds an additional%nl%&f%{_extraDurationAdd}% <#d48bc3>to the fall duration of the spell.%nl% %nl%<#d48bc3>If &f <#f7b2e7>Mind Transfer <#d48bc3>is used while &fsneaking<#d48bc3>, this%nl%%{_loremindTransfer2}%"
						set {_loreHypercognition2} to "<#d48bc3>When this ability &fends <#d48bc3>or Espeon &ffails <#d48bc3>to complete%nl%<#d48bc3>a task set, Espeon releases a psychic shockwave,%nl%<#d48bc3>dealing &f%{_dmgHypercognition}% <#d84af7>Psychic <#d48bc3>damage in a &f%{_radiusHypercognition}% block <#d48bc3>radius <#d48bc3>and%nl%<#d48bc3>gaining &f %{_intHypercognition}% <#f7b2e7>Intellect <#d48bc3>per &f <#f7b2e7>Hypercognition <#d48bc3>stack.%nl%<#d48bc3>On &ftask failure<#d48bc3>, receive &f50%% <#d48bc3>of the accumulated%nl%<#d48bc3>damage.%nl% %nl%&f <#f7b2e7>Hypercognition <#d48bc3>will pause &fall active &f <#f7b2e7>Future Sight%nl%<#d48bc3>effects and &fdisable ability usage <#d48bc3>for the duration.%nl%<#d48bc3>Espeon will become &finvulnerable <#d48bc3>during this spell.%nl% %nl%&f <#f7b2e7>Hypercognition State:%nl%<#d48bc3>Espeon will gain a &fspecified amount of time <#d48bc3>to complete%nl%<#d48bc3>a randomly selected &fset of tasks <#d48bc3>in order from &fleft%nl%&fto right<#d48bc3>. If all tasks are completed successfully,%nl%<#d48bc3>a new list of tasks is chosen and Espeon gains a%nl%&fstack <#d48bc3>of &f <#f7b2e7>Hypercognition<#d48bc3>."
						
						set slot 1 of {_gui} to purple dye named "<#d48bc3>Mastery: Mental Agility" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown:  &fnone%nl%&7Use: &fPASSIVE%nl%<#d48bc3>For each stack of &f <#f7b2e7>Future Sight <#d48bc3>that%nl%<#d48bc3>exists on the field, gain &f %{_intellectGain}% <#f7b2e7>Intellect%nl%<#d48bc3>and &f %{_hasteGain}% <#f7b2e7>Haste<#d48bc3>." with nbt from "{""minecraft:custom_model_data"":{floats:[11.0f]}}"
						set slot 10 of {_gui} to ender pearl named "<#d48bc3>Psy Wave" with lore "&8Passive Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_psyWaveCd}%%nl%&7Use: &fSNEAK + LMB%nl%<#d48bc3>Espeon can use &fsneak + left click <#d48bc3>to%nl%<#d48bc3>send out a psy wave towards an enemy%nl%<#d48bc3>and &fInterrupt <#d48bc3>their spell cast. &f <#f7b2e7>Psy Wave%nl%<#d48bc3>will additionally &f Silence <#d48bc3>the enemy for%nl%&f%{_silenceDuration}% sec <#d48bc3>on successful &fInterrupt<#d48bc3>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						
						set slot 19 of {_gui} to pink dye named "<#d48bc3>Future Sight" with lore {_loreFutureSight} with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
						set slot 20 of {_gui} to fermented spider eye named "<#d48bc3>Mind Transfer" with lore {_loremindTransfer} with nbt from "{""minecraft:custom_model_data"":{floats:[2.0f]}}"
						
						set slot 28 of {_gui} to magenta dye named "<#d48bc3>Hypercognition" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_hypercognitionCd}%%nl%&7Use: &fRMB%nl%<#d48bc3>Espeon enters a <#f7b2e7>state of &f <#f7b2e7>Hypercognition<#d48bc3>, gaining%nl%<#d48bc3>transcendental mental powers and allowing them to%nl%<#d48bc3>perform &fsequential tasks <#d48bc3>to gain increased power.%nl% %nl%%{_loreHypercognition2}%" with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 29 of {_gui} to glass bottle named "<#d48bc3>Time Warp" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_timeWarpCd}%%nl%&7Use: &fRMB%nl%<#d48bc3>Warp the flow of time, increasing &f <#f7b2e7>Haste%nl%<#d48bc3>by &f%{_timeWarpHaste}% <#d48bc3>for all party <#d48bc3>members for &f%{_timeWarpDuration}% sec<#d48bc3>.%nl% %nl%<#d48bc3>If the player is not in a party or no party%nl%<#d48bc3>members can be found, grant the &f <#f7b2e7>Haste%nl%<#d48bc3>bonus to all allies within &f%{_timeWarpRadius}% blocks <#d48bc3>instead." with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
					open {_gui} to player
					stop
			#COMBAT STATS

			#MISCELLANEOUS

			#TOPKI
			if index of event-slot is 4:
				if {language::%player%} = "English":
					set {_top} to "Top"
					set {_sl1} to "&7Top levels:"
					set {_sl6} to "&7Top stats:"
					set {_na1} to "%{kartacolor::%player%}%Card"
					set {_sl2} to "&7Top kills:"
					set {_sl5} to "&7Top deaths:"
					set {_na2} to "%{kartacolor::%player%}%Combat"
					set {_sl3} to "&7Top damage dealt:"
					set {_sl4} to "&7Top damage taken:"
					set {_na3} to "%{kartacolor::%player%}%Damage"
					set {_na4} to "%{kartacolor::%player%}%Power"
					set {_sl7} to "&7Top gems:"
					set {_sl8} to "&7Top ascenscions:"
					set {_sl9} to "&7Top damage healed:"
				else:
					set {_top} to "Topki"
					set {_sl1} to "&7Top poziomy:"
					set {_sl6} to "&7Top staty:"
					set {_na1} to "%{kartacolor::%player%}%Karta"
					set {_na2} to "%{kartacolor::%player%}%Combat"
					set {_sl2} to "&7Top zabójstwa:"
					set {_sl5} to "&7Top śmierci:"
					set {_sl3} to "&7Top zadane obrażenia:"
					set {_sl4} to "&7Top otrzymane obrażenia:"
					set {_na3} to "%{kartacolor::%player%}%Obrażenia"
					set {_na4} to "%{kartacolor::%player%}%Ulepszenia"
					set {_sl7} to "&7Top gemy:"
					set {_sl8} to "&7Top wyniesienia:"
					set {_sl9} to "&7Top wyleczone obrażenia:"
				set (metadata tag "topkigui" of player) to chest inventory with 1 row named "%{_top}% %player's held item's name%"
				set {_item} to type of player's tool with blank nbt compound
				delete tag "CustomModelData" of nbt compound of {_item}
				set slot 1 of (metadata tag "topkigui" of player) to {_item} named {_na1} with lore " " and {_sl1} and topDesc(3, "poziomkarta::%{kartaname::%player%}%") and " " and {_sl6} and topDesc(4, "stattotal::%{kartaname::%player%}%")
				set slot 3 of (metadata tag "topkigui" of player) to {_item} named {_na2} with lore " " and {_sl2} and topDesc(3, "mobskilled::%{kartaname::%player%}%") and " " and {_sl5} and topDesc(4, "deaths::%{kartaname::%player%}%")
				set slot 5 of (metadata tag "topkigui" of player) to {_item} named {_na3} with lore " " and {_sl3} and topDesc(3, "damage::dealt::%{kartaname::%player%}%") and " " and {_sl4} and topDesc(4, "damage::taken::%{kartaname::%player%}%")
				set slot 7 of (metadata tag "topkigui" of player) to {_item} named {_na4} with lore " " and {_sl7} and topDesc(3, "gemyequipped::%{kartaname::%player%}%") and " " and {_sl8} and topDesc(4, "wyniesienie::%{kartaname::%player%}%")
				if {kartaname::%player%} = "Vaporeon":
					if {healcard::%{kartaname::%player%}%::%{_id}%} is not set:
						set {healcard::%{kartaname::%player%}%::%{_id}%} to 0
					add " " and {_sl9} and topDesc(4, "healcard::%{kartaname::%player%}%") to lore of slot 5 of (metadata tag "topkigui" of player)
				open (metadata tag "topkigui" of player) to player
			#GEAR
			else if index of event-slot is 13:
				set metadata tag "gearcard" of player to chest inventory with 6 rows named "&fGear"
				if line 19 of lore of {karta::%player%} contains "Id: ":
					set {_id} to uncolored line 19 of lore of {karta::%player%}
					replace all "Id: " in {_id} with ""
					set {_card} to {kartaname::%player%}

					loop yaml node keys "Slot Map" in "GearList":
						set {_slotIndex} to loop-value parsed as integer
						set {_gearSlot} to yaml value "Slot Map.%loop-value%" in "GearList"
						set {_gearItem} to yaml value "Gear.%{_gearSlot}%" in "activeCard-%player%"

						if {_gearItem} is set:
							set lore of {_gearItem} to EquippedGearLoreUpdate(player, {_gearItem})
							set slot {_slotIndex} of metadata tag "gearcard" of player to {_gearItem}
							
					set {_relic} to yaml value "Gear.Relic" in "activeCard-%player%"
					if {_relic} is set:
						set lore of {_relic} to EquippedGearLoreUpdate(player, {_relic})
						set slot 43 of metadata tag "gearcard" of player to {_relic}
				open (metadata tag "gearcard" of player) to player
				play sound "block.anvil.use" with volume 2 and pitch 1.65 to player

	if player's current inventory is (metadata tag "abilitygui" of player):
		cancel event
		#ABILITIES
		if index of event-slot is between 0 and 35:
			if name of event-slot does not contain "Next Page" or "Last Page":
				if event-slot is not air:
					play sound "entity.armadillo.scute_drop" with volume 1 and pitch 1 to player
					set metadata tag "abilitymenu" of player to chest inventory with 1 rows named "%uncolored (name of player's tool)% - %uncolored (name of clicked slot)%"
					set {_gui} to metadata tag "abilitymenu" of player
					set {_ele} to line 17 of lore of player's tool
					replace all "&7Element: " in {_ele} with ""
					set {_color} to last string color code of {_ele}
					set {_ability::*} to "&8Basic Ability", "&8Mastery Bonus", "&8Passive Ability" and "&8Ultimate Ability"
					loop {_ability::*}:
						loop lore of clicked slot:
							if loop-value-2 = loop-value-1:
								set {_isAbility} to true
								stop loop
						if {_isAbility} is true:
							set {_slot} to clicked slot
							loop lore of {_slot}:
								stop loop if {_true} is true
								if loop-value-2 contains "&7Ability Level:":
									set {_true} to true
								add loop-value-2 to {_lorelines::*}
							set {_lore} to join {_lorelines::*} by nl
							set {_clickedSlot} to clicked slot with lore {_lore}
							set {_customNbtClickedSlot} to custom nbt of {_clickedSlot}
							set {_nbt} to (uncolored name of (clicked slot))
							replace all "Mastery: " in {_nbt} with ""
							set boolean tag {_nbt} of {_customNbtClickedSlot} to true
							set boolean tag "Ability" of {_customNbtClickedSlot} to true
							set metadata tag "ClickedAbility" of player to {_clickedSlot}
							stop loop
					clear {_lore}
					if uncolored (name of clicked slot) = "Mastery: Icicles":
						set {_lore} to "%nl%&7Level 1:%nl%%{_color}%Mastery Scaling:%nl%&7Lv. 0: &c1.25%% &7-> Lv. 1: &a1.33%%%nl% %nl%&e★ &7&oUpgrade cost:%nl%   %{_color}%30 %{_ele}% Essence%nl%   <#b5e550>200 Klejnot%nl%   <#f53b98>120 Tourmaline%nl%   <#ffe17a>800 Cosmic Flux"
					if uncolored (name of clicked slot) = "Shatter":
						set {_lore} to "%nl%&7Level 1:%nl%%{_color}%Critical strike chance against Frozen targets:%nl%&7Lv. 0: &c35%% &7-> Lv. 1: &a40%%%nl% %nl%&e★ &7&oUpgrade cost:%nl%   %{_color}%50 %{_ele}% Essence%nl%   <#b5e550>200 Klejnot%nl%   <#11d7d8>60 Aquamarine%nl%   <#ffe17a>800 Cosmic Flux"
					if uncolored (name of clicked slot) = "Icy Veins":
						set {_info} to "&f• &7Icy Veins' CD does not benefit from Haste." 
					set {_clickedAbilityName} to uncolored name of (metadata tag "ClickedAbility" of player)
					replace all "Mastery: " in {_clickedAbilityName} with ""
					set {_cardName} to uncolored name of player's tool
					if AbilityUpgradeable({_cardName}, {_clickedAbilityName}) is true:
						set slot 3 of {_gui} to (heart of the sea named "&bUpgrade Ability") with lore "&7Spend resources &7to upgrade this ability%nl%&7and increase its power." and {_lore}
					else:
						set slot 3 of {_gui} to gray stained glass pane named "&8Upgrade Unavailable" with lore "&7This ability cannot be upgraded."
					set slot 5 of {_gui} to (shulker shell named "&dObtain Ability") with lore "&7Click here to obtain the ability%nl%&7in case you've lost it or accidentally%nl%&7deleted it.%nl% %nl%&7&oKeep in mind that this ability is not%nl%&7&ousable without the %(name of player's tool)% &7&ocard."
					if AbilityUpgradeable({_cardName}, {_clickedAbilityName}) is true:
						set slot 4 of {_gui} to (magma cream named "&cModifiers") with lore "&7View the modifiers of this ability."
					else:
						set slot 4 of {_gui} to (gray stained glass pane named "&8Modifiers Unavailable") with lore "&7This ability has no upgradeable modifiers."
					if {_info} is set:
						set slot 6 of {_gui} to gunpowder named "Info" with lore {_info}
					open {_gui} to player
	if player's current inventory is (metadata tag "abilitymenu" of player):
		cancel event
		#ABILITIES
		if index of event-slot is between 0 and 8:
			if name of event-slot contains "&bUpgrade Ability":
				AbilityUpgradeMenu(player)
				play sound "block.enchantment_table.use" with volume 2 and pitch 1.4 to player
			else if index of event-slot = 4:
				AbilityModifiersMenu(player)
				play sound "block.amethyst_block.chime" with volume 2 and pitch 1.4 to player
			else if event-slot = shulker shell named "&dObtain Ability":
				set {_clickedAbility} to metadata tag "ClickedAbility" of player
				if cooldown "%uncolored name of {_clickedAbility}%-Obtain%player%" is finished:
					create cooldown "%uncolored name of {_clickedAbility}%-Obtain%player%" for 5 minutes
					set string tag "Card" of (custom nbt of {_clickedAbility}) to (uncolored name of (player's tool))
					give player {_clickedAbility}
				else:
					set {_cdd} to cooldown "%uncolored (name of {_clickedAbility})%-Obtain%player%"
					send "&c&oYou must wait &f&o%{_cdd}% &c&obefore you can obtain this ability again." to player
					play sound "entity.villager.no" with volume 2 and pitch 1 to player
				open metadata tag "abilitygui" of player to player
				play sound "entity.armadillo.scute_drop" with volume 1 and pitch 1.5 to player


	if player's current inventory is (metadata tag "abilityupgrademenu" of player):
		cancel event
		if event-slot = 16:
			set {_ability} to metadata tag "AbilityUpgradeAbility" of player
			set {_card} to metadata tag "AbilityUpgradeCard" of player
			set {_nextLevel} to metadata tag "AbilityUpgradeNextLevel" of player
			if AbilityUpgradeCanAfford(player, {_nextLevel}) is true:
				AbilityUpgradeTakeCost(player, {_nextLevel})
				AbilityUpgradeApply(player, {_card}, {_ability}, {_nextLevel})
				play sound "entity.player.levelup" with volume 3 and pitch 1.6 to player
				send "&a✦ Successfully upgraded &9%{_ability}% &ato &9Level %{_nextLevel}%&a!" to player
				loop all players:
					send "&a✦ &f%player% &aSuccessfully upgraded their &9%{_ability}% &aability to &9Level %{_nextLevel}%&a!" to player
				AbilityUpgradeMenu(player)
				play sound "ui.toast.challenge_complete" with volume 5 and pitch 2 at player
			else:
				play sound "entity.villager.no" with volume 2 and pitch 1 to player
				send "&cYou do not have enough materials to upgrade this ability." to player

	if player's current inventory is (metadata tag "abilitymodifiersmenu" of player):
		cancel event



function BuckshotAbilityPreviewLore(p: player, ability: text) :: text:
	set {_customnbt} to custom nbt of {karta::%{_p}%}
	set {_haste} to Haste({_p})
	set {_cc} to CrowdControlStat({_p})

	set {_mastery} to (180 + (Mastery({_p})/7.25))

	set {_cdPortals} to round((9/{_haste}), 1)
	set {_portalDuration} to 40
	set {_portalCharges} to 2
	set {_portalRange} to 4 + {_cc}/25
	set {_portalMaxBounces} to 3

	set {_bindingShotDamage} to 5 + ({damage::%{_p}%}/11) + (Versatility({_p})/33) + ({primarystat::%{_p}%}/5.5)
	if string tag "Talents;Row 5" of {_customnbt} = "Dimensional Damage":
		set {_portalDuration} to {_portalDuration} + 10
		set {_bindingShotDamage} to {_bindingShotDamage} * 1.5
	set {_bindingShotDuration} to 10
	set {_bindingShotDurationPull} to 10
	set {_bindingShotCooldown} to 25

	set {_damage} to 2 + ({damage::%{_p}%}/33) + (Versatility({_p})/99) + ({primarystat::%{_p}%}/16.5)
	set {_spreadShotArrows} to 5
	set {_spreadShotEffectiveness} to 60
	if boolean tag "Constellation;And For My Next Trick" of {_customnbt} is set:
		set {_spreadShotArrows} to {_spreadShotArrows} + 1
	if string tag "Talents;Row 1" of {_customnbt} = "Wideshot":
		set {_spreadShotArrows} to {_spreadShotArrows} + 1

	set {_goatDuration} to 20
	set {_goatCooldown} to 240
	set {_goatPortals} to 12
	if string tag "Talents;Row 3" of {_customnbt} = "Hail of Portals":
		set {_goatCooldown} to {_goatCooldown} - 60
		set {_goatPortals} to {_goatPortals} + 4
	set {_goatDistance} to 15

	if {_ability} = "Portal Mastery":
		return GetAbilityDescription({_p}, "Buckshot", "Portal Mastery", "MASTERY", {_mastery})
	else if {_ability} = "Mystic Shots":
		return GetAbilityDescription({_p}, "Buckshot", "Mystic Shots", "", 0)
	else if {_ability} = "Starbolt":
		set {_valueNames::*} to "DAMAGE", "ARROWS", "EFFECTIVENESS"
		set {_values::*} to {_damage}, {_spreadShotArrows}, {_spreadShotEffectiveness}
		return GetAbilityDescription({_p}, "Buckshot", "Starbolt", {_valueNames::*}, {_values::*})
	else if {_ability} = "Magic Portals":
		set {_valueNames::*} to "CHARGES", "COOLDOWN", "RANGE", "DURATION", "BOUNCES"
		set {_values::*} to {_portalCharges}, {_cdPortals}, {_portalRange}, {_portalDuration}, {_portalMaxBounces}
		return GetAbilityDescription({_p}, "Buckshot", "Magic Portals", {_valueNames::*}, {_values::*})
	else if {_ability} = "Binding Shot":
		set {_valueNames::*} to "COOLDOWN", "DURATION", "DURATIONPULL", "DAMAGE"
		set {_values::*} to {_bindingShotCooldown}, {_bindingShotDuration}, {_bindingShotDurationPull}, {_bindingShotDamage}
		return GetAbilityDescription({_p}, "Buckshot", "Binding Shot", {_valueNames::*}, {_values::*})
	else if {_ability} = "GOAT":
		set {_valueNames::*} to "COOLDOWN", "PORTALCOUNT", "DISTANCE", "DURATION"
		set {_values::*} to {_goatCooldown}, {_goatPortals}, {_goatDistance}, {_goatDuration}
		return GetAbilityDescription({_p}, "Buckshot", "GOAT", {_valueNames::*}, {_values::*})
	return ""

function GhazanAbilityPreviewLore(p: player, ability: text) :: text:
	if {_ability} = "Lava Technique":
		return GhazanLavaTechniqueDescription({_p})
	else if {_ability} = "Lava Surge":
		return GhazanLavaSurgeDescription({_p})
	else if {_ability} = "Lava Burst":
		return GhazanLavaBurstDescription({_p})
	else if {_ability} = "Molten Lava":
		return GhazanMoltenLavaDescription({_p})
	else if {_ability} = "Rain of Lava":
		return GhazanRainOfLavaDescription({_p})
	else if {_ability} = "Ascendance":
		return GhazanAscendanceDescription({_p})
	else if {_ability} = "Lava Wave":
		return GhazanLavaWaveDescription({_p})
	else if {_ability} = "Lavakeeper":
		return GhazanLavakeeperDescription({_p})
	else if {_ability} = "Lavafury":
		return GhazanLavafuryDescription({_p})
	return ""

function AbilityModifierLore(p: player, card: text, ability: text) :: text:
	set {_level} to AbilityUpgradeLevel({_p}, {_ability})
	set {_lore} to "&9Ability Modifiers%nl%&7Current Ability Level: &f%{_level}%%nl% %nl%&7These are the values held by%nl%&7this ability. Upgrading awakens%nl%&7stronger values for these modifiers.%nl% "
	loop yaml list "Card.%{_card}%.%{_ability}%.Upgrades.Display" in "SpellList":
		set {_entry::*} to loop-value split at "|"
		set {_label} to {_entry::1}
		set {_modifier} to {_entry::2}
		set {_format} to {_entry::3}
		set {_value} to AbilityUpgradeValue({_p}, {_card}, {_ability}, {_modifier}, {_level})
		set {_valueText} to AbilityUpgradeFormatValue({_value}, {_format})
		set {_lore} to "%{_lore}%%nl%&8✦ &7%{_label}%: &f%{_valueText}%"
	return {_lore}

function AbilityModifiersMenu(p: player):
	set {_card} to uncolored name of {_p}'s tool
	set {_ability} to uncolored name of (metadata tag "ClickedAbility" of {_p})
	replace all "Mastery: " in {_ability} with ""
	if AbilityUpgradeable({_card}, {_ability}) is not true:
		stop
	set metadata tag "abilitymodifiersmenu" of {_p} to chest inventory with 3 rows named "%{_card}% - %{_ability}% Modifiers"
	set {_gui} to metadata tag "abilitymodifiersmenu" of {_p}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
	set {_item} to metadata tag "ClickedAbility" of {_p}
	set lore of {_item} to AbilityModifierLore({_p}, {_card}, {_ability})
	set slot 13 of {_gui} to {_item}
	open {_gui} to {_p}

function AbilityUpgradeMaxLevel(card: text, ability: text) :: integer:
	set {_max} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Max Level" in "SpellList"
	if {_max} is not set:
		set {_max} to 5
	return {_max}

function AbilityUpgradeLevel(p: player, ability: text) :: integer:
	set {_level} to yaml value "Card.Ability Levels.%{_ability}%" in "activeCard-%{_p}%"
	if {_level} is not set:
		set {_level} to 0
	return {_level}

function AbilityUpgradeable(card: text, ability: text) :: boolean:
	set {_enabled} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Enabled" in "SpellList"
	if {_enabled} is true:
		return true
	return false

function AbilityUpgradeValue(p: player, card: text, ability: text, modifier: text, level: integer = -1) :: number:
	if {_level} < 0:
		set {_level} to AbilityUpgradeLevel({_p}, {_ability})
	set {_currentLevel} to AbilityUpgradeLevel({_p}, {_ability})
	if {_level} = {_currentLevel}:
		set {_value} to yaml value "Card.Ability Modifiers.%{_ability}%.%{_modifier}%" in "activeCard-%{_p}%"
	if {_value} is not set:
		set {_value} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Levels.%{_level}%.%{_modifier}%" in "SpellList"
	if {_value} is not set:
		set {_value} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Levels.0.%{_modifier}%" in "SpellList"
	if {_value} is not set:
		set {_value} to 0
	return {_value}

function AbilityUpgradeFormatValue(value: number, valueFormat: text) :: text:
	if {_valueFormat} = "scaling":
		set {_text} to "%round((1 / {_value}) * 100, 2)%%%"
	else if {_valueFormat} = "percent":
		set {_text} to "%{_value}%%%"
	else if {_valueFormat} = "multiplier":
		set {_text} to "%round({_value} * 100, 2)%%%"
	else if {_valueFormat} = "sec":
		set {_text} to "%{_value}% sec"
	else:
		set {_text} to "%{_value}%"
	return {_text}


function AbilityUpgradeDescription(p: player, card: text, ability: text, valueNames: texts, values: objects) :: text:
	set {_description::*} to yaml list "%{_card}%.%{_ability}%.Description" in "AbilityDescriptionList"
	set {_description} to (join {_description::*} by nl)

	set {_primCol} to getPrimaryCardColour({_p})
	set {_secCol} to getSecondaryCardColour({_p})

	replace all "{COLOUR:primary}" in {_description} with {_primCol}
	replace all "{COLOUR:secondary}" in {_description} with {_secCol}

	loop {_valueNames::*}:
		replace all "{%loop-value%}" in {_description} with "%{_values::%loop-counter%}%"

	set {_variant} to getCurrentVariant({_p}, {_card})
	set {_cardAbilities::*} to yaml node keys "Card.%{_card}%" in "SpellList"

	loop {_cardAbilities::*}:
		set {_icon} to yaml value "Card.%{_card}%.%loop-value%.Icons.%{_variant}%" in "SpellList"
		replace all "{ICON:%loop-value%}" in {_description} with {_icon}

	set {_description} to ReplaceTalentPlaceholders({_p}, {_card}, {_description})
	set {_description} to coloured {_description}
	return {_description}

function AbilityUpgradePreviewValue(value: object, colour: text, oldValue: object = "") :: text:
	if {_oldValue} is set:
		if "%{_oldValue}%" != "":
			if "%{_value}%" = "%{_oldValue}%":
				return "&f%{_value}%"
	return "%{_colour}%%{_value}%"

function GhazanAbilityUpgradePreviewLore(p: player, ability: text, level: integer, colour: text, compareLevel: integer = -1) :: text:
	set {_customnbt} to custom nbt of {karta::%{_p}%}
	set {_hasteTt} to Haste({_p})
	set {_levelLine} to "&9Level %{_level}%"

	if {_ability} = "Lava Technique":
		set {_mastery} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Technique", "MASTERY", {_level})
		set {_oldMastery} to {_mastery}
		if {_compareLevel} >= 0:
			set {_oldMastery} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Technique", "MASTERY", {_compareLevel})
		if string tag "Talents;Row 1" of {_customnbt} = "Advanced Technique":
			set {_mastery} to {_mastery} + 0.1
			set {_oldMastery} to {_oldMastery} + 0.1
		set {_mastery} to {_mastery} + getRunePower({_p}, "Thermal Buildup")
		set {_oldMastery} to {_oldMastery} + getRunePower({_p}, "Thermal Buildup")
		set {_maxStacks} to GhazanLavaTechniqueMaxStacks({_p})
		set {_maxDamage} to round(((1 + ({_mastery}/100))^{_maxStacks}) * 100, 2)
		set {_oldMaxDamage} to round(((1 + ({_oldMastery}/100))^{_maxStacks}) * 100, 2)
		set {_valueNames::*} to "MASTERY", "MAXSTACKS", "MAXDAMAGE", "DURATION"
		set {_values::*} to AbilityUpgradePreviewValue({_mastery}, {_colour}, {_oldMastery}), {_maxStacks}, AbilityUpgradePreviewValue({_maxDamage}, {_colour}, {_oldMaxDamage}), 16
		set {_description} to AbilityUpgradeDescription({_p}, "Ghazan", "Lava Technique", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Lava Surge":
		set {_chance} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Surge", "CHANCE", {_level})
		set {_oldChance} to {_chance}
		if {_compareLevel} >= 0:
			set {_oldChance} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Surge", "CHANCE", {_compareLevel})
		if string tag "Talents;Row 1" of {_customnbt} = "Hot Hand":
			set {_chance} to {_chance} + 2
			set {_oldChance} to {_oldChance} + 2
		if getTrait({_p}, "Lava Resurgence") is set:
			set {_chance} to {_chance} + 2.5
			set {_oldChance} to {_oldChance} + 2.5
		set {_chance} to {_chance} + getRunePower({_p}, "Seeping Lava")
		set {_oldChance} to {_oldChance} + getRunePower({_p}, "Seeping Lava")
		set {_valueNames::*} to "CHANCE"
		set {_values::*} to AbilityUpgradePreviewValue({_chance}, {_colour}, {_oldChance})
		set {_description} to AbilityUpgradeDescription({_p}, "Ghazan", "Lava Surge", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Lava Burst":
		set {_baseCd} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "COOLDOWN", {_level}) - getRunePower({_p}, "Igneous Flow")
		set {_oldBaseCd} to {_baseCd}
		if {_compareLevel} >= 0:
			set {_oldBaseCd} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "COOLDOWN", {_compareLevel}) - getRunePower({_p}, "Igneous Flow")
		set {_cooldown} to "%round({_baseCd} / {_hasteTt}, 1)% seconds" parsed as timespan
		set {_oldCooldown} to "%round({_oldBaseCd} / {_hasteTt}, 1)% seconds" parsed as timespan
		set {_castTime} to round(AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "CASTTIME", {_level}) / {_hasteTt}, 1)
		set {_oldCastTime} to {_castTime}
		if {_compareLevel} >= 0:
			set {_oldCastTime} to round(AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "CASTTIME", {_compareLevel}) / {_hasteTt}, 1)
		set {_scaling} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "DAMAGESCALING", {_level})
		set {_damage} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "BASEDAMAGE", {_level}) + ({damage::%{_p}%}/{_scaling}) + (Versatility({_p})/({_scaling} * 3)) + (PrimaryStat({_p})/({_scaling} / 2))
		set {_damage} to round({_damage} * (1 + getRunePower({_p}, "Core Intensity")), 2)
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "DAMAGESCALING", {_compareLevel})
			set {_oldDamageRaw} to AbilityUpgradeValue({_p}, "Ghazan", "Lava Burst", "BASEDAMAGE", {_compareLevel}) + ({damage::%{_p}%}/{_oldScaling}) + (Versatility({_p})/({_oldScaling} * 3)) + (PrimaryStat({_p})/({_oldScaling} / 2))
			set {_oldDamage} to round({_oldDamageRaw} * (1 + getRunePower({_p}, "Core Intensity")), 2)
		set {_valueNames::*} to "CASTTIME", "COOLDOWN", "DAMAGE"
		set {_values::*} to AbilityUpgradePreviewValue({_castTime}, {_colour}, {_oldCastTime}), AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage})
		set {_description} to AbilityUpgradeDescription({_p}, "Ghazan", "Lava Burst", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Molten Lava":
		set {_cooldown} to "%round(AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "COOLDOWN", {_level}) / {_hasteTt}, 1)% seconds" parsed as timespan
		set {_oldCooldown} to {_cooldown}
		if {_compareLevel} >= 0:
			set {_oldCooldown} to "%round(AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "COOLDOWN", {_compareLevel}) / {_hasteTt}, 1)% seconds" parsed as timespan
		set {_duration} to AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "DURATION", {_level})
		set {_oldDuration} to {_duration}
		if {_compareLevel} >= 0:
			set {_oldDuration} to AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "DURATION", {_compareLevel})
		set {_scaling} to AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "DAMAGESCALING", {_level})
		set {_damage} to round(AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "BASEDAMAGE", {_level}) + ({damage::%{_p}%}/{_scaling}) + (Versatility({_p})/({_scaling} * 3)) + (PrimaryStat({_p})/({_scaling} / 2)), 2)
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "DAMAGESCALING", {_compareLevel})
			set {_oldDamage} to round(AbilityUpgradeValue({_p}, "Ghazan", "Molten Lava", "BASEDAMAGE", {_compareLevel}) + ({damage::%{_p}%}/{_oldScaling}) + (Versatility({_p})/({_oldScaling} * 3)) + (PrimaryStat({_p})/({_oldScaling} / 2)), 2)
		set {_valueNames::*} to "COOLDOWN", "RADIUS", "DURATION", "DAMAGE", "TICKRATE"
		set {_values::*} to AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), round(2 + (CrowdControl({_p})/40), 2), AbilityUpgradePreviewValue({_duration}, {_colour}, {_oldDuration}), AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage}), GhazanMoltenLavaTickRate({_p})
		set {_description} to AbilityUpgradeDescription({_p}, "Ghazan", "Molten Lava", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Rain of Lava":
		set {_cooldown} to "%round(AbilityUpgradeValue({_p}, "Ghazan", "Rain of Lava", "COOLDOWN", {_level}) / {_hasteTt}, 1)% seconds" parsed as timespan
		set {_oldCooldown} to {_cooldown}
		if {_compareLevel} >= 0:
			set {_oldCooldown} to "%round(AbilityUpgradeValue({_p}, "Ghazan", "Rain of Lava", "COOLDOWN", {_compareLevel}) / {_hasteTt}, 1)% seconds" parsed as timespan
		set {_duration} to AbilityUpgradeValue({_p}, "Ghazan", "Rain of Lava", "DURATION", {_level})
		set {_oldDuration} to {_duration}
		if {_compareLevel} >= 0:
			set {_oldDuration} to AbilityUpgradeValue({_p}, "Ghazan", "Rain of Lava", "DURATION", {_compareLevel})
		if string tag "Talents;Row 1" of {_customnbt} = "Unrivaled Finesse":
			set {_duration} to {_duration} + 1.5
			set {_oldDuration} to {_oldDuration} + 1.5
		set {_valueNames::*} to "COOLDOWN", "DURATION", "INTERVAL"
		set {_values::*} to AbilityUpgradePreviewValue({_cooldown}, {_colour}, {_oldCooldown}), AbilityUpgradePreviewValue({_duration}, {_colour}, {_oldDuration}), GhazanRainOfLavaIntervalSeconds({_p})
		set {_description} to AbilityUpgradeDescription({_p}, "Ghazan", "Rain of Lava", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

function CresseliaAbilityUpgradePreviewLore(p: player, ability: text, level: integer, colour: text, compareLevel: integer = -1) :: text:
	set {_customnbt} to custom nbt of {karta::%{_p}%}
	set {_hasteTt} to Haste({_p})
	set {_levelLine} to "&9Level %{_level}%"

	if {_ability} = "Shooting Stars":
		set {_baseDamage} to (0.8 + (({damage::%{_p}%}/61) + (Versatility({_p})/183) + ({primarystat::%{_p}%}/30.5))) * (1 + (Mastery({_p})/108))
		set {_damage} to {_baseDamage} * AbilityUpgradeValue({_p}, "Cresselia", "Shooting Stars", "DAMAGE_MULTIPLIER", {_level})
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldDamage} to {_baseDamage} * AbilityUpgradeValue({_p}, "Cresselia", "Shooting Stars", "DAMAGE_MULTIPLIER", {_compareLevel})
		set {_chance} to 8 + getRunePower({_p}, "Astral Cascade")
		if boolean tag "Constellation;Stellar Command" of {_customnbt} is set:
			set {_chance} to {_chance} + 2
		if metadata value "CelestialAlignment" of {_p} is set:
			set {_chance} to {_chance} * (1 + (AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "SHOOTINGSTARSFREQUENCY") / 100))
			set {_damage} to {_damage} * 1.15
			set {_damage} to {_damage} * (1 + (AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "SHOOTINGSTARSDAMAGE") / 100))
			set {_oldDamage} to {_oldDamage} * 1.15
			set {_oldDamage} to {_oldDamage} * (1 + (AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "SHOOTINGSTARSDAMAGE") / 100))
		if metadata value "Solstice" of {_p} is set:
			set {_chance} to {_chance} * 3
		set {_astralPower} to AbilityUpgradeValue({_p}, "Cresselia", "Shooting Stars", "ASTRALPOWER", {_level})
		set {_oldAstralPower} to {_astralPower}
		if {_compareLevel} >= 0:
			set {_oldAstralPower} to AbilityUpgradeValue({_p}, "Cresselia", "Shooting Stars", "ASTRALPOWER", {_compareLevel})
		if string tag "Talents;Row 3" of {_customnbt} = "Whirling Stars":
			if {_astralPower} < 3:
				set {_astralPower} to 3
			if {_oldAstralPower} < 3:
				set {_oldAstralPower} to 3
			set {_damage} to {_damage} * 1.09
			set {_oldDamage} to {_oldDamage} * 1.09
		if string tag "Talents;Row 4" of {_customnbt} = "Stellar Collision":
			set {_damage} to {_damage} * 1.15
			set {_oldDamage} to {_oldDamage} * 1.15
		set {_valueNames::*} to "CHANCE", "DAMAGE", "ASTRALPOWER"
		set {_values::*} to AbilityUpgradePreviewValue({_chance}, {_colour}, {_chance}), AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage}), AbilityUpgradePreviewValue({_astralPower}, {_colour}, {_oldAstralPower})
		set {_description} to AbilityUpgradeDescription({_p}, "Cresselia", "Shooting Stars", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Boundless Moonlight":
		set {_apGen} to 3/{_hasteTt}
		set {_ap} to AbilityUpgradeValue({_p}, "Cresselia", "Boundless Moonlight", "AP", {_level}) * (1 + getRunePower({_p}, "Astral Flow") / 100)
		set {_oldAp} to {_ap}
		set {_invocChance} to AbilityUpgradeValue({_p}, "Cresselia", "Boundless Moonlight", "INVOCATIONCHANCE", {_level})
		set {_oldInvocChance} to {_invocChance}
		if {_compareLevel} >= 0:
			set {_oldAp} to AbilityUpgradeValue({_p}, "Cresselia", "Boundless Moonlight", "AP", {_compareLevel}) * (1 + getRunePower({_p}, "Astral Flow") / 100)
			set {_oldInvocChance} to AbilityUpgradeValue({_p}, "Cresselia", "Boundless Moonlight", "INVOCATIONCHANCE", {_compareLevel})
		set {_valueNames::*} to "APGEN", "AP", "INVOCATIONCHANCE"
		set {_values::*} to {_apGen}, AbilityUpgradePreviewValue({_ap}, {_colour}, {_oldAp}), AbilityUpgradePreviewValue({_invocChance}, {_colour}, {_oldInvocChance})
		set {_description} to AbilityUpgradeDescription({_p}, "Cresselia", "Boundless Moonlight", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Starfire":
		set {_baseCastTime} to AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "CASTTIME", {_level})
		set {_oldBaseCastTime} to {_baseCastTime}
		set {_scaling} to AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "DAMAGESCALING", {_level})
		set {_oldScaling} to {_scaling}
		if {_compareLevel} >= 0:
			set {_oldBaseCastTime} to AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "CASTTIME", {_compareLevel})
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "DAMAGESCALING", {_compareLevel})
		set {_castTime} to round(({_baseCastTime} / {_hasteTt}), 1)
		set {_oldCastTime} to round(({_oldBaseCastTime} / {_hasteTt}), 1)
		set {_damage} to AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "BASEDAMAGE", {_level}) + ({damage::%{_p}%}/{_scaling}) + (Versatility({_p})/({_scaling} * 3)) + ({primarystat::%{_p}%}/({_scaling} / 2))
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldDamage} to AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "BASEDAMAGE", {_compareLevel}) + ({damage::%{_p}%}/{_oldScaling}) + (Versatility({_p})/({_oldScaling} * 3)) + ({primarystat::%{_p}%}/({_oldScaling} / 2))
		if metadata value "CelestialAlignment" of {_p} is set:
			if string tag "Talents;Row 3" of {_customnbt} = "Aetherial Kindling":
				set {_damage} to {_damage} * 1.15
				set {_oldDamage} to {_oldDamage} * 1.15
		if metadata value "AstronomicalImpact" of {_p} is set:
			set {_damagePreview} to {_damage} * 1.6
			set {_oldDamagePreview} to {_oldDamage} * 1.6
		else:
			set {_damagePreview} to {_damage}
			set {_oldDamagePreview} to {_oldDamage}
		set {_aoeDamage} to {_damagePreview} * (AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "AOE", {_level}) / 100)
		set {_oldAoeDamage} to {_aoeDamage}
		if {_compareLevel} >= 0:
			set {_oldAoeDamage} to {_oldDamagePreview} * (AbilityUpgradeValue({_p}, "Cresselia", "Starfire", "AOE", {_compareLevel}) / 100)
		if string tag "Talents;Row 3" of {_customnbt} = "Aetherial Kindling":
			if metadata value "CelestialAlignment" of {_p} is set:
				set {_aoeDamage} to {_aoeDamage} * 1.3
				set {_oldAoeDamage} to {_oldAoeDamage} * 1.3
		set {_valueNames::*} to "CASTTIME", "DAMAGE", "AOEDAMAGE"
		set {_values::*} to AbilityUpgradePreviewValue({_castTime}, {_colour}, {_oldCastTime}), AbilityUpgradePreviewValue({_damagePreview}, {_colour}, {_oldDamagePreview}), AbilityUpgradePreviewValue({_aoeDamage}, {_colour}, {_oldAoeDamage})
		set {_description} to AbilityUpgradeDescription({_p}, "Cresselia", "Starfire", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Starsurge":
		set {_cost} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "COST", {_level})
		set {_oldCost} to {_cost}
		if {_compareLevel} >= 0:
			set {_oldCost} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "COST", {_compareLevel})
		if string tag "Talents;Row 2" of {_customnbt} = "Astral Communion":
			if metadata value "CelestialAlignment" of {_p} is set:
				set {_cost} to {_cost} - 10
				set {_oldCost} to {_oldCost} - 10
				if {_cost} < 0:
					set {_cost} to 0
				if {_oldCost} < 0:
					set {_oldCost} to 0
		set {_scaling} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "DAMAGESCALING", {_level})
		set {_oldScaling} to {_scaling}
		if {_compareLevel} >= 0:
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "DAMAGESCALING", {_compareLevel})
		set {_damage} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "BASEDAMAGE", {_level}) + ({damage::%{_p}%}/{_scaling}) + (Versatility({_p})/({_scaling} * 3)) + ({primarystat::%{_p}%}/({_scaling} / 2))
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldDamage} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "BASEDAMAGE", {_compareLevel}) + ({damage::%{_p}%}/{_oldScaling}) + (Versatility({_p})/({_oldScaling} * 3)) + ({primarystat::%{_p}%}/({_oldScaling} / 2))
		if boolean tag "Constellation;Rattle the Stars" of {_customnbt} is set:
			set {_cost} to {_cost} * 0.9
			set {_oldCost} to {_oldCost} * 0.9
			set {_damage} to {_damage} * 1.08
			set {_oldDamage} to {_oldDamage} * 1.08
		if metadata value "CelestialAlignment" of {_p} is set:
			set {_damage} to {_damage} * 1.15
			set {_oldDamage} to {_oldDamage} * 1.15
		if metadata value "UmbralInspiration" of {_p} is set:
			set {_damage} to {_damage} * 1.3
			set {_oldDamage} to {_oldDamage} * 1.3
		set {_amp} to ((AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "AMPBASE", {_level}) / 100) + getRunePower({_p}, "Stellar Compression")) + (0.25 * (Haste({_p}) - 1))
		set {_oldAmp} to {_amp}
		if {_compareLevel} >= 0:
			set {_oldAmp} to ((AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "AMPBASE", {_compareLevel}) / 100) + getRunePower({_p}, "Stellar Compression")) + (0.25 * (Haste({_p}) - 1))
		set {_maxStacks} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "MAXSTACKS", {_level})
		set {_oldMaxStacks} to {_maxStacks}
		if {_compareLevel} >= 0:
			set {_oldMaxStacks} to AbilityUpgradeValue({_p}, "Cresselia", "Starsurge", "MAXSTACKS", {_compareLevel})
		if boolean tag "Constellation;Stellar Amplification" of {_customnbt} is set:
			set {_maxStacks} to 4
			set {_oldMaxStacks} to 4
		set {_valueNames::*} to "COST", "DAMAGE", "AMP", "MAXSTACKS"
		set {_ampPreview} to {_amp} * 100
		set {_oldAmpPreview} to {_oldAmp} * 100
		set {_values::*} to AbilityUpgradePreviewValue({_cost}, {_colour}, {_oldCost}), AbilityUpgradePreviewValue({_damage}, {_colour}, {_oldDamage}), AbilityUpgradePreviewValue({_ampPreview}, {_colour}, {_oldAmpPreview}), AbilityUpgradePreviewValue({_maxStacks}, {_colour}, {_oldMaxStacks})
		set {_description} to AbilityUpgradeDescription({_p}, "Cresselia", "Starsurge", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Starfall":
		set {_cost} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "COST", {_level})
		set {_oldCost} to {_cost}
		if {_compareLevel} >= 0:
			set {_oldCost} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "COST", {_compareLevel})
		if string tag "Talents;Row 2" of {_customnbt} = "Astral Communion":
			if metadata value "CelestialAlignment" of {_p} is set:
				set {_cost} to {_cost} - 10
				set {_oldCost} to {_oldCost} - 10
				if {_cost} < 0:
					set {_cost} to 0
				if {_oldCost} < 0:
					set {_oldCost} to 0
		if boolean tag "Constellation;Rattle the Stars" of {_customnbt} is set:
			set {_cost} to {_cost} * 0.9
			set {_oldCost} to {_oldCost} * 0.9

		set {_duration} to 8 + getRunePower({_p}, "Astral Rain")

		if string tag "Talents;Row 4" of {_customnbt} = "Hail of Stars":
			set {_duration} to {_duration} + 3
			set {_starfallHaste} to Haste({_p}, 3.6)
		else:
			set {_starfallHaste} to Haste({_p})
		if boolean tag "Constellation;Stellar Amplification" of {_customnbt} is set:
			set {_duration} to {_duration} + 3

		set {_durationScalarStrength} to 0.22
		set {_scaling} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "DAMAGESCALING", {_level})
		set {_oldScaling} to {_scaling}
		if {_compareLevel} >= 0:
			set {_oldScaling} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "DAMAGESCALING", {_compareLevel})
		set {_damage} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "BASEDAMAGE", {_level}) + ({damage::%{_p}%}/{_scaling}) + (Versatility({_p})/({_scaling} * 3)) + ({primarystat::%{_p}%}/({_scaling} / 2))
		set {_oldDamage} to {_damage}
		if {_compareLevel} >= 0:
			set {_oldDamage} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "BASEDAMAGE", {_compareLevel}) + ({damage::%{_p}%}/{_oldScaling}) + (Versatility({_p})/({_oldScaling} * 3)) + ({primarystat::%{_p}%}/({_oldScaling} / 2))
		set {_damage} to {_damage} * {_durationScalar}
		set {_oldDamage} to {_oldDamage} * {_oldDurationScalar}
		if metadata value "CelestialAlignment" of {_p} is set:
			set {_damage} to {_damage} * 1.15
			set {_oldDamage} to {_oldDamage} * 1.15
		if metadata value "UmbralInspiration" of {_p} is set:
			set {_damage} to {_damage} * 1.3
			set {_oldDamage} to {_oldDamage} * 1.3
		if string tag "Talents;Row 2" of {_customnbt} = "Stellar Drift":
			set {_damage} to {_damage} * 1.3
			set {_oldDamage} to {_oldDamage} * 1.3
		if boolean tag "Constellation;Rattle the Stars" of {_customnbt} is set:
			set {_damage} to {_damage} * 1.08
			set {_oldDamage} to {_oldDamage} * 1.08
		set {_ticks} to rounded ({_duration} / (1 / {_starfallHaste}))
		set {_oldTicks} to rounded ({_oldDuration} / (1 / {_starfallHaste}))
		set {_damageTotal} to {_damage} * {_ticks}
		set {_oldDamageTotal} to {_oldDamage} * {_oldTicks}
		set {_aoe} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "AOE", {_level})
		set {_oldAoe} to {_aoe}
		if {_compareLevel} >= 0:
			set {_oldAoe} to AbilityUpgradeValue({_p}, "Cresselia", "Starfall", "AOE", {_compareLevel})
		set {_valueNames::*} to "COST", "DAMAGE", "DURATION", "AOE"
		set {_values::*} to AbilityUpgradePreviewValue({_cost}, {_colour}, {_oldCost}), AbilityUpgradePreviewValue({_damageTotal}, {_colour}, {_oldDamageTotal}), AbilityUpgradePreviewValue({_duration}, {_colour}, {_oldDuration}), AbilityUpgradePreviewValue({_aoe}, {_colour}, {_oldAoe})
		set {_description} to AbilityUpgradeDescription({_p}, "Cresselia", "Starfall", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	else if {_ability} = "Celestial Alignment":
		set {_cdSeconds} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "COOLDOWN", {_level})
		set {_oldCdSeconds} to {_cdSeconds}
		if {_compareLevel} >= 0:
			set {_oldCdSeconds} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "COOLDOWN", {_compareLevel})
		set {_cd} to "%{_cdSeconds}% seconds" parsed as timespan
		set {_oldCd} to "%{_oldCdSeconds}% seconds" parsed as timespan
		if boolean tag "Constellation;The Eternal Moon" of {_customnbt} is set:
			set {_cd} to {_cd} - 30 seconds
			set {_oldCd} to {_oldCd} - 30 seconds
		set {_ap} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "ASTRALPOWER", {_level})
		set {_crit} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "CRIT", {_level})
		set {_frequency} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "SHOOTINGSTARSFREQUENCY", {_level})
		set {_damageBonus} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "SHOOTINGSTARSDAMAGE", {_level})
		set {_oldAp} to {_ap}
		set {_oldCrit} to {_crit}
		set {_oldFrequency} to {_frequency}
		set {_oldDamageBonus} to {_damageBonus}
		if {_compareLevel} >= 0:
			set {_oldAp} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "ASTRALPOWER", {_compareLevel})
			set {_oldCrit} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "CRIT", {_compareLevel})
			set {_oldFrequency} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "SHOOTINGSTARSFREQUENCY", {_compareLevel})
			set {_oldDamageBonus} to AbilityUpgradeValue({_p}, "Cresselia", "Celestial Alignment", "SHOOTINGSTARSDAMAGE", {_compareLevel})
		set {_valueNames::*} to "COOLDOWN", "ASTRALPOWER", "CRIT", "DURATION", "SHOOTINGSTARSFREQUENCY", "SHOOTINGSTARSDAMAGE"
		set {_values::*} to AbilityUpgradePreviewValue({_cd}, {_colour}, {_oldCd}), AbilityUpgradePreviewValue({_ap}, {_colour}, {_oldAp}), AbilityUpgradePreviewValue({_crit}, {_colour}, {_oldCrit}), AbilityUpgradePreviewValue(20, {_colour}, 20), AbilityUpgradePreviewValue({_frequency}, {_colour}, {_oldFrequency}), AbilityUpgradePreviewValue({_damageBonus}, {_colour}, {_oldDamageBonus})
		set {_description} to AbilityUpgradeDescription({_p}, "Cresselia", "Celestial Alignment", {_valueNames::*}, {_values::*})
		return "%{_levelLine}%%nl%%{_description}%"

	return AbilityUpgradeModifierLore({_p}, "Cresselia", {_ability}, {_level}, {_colour})

function AbilityUpgradeModifierLore(p: player, card: text, ability: text, level: integer, colour: text, bold: boolean = false, compareLevel: integer = -1) :: text:
	if {_bold} = true:
		set {_lore} to "&9Level %{_level}% &8(Max)"
	else:
		set {_lore} to "&9Level %{_level}%"
	loop yaml list "Card.%{_card}%.%{_ability}%.Upgrades.Display" in "SpellList":
		set {_entry::*} to loop-value split at "|"
		set {_label} to {_entry::1}
		set {_modifier} to {_entry::2}
		set {_format} to {_entry::3}
		set {_value} to AbilityUpgradeValue({_p}, {_card}, {_ability}, {_modifier}, {_level})
		set {_valueText} to AbilityUpgradeFormatValue({_value}, {_format})
		if {_compareLevel} >= 0:
			set {_oldValue} to AbilityUpgradeValue({_p}, {_card}, {_ability}, {_modifier}, {_compareLevel})
			set {_oldValueText} to AbilityUpgradeFormatValue({_oldValue}, {_format})
			set {_lore} to "%{_lore}%%nl%&7%{_label}%: &e%{_oldValueText}% &f-> &a%{_valueText}%"
		else if {_bold} = true:
			set {_lore} to "%{_lore}%%nl%&7%{_label}%: %{_colour}%%{_valueText}%"
		else:
			set {_lore} to "%{_lore}%%nl%&7%{_label}%: %{_colour}%%{_valueText}%"
	return {_lore}

function AbilityUpgradeItem(p: player, card: text, ability: text, level: integer, colour: text, bold: boolean = false, compareLevel: integer = -1) :: item:
	set {_item} to metadata tag "AbilityUpgradeClickedAbility" of {_p}
	if {_card} = "Cresselia":
		set lore of {_item} to CresseliaAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else if {_card} = "Ghazan":
		set lore of {_item} to GhazanAbilityUpgradePreviewLore({_p}, {_ability}, {_level}, {_colour}, {_compareLevel})
	else:
		set lore of {_item} to AbilityUpgradeModifierLore({_p}, {_card}, {_ability}, {_level}, {_colour}, {_bold}, {_compareLevel})
	return {_item}

function AbilityUpgradePrismCost(level: integer) :: integer:
	if {_level} >= 5:
		return 2
	return 1

function AbilityUpgradeCostLore(level: integer) :: text:
	set {_prismCost} to AbilityUpgradePrismCost({_level})
	set {_essenceCost} to 40 + (({_level} - 1) * 10)
	set {_fluxCost} to 500 * {_level}
	set {_peridotCost} to 30 * {_level}
	return "&7Cost:%nl%&f%{_prismCost}% <##f79eff>Magic <##9ed5ff>Prism%nl%&f%{_essenceCost}% <#a99afc>Astral Essence%nl%&f%{_fluxCost}% &f &7Cosmic Flux%nl%&f%{_peridotCost}% <#c0ff02>Peridot"

function AbilityUpgradeCanAfford(p: player, level: integer) :: boolean:
	set {_prismCost} to AbilityUpgradePrismCost({_level})
	set {_essenceCost} to 40 + (({_level} - 1) * 10)
	set {_fluxCost} to 500 * {_level}
	set {_peridotCost} to 30 * {_level}
	set {_peridotItem} to yaml value "Peridot.Item" in "ItemList"
	set {_essenceItem} to yaml value "Astral Essence.Item" in "ItemList"
	if {_p} has {_prismCost} of {magicznypryzmat}:
		if {_p} has {_essenceCost} of {_essenceItem}:
			if {_p} has {_peridotCost} of {_peridotItem}:
				if {cosmicflux::%{_p}%} >= {_fluxCost}:
					return true
	return false

function AbilityUpgradeTakeCost(p: player, level: integer):
	set {_prismCost} to AbilityUpgradePrismCost({_level})
	set {_essenceCost} to 40 + (({_level} - 1) * 10)
	set {_fluxCost} to 500 * {_level}
	set {_peridotCost} to 30 * {_level}
	set {_peridotItem} to yaml value "Peridot.Item" in "ItemList"
	set {_essenceItem} to yaml value "Astral Essence.Item" in "ItemList"
	remove {_prismCost} of {magicznypryzmat} from {_p}'s inventory
	remove {_essenceCost} of {_essenceItem} from {_p}'s inventory
	remove {_peridotCost} of {_peridotItem} from {_p}'s inventory
	set {cosmicflux::%{_p}%} to {cosmicflux::%{_p}%} - {_fluxCost}

function AbilityUpgradeApply(p: player, card: text, ability: text, level: integer):
	loop yaml node keys "Card.%{_card}%.%{_ability}%.Upgrades.Levels.%{_level}%" in "SpellList":
		set {_value} to yaml value "Card.%{_card}%.%{_ability}%.Upgrades.Levels.%{_level}%.%loop-value%" in "SpellList"
		set yaml value "Card.Ability Modifiers.%{_ability}%.%loop-value%" in "activeCard-%{_p}%" to {_value}
	set yaml value "Card.Ability Levels.%{_ability}%" in "activeCard-%{_p}%" to {_level}
	save yaml "activeCard-%{_p}%"

function AbilityUpgradeMenu(p: player):
	if metadata tag "ClickedAbility" of {_p} is set:
		set {_card} to uncolored name of {_p}'s tool
		set {_ability} to uncolored name of (metadata tag "ClickedAbility" of {_p})
		replace all "Mastery: " in {_ability} with ""
		set metadata tag "AbilityUpgradeAbility" of {_p} to {_ability}
		set metadata tag "AbilityUpgradeCard" of {_p} to {_card}
		set metadata tag "AbilityUpgradeClickedAbility" of {_p} to metadata tag "ClickedAbility" of {_p}
	else:
		set {_ability} to metadata tag "AbilityUpgradeAbility" of {_p}
		set {_card} to metadata tag "AbilityUpgradeCard" of {_p}
	if AbilityUpgradeable({_card}, {_ability}) is not true:
		stop
	set metadata tag "abilityupgrademenu" of {_p} to chest inventory with 3 rows named "%{_card}% - Upgrade %{_ability}%"
	set {_gui} to metadata tag "abilityupgrademenu" of {_p}
	set {_level} to AbilityUpgradeLevel({_p}, {_ability})
	set {_maxLevel} to AbilityUpgradeMaxLevel({_card}, {_ability})
	if {_level} >= {_maxLevel}:
		set slot 10 of {_gui} to AbilityUpgradeItem({_p}, {_card}, {_ability}, {_level}, "&f", true)
		set slot 16 of {_gui} to blue stained glass pane named "<#8bbdf0>Fully Awakened" with lore "&7This ability has reached its current%nl%&7celestial apex. Its power sleeps no%nl%&7longer, though the stars may answer%nl%&7in a future calling."
	else:
		set {_nextLevel} to {_level} + 1
		set metadata tag "AbilityUpgradeNextLevel" of {_p} to {_nextLevel}
		set slot 10 of {_gui} to AbilityUpgradeItem({_p}, {_card}, {_ability}, {_level}, "&f")
		set slot 13 of {_gui} to AbilityUpgradeItem({_p}, {_card}, {_ability}, {_nextLevel}, "&a", false, {_level})
		set {_confirmLore} to "&7Upgrade &f%{_ability}% &7to &fLevel %{_nextLevel}%&7.%nl% %nl%%AbilityUpgradeCostLore({_nextLevel})%"
		if AbilityUpgradeCanAfford({_p}, {_nextLevel}) is true:
			set slot 16 of {_gui} to lime stained glass pane named "&aAwaken Power" with lore "%{_confirmLore}%%nl% %nl%&fClick here to upgrade ability."
		else:
			set slot 16 of {_gui} to red stained glass pane named "&cAwaken Power" with lore "%{_confirmLore}%%nl% %nl%&cInsufficient materials."
	open {_gui} to {_p}

function CombatProfileMenu(p: player):
	set metadata tag "combatprofilegui" of {_p} to (chest inventory with 3 rows named "%uncolored (name of {_p}'s tool)% - Combat Profile")
	set {_gui} to metadata tag "combatprofilegui" of {_p}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " "
	set {_card} to uncolored (name of {_p}'s tool)
	set {_gearScore} to CalculateCardGearScore({_p})
	set {_gearScoreItem} to netherite chestplate named "&8Gear Score" with item flag hide attributes
	set {_gearTop::*} to CombatProfileTopList({_card}, "Card.Gear Score")
	set lore of {_gearScoreItem} to "&f✨ What is Gear Score?", "&7Gear Score measures the overall strength", "&7of your equipped gear. It is primarily", "&7based on weighted item level and rarity,", "&7then increased by sockets, gems, enchants,", "&7built-in set bonuses and Starforged bonuses.", " ", "&7Your Gear Score: &f%{_gearScore}%", " " and {_gearTop::*}
	set slot 0 of {_gui} to {_gearScoreItem}
	set slot 1 of {_gui} to CombatProfileStatItem(iron sword, "&6Damage Dealt", "&7Shows the top damage dealt for %{_card}%.", {_card}, "Combat Data.Total Damage Dealt") with item flag hide attributes
	set slot 2 of {_gui} to CombatProfileStatItem(shield, "&bDamage Shielded", "&7Shows the top damage shielded for %{_card}%.", {_card}, "Combat Data.Total Damage Shielded", true) with item flag hide attributes
	set slot 3 of {_gui} to CombatProfileStatItem(potion, "&aHealing Done", "&7Shows the top healing done for %{_card}%.", {_card}, "Combat Data.Total Healing Done")
	set slot 4 of {_gui} to CombatProfileStatItem(diamond sword, "&cKilling Blows", "&7Shows the top killing blows for %{_card}%.", {_card}, "Combat Data.Total Killing Blows") with item flag hide attributes
	set slot 5 of {_gui} to CombatProfileStatItem(golden sword, "&eOverall Kills", "&7Shows the top overall kills for %{_card}%.", {_card}, "Combat Data.Total Overall Kills") with item flag hide attributes
	set slot 6 of {_gui} to CombatProfileStatItem(totem of undying, "&dAssists", "&7Shows the top assists for %{_card}%.", {_card}, "Combat Data.Total Assists")
	set slot 7 of {_gui} to CombatProfileStatItem(flint, "&6Critical Hits", "&7Shows the top critical hits for %{_card}%.", {_card}, "Combat Data.Total Critical Hits")
	set slot 8 of {_gui} to CombatProfileStatItem(clock, "&fCombat Time", "&7Shows the top combat time for %{_card}%.", {_card}, "Combat Data.Total Combat Time")
	set slot 9 of {_gui} to CombatProfileStatItem(wither skeleton skull, "&8Deaths", "&7Shows the top deaths for %{_card}%.", {_card}, "Combat Data.Total Deaths")
	set {_averageItemLevel} to CalculateCardAverageItemLevel({_p})
	set {_averageItemLevelTop::*} to CombatProfileTopList({_card}, "Card.Average Item Level")
	set {_averageItemLevelItem} to spyglass named "&bTop Item Levels" with item flag hide attributes
	set lore of {_averageItemLevelItem} to "&7Shows the top average item levels", "&7for %{_card}%.", " ", "&7Your Average Item Level: &f%CombatProfileFormatDecimal({_averageItemLevel})%", " " and {_averageItemLevelTop::*}
	set slot 10 of {_gui} to {_averageItemLevelItem}
	open {_gui} to {_p}

function CombatProfileStatItem(itemType: item type, title: text, description: text, card: text, yamlNode: text, hideAttributes: boolean = false) :: item:
	set {_item} to {_itemType} named {_title}
	set {_top::*} to CombatProfileTopList({_card}, {_yamlNode})
	set lore of {_item} to {_description}, " " and {_top::*}
	if {_hideAttributes} is true:
		set {_item} to {_item} with item flag hide attributes
	return {_item}

function CombatProfileFormatDecimal(value: number) :: text:
	set {_whole} to floor({_value})
	set {_decimal} to round(({_value} - {_whole}) * 100, 0)
	if {_decimal} = 100:
		set {_whole} to {_whole} + 1
		set {_decimal} to 0
	if {_decimal} < 10:
		set {_decimalText} to "0%{_decimal}%"
	else:
		set {_decimalText} to "%{_decimal}%"
	return "%{_whole}%.%{_decimalText}%"

function CombatProfileDisplayValue(yamlNode: text, value: number) :: text:
	if {_yamlNode} = "Combat Data.Total Combat Time":
		set {_timespan} to "%{_value}% seconds" parsed as timespan
		return "%{_timespan}%"
	if {_yamlNode} = "Card.Average Item Level":
		return CombatProfileFormatDecimal({_value})

	return "%{_value}%"

function CombatProfileTopList(card: text, yamlNode: text, p: player = null) :: texts:
	set {_dir} to new File("plugins/Skript/playerdata/karty/%{_card}%")
	if {_dir}.isDirectory() is false:
		loop 5 times:
			set {_top::*} to {_top::*} and "&7%loop-number%. &8..."
		if {_p} is set:
			set {_top::*} to {_top::*} and "%last string color code of name of {_p}'s tool%&7-"
		set {_top::*} to {_top::*} and "&8&o0 more..."
		return {_top::*}

	if {_p} is set:
		set {_playerLineColour} to last string color code of name of {_p}'s tool
	else:
		set {_playerLineColour} to "&f"

	set {_files::*} to ...{_dir}.listFiles()
	loop {_files::*}:
		set {_file} to loop-value
		if {_file}.isFile() is true:
			set {_fileName} to {_file}.getName()
			set {_nameLength} to length of {_fileName}
			if {_nameLength} > 4:
				set {_extension} to subtext of {_fileName} from ({_nameLength} - 3) to {_nameLength}
				if {_extension} = ".yml":
					set {_yamlId} to "combatprofile-%random 8 char string from charset `0-9` `a-z`%"
					load yaml "plugins/Skript/playerdata/karty/%{_card}%/%{_fileName}%" as {_yamlId}

					set {_value} to yaml value "%{_yamlNode}%" in {_yamlId}
					if {_value} is not set:
						set {_value} to 0

					if {_value} > 0:
						set {_owner} to yaml value "Card.Owner" in {_yamlId}
						if {_owner} is not set:
							set {_owner} to "Unknown"

						set {_cardId} to yaml value "Card.Id" in {_yamlId}
						if {_cardId} is not set:
							set {_cardId} to subtext of {_fileName} from 1 to ({_nameLength} - 4)

						set {_labels::*} to {_labels::*} and "%{_owner}% (%{_cardId}%)"
						set {_values::*} to {_values::*} and {_value}
						set {_owners::*} to {_owners::*} and {_owner}
						set {_positiveCount} to {_positiveCount} + 1

					unload yaml {_yamlId}

	if {_values::*} is set:
		loop size of {_values::*} times:
			clear {_max}
			clear {_index}

			loop {_values::*}:
				if {_used::*} does not contain loop-index:
					if {_max} is not set:
						set {_max} to loop-value-2
						set {_index} to loop-index
					else if loop-value-2 > {_max}:
						set {_max} to loop-value-2
						set {_index} to loop-index

			if {_index} is set:
				set {_used::*} to {_used::*} and {_index}
				set {_rankedLabel::%loop-number%} to {_labels::%{_index}%}
				set {_rankedValue::%loop-number%} to {_max}

				if {_p} is set:
					if {_owners::%{_index}%} = "%{_p}%":
						set {_playerRank} to loop-number
						set {_playerRankValue} to {_max}
						set {_playerRankLabel} to {_labels::%{_index}%}

		loop 5 times:
			if {_rankedLabel::%loop-number%} is set:
				set {_displayValue} to CombatProfileDisplayValue({_yamlNode}, {_rankedValue::%loop-number%})

				if all:
					{_p} is set
					{_playerRank} is set
					{_playerRank} = loop-number
				then:
					set {_top::*} to {_top::*} and "%{_playerLineColour}%%loop-number%. %{_rankedLabel::%loop-number%}%: &f%{_displayValue}%"
				else:
					set {_top::*} to {_top::*} and "&7%loop-number%. %{_rankedLabel::%loop-number%}%: &f%{_displayValue}%"
			else:
				set {_top::*} to {_top::*} and "&7%loop-number%. &8..."

		if {_p} is set:
			if {_playerRank} is not set:
				loop size of {_values::*} times:
					clear {_max}
					clear {_index}

					loop {_values::*}:
						if {_usedPlayer::*} does not contain loop-index:
							if {_max} is not set:
								set {_max} to loop-value-2
								set {_index} to loop-index
							else if loop-value-2 > {_max}:
								set {_max} to loop-value-2
								set {_index} to loop-index

					if {_index} is set:
						set {_usedPlayer::*} to {_usedPlayer::*} and {_index}
						if {_owners::%{_index}%} = "%{_p}%":
							set {_playerRank} to loop-number
							set {_playerRankValue} to {_max}
							set {_playerRankLabel} to {_labels::%{_index}%}
							stop loop

			if {_playerRank} is set:
				if {_playerRank} > 5:
					set {_playerDisplayValue} to CombatProfileDisplayValue({_yamlNode}, {_playerRankValue})
					set {_top::*} to {_top::*} and "%{_playerLineColour}%%{_playerRank}%. %{_playerRankLabel}%: &f%{_playerDisplayValue}%"

		set {_shown} to {_positiveCount}
		if {_shown} > 5:
			set {_shown} to 5

		set {_remaining} to {_positiveCount} - {_shown}
		if {_playerRank} is set:
			if {_playerRank} > 5:
				set {_remaining} to {_remaining} - 1

		if {_remaining} < 0:
			set {_remaining} to 0

		set {_top::*} to {_top::*} and "&8&o+%{_remaining}% more..."
		return {_top::*}

	loop 5 times:
		set {_top::*} to {_top::*} and "&7%loop-number%. &8..."
	set {_top::*} to {_top::*} and "&8&o+0 more..."
	return {_top::*}


on inventory close:
	if player's current inventory is (metadata tag "combatprofilegui" of player):
		clear metadata tag "combatprofilegui" of player
	if player's current inventory is (metadata tag "kartagui" of player):
		clear (metadata tag "kartagui" of player)	
	if player's current inventory is (metadata tag "abilitymenu" of player):
		clear metadata tag "abilitymenu" of player
		clear metadata tag "ClickedAbility" of player
	if player's current inventory is (metadata tag "abilityupgrademenu" of player):
		clear metadata tag "abilityupgrademenu" of player
	if player's current inventory is (metadata tag "abilitymodifiersmenu" of player):
		clear metadata tag "abilitymodifiersmenu" of player
		
function topDesc(n: number, v: text) :: string:
	loop 5 times:
		set {_%{_n}%::%loop-number%} to (loop-number)th element of (createTop("%{_v}%", 5, "&e##[I] &7> &f[P] &7(&a[V]&7)"))
		set {_list::*} to {_%{_n}%::%loop-number%} split at " "
		set {_list::3} to "&8Id:"
		set {_idowner} to join {_list::3} and {_list::4} by " "
		set {_idowner} to {_idowner} in lowercase
		replace all "id:" in {_idowner} with "Id:"
		set {_owner} to "&f%{kartaowner::%{_idowner}%}%"
		if {_owner} contains "<none>":
			set {_owner} to "&f&oUnknown"
		set {_list::3} to {_owner}
		clear {_list::4}
		set {_%{_n}%::%loop-number%} to join {_list::*} by " "
	set {_r} to join {_%{_n}%::*} by nl
	return "%{_r}%"
	
