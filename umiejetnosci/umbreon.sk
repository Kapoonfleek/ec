

on rightclick:
	if boolean tag "Night Slash" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Umbreon":
			if CanUseAbility(player) != false:
				set {_target} to Target(player, 100, false)
				if {_target} is set:
					set {_range} to 3 + CrowdControlStat(player)/30
					if distance between player and {_target} <= {_range}:
						set {_pospiech} to Haste(player)
						set {_baseCd} to 3
						set {_damage} to 5 + ({damage::%player%}/30) + (Versatility(player)/90 + PrimaryStat(player)/20)

						if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) = "Quick Claw":
							set {_damage} to {_damage}*0.75
							set {_baseCd} to {_baseCd}*0.5

						else if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) = "Heavy Claw":
							set {_damage} to {_damage}*1.875
							set {_baseCd} to {_baseCd}*1.25

						else if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) = "Sharp Claw":
							set {_damage} to {_damage}*1.5

						set {_cd} to "%{_baseCd}/{_pospiech}% seconds" parsed as timespan
						
						if metadata value "From the Shadows%player%" of {_target} is not set:
							if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "From the Shadows":
								set metadata value "From the Shadows%player%" of {_target} to true
								set {_damage} to {_damage}*5
								set {_cd} to "%({_baseCd}/{_pospiech})*0.25% seconds" parsed as timespan
						
						if cooldown "Night Slash%player%" is finished:
							create cooldown "Night Slash%player%" for {_cd}
							set cooldown of player's held item for player to {_cd}
							AbilityUse(player, "Night Slash")

							set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cd}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>slashes her target with her claw%nl%<#555555>at short range, dealing &f%{_damage}% <#333333>Dark <#555555>damage.%nl% %nl%<#555555>The enemy will take &f7.5%% <#555555>increased damage%nl%<#555555>from your upcoming &f <#999999>Night Slash <#555555>attacks%nl%<#555555>for the next &f6 sec<#555555>. This effect stacks."
							LoreUpdate(player, "Night Slash", {_lore})

							NightSlash(player, {_target}, {_damage}, {_pospiech}, {_lore})

							if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) is set:
							
								if boolean tag "Constellation;Hunter of the Claw" of (custom nbt of {karta::%player%}) is set:
									set {_chance} to 40
									set {_loops} to 2
								else:
									set {_chance} to 30
									set {_loops} to 1

								chance of {_chance}%:
									set {_moonStrikesEffectiveness} to 0.8
									set {_wait} to "%0.5/{_pospiech}% seconds" parsed as timespan
									loop {_loops} times:
										set {_damage} to {_damage}*{_moonStrikesEffectiveness}
										wait {_wait}
										if {_target} is alive:
											NightSlash(player, {_target}, {_damage}, {_pospiech}, {_lore}, true)
						else:
							cancel event
							if {tekstcd::%player%} = true:
								set {_cdd} to cooldown "Night Slash%player%"
								send "<#555555>You must wait &f%{_cdd}%<#555555> to use this ability." to player
							stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "Moonlight Orb" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Umbreon":	
			if CanUseAbility(player) != false:

				set {_targetLocation} to Target(player, 100, false)
				if {_targetLocation} is not set:
					set {_targetLocation} to target block of player

				if {_targetLocation} is set:
					if cooldown "Moonlight Orb%player%" is finished:

						set {_pospiech} to Haste(player)
						set {_cd} to "%16/{_pospiech}% seconds" parsed as timespan
						create cooldown "Moonlight Orb%player%" for {_cd}
						set the cooldown of player's held item for player to {_cd}

						AbilityUse(player, "Moonlight Orb")

						if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Shadow Mark":
							set {_shadowMark} to true

						MoonlightOrb(player, target block of player, {_shadowMark})

					else:
						cancel event
						if {tekstcd::%player%} = true:
							set {_cdd} to cooldown "Moonlight Orb%player%"
							send "<#555555>You must wait &f%{_cdd}%<#555555> to use this ability." to player
						stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "End Game" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Umbreon":
			if CanUseAbility(player) != false:
				if cooldown "End Game%player%" is finished:	
					set {_pospiech} to Haste(player)
					set {_cd} to "%600/{_pospiech}% seconds" parsed as timespan
					create cooldown "End Game%player%" for {_cd}
					set cooldown of player's tool for player to {_cd}
					AbilityUse(player, "End Game")

					set {_damage} to 50 + ({damage::%player%}/0.24) + (Versatility(player)/0.72) + (PrimaryStat(player)/0.12)
					
					set {_executionThreshold} to 0.25
					if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Inevitable End":
						add 0.05 to {_executionThreshold}
						set {_damage} to {_damage}*1.25

					set {_element} to "Dark"
					if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Moonlight Empowerment":
						if checkIfInsideMoonlightOrb(player) is set:
							set {_element} to "Moonlight"

					set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cd}%%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>attempts to <#999999>execute <#555555>all enemies%nl%<#555555>below &f25%% <#999999>health <#555555>in an enormous radius.%nl% %nl%<#555555>All enemies in range are <#999999> Blinded%nl%<#555555>for &f10 sec<#555555>.%nl% %nl%<#555555>This ability instead deals &f%{_damage}% <#333333>Dark <#555555>damage%nl%<#555555>to all <#999999>Boss <#555555>enemies."
					LoreUpdate(player, "End Game", {_lore})

					play sound "entity.enderman.scream" with volume 5 and pitch 0 at location of player

					if boolean tag "Constellation;Executioner" of (custom nbt of {karta::%player%}) is set:
						set metadata value "UmbreonExecutioner" of player to 0

					set {_world} to world of player

					loop {ECMobs::%{_world}%::*}:
						set {_entity} to loop-value parsed as entity
						set {_entityLoc} to location of {_entity}

						if chunk at {_entityLoc} is loaded:
							if canBeCCed({_entity}) = true:
								apply blindness 2 to {_entity} for 10 seconds
							if health of {_entity} < ({_executionThreshold}*(max health of {_entity})):
								set {_entity}'s last damage cause to sweep attack
								set metadata value "Element" of player to {_element}
								set metadata value "LastDamageCause" of {_entity} to "<#555555>End Game"
								set metadata value "LastDamageCauseLore" of {_entity} to {_lore}
								if boolean tag "ECBoss" of (custom nbt of {_entity}) is not set:
									make player damage {_entity} by ({_executionThreshold}*({_entity}'s max health))
								else:
									make player damage {_entity} by {_damage}
				else:
					cancel event
					if {tekstcd::%player%} = true:
						set {_cdd} to cooldown "End Game%player%"
						send "<#555555>You must wait &f%{_cdd}%<#555555> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "Garrote" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Umbreon":
			if CanUseAbility(player) != false:
				set {_target} to Target(player, 100, false)
				if {_target} is set:
					set {_range} to 3 + CrowdControlStat(player)/30
					if distance between player and {_target} <= {_range}:
						if cooldown "Garrote%player%" is finished:
							set {_pospiech} to Haste(player)
							set {_cd} to "%16/{_pospiech}% seconds" parsed as timespan
							if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Scent of Blood":
								if player has invisibility:
									set {_noCd} to true

							if {_noCd} != true:
								create cooldown "Garrote%player%" for {_cd}
								set cooldown of player's tool for player to {_cd}

							AbilityUse(player, "Garrote")
							Garrote(player, {_target})

							play sound "skill.umbreon.garrote" with volume 2 and pitch 1 at location of {_target}
							play sound "skill.umbreon.garrote_impact" with volume 2 and pitch 1 at location of {_target}

						else:
							cancel event
							if {tekstcd::%player%} = true:
								set {_cdd} to cooldown "Garrote%player%"
								send "<#555555>You must wait &f%{_cdd}%<#555555> to use this ability." to player
							stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player 	

	else if boolean tag "Shadowstep" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Umbreon":
			if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Shadowstep":
				if CanUseAbility(player) != false:
					set {_target} to Target(player, 100, false)
					if {_target} is set:
						set {_range} to 6 + CrowdControlStat(player)/30
						if distance between player and {_target} <= {_range}:
							if cooldown "Shadowstep%player%" is finished:
								set {_cd} to 20 seconds
								create cooldown "Shadowstep%player%" for {_cd}
								set cooldown of player's tool for player to {_cd}

								AbilityUse(player, "Shadowstep")

								set {_damage} to 2 + ({damage::%player%}/100 + Versatility(player)/300 + PrimaryStat(player)/50)
								set {_shadowstepDmgIncrease} to 8
								set {_shadowstepDuration} to 6

								set {_element} to "Dark"
								if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Moonlight Empowerment":
									if checkIfInsideMoonlightOrb(player) is set:
										set {_element} to "Moonlight"

								set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cd}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Blink <#555555>behind a target, dealing &f%{_damage}% <#333333>Dark%nl%<#555555>damage and increasing <#999999>all damage they%nl%<#999999>take <#555555>from you by &f%{_shadowstepDmgIncrease}%%% <#555555>for &f%{_shadowstepDuration}% sec<#555555>."
								LoreUpdate(player, "Shadowstep", {_lore})

								set {_crit} to CriticalHit(player)
								set {_target}'s last damage cause to sweep attack
								set metadata value "Element" of player to {_element}
								set metadata value "LastDamageCause" of {_target} to "<#555555>Shadowstep"
								set metadata value "LastDamageCauseLore" of {_target} to {_lore}
								set {_damage} to Crit(player, {_target}, {_crit}, {_damage})

								make player damage {_target} by ({_damage})

								Shadowstep(player, {_target})

								play sound "entity.generic.hurt" with volume 1.25 and pitch 1.1 at location of {_target}
								draw 20 of (black dust particle with extra value 0.03) with offset vector(0.6, 0.6, 0.6) at (location above {_target})

								set {_loc} to findSafeLocation({_target})
								if {_loc} is set:
									play sound "skill.umbreon.vanish" with volume 2.25 and pitch 1 at location of player
									teleport player to {_loc}
									play sound "entity.enderman.teleport" with volume 2.25 and pitch 0.75 at location of {_target}
								
							else:
								cancel event
								if {tekstcd::%player%} = true:
									set {_cdd} to cooldown "Shadowstep%player%"
									send "<#555555>You must wait &f%{_cdd}%<#555555> to use this ability." to player
								stop
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required talent to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "Vanish" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Umbreon":
			if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Shadowstep":
				if CanUseAbility(player) != false:
					if cooldown "Vanish%player%" is finished:
						set {_cd} to 40 seconds
						create cooldown "Vanish%player%" for {_cd}
						set cooldown of player's tool for player to {_cd}

						AbilityUse(player, "Vanish")

						set {_vanishDuration} to 10 seconds
						set {_vanishMovementSpeed} to 50
						set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cd}%%nl%&7Use: &fRMB%nl%<#555555>Blend into the shadows, <#999999>vanishing <#555555>from%nl%<#555555>sight and becoming &f <#999999>Invisible <#555555>for &f%seconds of {_vanishDuration}% sec<#555555>.%nl% %nl%&f <#999999>Vanish <#555555>increases your <#999999> Movement%nl%<#999999>Speed <#555555>by &f%{_vanishMovementSpeed}%%% <#555555>for the duration."
						LoreUpdate(player, "Vanish", {_lore})

						apply an ambient potion effect of invisibility of tier 1 to player for {_vanishDuration}:
							hide the particles

						set metadata value "Vanish" of player to true
						playerMoveSpeedUpdate(player)

						draw 20 of (black dust particle with extra value 0.03) with offset vector(0.6, 0.6, 0.6) at (location above player)
						play sound "skill.umbreon.vanish" with volume 2.25 and pitch 1 at location of player

						wait {_vanishDuration}
						clear metadata value "Vanish" of player
						playerMoveSpeedUpdate(player)
						
					else:
						cancel event
						if {tekstcd::%player%} = true:
							set {_cdd} to cooldown "Vanish%player%"
							send "<#555555>You must wait &f%{_cdd}%<#555555> to use this ability." to player
						stop
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required talent to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player	

	else if boolean tag "Shadow Claws" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Umbreon":
			if CanUseAbility(player) != false:
				if cooldown "Shadow Claws%player%" is finished:
					set {_target} to Target(player, 100, false)
					if {_target} is set:
						set {_range} to 3 + CrowdControlStat(player)/30
						if distance between player and {_target} <= {_range}:

							if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Shadow Macabre":
								if player has invisibility:
									add 1 to {_shadowClawsStacks}
								else:
									send "&8[&6Earthcraft&8] &6You must be &f Invisible &6to use this ability." to player
									play sound "block.glass.break" with volume 3 and pitch 0 to player	
									stop

							set {_cd} to 30 seconds
							create cooldown "Shadow Claws%player%" for {_cd}
							set cooldown of player's tool for player to {_cd}

							AbilityUse(player, "Shadow Claws")
							ShadowClawsVisual(player, {_target})
							play sound "skill.beast_master.bestial_wrath" with volume 2 and pitch 1 at location of {_target}
							play sound "skill.beast_master.kill_command" with volume 2 and pitch 0.5 at location of {_target}

							set {_damage} to 6 + ({damage::%player%}/12) + (Versatility(player)/36) + (PrimaryStat(player)/6)

							if metadata value "Garrote%player%" of {_target} > 0 seconds:
								add 1 to {_shadowClawsStacks}

							if metadata value "Night Slash Vulnerability%player%" of {_target} > 0:
								add (metadata value "Night Slash Vulnerability%player%" of {_target})/0.075 to {_shadowClawsStacks}

								clear metadata value "Night Slash Vulnerability%player%" of {_target}
								clear metadata value "Night Slash Vulnerability Duration%player%" of {_target}

							if metadata value "ShadowstepDamageIncrease%player%" of {_target} > 0 seconds:
								add 1 to {_shadowClawsStacks}

							set {_element} to "Dark"

							set {_moonlightOrb} to checkIfInsideMoonlightOrb(player)
							if {_moonlightOrb} is set:
								if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Moonlight Empowerment":
									set {_element} to "Moonlight"

								if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Shadow Macabre":
									add 1 to {_shadowClawsStacks}
									set {_id} to metadata value "MoonlightOrbId%player%" of {_moonlightOrb}
									clear metadata value "MoonlightOrb%{_id}%" of player
									clear metadata value "RadiusOrb%{_id}%" of player
									clear metadata value "MoonlightOrbDuration%{_id}%" of player
									clear metadata value "MoonlightOrbId%player%" of block at {_moonlightOrb}

								
							set {_damageShadowClaws} to {_damage}*{_shadowClawsStacks}
							
							set {_lore} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f%{_cd}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>draws upon the surrounding shadows to%nl%<#999999>empower <#555555>her claws and deal &f%{_damage}% <#333333>Dark <#555555>damage for%nl%<#555555>each &f <#999999>Damage Amp <#555555>effect applied <#999999>on the target%nl%<#555555>by her abilities.%nl% %nl%<#555555>Deals a total of &f%{_damageShadowClaws}% <#333333>Dark <#555555>damage against your%nl%<#555555>current target.%nl% %nl%<#555555>This ability consumes all &f <#999999>Damage Modifications%nl%<#555555>used to <#999999>empower <#555555>the ability in the process."
							LoreUpdate(player, "Shadow Claws", {_lore})

							set {_crit} to CriticalHit(player)
							set {_target}'s last damage cause to sweep attack
							set metadata value "Element" of player to {_element}
							set metadata value "LastDamageCause" of {_target} to "<#555555>Shadow Claws"
							set metadata value "LastDamageCauseLore" of {_target} to {_lore}
							set {_damageShadowClaws} to Crit(player, {_target}, {_crit}, {_damageShadowClaws})
							
							if {_damageShadowClaws} > 0:
								make player damage {_target} by ({_damageShadowClaws})

				else:
					if {tekstcd::%player%} = true:
						set {_cdd} to cooldown "Shadow Claws%player%"
						send "<#555555>You must wait &f%{_cdd}%<#555555> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player	
	
function Garrote(p: player, target: entity):
	if metadata value "Garrote%{_p}%" of {_target} is not set:
		set metadata value "Garrote%{_p}%" of {_target} to 18 seconds
		set {_id} to entity id of {_target}
		set {_meta} to metadata packet with id {_id}

		amountOfDotsSet({_p}, {_target})
		set {_height} to amountOfDots({_p}, {_target})
		set {_dots} to metadata value "AmountOfDots%{_p}%" of {_target}

		while metadata value "Garrote%{_p}%" of {_target} > 0 seconds:
			set {_pospiech} to Haste({_p})
			set {_tickTime} to "%2/{_pospiech}% seconds" parsed as timespan
			set {_damage} to 1.25 + ({damage::%{_p}%}/70) + (Versatility({_p})/210) + (PrimaryStat({_p})/35)

			if {_p} has invisibility:
				if string tag "Talents;Row 4" of (custom nbt of {karta::%{_p}%}) = "Scent of Blood":
					set {_damage} to {_damage}*1.2

			set {_element} to "Dark"

			if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Moonlight Empowerment":
				if checkIfInsideMoonlightOrb({_p}) is set:
					set {_element} to "Moonlight"

			set {_cd} to "%16/{_pospiech}% seconds" parsed as timespan
			set {_range} to 3 + CrowdControlStat({_p})/30
			set {_garroteDuration} to 18
			set {_tickTimeTooltip} to 2/{_pospiech}

			set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cd}%%nl%&7Range: &f%{_range}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>garrotes the enemy, causing the%nl%<#555555>target to <#999999>Bleed <#555555>for &f%{_damage}% <#333333>Dark <#555555>every &f%{_tickTimeTooltip}% sec%nl%<#555555>for a total of &f%{_damage}*({_garroteDuration}/{_tickTimeTooltip})% <#333333>Dark <#555555>damage over &f%{_garroteDuration}% sec<#555555>.%nl% %nl%<#555555>This ability increases all <#999999>damage taken <#555555>by%nl%<#555555>the target from your abilities by &f10%% <#555555>for%nl%<#555555>its duration."
			LoreUpdate({_p}, "Garrote", {_lore})

			if metadata value "AmountOfDots%{_p}%" of {_target} < {_dots}:
				set {_height} to amountOfDots({_p}, {_target})

			set {_durationLeft} to metadata value "Garrote%{_p}%" of {_target}
			dotsText(" %seconds of {_durationLeft}% sec", {_p}, {_target}, (location {_height} above {_target}'s head), 0 seconds, {_tickTime})

			set {_crit} to CriticalHit({_p})

			set {_target}'s last damage cause to sweep attack
			set metadata value "Element" of {_p} to {_element}
			set metadata value "LastDamageCause" of {_target} to "<#555555>Garrote"
			set metadata value "LastDamageCauseLore" of {_target} to {_lore}
			set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage})

			make {_p} damage {_target} by ({_damage})

			play sound "skill.umbreon.garrote_bleed" with volume 1.25 and pitch 1.1 at location of {_target}
			set {_block} to redstone block
			draw 10 of ({_block} block particle with extra value 0.03) with offset vector(0.4, 0.4, 0.4) at location above {_target}
			wait {_tickTime}
			remove {_tickTime} from metadata value "Garrote%{_p}%" of {_target}
			stop loop if {_target} is not alive
			
		clear metadata value "Garrote%{_p}%" of {_target}
		amountOfDotsSubtract({_p}, {_target})

	else:
		set metadata value "Garrote%{_p}%" of {_target} to 18 seconds


function NightSlash(p: player, target: entity, damage: number, haste: number, lore: text, moonStrikes: boolean = false):
	set {_crit} to CriticalHit({_p})

	if {_moonStrikes} = true:
		set {_pitch} to 0.7
		set {_damageSource} to "Moon Strikes"
	else:
		set {_damageSource} to "Night Slash"
		set {_pitch} to 0.2

	if metadata value "Night Slash Vulnerability%{_p}%" of {_target} is set:
		set {_nightSlashBonus} to metadata value "Night Slash Vulnerability%{_p}%" of {_target}
		set {_damage} to {_damage} * (1 + {_nightSlashBonus})

	set {_bonusDuration} to 6 seconds

	set {_element} to "Dark"
	set {_visual} to "Standard"

	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Moonlight Empowerment":
		if checkIfInsideMoonlightOrb({_p}) is set:
			set {_element} to "Moonlight"
			set {_visual} to "Moonlight"
			add 0.5 to {_pitch}

	set {_target}'s last damage cause to sweep attack
	set metadata value "Element" of {_p} to {_element}
	checkIfInsideMoonlightOrb({_p})
	set metadata value "LastDamageCause" of {_target} to "<#555555>%{_damageSource}%"
	set metadata value "LastDamageCauseLore" of {_target} to {_lore}
	set {_damage} to Crit({_p}, {_target}, {_crit}, {_damage})

	make {_p} damage {_target} by ({_damage})

	play sound "entity.player.attack.sweep" with volume 3 and pitch {_pitch} at location of {_target}
	play sound "skill.umbreon.nightslash" with volume 3 and pitch {_pitch}+0.8 at location of {_target}

	if {_moonStrikes} != true:
		NightSlashBonus({_p}, {_target}, {_bonusDuration}, 0.075)
		make {_p} swing their hand
	else:
		if boolean tag "Constellation;Nightfall" of (custom nbt of {karta::%{_p}%}) is set:
			NightSlashBonus({_p}, {_target}, {_bonusDuration}, 0.075)

	NightSlashVisual({_p}, {_target}, {_visual})

function MoonlightOrb(p: player, loc: location, shadowMark: boolean):
	set {_locOrb} to block 0.5 blocks above block at {_loc}
	set {_locOrbAbove} to block 2 above {_loc}

	set {_crit} to CriticalHit({_p})
	set {_pospiech} to Haste({_p})
	set {_cd} to "%16/{_pospiech}% seconds" parsed as timespan
	set {_radius} to 3 + CrowdControlStat({_p})/20
	set {_damage} to 2 + ({damage::%{_p}%}/90) + (Versatility({_p})/270 + PrimaryStat({_p})/45)	

	if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Supermoon":
		set {_damage} to {_damage}*4
		set {_radius} to {_radius}*1.2

	play sound "entity.enderman.teleport" with volume 5 and pitch 0 at {_locOrb}

	if block at {_locOrb} is air:
		make all players see block at {_locOrb} as light block
		set {_light} to true

	set {_id} to random 8 char string from charset `0-9`
	set metadata value "RadiusOrb%{_id}%" of {_p} to {_radius}

	set {_duration} to 8 seconds

	set {_sphere} to a sphere with radius 0.8
	set particle of {_sphere} to ((rgb 255, 228, 140) dust particle with extra value 0.5)
	draw shape {_sphere} at {_locOrbAbove} for {_duration}


	set {_lore} to "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cd}%%nl%&7Radius area: &f%{_radius}% blocks%nl%&7Use: &fRMB%nl%<#999999>Umbreon <#555555>creates a zone of &f <#999999>Moonlight <#555555>at the%nl%<#555555>target location, inflicting &f%{_damage}% <#d9d5a7>Moonlight <#555555>damage to%nl%<#555555>enemies caught in its radius and <#999999> Slowing%nl%<#555555>them by &f30%% <#555555>until they leave the area.%nl% %nl%<#999999>Umbreon<#555555> becomes &f <#999999>Invisible <#555555>when she enters%nl%<#555555>a &f <#999999>Moonlight <#555555>zone.%nl% %nl%&f <#999999>Moonlight <#555555>zones last &f8 sec<#555555>."
	LoreUpdate({_p}, "Moonlight Orb", {_lore})

	loop all living entities in radius {_radius} around {_locOrb}:
		if boolean tag "ECMob" of (custom nbt of loop-entity) is set:
			set loop-entity's last damage cause to sweep attack
			set metadata value "Element" of {_p} to "Moonlight"
			set metadata value "LastDamageCause" of loop-entity to "<#555555>Moonlight Orb"
			set metadata value "LastDamageCauseLore" of loop-entity to {_lore}
			set {_damage} to Crit({_p}, loop-entity, {_crit}, {_damage})
			make {_p} damage loop-entity by {_damage}
			if {_shadowMark} = true:
				ShadowMark({_p}, loop-entity)

	set metadata value "MoonlightOrb%{_id}%" of {_p} to {_locOrb}

	MoonlightOrbRadius({_p}, {_id})
	
	MoonlightOrbExpire({_p}, {_id}, {_duration}, {_locOrb}, {_light})

function MoonlightOrbRadius(p: player, id: text):
	set {_radius} to metadata value "RadiusOrb%{_id}%" of {_p}
	set {_location} to metadata value "MoonlightOrb%{_id}%" of {_p}

	set {_circle} to a circle with radius {_radius}
	set particle of {_circle} to ((rgb 255, 228, 140) dust particle with extra value 0.5)

	while metadata value "MoonlightOrb%{_id}%" of {_p} is set:
		draw shape {_circle} at {_location} ~ {_v} for 0.5 seconds
		loop all living entities in radius {_radius} around {_location}:
			if boolean tag "ECMob" of (custom nbt of loop-entity) is set:
				if canBeCCed(loop-entity) = true:
					apply an ambient potion effect of slowness of tier 2 to loop-entity for 0.8 seconds:
						hide the particles
			else:
				if loop-entity = {_p}:
					apply an ambient potion effect of invisibility of tier 1 to {_p} for 0.8 seconds:
						hide the particles
		wait 0.75 seconds
		
function NightSlashBonus(p: player, target: entity, duration: timespan, bonus: number):
	if metadata value "Night Slash Vulnerability%{_p}%" of {_target} is not set:
		set metadata value "Night Slash Vulnerability%{_p}%" of {_target} to {_bonus}

		set metadata value "Night Slash Vulnerability Duration%{_p}%" of {_target} to {_duration}

		set {_star} to a circle of radius 0.6

		set {_particle} to black dust particle that transitions to gray with extra value 0.5
		set particle of {_star} to {_particle}

		amountOfDotsSet({_p}, {_target})
		set {_height} to amountOfDots({_p}, {_target})
		set {_dots} to metadata value "AmountOfDots%{_p}%" of {_target}

		while metadata value "Night Slash Vulnerability Duration%{_p}%" of {_target} > 0 seconds:
			draw shape {_star} at {_target} for 1 second

			if metadata value "AmountOfDots%{_p}%" of {_target} < {_dots}:
				set {_height} to amountOfDots({_p}, {_target})

			set {_durationLeft} to metadata value "Night Slash Vulnerability Duration%{_p}%" of {_target}
			set {_stacksTarget} to metadata value "Night Slash Vulnerability%{_p}%" of {_target}
			dotsText(" %{_stacksTarget}/0.075%x (%seconds of {_durationLeft}% sec)", {_p}, {_target}, (location {_height} above {_target}'s head), 0 seconds, 0.5 seconds)

			wait 0.5 seconds
			remove 0.5 seconds from metadata value "Night Slash Vulnerability Duration%{_p}%" of {_target}

		clear metadata value "Night Slash Vulnerability%{_p}%" of {_target}
		clear metadata value "Night Slash Vulnerability Duration%{_p}%" of {_target}
		amountOfDotsSubtract({_p}, {_target})

	else:
		add {_bonus} to metadata value "Night Slash Vulnerability%{_p}%" of {_target}

function MoonlightOrbExpire(p: player, id: text, duration: timespan, locOrb: location, light: boolean = false):
	if metadata value "MoonlightOrbDuration%{_id}%" of {_p} is not set:
		set metadata value "MoonlightOrbId%{_p}%" of block at {_locOrb} to {_id}
		set metadata value "MoonlightOrbDuration%{_id}%" of {_p} to {_duration}
		while metadata value "MoonlightOrbDuration%{_id}%" of {_p} > 0 seconds:
			wait 1 second
			remove 1 second from metadata value "MoonlightOrbDuration%{_id}%" of {_p}
		clear metadata value "MoonlightOrb%{_id}%" of {_p}
		clear metadata value "RadiusOrb%{_id}%" of {_p}
		clear metadata value "MoonlightOrbDuration%{_id}%" of {_p}
		clear metadata value "MoonlightOrbId%{_p}%" of block at {_locOrb}

		if {_light} is true:
			make all players see block at {_locOrb} as air
	else:
		set metadata value "MoonlightOrbDuration%{_id}%" of {_p} to {_duration}

function checkIfInsideMoonlightOrb(p: player) :: block:
	set {_radius} to 3 + CrowdControlStat({_p})/20

	if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Supermoon":
		set {_radius} to {_radius}*1.2

	loop all blocks in radius {_radius} around {_p}:
		if metadata value "MoonlightOrbId%{_p}%" of loop-block is set:
			set {_insideMoonlightOrb} to loop-block
			stop loop

	return {_insideMoonlightOrb}

function NightSlashVisual(p: player, target: entity, visual: string):
	set {_randomAbove} to a random number between 1 and 1.25
	set {_loc} to location {_randomAbove} above {_p}
	set {_loc} to location 1 block in front of {_loc}
	set {_yaw} to {_p}'s yaw
	add (random number between -45.0 and 45.0) to {_yaw}
	set {_v} to vector from yaw {_yaw} and pitch {_p}'s pitch
	set {_v2} to vector from yaw {_yaw} and pitch {_p}'s pitch + 90
	rotate {_v} around {_v2} by -90

	set {_ogV} to {_v}
	set {_ogV2} to {_v2}

	set vector length of {_v} to 0.8

	loop 45 times:
		set {_rx} to a random number between 0.00 and 0.08
		if {_visual} = "Standard":
			draw 1 of (black dust particle that transitions to gray with extra value -0.01) with offset vector({_rx},{_rx},{_rx}) at {_loc} ~ {_v}
		else if {_visual} = "Moonlight":
			draw 1 of (dark gray dust particle that transitions to yellow with extra value -0.01) with offset vector({_rx},{_rx},{_rx}) at {_loc} ~ {_v}
		rotate {_v} around {_v2} by 8 degrees

function Shadowstep(p: player, target: entity):
	set {_duration} to 6 seconds
	if metadata value "ShadowstepDamageIncrease%{_p}%" of {_target} is not set:

		amountOfDotsSet({_p}, {_target})
		set {_height} to amountOfDots({_p}, {_target})
		set {_dots} to metadata value "AmountOfDots%{_p}%" of {_target}

		set metadata value "ShadowstepDamageIncrease%{_p}%" of {_target} to {_duration}
		while metadata value "ShadowstepDamageIncrease%{_p}%" of {_target} > 0 seconds:

			if metadata value "AmountOfDots%{_p}%" of {_target} < {_dots}:
				set {_height} to amountOfDots({_p}, {_target})

			set {_durationLeft} to seconds of metadata value "ShadowstepDamageIncrease%{_p}%" of {_target}
			dotsText(" %{_durationLeft}% sec", {_p}, {_target}, (location {_height} above {_target}'s head), 0 seconds, 1 second)

			wait 1 second
			remove 1 second from metadata value "ShadowstepDamageIncrease%{_p}%" of {_target}

		clear metadata value "ShadowstepDamageIncrease%{_p}%" of {_target}
		amountOfDotsSubtract({_p}, {_target})
	else:
		set metadata value "ShadowstepDamageIncrease%{_p}%" of {_target} to {_duration}

function MidnightDamageIncrease(p: player, element: text):
	set {_increase} to 0.01
	if metadata value "MidnightDamageIncrease%{_element}%" of {_p} is not set:
		set metadata value "MidnightDamageIncrease%{_element}%" of {_p} to 1 + {_increase}
		set metadata value "MidnightDamageIncrease%{_element}%Duration" of {_p} to 8 seconds
		while metadata value "MidnightDamageIncrease%{_element}%Duration" of {_p} > 0 seconds:
			MidnightBuff({_p})
			wait 1 second
			remove 1 second from metadata value "MidnightDamageIncrease%{_element}%Duration" of {_p}
		clear metadata value "MidnightDamageIncrease%{_element}%Duration" of {_p}
		clear metadata value "MidnightDamageIncrease%{_element}%" of {_p}
		buffClear({_p}, "Midnight")
	else:
		add {_increase} to metadata value "MidnightDamageIncrease%{_element}%" of {_p}

function MidnightBuff(p: player):
	if metadata value "MidnightDamageIncreaseDark" of {_p} is set:
		set {_totalIncreaseDark} to (metadata value "MidnightDamageIncreaseDark" of {_p} - 1)*100
		set {_durationDark} to seconds of metadata value "MidnightDamageIncreaseDarkDuration" of {_p}
		set {_durationDark} to "(%{_durationDark}%s)"
	else:
		set {_totalIncreaseDark} to 0
		set {_durationDark} to ""

	if metadata value "MidnightDamageIncreaseLight" of {_p} is set:
		set {_totalIncreaseLight} to (metadata value "MidnightDamageIncreaseLight" of {_p} - 1)*100
		set {_durationLight} to seconds of metadata value "MidnightDamageIncreaseLightDuration" of {_p}
		set {_durationLight} to "(%{_durationLight}%s)"
	else:
		set {_totalIncreaseLight} to 0
		set {_durationLight} to ""

	buffRegister({_p}, "Midnight", 1, "", "Stacks", "<#333333>%{_totalIncreaseDark}%%% &f%{_durationDark}% &7| <#fffec8>%{_totalIncreaseLight}%%% &f%{_durationLight}%", "-")

function MoonlightEcho(p: player, target: entity, damage: number, element: text):
	wait 0.25 seconds
	if {_target} is alive:
		set {_lore} to "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#555555>Each time your abilities deal either <#333333>Dark%nl%<#555555>or <#fffec8>Light <#555555>damage, repeat &f8%% <#555555>of the damage%nl%<#555555>dealt as the other element after &f0.25 <#555555>sec."
		set {_target}'s last damage cause to sweep attack
		set metadata value "Element" of {_p} to {_element}
		set metadata value "LastDamageCause" of {_target} to "<#555555>Moonlight Echo"
		set metadata value "LastDamageCauseLore" of {_target} to {_lore}
		make {_p} damage {_target} by ({_damage})

function ShadowMark(p: player, target: entity):
	set {_duration} to 3 seconds
	if metadata value "ShadowMarkDuration%{_p}%" of {_target} is not set:

		set metadata value "ShadowMark%{_p}%" of {_target} to 0
		set metadata value "ShadowMarkDuration%{_p}%" of {_target} to {_duration}

		amountOfDotsSet({_p}, {_target})
		set {_height} to amountOfDots({_p}, {_target})
		set {_dots} to metadata value "AmountOfDots%{_p}%" of {_target}

		while metadata value "ShadowMarkDuration%{_p}%" of {_target} > 0 seconds:
			if metadata value "AmountOfDots%{_p}%" of {_target} < {_dots}:
				set {_height} to amountOfDots({_p}, {_target})

			set {_durationLeft} to metadata value "ShadowMarkDuration%{_p}%" of {_target}
			dotsText(" %seconds of {_durationLeft}% sec", {_p}, {_target}, (location {_height} above {_target}'s head), 0 seconds, 1 second)

			wait 1 second
			remove 1 second from metadata value "ShadowMarkDuration%{_p}%" of {_target}

		clear metadata value "ShadowMarkDuration%{_p}%" of {_target}
		amountOfDotsSubtract({_p}, {_target})

		if {_target} is alive:
			set {_damage} to metadata value "ShadowMark%{_p}%" of {_target}
			clear metadata value "ShadowMark%{_p}%" of {_target}
			if {_damage} > 0:
				set {_damage} to {_damage}*0.3

				set {_element} to "Dark"

				if checkIfInsideMoonlightOrb({_p}) is set:
					set {_element} to "Moonlight"

				set {_lore} to "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<#555555>All targets damaged by &f <#999999>Moonlight Orb%nl%<#555555>receive a &f <#999999>Shadow Mark <#555555>for &f3.0 sec<#555555>.%nl% %nl%<#555555>On expiration, &f <#999999>Shadow Mark <#555555>repeats%nl%&f30%% <#555555>of the damage dealt to the target%nl%<#555555>since its application."
				set {_target}'s last damage cause to sweep attack
				set metadata value "Element" of {_p} to {_element}
				set metadata value "LastDamageCause" of {_target} to "<#555555>Shadow Mark"
				set metadata value "LastDamageCauseLore" of {_target} to {_lore}
				make {_p} damage {_target} by {_damage}

function InvisibilityActionBar(p: player):
	while metadata value "ECEngaged" of {_p} is set:
		if {_p} has invisibility:
			loop potion effects of {_p}:
				if "%type of loop-value%" = "Invisibility":
					set {_dur} to durationShort("%potion duration of loop-value%")
					send action bar " %{_dur}%" to {_p}
		wait 1 second

function ShadowClawsVisual(p: player, target: entity):
	set {_a} to "a"

function CheatDeathUmbreon(p: player):
	set metadata value "DamageReduction" of {_p} to 0.1
	send " Cheat Death triggered. You will take 90%% reduced damage for 3 sec." to {_p}
	wait 3 seconds
	clear metadata value "DamageReduction" of {_p}