on load:
	set {_desc} to "&7&o''As Team Poison pushes their Absolute Zero plan to the limit, the guardians of vitality are storming the Aether Paradise to restore the server’s fading pulse. The rivalry finally boils over in an epic clash between unfiltered life and perfect stasis. Will you roar with the ocean to set reality free or side with the chilling precision of the lab? Choose your team and join the battle for the future of Earthcraft!''"
	set {_desc} to join wrapText({_desc}, 50) by "%nl%&7&o"
	set {boosterteampoisonvsteamaqua} to glass pane of unbreaking 10 named "&5Team Poison vs. Team Aqua &9Booster" with lore "&9Booster%nl%&7Booster containing one or more cards.%nl%&7Contains exclusive cards from this set.%nl% %nl%%{_desc}%" with nbt from "{""minecraft:custom_data"":{""BoosterName"":""Team Poison vs. Team Aqua"",""CardBooster"":1b}}"
	set {dustoxkartatpvsta} to purple stained glass pane named "<##785a8c>Dustox" with lore "&7Poison Moth" and "&7Level: &f0 &7| &7Exp: &f0%nl%&7Statistics:%nl%&7Intellect: &7■■■■■■■■■■ &7(<##59c1e3>0&7)%nl%&7Health: <##c0ff02>&7■■■■■■■■■■ &7(<##c0ff02>0&7)%nl%&7Damage: <##f74428>&7■■■■■■■■■■ &7(<##f74428>0&7)%nl%&7Resistance: <##ffef45>&7■■■■■■■■■■ &7(<##ffef45>0&7)%nl%&7Mobility: &f&7■■■■■■■■■■ &7(&f0&7)%nl%&7Utility: <##ae78d0>&7■■■■■■■■■■ &7(<##ae78d0>0&7)%nl%&7Crowd Control: <##58c3f5>&7■■■■■■■■■■ &7(<##58c3f5>0&7)%nl%&7Versatility: <##e3ebff>&7■■■■■■■■■■ &7(<##e3ebff>0&7)%nl%&7Mastery: <##f53b98>&7■■■■■■■■■■ &7(<##f53b98>0&7)%nl%&7Critical Hit: <##fca417>&7■■■■■■■■■■ &7(<##fca417>0&7)%nl%&7Element: <##d5ff57>&7■■■■■■■■■■ &7(<##d5ff57>0&7)%nl%&7Haste: <##19943e>&7■■■■■■■■■■ &7(<##19943e>0&7)%nl%&7Avoidance: <##2154ad>&7■■■■■■■■■■ &7(<##2154ad>0&7)" and "&7Element: <##9c72b2>Poison" and "&7Source: &fTeam Poison vs. Team Aqua" with nbt from "{""minecraft:custom_model_data"":{floats:[14.0f]}}"

#set {_cardPoppy} to cardItem(lime stained glass pane, "<##702f33>Poppy", 8, 64, "TPVSTA", "tpvsta", "Common", "Fight", 1)
#set lore of {_cardPoppy} to cardLore("Keeper of the Hammer", "<##953301>Fight", "Poison vs. Aqua", "<##79f759>Common", 9, 6, 10, 7, 6, 9, 7, 1, 3, 7, 5, 3)

on rightclick:
	set {_item} to 1 of player's held item
	if boolean tag "CardBooster" of custom nbt of {_item} = true:
		if string tag "BoosterName" of custom nbt of {_item} = "Team Poison vs. Team Aqua":
			remove 1 of {_item} from player

			if {winterDelightPassLEVEL::%player%} >= 0:
				getMission(player, "Boostermania", "Boosteromania", 1)

			load yaml "plugins/Skript/playerdata/boosters/Team Poison vs. Team Aqua/%uuid of player%.yml" as "TPVSTA-%player%"
			set {_boostersOpened} to yaml value "Booster.Opened" in "TPVSTA-%player%"
			add 1 to {_boostersOpened}
			set yaml value "Booster.Opened" in "TPVSTA-%player%" to {_boostersOpened}

			add 1 to {otwboostery::%player%}
			boosterAchievements(player, "TPVSTA")		

			set {_cardKatara} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Katara")

			set {_cardPopplio} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Popplio")

			set {_cardSiren} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Siren")

			set {_cardWatchdog} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Watchdog")

			set {_cardSpifey} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Spifey")

			set {_cardTux} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Tux")

			set {_cardSmeargle} to BoosterCardFromYaml("TPVSTA", "Team Poison's Smeargle")

			set {_cardLyney} to BoosterCardFromYaml("TPVSTA", "Team Poison's Lyney")

			set {_cardEspeon} to BoosterCardFromYaml("TPVSTA", "Team Poison's Espeon")

			set {_cardGarona} to BoosterCardFromYaml("TPVSTA", "Team Poison's Garona")

			set {_cardZiggs} to BoosterCardFromYaml("TPVSTA", "Team Poison's Ziggs")

			set {_cardEzio} to BoosterCardFromYaml("TPVSTA", "Team Poison's Ezio")

			set {_cardMilotic} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Milotic")

			set {_cardShanel} to BoosterCardFromYaml("TPVSTA", "Team Poison's Shanel")

			set {_cardLapras} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Lapras")

			set {_cardHatsuneMiku} to BoosterCardFromYaml("TPVSTA", "Team Poison's Hatsune Miku")

			set {_cardPoseidon} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Poseidon")

			set {_cardMaguro} to BoosterCardFromYaml("TPVSTA", "Team Poison's Maguro")

			set {_cardWafflecopter} to BoosterCardFromYaml("TPVSTA", "Team Aqua's Wafflecopter")

			set {_cardGosha} to BoosterCardFromYaml("TPVSTA", "Team Poison's Gosha")

			chance of 10%:
				BoosterPackDrop(player, {_cardKatara})
			chance of 10%:
				BoosterPackDrop(player, {_cardPopplio})
			chance of 10%:
				BoosterPackDrop(player, {_cardSiren})
			chance of 10%:
				BoosterPackDrop(player, {_cardWatchdog})
			chance of 10%:
				BoosterPackDrop(player, {_cardSpifey})
			chance of 10%:
				BoosterPackDrop(player, {_cardTux})
			chance of 10%:
				BoosterPackDrop(player, {_cardSmeargle})
			chance of 10%:
				BoosterPackDrop(player, {_cardLyney})
			chance of 10%:
				BoosterPackDrop(player, {_cardEspeon})
			chance of 10%:
				BoosterPackDrop(player, {_cardGarona})
			chance of 10%:
				BoosterPackDrop(player, {_cardZiggs})
			chance of 10%:
				BoosterPackDrop(player, {_cardEzio})

			#RARE
			chance of 5%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardMilotic})
			chance of 5%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardShanel})

			#SUPER RARE
			chance of 3%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardLapras})
			chance of 3%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardHatsuneMiku})

			#HYPER RARE
			chance of 1%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardPoseidon})
			chance of 1%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardMaguro})

			#SECRET RARE
			chance of 0.5%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardWafflecopter})
			chance of 0.5%:
				set {_droppedRare} to true
				BoosterPackDrop(player, {_cardGosha})
			
			
			if {_droppedRare} is not true:
				set {_pity} to yaml value "Booster.Pity" in "TPVSTA-%player%"
				add 1 to {_pity}
				if {_pity} = 10:
					set {_pity} to 0
					set {_pityDrop} to true
				set yaml value "Booster.Pity" in "TPVSTA-%player%" to {_pity}

				set {_x} to a random integer between 1 and 12
				if {_x} = 1:
					BoosterPackDrop(player, {_cardKatara})
				else if {_x} = 2:
					BoosterPackDrop(player, {_cardPopplio})
				else if {_x} = 3:
					BoosterPackDrop(player, {_cardSiren})
				else if {_x} = 4:		
					BoosterPackDrop(player, {_cardWatchdog})
				else if {_x} = 5:
					BoosterPackDrop(player, {_cardSpifey})
				else if {_x} = 6:
					BoosterPackDrop(player, {_cardTux})
				else if {_x} = 7:
					BoosterPackDrop(player, {_cardSmeargle})
				else if {_x} = 8:
					BoosterPackDrop(player, {_cardLyney})
				else if {_x} = 9:
					BoosterPackDrop(player, {_cardEspeon})
				else if {_x} = 10:
					BoosterPackDrop(player, {_cardGarona})
				else if {_x} = 11:
					BoosterPackDrop(player, {_cardZiggs})
				else if {_x} = 12:
					BoosterPackDrop(player, {_cardEzio})
			else:
				set yaml value "Booster.Pity" in "TPVSTA-%player%" to 0

			if {_pityDrop} is true:
				set {_randomRare} to a random integer between 1 and 100
				if {_randomRare} is between 1 and 25:
					set {_pityCard} to {_cardMilotic}
				else if {_randomRare} is between 26 and 50:
					set {_pityCard} to {_cardShanel}
				else if {_randomRare} is between 51 and 65:
					set {_pityCard} to {_cardLapras}
				else if {_randomRare} is between 66 and 80:
					set {_pityCard} to {_cardHatsuneMiku}
				else if {_randomRare} is between 81 and 85:
					set {_pityCard} to {_cardPoseidon}
				else if {_randomRare} is between 86 and 90:
					set {_pityCard} to {_cardMaguro}
				else if {_randomRare} is between 91 and 95:
					set {_pityCard} to {_cardWafflecopter}
				else if {_randomRare} is between 95 and 100:
					set {_pityCard} to {_cardGosha}
				BoosterPackDrop(player, {_pityCard})

				send formatted "&f[&2Booster&f] &aThis &awas your &510th booster &ain a row without at least a Rare rarity drop, meaning that %name of {_pityCard}% &ais a pity drop!" to player
				set {_pityDrops} to yaml value "Booster.Pity Drops" in "TPVSTA-%player%"
				add 1 to {_pityDrops}
				set yaml value "Booster.Pity Drops" in "TPVSTA-%player%" to {_pityDrops}

				add 1 to {pityDrops::%player%}

			save yaml "TPVSTA-%player%"