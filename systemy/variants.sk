on inventory click:
    if event-inventory = (metadata tag "kartagui" of player):
        if index of event-slot is 22:
            if name of event-slot contains "&6Variants":
                VariantMenu(player)
                play sound "skill.cresselia.shootingstarhit" with volume 1 and pitch 2 to player

function VariantMenu(p: player) :: number:
    set metadata tag "variantgui" of {_p} to chest inventory with 3 rows named "%uncolored name of {_p}'s tool% - Variants"
    set {_gui} to metadata tag "variantgui" of {_p}
    set {_id} to string tag "Id" of custom nbt of {_p}'s tool
    set {_card} to uncolored name of {_p}'s tool

    load yaml "plugins/Skript/playerdata/karty/%{_card}%/%{_id}%.yml" as "cardVariant-%{_p}%"
    set {_variant} to yaml value "Card.Variant" in "cardVariant-%{_p}%"
    unload yaml "cardVariant-%{_p}%"

    set {_div} to "%{kartacolor::%{_id}%}%✨&m------%{kartacolor::%{_id}%}%⭐&m------%{kartacolor::%{_id}%}%✨&f"

    set {_baseSlot} to 10
    set {_change} to 2

    loop yaml node keys "%{_card}%" in "VariantList":
        add loop-value to {_variants::*}
    
    if size of {_variants::*} > 4:
        set {_change} to 1

    set slot 4 of {_gui} to orange stained glass pane named "&6What are Variants?" with lore "&7TBD"

    set {_} to "<##d4eaff>|⃓"

    loop {_variants::*}:
        set {_item} to yaml value "%{_card}%.%loop-value%.Item" in "VariantList"
        enchant {_item} with infinity 1
        set boolean tag "minecraft:enchantments;show_in_tooltip" of nbt of {_item} to false

        set {_colourDesc} to yaml value "Variant Options.Description Colour" in "VariantList"
        set {_colour} to yaml value "Variant List.%loop-value%.Colour" in "VariantList"

        set name of {_item} to (mini message from "%{_colour}%%loop-value% %{_card}%")

        set {_description::*} to (yaml list "Variant List.%loop-value%.Description" in "VariantList") 
        loop {_description::*}:
            set {_currentLine} to loop-value-2
            replace all "{CARDNAME}" in {_currentLine} with {_card}
            set {_description::%loop-counter-2%} to (mini message from "<i>%{_colourDesc}%%{_currentLine}%")

        set {_description} to join {_description::*} by "%nl%%{_}%  "

        set {_source} to yaml value "%{_card}%.%loop-value%.Source" in "Variants%{_p}%"
        set {_acquired} to yaml value "%{_card}%.%loop-value%.Acquired" in "Variants%{_p}%"
        set {_owned} to yaml value "%{_card}%.%loop-value%.Owned" in "Variants%{_p}%"

        if {_source} is not set:
            set {_source} to "Unknown"
        if {_acquired} is not set:
            set {_acquired} to "Not unlocked"

        set {_lore} to "%{_}%  <##9376E0>✨ %{_card}% Card Variant ✨%nl%%{_}%  %nl%%{_}%  ✨ %{_description}%%nl%%{_}%%nl%%{_}%  <##9376E0>Source: &f%{_source}%%nl%%{_}%  <##9376E0>Acquired: &f%{_acquired}%"
        set {_currentVariant} to yaml value "%{_card}%.Current Variant" in "Variants%{_p}%"
        if {_currentVariant} = loop-value:
            set {_lore} to "%{_lore}%%nl%%{_}%%nl%%{_}%  &a&o✔ Selected"
        else:
            if {_owned} = true:
                set {_lore} to "%{_lore}%%nl%%{_}%%nl%%{_}%  &9&o🖍 Click here to select Variant"
            else:
                set {_lore} to "%{_lore}%%nl%%{_}%%nl%%{_}%  &c&o✘ You do not own this Variant"

        set lore of {_item} to {_lore}
        
        set slot {_baseSlot} of {_gui} to {_item}

        set {_baseSlot} to {_baseSlot} + {_change}

    open {_gui} to {_p}

command /tv:
    trigger:
        set {_divider} to "• —– ٠ ✤ ٠ —– • ·"
        set {_f} to "<gradient:##d4eaff:##82c3ff:##d4eaff:##82c3ff>"
        #mini message from "<gradient:##d4eaff:##82c3ff:##d4eaff:##82c3ff>Winter Delight {CARDNAME}"
        set {_w} to "Winter Delight {CARDNAME}"
        replace all "{CARDNAME}" in {_w} with "Delphox"
        set {_mi} to mini message from "%{_f}%%{_w}%"
        broadcast {_mi}
        stop
        give player glowing stick
        
        #|⃓
        set lore of player's tool to "<##d4eaff>|⃓  <##9376E0>✨ Delphox Card Variant ✨%nl%<##d4eaff>|⃓  %nl%<##d4eaff>|⃓  ✨ %{_gradient}%%nl%<##d4eaff>|⃓  %{_gradient2}%%nl%<##d4eaff>|⃓%nl%<##d4eaff>|⃓  <##9376E0>Source: &fWinter Delight 2024 Event%nl%<##d4eaff>|⃓  <##9376E0>Acquired: &f{ACQUIREDDATE}%nl%<##d4eaff>|⃓%nl%<##d4eaff>|⃓  &a&o✔ Selected"           
        
command /tvr [<text>]:
    trigger:
        set {_gradient} to "Frostbite your enemies with this"
        set {_gradient2} to "exclusive variant for {CARDNAME}."
        #set yaml value "Delphox.Winter Delight.Item" in "VariantList" to player's tool

        set yaml list "Variant List.Winter Delight.Description" in "VariantList" to {_gradient} and {_gradient2}
        set yaml value "Variant List.Winter Delight.Colour" in "VariantList" to "<gradient:##d4eaff:##82c3ff:##d4eaff:##82c3ff>"

        set {_colour} to "<i><gradient:##f57fd2:##ffe3e9>"
        set yaml value "Variant Options.Description Colour" in "VariantList" to {_colour}
        save yaml "VariantList"
