on chestplate change:
	if boolean tag "HeartOfEarthcraft" of custom nbt of future event-item stack is set:
		if metadata value "ECEngaged" of player is not set:
			if player's gamemode != creative:
				set {_Soulbound} to uuid tag "Soulbound" of custom nbt of event-item
				set {_Soulbound} to {_Soulbound} parsed as player
				if {_Soulbound} = player:
					SetPlayerStats(player)
					updateAzeriteArmorLore(player)
					play sound "azerite.trait_select" with volume 5 and pitch 1 to player
					if {azeriteStash::%uuid of player%} > 0:
						addAzerite(player, {azeriteStash::%uuid of player%})
						clear {azeriteStash::%uuid of player%}
			else:
				send "&cEquipped Heart of Earthcraft has no effect. (Ensure that you are in survival mode when equipping the Heart of Earthcraft due to an existing bug with Paper.)" to player

	else if boolean tag "HeartOfEarthcraft" of custom nbt of past event-item stack is set:
		if metadata value "ECEngaged" of player is not set:
			if player's gamemode != creative:
				SetPlayerStats(player)
				updateAzeriteArmorLore(player)
				play sound "azerite.trait_select" with volume 5 and pitch 0.8 to player

on region exit:
	if "%region%" contains "ChamberofHeart":
		stop sound "ambient.chamber_of_heart" for player

on region enter:
	if "%event-region%" contains "spawn":
		if yaml value "Player.OwnsHeart" in "data-%player%" is not set:
			if {poziom::%player%} >= 50:
				magniDialogueVoiced(player, "ahthere", 1 second)
	if "%region%" contains "ChamberOfHeart":
		wait 1 tick
		play sound "ambient.chamber_of_heart" with volume 5 and pitch 1 to player
		if yaml value "Player.OwnsHeart" in "data-%player%" is not set:
			if {poziom::%player%} >= 50:
				magniDialogueVoiced(player, "introduction", 1 second)
		set {_loc} to location(9112.5, -41, 1643.5, world "world")
		load chunk at location(9105, -42, 1627, world "world")
		load chunk at location(9120, -42, 1660, world "world")
		load chunk at location(9105, -42, 1661, world "world")
		load chunk at location(9118, -42, 1628, world "world")
		loop all entities in radius 40 around {_loc}:
			if double tag "AzeriteScale" of (custom nbt of loop-entity) is set:
				set {_scale} to double tag "AzeriteScale" of (custom nbt of loop-entity)
				modelApply(loop-entity, "azeritecrystal", {_scale})
		while "%regions at player%" contains "ChamberofHeart":
			stop loop if "%regions at player%" does not contain "ChamberofHeart"
			wait 1 second
			add 1 to {_seconds}
			if {_seconds} is divisible by 143:
				play sound "ambient.chamber_of_heart" with volume 5 and pitch 1 to player
	else if "%region%" contains "MineLower":
		if yaml value "Player.OwnsHeart" in "data-%player%" is not set:
			if {poziom::%player%} >= 50:
				if cooldown "MagniEntranceDialogue%player%" is finished:
					create cooldown "MagniEntranceDialogue%player%" for 1 minute
					spawn 1 pig at player with nbt from "{Silent:1b,Invulnerable:1b}"
					set {_magni} to last spawned pig
					set metadata value "FollowerNPC" of player to uuid of {_magni}
					disguise {_magni} as saved disguise "Magni"
					magniPathfind(player, {_magni})
					set generic movement speed attribute of {_magni} to 0.4
					set boolean tag "RemoveOnReset" of custom nbt of {_magni} to true
					magniDialogueVoiced(player, "entrance", 1 second)
					wait 1 tick
					entityTitle({_magni}, "the Speaker", -0.85)
	else if "%region%" contains "chambercenter":
		if metadata value "ECHeartQuestline" of player = 4:
			if cooldown "HeartWoundSeal%player%" is finished:
				create cooldown "HeartWoundSeal%player%" for 10 seconds
				send " " to player
				send "" to player
				send " " to player
				send "  <command:/sealazeritewound><tooltip:&fClick here to seal the wound.>&f   &a[Click here to seal the wound]" to player
				send "             &7(Stand in the middle of the room)" to player
				play sound "block.wooden_button.click_on" with volume 5 and pitch 2 to player
				play sound "entity.item.pickup" with volume 5 and pitch 0 to player
	
command /sealazeritewound:
	trigger:
		if metadata value "ECHeartQuestline" of player = 4:
			if boolean tag "HeartOfEarthcraft" of (custom nbt of player's chestplate):
				sealWoundAzerite(player)
			else:
				set {_dialogue} to "Equip yer Heart of Earthcraft to seal the wound, champion."
				magniDialogue(player, {_dialogue}, 0 seconds)
				play sound "entity.villager.ambient" with volume 1 and pitch 0.9 to player
				

function magniPathfind(p: player, magni: entity):
	while "%regions at {_p}%" contains "SpawnArea":
		if "%regions at {_p}%" contains "ChamberofHeart":
			stop loop
		stop loop if {_magni} is not alive
		stop loop if {_p} is not alive
		if distance between {_magni} and {_p} > 30:
			teleport {_magni} to {_p}
		make {_magni} pathfind to {_p}       
		wait 1 second
	set {_uuid} to uuid of {_magni}
	kill {_magni}
	clear metadata value "FollowerNPC" of {_p} if metadata value "FollowerNPC" of {_p} = {_uuid}

function magniDialogueVoiced(p: player, text: string, wait: timespan = 0 seconds):
	wait {_wait}
	if {_text} = "ahthere":
		set {_dialogue} to "Ah, there ye ar, %{_p}%. I must have words with ye! Meet me in the Chamber o' Heart."
		play sound "npc.magnibronzebeard.heart_ahthere" with volume 5 and pitch 1 to {_p}
		set {_extraSound} to true
		send "&7(Chamber of Heart is located in the mine at spawn.)" to {_p}
	else if {_text} = "entrance":
		set {_dialogue} to "The entrance tae the chamber is this way. Come on!"
		play sound "npc.magnibronzebeard.heart_theentrance" with volume 5 and pitch 1 to {_p}
		set {_extraSound} to true
	else if {_text} = "introduction":
		set {_dialogue} to "No need tae panic! Though I suppose my entrance was a bit abrupt... The name's Magni Bronzebeard."
		set {_citizens} to Bukkit.getPluginManager().getPlugin("Citizens")
		set {_magni} to {_citizens}.getNPCRegistry().getById(6748).getEntity()
		play sound "npc.magnibronzebeard.heart_introduction" with volume 5 and pitch 1 on {_magni}
		dialogue({_dialogue}, (location at {_magni}), 0 seconds, 0 seconds, {_p})
		spawnQuestMarker({_p}, {_magni})
		set metadata value "MagniInteraction%{_p}%" of {_magni} to "QuestReady"
	else if {_text} = "theplanet":
		set {_dialogue} to "Earthcraft calls tae ye, champion. She offers a gift... one born of her own essence."
		play sound "npc.magnibronzebeard.heart_theplanet" with volume 5 and pitch 1 to {_p}
	else if {_text} = "thevery":
		set {_dialogue} to "The very Heart of Earthcraft!"
		play sound "npc.magnibronzebeard.heart_thevery" with volume 5 and pitch 1 to {_p}
	else if {_text} = "infuse":
		set {_dialogue} to "Infuse this amulet with power...it might be the only way to save her!"
		play sound "npc.magnibronzebeard.heart_infuse" with volume 5 and pitch 1 to {_p}
	else if {_text} = "ifyouuse":
		set {_dialogue} to "If you use yer amulet to absorb the Azerite, it's power should mend the chamber's seal."
		play sound "npc.magnibronzebeard.heart_ifyouuse" with volume 5 and pitch 1 to {_p}

	else if {_text} = "thatsit":
		set {_dialogue} to "That's it, I think it's working!"
		play sound "npc.magnibronzebeard.heart_thatsit" with volume 5 and pitch 1 to {_p}
	else if {_text} = "keepgoing":
		set {_dialogue} to "Keep going! Just a wee bit more!"
		play sound "npc.magnibronzebeard.heart_keepgoing" with volume 5 and pitch 1 to {_p}
	else if {_text} = "unleash":
		set {_dialogue} to "Now, unleash the Heart's power!"
		play sound "npc.magnibronzebeard.heart_unleash" with volume 5 and pitch 1 to {_p}
	else if {_text} = "youdidit":
		set {_dialogue} to "Ye did it, champion! The chamber is secure!"
		play sound "npc.magnibronzebeard.heart_youdidit" with volume 5 and pitch 1 to {_p}

	portraitDialogue({_p}, "", "Magni Bronzebeard", {_dialogue}, "Champions of Earthcraft")

	if {_extraSound} = true:
		play sound "block.wooden_button.click_on" with volume 5 and pitch 2 to {_p}
		play sound "entity.item.pickup" with volume 5 and pitch 0 to {_p}

function magniDialogue(p: player, dialogue: string, wait: timespan = 0 seconds):
	wait {_wait}
	portraitDialogue({_p}, "", "Magni Bronzebeard", {_dialogue}, "Champions of Earthcraft")
	play sound "block.wooden_button.click_on" with volume 5 and pitch 2 to {_p}
	play sound "entity.item.pickup" with volume 5 and pitch 0 to {_p}

on rightclick on a player:
	if metadata value "MagniInteraction%player%" of clicked player = "QuestReady":
		set metadata value "MagniInteraction%player%" of clicked player to "Ask"
		set {_dialogue} to "I can hear the cries o' the world beneath my feet. The planet trembles in pain! We must find a way tae ease its sufferin'..."
		magniDialogue(player, {_dialogue})
		wait 3 seconds
		send formatted "&7(CTRL) &f&l💬 &fWhat does Earthcraft want of me, Magni? &9(Play cinematic)" to player
		send formatted "&8(If you have sprint bound to another key, press that key instead.)" to player
		play sound "entity.item.pickup" with volume 5 and pitch 1 to player

	else if metadata value "ArmorPieceReady" of player = true:
		set {_citizens} to Bukkit.getPluginManager().getPlugin("Citizens")
		set {_magni} to {_citizens}.getNPCRegistry().getById(6748).getEntity()

		if metadata value "MagniInteraction%player%" of {_magni} = "ArmorPiece":
			set metadata value "MagniArmor" of player to chest inventory with 1 row named "Pick an Azerite Armor Piece"
			set {_menu} to metadata value "MagniArmor" of player

			set {_primaryStat} to string tag "PrimaryStat" of (custom nbt of {karta::%player%})

			loop yaml node keys "Cards" in "StellarChestList":
				if yaml value "Cards.%loop-value%.Primary Stat" in "StellarChestList" = {_primaryStat}:
					if yaml value "Cards.%loop-value%.Playable" in "StellarChestList" = true:
						if loop-value != {kartaname::%player%}:
							set {_cardList::*} to {_cardList::*} and loop-value
			
			set {_card} to a random element of {_cardList::*}
			remove {_card} from {_cardList::*}
			set {_cards::*} to {_cards::*} and {_card}

			set {_cards::*} to {_cards::*} and {kartaname::%player%}
			
			set slot 3 of {_menu} to azeriteArmor(player, "Intro Quest", "Helmet", 60, {_primaryStat}, {_cards::*})
			set slot 4 of {_menu} to azeriteArmor(player, "Intro Quest", "Leggings", 60, {_primaryStat}, {_cards::*})
			set slot 5 of {_menu} to azeriteArmor(player, "Intro Quest", "Boots", 60, {_primaryStat}, {_cards::*})
			
			open {_menu} to player

on inventory click:
	if player's current inventory = (metadata value "MagniArmor" of player):
		if event-inventory = (metadata value "MagniArmor" of player):
			cancel event
			if index of event-slot is between 3 and 5:
				give player event-slot
				close player's inventory
				play sound "azerite.collect" with volume 1 and pitch 1 to player
				send "<#fdd002>Successfully picked your Azerite Armor Piece." to player
				azeriteArmorContentUnlocked(player)
				clear metadata value "MagniArmor" of player
				clear metadata value "ArmorPieceReady" of player


on press of sprint key:
	if metadata value "MagniInteraction%player%" of (target entity of player) = "Ask":
		set metadata value "MagniInteraction%player%" of (target entity of player) to "Heart"
		chamberCinematic(player)
		magniDialogueVoiced(player, "theplanet", 2.5 seconds)
		magniDialogueVoiced(player, "thevery", 15 seconds)
		magniDialogueVoiced(player, "infuse", 20 seconds)
		magniDialogueVoiced(player, "ifyouuse", 26 seconds)

on rightclick:
	if boolean tag "ECHeartQuestlineAzerite" of (custom nbt of clicked entity) = true:
		if metadata value "ECHeartQuestlineMined%player%" of clicked entity != true:
			if boolean tag "HeartOfEarthcraft" of (custom nbt of player's chestplate) is set:
				if player's tool is tagged with minecraft tag "pickaxes":
					azeriteOreMineHeartQuest(player, clicked entity)
				else:
					set {_dialogue} to "Use a pickaxe tae mine this Azerite!"
					magniDialogue(player, {_dialogue}, 0 seconds)
					play sound "entity.villager.ambient" with volume 1 and pitch 0.9 to player
			else:
				set {_dialogue} to "Equip yer Heart of Earthcraft to mine this Azerite, champion."
				magniDialogue(player, {_dialogue}, 0 seconds)
				play sound "entity.villager.ambient" with volume 1 and pitch 0.9 to player
		else:
			set {_dialogue} to "Ye already mined that Azerite ore, champion. Continue tae the next one!"
			magniDialogue(player, {_dialogue}, 0 seconds)
			play sound "entity.villager.ambient" with volume 1 and pitch 0.9 to player
			
function azeriteOreMineHeartQuest(p: player, e: entity):
	set {_casttime} to 6 seconds
	if metadata value "cast" of {_p} is not set:
		set metadata value "mining" of {_p} to true
		set metadata value "cast" of {_p} to {_casttime}
		set {_break} to 0
		set {_above} to 2
		play sound "misc.mine_ore" with volume 2 and pitch 1 at (location of {_e})

		while metadata value "mining" of {_p} = true:
			if metadata value "channeling" of {_p} is set:
				clear metadata value "channeling" of {_p}
			if metadata value "cast" of {_p} is not set:
				if {_p} is a player:
					clear metadata value "mining" of {_p}
					stop sound "azerite.chest_loop" for {_p}
				stop
			if {_force} is not true:
				if distance between {_p} and {_e} > 5:
					stop loop
			if {_casttime} > 0 seconds:
				set metadata value "casttimeleft" of {_p} to {_casttime}
				if {_p} is a player:
					send action bar "Mining... %{_casttime}% " to {_p}
				if {_castTimeValue} is divisible by 1:
					play sound "misc.mine_ore" with volume 2 and pitch 1 at (location of {_e})
					make {_p} swing their hand
					set {_break} to {_break} + 1/{_originalCastTimeValue}
					set {_location} to location 3 above {_e}

					set {_block} to diamond block
					draw 20 of ({_block} block particle with extra value 0.04) with offset vector({_above}/5, {_above}/2, {_above}/5) at {_location}
					set {_block} to gold block
					draw 20 of ({_block} block particle with extra value 0.04) with offset vector({_above}/5, {_above}/2, {_above}/5) at {_location}
					
				wait 0.1 seconds
				remove 0.1 seconds from {_casttime}
				remove 0.1 from {_castTimeValue}
			else:
				if {_p} is a player:
					clear metadata value "mining" of {_p}
					send action bar "" to {_p}
	else:
		stop
		
	clear metadata value "mining" of {_p}
	clear metadata value "cast" of {_p}
	clear metadata value "casttime" of {_p}
	clear metadata value "casttimeleft" of {_p}

	play sound "azerite.collect" with volume 3 and pitch 1 at location of {_e}

	if metadata value "ECHeartQuestline" of {_p} is not set:
		set metadata value "ECHeartQuestline" of {_p} to 0

	set metadata value "ECHeartQuestlineMined%{_p}%" of {_e} to true

	set metadata value "ECHeartQuestline" of {_p} to (metadata value "ECHeartQuestline" of {_p} + 1)

	if metadata value "ECHeartQuestline" of {_p} = 1:
		magniDialogueVoiced({_p}, "thatsit")

	else if metadata value "ECHeartQuestline" of {_p} = 3:
		magniDialogueVoiced({_p}, "keepgoing")

	else if metadata value "ECHeartQuestline" of {_p} = 4:
		magniDialogueVoiced({_p}, "unleash")

function sealWoundAzerite(p: player):
	set {_casttime} to 10 seconds
	if metadata value "cast" of {_p} is not set:
		set metadata value "cast" of {_p} to {_casttime}
		set metadata value "casting" of {_p} to true
		play sound "azerite.loop" with volume 1 and pitch 1 to {_p}

		while metadata value "casting" of {_p} = true:
			if metadata value "channeling" of {_p} is set:
				clear metadata value "channeling" of {_p}
			if metadata value "cast" of {_p} is not set:
				stop sound "azerite.loop" for {_p}
				Interrupt({_p}, {_p})

			if "%region at {_p}%" does not contain "chambercenter":
				stop sound "azerite.loop" for {_p}
				Interrupt({_p}, {_p})
				stop 

			if {_casttime} > 0 seconds:
				set metadata value "casttimeleft" of {_p} to {_casttime}
				if {_p} is a player:
					send action bar "Sealing... %{_casttime}% " to {_p}
				if {_castTimeValue} is divisible by 1:
					play sound "azerite.collect_small" with volume 1 and pitch 1 at (location of {_p})
					make {_p} swing their hand
					set {_break} to {_break} + 1/{_originalCastTimeValue}
					set {_location} to location 3 above {_e}

					draw 10 of light blue dust particle of size 1 with extra value 0.01 with offset vector(1, 1, 1) at location above {_p}
					draw 10 of yellow dust particle with extra value 0.01 with offset vector(1, 1, 1) at location above {_p}
					
				wait 0.1 seconds
				remove 0.1 seconds from {_casttime}
				remove 0.1 from {_castTimeValue}
			else:
				if {_p} is a player:
					stop sound "azerite.loop" for {_p}
					Interrupt({_p}, {_p})
	else:
		stop
		
	clear metadata value "mining" of {_p}
	clear metadata value "cast" of {_p}
	clear metadata value "casting" of {_p}
	clear metadata value "casttime" of {_p}
	clear metadata value "casttimeleft" of {_p}
	set metadata value "ECHeartQuestline" of {_p} to 0

	draw 60 of light blue dust particle of size 1 with extra value 0.01 with offset vector(1, 1, 1) at location above {_p}
	draw 30 of yellow dust particle with extra value 0.01 with offset vector(1, 1, 1) at location above {_p}
	clear metadata value "ECHeartQuestline" of {_p}
	magniDialogueVoiced({_p}, "youdidit")
	addAzerite({_p}, 350)

	set {_dialogue} to "And now, a reward befittin' the deed. Let's see it put to work."
	magniDialogue({_p}, {_dialogue}, 6 seconds)
	
	wait 6 seconds

	set {_dialogue} to "I'll forge ye a piece o' armor from the chamber's own resonance. Ye pick. One piece, the rest ye'll earn."
	magniDialogue({_p}, {_dialogue}, 6 seconds)

	wait 10 seconds
	set {_citizens} to Bukkit.getPluginManager().getPlugin("Citizens")
	set {_magni} to {_citizens}.getNPCRegistry().getById(6748).getEntity()

	loop 4 times:
		play sound "block.anvil.place" with volume 3 and pitch 1 at location of {_magni}
		make {_magni} swing their hand
		wait 2 seconds
	
	set metadata value "ArmorPieceReady" of {_p} to true
	set metadata value "MagniInteraction%{_p}%" of {_magni} to "ArmorPiece"
	set {_dialogue} to "It's ready. Wear it proud, champion! Earthcraft's strength is now yer own!"
	magniDialogue({_p}, {_dialogue})
		

function grantPlayerHeartOfEC(p: player):
	set {_nbt} to "{""minecraft:custom_model_data"":{floats:[10.0f]}}"
	set {_itemLevel} to 60
	set {_stat} to round(accessoryGearFormula({_itemLevel})/3, 0)
	set {_multiplier} to statMultiplierGear("accessory")
	set {_health} to round(healthFormula({_itemLevel})*{_multiplier}, 0)
	set {_heart} to gold nugget named "<##e8ce81>Heart of Earthcraft" with lore "<##fdd002>Item Level %{_itemLevel}%%nl%&fSoulbound to %{_p}%%nl%&f+%{_health}% Health%nl%<##00ff00>+%{_stat}% Critical Hit%nl%<##00ff00>+%{_stat}% Haste%nl%<##00ff00>+%{_stat}% Mastery%nl% %nl%<##00ff00>Equip: Harnesses the energy of raw%nl%<##00ff00>Azerite, awakening exceptional pieces%nl%<##00ff00>of armor that possess latent powers.%nl% %nl%<##fdd002>''A living symbol of hope, borne by the%nl%<##fdd002>champions of a dying planet. The fate%nl%<##fdd002>of Earthcraft will be shared by all its%nl%<##fdd002>children.''"
	set {_heart} to {_heart} with nbt from {_nbt}
	set tooltip style of {_heart} to "azerite"

	set {_customNbt} to custom nbt of {_heart}
	set boolean tag "HeartOfEarthcraft" of {_customNbt} to true
	set uuid tag "Soulbound" of {_customNbt} to {_p}'s uuid
	set int tag "Stats;Health" of {_customNbt} to {_health}
	set int tag "Stats;Critical Hit" of {_customNbt} to {_stat}
	set int tag "Stats;Haste" of {_customNbt} to {_stat}
	set int tag "Stats;Mastery" of {_customNbt} to {_stat}
	set int tag "ItemLevel" of {_customNbt} to {_itemLevel}
	set int tag "HeartLevel" of {_customNbt} to 1
	set int tag "Azerite" of {_customNbt} to 0
	set int tag "AzeriteTotal" of {_customNbt} to 0
	set int tag "AzeriteRequired" of {_customNbt} to 350

	apply equippable component to {_heart}:
		slot: chestplate slot
		equip_sound: "item.armor.equip_gold"
		asset_id: "heartofearthcraft"
		dispensable: true
		swappable: true
		damage_on_hurt: false

	give {_p} {_heart}
	setHeartOfEarthcraft({_p}, {_heart})
	heartBackup({_p}, {_heart})
	heartContentUnlocked({_p})
	send formatted "<##fdd002>You receive: <tooltip:%name of {_heart}%%nl%%join lore of {_heart} by nl%>&f <##e8ce81>[Heart of Earthcraft]" to {_p}

	achievementYaml({_p}, "Heart of Earthcraft", "Have+a+Heart", 1)
	set yaml value "Player.OwnsHeart" in "data-%{_p}%" to true

	save yaml "data-%{_p}%"

function heartOfECUpdate(p: player):
	set {_previousStat} to int tag "Stats;Haste" of (custom nbt of {_p}'s chestplate)
	set {_previousHealth} to int tag "Stats;Health" of (custom nbt of {_p}'s chestplate)
	
	set {_itemLevel} to int tag "ItemLevel" of (custom nbt of {_p}'s chestplate)
	set {_stat} to round(accessoryGearFormula({_itemLevel})/3, 0)
	set {_multiplier} to statMultiplierGear("accessory")
	set {_health} to round(healthFormula({_itemLevel})*{_multiplier}, 0)
	set int tag "Stats;Health" of (custom nbt of {_p}'s chestplate) to {_health}
	set int tag "Stats;Critical Hit" of (custom nbt of {_p}'s chestplate) to {_stat}
	set int tag "Stats;Haste" of (custom nbt of {_p}'s chestplate) to {_stat}
	set int tag "Stats;Mastery" of (custom nbt of {_p}'s chestplate) to {_stat}
	set lore of {_p}'s chestplate to "<##fdd002>Item Level %{_itemLevel}%%nl%&fSoulbound to %{_p}%%nl%&f+%{_health}% Health%nl%<##00ff00>+%{_stat}% Critical Hit%nl%<##00ff00>+%{_stat}% Haste%nl%<##00ff00>+%{_stat}% Mastery%nl% %nl%<##00ff00>Equip: Harnesses the energy of raw%nl%<##00ff00>Azerite, awakening exceptional pieces%nl%<##00ff00>of armor that possess latent powers.%nl% %nl%<##fdd002>''A living symbol of hope, borne by the%nl%<##fdd002>champions of a dying planet. The fate%nl%<##fdd002>of Earthcraft will be shared by all its%nl%<##fdd002>children.''"

	if {_stat} != {_previousStat}:
		set {_increase} to true
		set {_statIncrease} to {_stat}-{_previousStat}
	if {_health} != {_previousHealth}:
		set {_increase} to true
		set {_healthIncrease} to {_health}-{_previousHealth}
	if {_increase} = true:
		send " " to {_p}
		set {_heart} to {_p}'s chestplate
		send formatted "<##fdd002>Your &f <tooltip:%name of {_heart}%%nl%%join lore of {_heart} by nl%><##e8ce81>[Heart of Earthcraft] <##fdd002>gains the following attributes:" to {_p}
		if {_healthIncrease} is set:
			send "<##fdd002>- +%{_healthIncrease}% <##e8ce81> <##fdd002>Health" to {_p}
		if {_statIncrease} is set:
			send "<##fdd002>- +%{_statIncrease}% <##e8ce81> <##fdd002>Critical Hit" to {_p}
			send "<##fdd002>- +%{_statIncrease}% <##e8ce81> <##fdd002>Haste" to {_p}
			send "<##fdd002>- +%{_statIncrease}% <##e8ce81> <##fdd002>Mastery" to {_p}

	setHeartOfEarthcraft({_p}, {_p}'s chestplate)
	updateAzeriteArmorLore({_p})

function getHeartOfEarthcraft(p: player) :: item:
	set {_id} to random 8 char string from charset `0-9` `a-z`
	load yaml "plugins/Skript/playerdata/heart/%uuid of {_p}%" as "%{_id}%"
	set {_heart} to yaml value "Heart of Earthcraft" in "%{_id}%"
	unload yaml "%{_id}%"
	return {_heart}

function setHeartOfEarthcraft(p: player, item: item) :: item:
	set {_id} to random 8 char string from charset `0-9` `a-z`
	load yaml "plugins/Skript/playerdata/heart/%uuid of {_p}%" as "%{_id}%"
	set yaml value "Heart of Earthcraft" in "%{_id}%" to {_item}
	save yaml "%{_id}%"
	unload {_id}

function azeriteType(azerite: number, stringEnd: string, justAzerite: boolean = false) :: string:
	if {_azerite} is between 1 and 50:
		set {_azeriteType} to "&f <##00ff00>[Tiny Azerite Splinter]"

	else if {_azerite} < 150:
		set {_azeriteType} to "&f <##00ff00>[Small Azerite Shard]"

	else if {_azerite} < 200:
		set {_azeriteType} to "&f <##00ff00>[Small Azerite Cluster]"

	else if {_azerite} < 300:
		set {_azeriteType} to "&f <##0070dd>[Glowing Azerite Crystal]"

	else if {_azerite} < 425:
		set {_azeriteType} to "&f <##0070dd>[Glowing Azerite]"

	else if {_azerite} < 500:
		set {_azeriteType} to "&f <##0070dd>[Glowing Azerite Geode]"

	else if {_azerite} <= 650:
		set {_azeriteType} to "&f <##a335ee>[Radiant Azerite Fragment]"

	else if {_azerite} < 1500:
		set {_azeriteType} to "&f <##a335ee>[Radiant Azerite Core]"

	else if {_azerite} < 3000:
		set {_azeriteType} to "&f <##a335ee>[Radiant Azerite Matrix]"

	else:
		set {_azeriteType} to "&f <##a335ee>[Humming Azerite Heart]"

	if {_justAzerite} = false:
		set {_string} to "<##fdd002>You receive item: %{_azeriteType}%%{_stringEnd}%"
	else:
		set {_string} to {_azeriteType}

	return {_string}
	
function addAzerite(p: player, azerite: integer):
	if boolean tag "HeartOfEarthcraft" of (custom nbt of {_p}'s chestplate) is set:
		set {_heart} to {_p}'s chestplate
		add {_azerite} to (int tag "AzeriteTotal" of (custom nbt of {_p}'s chestplate))
		set {_heartLevel} to (int tag "HeartLevel" of (custom nbt of {_p}'s chestplate))
		add {_azerite} to (int tag "Azerite" of (custom nbt of {_p}'s chestplate))
		set {_heartLevelStart} to {_heartLevel}
		if {azeriteStash::%uuid of {_p}%} > 0:
			set {_stringEnd} to " <##fdd002>from your Azerite Stash."
		else:
			set {_stringEnd} to "<##fdd002>."

		send formatted azeriteType({_azerite}, {_stringEnd}) to {_p}
									
		send formatted "&f <tooltip:%name of {_heart}%%nl%%join lore of {_heart} by nl%><##e8ce81>[Heart of Earthcraft] <##fdd002>gains %{_azerite}% Artifact Power." to {_p}
		
		if {_azerite} < 200:
			play sound "azerite.collect_small" with volume 1 and pitch 1 to {_p}
		else:
			play sound "azerite.collect" with volume 1 and pitch 1 to {_p}

		set {_azeriteRequirement} to azeriteRequirement({_heartLevel})

		while int tag "Azerite" of (custom nbt of {_p}'s chestplate) >= {_azeriteRequirement}:
			remove {_azeriteRequirement} from int tag "Azerite" of (custom nbt of {_p}'s chestplate)
			add 1 to int tag "HeartLevel" of (custom nbt of {_p}'s chestplate)
			add 2 to int tag "ItemLevel" of (custom nbt of {_p}'s chestplate)
			set {_heartLevel} to int tag "HeartLevel" of (custom nbt of {_p}'s chestplate)
			set int tag "AzeriteRequired" of (custom nbt of {_p}'s chestplate) to azeriteRequirement({_heartLevel})
			set {_azeriteRequirement} to azeriteRequirement({_heartLevel})

		if {_heartLevel} > {_heartLevelStart}:
			play sound "azerite.cast" with volume 2 and pitch 2 to {_p}
			play sound "azerite.cast" with volume 2 and pitch 0.5 to {_p}
			heartOfECUpdate({_p})
			set {_title} to "&f <##e8ce81>Heart of Earthcraft"
			set {_subtitle} to "       <##00ff00>Power Increased <##00ff00>to Level %{_heartLevel}%"
			send title {_title} with subtitle {_subtitle} to {_p} for 5 seconds with fade in 1.5 second and fade out 1.5 second
			set {_heart} to {_p}'s chestplate
			broadcast " "
			broadcast "<##fdd002>%{_p}% reached Level %{_heartLevel}% on their &f <tooltip:%name of {_heart}%%nl%%join lore of {_heart} by nl%><##e8ce81>[Heart of Earthcraft]<##fdd002>!"
		heartBackup({_p}, {_p}'s chestplate)
	else:
		set {azeriteStash::%uuid of {_p}%} to {azeriteStash::%uuid of {_p}%} + {_azerite}
		send formatted azeriteType({_azerite}, " <##fdd002>to your Azerite Stash.") to {_p}

		set {_heart} to getHeartOfEarthcraft({_p})
		send formatted "&f <tooltip:%name of {_heart}%%nl%%join lore of {_heart} by nl%><##e8ce81>[Heart of Earthcraft] <##fdd002>will receive %{_azerite}% Artifact Power." to {_p}

function azeriteRequirement(heartLevel: integer) :: integer:
	if 14 >= {_heartLevel}:
		if {_heartLevel} is between 0 and 8:
			set {_azeriteRequirement} to 300 + {_heartLevel}*50
		else if {_heartLevel} = 9:
			set {_azeriteRequirement} to 1050
		else if {_heartLevel} = 10:
			set {_azeriteRequirement} to 1580
		else if {_heartLevel} = 11:
			set {_azeriteRequirement} to 2370
		else if {_heartLevel} = 12:
			set {_azeriteRequirement} to 3560
		else if {_heartLevel} = 13:
			set {_azeriteRequirement} to 5350
		else if {_heartLevel} = 14:
			set {_azeriteRequirement} to 8000			
	else:
		set {_azeriteRequirement} to 8000
		loop ({_heartLevel}-14) times:
			set {_azeriteRequirement} to ({_azeriteRequirement}*1.3)/50
			set {_rawnumber} to rounded down {_azeriteRequirement}
			set {_number} to {_azeriteRequirement} - {_rawnumber}
			if {_number} > 0.45:
				set {_azeriteRequirement} to (rounded up {_azeriteRequirement})*50
			else:
				set {_azeriteRequirement} to (rounded down {_azeriteRequirement})*50
	return {_azeriteRequirement}

function heartBackup(p: player, heart: item):
	load yaml "plugins/Skript/backups/heart/%uuid of {_p}%.yml" as "heartBackup-%{_p}%"
	set yaml value "Heart" in "heartBackup-%{_p}%" to {_heart}
	save yaml "heartBackup-%{_p}%"
	unload yaml "heartBackup-%{_p}%"
	#Add magni option - I seem to have misplaced my Heart of Earthcraft.
	#No problem - found it for ye
	#magni will tell you heart level