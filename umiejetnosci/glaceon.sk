									else:
										if {_iciclesBefore} is set:
											loop 2 times:
												IcicleForm(player, ({_iciclesBefore} + loop-number))
									send action bar " Icicles: %{icicles::%player%}%" to player
									if getTrait(player, "Splintering Cold") is set:
										chance of 10%:
											loop 2 times:
												set {icicles::%player%} to {icicles::%player%} + 1
												TrackIcicleGeneration(player, {_target})
									wait 1 tick
									loop 3 times:
										if {_target} is alive:
											set {_l} to location 0.3 blocks below player's head
											set {_l} to location 0.4 blocks right of {_l}
											set {_v} to vector between {_l} and {_target}'s head
											loop round(distance between {_l} and {_target}) / 1 times:
												set {_v} to vector between {_l} and {_target}'s head
												set vector length of {_v} to loop-value-2 * 1
												draw 1 of ((rgb 63, 188, 242) dust particle of size 1) at {_l} ~ {_v}
												draw 1 of ice block particle at {_l} ~ {_v}
											
											if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%player%}) is set:
												set {_critModifier} to 2.2
											else:
												set {_critModifier} to 2

											set {_damageBeforeCrit} to {_damage}

											set {_target}'s last damage cause to sweep attack
											set metadata value "Element" of player to "Ice"
											set metadata value "LastDamageCause" of {_target} to "<##4bbfe2>Flurry"
											set metadata value "LastDamageCauseLore" of {_target} to {_lore}
											set {_damage} to Crit(player, {_target}, {_crit}, {_damage}, {_critModifier})
											make player damage {_target} by {_damage}
											if getTrait(player, "Glacial Assault") is set:
												chance of 20%:
													set {_gaDmg} to offensiveTrait(player, "Glaceon", "Glacial Assault")
													GlacialAssaultComet(player, {_target}, {_gaDmg})
											if getTrait(player, "Glacial Assault") is set:
												chance of 20%:
													set {_gaDmg} to offensiveTrait(player, "Glaceon", "Glacial Assault")
													GlacialAssaultComet(player, {_target}, {_gaDmg})
											
											if {_damage} != {_damageBeforeCrit}:
												if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%player%}) is set:
													if metadata value "Icy Veins" of player is true:
														remove 0.75 seconds from cooldown "Icy Veins%player%"

											clear {_damageBeforeCrit}

											if {_brainFreeze} is true:
												if metadata value "WintersChill%player%" of {_target} is not set:
