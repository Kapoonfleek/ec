function ProfileFavouriteCard(p: player) :: text:
	set {_card} to yaml value "Player.Profile.Favourite Card" in "data-%{_p}%"
	if {_card} is not set:
		set {_card} to "Not set"
	return {_card}

function ProfileFavouriteElement(p: player) :: text:
	set {_element} to yaml value "Player.Profile.Favourite Element" in "data-%{_p}%"
	if {_element} is not set:
		set {_element} to "Not set"
	return {_element}

function ProfileBirthday(p: player) :: text:
	set {_birthday} to yaml value "Player.Profile.Birthday" in "data-%{_p}%"
	if {_birthday} is not set:
		if {dataurodzin::%{_p}%} is set:
			set {_birthday} to {dataurodzin::%{_p}%}
	if {_birthday} is not set:
		set {_birthday} to "Not set"
	else if {_birthday} contains ".":
		set {_parts::*} to {_birthday} split at "."
		if size of {_parts::*} = 3:
			set {_d} to {_parts::1} parsed as integer
			set {_m} to {_parts::2} parsed as integer
			set {_y} to {_parts::3} parsed as integer
			set {_monthName} to GetMonthName({_m})
			set {_birthday} to "%{_d}% %{_monthName}% %{_y}%"
	return {_birthday}

function ProfileTeam(p: player) :: text:
	set {_team} to yaml value "Player.Team" in "data-%{_p}%"
	if {_team} is not set:
		set {_team} to "None"
	return {_team}

function ProfileCurrentCard(p: player) :: text:
	if {kartaname::%{_p}%} is set:
		return {kartaname::%{_p}%}
	return "None"

function ProfileCurrentCardLevel(p: player) :: number:
	if yaml "activeCard-%{_p}%" is loaded:
		set {_level} to yaml value "Card.Level" in "activeCard-%{_p}%"
		if {_level} is set:
			return {_level}
	return 0

function ProfilePrimaryStatIcon(stat: text) :: text:
	if {_stat} = "Strength":
		return "<#e35959> &fStrength"
	else if {_stat} = "Intellect":
		return "<#59c1e3> &fIntellect"
	else if {_stat} = "Agility":
		return "<#5ee359> &fAgility"
	return "&f %{_stat}%"

function ProfilePrimaryStatLine(p: player) :: text:
	set {_primaryStat} to metadata value "PrimaryStatType" of {_p}
	if {_primaryStat} is set:
		set {_value} to PrimaryStatStat({_p})
		set {_icon} to ProfilePrimaryStatIcon({_primaryStat})
		return "%{_icon}% &7- &f%{_value}%"
	return "&f Primary Stat &7- &fNone"

function ProfileHealthLine(p: player) :: text:
	set {_health} to round(Health({_p}), 0)
	return "<#c0ff02> &fHealth &7- &f%{_health}%"

function ProfileTopStatsLines(p: player) :: texts:
	set {_indices::*} to retrieveTopStats({_p}, "indices")
	set {_values::*} to retrieveTopStats({_p}, "values")
	set {_rank} to 0
	set {_i} to 1
	loop {_indices::*}:
		set {_stat} to loop-value
		set {_value} to {_values::%{_i}%}
		set {_i} to {_i} + 1
		if {_stat} != "Health":
			set {_rank} to {_rank} + 1
			set {_icon} to returnStatIcon({_stat})
			set {_lines::*} to {_lines::*} and "&7%{_rank}%. %{_icon}% &7- &f%{_value}%"
		if {_rank} >= 5:
			exit loop
	return {_lines::*}

function ProfilePlayerLevel(p: player) :: number:
	if yaml "data-%{_p}%" is loaded:
		set {_level} to yaml value "Player.Level" in "data-%{_p}%"
		if {_level} is set:
			return {_level}
	return {poziom::%{_p}%}

function ProfilePlayerExp(p: player) :: number:
	if yaml "data-%{_p}%" is loaded:
		set {_exp} to yaml value "Player.Exp" in "data-%{_p}%"
		if {_exp} is set:
			return {_exp}
	return {exp::%{_p}%}

function LegacyToMiniMessage(t: text) :: text:
	replace all "&a" with "<color:##55FF55>" in {_t}
	replace all "&b" with "<color:##55ffff>" in {_t}
	replace all "&c" with "<color:##ff5555>" in {_t}
	replace all "&d" with "<color:##FF55FF>" in {_t}
	replace all "&e" with "<color:##FFFF55>" in {_t}
	replace all "&f" with "<color:##FFFFFF>" in {_t}
	replace all "&1" with "<color:##0000aa>" in {_t}
	replace all "&2" with "<color:##00AA00>" in {_t}
	replace all "&3" with "<color:##00AAAA>" in {_t}
	replace all "&4" with "<color:##aa0000>" in {_t}
	replace all "&5" with "<color:##AA00AA>" in {_t}
	replace all "&6" with "<color:##FFAA00>" in {_t}
	replace all "&7" with "<color:##AAAAAA>" in {_t}
	replace all "&8" with "<color:##555555>" in {_t}
	replace all "&9" with "<color:##5555ff>" in {_t}
	replace all "&0" with "<color:##000000>" in {_t}
	replace all "&l" with "<bold>" in {_t}
	replace all "&n" with "<underlined>" in {_t}
	replace all "&o" with "<i>" in {_t}
	replace all "&m" with "<strikethrough>" in {_t}
	replace all "&k" with "<obfuscated>" in {_t}
	replace all "&r" with "<reset>" in {_t}
	replace all "<##" with "<color:##" in {_t}
	return {_t}

function ProfileHoverText(p: player) :: text:
	set {_level} to ProfilePlayerLevel({_p})
	set {_exp} to ProfilePlayerExp({_p})
	set {_favouriteCard} to ProfileFavouriteCard({_p})
	set {_favouriteElement} to ProfileFavouriteElement({_p})
	set {_currentCard} to ProfileCurrentCard({_p})
	set {_cardLevel} to ProfileCurrentCardLevel({_p})
	set {_primaryStat} to ProfilePrimaryStatLine({_p})
	set {_healthLine} to ProfileHealthLine({_p})
	set {_stoneMined} to {stone::%{_p}%} + {deepslate::%{_p}%}*2
	set {_mobKills} to {mobskilled::%{_p}%}
	set {_hover} to "&fLevel %{_level}% &7| &fExp. %{_exp}%"
	set {_hover} to "%{_hover}%%nl% %nl%&fFavourite Card: &e%{_favouriteCard}%"
	set {_hover} to "%{_hover}%%nl%&fFavourite Element: &e%{_favouriteElement}%"
	set {_hover} to "%{_hover}%%nl%&fBirthday: &e%ProfileBirthday({_p})%"
	set {_hover} to "%{_hover}%%nl%&fTeam: &e%ProfileTeam({_p})%"
	set {_hover} to "%{_hover}%%nl% %nl%&fCurrent Card: &e%{_currentCard}%"
	set {_hover} to "%{_hover}%%nl%&fCard Level: &e%{_cardLevel}%"
	set {_hover} to "%{_hover}%%nl% %nl%%{_primaryStat}%"
	set {_hover} to "%{_hover}%%nl%%{_healthLine}%"
	set {_stats::*} to ProfileTopStatsLines({_p})
	loop {_stats::*}:
		set {_hover} to "%{_hover}%%nl%%loop-value%"
	set {_hover} to "%{_hover}%%nl% %nl%&fTotal mob kills: &e%formatNumberEc({_mobKills})%"
	set {_hover} to "%{_hover}%%nl%&fTotal stone mined: &e%formatNumberEc({_stoneMined})%"
	set {_hover} to LegacyToMiniMessage({_hover})
	replace all nl in {_hover} with "<newline>"
	return {_hover}

function LoadTargetData(target: player):
	if yaml "data-%{_target}%" is not loaded:
		load yaml "plugins/Skript/playerdata/%uuid of {_target}%.yml" as "data-%{_target}%"

function LoadStellarChestList():
	if yaml "StellarChestList" is not loaded:
		load yaml "plugins/Skript/lists/StellarChestList" as "StellarChestList"

function IsCardCollected(p: player, booster: text, card: text) :: boolean:
	if {kolekcja::karty::%{_p}%::*} contains {_card}:
		return true
	set {_pathName} to {_booster}
	if {_booster} = "Team Poison vs Team Aqua":
		set {_pathName} to "Team Poison vs. Team Aqua"
	if yaml "%{_booster}%-%{_p}%" is not loaded:
		load yaml "plugins/Skript/playerdata/boosters/%{_pathName}%/%uuid of {_p}%.yml" as "%{_booster}%-%{_p}%"
	set {_val} to yaml value "Cards.%{_card}%" in "%{_booster}%-%{_p}%"
	if {_val} is set:
		if {_val} > 0:
			return true
	return false

function CountYamlTrue(yamlId: text, path: text) :: number:
	set {_count} to 0
	set {_keys::*} to yaml node keys "%{_path}%" in {_yamlId}
	loop {_keys::*}:
		set {_childPath} to "%{_path}%.%loop-value%"
		if yaml value "%{_childPath}%" in {_yamlId} is true:
			set {_count} to {_count} + 1
		else:
			set {_childKeys::*} to yaml node keys "%{_childPath}%" in {_yamlId}
			if {_childKeys::*} is set:
				set {_count} to {_count} + CountYamlTrue({_yamlId}, {_childPath})
	return {_count}

function ProfileSummaryLore(p: player) :: texts:
	set {_stoneMined} to {stone::%{_p}%} + {deepslate::%{_p}%}*2
	set {_lore::*} to "&fLevel %ProfilePlayerLevel({_p})% &7| &fExp. %ProfilePlayerExp({_p})%", " ", "&fFavourite Card: &e%ProfileFavouriteCard({_p})%", "&fFavourite Element: &e%ProfileFavouriteElement({_p})%", "&fBirthday: &e%ProfileBirthday({_p})%", "&fTeam: &e%ProfileTeam({_p})%", " ", "&fCurrent Card: &e%ProfileCurrentCard({_p})%", "&fCard Level: &e%ProfileCurrentCardLevel({_p})%", " ", "%ProfilePrimaryStatLine({_p})%", "%ProfileHealthLine({_p})%"
	set {_stats::*} to ProfileTopStatsLines({_p})
	loop {_stats::*}:
		set {_lore::*} to {_lore::*} and loop-value
	set {_lore::*} to {_lore::*} and " " and "&fTotal mob kills: &e%formatNumberEc({mobskilled::%{_p}%})%" and "&fTotal stone mined: &e%formatNumberEc({_stoneMined})%"
	return {_lore::*}

function OpenProfileMain(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-main" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Profile"
	set {_gui} to metadata tag "profile-main" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set slot 4 of {_gui} to (skull of ("%{_target}%" parsed as offlineplayer) named "&f%{_target}%" with lore ProfileSummaryLore({_target})) with item flag hide attributes
	set slot 10 of {_gui} to book named "&bCollection" with lore "&7View collected cards." with item flag hide attributes
	set slot 11 of {_gui} to compass named "&aStatistics" with lore "&7View saved profile statistics." with item flag hide attributes
	set slot 12 of {_gui} to totem of undying named "&6Achievements" with lore "&7View achievement progress." with item flag hide attributes
	set slot 14 of {_gui} to cake named "&dSet Birthday" with lore "&7Current: &f%ProfileBirthday({_target})%" with item flag hide attributes
	set slot 15 of {_gui} to paper named "&eSet Favourite Card" with lore "&7Current: &f%ProfileFavouriteCard({_target})%" with item flag hide attributes
	set slot 16 of {_gui} to blaze powder named "&cSet Favourite Element" with lore "&7Current: &f%ProfileFavouriteElement({_target})%" with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollection(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-collection" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Collection"
	set {_gui} to metadata tag "profile-collection" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set slot 12 of {_gui} to nether star named "&fPlayable Cards" with lore "&7View your collected playable cards." with item flag hide attributes
	set slot 14 of {_gui} to experience bottle named "&9Booster Cards" with lore "&7View collected booster cards." with item flag hide attributes
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionPlayable(viewer: player, target: player):
	LoadTargetData({_target})
	LoadStellarChestList()
	set metadata tag "profile-collection-playable" of {_viewer} to chest inventory with 6 rows named "%{_target}% - Playable Cards"
	set {_gui} to metadata tag "profile-collection-playable" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_slot} to 0
	set {_cards::*} to yaml node keys "Cards" in "StellarChestList"
	loop {_cards::*}:
		set {_card} to loop-value
		set {_preview} to StellarCardPreview({_card}, true)
		if {_preview} is set:
			if {kolekcja::karty::%{_target}%::*} contains {_card}:
				set lore of {_preview} to coloured lore of {_preview}
				set {_preview} to {_preview} with item flag hide attributes
			else:
				set {_preview} to gray stained glass pane named name of {_preview}
				set {_lore::*} to coloured lore of {_preview}
				set {_lore::*} to {_lore::*} and " " and "&8Not collected yet"
				set lore of {_preview} to {_lore::*}
			set slot {_slot} of {_gui} to {_preview}
			set {_slot} to {_slot} + 1
			if {_slot} >= 45:
				exit loop
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterMain(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-collection-booster" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Booster Cards"
	set {_gui} to metadata tag "profile-collection-booster" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set slot 12 of {_gui} to nether star named "&fAll Cards" with lore "&7View all booster cards." with item flag hide attributes
	set slot 14 of {_gui} to book named "&9Per Booster" with lore "&7View booster cards sorted per booster." with item flag hide attributes
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterSetSelect(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-collection-booster-select" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Per Booster"
	set {_gui} to metadata tag "profile-collection-booster-select" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_slot} to 11
	set {_boosters::*} to "Secret Wonders", "Majestic Dawn", "Unseen Forces", "Plasma Freeze", "Team Poison vs Team Aqua"
	loop {_boosters::*}:
		set slot {_slot} of {_gui} to glass pane named "&9%loop-value% &7Booster" with lore "&7View cards from this booster." with item flag hide attributes
		set {_slot} to {_slot} + 1
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterAll(viewer: player, target: player):
	LoadTargetData({_target})
	LoadStellarChestList()
	set metadata tag "profile-collection-booster-all" of {_viewer} to chest inventory with 6 rows named "%{_target}% - All Booster Cards"
	set {_gui} to metadata tag "profile-collection-booster-all" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_boosters::*} to "Secret Wonders", "Majestic Dawn", "Unseen Forces", "Plasma Freeze", "Team Poison vs Team Aqua"
	set {_slot} to 0
	loop {_boosters::*}:
		set {_booster} to loop-value
		set {_cards::*} to yaml node keys "Cards" in "StellarChestList"
		loop {_cards::*}:
			set {_source} to yaml value "Cards.%loop-value-2%.Source" in "StellarChestList"
			if {_source} = {_booster}:
				set {_boosterOrder} to yaml value "Cards.%loop-value-2%.BoosterOrder" in "StellarChestList"
				if {_boosterOrder} is not set:
					set {_boosterOrder} to yaml value "Cards.%loop-value-2%.ID" in "StellarChestList"
					if {_boosterOrder} is not set:
						set {_boosterOrder} to 99
				set {_boosterCards::%{_boosterOrder}%} to loop-value-2

		set {_sorted::*} to sorted indices of {_boosterCards::*} in ascending order
		loop {_sorted::*}:
			set {_idx} to loop-value-2
			set {_cardName} to {_boosterCards::%{_idx}%}
			if {_cardName} is set:
				if IsCardCollected({_target}, {_booster}, {_cardName}) is true:
					set {_preview} to StellarCardPreview({_cardName}, true)
					if {_preview} is set:
						set lore of {_preview} to coloured lore of {_preview}
						set {_preview} to {_preview} with item flag hide attributes
						set slot {_slot} of {_gui} to {_preview}
				else:
					set {_element} to yaml value "Cards.%{_cardName}%.Element" in "StellarChestList"
					if {_element} is not set:
						set {_element} to "???"
					set {_id} to yaml value "Cards.%{_cardName}%.ID" in "StellarChestList"
					if {_id} is not set:
						set {_id} to "???"
					set {_boosterOrder} to yaml value "Cards.%{_cardName}%.BoosterOrder" in "StellarChestList"
					if {_boosterOrder} is not set:
						set {_boosterOrder} to "???"
					
					set {_preview} to gray stained glass pane named "&7???" with lore "&7Not collected yet", " ", "&7Name: ???", "&7Element: %{_element}%", "&7Card ID: %{_boosterOrder}%", "&7Global ID: %{_id}%", "&7Booster: %{_booster}%"
					set slot {_slot} of {_gui} to {_preview}
				set {_slot} to {_slot} + 1
				if {_slot} >= 45:
					exit 2 loops
		clear {_boosterCards::*}
		
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterSet(viewer: player, target: player, booster: text):
	LoadTargetData({_target})
	LoadStellarChestList()
	set metadata tag "profile-collection-booster-set" of {_viewer} to chest inventory with 6 rows named "%{_target}% - %{_booster}% Cards"
	set {_gui} to metadata tag "profile-collection-booster-set" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_slot} to 0
	set {_cards::*} to yaml node keys "Cards" in "StellarChestList"
	clear {_boosterCards::*}
	loop {_cards::*}:
		set {_source} to yaml value "Cards.%loop-value%.Source" in "StellarChestList"
		if {_source} = {_booster}:
			set {_boosterOrder} to yaml value "Cards.%loop-value%.BoosterOrder" in "StellarChestList"
			if {_boosterOrder} is not set:
				set {_boosterOrder} to yaml value "Cards.%loop-value%.ID" in "StellarChestList"
				if {_boosterOrder} is not set:
					set {_boosterOrder} to 99
			set {_boosterCards::%{_boosterOrder}%} to loop-value
	set {_sorted::*} to sorted indices of {_boosterCards::*} in ascending order
	loop {_sorted::*}:
		set {_idx} to loop-value
		set {_cardName} to {_boosterCards::%{_idx}%}
		if {_cardName} is set:
			if IsCardCollected({_target}, {_booster}, {_cardName}) is true:
				set {_preview} to StellarCardPreview({_cardName}, true)
				if {_preview} is set:
					set lore of {_preview} to coloured lore of {_preview}
					set {_preview} to {_preview} with item flag hide attributes
					set slot {_slot} of {_gui} to {_preview}
			else:
				set {_element} to yaml value "Cards.%{_cardName}%.Element" in "StellarChestList"
				if {_element} is not set:
					set {_element} to "???"
				set {_id} to yaml value "Cards.%{_cardName}%.ID" in "StellarChestList"
				if {_id} is not set:
					set {_id} to "???"
				set {_boosterOrder} to yaml value "Cards.%{_cardName}%.BoosterOrder" in "StellarChestList"
				if {_boosterOrder} is not set:
					set {_boosterOrder} to "???"
				
				set {_preview} to gray stained glass pane named "&7???" with lore "&7Not collected yet", " ", "&7Name: ???", "&7Element: %{_element}%", "&7Card ID: %{_boosterOrder}%", "&7Global ID: %{_id}%", "&7Booster: %{_booster}%"
				set slot {_slot} of {_gui} to {_preview}
			set {_slot} to {_slot} + 1
			if {_slot} >= 45:
				exit loop
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function ProfileStatCategoryItem(category: text) :: item:
	if {_category} = "Mining":
		return iron pickaxe named "&eMining"
	else if {_category} = "Combat":
		return iron sword named "&cCombat"
	else if {_category} = "Professions":
		return brewing stand named "&bProfessions"
	else if {_category} = "Experience":
		return experience bottle named "&aExperience"
	else if {_category} = "Miscellaneous" or "General" or "Global":
		return nether star named "&dMiscellaneous"
	else if {_category} = "Chat":
		return writable book named "&fChat"
	else if {_category} = "Diamond Chest":
		return diamond named "&bDiamond Chest"
	else if {_category} = "Stellar Chest":
		return amethyst shard named "&dStellar Chest"
	return paper named "&f%{_category}%"

function ProfileStatSummaryLines(target: player, category: text) :: texts:
	if {_category} = "Experience":
		set {_total} to yaml value "Statistics.Experience.Total" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		return "&7Total XP Gained: &f%{_total}%"
		
	else if {_category} = "Professions":
		set {_jcLvl} to {poziomjubilerstwo::%{_target}%}
		if {_jcLvl} is not set:
			set {_jcLvl} to 0
		set {_enchLvl} to yaml value "Professions.Enchanting.Level" in "data-%{_target}%"
		if {_enchLvl} is not set:
			set {_enchLvl} to 0
		set {_minLvl} to {poziomgornictwo::%{_target}%}
		if {_minLvl} is not set:
			set {_minLvl} to 0
		return "&7Jewelcrafting Level: &f%{_jcLvl}%", "&7Enchanting Level: &f%{_enchLvl}%", "&7Mining Level: &f%{_minLvl}%"
		
	else if {_category} = "Mining":
		set {_stone} to yaml value "Statistics.Mining.Stone Mined" in "data-%{_target}%"
		if {_stone} is not set:
			set {_stone} to 0
		set {_deepslate} to yaml value "Statistics.Mining.Deepslate Mined" in "data-%{_target}%"
		if {_deepslate} is not set:
			set {_deepslate} to 0
		set {_gems} to yaml value "Statistics.Mining.Gemstones Mined" in "data-%{_target}%"
		if {_gems} is not set:
			set {_gems} to 0
		return "&7Stone Mined: &f%{_stone}%", "&7Deepslate Mined: &f%{_deepslate}%", "&7Gemstones Found: &f%{_gems}%"
		
	else if {_category} = "Stellar Chest":
		set {_total} to yaml value "Statistics.Stellar Chest.Total Drops" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		set {_pity} to yaml value "Statistics.Stellar Chest.Pity Drops" in "data-%{_target}%"
		if {_pity} is not set:
			set {_pity} to 0
		return "&7Total Drops: &f%{_total}%", "&7Pity Drops: &f%{_pity}%"
		
	else if {_category} = "Combat":
		set {_kills} to {mobskilled::%{_target}%}
		if {_kills} is not set:
			set {_kills} to 0
		return "&7Total Mob Kills: &f%{_kills}%"
		
	else if {_category} = "Chat":
		set {_msg} to yaml value "Statistics.Chat.Messages sent" in "data-%{_target}%"
		if {_msg} is not set:
			set {_msg} to 0
		return "&7Messages Sent: &f%{_msg}%"
		
	else if {_category} = "Diamond Chest":
		set {_total} to yaml value "Statistics.Diamond Chest.Total Drops" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		return "&7Total Drops: &f%{_total}%"
		
	else if {_category} = "Miscellaneous":
		set {_total} to yaml value "Statistics.General.Total" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		return "&7Miscellaneous stats."
		
	return "&7No recorded statistics."

function GetFormattedYamlLines(target: player, path: text, indent: text) :: strings:
	set {_keys::*} to yaml node keys {_path} in "data-%{_target}%"
	if size of {_keys::*} > 0:
		loop {_keys::*}:
			set {_childPath} to "%{_path}%.%loop-value%"
			set {_childKeys::*} to yaml node keys {_childPath} in "data-%{_target}%"
			if size of {_childKeys::*} > 0:
				set {_lines::*} to {_lines::*} and "%{_indent}%%loop-value%:"
				set {_childLines::*} to GetFormattedYamlLines({_target}, {_childPath}, "%{_indent}%  ")
				set {_lines::*} to {_lines::*} and {_childLines::*}
			else:
				set {_val} to yaml value {_childPath} in "data-%{_target}%"
				if {_val} is not set:
					set {_val} to 0
				set {_lines::*} to {_lines::*} and "%{_indent}%%loop-value%: &f%{_val}%"
	else:
		set {_val} to yaml value {_path} in "data-%{_target}%"
		if {_val} is not set:
			set {_val} to 0
		set {_lines::*} to {_lines::*} and "%{_indent}%Total: &f%{_val}%"
	return {_lines::*}

function ProfileStatItem(category: text, key: text) :: item:
	if {_category} = "Mining":
		if {_key} contains "Stone":
			return stone
		else if {_key} contains "Deepslate":
			return deepslate
		else if {_key} contains "Cobblestone":
			return cobblestone
		else if {_key} contains "Obsidian":
			return obsidian
		else if {_key} contains "Ruby":
			return red stained glass pane
		else if {_key} contains "Sapphire":
			return blue stained glass pane
		else if {_key} contains "Amethyst":
			return purple stained glass pane
		else if {_key} contains "Topaz":
			return yellow stained glass pane
		else if {_key} contains "Aquamarine":
			return light blue stained glass pane
		else if {_key} contains "Peridot":
			return lime stained glass pane
		else if {_key} contains "Amber":
			return orange stained glass pane
		else if {_key} contains "Klejnot":
			return emerald
		else if {_key} contains "Chest" or "skrzynka":
			return chest
		return iron pickaxe
	else if {_category} = "Professions":
		if {_key} contains "Recipe" or "Learned":
			return book
		if {_key} contains "Dust":
			return sugar
		return brewing stand
	else if {_category} = "Stellar Chest":
		if {_key} contains "Pity":
			return gold ingot
		return amethyst shard
	else if {_category} = "Diamond Chest":
		if {_key} contains "Pity":
			return gold ingot
		return diamond
	else if {_category} = "Combat":
		return iron sword
	else if {_category} = "Chat":
		return writable book
	else if {_category} = "Experience":
		return experience bottle
	return paper

function OpenProfileStatistics(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-stats" of {_viewer} to chest inventory with 6 rows named "%{_target}% - Statistics"
	set {_gui} to metadata tag "profile-stats" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25
	set {_i} to 1
	
	set {_categories::*} to "Experience", "Professions", "Mining", "Stellar Chest", "Combat", "Chat", "Diamond Chest", "Miscellaneous"
	loop {_categories::*}:
		set {_category} to loop-value
		set {_searchCategory} to {_category}
		if {_category} = "Miscellaneous":
			set {_searchCategory} to "General"
			
		set {_item} to ProfileStatCategoryItem({_category})
		set lore of {_item} to ProfileStatSummaryLines({_target}, {_searchCategory})
		set {_item} to {_item} with item flag hide attributes
		set {_slot} to {_slots::%{_i}%}
		if {_slot} is set:
			set slot {_slot} of {_gui} to {_item}
			set {_i} to {_i} + 1
			
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileStatCategory(viewer: player, target: player, category: text):
	LoadTargetData({_target})
	set metadata tag "profile-stat-category" of {_viewer} to chest inventory with 6 rows named "%{_target}% - %{_category}%"
	set {_gui} to metadata tag "profile-stat-category" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	
	clear {flat-stats-keys::%{_viewer}%::*}
	clear {flat-stats-values::%{_viewer}%::*}
	
	set {_searchCategory} to {_category}
	if {_category} = "Miscellaneous":
		set {_searchCategory} to "General"
		
	set {_slot} to 9
	if {_category} = "Combat":
		set {_kills} to {mobskilled::%{_target}%}
		if {_kills} is not set:
			set {_kills} to 0
		set slot {_slot} of {_gui} to iron sword named "&eMob Kills" with lore "&7Total Mob Kills: &f%{_kills}%" with item flag hide attributes
		set {_slot} to {_slot} + 1
	else:
		loop yaml node keys "Statistics.%{_searchCategory}%" in "data-%{_target}%":
			set {_key} to loop-value
			set {_lines::*} to GetFormattedYamlLines({_target}, "Statistics.%{_searchCategory}%.%{_key}%", "")
			set {_item} to ProfileStatItem({_category}, {_key})
			
			set slot {_slot} of {_gui} to {_item} named "&e%{_key}%" with lore {_lines::*} with item flag hide attributes
			set {_slot} to {_slot} + 1
			if {_slot} >= 45:
				exit loop

	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	set metadata value "ProfileStatCategory" of {_viewer} to {_category}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileStatProfessionsSelect(viewer: player, target: player):
	set metadata tag "profile-stat-professions-select" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Professions Stats"
	set {_gui} to metadata tag "profile-stat-professions-select" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	
	set {_jcLvl} to {poziomjubilerstwo::%{_target}%}
	if {_jcLvl} is not set:
		set {_jcLvl} to 0
	set {_jcExp} to {exp::jubilerstwo::%{_target}%}
	if {_jcExp} is not set:
		set {_jcExp} to 0
	set {_jcRecipes} to {przepisy::jubilerstwo::%{_target}%}
	if {_jcRecipes} is not set:
		set {_jcRecipes} to 0
	set {_jc} to prismarine crystals named "&dJewelcrafting" with lore "&7Level: &f%{_jcLvl}%", "&7Experience: &f%{_jcExp}%&7/&f%150*{_jcLvl}%", "&7Unlocked Recipes: &f%{_jcRecipes}%&7/&f24" with item flag hide attributes
	set slot 11 of {_gui} to {_jc}
	
	set {_enchLvl} to yaml value "Professions.Enchanting.Level" in "data-%{_target}%"
	if {_enchLvl} is not set:
		set {_enchLvl} to 0
	set {_ench} to brewing stand named "&bEnchanting" with lore "&7Level: &f%{_enchLvl}%", " ", "&7Click to view detailed Enchanting stats." with item flag hide attributes
	set slot 13 of {_gui} to {_ench}
	
	set {_minLvl} to {poziomgornictwo::%{_target}%}
	if {_minLvl} is not set:
		set {_minLvl} to 0
	set {_min} to iron pickaxe named "&aMining" with lore "&7Level: &f%{_minLvl}%", " ", "&7Click to view detailed Mining stats." with item flag hide attributes
	set slot 15 of {_gui} to {_min}
	
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileAchievements(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-achievements" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Achievements"
	set {_gui} to metadata tag "profile-achievements" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
