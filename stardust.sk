function openStardustWithdrawal(p: player):
	set {_currentLevel} to {poziom::%{_p}%}
	set {_cap} to {_currentLevel} * 3

	set {_storedLevel} to metadata value "StardustWithdrawnLevel" of {_p}
	if {_storedLevel} is not set:
		set {_storedLevel} to 0

	if {_storedLevel} != {_currentLevel}:
		set metadata value "StardustWithdrawn" of {_p} to 0
		set metadata value "StardustWithdrawnLevel" of {_p} to {_currentLevel}

	set {_withdrawn} to  metadata value "StardustWithdrawn" of {_p}
	if {_withdrawn} is not set:
		set {_withdrawn} to 0

	set {_remaining} to {_cap} - {_withdrawn}

	set {_stardust} to yaml value "Stardust.Item" in "ItemList"

	set metadata tag "StardustWithdrawalMenu" of {_p} to chest inventory with 1 row named "Stardust Withdrawal"
	set {_menu} to metadata tag "StardustWithdrawalMenu" of {_p}

	set slot 4 of {_menu} to {_stardust} named "&fWithdraw All" with lore "&7Withdraw &f%{_remaining}%x %name of {_stardust}%&7.%nl%&7Limit: &f%{_withdrawn}%/%{_cap}% &7for Level &f%{_currentLevel}%%nl%&7Resets when you reach Level &f%{_currentLevel} + 1%&7.%nl% %nl%&eClick to withdraw."

	set boolean tag "StardustWithdrawalItem" of (custom nbt of slot 4 of {_menu}) to true

	play sound "entity.villager.ambient" with volume 4 and pitch 1 to {_p}
	open {_menu} to {_p}