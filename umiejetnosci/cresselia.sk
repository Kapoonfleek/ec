function CresseliaStarfirePrecastSoundStop(p: player):
	stop sound "skill.cresselia.starfire_precast" for {_p}
	stop sound "skill.cresselia.starfire_precast.arcticlights" for {_p}

function CresseliaStarsurgeVisual(p: player, target: entity):

	set {_variant} to getCurrentVariant({_p}, "Cresselia")
	
	if {_variant} = "Arctic Lights":
		CresseliaStarsurgeArcticLightsVisual({_p}, {_target})
		set {_l} to location 0.7 blocks below {_p}'s head
		set {_l} to location 0.4 blocks right of {_l}
		set {_v} to vector between {_l} and {_target}'s head

		set {_particleList::*} to cyan concrete powder, blue concrete powder and lime concrete powder

		set {_particleLoc} to location 1.758 above {_p}
		set {_shape} to a line from {_particleLoc} to location 1 above {_target}

		loop {_particleList::*}:
			set particle of {_shape} to loop-value item particle
			draw shape {_shape} at {_particleLoc}

	else:
		set {_l} to location 0.7 blocks below {_p}'s head
		set {_l} to location 0.4 blocks right of {_l}
		set {_v} to vector between {_l} and {_target}'s head

		set {_particleList::*} to magenta concrete powder and purple concrete powder

		set {_particleLoc} to location 1.758 above {_p}
		set {_shape} to a line from {_particleLoc} to location 1 above {_target}

		loop {_particleList::*}:
			set particle of {_shape} to loop-value item particle
			draw shape {_shape} at {_particleLoc}

		loop round(distance between {_l} and {_target}) / 0.85 times:
			set {_v} to vector between {_l} and {_target}'s head
			set vector length of {_v} to loop-value * 0.85

			draw 1 firework particle at {_l} ~ {_v}
			draw 2 white concrete powder item particle at {_l} ~ {_v}
			draw 1 pink wool item particle with offset random vector at {_l} ~ {_v}
			draw 1 light blue wool item particle with offset random vector at {_l} ~ {_v}
			draw 1 blue wool item particle with offset random vector at {_l} ~ {_v}

function CresseliaStarsurgeArcticLightsVisual(p: player, target: entity):
	set {_start} to location of {_p}
	set {_target} to location of {_target}

	set {_dir} to vector from {_start} to {_target}

	if (y of {_start}) = (y of {_target}):
		set y of {_dir} to a random number between 1.0 and 2.0
	set {_dist} to distance between {_start} and {_target}

	set {_totalSteps} to ({_dist} * 40)
	set {_freq1} to random number between 0.1 and 0.5
	set {_freq2} to random number between 0.4 and 1.0
	set {_amp} to random number between 0.25 and 2.0
	set {_jitter} to random number between 0.1 and 2

	loop {_totalSteps} times:
		set {_progress} to (loop-value / {_totalSteps})
		
		set {_basePos} to {_start} ~ ({_dir} * {_progress})
		
		set {_swayX} to sin(loop-value * {_freq1}) * {_amp}
		set {_swayZ} to cos(loop-value * {_freq2}) * {_amp}
		
		set {_finalPos} to {_basePos} ~ vector({_swayX}, random number between -0.2 and 0.2, {_swayZ})
		add vector((random number between ({_jitter}*-1) and {_jitter}), 0, (random number between ({_jitter}*-1) and {_jitter})) to {_finalPos}

		if loop-value is divisible by 6:
			if {_progress} is less than 0.2:
				set {_randomPart} to a random integer between 1 and 2
				if {_randomPart} = 1:
					draw 1 of (rgb(50, 255, 80) dust particle of size 1.4 with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
					draw 1 of (lime wool item particle with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
				else:
					draw 1 of (rgb(125, 255, 129) dust particle of size 1.4 with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
					draw 1 of (lime concrete powder item particle with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
				
			else if {_progress} is less than 0.4:
				draw 1 of (rgb(0, 255, 180) dust particle of size 1.3 with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
				draw 1 of (cyan wool item particle with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
				
			else if {_progress} is less than 0.55:
				draw 1 of (rgb(0, 240, 255) dust particle of size 1.2 with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
				draw 1 of (light blue wool item particle with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
				
			else if {_progress} is less than 0.9:
				set {_randomPart} to a random integer between 1 and 2
				if {_randomPart} = 1:
					draw 1 of (rgb(252, 43, 120) dust particle of size 1.0 with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
					draw 1 of (magenta wool item particle with an extra value of 0.1) with offset vector(0, 0, 0) at {_finalPos}
				else:
					draw 1 of (rgb(40, 100, 255) dust particle of size 1.0 with an extra value of 0.1) with offset vector(0.05, 0, 0.05) at {_finalPos}


			if loop-value is divisible by 10:
				draw 1 of (end rod particle with an extra value of 0.05) with offset vector(0, 0, 0) at {_finalPos}
			
			if loop-value is divisible by 50:
				wait 1 tick
		
	draw 1 of lime flash particle at {_finalPos}

function CresseliaRandomOffset() :: numbers:
	set {_offsetX} to a random number between -5 and -20
	set {_offsetY} to a random number between -5 and -20
	set {_offsetZ} to a random number between -5 and -20
	set {_offset::*} to {_offsetX} and {_offsetY} and {_offsetZ}
	return {_offset::*}

function StarfallStarTravel(p: player, e: entity, target: entity, duration: timespan, haste: number, effectiveness: number, particle: boolean, starfallScalar: number, astralPowerCost: number):
	set {_y} to 0
	set {_locStar} to location of {_e}
	set {_count} to 0
	set {_starSpeed} to 0.25*{_haste}
	set {_starfallDuration} to "%{_duration}%"
	replace all " seconds" and " second" in {_starfallDuration} with " sec"

	while {_e} is alive:
		set {_targetLoc} to location 0.5 below {_target}
		set {_vec} to vector between {_locStar} and {_targetLoc}
		if {_count} is divisible by 7:
			set {_loc} to location of {_e}
			add 2.5 to y of {_loc}
			draw 1 firework particle at {_loc}
		
		set vector length of {_vec} to {_count} * {_starSpeed}
		teleport {_e} to {_locStar} ~ {_vec}
		add nbt from "{Rotation:[%{_y}-5%f,%{_y}-5%.0f]}" to nbt of {_e}

		if distance between {_e} and {_target} < 1:
			set {_hit} to true
			stop loop
		
		wait 1 tick
		set {_count} to {_count} + 1
		set {_y} to {_y} + 10

	kill {_e}

	stop if {_hit} != true

	set {_critModifier} to 2
	if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%{_p}%}) is set:
		set {_critModifier} to {_critModifier} + 0.2

	set {_primCol} to coloured getPrimaryCardColour({_p})
	set {_secCol} to coloured getSecondaryCardColour({_p})

	if {_particle} != true:
		set {_enemies::*} to LoopEntitiesAroundTarget({_target}, 3, true)
		loop {_enemies::*}:
			set {_crit} to 0 + (CriticalHit({_p})/10)
			set {_damage} to (1 + (({damage::%{_p}%}/63) + (Versatility({_p})/189) + PrimaryStat({_p})/31.5)) * {_effectiveness}

			set {_damage} to {_damage} * {_starfallScalar}

			if metadata value "CelestialAlignment" of {_p} is set:
				set {_damage} to {_damage}*1.15
				set {_crit} to {_crit} + 15
			if metadata value "UmbralInspiration" of {_p} is set:
				set {_damage} to {_damage}*1.3
			if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Stellar Drift":
				set {_damage} to {_damage}*1.3
			if boolean tag "Constellation;Rattle the Stars" of (custom nbt of {karta::%{_p}%}) is set:
				set {_damage} to {_damage}*1.08

			if loop-value != {_target}:
				set {_splashMultiplier} to 0.4

				set {_damage} to {_damage}*{_splashMultiplier}
			
			CresseliaStarfallHitSound({_p}, loop-value)

			set loop-value's last damage cause to sweep attack
			
			set {_valueNames::*} to "COST", "DAMAGE", "DURATION"
			set {_values::*} to {_astralPowerCost}, {_damage}, {_starfallDuration}
			set {_lore} to GetAbilityDescription({_p}, "Cresselia", "Starfall", {_valueNames::*}, {_values::*})

			set metadata value "LastDamageCause" of loop-value to "%{_primCol}%Starfall"
			set metadata value "LastDamageCauseLore" of loop-value to {_lore}
			set metadata value "Element" of {_p} to "Astral"
			set {_damage} to Crit({_p}, loop-value, {_crit}, {_damage}, {_critModifier})
			make {_p} damage loop-value by {_damage}
			CresseliaRecentlyDamaged({_p}, loop-value)

function StarfallStarKill(e: entity):
	wait 20 seconds
	#kill on server stop
	kill {_e}

function CresseliaRecentlyDamaged(p: player, e: entity):
	if metadata value "RecentlyDamagedCresselia%{_p}%" of {_e} is not set:
		set metadata value "RecentlyDamagedCresselia%{_p}%" of {_e} to 20 seconds
		while metadata value "RecentlyDamagedCresselia%{_p}%" of {_e} > 0 seconds:
			wait 1 second
			set {_duration} to metadata value "RecentlyDamagedCresselia%{_p}%" of {_e}
			remove 1 second from {_duration}
			set metadata value "RecentlyDamagedCresselia%{_p}%" of {_e} to {_duration}
			if 0 seconds >= metadata value "RecentlyDamagedCresselia%{_p}%" of {_e}:
				clear metadata value "RecentlyDamagedCresselia%{_p}%" of {_e}
				stop loop
		clear metadata value "RecentlyDamagedCresselia%{_p}%" of {_e}
	else:
		set metadata value "RecentlyDamagedCresselia%{_p}%" of {_e} to 20 seconds

function AstralInvocation(p: player):
	send title " " with subtitle "" to {_p} for 1 minute with fade in 0.25 second and fade out 0 second
	set metadata value "AstralInvocation" of {_p} to true
	play sound "skill.cresselia.innervate_cast" with volume 2 and pitch 2 at {_p}
	set {_uuid} to random uuid
	set metadata value "AstralInvocationUUID" of {_p} to {_uuid}

	set {_time} to 60 seconds
	
	wait {_time}

	if metadata value "AstralInvocationUUID" of {_p} = {_uuid}:
		clear metadata value "AstralInvocation" of {_p}
		clear metadata value "AstralInvocationUUID" of {_p}
		send title " " with subtitle " " to {_p} for 1 second with fade in 0 second and fade out 0 second
	
function shootingStarsVisual(p: player, loc: location):
	set {_variant} to getCurrentVariant({_p}, "Cresselia")
	
	if {_variant} = "Arctic Lights":
		set {_particle} to (rgb(0, 255, 180) dust particles of size 1 that transitions to rgb(0, 240, 255))

		draw 1 of {_particle} at {_loc}

		chance of 4%:
			set {_star} to a star with 5 points, inner radius 0.3, and outer radius 0.6
			
			set {_random} to a random integer between 1 and 4

			if {_random} = 1:
				set {_particle} to (rgb(125, 255, 149) dust particles of size 0.85 that transitions to rgb(138, 253, 255)) with an extra value of 0.03
			else if {_random} = 2:
				set {_particle} to (rgb(0, 255, 180) dust particles of size 1 that transitions to rgb(0, 240, 255))
			else if {_random} = 3:
				set {_particle} to (rgb(255, 41, 155) dust particles of size 1 that transitions to rgb(0, 240, 255))
			else:
				set {_particle} to (rgb(179, 101, 247) dust particles of size 1 that transitions to rgb(125, 255, 149))

			set {_x} to x of {_loc}
			set {_z} to z of {_loc}

			set {_x} to {_x} + (random number between -3.0 and 3.0)
			set {_z} to {_z} + (random number between -3.0 and 3.0)

			set {_newLoc} to location({_x}, (y of {_loc}), {_z}, world of {_loc})

			set particle of {_star} to {_particle}
			rotate shape {_star} around x axis by 90 degrees
			rotate shape {_star} around y axis by a random number between 0 and 360 degrees
			rotate shape {_star} around z axis by a random number between 0 and 360 degrees

			draw shape {_star} at {_newLoc} for 0.25 seconds

	else:
		draw 1 of (rgb(168, 134, 240) dust particle of size 1) at {_loc}

function CelestialAlignmentVisual(p: player):
	set {_variant} to getCurrentVariant({_p}, "Cresselia")
	
	if {_variant} = "Arctic Lights":

		loop 42 times:
			set {_origin} to location 8.5 above {_p}
			set {_progress} to loop-number / 42
			set {_sweep} to (loop-number - 21) * 0.22

			loop 5 times:
				set {_strand} to loop-number-2
				set {_planeLoc} to {_origin}

				add ({_sweep} + (sin(loop-number-2 * 0.32 + {_strand} * 1.7) * 1.35)) to x of {_planeLoc}
				add (sin(loop-number-2 * 0.22 + {_strand}) * 0.75) to y of {_planeLoc}
				add ((({_strand} - 3) * 1.15) + (cos(loop-number-2 * 0.29 + {_strand} * 1.4) * 0.9)) to z of {_planeLoc}

				if {_strand} = 1:
					draw 3 of (rgb(50, 255, 80) dust particle of size 1.45 with an extra value of 0.06) with offset vector(0.16, 0.08, 0.16) at {_planeLoc}
					draw 1 lime wool item particle with offset random vector at {_planeLoc}
				else if {_strand} = 2:
					draw 3 of (rgb(0, 255, 180) dust particle of size 1.35 with an extra value of 0.06) with offset vector(0.16, 0.08, 0.16) at {_planeLoc}
					draw 1 cyan wool item particle with offset random vector at {_planeLoc}
				else if {_strand} = 3:
					draw 3 of (rgb(0, 240, 255) dust particle of size 1.25 with an extra value of 0.06) with offset vector(0.16, 0.08, 0.16) at {_planeLoc}
					draw 1 light blue wool item particle with offset random vector at {_planeLoc}
				else if {_strand} = 4:
					draw 2 of (rgb(40, 100, 255) dust particle of size 1.15 with an extra value of 0.06) with offset vector(0.16, 0.08, 0.16) at {_planeLoc}
					draw 1 blue wool item particle with offset random vector at {_planeLoc}
				else:
					draw 2 of (rgb(252, 43, 120) dust particle of size 1.0 with an extra value of 0.06) with offset vector(0.16, 0.08, 0.16) at {_planeLoc}
					draw 1 magenta wool item particle with offset random vector at {_planeLoc}

				if loop-number-1 is divisible by 5:
					draw 1 end rod particle with offset vector(0.12, 0.05, 0.12) at {_planeLoc}

			if loop-number is divisible by 2:
				set {_starLoc} to location 8.5 above {_p}
				add a random number between -5.5 and 5.5 to x of {_starLoc}
				add a random number between -0.8 and 1.3 to y of {_starLoc}
				add a random number between -3.2 and 3.2 to z of {_starLoc}

				set {_star} to a star with 5 points, inner radius 0.08, and outer radius 0.35

				set {_c} to a random integer between 1 and 6
				if {_c} = 1:
					set particle of {_star} to (rgb(50, 255, 80) dust particle of size 0.8 with an extra value of 0.03)
				else if {_c} = 2:
					set particle of {_star} to (rgb(125, 255, 129) dust particle of size 0.8 with an extra value of 0.03)
				else if {_c} = 3:
					set particle of {_star} to (rgb(0, 255, 180) dust particle of size 0.8 with an extra value of 0.03)
				else if {_c} = 4:
					set particle of {_star} to (rgb(0, 240, 255) dust particle of size 0.8 with an extra value of 0.03)
				else if {_c} = 5:
					set particle of {_star} to (rgb(40, 100, 255) dust particle of size 0.8 with an extra value of 0.03)
				else:
					set particle of {_star} to (rgb(252, 43, 120) dust particle of size 0.75 with an extra value of 0.03)

				rotate shape {_star} around x axis by a random number between 0 and 360 degrees
				rotate shape {_star} around y axis by a random number between 0 and 360 degrees
				rotate shape {_star} around z axis by a random number between 0 and 360 degrees
				draw shape {_star} at {_starLoc}

			if loop-number is divisible by 6:
				wait 1 tick

		loop 18 times:
			set {_center} to location 7.8 above {_p}

			loop 3 times:
				set {_sigilLoc} to {_center}
				add a random number between -4.5 and 4.5 to x of {_sigilLoc}
				add a random number between -0.6 and 1.1 to y of {_sigilLoc}
				add a random number between -2.8 and 2.8 to z of {_sigilLoc}

				set {_r} to a random number between 0.45 and 1.25
				set {_sigil} to a circle of radius {_r}

				set {_c} to a random integer between 1 and 4
				if {_c} = 1:
					set particle of {_sigil} to (rgb(0, 255, 180) dust particle of size 0.85 with an extra value of 0.035)
				else if {_c} = 2:
					set particle of {_sigil} to (rgb(0, 240, 255) dust particle of size 0.85 with an extra value of 0.035)
				else if {_c} = 3:
					set particle of {_sigil} to (rgb(125, 255, 129) dust particle of size 0.85 with an extra value of 0.035)
				else:
					set particle of {_sigil} to (rgb(252, 43, 120) dust particle of size 0.75 with an extra value of 0.035)

				rotate shape {_sigil} around x axis by a random number between 55 and 125 degrees
				rotate shape {_sigil} around y axis by a random number between 0 and 360 degrees
				rotate shape {_sigil} around z axis by a random number between 0 and 360 degrees
				draw shape {_sigil} at {_sigilLoc}

				if loop-number-2 is 2:
					set {_tri} to a triangle with radius ({_r} * 0.85)
					set particle of {_tri} to (rgb(255, 255, 255) dust particle of size 0.65 with an extra value of 0.02)
					rotate shape {_tri} around x axis by a random number between 0 and 360 degrees
					rotate shape {_tri} around y axis by a random number between 0 and 360 degrees
					rotate shape {_tri} around z axis by a random number between 0 and 360 degrees
					draw shape {_tri} at {_sigilLoc}

			wait 1 tick

		loop 24 times:
			set {_fallOrigin} to location 10 above {_p}

			loop 4 times:
				set {_fallLoc} to {_fallOrigin}
				add a random number between -5.5 and 5.5 to x of {_fallLoc}
				add a random number between -0.4 and 1.4 to y of {_fallLoc}
				add a random number between -3.5 and 3.5 to z of {_fallLoc}

				set {_lowerLoc} to {_fallLoc}
				remove (loop-number-2 * 0.08) from y of {_lowerLoc}

				draw 2 of (rgb(255, 255, 255) dust particle of size 0.65 with an extra value of 0.015) with offset vector(0.04, 0.04, 0.04) at {_lowerLoc}

				set {_tailLoc} to {_lowerLoc}
				add a random number between -0.2 and 0.2 to x of {_tailLoc}
				add a random number between -0.2 and 0.2 to z of {_tailLoc}

				if loop-number-2 = 1:
					draw 2 of (rgb(50, 255, 80) dust particle of size 1.1 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_tailLoc}
				else if loop-number-2 = 2:
					draw 2 of (rgb(0, 255, 180) dust particle of size 1.1 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_tailLoc}
				else if loop-number-2 = 3:
					draw 2 of (rgb(0, 240, 255) dust particle of size 1.0 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_tailLoc}
				else:
					draw 2 of (rgb(252, 43, 120) dust particle of size 0.9 with an extra value of 0.04) with offset vector(0.08, 0.08, 0.08) at {_tailLoc}

			if loop-number is divisible by 3:
				wait 1 tick

		loop 10 times:
			set {_burstLoc} to location 7.5 above {_p}
			add a random number between -4.8 and 4.8 to x of {_burstLoc}
			add a random number between -0.9 and 1.2 to y of {_burstLoc}
			add a random number between -3.0 and 3.0 to z of {_burstLoc}

			set {_burstStar} to a star with 5 points, inner radius 0.18, and outer radius 0.85

			if loop-number is divisible by 2:
				set particle of {_burstStar} to (rgb(255, 255, 255) dust particle of size 0.85 with an extra value of 0.025)
			else:
				set particle of {_burstStar} to (rgb(0, 255, 180) dust particle of size 1.0 with an extra value of 0.035)

			rotate shape {_burstStar} around x axis by a random number between 0 and 360 degrees
			rotate shape {_burstStar} around y axis by a random number between 0 and 360 degrees
			rotate shape {_burstStar} around z axis by a random number between 0 and 360 degrees
			draw shape {_burstStar} at {_burstLoc}

			draw 8 of (end rod particle with an extra value of 0.025) with offset vector(0.5, 0.25, 0.5) at {_burstLoc}

			wait 1 tick

		loop 7 times:
			set {_waveLoc} to location 8.2 above {_p}

			set {_wave} to a circle of radius (1.6 + loop-number * 0.85)

			if loop-number <= 2:
				set particle of {_wave} to (rgb(50, 255, 80) dust particle of size 1.25 with an extra value of 0.045)
			else if loop-number <= 4:
				set particle of {_wave} to (rgb(0, 240, 255) dust particle of size 1.15 with an extra value of 0.045)
			else:
				set particle of {_wave} to (rgb(252, 43, 120) dust particle of size 0.95 with an extra value of 0.045)

			rotate shape {_wave} around x axis by a random number between 65 and 115 degrees
			rotate shape {_wave} around y axis by a random number between 0 and 360 degrees
			rotate shape {_wave} around z axis by a random number between 0 and 360 degrees

			draw shape {_wave} at {_waveLoc}

			draw 10 of (rgb(255, 255, 255) dust particle of size 0.8 with an extra value of 0.015) with offset vector(2.8, 0.35, 2.0) at {_waveLoc}

			wait 1 tick

		loop 24 times:
			set {_finalLoc} to location 8 above {_p}
			add a random number between -5.5 and 5.5 to x of {_finalLoc}
			add a random number between -0.9 and 1.5 to y of {_finalLoc}
			add a random number between -3.4 and 3.4 to z of {_finalLoc}

			draw 3 of (rgb(50, 255, 80) dust particle of size 1.35 with an extra value of 0.05) with offset vector(0.2, 0.12, 0.2) at {_finalLoc}
			draw 2 of (rgb(0, 255, 180) dust particle of size 1.25 with an extra value of 0.05) with offset vector(0.18, 0.1, 0.18) at {_finalLoc}
			draw 2 of (rgb(0, 240, 255) dust particle of size 1.15 with an extra value of 0.05) with offset vector(0.16, 0.1, 0.16) at {_finalLoc}

			if loop-number is divisible by 3:
				draw 1 magenta wool item particle with offset random vector at {_finalLoc}
			else if loop-number is divisible by 2:
				draw 1 cyan wool item particle with offset random vector at {_finalLoc}
			else:
				draw 1 lime wool item particle with offset random vector at {_finalLoc}

	else:
		set {_loc} to location 2.5 above {_p}
		if {_p}'s horizontal facing is south:
			set {_loc1} to location 2 east of {_loc}
			set {_loc2} to location 2 west of {_loc}
		set {_v} to vector between {_loc1} and {_loc2}
		loop round(distance between {_loc1} and {_loc2}) / 0.1 times:
			if loop-number < 20:
				set {_v} to vector between {_loc1} and {_loc}
			set vector length of {_v} to loop-value * 0.1
			draw 1 of (rgb(255-loop-number, 255-loop-number, 255-loop-number) dust particle of size 1) at {_loc1} ~ {_v}

function Solstice(p: player):
	if metadata value "Solstice" of {_p} is not set:
		set metadata value "Solstice" of {_p} to 6 seconds
		while metadata value "Solstice" of {_p} > 0 seconds:
			buffRegister({_p}, "Solstice", 1, "", "-", "-", durationShort("%metadata value "Solstice" of {_p}%"))
			wait 1 second
			set {_duration} to metadata value "Solstice" of {_p}
			remove 1 second from {_duration}
			set metadata value "Solstice" of {_p} to {_duration}
			if 0 seconds >= metadata value "Solstice" of {_p}:
				clear metadata value "Solstice" of {_p}
				stop loop
		buffClear({_p}, "Solstice")
	else:
		set metadata value "Solstice" of {_p} to 6 seconds

function FullMoon(p: player, target: entity, effectiveness: number = 1):
	play sound "skill.cresselia.fullmoon_cast" with volume 3 and pitch 1 at location of {_target}
	CresseliaStreakingStars({_p}, {_target}, "Full Moon")
	set {_haste} to Haste({_p})
	set {_randomIncrease} to a random number between 10 and 40
	set {_loc} to location of {_target}
	set y of {_loc} to (y of (location at {_target}) + {_randomIncrease})
	spawn an armor stand at {_loc} with nbt from "{Invulnerable:1b,Invisible:1b,NoGravity:1b,Silent:1b,Pose:{Head:[180.0f,0.0f,0.0f]}}"
	set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true

	modelApply(last spawned armor stand, "fullmoon", 2.0)
	set {_e} to last spawned armor stand

	set {_y} to 0
	set {_locMoon} to location of {_e}
	set {_count} to 0
	set {_moonSpeed} to 0.15*{_haste}

	set {_maxTicks} to 2000

	while {_e} is alive:
		set {_targetLoc} to location 0.5 below {_target}
		set {_vec} to vector between {_locMoon} and {_targetLoc}
		if {_count} is divisible by 2:
			set {_loc} to location of {_e}
			add 3 to y of {_loc}
			draw 1 of (rgb(252, 240, 204) dust particle of size 1) at {_loc}
			shootingStarsVisual({_p}, {_loc})

			draw 1 of end rod particle at {_e}
		set vector length of {_vec} to {_count} * {_moonSpeed}
		teleport {_e} to {_locMoon} ~ {_vec}
		add nbt from "{Rotation:[%{_y}%.0f,%{_y}%.0f]}" to nbt of {_e}
		
		if distance between {_e} and {_target} < 1:
			set {_hit} to true
			stop loop

		wait 1 tick
		set {_count} to {_count} + 1
		set {_y} to {_y} + 10

		stop loop if {_target} is not alive
		stop loop if {_count} = {_maxTicks}
		
	kill {_e}

	stop if {_hit} != true

	set {_enemies::*} to LoopEntitiesAroundTarget({_target}, 5, true)
	set {_astralpower} to 40
	set {_astralpower} to {_astralpower}*{_effectiveness}
	if string tag "Talents;Row 2" of (custom nbt of {karta::%{_p}%}) = "Astral Communion":
		set {_astralPowerCap} to 120
	else:
		set {_astralPowerCap} to 100
	set {_astralpower} to CresseliaAstralPowerGen({_p}, {_astralpower})
	if {_astralPowerCap} >= {astralpower::%{_p}%} + {_astralpower}:
		set {astralpower::%{_p}%} to {astralpower::%{_p}%} + {_astralpower} 
	else:
		set {astralpower::%{_p}%} to {_astralPowerCap}
	AstralPowerUpdate({_p})
	draw 25 of (smoke particle with an extra value of 0.01) with offset vector(2, 0.5, 2) at (location above {_target})
	draw 25 of (cloud particle with an extra value of 0.005) with offset vector(0.45, 0.5, 0.45) at (location above {_target})

	set {_primCol} to coloured getPrimaryCardColour({_p})
	set {_secCol} to coloured getSecondaryCardColour({_p})
	
	set {_damageFullMoon} to (13 + (({damage::%{_p}%}/6.5) + (Versatility({_p})/19.5) + PrimaryStat({_p})/3.25)) * (1 + (Mastery({_p})/108))
	set {_damageFullMoon} to {_damageFullMoon}*{_effectiveness}
	set {_lunarFirmamentDmg} to offensiveTrait({_p}, "Cresselia", "Lunar Firmament")
	if {_lunarFirmamentDmg} > 0:
		if metadata value "LunarFirmamentStacks%{_p}%" of {_p} is set:
			set {_stacks} to metadata value "LunarFirmamentStacks%{_p}%" of {_p}
			set {_damageFullMoon} to {_damageFullMoon} + ({_lunarFirmamentDmg} * {_stacks})
			clear metadata value "LunarFirmamentStacks%{_p}%" of {_p}

	set {_valueNames::*} to "DAMAGE", "AOEDAMAGE", "ASTRALPOWER"
	set {_values::*} to {_damageFullMoon}, ({_damageFullMoon}*0.4), {_astralpower}
	set {_lore} to GetAbilityDescription({_p}, "Cresselia", "Full Moon", {_valueNames::*}, {_values::*})
	
	set {_critModifier} to 2
	if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%{_p}%}) is set:
		set {_critModifier} to {_critModifier} + 0.2

	loop {_enemies::*}:
		set {_crit} to 0 + (CriticalHit({_p})/10)
		set {_damage} to {_damageFullMoon}
		if loop-value != {_target}:
			set {_damage} to {_damage}*0.4
		if metadata value "CelestialAlignment" of {_p} is set:
			set {_damage} to {_damage}*1.15
			set {_crit} to {_crit} + 15
		set loop-value's last damage cause to sweep attack
		set metadata value "LastDamageCause" of loop-value to "%{_primCol}%Full Moon"
		set metadata value "LastDamageCauseLore" of loop-value to {_lore}
		set metadata value "Element" of {_p} to "Astral"
		set {_damage} to Crit({_p}, loop-value, {_crit}, {_damage}, {_critModifier})
		make {_p} damage loop-value by {_damage}
		CresseliaRecentlyDamaged({_p}, loop-value)
		play sound "entity.player.hurt" with volume 1.5 and pitch 1 at location of loop-value

function UmbralInspiration(p: player):
	if metadata value "UmbralInspiration" of {_p} is not set:
		set metadata value "UmbralInspiration" of {_p} to 6 seconds
		while metadata value "UmbralInspiration" of {_p} > 0 seconds:
			wait 1 second
			set {_duration} to metadata value "UmbralInspiration" of {_p}
			remove 1 second from {_duration}
			set metadata value "UmbralInspiration" of {_p} to {_duration}
			if 0 seconds >= metadata value "UmbralInspiration" of {_p}:
				clear metadata value "UmbralInspiration" of {_p}
				stop loop
	else:
		set metadata value "UmbralInspiration" of {_p} to 6 seconds

function CelestialAlignment(p: player, duration: timespan):
	if string tag "Talents;Row 1" of (custom nbt of {karta::%{_p}%}) = "Solstice":
		Solstice({_p})
	if string tag "Talents;Row 5" of (custom nbt of {karta::%{_p}%}) = "Touch the Cosmos":
		Starfall({_p}, 4)
	if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%{_p}%}) is set:
		set {_lastDamagedTarget} to (metadata value "MostRecentlyDamagedEnemy" of {_p})

		if {_lastDamagedTarget} is set:
			if {_lastDamagedTarget} is alive:
				FullMoon({_p}, {_lastDamagedTarget}, 0.7)

	if metadata value "CelestialAlignment" of {_p} is not set:
		set metadata value "CelestialAlignment" of {_p} to {_duration}
		while metadata value "CelestialAlignment" of {_p} > 0 seconds:
			buffRegister({_p}, "Alignment", 5, "", "-", "-", durationShort("%metadata value "CelestialAlignment" of {_p}%"))
			wait 1 second
			set {_timeRemaining} to metadata value "CelestialAlignment" of {_p}
			remove 1 second from {_timeRemaining}

			set metadata value "CelestialAlignment" of {_p} to {_timeRemaining}

			if 0 seconds >= metadata value "CelestialAlignment" of {_p}:
				clear metadata value "CelestialAlignment" of {_p}
				AstronomicalImpact({_p})
				stop loop

		buffClear({_p}, "Alignment")
		clear metadata value "AetherialKindlingExtension" of {_p}
	else:
		set {_timeRemaining} to metadata value "CelestialAlignment" of {_p}
		set {_timeRemaining} to 0 seconds if {_timeRemaining} is not set
		set {_timeRemaining} to {_timeRemaining} + {_duration}
		set metadata value "CelestialAlignment" of {_p} to {_timeRemaining}

function StellarDrift(p: player, duration: timespan):
	if metadata value "StellarDrift" of {_p} is not set:
		set {_movementSpeed} to {_p}'s walking speed
		set metadata value "StellarDrift" of {_p} to {_duration}
		set {_p}'s walking speed to ({_p}'s walking speed*1.2)
		while metadata value "StellarDrift" of {_p} > 0 seconds:
			wait 1 second
			set {_duration} to metadata value "StellarDrift" of {_p}
			remove 1 second from {_duration}
			set metadata value "StellarDrift" of {_p} to {_duration}
			if 0 seconds >= metadata value "StellarDrift" of {_p}:
				clear metadata value "StellarDrift" of {_p}
				set {_p}'s walking speed to {_movementSpeed}
				stop loop
	else:
		set metadata value "StellarDrift" of {_p} to {_duration}

function AstronomicalImpact(p: player):
	set metadata value "AstronomicalImpact" of {_p} to 3

function Starlord(p: player):
	if metadata value "StarlordStackCount" of {_p} is not set:
		set metadata value "StarlordStackCount" of {_p} to 0
	if metadata value "StarlordStackCount" of {_p} < 3:
		set  metadata value "StarlordStackCount" of {_p} to ( metadata value "StarlordStackCount" of {_p} + 1)
		set {bonusHaste::%{_p}%} to {bonusHaste::%{_p}%} + 16
	if metadata value "Starlord" of {_p} is not set:
		set metadata value "Starlord" of {_p} to 15 seconds
		while metadata value "Starlord" of {_p} > 0 seconds:
			set {_duration} to metadata value "Starlord" of {_p}
			set {_stackCount} to metadata value "StarlordStackCount" of {_p}
			buffRegister({_p}, "Starlord", 1, "", "Stacks", "<#19943e> &f%{_stackCount}*16% &7| &f%{_stackCount}%", durationShort("%{_duration}%"))
			wait 1 second	
			remove 1 second from {_duration}
			set metadata value "Starlord" of {_p} to {_duration}
		remove metadata value "StarlordStackCount" of {_p}*16 from {bonusHaste::%{_p}%}
		clear metadata value "StarlordStackCount" of {_p}
		clear metadata value "Starlord" of {_p}
		buffClear({_p}, "Starlord")	

function StellarCommand(p: player, target: entity):
	if metadata value "Stellar Command%{_p}%" of {_target} is not set:
		set metadata value "Stellar Command%{_p}%" of {_target} to 8 seconds
		while metadata value "Stellar Command%{_p}%" of {_target} > 0 seconds:
			wait 1 second
			remove 1 second from metadata value "Stellar Command%{_p}%" of {_target}
		clear metadata value "Stellar Command%{_p}%" of {_target}
	else:
		set metadata value "Stellar Command%{_p}%" of {_target} to 8 seconds

function PrimordialArcanicPulsar(p: player, astralPowerCost: number):
	set {_astralPowerTrigger} to 400
	set {_CADuration} to 9 seconds

	if metadata value "PrimordialArcanicPulsar" of {_p} is not set:
		set metadata value "PrimordialArcanicPulsar" of {_p} to 0

	set {_arcanicPulsar} to metadata value "PrimordialArcanicPulsar" of {_p}

	set {_arcanicPulsar} to ({_arcanicPulsar} + {_astralPowerCost})

	if {_arcanicPulsar} >= {_astralPowerTrigger}:
		set {_arcanicPulsar} to {_arcanicPulsar} - {_astralPowerTrigger}
		CelestialAlignment({_p}, {_CADuration})

	set metadata value "PrimordialArcanicPulsar" of {_p} to {_arcanicPulsar}

	buffRegister({_p}, "Pulsar", 1, "", "Value", "%{_arcanicPulsar}% AP", "-")

function caBezier(start: location, control: location, end: location, t: number) :: location:
    set {_u} to (1 - {_t})
    set {_uu} to ({_u} * {_u})
    set {_tt} to ({_t} * {_t})
    set {_ut2} to (2 * {_u} * {_t})

    set {_x1} to ({_uu} * (x of {_start}))
    set {_x2} to ({_ut2} * (x of {_control}))
    set {_x3} to ({_tt} * (x of {_end}))
    set {_x} to ({_x1} + {_x2} + {_x3})

    set {_y1} to ({_uu} * (y of {_start}))
    set {_y2} to ({_ut2} * (y of {_control}))
    set {_y3} to ({_tt} * (y of {_end}))
    set {_y} to ({_y1} + {_y2} + {_y3})

    set {_z1} to ({_uu} * (z of {_start}))
    set {_z2} to ({_ut2} * (z of {_control}))
    set {_z3} to ({_tt} * (z of {_end}))
    set {_z} to ({_z1} + {_z2} + {_z3})

    return location({_x}, {_y}, {_z}, world of {_start})

function caMidControl(start: location, end: location, height: number) :: location:
    set {_x} to (((x of {_start}) + (x of {_end})) / 2)
    set {_y} to ((((y of {_start}) + (y of {_end})) / 2) + {_height})
    set {_z} to (((z of {_start}) + (z of {_end})) / 2)
    return location({_x}, {_y}, {_z}, world of {_start})

function caMoonTrail(loc: location, amount: number):
    set {_dust} to ((rgb(255, 255, 200) dust particle of size 0.8) with an extra value of 0.01)
    set {_dustOffset} to vector(0.1, 0.1, 0.1)
    set {_smallOffset} to vector(0.05, 0.05, 0.05)

    draw {_amount} of {_dust} with offset {_dustOffset} at {_loc}
    draw 1 end rod particle with offset {_smallOffset} at {_loc}

function caStarTrail(loc: location, amount: number):
    set {_dust} to ((rgb(170, 80, 220) dust particle of size 0.8) with an extra value of 0.01)
    set {_dustOffset} to vector(0.1, 0.1, 0.1)
    set {_smallOffset} to vector(0.05, 0.05, 0.05)

    draw {_amount} of {_dust} with offset {_dustOffset} at {_loc}
    draw 1 firework particle with offset {_smallOffset} at {_loc}

function caBurst(loc: location):
    set {_moonDust} to ((rgb(255, 255, 200) dust particle of size 1.2) with an extra value of 0.01)
    set {_starDust} to ((rgb(170, 80, 220) dust particle of size 1.2) with an extra value of 0.01)

    set {_bigOffset} to vector(1.5, 1.5, 1.5)
    set {_fireworkOffset} to vector(1, 1, 1)

    draw 60 of {_moonDust} with offset {_bigOffset} at {_loc}
    draw 60 of {_starDust} with offset {_bigOffset} at {_loc}
    draw 30 end rod particle with offset {_bigOffset} at {_loc}
    draw 30 firework particle with offset {_fireworkOffset} at {_loc}
    draw 1 white flash particle at {_loc}

function celestialAlignmentVisual(p: player):
	set {_baseLoc} to location of {_p}
	set {_radius} to 1.5
	set {_height} to 1

	set {_leftX} to (0 - {_radius})
	set {_rightX} to {_radius}

	set {_moonStart} to ({_baseLoc} ~ vector({_leftX}, {_height}, 0))
	set {_starStart} to ({_baseLoc} ~ vector({_rightX}, {_height}, 0))

	set {_standNBT} to "{Invulnerable:1b,Invisible:1b,NoGravity:1b,Silent:1b,Marker:1b}"

	CelestialAlignmentVisual({_p})

	spawn an armor stand at {_moonStart} with nbt from {_standNBT}
	set {_moon} to last spawned armor stand
	set name of {_moon} to "FullMoon"
	modelApply({_moon}, "fullmoon", 0.5)

	spawn an armor stand at {_starStart} with nbt from {_standNBT}
	set {_star} to last spawned armor stand
	set name of {_star} to "ShootingStar"
	modelApply({_star}, "shootingstar", 1)

	set {_orbitTicks} to 40

	set boolean tag "Invisible" of nbt of {_moonStart} to false
	set boolean tag "Invisible" of nbt of {_starStart} to false

	loop {_orbitTicks} times:
		set {_baseLoc} to location of {_p}
		set {_progress} to ((loop-value - 1) / {_orbitTicks})

		set {_moonAngle} to (180 - ({_progress} * 360))
		set {_starAngle} to (0 - ({_progress} * 360))

		set {_moonX} to ((cos({_moonAngle})) * {_radius})
		set {_moonZ} to ((sin({_moonAngle})) * {_radius})

		set {_starX} to ((cos({_starAngle})) * {_radius})
		set {_starZ} to ((sin({_starAngle})) * {_radius})

		set {_moonPos} to ({_baseLoc} ~ vector({_moonX}, {_height}, {_moonZ}))
		set {_starPos} to ({_baseLoc} ~ vector({_starX}, {_height}, {_starZ}))

		teleport {_moon} to {_moonPos}
		teleport {_star} to {_starPos}

		caMoonTrail({_moonPos}, 2)
		caStarTrail({_starPos}, 2)

		if loop-counter is divisible by 2:
			wait 1 tick

	set {_moonArcStart} to location of {_moon}
	set {_starArcStart} to location of {_star}
	set {_meetPoint} to ((location of {_p}) ~ vector(0, 3.5, 0))

	set {_moonControl} to caMidControl({_moonArcStart}, {_meetPoint}, 1.5)
	set {_starControl} to caMidControl({_starArcStart}, {_meetPoint}, 1.5)

	set {_arcTicks} to 10

	loop {_arcTicks} times:
		set {_t} to ((loop-value - 1) / {_arcTicks})

		set {_moonPos} to caBezier({_moonArcStart}, {_moonControl}, {_meetPoint}, {_t})
		set {_starPos} to caBezier({_starArcStart}, {_starControl}, {_meetPoint}, {_t})

		teleport {_moon} to {_moonPos}
		teleport {_star} to {_starPos}

		set {_densityRaw} to ({_t} * 3)
		set {_trailDensity} to (2 + round({_densityRaw}))

		caMoonTrail({_moonPos}, {_trailDensity})
		caStarTrail({_starPos}, {_trailDensity})

		wait 1 tick

	teleport {_moon} to {_meetPoint}
	teleport {_star} to {_meetPoint}

	caBurst({_meetPoint})

	wait 10 ticks

	kill {_moon}
	kill {_star}
	
function CresseliaCosmicRipple(p: player):
	set {_stat} to statTrait({_p}, "Cresselia", "Cosmic Ripple")
	if {_stat} > 0:
		if metadata value "CosmicRippleStacks%{_p}%" of {_p} is not set:
			set metadata value "CosmicRippleStacks%{_p}%" of {_p} to 0
		set {_stacks} to metadata value "CosmicRippleStacks%{_p}%" of {_p}
		if {_stacks} < 3:
			set {_stacks} to {_stacks} + 1
			set metadata value "CosmicRippleStacks%{_p}%" of {_p} to {_stacks}
		
		set metadata value "CosmicRippleHaste" of {_p} to {_stat} * {_stacks}
		set {_hasteGranted} to metadata value "CosmicRippleHaste" of {_p}
		buffRegister({_p}, "Ripple", 2, "", "Stacks", "<#19943e> &f%(round({_hasteGranted}, 0))% &7| &f%{_stacks}%", "8 sec")
		
		set metadata value "CosmicRippleTime%{_p}%" of {_p} to 8

		if metadata value "CosmicRippleLoop%{_p}%" of {_p} is not set:
			set metadata value "CosmicRippleLoop%{_p}%" of {_p} to true
			while metadata value "CosmicRippleTime%{_p}%" of {_p} > 0:
				wait 1 second
				if metadata value "CosmicRippleTime%{_p}%" of {_p} is set:
					set {_t} to metadata value "CosmicRippleTime%{_p}%" of {_p}
					set {_t} to {_t} - 1
					set metadata value "CosmicRippleTime%{_p}%" of {_p} to {_t}
					if {_t} > 0:
						set {_ripple} to metadata value "CosmicRippleStacks%{_p}%" of {_p}
						set {_hasteGranted} to metadata value "CosmicRippleHaste" of {_p}
						buffRegister({_p}, "Ripple", 2, "", "Stacks", "<#19943e> &f%(round({_hasteGranted}, 0))% &7| &f%{_ripple}%", "%{_t}% sec")
			clear metadata value "CosmicRippleLoop%{_p}%" of {_p}
			clear metadata value "CosmicRippleStacks%{_p}%" of {_p}
			clear metadata value "CosmicRippleHaste" of {_p}
			buffClear({_p}, "Ripple")

function CresseliaSurgingRhythm(p: player):
	broadcast "?"
	set {_stat} to statTrait({_p}, "Cresselia", "Surging Rhythm")
	if {_stat} > 0:
		set metadata value "SurgingRhythmPrimary" of {_p} to {_stat}
		buffRegister({_p}, "Rhythm", 3, "", "Stacks", "<##59c1e3> &f%{_stat}%", "10 sec")

		set metadata value "SurgingRhythmTime%{_p}%" of {_p} to 10
		if metadata value "SurgingRhythmLoop%{_p}%" of {_p} is not set:
			set metadata value "SurgingRhythmLoop%{_p}%" of {_p} to true
			while metadata value "SurgingRhythmTime%{_p}%" of {_p} > 0:
				wait 1 second
				if metadata value "SurgingRhythmTime%{_p}%" of {_p} is set:
					set {_t} to metadata value "SurgingRhythmTime%{_p}%" of {_p}
					set {_t} to {_t} - 1
					set metadata value "SurgingRhythmTime%{_p}%" of {_p} to {_t}
					if {_t} > 0:
						set {_rhythm} to metadata value "SurgingRhythmPrimary" of {_p}
						buffRegister({_p}, "Rhythm", 3, "", "Stacks", "<##59c1e3> &f%{_rhythm}%", "%{_t}% sec")
			clear metadata value "SurgingRhythmLoop%{_p}%" of {_p}
			clear metadata value "SurgingRhythmPrimary" of {_p}
			buffClear({_p}, "Rhythm")
		else:
			set metadata value "SurgingRhythmTime%{_p}%" of {_p} to 10

function CresseliaDawningHorizon(p: player):
	set {_stat} to statTrait({_p}, "Cresselia", "Dawning Horizon")
	if {_stat} > 0:
		if metadata value "DawningHorizonStacks%{_p}%" of {_p} is not set:
			set metadata value "DawningHorizonStacks%{_p}%" of {_p} to 0
		set {_stacks} to metadata value "DawningHorizonStacks%{_p}%" of {_p}
		if {_stacks} < 5:
			set {_stacks} to {_stacks} + 1
			set metadata value "DawningHorizonStacks%{_p}%" of {_p} to {_stacks}
		
		set metadata value "DawningHorizonMastery" of {_p} to {_stat} * {_stacks}
		set {_horizon} to metadata value "DawningHorizonStacks%{_p}%" of {_p}
		set {_masteryGranted} to metadata value "DawningHorizonMastery" of {_p}
		buffRegister({_p}, "Horizon", 2, "", "Stacks", "<#f53b98> &f%(round({_masteryGranted}, 0))% &7| &f%{_horizon}%", "8 sec")
		
		set metadata value "DawningHorizonTime%{_p}%" of {_p} to 8
		if metadata value "DawningHorizonLoop%{_p}%" of {_p} is not set:
			set metadata value "DawningHorizonLoop%{_p}%" of {_p} to true
			while metadata value "DawningHorizonTime%{_p}%" of {_p} > 0:
				wait 1 second
				if metadata value "DawningHorizonTime%{_p}%" of {_p} is set:
					set {_t} to metadata value "DawningHorizonTime%{_p}%" of {_p}
					set {_t} to {_t} - 1
					set metadata value "DawningHorizonTime%{_p}%" of {_p} to {_t}

					if {_t} > 0:
						set {_horizon} to metadata value "DawningHorizonStacks%{_p}%" of {_p}
						set {_masteryGranted} to metadata value "DawningHorizonMastery" of {_p}
						buffRegister({_p}, "Horizon", 2, "", "Stacks", "<#f53b98> &f%(round({_masteryGranted}, 0))% &7| &f%{_horizon}%", "%{_t}% sec")

			clear metadata value "DawningHorizonLoop%{_p}%" of {_p}
			clear metadata value "DawningHorizonStacks%{_p}%" of {_p}
			clear metadata value "DawningHorizonMastery" of {_p}
			buffClear({_p}, "Horizon")
		else:
			set metadata value "DawningHorizonTime%{_p}%" of {_p} to 8

function CresseliaStreakingStars(p: player, target: entity, spell: string):
	if metadata value "CelestialAlignment" of {_p} is set:
		set {_damage} to offensiveTrait({_p}, "Cresselia", "Streaking Stars")
		if {_damage} > 0:
			if metadata value "StreakingStarsLastSpell%{_p}%" of {_p} != {_spell}:
				set metadata value "StreakingStarsLastSpell%{_p}%" of {_p} to {_spell}

				set {_primCol} to coloured getPrimaryCardColour({_p})
				set {_secCol} to coloured getSecondaryCardColour({_p})
				
				set {_loc} to location of block 15 blocks above {_target}
				spawn an armor stand at {_loc} with nbt from "{Invulnerable:1b,Invisible:1b,NoGravity:1b,Silent:1b,Pose:{Head:[180.0f,0.0f,0.0f]}}"
				set boolean tag "RemoveOnReset" of (custom nbt of last spawned armor stand) to true
				set {_star} to last spawned armor stand
				
				modelApply({_star}, "starfallmodel", 0.6)
				
				CresseliaShootingStarSound({_p}, {_target})
				
				set {_y} to 0
				set {_locStar} to location of {_star}
				set {_count} to 0
				set {_starSpeed} to 0.7
				
				while {_star} is alive:
					set {_targetLoc} to location 0.5 below {_target}
					set {_vec} to vector between {_locStar} and {_targetLoc}
					set vector length of {_vec} to {_count} * {_starSpeed}
					teleport {_star} to {_locStar} ~ {_vec}
					add nbt from "{Rotation:[%{_y}-5%f,%{_y}-5%.0f]}" to nbt of {_star}
					
					if distance between {_star} and {_target} < 1.5:
						kill {_star}
						set {_hit} to true
						stop loop
						
					wait 1 tick
					set {_count} to {_count} + 1
					set {_y} to {_y} + 25
					
					if {_count} > 60:
						kill {_star}
						stop loop
						
				if {_hit} is true:
					set {_crit} to (CriticalHit({_p})/10) + 15
					set {_critMod} to 2
					if boolean tag "Constellation;The Eternal Moon" of (custom nbt of {karta::%{_p}%}) is set:
						set {_critMod} to {_critMod} + 0.2
						
					set {_finalDmg} to Crit({_p}, {_target}, {_crit}, {_damage}, {_critMod})
					
					set {_target}'s last damage cause to sweep attack
					set metadata value "LastDamageCause" of {_target} to "%{_primCol}%Streaking Star"
					set metadata value "LastDamageCauseLore" of {_target} to "Streaking Star"
					set metadata value "Element" of {_p} to "Astral"
					make {_p} damage {_target} by {_finalDmg}
					
					shootingStarsVisual({_p}, (location 0.5 above {_target}))
					play sound "entity.armadillo.brush" with volume 1.5 and pitch 1.5 at location of {_target}

