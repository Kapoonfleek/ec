command /rename [<text>]:
	description: Changes the item name
	executable by: players
	trigger:
		if player's tool is not air:
			if arg 1 is set:
				set the name of player's tool to coloured argument
				send "&cSuccessfully changed the name of the item!" to player
			else:
				send "&cCorrect usage: /relore <text>" to player
		else:
			send "&cYou must be holding an item to use this command!" to player

command /relore [<text>]:
	description: Changes the item lore
	executable by: players
	trigger:
		if player's tool is not air:
			if arg 1 is set:
				set the lore of player's tool to coloured argument
				send "&cSuccessfully changed the lore of the item!" to player
			else:
				send "&cCorrect usage: /relore <text>" to player
		else:
			send "&cYou must be holding an item to use this command!" to player