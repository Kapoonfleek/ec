function newCardAssignments(p: player, card: item, ele: string, prim: string, icon: string) :: item:
	set {_y} to data()
	set {_id} to random 8 char string from charset `0-9` `a-z`
	add "&8Id: %{_id}%" to lore of {_card}
	add "&8Dropped: %{_y}%" to lore of {_card}

	set string tag "Element" of custom nbt of {_card} to {_ele}
	set boolean tag "Card" of custom nbt of {_card} to true

	set int tag "Stats;%{_prim}%" of custom nbt of {_card} to 0
	set int tag "Stats;Health" of custom nbt of {_card} to 0
	set int tag "Stats;Damage" of custom nbt of {_card} to 0
	set int tag "Stats;Resistance" of custom nbt of {_card} to 0
	set int tag "Stats;Mobility" of custom nbt of {_card} to 0
	set int tag "Stats;Utility" of custom nbt of {_card} to 0
	set int tag "Stats;Crowd Control" of custom nbt of {_card} to 0
	set int tag "Stats;Versatility" of custom nbt of {_card} to 0
	set int tag "Stats;Mastery" of custom nbt of {_card} to 0
	set int tag "Stats;Critical Hit" of custom nbt of {_card} to 0
	set int tag "Stats;Element" of custom nbt of {_card} to 0
	set int tag "Stats;Haste" of custom nbt of {_card} to 0
	set int tag "Stats;Avoidance" of custom nbt of {_card} to 0

	set string tag "PrimaryStat" of custom nbt of {_card} to {_prim}

	set string tag "CardIcon" of custom nbt of {_card} to {_icon}

	set string tag "OriginalOwner" of custom nbt of {_card} to {_p}'s name

	set int tag "MaxLevel" of custom nbt of {_card} to 60
	set int tag "EquippedGems" of custom nbt of {_card} to 0

	set string tag "Id" of custom nbt of {_card} to {_id}

	set int tag "StellarPower" of custom nbt of {_card} to 0


	return {_card}
	
on rightclick:
	if boolean tag "Card" of custom nbt of player's tool is not set:
		if line 19 of lore of player's tool contains "&8Id:":
			set boolean tag "Card" of custom nbt of player's tool to true
	else:
		if string tag "Id" of custom nbt of player's tool is set:
			cancel event if clicked entity is not item frame
			if target of player is a player:
				if target of player is not online:
					if (distance between (target of player) and player) < 7:
						stop

			else if metadata value "dungeon" of player is set:
				cancel event
				send "&9You can't open the card menu while in a dungeon." to player
				play sound "block.glass.break" with volume 3 and pitch 1 to player
				stop

			if player is alive:
				if metadata value "ECEngaged" of player is set:
					send "&9You can't open the card menu during combat." to player
					play sound "block.glass.break" with volume 3 and pitch 1 to player
					stop

				set {_id} to string tag "Id" of custom nbt of player's tool

				if {karta::%player%} is set:
					set {_idPreviousCard} to string tag "Id" of custom nbt of {karta::%player%}
					if {_id} != {_idPreviousCard}:
						save yaml "activeCard-%player%"
						unload yaml "activeCard-%player%"
						load yaml "plugins/Skript/playerdata/karty/%uncolored name of player's tool%/%{_id}%.yml" as "activeCard-%player%"
				else:
					load yaml "plugins/Skript/playerdata/karty/%uncolored name of player's tool%/%{_id}%.yml" as "activeCard-%player%"

				UpdateCard(player)
				SetPlayerStats(player) #Sets player stats to current selected card's stats (funkcje.sk)
			
				set {kartaname::%player%} to uncolored name of player's tool
				set {kartacolor::%player%} to last string color code of player's tool's name
				
				set {_cardLevel} to yaml value "Card.Level" in "activeCard-%player%"

				set {karta::%{_id}%} to {kartaname::%player%}
				set string tag "Owner" of custom nbt of player's tool to "%player%"

				set {_elementText} to string tag "Element" of custom nbt of player's tool
				set string tag "ECElement" of custom nbt of player to {_elementText} #Card's Element when receiving damage

				
				set {_primaryStatType} to string tag "PrimaryStat" of custom nbt of player's tool
				set metadata value "PrimaryStatType" of player to {_primaryStatType}

				if string tag "OriginalOwner" of custom nbt of player's tool is not set:
					set string tag "OriginalOwner" of custom nbt of player's tool to player's name

				set {_primarystat} to int tag "Stats;%{_primaryStatType}%" of custom nbt of player's tool
				set {_health} to int tag "Stats;Health" of custom nbt of player's tool
				set {_damage} to int tag "Stats;Damage" of custom nbt of player's tool
				set {_resistance} to int tag "Stats;Resistance" of custom nbt of player's tool
				set {_mobility} to int tag "Stats;Mobility" of custom nbt of player's tool
				set {_utility} to int tag "Stats;Utility" of custom nbt of player's tool
				set {_crowdcontrol} to int tag "Stats;Crowd Control" of custom nbt of player's tool
				set {_versatility} to int tag "Stats;Versatility" of custom nbt of player's tool
				set {_mastery} to int tag "Stats;Mastery" of custom nbt of player's tool
				set {_criticalhit} to int tag "Stats;Critical Hit" of custom nbt of player's tool
				set {_element} to int tag "Stats;Element" of custom nbt of player's tool
				set {_haste} to int tag "Stats;Haste" of custom nbt of player's tool
				set {_avoidance} to int tag "Stats;Avoidance" of custom nbt of player's tool

				set {_total} to {_primarystat} + {_health} + {_damage} + {_resistance} + {_mobility} + {_utility} + {_crowdcontrol} + {_versatility} + {_mastery} + {_criticalhit} + {_element} + {_haste} + {_avoidance}

				set int tag "Stats;Total" of custom nbt of player's tool to {_total}
					
				
				UpdateScoreboard(player)

				loop 12 times:
					if {trait::%{_id}%::%loop-number%} is set:
						set {hearttrait::%player%::%loop-number%} to {trait::%{_id}%::%loop-number%}

				if name of player's tool contains "Brother Therold":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Glaceon":
					set string tag "CardIcon" of custom nbt of player's tool to ""
					set metadata value "Fingers of Frost" of player to 0
				else if name of player's tool contains "Umbreon":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Delphox":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Buckshot":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Drogoz":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Cresselia":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Shenhe":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Vaporeon":
					set string tag "CardIcon" of custom nbt of player's tool to ""
				else if name of player's tool contains "Espeon":
					set string tag "CardIcon" of custom nbt of player's tool to ""

				SetCardIcon(player)

				if {damage::dealt::%{_id}%} is not set:
					set {damage::dealt::%{_id}%} to 0
				if {damage::taken::%{_id}%} is not set:
					set {damage::taken::%{_id}%} to 0

				if {kartaname::%player%} = "Umbreon":
					if boolean tag "Constellation;Featherfoot" of custom nbt of {karta::%player%} is set:
						if (time in world "world") is between 10:00 PM and 4:00 AM:
							set metadata value "UmbreonFeatherfoot" of player to 150
						else:
							set metadata value "UmbreonFeatherfoot" of player to 100
				else:
					clear metadata value "UmbreonFeatherfoot" of player

				set max health of player to 25 + ({health::%player%}/5)
				set scaled health of player to 20
				heal the player
				playerMoveSpeedUpdate(player)
				updateAzeriteArmorLore(player)

				if {mobskilled::%{kartaname::%player%}%::%{_id}%} is not set:
					set {mobskilled::%{kartaname::%player%}%::%{_id}%} to 0
				if {deaths::%{kartaname::%player%}%::%{_id}%} is not set:
					set {deaths::%{kartaname::%player%}%::%{_id}%} to 0

				set {_mobsK} to {mobskilled::%{kartaname::%player%}%::%{_id}%}
				set {_deaths} to {deaths::%{kartaname::%player%}%::%{_id}%}
				set {_damagedealt} to {damage::dealt::%{kartaname::%player%}%::%{_id}%}
				set {_damagetaken} to {damage::taken::%{kartaname::%player%}%::%{_id}%}

				set {_k} to {kartacolor::%player%}
				set metadata tag "kartagui" of player to chest inventory with 3 rows named "%uncolored name of player's tool% - Select Category"
				set {_gui} to (metadata tag "kartagui" of player)
				set slot integers between 0 and 26 of {_gui} to black stained glass pane named " "
				set slot 4 of {_gui} to player's tool with lore (lore of player's tool) and "&7&oYour current card"

				loop 5 times:
					if yaml value "Card.Talents.Row %loop-number%" in "activeCard-%player%" is not set:
						if loop-number <= 2:
							if (int tag "Level" of custom nbt of player's tool) >= 15*loop-number:
								add 1 to {_talentPointsAvailable}
						else if loop-number = 3:
							if (int tag "Level" of custom nbt of player's tool) >= 40:
								add 1 to {_talentPointsAvailable}
						else if loop-number = 4:
							if (int tag "Level" of custom nbt of player's tool) >= 45:
								add 1 to {_talentPointsAvailable}
						else:
							if (int tag "Level" of custom nbt of player's tool) >= 50:
								add 1 to {_talentPointsAvailable}

				set slot 9 of {_gui} to blue stained glass pane named "&9Cards Explained" with lore "&7Cards are &fcollectible playable characters &7that%nl%&7can be used in combat by the player.%nl% %nl%&7Cards can be &fleveled &7and may have their &fpower%nl%&fincreased &7through features including:%nl%&f- &6Talents &9(unlocked at certain levels)%nl%&f- &cConstellations &9(unlocked by collecting copies)%nl%&f- &eGear &9(dropped from mobs and endgame content)%nl%&f- &5Ability Levels &9(unlocked by expending materials)%nl%&f- &bAzerite Powers &9(found on Azerite Gear)%nl%&f- &aSpecializations &9(capstones unlocked at level caps)%nl% %nl%&6&nThe current max Card Level is&r &f60&7."
				set slot 11 of {_gui} to fire charge named "&eAbilities" with lore "&7Click here to view your Card's%nl%&7abilities and mastery bonus.%nl% %nl%&eAbilities%nl%&7Sets of skills that can be used in both%nl%&7PVE and PVP combat. Abilities can be%nl%&7further upgraded by spending materials."
				set slot 12 of {_gui} to {odlamekgwiazdyEN} named "&cConstellation" with lore "&7Click here to check your Card's%nl%&7constellation and constellation bonuses.%nl% %nl%&cConstellations%nl%&7Powerful sequential bonuses unlocked%nl%&7by collecting multiple copies of a Card."
				set slot 13 of {_gui} to golden helmet named "&eGear" with lore "&7Click here to manage your Card's gear.%nl% %nl%&eGear%nl%&7Armour that can be equipped by your Card.%nl%&7Gear provides stats and can come with%nl%&7additional unique effects or set bonuses." with nbt from "{""minecraft:attribute_modifiers"":{modifiers:[],show_in_tooltip:0}}"
				set {_specPoints} to 0
				set slot 14 of {_gui} to diamond named "&cSpecializations" with lore "&7Click here to view or select your%nl%&7Card's specialization.%nl% %nl%&cSpecializations%nl%&7Special &fcapstones &7unlocked with each new &fmax%nl%&flevel &7reached by your Card. Specializations%nl%&7are impactful powers capable of elevating%nl%&7and adding uniqueness to your very own playstyle.%nl% %nl%&f%{_specPoints}% Available Specialization Points" with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
				set slot 15 of {_gui} to brush named "&6Talents" with lore "&7Click here to view and learn%nl%&7your Card's talents.%nl% %nl%&6Talents%nl%&7Powerful bonuses learned at set Card Levels.%nl%&7Talents are designed to create unique playstyles,%nl%&7anlock new abilities and add versatility and extra%nl%&7fun to the combat prowess of a Card.%nl% %nl%&f- &7Left Click to see &flearned &7Talent rows%nl%&f- &7Shift Click to see &fall &7Card Talents%nl% %nl%&f%{_talentPointsAvailable}% Available Talent Points"
				set {_loreStats2} to "&7shielding and supportive buffs.%nl%<##58c3f5> Crowd Control&7: Improves most CC (stuns, knockups, etc.)%nl%&7and increases the range of most abilities.%nl%<##e3ebff> Versatility&7: Damage, Resistance and Utility all%nl%&7in one stat at 33%% effectiveness each.%nl%<##f53b98> Mastery&7: Differs per card and provides an additional%nl%&7passive effect.%nl%<##fca417> Critical Hit&7: Chance to deal increased damage.%nl%<##d5ff57> Element&7: Increases damage dealt and reduces damage%nl%&7taken by supereffective and ineffective attacks.%nl%<##19943e> Haste&7: Decreases most cooldowns and tick times of abilities.%nl%<##2154ad> Avoidance&7: Increases the chance to avoid an attack."
				set {_loreStats} to "<#f74428> Damage&7: Increases the damage of most abilities.%nl%<##ffef45> Resistance&7: Reduces the damage taken by attacks.%nl%&f Mobility&7: Increases movement and flying speed.%nl%<##ae78d0> Utility&7: Increases the effectiveness of most healing,%nl%%{_loreStats2}%"
				set slot 17 of {_gui} to blue stained glass pane named "&9Stats Explained" with lore "&fPrimary Stats:%nl%<#5ee359> Agility&7, <#59c1e3>  Intellect &7and <#e35959> Strength &7are main stats%nl%&7and all greatly increase the damage and healing.%nl%<#5ee359> Agility &7is the stat of most ranged users,%nl%<#59c1e3> Intellect &7is the stat of most magic users, while%nl%<#e35959> Strength &7is the stat of most melee Cards.%nl% %nl%&fSecondary Stats:%nl%<#c0ff02> Health&7: Increases the amount of HP (hearts).%nl%%{_loreStats}%"
				set slot 22 of {_gui} to glow berries named "&6Variants" with lore "&7Click here to view and manage%nl%&7this Card's variants.%nl% %nl%&6Variants%nl%&7Cosmetic appearances enriching or changing%nl%&7the theme, visual appearance and sound%nl%&7effects of Card abilities."
				open {_gui} to player

				loop {gem::%{_id}%::*}:
					set {_r} to "%loop-value%"
					loop lore of loop-value:
						if loop-value-2 contains "Quality" or "Jakość":
							set {_x} to uncolored loop-value-2
							replace all "Jakość: ★★★" and "Quality: ★★★" in {_x} with "(R3)"
							replace all "Jakość: ★★" and "Quality: ★★" in {_x} with "(R2)"
							replace all "Jakość: ★" and "Quality: ★" in {_x} with "(R1)"
							replace all "★" in {_x} with ""
					replace all "diamond named " in {_r} with ""
					set {_r} to uncolored {_r}
					add "%{_r}% %{_x}%" to {_gemy::*}
				set {_agStats::*} to {_primarystat}, {_health}, {_damage}, {_resistance}, {_mobility}, {_utility}, {_crowdcontrol}, {_versatility}, {_mastery}, {_criticalhit}, {_element}, {_haste}, {_avoidance} and {_total}
				set {_ag::*} to "%{_primaryStatType}%", "Health", "Damage", "Resistance", "Mobility", "Utility", "Crowd Ctrl", "Versatility", "Mastery", "Critical Hit", "Element", "Haste", "Avoidance", "Total"
				loop 12 times:
					if {trait::%{_id}%::%loop-number%} is set:
						set {_ce::%loop-number%} to uncolored {trait::%{_id}%::%loop-number%}
					else:
						set {_ce::%loop-number%} to "Not set"
				set {_dr} to uncolored line 20 of lore of player's tool
				set {_cardname} to uncolored name of player's tool
				set {_color} to raw (name of player's tool)
				loop 5 times:
					if string tag "Talents;Row %loop-number%" of nbt compound of player's tool is set:
						add string tag "Talents;Row %loop-number%" of nbt compound of player's tool to {_talents::*}
				#replace all """", "{" and "}" in {_talents} with ""
				#replace all ":" in {_talents} with " ("
				#set {_talents::*} to {_talents} split at ","
				#set {_numBer} to 1
				#loop {_talents::*}:
				#	set {_talents::%{_num}%} to "%loop-value%)"
				#	add 1 to {_numBer}
				replace all (uncolored name of player's tool) in {_color} with ""
				replace all "<" and ">" in {_color} with ""
				replace all "Dropped: " and "Wydropiono: " in {_dr} with ""


				set yaml value "Card.Card" in "activeCard-%player%" to {_cardname}
				set yaml value "Card.Owner" in "activeCard-%player%" to player
				set yaml value "Card.Dropped" in "activeCard-%player%" to {_dr}
				set yaml value "Card.Colour" in "activeCard-%player%" to {_color}
				set yaml value "Card.Level" in "activeCard-%player%" to {_cardLevel}
				set yaml value "Card.Id" in "activeCard-%player%" to {_id}
				#set yaml value "Card.Exp" in "activeCard-%player%" to round({expkarta::%{_id}%}, 2)
				set yaml value "Card.Element" in "activeCard-%player%" to {_elementText}
				#set yaml value "Card.Ascension" in "activeCard-%player%" to {wyniesienie::%{_id}%}
				if yaml value "Card.Constellation" in "activeCard-%player%" is not set:
					set yaml value "Card.Constellation" in "activeCard-%player%" to 0
				if yaml value "Card.Gear Score" in "activeCard-%player%" is not set:
					set yaml value "Card.Gear Score" in "activeCard-%player%" to 0
				if yaml value "Card.Variant" in "activeCard-%player%" is not set:
					set yaml value "Card.Variant" in "activeCard-%player%" to "Classic"
				set {_agIndex} to 1
				loop {_ag::*}:
					set yaml value "Card.Stats.%loop-value%" in "activeCard-%player%" to {_agStats::%{_agIndex}%}
					add 1 to {_agIndex}
				set yaml list "Card.Talents" in "activeCard-%player%" to {_talents::*}
				set yaml list "Card.Gems" in "activeCard-%player%" to {_gemy::*}
				set yaml list "Card.Traits" in "activeCard-%player%" to {_ce::*}

				if yaml list "Card.Gear.Artifacts" in "activeCard-%player%" is set:
					set {_gear::*} to yaml list "Card.Gear.Artifacts" in "activeCard-%player%"
					set yaml list "Card.Gear.Artifacts" in "activeCard-%player%" to {_gear::*}
				if {_gear::*} is set:
					loop {_gear::*}:
						set yaml value "Card.Gear.Artifacts.%loop-value%.Item Level" in "activeCard-%player%" to 50
						set yaml list "Card.Gear.Artifacts.%loop-value%.Stats" in "activeCard-%player%" to "25 Damage", "7 Utility", "25 Haste" and "31 Critical Hit"
						set yaml value "Card.Gear.Artifacts.%loop-value%.Upgrade Level" in "activeCard-%player%" to 25

				save yaml "activeCard-%player%"
				CardBackup(player, uncolored name of player's tool, {_id})
	
function CardBackup(p: player, name: string, id: string):
	load yaml "plugins/Skript/backups/cards/%{_name}%/%{_id}%.yml" as "cardbackup-%{_id}%"
	set yaml value "Card" in "cardbackup-%{_id}%" to {_p}'s tool
	save yaml "cardbackup-%{_id}%"
	unload yaml "cardbackup-%{_id}%"

on leave:
	clear metadata value "gemadd" of player
	clear {rgem::%player%}

on inventory click:
	if player's current inventory is (metadata tag "topkigui" of player):
		cancel event
	else if player's current inventory is (metadata tag "kartagui2" of player):
		cancel event
	else if player's current inventory is (metadata tag "kartagui" of player):
		cancel event
		if event-inventory is (metadata tag "kartagui" of player):
			set {_id} to uncolored line 19 of lore of {karta::%player%}
			replace all "Id: " in {_id} with ""
			#GEMY
			if index of event-slot is 14:
				if {language::%player%} = "English":
					set metadata tag "gemykarta" of player to chest inventory with 6 rows named "Gems"
				else:
					set metadata tag "gemykarta" of player to chest inventory with 6 rows named "Gemy"
				open (metadata tag "gemykarta" of player) to player
				play sound "ui.click_echo" with volume 1 and pitch 1 to player
				loop 54 times:
					add 1 to {_loopnumber}
					if {gem::%{_id}%::%{_loopnumber}%} is not set:
						if (loop-number - 1) = 0:
							if {language::%player%} = "English":
								set {_slot} to purple stained glass pane named "<##a335ee>Epic Gem" with lore "&fSlot %{_loopnumber}%" and "&7An epic Gem will fit in this slot."
							else:
								set {_slot} to purple stained glass pane named "<##a335ee>Epicki Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się epicki Gem."
						else:
							if {slotgem::%{_id}%::%{_loopnumber}%} = true:
								if {raregem::%{_id}%::%{_loopnumber}%} = true:
									if {language::%player%} = "English":
										set {_slot} to blue stained glass pane named "<##0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
									else:
										set {_slot} to blue stained glass pane named "<##0070dd>Rzadki Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się rzadki gGem."
								else:
									if {language::%player%} = "English":
										set {_slot} to lime stained glass pane named "<##1eff00>Uncommon Gem" with lore "&fSlot %{_loopnumber}%" and "&7An uncommon Gm will fit in this slot." and " " and "&7Upgrade this slot to <##0070dd>Rare &7quality" and "&7by talking to Zach."
									else:
										set {_slot} to lime stained glass pane named "<##1eff00>Nieczęsty Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się nieczęsty Gem." and " " and "&7Możesz ulepszyć ten slot do <##0070dd>Rzadkiej &7jakości" and "&7u Zacha."
							else:
								if {_loopnumber} > 4:
									if int tag "Level" of custom nbt of {karta::%player%} >= {_loopnumber}*8-32:
										if {raregem::%{_id}%::%{_loopnumber}%} = true:
											if {language::%player%} = "English":
												set {_slot} to blue stained glass pane named "<##0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
											else:
												set {_slot} to blue stained glass pane named "<##0070dd>Rzadki Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się rzadki Gem."
										else:
											if {language::%player%} = "English":
												set {_slot} to lime stained glass pane named "<##1eff00>Uncommon Gem" with lore "&fSlot %{_loopnumber}%" and "&7An uncommon Gem will fit in this slot." and " " and "&7Upgrade this slot to <##0070dd>Rare &7quality" and "&7by talking to Zach."
											else:
												set {_slot} to lime stained glass pane named "<##1eff00>Nieczęsty Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się nieczęsty Gem." and " " and "&7Możesz ulepszyć ten slot do <##0070dd>Rzadkiej &7jakości" and "&7u Zacha."
									else:
										if {language::%player%} = "English":
											set {_slot} to red stained glass pane named "&cLocked Slot" with lore "&7Reach level &f%{_loopnumber}*8-32% &7on your card" and "&7to unlock this slot."
										else:
											set {_slot} to red stained glass pane named "&cNieodblokowany Slot" with lore "&7Osiągnij poziom &f%{_loopnumber}*8-32% &7na karcie" and "&7by odblokować ten slot."
								else:
									if {_loopnumber} is not 2:
										if {raregem::%{_id}%::%{_loopnumber}%} = true:
											if {language::%player%} = "English":
												set {_slot} to blue stained glass pane named "<##0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
											else:
												set {_slot} to blue stained glass pane named "<##0070dd>Rzadki Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się rzadki gGem."
										else:
											if {language::%player%} = "English":
												set {_slot} to lime stained glass pane named "<##1eff00>Uncommon Gem" with lore "&fSlot %{_loopnumber}%" and "&7An uncommon Gem will fit in this slot." and " " and "&7Upgrade this slot to <##0070dd>Rare &7quality" and "&7by talking to Zach."
											else:
												set {_slot} to lime stained glass pane named "<##1eff00>Nieczęsty Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się nieczęsty Gem." and " " and "&7Możesz ulepszyć ten slot do <##0070dd>Rzadkiej &7jakości" and "&7u Zacha."
									else:
										if {language::%player%} = "English":
											set {_slot} to blue stained glass pane named "<##0070dd>Rare Gem" with lore "&fSlot %{_loopnumber}%" and "&7A rare Gem will fit in this slot."
										else:
											set {_slot} to blue stained glass pane named "<##0070dd>Rzadki Gem" with lore "&fSlot %{_loopnumber}%" and "&7W tym slocie zmieści się rzadki Gem."
					else:
						set {_gem} to {gem::%{_id}%::%{_loopnumber}%}
						if {language::%player%} = "English":
							add " " and "&cClick to destroy this gem" to lore of {_gem}
						else:
							add " " and "&cKliknij, by zniszczyć gem" to lore of {_gem}
						set {_slot} to {_gem}
					set {_LN} to loop-number
					set {_page} to rounded down (loop-number/55)
					if {_page} >= 1:
						set {_LN} to loop-number - (loop-number/{_page})
					set slot ({_LN} - 1) of metadata tag "gemykarta" of player to {_slot}
					clear {_slot}
				stop
			else if index of event-slot is 11:
				if name of event-slot contains "Abilities":
					play sound "entity.armadillo.scute_drop" with volume 1 and pitch 1 to player
					set {_hasteTt} to Haste(player)
					set metadata tag "abilitygui" of player to chest inventory with 4 rows named "%uncolored name of player's tool% - Abilities"
					set {_gui} to metadata tag "abilitygui" of player
					set {_id} to line 19 of lore of player's tool
					set {_pospiech} to Haste(player)
					set {_crowdcontrol} to CrowdControl(player)
					set slot 0 of {_gui} to magenta stained glass pane named "<##f53b98>Mastery" with lore "&7All Mastery bonuses of this Card."
					set slot 9 of {_gui} to lime stained glass pane named "&aPassive Abilities" with lore "&7All Passive abilities of this Card."
					set slot 18 of {_gui} to blue stained glass pane named "&9Basic Abilities" with lore "&7All Basic Abilities of this Card."
					set slot 27 of {_gui} to red stained glass pane named "&cUltimate Abilities" with lore "&7All Ultimate Abilities of this Card."
					#set slot 36 of {_gui} to orange stained glass pane named "&6Talent Abilities" with lore "&7All Talent Abilities and Talent Passives%nl%&7of this Card."
					if uncolored name of player's tool = "Glaceon":
						set {_damageicicles} to (0.4 + {damage::%player%}/75 + {versatility::%player%}/225 + {primarystat::%player%}/37.5) * (1 + ({mastery::%player%}/3.75/100))
						set {_casttimeFB} to round((3/{_pospiech}), 1)
						set {_damageFB} to 2 + {damage::%player%}/40 + {versatility::%player%}/120 + {primarystat::%player%}/20
						set {_slowtime} to "%2 + ({crowdcontrol::%player%}/100)% sec"
						set {_slow} to 40
						set {_BonuschanceFoF} to 0
						set {_cdIceLance} to 1.5/{_pospiech}
						set {_damageIL} to 2.5 + {damage::%player%}/34 + {versatility::%player%}/102 + {primarystat::%player%}/17
						set {_hasteTt} to 750
						set {_hasteTt} to ({_hasteTt}/25)
						set {_seconds} to 20
						set {_brainFreezeChance} to 30

						set {_flurryCastTime} to round((3/{_pospiech}), 1)
						set {_slowFlurry} to 40
						set {_slowtimeFlurry} to "%2 + ({crowdcontrol::%player%}/100)% sec"
						set {_damageFlurry} to (2 + (({damage::%player%}/36) + ({versatility::%player%}/108) + ({primarystat::%player%}/18)))
						set {_flurryDmgIncrease} to 50

						set {_cdIcyVeins} to "180 seconds" parsed as timespan
						set {_icyVeinsHaste} to 120

						if string tag "Talents;Row 1" of custom nbt of player's tool = "Clarity of Thought":
							add 5 to {_brainFreezeChance}

						set {_glacialSpikeCast} to "%2.75/{_haste}% seconds"
						set {_damageGlacialSpike} to 5 + {damage::%player%}/14 + {versatility::%player%}/42 + {primarystat::%player%}/7

						if boolean tag "Constellation;Eternal Winter" of custom nbt of player's tool is set:
							set {_icicleCap} to 7
						else:
							set {_icicleCap} to 5

						set slot 1 of {_gui} to diamond named "<##4bbfe2>Mastery: Icicles" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<##4bbfe2>Casting &f <##7fd6f0>Frostbolt <##4bbfe2>grants you an &f <##7fd6f0>Icicle<##4bbfe2>.%nl%&f <##7fd6f0>Ice Lance <##4bbfe2>hurls all stored &f <##7fd6f0>Icicles <##4bbfe2>at%nl%<##4bbfe2>your target, each dealing &f%{_damageicicles}% <##add8e6>Ice <##4bbfe2>damage.%nl% %nl%<##4bbfe2>Up to &f%{_icicleCap}% &f <##7fd6f0>Icicles <##4bbfe2>can be stored. Any excess%nl%<##4bbfe2>&f <##7fd6f0>Icicles <##4bbfe2>gained will be automatically launched." with nbt from "{""minecraft:custom_model_data"":{floats:[45.0f]}}"
						set slot 10 of {_gui} to diamond named "<##4bbfe2>Shatter" with lore "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<##4bbfe2>Increases your <##7fd6f0> Critical Hit <##4bbfe2>chance against%nl%<##4bbfe2>targets affected by &f <##aedafc>Winter's Chill <##4bbfe2>by &f50%%<##4bbfe2>.%nl%<##4bbfe2>Increases your base <##7fd6f0> Critical Hit <##4bbfe2>chance%nl%<##4bbfe2>by &f25%%<##4bbfe2>." with nbt from "{""minecraft:custom_model_data"":{floats:[32.0f]}}"
						set slot 19 of {_gui} to blue dye named "<##4bbfe2>Frostbolt" with lore "&8Basic Ability%nl%&f%{_casttimeFB}% second cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<##4bbfe2>Launches a bolt of frost at the enemy,%nl%<##4bbfe2>dealing &f%{_damageFB}% <##add8e6>Ice <##4bbfe2>damage to the target%nl%<##4bbfe2>and <##7fd6f0> Slowing <##4bbfe2>them by &f%{_slow}%%% <##4bbfe2>for &f%{_slowtime}%<##4bbfe2>.%nl% %nl%&f <##7fd6f0>Frostbolt <##4bbfe2>has a &f%15 +{_BonuschanceFoF}%%% <##4bbfe2>chance to grant%nl%&f <##aedafc>Fingers of Frost <##4bbfe2>and a &f%30 + {_chanceBrainFreeze}%%% <##4bbfe2>chance to%nl%<##4bbfe2>grant &f <##aedafc>Brain Freeze<##4bbfe2>." with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 20 of {_gui} to light blue dye named "<##4bbfe2>Ice Lance" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Global Cooldown:  &f%{_cdIceLance}% seconds%nl%&7Use: &fRMB%nl%<##4bbfe2>Hurls an &f <##7fd6f0>Ice Lance <##4bbfe2>at the target, inflicting%nl%&f%{_damageIL}% <##add8e6>Ice <##4bbfe2>damage, and incurring a &f%{_cdIceLance}% sec <##4bbfe2>global%nl%<##4bbfe2>cooldown when it is used without &f <##aedafc>Fingers of%nl%<##aedafc>Frost<##4bbfe2>.%nl% %nl%&f <##7fd6f0>Ice Lance <##4bbfe2>deals <##7fd6f0>double <##4bbfe2>damage against%nl%<##4bbfe2>targets affected by &f <##aedafc>Winter's Chill<##4bbfe2>.%nl% %nl%&f <##aedafc>Fingers of Frost%nl%<##4bbfe2>Your next &f <##7fd6f0>Ice Lance <##4bbfe2>will deal damage%nl%<##4bbfe2>as if the target was affected by &f <##aedafc>Winter's%nl%<##aedafc>Chill <##4bbfe2>and will incur no cooldown." with nbt from "{""minecraft:custom_model_data"":{floats:[9.0f]}}"
						set slot 21 of {_gui} to prismarine shard named "<##4bbfe2>Flurry" with lore "&8Basic Ability%nl%&f%{_flurryCastTime}% second cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<##4bbfe2>Unleash a flurry of ice shards, striking the%nl%<##4bbfe2>target &f3 <##4bbfe2>times for a total of &f%{_damageFlurry}% <##add8e6>Ice <##4bbfe2>damage.%nl%<##4bbfe2>Each hit reduces the target's <##7fd6f0> Movement%nl%<##7fd6f0>Speed <##4bbfe2>by &f%{_slowFlurry}%%% <##4bbfe2>for &f%{_slowtimeFlurry}%<##4bbfe2>.%nl% %nl%<##4bbfe2>If &f <##aedafc>Brain Freeze <##4bbfe2>is active, &f <##7fd6f0>Flurry%nl%<##4bbfe2>consumes it to <##4bbfe2>deal &f%{_flurryDmgIncrease}%%% <##4bbfe2>increased damage%nl%<##4bbfe2>and apply a stack of &f <##aedafc>Winter's Chill <##4bbfe2>to its%nl%<##4bbfe2>target with each strike for &f8 sec<##4bbfe2>, up to &f2<##4bbfe2>." with nbt from "{""minecraft:custom_model_data"":{floats:[12.0f]}}"
						set slot 28 of {_gui} to lapis lazuli  named "<##4bbfe2>Icy Veins" with lore "&8Ultimate Ability" and "&fInstant cast" and "&7Cooldown: &8 &f%{_cdIcyVeins}%" and "&7Use: &fRMB" and "<##4bbfe2>Accelerates your spellcasting <##4bbfe2>for%nl%&f%{_seconds}% sec<##4bbfe2>, <##4bbfe2>increasing <##7fd6f0> Haste <##4bbfe2>by &f%{_icyVeinsHaste}%<##4bbfe2>." with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						
						if string tag "Talents;Row 5" of custom nbt of player's tool = "Glacial Spike":
							set slot 29 of {_gui} to prismarine crystals named "<##4bbfe2>Glacial Spike" with lore "&8Ultimate Ability%nl%&f%{_glacialSpikeCast}% cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fRMB%nl%<##4bbfe2>Conjures a massive spike of ice, and merges%nl%<##4bbfe2>your current &f <##7fd6f0>Icicles <##4bbfe2>into it. It impales your%nl%<##4bbfe2>target, dealing &f%{_damageGlacialSpike}% <##add8e6>Ice <##4bbfe2>damage plus all of the%nl%<##4bbfe2>damage stored in your &f <##7fd6f0>Icicles.<##4bbfe2>%nl% %nl%<##4bbfe2>Requires &f5  <##7fd6f0>Icicles to cast.%nl% %nl%&f <##7fd6f0>Ice Lance <##4bbfe2>no longer launches &f <##7fd6f0>Icicles<##4bbfe2>." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
					
					else if uncolored name of player's tool = "Buckshot":
						#PORTALS
						set {_cdportals} to round((9/{_pospiech}), 1)
						set {_portalduration} to 40
						set {_portalCharges} to 2
						set {_portalRange} to 4 + CrowdControl(player)/25

						#BINDING
						set {_bindingShotDamage} to 5 + ({damage::%player%}/11) + ({versatility::%player%}/33) + ({primarystat::%player%}/5.5)
						if string tag "Talents;Row 5" of custom nbt of player's tool = "Dimensional Damage":
							add 10 to {_portalduration}
							set {_bindingShotDamage} to {_bindingShotDamage}*1.5

						set {_bindingShotDuration} to 10
						set {_bindingShotDurationPull} to 10
						set {_cdbinding} to 25
						
						#SHOTS
						set {_mastery} to (180 + ({mastery::%player%}/7.25))
						set {_damage} to 2 + ({damage::%player%}/33) + ({versatility::%player%}/99) + ({primarystat::%player%}/16.5)
						set {_spreadShotArrows} to 5
						set {_spreadShotEffectiveness} to 60
						
						if boolean tag "Constellation;And For My Next Trick" of custom nbt of {karta::%player%} is set:
							add 1 to {_spreadShotArrows}

							if string tag "Talents;Row 1" of custom nbt of player's tool = "Wideshot":
								add 1 to {_spreadShotArrows}
						else:
							if string tag "Talents;Row 1" of custom nbt of player's tool = "Wideshot":
								add 1 to {_spreadShotArrows}
						
						#GOAT
						set {_goatDuration} to 20
						set {_cdGoat} to 240
						if string tag "Talents;Row 3" of custom nbt of {karta::%player%} = "Hail of Portals":
							set {_cdGoat} to {_cdGoat} - 60
						set {_portalMaxBounces} to 3
						set {_goatPortals} to 12
						if string tag "Talents;Row 3" of custom nbt of player's tool = "Hail of Portals":
							add 4 to {_goatPortals}
						set {_goatDistance} to 15

						set slot 1 of {_gui} to arrow named "<##866da4>Mastery: Portal Mastery" with lore GetAbilityDescription("Buckshot", "Portal Mastery", "MASTERY", {_mastery}) with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						set slot 10 of {_gui} to magenta dye named "<##866da4>Mystic Shots" with lore GetAbilityDescription("Buckshot", "Mystic Shots", "", 0) with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						
						set {_valueNames::*} to "DAMAGE", "ARROWS", "EFFECTIVENESS"
						set {_values::*} to {_damage}, {_spreadShotArrows}, {_spreadShotEffectiveness}
						set slot 19 of {_gui} to bow named "<##866da4>Starbolt" with lore GetAbilityDescription("Buckshot", "Starbolt", {_valueNames::*}, {_values::*}) with nbt from "{""minecraft:custom_model_data"":{floats:[3.0f]}}"
						
						set {_valueNames::*} to "CHARGES", "COOLDOWN", "RANGE", "DURATION", "BOUNCES"
						set {_values::*} to {_portalCharges}, {_cdportals}, {_portalRange}, {_portalduration}, {_portalMaxBounces}

						set slot 20 of {_gui} to purple dye named "<##866da4>Magic Portals" with lore GetAbilityDescription("Buckshot", "Magic Portals", {_valueNames::*}, {_values::*}) with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						
						set {_valueNames::*} to "COOLDOWN", "DURATION", "DURATIONPULL", "DAMAGE"
						set {_values::*} to {_cdbinding}, {_bindingShotDuration}, {_bindingShotDurationPull}, {_bindingShotDamage}

						set slot 21 of {_gui} to popped chorus fruit named "<##866da4>Binding Shot" with lore GetAbilityDescription("Buckshot", "Binding Shot", {_valueNames::*}, {_values::*}) with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
						
						set {_valueNames::*} to "COOLDOWN", "PORTALCOUNT", "DISTANCE", "DURATION"
						set {_values::*} to {_cdGoat}, {_goatPortals}, {_goatDistance}, {_goatDuration}
						set slot 28 of {_gui} to pink dye named "<##866da4>G.O.A.T" with lore GetAbilityDescription("Buckshot", "GOAT", {_valueNames::*}, {_values::*}) with nbt from "{""minecraft:custom_model_data"":{floats:[6.0f]}}"
						
					else if uncolored name of player's tool = "Ghazan":
						set {_mastery} to 4 + ({mastery::%player%}/26)
						set {_LTDuration} to 16
						set {_RoLduration} to 12
						if string tag "Talents;Row 1" of custom nbt of {karta::%player%} = "Advanced Technique":
							set {_LTmaxStacks} to 30
							add 0.1 to {_mastery}
						else:
							set {_LTmaxStacks} to 25
							if string tag "Talents;Row 1" of custom nbt of {karta::%player%} = "Unrivaled Finesse":
								add 1.5 to {_RoLduration} 
					
						set {_maxDamageInc} to (1 + ({_mastery}/100))^{_LTmaxStacks}
						set {_LBDamage} to 2.5 + ({damage::%player%}/32.5) + ({versatility::%player%}/97.5) + ({primarystat::%player%}/16.25)
						set {_LBCd} to (8/{_pospiech})
						set {_LBCasttime} to round((2/{_pospiech}), 1)
						set {_lavaSurge} to 12
						
						set {_RoLCd} to "%300/{_pospiech}% seconds" parsed as timespan
						set {_MLCd} to 15/{_pospiech}
						set {_MLRadius} to 2 + (CrowdControl(player)/40)
						set {_MLDamage} to 0.5 + ({damage::%player%}/160) + ({versatility::%player%}/480) + ({primarystat::%player%}/80)
						set {_faster} to 1
						if string tag "Talents;Row 1" of custom nbt of {karta::%player%} = "Hot Hand":
							add 0.08 to {_faster}
						set {_MLTick} to (1/{_faster})/(((({_pospiech}-1)/1.3))+1)
						set {_MLDur} to 30 seconds

						set slot 1 of {_gui} to red dye named "<##b03228>Mastery: Lava Technique" with lore "&8Mastery Bonus%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%&f <##d14d43>Lava Burst <##b03228>deals &f%{_mastery}%%% <##b03228>more damage%nl%<##b03228>to the enemy each time it is used on the%nl%<##b03228>the same target, up to &f%{_LTMaxStacks}% stacks<##b03228>.%nl%<##b03228>Maximum damage increase: &f%{_maxDamageInc}*100%%%<##b03228>.%nl% %nl%<##b03228>This damage increase has a duration%nl%<##b03228>of &f%{_LTDuration}% sec <##b03228>and is refreshed with each%nl%&f <##d14d43>Lava Burst <##b03228>cast on the target." with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 10 of {_gui} to magma cream named "<##b03228>Lava Surge" with lore "&8Passive Ability%nl%&fNo cast%nl%&7Cooldown: &8 &fnone%nl%&7Use: &fPASSIVE%nl%<##b03228>Your &f <##d14d43>Molten Lava <##b03228>damage has a &f%{_lavaSurge}%%%%nl%<##b03228>chance to cause your next &f <##d14d43>Lava Burst%nl%<##b03228>to be instant and not incur its cooldown." with nbt from "{""minecraft:custom_model_data"":{floats:[1.0f]}}"
						set slot 19 of {_gui} to red dye named "<##b03228>Lava Burst" with lore "&8Basic Ability%nl%&f%{_LBCasttime}% second cast%nl%&7Cooldown:  &f%{_LBCd}% seconds%nl%&7Use: &fRMB%nl%<##b03228>Hurls molten lava at the target, dealing%nl%&f%{_LBDamage}% <##ff4d00>Lava <##b03228>damage. &f <##d14d43>Lava Burst <##b03228>will%nl%<##b03228>always <##d14d43> Critically Strike <##b03228>if the target%nl%<##b03228>is affected by &f <##d14d43>Molten Lava<##b03228>." with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						set slot 20 of {_gui} to orange dye named "<##b03228>Molten Lava" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_MLCd}% seconds%nl%&7Use: &fRMB%nl%<##b03228>Turns all terrain in radius &f%{_MLRadius}% <##b03228>of the%nl%<##b03228>target block into &f <##d14d43>Molten Lava <##b03228>for &f%{_MLDur}%<##b03228>.%nl%<##b03228>Enemies standing in &f <##d14d43>Molten Lava%nl%<##b03228>receive &f%{_MLDamage}% <##ff4d00>Lava <##b03228>damage every &f%{_MLTick}% sec<##b03228>." with nbt from "{""minecraft:custom_model_data"":{floats:[8.0f]}}"
						if string tag "Talents;Row 5" of custom nbt of {karta::%player%} = "Skytear":
							set {_rain} to 0.5
						else:
							set {_rain} to 1
						set slot 28 of {_gui} to blaze powder named "<##b03228>Rain of Lava" with lore "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_RoLCd}%%nl%&7Use: &fRMB%nl%<##b03228>Ghazan creates a display of his skill,%nl%<##b03228>throwing himself in the air for &f%{_RoLduration}% sec<##b03228>.%nl%<##b03228>During this spell, Ghazan continously%nl%<##b03228>fires &f <##d14d43>Lava Burst <##b03228>at nearby enemies%nl%<##b03228>every &f%{_rain}% sec<##b03228>, prioritizing enemies inside%nl%&f <##d14d43>Molten Lava<##b03228>." with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
						if string tag "Talents;Row 2" of custom nbt of {karta::%player%} is set:
							if string tag "Talents;Row 2" of custom nbt of {karta::%player%} = "Ascendance":
								set {_cdAsc} to "%360/{_pospiech}% seconds" parsed as timespan
								set {_loreAscendance} to "&8Ultimate Ability%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdAsc}%%nl%&7Use: &fRMB%nl%<##b03228>Transform into a &f <##d14d43>Lava Ascendant <##b03228>for &f18 sec<##b03228>,%nl%<##b03228>removing the cooldown on &f <##d14d43>Lava Burst <##b03228>and%nl%<##b03228>increasing the damage of &f <##d14d43>Lava Burst <##b03228>by an%nl%<##b03228>amount equal to your <##d14d43> Critical Strike <##b03228>chance.%nl% %nl%<##b03228>When you transform into the &f <##d14d43> Lava Ascendant,%nl%<##b03228>instantly cast a &f <##d14d43>Lava Burst <##b03228>at all enemies%nl%<##b03228>affected by your &f <##d14d43>Molten Lava<##b03228>, and refresh%nl%<##b03228>your &f <##d14d43>Molten Lava <##b03228>durations."
								set slot 29 of {_gui} to yellow dye named "<##b03228>Ascendance" with lore {_loreAscendance} with nbt from "{""minecraft:custom_model_data"":{floats:[5.0f]}}"
						
						set {_cast} to 1.5/{_haste}
						set {_lWave} to 3 + ({damage::%player%}/35) + ({versatility::%player%}/105) + ({primarystat::%player%}/17.5)
						set {_lFury} to 5 + ({damage::%player%}/18) + ({versatility::%player%}/36) + ({primarystat::%player%}/9)
						if string tag "Talents;Row 3" of custom nbt of {karta::%player%} is set:
							if string tag "Talents;Row 3" of custom nbt of {karta::%player%} = "Lava Wave":
								set slot 21 of {_gui} to brown dye named "<##b03228>Lava Wave" with lore "&8Basic Ability%nl%&fInstant cast%nl%&7Cooldown: &8 &f1 minute%nl%&7Use: &fRMB%nl%<##b03228>Blast your target with a &f <##d14d43>Lava Wave<##b03228>, which%nl%<##b03228>deals &f%{_lWave}% <##ff3014>Lava <##b03228>damage <##b03228>and applies &f <##d14d43>Molten Lava%nl%<##b03228>upon reaching its target.%nl% %nl%<##b03228>Your next &f <##d14d43>Lava Burst <##b03228>will also hit all targets%nl%<##b03228>affected by &f <##d14d43>Molten Lava <##b03228>for &f80%% <##b03228>of normal%nl%<##b03228>damage." with nbt from "{""minecraft:custom_model_data"":{floats:[4.0f]}}"
							else if string tag "Talents;Row 3" of custom nbt of {karta::%player%} = "Lavakeeper":
