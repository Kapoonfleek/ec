function data() :: string:
	set {_data} to now formatted as "HH:mm:ss dd.MM.yyyy"
	return {_data}

options:
	UTC-Offset: 2

variables:
	{currentUpdate} = "Return to the Heart"
	{currentVersion} = "8.3.0"


# find the number of seconds until a given time
# Uses 24 hour time
function findSecondsUntil(hour: number, minutes: number = 0, seconds: number = 0) :: number:
	#set {_x::*} to text from "https://time.now/developer/api/timezone/Europe/Amsterdam" split at ","
	#set {_time} to {_x::7}
	set {_time} to now
	add 2 hours to {_time}
	set {_unix-now} to unix timestamp of now
	set {_unix-now} to "%{_unix-now}%" parsed as number
	add 7200 to {_unix-now}
	add 3600 * {@UTC-Offset} to {_unix-now} # Offset to correct for timezone
	# offset by the hour, minutes, and seconds to get the exact time we're looking for
	add -3600 * {_hour} to {_unix-now}  
	add -60 * {_minutes} to {_unix-now}
	add -1 * {_seconds} to {_unix-now}
	# use modulus to find the number of seconds until the time we're looking for
	return 86400 - mod({_unix-now}, 86400)

every 10 minutes:
	# every day at 8:00
	# since we check every 10 minutes, if we're within 10 minutes of 8:00, we should wait and trigger at 8:00 exactly
	set {_seconds} to findSecondsUntil(7 + 0.91 + (2/300))
	if {_seconds} < 600:
		wait "%{_seconds}% seconds" parsed as timespan
		runAt6Announcement()
	
	# every day at 20:00
	# technically this could be delayed by up to 10 minutes, but since 20:00 is 12 hours after 8:00, it doesn't matter
	# just be aware that this behavior exists
	set {_seconds} to findSecondsUntil(8)
	if {_seconds} < 600:
		wait "%{_seconds}% seconds" parsed as timespan
		runAt6()

function runAt6():
	set {_x} to text from "https://time.now/developer/api/timezone/Europe/Amsterdam"
	if {_x} contains """day_of_week"":5":
		set {tygodniowyreset} to true
		add 1 to {stellarrotation}
		if {stellarrotation} = 5:
			set {stellarrotation} to 1
	set {dziennyreset} to true
	kill {leaderboard::*}
	clear {dailyResetSoon}
	restart server

function runAt6Announcement():
	set {_bot} to bot named "Earthcraft"
	set {dailyResetSoon} to true
	broadcast "&aDaily reset will happen in 5 min!"
	wait 2 minutes
	broadcast "&aDaily reset will happen in 3 min!"
	wait 2 minutes
	broadcast "&aDaily reset will happen in 1 min!"
	wait 30 seconds
	set {_s} to 30
	loop 30 times:
		if {_s} = 30, 20, 15, 10 or 5:
			broadcast "&aDaily reset will happen in %{_s}% seconds!"
			if {_s} = 5:
				make embed:
					set author of embed to "The server has stopped!"
					set embed color of the embed to red
				post last embed to channel with id "900397064251379752" using {_bot}
		else if {_s} < 5:
			broadcast "&aDaily reset will happen in %{_s}% seconds!"
		remove 1 from {_s}
		wait 1 second
	
on skript start:
	wait 2 ticks
	set {dungeons} to 0
	set {_wind} to a random integer between 1 and 100
	if {_wind} is between 1 and 10:
		set {wind} to "Howling"
	else if {_wind} is between 11 and 30:
		set {wind} to "Heavy"
	else if {_wind} is between 31 and 90:
		set {wind} to "Light"
	else:
		clear {wind}
	clear {worldTimePaused}
	execute console command "gamerule naturalRegeneration false"
	load yaml "plugins/Skript/serverstats/stats.yml" as "serverstats"
	load yaml "plugins/Skript/islandexpeditions/SoundList.yml" as "IslandsSounds"
	load yaml "plugins/Skript/islandexpeditions/AzeriteModels" as "AzeriteModels"
	load yaml "plugins/Skript/islandexpeditions/AzeriteAttributes" as "AzeriteAttributes"
	load yaml "plugins/Skript/islandexpeditions/EnemyList" as "IslandEnemyList"
	load yaml "plugins/Skript/islandexpeditions/AITeams" as "IslandAITeams"
	load yaml "plugins/Skript/lists/StatList" as "StatList"
	load yaml "plugins/Skript/lists/CardList" as "CardList"
	load yaml "plugins/Skript/lists/TalentList" as "TalentList"
	load yaml "plugins/Skript/lists/SpellList" as "SpellList"
	load yaml "plugins/Skript/lists/GearList" as "GearList"
	load yaml "plugins/Skript/lists/RuneList" as "RuneList"
	load yaml "plugins/Skript/lists/ElementList" as "ElementList"
	load yaml "plugins/Skript/lists/VariantList" as "VariantList"
	load yaml "plugins/Skript/lists/AbilityDescriptionList" as "AbilityDescriptionList"
	load yaml "plugins/Skript/lists/ArtifactList" as "ArtifactList"
	load yaml "plugins/Skript/lists/WorldQuestList" as "WorldQuestList"
	load yaml "plugins/Skript/lists/DialogueList" as "DialogueList"
	load yaml "plugins/Skript/lists/ItemList" as "ItemList"
	load yaml "plugins/Skript/lists/PrimaryStatList" as "PrimaryStatList"
	load yaml "plugins/Skript/files/ReputationRequirements" as "ReputationRequirements"
	load yaml "plugins/Skript/files/ModelHeights" as "ModelHeights"
	load yaml "plugins/Skript/lists/WorkOrderList" as "WorkOrderList"
	load yaml "plugins/Skript/lists/EnchantingProfessionList" as "EnchantingProfessionList"
	load yaml "plugins/Skript/worldquests/WorldQuestHTML" as "WorldQuestHTML"
	load yaml "plugins/Skript/azeritearmor/TraitList" as "TraitList"
	load yaml "plugins/Skript/azeritearmor/Sources" as "AzeriteArmorSources"
	load yaml "plugins/Skript/lists/DiscordList" as "DiscordList"
	load yaml "plugins/Skript/lists/StellarChestList" as "StellarChestList"
	load yaml "plugins/Skript/lists/DiamondChestList" as "DiamondChestList"
	load yaml "plugins/Skript/lists/GemList" as "GemList"
	load yaml "plugins/Skript/lists/TierSetList" as "TierSetList"
	load yaml "plugins/Skript/lists/BoosterCardList" as "BoosterCardList"
	load yaml "plugins/Skript/lists/RelicList" as "RelicList"
	load yaml "plugins/Skript/lists/AchievementList" as "AchievementList"
	load yaml "plugins/Skript/lists/PromoCardList" as "PromoCardList"
	if {dziennyreset} is true:
		set {dziennyreset} to false
		if {dailyRewardResetId} is not set:
			set {dailyRewardResetId} to 1
		set {dailyRewardResetId} to {dailyRewardResetId} + 1
		send "Dzienny reset nastąpił!" to console
		set {_data} to data()
		log "%{_data}% Dzienny reset nastąpił!" to "logi/serwer.log"
		if {tygodniowyreset} is not true:
			resetMessage("daily")

		loop all offline players:
			set {dziennylimit::stardust::%loop-offline player%} to {poziom::%loop-offline player%}
			clear {dailyrewardreminderhidden::%loop-offline player%}
			clear {dailyrewardreminderloop::%loop-offline player%}
			if {dailyready::%loop-offline player%} = true:
				set {dailystreak::%loop-offline player%} to 0
			set {dailyready::%loop-offline player%} to true
			set {dresetwiad::%loop-offline player%} to true

		execute console command "noinvincibility on"
		Leaderboard(1, "mobskilled")
		set {_day} to text from "https://current-time-api.vercel.app/api/current-date" parsed as number
		set {_month} to (text from "https://current-time-api.vercel.app/api/current-month" parsed as number) + 1
		set {_year} to text from "https://current-time-api.vercel.app/api/current-year" parsed as number
		set {_n1} to floor(275 * {_month} / 9)
		set {_n2} to floor(({_month} + 9) / 12)
		set {_n3} to (1 + floor(({_year} - 4 * floor({_year} / 4) + 2) / 3))
		set {_dayoftheyear} to {_n1} - ({_n2} * {_n3}) + {_day} - 30

		loop all offline players:
			if {dataurodzin::%loop-offline player%} is set:
				set {_data::*} to {dataurodzin::%loop-offline player%} split at "."
				set {_data::1} to {_data::1} parsed as number
				set {_data::2} to {_data::2} parsed as number
				set {_data::3} to {_data::3} parsed as number
				set {_n1} to floor(275 * {_data::2} / 9)
				set {_n2} to floor(({_data::2} + 9) / 12)
				set {_n3} to (1 + floor(({_data::3} - 4 * floor({_data::3} / 4) + 2) / 3))
				set {_dayoftheyearplayer} to {_n1} - ({_n2} * {_n3}) + {_data::1} - 30
				if {_dayoftheyearplayer} = {_dayoftheyear}:
					set {urodzinydzien::%loop-offline player%} to true
					if {jezyk::%loop-offline player%} = "English":
						execute console command "/reward set 3 %loop-offline player% Birthday {odlamekgwiazdyEN}"
					else:
						execute console command "/reward set 3 %loop-offline player% Urodziny {odlamekgwiazdy}"
				else:
					if {urodzinydzien::%loop-offline player%} is set:
						clear {urodzinydzien::%loop-offline player%}

	if {tygodniowyreset} != true:
		clear {doubleXPFriday}
		loop {activeWorldQuests::*}:
			set {_WQLocations::*} to WorldQuestRegionSpawn(loop-value)
        
			set {_WQLocation} to {_WQLocations::1}
			set {_WQLocationMin} to {_WQLocations::2}
			set {_WQLocationMax} to {_WQLocations::3}

			set {_plugin} to instance of plugin "Skript"

			loop all chunks within {_WQLocationMin} and {_WQLocationMax}:
				set {_chunk} to loop-chunk
				set {_chunkLoc} to block at 0,0,0 in {_chunk}
				{_chunk}.addPluginChunkTicket({_plugin})
				set {_chunk} to {_chunk}.getWorld().getChunkAtAsync({_chunkLoc})
				set {_actualChunk} to {_chunk}.join()
				wait 1 tick if loop-counter-2 is divisible by 20

			WorldQuestSpawn(loop-value)
	else:
		set {tygodniowyreset} to false
		send "Tygodniowy reset nastąpił!" to console
		set {doubleXPFriday} to true
		set {_data} to data()
		log "%{_data}% Tygodniowy reset nastąpił!" to "logi/serwer.log"
		resetMessage("weekly")

		NewWorldQuests()
		
		loop all offline players:
			set {tresetwiad::%loop-offline player%} to true
			clear {zlecenia::%loop-offline player%::*}
			clear {vaultnagroda::%loop-offline player%}
		set {_datatydz::*} to {_data} split at " "
		set {_datatydzien} to {_datatydz::2}
		set {_char1} to char at 0 in {_datatydzien}
		set {_char2} to char at 1 in {_datatydzien}
		set {_day} to text from "https://current-time-api.vercel.app/api/current-date" parsed as number
		set {_month} to (text from "https://current-time-api.vercel.app/api/current-month" parsed as number) + 1
		add 7 to {_day}
		if {_month} is 2 or 4 or 6 or 9 or 11:
			if {_day} > 30:
				set {_day} to {_day}-30
		else:
			if {_day} > 31:
				set {_day} to {_day}-31
		set {datatydzien} to {_datatydzien}
		set {_datadzien::*} to {_datatydzien} split at "."
		set {_datadzien::1} to {_day}
		set {_datadzien} to join {_datadzien::*} with "."
		set {datatydzien2} to "%{_day}%.%{_datadzien}%"

		set {_cards::*} to yaml list "Weekly Rotation.Cards" in "StellarChestList"
		set {_index} to yaml value "Weekly Rotation.Current Index" in "StellarChestList"
		if {_index} is not set:
			set {_index} to 1
		set {_index} to {_index} + 1
		if {_index} > size of {_cards::*}:
			set {_index} to 1
		set yaml value "Weekly Rotation.Current Index" in "StellarChestList" to {_index}

		set {_cycle} to yaml value "Settings.Cycle" in "StellarChestList"
		if {_cycle} is not set:
			set {_cycle} to 1
		set {_cycle} to {_cycle} + 1
		set yaml value "Settings.Cycle" in "StellarChestList" to {_cycle}

		save yaml "StellarChestList"

	UpdateTopDungeons({topKeystones::1}, {topKeystonesPath::1}, "top")
	UpdateTopDungeons({mostRecentKeystone}, {mostRecentKeystonePath}, "recent")
	clear {dmgdealt::*}
	clear {dailyResetSoon}
	
			
on skript stop:
	clear {discordCodes::*}
	clear {dailyResetSoon}
	set {expAreaMayanMobs} to 0
	clear {expAreaMayan}
	set {expAreaIceMobs} to 0
	clear {expAreaIce}
	clear {allowChangeConditions::*}
	loop all offline players where [metadata value "dungeon" of input is set]:
		DungeonLeave(loop-offline player)
	loop all players where [metadata value "dungeon" of input is set]:
		DungeonLeave(loop-player)
	load yaml "plugins/Skript/dungeonconfig/KeystoneHolderIDs.yml" as "keystoneIds"
	set {_size} to yaml value "IDs Registered" in "keystoneIds"
	loop {_size} times:
		clear {KeystoneHolderLoc%loop-number%}
		clear {dungeonInstance%loop-number%::*}
		clear {DungeonTimer%loop-number%}
		clear {DungeonTimerLimit%loop-number%}
		clear {deaths%loop-number%}
		clear {dungeonBosses%loop-number%}
	unload yaml "keystoneIds"
	DungeonStatsFileAverageUpdate()
	loop all entities where [input's world = "groveofimmemorialruins"]:
		if loop-entity is not a player:
			kill loop-entity
	loop all entities where [input's world = "arcticbattlefield"]:
		if loop-entity is not a player:
			kill loop-entity
	loop all entities where [boolean tag "RemoveOnReset" of custom nbt of input is true]:
		kill loop-entity
	clear {lingeringInsanityHaste::*}
	clear {hasteVoidform::*}
	delete all yaml from directory "plugins/Skript/scripts/combat/Shields"
	delete all yaml from directory "plugins/Skript/scripts/combat/Buffs"
	clear {azeriteRequired::*}
	clear {azeriteCollectedAlly::*}
	clear {azeriteCollectedEnemy::*}
	
	load yaml "plugins/Skript/islandexpeditions/IslandList" as "IslandsClear"
	set {_islandList::*} to yaml list "Islands" in "IslandsClear"
	unload yaml "IslandsClear"
	loop {_islandList::*}:  
		loop all worlds where ["%input%" contains "%loop-value%"]:
			if "%loop-value-2%" != "%loop-value-1%":
				deleteIslandExpeditionWorld("%loop-value-2%")
	#wait 2 ticks
	#loop {leaderboard::*}:
	#	kill loop-value
	#	clear {leaderboard::*}
	#loop {standard::*}:
	#	kill loop-value
	#clear {standard::*}

on join:
	if player is invulnerable:
		make player vulnerable
	set long tag "ECMovementSpeed" of nbt of player to player's walking speed
	set {_month} to getDayMonth("month")
	if player is not whitelisted:
		set {_data} to data()
		log "%{_data}% | %player% joined the server." to "logi/login-nonwhitelisted.log"
	if {event} = "Winter Delight":
		set {_winter::*} to 12, 1, 2
		if {_winter::*} contains {_month}:
			if amount of online players = 1:
				SnowfallOnSpawn()
			if {_month} = 12:
				AkasakaArthurSnowFight()
				playerGiftYaml(player)
				WinterDelightDisguiseUpdate()
				newGiftSpawn()
	clear {chatbubbles::%player%::*}
	set {_prompt} to "Download this pack for additional server features."
	send resource pack from url "http://raw.githubusercontent.com/kapoonfleek/ecresourcepack/8.3.0/release.zip" with uuid (random uuid) with prompt {_prompt} to player
	if online player count = 1:
		chamberOfHeartAmbience()
		diamondChestAnimate()
		dailyRewardAnimate()
		loop {stellarChests::*}:
			stellarChestAnimate(loop-value)
	if {kartaname::%player%} = "Umbreon":
		if boolean tag "Constellation;Featherfoot" of (custom nbt of {karta::%player%}) is set:
			if (time in world "world") is between 10:00 PM and 4:00 AM:
				set metadata value "UmbreonFeatherfoot" of player to 150
			else:
				set metadata value "UmbreonFeatherfoot" of player to 100
	wait 2 seconds
	execute console command "noinvincibility on"
	notifyPlayerDailyReward(player)
	if {dresetwiad::%player%} = true:
		if {event} = "Winter Delight":
			winterDelightRandomizeMissions(player)
		set {dresetwiad::%player%} to false
		wait 1.5 seconds
		send "&a=== Daily reset ===" to player
		send "&aYour daily <##6518ba>S<##942cce>t<##a925d9>a<##f346d1>r<##f37646>d<##f38646>u<##f18d18>s<##f3d846>t &alimit has reset!" to player
		send "&aYour Daily Reward has reset!" to player
		send "&aNew Work Orders are available!" to player
	if {tresetwiad::%player%} = true:
		set {tresetwiad::%player%} to false
		wait 1.5 seconds
		set {_x} to text from "https://time.now/developer/api/timezone/Europe/Amsterdam"
		send "&d=== Weekly reset ===" to player
		send "&dWeekly rewards are awaiting you in The Grand Vault!" to player
		send "&dWorld Quests have been refreshed!" to player
		send "&dCard rotation in the Stellar Chest has changed!" to player
		send "&dA new weekly Azerite for Earthcraft quest is available!" to player
		if {_x} contains """day_of_week"":5":
			send "&dBenefit from a Double EXP day today!" to player
			doubleExpDayReminder(player)

on pickup:
	if boolean tag "CantDespawn" of custom nbt of event-dropped item is set:
		cancel event
on item despawn:
	if boolean tag "CantDespawn" of custom nbt of event-dropped item is set:
		cancel event

function notifyPlayerDailyReward(p: player):
	if {dailyrewardreminderloop::%{_p}%} is true:
		stop
	set {dailyrewardreminderloop::%{_p}%} to true
	while true:
		wait 15 minutes
		if {dailyready::%{_p}%} = false:
			stop loop
		if {_p} is not online:
			stop loop
		if {dailyrewardreminderhidden::%{_p}%} is true:
			stop loop
		send formatted "Reminder: &4(&c&l&o!&4&o) &cYou have not yet claimed your daily reward. You can visit the &lspawn centre &cto do so. <command:/dailyrewardreminder hide><tooltip:&fHides the daily reward reminder for today.>&4(Click here to hide this message)" to {_p}
		set {_pitch} to 1
		loop 3 times:
			play sound "block.note_block.cow_bell" with volume 3 and pitch {_pitch} to {_p}
			play sound "block.note_block.basedrum" with volume 3 and pitch {_pitch} to {_p}
			play sound "block.note_block.didgeridoo" with volume 3 and pitch {_pitch} to {_p}
			add 0.334 to {_pitch}
			wait 2 ticks
	clear {dailyrewardreminderloop::%{_p}%}
		

function doubleExpDayReminder(p: player):
	wait 6 seconds
	set {_dexp} to mini message from "<gradient:##daa3ff:##ff42fc>Double Exp Friday:"
	set {_d2} to mini message from "<gradient:##daa3ff:##ff42fc>Double EXP Day"
	send "&5(&d&l🫧&5) %{_dexp}% &fToday marks a %{_d2}%&f! Enjoy double player EXP from all sources!" to {_p}
	play sound "entity.player.levelup" with volume 2 and pitch 0.6 to {_p}