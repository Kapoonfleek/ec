				set {cytryn::%player%} to {cytryn::%player%} + 1
				set {wykopanekamieniesz::%player%} to {wykopanekamieniesz::%player%} + 1
				set {_yamlValue} to "Achievement.Mining.Gemstones.100"
				achievementYaml({_p}, "Mining", "Gemstones+100", {wykopanekamieniesz::%player%})
				set {_yamlValue} to "Achievement.Mining.Gemstones.1000"
				achievementYaml({_p}, "Mining", "Gemstones+1000", {wykopanekamieniesz::%player%})
				add 8 to {_otxp}
			set {_otxpAfterMultiplier} to addPlayerXP(player, {_otxp}, 1, "mining")
			add {_otxpAfterMultiplier} to {expkopanie::%player%}
			addMiningXP(player, {_otxpAfterMultiplier})
			if {_otxpAfterMultiplier} > {_otxp}:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP) (&fx%{_otxpAfterMultiplier}/{_otxp}%&7)"
			else:
				set {_xpmsg} to "&7(+%{_otxpAfterMultiplier}% &7XP)"
			if {_x} > 1:
				set {_d} to "y"
			else:
				set {_d} to ""
			send "&8[&6Earthcraft&8] &7Congratulations! You found &6%{_x}% <##ff7926>Citrines&7! %{_xpmsg}%" to player
			wait 5 ticks
			loop 2 times:
				play sound "block.glass.break" with volume 1 and pitch 2 to player
				wait 5 ticks
