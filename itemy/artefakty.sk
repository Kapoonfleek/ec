function ArtifactSetStats(i: item, eledmg: text, critdmg: number, seconmin: integer, seconmax: integer, heal: number) :: item:
	if {_heal} is not 0:
		set line 3 of lore of {_i} to RelicMainStat("%{_eledmg}%", {_critdmg}, {_heal})
	else:
		set line 3 of lore of {_i} to RelicMainStat("%{_eledmg}%", {_critdmg}, 0)
	set {_secondaries::*} to RelicSecondaries({_seconmin}, {_seconmax})
	set line 4 of lore of {_i} to {_secondaries::1}
	set line 5 of lore of {_i} to {_secondaries::2}
	set line 6 of lore of {_i} to {_secondaries::3}
	return {_i}


function getArtifactDescription(artifactSet: text) :: text:
	set {_description} to yaml value "Artifacts.%{_artifactSet}%.Description" in "ArtifactList"
	set {_valueNames::*} to yaml node keys "Values.%{_artifactSet}%" in "ArtifactList"
	loop {_valueNames::*}:
		set {_value} to yaml value "Values.%{_artifactSet}%.%loop-value%" in "ArtifactList"
		replace all "{%loop-value%}" in {_description} with "%{_value}%"
	return {_description}

function getArtifactIcon(artifactSet: text) :: text:
	set {_icon} to yaml value "Artifact.%{_artifactSet}%.Icon" in "ArtifactList"
	return {_icon}

function getArtifactPieces(artifactSet: text) :: texts:
	set {_pieces::*} to yaml value "Artifact.%{_artifactSet}%.Items" in "ArtifactList"
	return {_pieces::*}

function getArtifactType(artifactSet: text, artifactPiece: text) :: texts:
	set {_type} to yaml value "Artifact Pieces.%{_artifactSet}%.%{_artifactPiece}%.Type" in "ArtifactList"
	return {_type}

function getArtifactSetsEquipped(p: player, yamlOrNBT: text) :: strings:
	if yaml "activeCard-%{_p}%" is loaded:
		set {_id} to yaml value "Card.Id" in "activeCard-%{_p}%"

		if {_yamlOrNBT} = "NBT":
			set {_artifactSetsTag} to compound tag "Artifact Sets" of custom nbt of {karta::%{_p}%}
			set {_artifactSets::*} to nbt tags of {_artifactSetsTag}
		else:
			set {_artifactSets::*} to yaml node keys "Card.Artifact Sets" in "activeCard-%{_p}%"

	return {_artifactSets::*}

function getArtifactSetsCompletion(p: player, artifactSets: strings, yamlOrNBT: text) :: integers:
	if yaml "activeCard-%{_p}%" is loaded:
		set {_id} to yaml value "Card.Id" in "activeCard-%{_p}%"

		loop {_artifactSets::*}:
			if {_yamlOrNBT} = "NBT":
				add int tag "Artifact Sets;%loop-value%" of custom nbt of {karta::%{_p}%} to {_piecesCompleted::*}
			else:
				add yaml value "Card.Artifact Sets.%loop-value%" in "activeCard-%{_p}%" to {_piecesCompleted::*}

	return {_piecesCompleted::*}

function getArtifactString(p: player, yamlOrNBT: text) :: strings:
	set {_artifactSets::*} to getArtifactSetsEquipped({_p}, {_yamlOrNBT})

	if {_artifactSets::*} is set:
		set {_piecesCompleted::*} to getArtifactSetsCompletion({_p}, {_artifactSets::*}, {_yamlOrNBT})
		
		loop {_artifactSets::*}:
			set {_icon} to yaml value "Artifacts.%loop-value%.Icon" in "ArtifactList"
			set {_abbreviation} to yaml value "Artifacts.%loop-value%.Abbreviation" in "ArtifactList"
			set {_pieces} to {_piecesCompleted::%loop-counter%}

			set {_joinBy} to " &7| "

			if loop-counter > 0:
				if loop-counter is divisible by 2:
					set {_joinBy} to "{NEXTLINE}"
				else if loop-counter = (size of {_artifactSets::*}):
					set {_joinBy} to ""

			add "&f%{_icon}% %{_abbreviation}%: %{_pieces}%-set%{_joinBy}%" to {_setsEquipped::*}

		set {_setsEquipped::*} to (join {_setsEquipped::*} by "") split at "{NEXTLINE}"

	else:
		set {_setsEquipped::*} to " "

	return {_setsEquipped::*}

function getArtifactSetCount(p: player, setName: string, setCompleteCount: integer, yamlOrNBT: text = "NBT") :: boolean:
	if {_yamlOrNBT} = "NBT":
		if int tag "Artifact Sets;%{_setName}%" of custom nbt of {karta::%{_p}%} >= {_setCompleteCount}:
			set {_bool} to true
	else:
		if yaml "activeCard-%{_p}%" is loaded:
			if yaml value "Card.Artifact Sets.%{_setName}%" in "activeCard-%{_p}%" >= {_setCompleteCount}:
				set {_bool} to true
				
	return {_bool}

function ArcaneMysteries4Set(p: player):
	set metadata value "ArcaneMysteries" of {_p} to 0
	set {_interval} to yaml value "Values.Arcane Mysteries.4SETINTERVAL" in "ArtifactList"
	set {_interval} to ("%{_interval}% seconds" parsed as timespan)

	set metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} to {_interval}
	set {_durationPersist} to yaml value "Values.Arcane Mysteries.4SETDURATIONPERSIST" in "ArtifactList"
	set {_declineRate} to yaml value "Values.Arcane Mysteries.4SETDECLINERATE" in "ArtifactList"

	set {_durationPersist} to ("%{_durationPersist}% seconds" parsed as timespan)
	set {_declineRate} to ("%{_declineRate}% seconds" parsed as timespan)

	set {_buffIncrease} to yaml value "Values.Arcane Mysteries.4SETBONUS" in "ArtifactList"
	set {_buffMax} to yaml value "Values.Arcane Mysteries.4SETPEAK" in "ArtifactList"

	set {_element} to string tag "ECElement" of custom nbt of {_p}
	if ("Magic", "Ghost", "Dark") does not contain {_element}:
		set {_buffIncrease} to {_buffIncrease}/2
		set {_buffMax} to {_buffMax}/2

	while metadata value "ECEngaged" of {_p} is set:
		while metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} > 0 seconds:
			set {_duration} to durationShort("%metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}%")
			buffRegister({_p}, "Ams", 1, "", "Value", "&f%metadata value "ArcaneMysteries" of {_p}%%% &7| &f%{_duration}%", "-")
			wait 1 second
			remove 1 second from metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}
			stop if metadata value "ECEngaged" of {_p} is not set
		add {_buffIncrease} to metadata value "ArcaneMysteries" of {_p}

		if metadata value "ArcaneMysteries" of {_p} >= {_buffMax}:
			set metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} to {_durationPersist}
			
			while metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} > 0 seconds:
				set {_duration} to durationShort("%metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}%")
				buffRegister({_p}, "Ams", 1, "", "Value", "&f%metadata value "ArcaneMysteries" of {_p}%%% &7| &f%{_duration}%", "-")
				wait 1 second
				remove 1 second from metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}
				stop if metadata value "ECEngaged" of {_p} is not set
			set metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} to {_declineRate}

			while metadata value "ArcaneMysteries" of {_p} > 0:
				while metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} > 0 seconds:
					set {_duration} to durationShort("%metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}%")
					buffRegister({_p}, "Ams", 1, "", "Value", "&f%metadata value "ArcaneMysteries" of {_p}%%% &7| &f%{_duration}%", "-")
					wait 1 second
					remove 1 second from metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}
					stop if metadata value "ECEngaged" of {_p} is not set
				set metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} to {_declineRate}

				remove 1 from metadata value "ArcaneMysteries" of {_p}
				set {_duration} to durationShort("%metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}%")
				buffRegister({_p}, "Ams", 1, "", "Value", "&f%metadata value "ArcaneMysteries" of {_p}%%% &7| &f%{_duration}%", "-")
		else:
			set metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p} to {_interval}

	clear metadata value "ArcaneMysteries" of {_p}
	clear metadata value "ArcaneMysteriesCurrentBonusDuration" of {_p}
	buffClear({_p}, "Ams")

function Scorched4Set(p: player):
	set {_duration} to yaml value "Values.Scorched.4SETDURATION" in "ArtifactList"
	set {_duration} to "%{_duration}% seconds" parsed as timespan

	if metadata value "ScorchedSet4SetBonus" of {_p} is not set:
		set metadata value "ScorchedSet4SetBonus" of {_p} to {_duration}
		while metadata value "ScorchedSet4SetBonus" of {_p} > 0 seconds:
			wait 1 second
			remove 1 second from metadata value "ScorchedSet4SetBonus" of {_p}
		clear metadata value "ScorchedSet4SetBonus" of {_p}
	else:
		set metadata value "ScorchedSet4SetBonus" of {_p} to {_duration} 
	