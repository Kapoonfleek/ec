import:
	kr.toxicity.model.api.BetterModel
	kr.toxicity.model.api.tracker.EntityTrackerRegistry
	kr.toxicity.model.api.tracker.Tracker
	kr.toxicity.model.api.tracker.TrackerModifier
	java.lang.System



function IcicleForm(p: player, icicle: integer):
	if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is set:
		set {_max} to 7
	else:
		set {_max} to 5
	if {_icicle} - {_max} > 0:
		set {_icicle} to {_max}

	spawn 1 armor stand at {_p}
	set boolean tag "Invisible" of nbt of last spawned armor stand to true
	set boolean tag "RemoveOnReset" of custom nbt of last spawned armor stand to true
	set {_icicleModel} to last spawned armor stand
	IcicleAssignments({_icicleModel})
	
	if string tag "Talents;Row 3" of (custom nbt of {karta::%{_p}%}) = "Black Ice":
		chance of 30%:
			set boolean tag "BlackIce" of custom nbt of {_icicleModel} to true
			set {_modelName} to "icicle_blackfrost"

	if {_modelName} is not set:
		set {_modelName} to "icicle"
	
	modelApply({_icicleModel}, {_modelName}, 1.0)

	if {icicle%{_icicle}%::%{_p}%} is not set:
		set {icicle%{_icicle}%::%{_p}%} to {_icicleModel}
		StartIcicleMasterLoop({_p})

function IcicleHurl(p: player, icicle: entity, target: entity, rgb: color):
	set {_l} to location of {_icicle}
	set {_yaw} to yaw of {_p}
	set {_pitch} to pitch of {_p}
	set yaw of {_l} to {_yaw}
	set pitch of {_l} to {_pitch}
	set {_targetLoc} to location 0.5 below {_target}
	loop round(distance between {_l} and {_targetLoc}) / 1 times:
		set {_targetLoc} to location 0.5 below {_target}
		set {_vec} to vector between {_l} and {_targetLoc}
		set vector length of {_vec} to loop-value * 2
		teleport {_icicle} to {_l} ~ {_vec}
		set {_icicleLoc} to location of {_icicle}
		increase y-coordinate of {_icicleLoc} by 2 
		draw 1 of ({_rgb} dust particle of size 1) at {_icicleLoc}
		wait 1 tick
	kill {_icicle}

function StartIcicleMasterLoop(p: player):
	if metadata value "IcicleLoopRunning" of {_p} is not set:
		set metadata value "IcicleLoopRunning" of {_p} to true
		while metadata value "IcicleLoopRunning" of {_p} is true:
			if {_p} is not online:
				stop loop
			if {icicles::%{_p}%} <= 0:
				clear metadata value "IcicleLoopRunning" of {_p}
				stop loop
			set {_max} to 5
			if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is set:
				set {_max} to 7
			loop {icicles::%{_p}%} times:
				set {_num} to loop-number
				set {_x} to {icicle%{_num}%::%{_p}%}
				if {_x} is set:
					if {_x} is alive:
						set {_loc} to {_p}'s location
						increase {_loc}'s y-coordinate by 1.75
						if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is not set:
							if {_p}'s horizontal facing is west:
								increase {_loc}'s z-coordinate by (-0.5 + 0.3 * {_num})
							else if {_p}'s horizontal facing is south:
								increase {_loc}'s x-coordinate by (-0.5 + 0.3 * {_num})
							else if {_p}'s horizontal facing is east:
								increase {_loc}'s z-coordinate by (0.5 - 0.3 * {_num})
							else if {_p}'s horizontal facing is north:
								increase {_loc}'s x-coordinate by (0.5 - 0.3 * {_num})
							if 3 >= {_num}:
								increase {_loc}'s y-coordinate by -0.3 + (0.1 * {_num})
							else:
								increase {_loc}'s y-coordinate by (-0.1 * {_num}) + 0.3
						else:
							if {_p}'s horizontal facing is west:
								increase {_loc}'s z-coordinate by (-0.8 + 0.3 * {_num})
							else if {_p}'s horizontal facing is south:
								increase {_loc}'s x-coordinate by (-0.8 + 0.3 * {_num})
							else if {_p}'s horizontal facing is east:
								increase {_loc}'s z-coordinate by (0.8 - 0.3 * {_num})
							else if {_p}'s horizontal facing is north:
								increase {_loc}'s x-coordinate by (0.8 - 0.3 * {_num})
							if 4 >= {_num}:
								increase {_loc}'s y-coordinate by (0.1 * {_num})
							else:
								increase {_loc}'s y-coordinate by (-0.1 * {_num}) + 0.8
						teleport {_x} to {_loc}
						set {_x}'s yaw to {_p}'s yaw
						set {_x}'s pitch to {_p}'s pitch
			wait 1 tick
function frostboltSound(p: player):
	play sound "skill.glaceon.frostbolt_cast" with volume 2 and pitch 1 to {_p}
function frostboltHitSound(p: location):
	play sound "skill.glaceon.frostbolt_impact" with volume 3 and pitch 1 at location of {_p}
function frostbolthurlSound(p: location):
	play sound "skill.glaceon.frostbolt_hurl" with volume 3 and pitch 1 at location of {_p}
function icelanceHitSound(p: location):
	play sound "skill.glaceon.icelance_impact" with volume 3 and pitch 1 at location of {_p}
function icelancehurlSound(p: location):
	play sound "skill.glaceon.icelance_hurl" with volume 3 and pitch 1 at location of {_p}

function IcicleFormIcicleStorm(p: player, icicle: integer, blackIce: boolean = false) :: entity:
	set {_loc} to {_p}'s location
	increase {_loc}'s y-coordinate by 1.75
	if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%{_p}%}) is not set:
		#Horizontal
		if {_p}'s horizontal facing is west:
			increase {_loc}'s z-coordinate by (-0.5 + 0.3*{_icicle})
		else if {_p}'s horizontal facing is south:
			increase {_loc}'s x-coordinate by (-0.5 + 0.3*{_icicle})

		else if {_p}'s horizontal facing is east:
			increase {_loc}'s z-coordinate by (0.5 - 0.3*{_icicle})
		else if {_p}'s horizontal facing is north:
			increase {_loc}'s x-coordinate by (0.5 - 0.3*{_icicle})
		
		#Vertical
		if 3 >= {_icicle}:
			increase {_loc}'s y-coordinate by -0.3 + (0.1*{_icicle})
		else:
			increase {_loc}'s y-coordinate by (-0.1*{_icicle}) + 0.3

	else:
		#Horizontal
		if {_p}'s horizontal facing is west:
			increase {_loc}'s z-coordinate by (-0.8 + 0.3*{_icicle})
		else if {_p}'s horizontal facing is south:
			increase {_loc}'s x-coordinate by (-0.8 + 0.3*{_icicle})

		else if {_p}'s horizontal facing is east:
			increase {_loc}'s z-coordinate by (0.8 - 0.3*{_icicle})
		else if {_p}'s horizontal facing is north:
			increase {_loc}'s x-coordinate by (0.8 - 0.3*{_icicle})
		
		#Vertical
		if 4 >= {_icicle}:
			increase {_loc}'s y-coordinate by (0.1*{_icicle})
		else:
			increase {_loc}'s y-coordinate by (-0.1*{_icicle}) + 0.8

	if {_blackIce} = true:
		set {_modelName} to "icicle_blackfrost"
	else:
		set {_modelName} to "icicle"

	spawn 1 armor stand at {_loc}
	set {_icicleModel} to last spawned armor stand
	set boolean tag "Invisible" of nbt of last spawned armor stand to true
	IcicleAssignments({_icicleModel})

	modelApply({_icicleModel}, {_modelName}, 1.0)

	return {_icicleModel}

function GlacialSpike(p: player) :: entity:
	set {_loc} to {_p}'s location
	increase {_loc}'s y-coordinate by 1/2

	spawn 1 armor stand at location 1 above {_p}
	set {_glacialSpikeModel} to last spawned armor stand
	set boolean tag "Invisible" of nbt of last spawned armor stand to true
	IcicleAssignments({_glacialSpikeModel})

	modelApply({_icicleModel}, {_modelName}, 3.0)

	return {_glacialSpikeModel}

function IcicleAssignments(e: entity):
	set boolean tag "Marker" of nbt of {_e} to true
	set boolean tag "NoGravity" of nbt of {_e} to true
	set boolean tag "Invulnerable" of nbt of {_e} to true
	set boolean tag "Silent" of nbt of {_e} to true
	set boolean tag "Invisible" of nbt of {_e} to false

function GlacialSpikeMove(p: player, x: entity):
	while metadata value "GlacialSpike" of {_p} is set:
		if {_x} is alive:
			if {_p} is alive:
				if {_p} is not offline:
					set {_loc} to location 1 in front of {_p}
					set {_loc} to location 1.25 left of {_loc}
					increase {_loc}'s y-coordinate by 1.2
					set {_x}'s yaw to {_p}'s yaw
					set {_x}'s pitch to {_p}'s pitch
					teleport {_x} to {_loc}
		wait 2 ticks

function GlacialSpikeHurl(p: player, glacialspike: entity, target: entity):
	set {_l} to location of {_glacialspike}
	set {_yaw} to yaw of {_p}
	set {_pitch} to pitch of {_p}
	set yaw of {_l} to {_yaw}
	set pitch of {_l} to {_pitch}
	set {_targetLoc} to location 0.5 below {_target}
	loop round(distance between {_l} and {_targetLoc}) / 1 times:
		set {_targetLoc} to location 0.5 below {_target}
		set {_vec} to vector between {_l} and {_targetLoc}
		set vector length of {_vec} to loop-value * 2
		teleport {_glacialspike} to {_l} ~ {_vec}
		set {_glacialspikeLoc} to location of {_glacialspike}
		increase y-coordinate of {_glacialspikeLoc} by 2 
		draw 1 of ({_rgb} dust particle of size 1) at {_glacialspikeLoc}
		wait 1 tick
	kill {_glacialspike}

variables:
	{chainreaction::%player%} = 0

function stopSoundGlaceon(p: player):
	stop sound "skill.glaceon.frostbolt_cast" for {_p}
	stop sound "skill.glaceon.flurry_cast" for {_p}

on rightclick:
	if boolean tag "Ice Lance" of (custom nbt of player's tool) is set:
		cancel event
		if {kartaname::%player%} = "Glaceon":
			if CanUseAbility(player) != false:
				set {_target} to Target(player, 100, false)
				if {_target} is set:
					if metadata value "cast" of player is not set:
						set {_crit} to 25 + ({criticalhit::%player%}/10)
						set {_cd} to 1.5
						set {_pospiech} to Haste(player)
						set {_baseHeal} to AbilityUpgradeValue(player, "Glaceon", "Icicles", "BASEDAMAGE")
						set {_scaling} to AbilityUpgradeValue(player, "Glaceon", "Icicles", "DAMAGESCALING")
						set {_damageicicles} to ({_baseHeal} + ({damage::%player%}/75) + ({versatility::%player%}/225) + ({primarystat::%player%}/{_scaling})) * (1 + ({mastery::%player%}/3.75/100))
						set {_rune} to getRunePower(player, "Glacial Wrath")
						set {_damageicicles} to {_damageicicles} * (1 + {_rune} * {icicles::%player%}/100)
						set {_flashFreezeDmg} to offensiveTrait(player, "Glaceon", "Flash Freeze")
						set {_damageicicles} to {_damageicicles} + {_flashFreezeDmg}

						set {_cd} to {_cd}/{_pospiech}
						set {_baseDamage} to AbilityUpgradeValue(player, "Glaceon", "Ice Lance", "BASEDAMAGE")
						set {_damageScaling} to AbilityUpgradeValue(player, "Glaceon", "Ice Lance", "DAMAGESCALING")
						set {_damage} to {_baseDamage} + {damage::%player%}/34 + {versatility::%player%}/102 + {primarystat::%player%}/{_damageScaling}
						set {_whiteoutDmg} to offensiveTrait(player, "Glaceon", "Whiteout")
						set {_damage} to {_damage} + {_whiteoutDmg}
						if getTrait(player, "Whiteout") is set:
							remove 0.5 seconds from cooldown "Icy Veins%player%" 

						if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Lonely Winter":
							set {_damage} to {_damage}*1.25

						if boolean tag "Constellation;Frigid Winds" of (custom nbt of {karta::%player%}) is set:
							set {_damage} to {_damage} * (1 + (({crowdcontrol::%player%}*0.3)/100))

						if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Chilled to the Core":
							if metadata value "Icy Veins" of player is true:
								set {_damage} to {_damage}*1.2
								set {_damageicicles} to {_damageicicles}*1.2

						if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Splitting Ice":
							set {_damage} to {_damage}*1.05
							set {_damageicicles} to {_damageicicles}*1.05

						if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%player%}) is set:
							set {_iciclesCap} to 7
							set {_damageicicles} to {_damageicicles}*1.2
						else:
							set {_iciclesCap} to 5

						set {_loreicicles} to "&7Użycie <##4bbfe2>Frostbolt &7przyzna ci <##4bbfe2>Sopelek&7. Użycie%nl%&7<##4bbfe2>Lodowej Lancy &7wystrzeli wszystkie przechowane%nl%<##4bbfe2>Sopelki &7w cel, każdy zadając &f%{_damageicicles}% &7obrażeń <##add8e6>Lodu&7.%nl% %nl%&7Maksymalnie %{_iciclesCap}% <##4bbfe2>Sopelków &7może być przechowane,%nl%&7a każdy wygenerowany <##4bbfe2>Sopelek &7w nadmiarze%nl%&7zostanie natychmiastowo wystrzelony."
						set {_lore} to "&8Umiejętność%nl%&fNatychmiastowy cast%nl%&7Globalny Cooldown: &f%{_cd}% sekund%nl%&7Użycie: &fPPM%nl%<##4bbfe2>Strzela lodową lancą w cel, zadając &f%{_damage}% <##4bbfe2>obrażeń <##add8e6>Lodu<##4bbfe2>.%nl%<##4bbfe2>Lodowa Lanca zadaje podwójne obrażenia%nl%<##4bbfe2>zamrożonym celom, oraz włącza &f%{_cd}% sekundowy%nl%<##4bbfe2>cooldown dla wszystkich zaklęć, gdy zostanie%nl%<##4bbfe2>użyta bez aktywnych <##aedafc>Palców Mrozu<##4bbfe2>."

						if cooldown "Ice Lance%player%" is finished:								
							AbilityUse(player, "Ice Lance")

							if metadata value "Fingers of Frost" of player = 0:
								set cooldown "Ice Lance%player%" to "%{_cd}% seconds" parsed as timespan
								set cooldown "Frostbolt%player%" to "%{_cd}% seconds" parsed as timespan
								set cooldown "Flurry%player%" to "%{_cd}% seconds" parsed as timespan
								set cooldown "Glacial Spike%player%" to "%{_cd}% seconds" parsed as timespan
								set the cooldown of player's tool for player to "%{_cd}% seconds" parsed as timespan

							if metadata value "ExtraSecondsIcyVeins" of player is not set:
								set metadata value "ExtraSecondsIcyVeins" of player to 0 seconds

							if metadata value "Fingers of Frost" of player > 0:
								remove 1 from metadata value "Fingers of Frost" of player
								if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Thermal Void":
									if metadata value "Icy Veins" of player is true:
										set metadata value "ExtraSecondsIcyVeins" of player to metadata value "ExtraSecondsIcyVeins" of player + 1 second

								if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Chain Reaction":
									set {_chainbuff} to 0.02*{chainreaction::%player%}
								if {chainreaction::%player%} < 5:
									set {chainreaction::%player%} to {chainreaction::%player%} + 1
								if {_chainbuff} is set:
									#3% chain reaction -> set {_damage} to ({_damage}*(1+(({_chainbuff}/100)*{chainreaction::%player%})))
									set {_damage} to {_damage} * (1+{_chainbuff})
								set {czaschain::%player%} to 10 seconds
								if {chainreac::%player%} is not set:
									set {chainreac::%player%} to true
								set {_frozen} to true
								if boolean tag "Constellation;Deep Shatter" of (custom nbt of {karta::%player%}) is set:
									if metadata value "WintersChill%player%" of {_target} > 0:
										set {_damage} to {_damage}*1.1
								if metadata value "Fingers of Frost" of player = 0:
									if metadata value "BrainFreeze" of player is true:
										send title " " with subtitle "" to player for 1 minute with fade in 0.25 second and fade out 0 second
									else:
										send title " " with subtitle " " to player for 1 second with fade in 0.0 second and fade out 0.0 second
								if metadata value "Fingers of Frost" of player = 1:
									if metadata value "BrainFreeze" of player is true:
										send title " " with subtitle "           " to player for 1 minute with fade in 0.25 second and fade out 0 second
									else:
										send title " " with subtitle "                     " to player for 1 minute with fade in 0.25 second and fade out 0 second
							if metadata value "WintersChill%player%" of {_target} > 0:
								set metadata value "WintersChill%player%" of {_target} to metadata value "WintersChill%player%" of {_target} - 1
								if metadata value "WintersChill%player%" of {_target} = 0:
									clear metadata value "WintersChill%player%" of {_target}
								set {_frozen} to true
								if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Thermal Void":
									set metadata value "ExtraSecondsIcyVeins" of player to metadata value "ExtraSecondsIcyVeins" of player + 1 second
							if {_frozen} is true:
								set {_damage} to {_damage}*2
								set {_crit} to {_crit} + 50
								if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%player%}) is set:
									set {_damage} to {_damage}*1.05

							icelancehurlSound(player)
							set {_l} to location 0.3 blocks below player's head
							set {_l} to location 0.4 blocks left of {_l}
							#set {_pid} to random 8 char string from charset `0-9`
							#ZAMIENIĆ PARTICLE JAK BĘDZIE SKDRAGON
							set {_vec} to vector between player and {_target}'s head
							loop round(distance between {_l} and {_target}) / 0.5 times:
								set {_vec} to vector between {_l} and {_target}'s head
								set vector length of {_vec} to loop-value * 0.5
								draw 1 of ((rgb 156, 255, 252) dust particle of size 1) at {_l} ~ {_vec}
								draw 1 of packed ice block particle at {_l} ~ {_vec}
							#drawLine particle redstone, RGB 156, 255, 252, center location of {_l}, target location of {_target}'s head, id "%{_pid}%", rainbowMode false, solid true, density 25, length 0, zigZag count 5, height 0, visibleRange 32, displacementXYZ 0, 1, 0, pulseDelay 3
							if {_r} > 10:
								set {_r} to distance between player and {_target}
								set {_sek} to "%{_r} - 10% ticks" parsed as timespan
							if {icicles::%player%} > 0:
								if metadata value "IcicleLaunch" of player is not set:
									set metadata value "IcicleLaunch" of player to true
							if distance between player and {_target} < 5:
								wait 0.3 seconds
							else:
								wait 0.5 seconds
							if boolean tag "Constellation;Subzero" of (custom nbt of {karta::%player%}) is set:
								set {_critModifier} to 2.2
							else:
								set {_critModifier} to 2

							set {_damageBeforeCrit} to {_damage}
							set {_target}'s last damage cause to sweep attack
							set metadata value "Element" of player to "Ice"
							set metadata value "LastDamageCause" of {_target} to "<##4bbfe2>Ice Lance"
							set metadata value "LastDamageCauseLore" of {_target} to {_lore}
							set {_rune} to getRunePower(player, "Brittle Ice")
							if metadata value "WintersChill%player%" of {_target} > 0:
								set {_damage} to {_damage} * (1 + {_rune}/100)
							set {_rune} to getRunePower(player, "Brittle Ice")
							if metadata value "WintersChill%player%" of {_target} > 0:
								set {_damage} to {_damage} * (1 + {_rune}/100)
							set {_damage} to Crit(player, {_target}, {_crit}, {_damage}, {_critModifier})
							make player damage {_target} by {_damage}*2

							if {_damage} != {_damageBeforeCrit}:
								if boolean tag "Constellation;Icy Propulsion" of (custom nbt of {karta::%player%}) is set:
									if metadata value "Icy Veins" of player is true:
										remove 0.75 seconds from cooldown "Icy Veins%player%"

							icelanceHitSound({_target})
							if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Splitting Ice":
								loop all entities in radius 5 around {_target}:
									if boolean tag "ECMob" of custom nbt of loop-entity is set:
										set loop-entity's last damage cause to sweep attack
										set metadata value "Element" of player to "Ice"
										set metadata value "LastDamageCause" of loop-entity to "<##4bbfe2>Ice Lance"
										set metadata value "LastDamageCauseLore" of loop-entity to {_lore}
										if {_damage} != {_damageBeforeCrit}:
											CritVisual(loop-entity)
											set metadata value "Crit%player%" of loop-entity to true
										make player damage loop-entity by 0.2*({_damage})

							clear {_damageBeforeCrit}
							ChainReaction(player)

							if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) != "Glacial Spike":
								if {_sek} is set:
									wait {_sek}
								HurlIcicleIceLance(player, {_target}, {_frozen})
							else:
								wait 1 tick
								if boolean tag "Constellation;Hailstones" of (custom nbt of {karta::%player%}) is set:
									if {_frozen} is true:
										set {icicles::%player%} to {icicles::%player%} + 1
										if {icicles::%player%} > {_iciclesCap}:

											HurlIcicle(player, {_target}, {_iciclesCap})

										else:
											IcicleForm(player, {icicles::%player%})
										send action bar " Icicles: %{icicles::%player%}%" to player
						else: 
							cancel event
							if {tekstcd::%player%} = true:
								set {_cdd} to cooldown "Ice Lance%player%"
								set the cooldown of player's tool for player to {_cdd}
								send "<##4bbfe2>You must wait &f%{_cdd}%<##4bbfe2> to use this ability." to player
							stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if player's tool is blue dye:
		if boolean tag "Frostbolt" of (custom nbt of player's tool) is set:
			cancel event
			if {kartaname::%player%} = "Glaceon":
				if CanUseAbility(player) != false:
					set {_target} to Target(player, 100, false)
					if {_target} is set:
						set {_pospiech} to Haste(player)
						set {_casttime} to "%round((2/{_pospiech}), 1)% seconds" parsed as timespan

						if {_target} is set:
							if {_target} is alive:
								set {_crit} to 25 + {criticalhit::%player%}/10
								set {_baseDamage} to AbilityUpgradeValue(player, "Glaceon", "Frostbolt", "BASEDAMAGE")
								set {_damageScaling} to AbilityUpgradeValue(player, "Glaceon", "Frostbolt", "DAMAGESCALING")
								set {_damage} to {_baseDamage} + {damage::%player%}/40 + {versatility::%player%}/120 + {primarystat::%player%}/{_damageScaling}
								
								set {_toiDmg} to offensiveTrait(player, "Glaceon", "Tunnel of Ice")
								if {_toiDmg} > 0:
									if metadata value "TunnelOfIceTarget" of player != {_target}:
										set metadata value "TunnelOfIceTarget" of player to {_target}
										set metadata value "TunnelOfIceStacks" of player to 1
									else:
										set {_toiStacks} to metadata value "TunnelOfIceStacks" of player
										if {_toiStacks} < 3:
											set {_toiStacks} to {_toiStacks} + 1
											set metadata value "TunnelOfIceStacks" of player to {_toiStacks}
									set {_damage} to {_damage} + ({_toiDmg} * (metadata value "TunnelOfIceStacks" of player))

								set {_rune} to getRunePower(player, "Frozen Focus")
								set {_damage} to {_damage} * (1 + {_rune}/100)

								set {_baseHeal} to AbilityUpgradeValue(player, "Glaceon", "Icicles", "BASEDAMAGE")
								set {_scaling} to AbilityUpgradeValue(player, "Glaceon", "Icicles", "DAMAGESCALING")
								set {_damageicicles} to ({_baseHeal} + ({damage::%player%}/75) + ({versatility::%player%}/225) + ({primarystat::%player%}/{_scaling})) * (1 + ({mastery::%player%}/3.75/100))

								if string tag "Talents;Row 2" of (custom nbt of {karta::%player%}) = "Lonely Winter":
									set {_damage} to {_damage}*1.25
								
								if string tag "Talents;Row 5" of (custom nbt of {karta::%player%}) = "Chilled to the Core":
									if metadata value "Icy Veins" of player is true:
										set {_damage} to {_damage}*1.2
										set {_damageicicles} to {_damageicicles}*1.2
								if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Splitting Ice":
									set {_damage} to {_damage}*1.05
									set {_damageicicles} to {_damageicicles}*1.05
								
								if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Slick Ice":
									if metadata value "Icy Veins" of player is true:
										if {slickIce::%player%} > 1:
											set {_slickIceReduction} to (1 - (0.04*{slickIce::%player%}))
											set {_casttime} to "%round(((2/{_pospiech})*{_slickIceReduction}), 1)% seconds" parsed as timespan
									set {_baseCd} to 2/(1 + (0.04*{slickIce::%player%}))
								else:
									set {_baseCd} to 2	

								if boolean tag "Constellation;Deep Shatter" of (custom nbt of {karta::%player%}) is set:
									set {_damage} to {_damage}*1.05

								if boolean tag "Constellation;Eternal Winter" of (custom nbt of {karta::%player%}) is set:
									set {_iciclesCap} to 7
									set {_damageicicles} to {_damageicicles}*1.2
								else:
									set {_iciclesCap} to 5

								set {_cd} to {_baseCd}/{_pospiech}
								set {_slowtime} to "%2 + ({crowdcontrol::%player%}/50)% seconds" parsed as timespan
								set {_slow} to 40
								set {_lore} to "&8Umiejętność%nl%&f%round(({_baseCd}/{_pospiech}), 1)% sekundowy cast%nl%&7Cooldown: &fbrak%nl%&7Użycie: &fPPM%nl%<##4bbfe2>Strzela w cel mroźnym pociskiem, zadając &f%{_damage}%%nl%<##4bbfe2>obrażeń <##add8e6>Lodu<##4bbfe2>, oraz spowalniajac <##4bbfe2>o &f%{_slow}%%% <##4bbfe2>na%nl%&f%{_slowtime}% &fsekund<##4bbfe2>.%nl% %nl%<##4bbfe2>Frostbolt ma &f%15 +{_chcf}%%% <##4bbfe2>szans na <##4bbfe2>przyznanie%nl%<##aedafc>Palców Mrozu <##4bbfe2>i &f%30 + {_chbf}%%% <##4bbfe2>szans na przyznanie%nl%<##aedafc>Zamrożenia Mózgu<##4bbfe2>.%nl% %nl%<##aedafc>Palce Mrozu<##4bbfe2>: Twoja następna Lodowa Lanca%nl%<##4bbfe2>zada obrażenia celowi jakby był Zamrożony,%nl%<##4bbfe2>oraz nie będzie miała cooldownu. %nl% %nl%<##aedafc>Zamrożenie Mózgu<##4bbfe2>: Wzmacnia kolejną użytą Śnieżycę,%nl%<##4bbfe2>zmieniając ją w natychmiastowy cast, zwiększając%nl%<##4bbfe2>jej obrażenia o &f50%%<##4bbfe2>, oraz powodując, że nałoży%nl%<##aedafc>Chłód <##aedafc>Zimy <##4bbfe2>na cel.%nl% %nl%<##aedafc>Chłód Zimy<##4bbfe2>: sprawia, że cel otrzymuje obrażenia%nl%<##4bbfe2>od twoich zaklęć tak, jakby był Zamrożony."
								set {_loreicicles} to "&7Użycie <##4bbfe2>Frostbolt &7przyzna ci <##4bbfe2>Sopelek&7. Użycie%nl%&7<##4bbfe2>Lodowej Lancy &7wystrzeli wszystkie przechowane%nl%<##4bbfe2>Sopelki &7w cel, każdy zadając &f%{_damageicicles}% &7obrażeń <##add8e6>Lodu&7.%nl% %nl%&7Maksymalnie %{_iciclesCap}% <##4bbfe2>Sopelków &7może być przechowane,%nl%&7a każdy wygenerowany <##4bbfe2>Sopelek &7w nadmiarze%nl%&7zostanie natychmiastowo wystrzelony."

								if cooldown "Frostbolt%player%" is finished:
									if metadata value "cast" of player is not set:
										set the cooldown of player's held item for player to "%{_cd}% seconds" parsed as timespan
										frostboltSound(player)
										set metadata value "casting" of player to true
										set metadata value "cast" of player to {_casttime}
										while metadata value "casting" of player = true:
											if metadata value "cast" of player is not set:
												clear metadata value "casting" of player
												stop
											if player can not see {_target}:
												clear metadata value "casting" of player
												stop
											if {_casttime} > 0 seconds:
												set {_cst} to "%{_casttime}%"
												send action bar "Casting... %{_cst}%" to player
												wait 0.1 seconds
												remove 0.1 seconds from {_casttime}
											else:
												clear metadata value "casting" of player
												stop loop
									else:
										stop
									clear metadata value "casting" of player
									clear metadata value "cast" of player
									stopSoundGlaceon(player)
									if {_casttime} > 0 seconds:
										send action bar "&cInterrupted" to player
										stop
									AbilityUse(player, "Frostbolt")
									frostbolthurlSound(player)
									set {_chancefrozen} to 15
									if string tag "Talents;Row 1" of (custom nbt of {karta::%player%}) = "Clarity of Thought":
										set {_brainFreezeChance} to 35
									else:
										set {_brainFreezeChance} to 30
									if string tag "Talents;Row 3" of (custom nbt of {karta::%player%}) = "Frozen Touch":
										set {_chancefrozen} to {_chancefrozen}*1.25
										set {_brainFreezeChance} to {_brainFreezeChance}*1.2
									if string tag "Talents;Row 4" of (custom nbt of {karta::%player%}) = "Slick Ice":
										if metadata value "Icy Veins" of player is true:
											if 6 > {slickIce::%player%}:
												set {slickIce::%player%} to {slickIce::%player%} + 1
												if {slickIce::%player%} > 1:
													set {_damage} to {_damage}*(1 + (0.04*{slickIce::%player%}))
											else if {slickIce::%player%} is not set:
												set {slickIce::%player%} to 1

									chance of {_brainFreezeChance}%:
										set metadata value "BrainFreeze" of player to true
										if metadata value "Fingers of Frost" of player < 1:
											send title " " with subtitle "" to player for 1 minute with fade in 0.25 second and fade out 0 second

									chance of {_chancefrozen}%:
										if metadata value "Fingers of Frost" of player < 2:
											set metadata value "Fingers of Frost" of player to metadata value "Fingers of Frost" of player + 1
										if metadata value "Fingers of Frost" of player = 1:
											if metadata value "BrainFreeze" of player is true:
												send title " " with subtitle "           " to player for 1 minute with fade in 0.25 second and fade out 0 second
											else:
												send title " " with subtitle "                     " to player for 1 minute with fade in 0.25 second and fade out 0 second
										else if metadata value "Fingers of Frost" of player = 2:
											if metadata value "BrainFreeze" of player is true:
												send title " " with subtitle "    " to player for 1 minute with fade in 0.25 second and fade out 0 second

									set {_iciclesBefore} to {icicles::%player%}
									set {icicles::%player%} to {icicles::%player%} + 1
									chance of {_extraicicles}%:
										set {_extra} to 2
										set {icicles::%player%} to {icicles::%player%} + 2

									Frostbolt(player, {_target}, {_crit}, {_damage}, {_slowtime})
									wait 1 tick
									if {icicles::%player%} > {_iciclesCap}:

										HurlIcicle(player, {_target}, {_iciclesCap})

									else:
										if {_extra} is not set:
											set {_extra} to 0
										loop 1 + {_extra} times:
											IcicleForm(player, ({_iciclesBefore} + loop-number))
									send action bar " Icicles: %{icicles::%player%}%" to player
							else:
								cancel event
								if {tekstcd::%player%} = true:
									set {_cdd} to cooldown "Frostbolt%player%"
									set the cooldown of player's tool for player to {_cdd}
									send "<##4bbfe2>You must wait &f%{_cdd}%<##4bbfe2> to use this ability." to player
								stop
			else:
				send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
				play sound "block.glass.break" with volume 3 and pitch 0 to player
	else if player's tool is prismarine shard:
		if boolean tag "Flurry" of (custom nbt of player's tool) is set:
			cancel event
			if {kartaname::%player%} = "Glaceon":
				if CanUseAbility(player) != false:
