		play sound "skill.cresselia.starfire_precast.arcticlights" with volume 4 and pitch 1 for {_p}
	else:
		play sound "skill.cresselia.starfire_precast" with volume 4 and pitch 1 for {_p}

function CresseliaStarfireCastSound(p: player):
	if getCurrentVariant({_p}, "Cresselia") = "Arctic Lights":
		play sound "skill.cresselia.starfire_cast.arcticlights" with volume 3 and pitch 1 at location of {_p}
		set {_extraCastSound} to metadata value "StarfireArcticLightsExtraCastSound" of {_p}
		if {_extraCastSound} is not set:
			set {_extraCastSound} to 0

		set {_extraCastSound} to {_extraCastSound} + 1

		play sound "skill.cresselia.starfire_castextra%{_extraCastSound}%.arcticlights" with volume 3 and pitch 1 at location of {_p}
		if {_extraCastSound} = 2:
			set {_extraCastSound} to 0
		set metadata value "StarfireArcticLightsExtraCastSound" of {_p} to {_extraCastSound}

	else:
		play sound "skill.cresselia.starfire_cast" with volume 3 and pitch 1 at location of {_p}

function CresseliaShootingStarSound(p: player, target: entity):
