function DailyRewardInFountain(b: block) :: boolean:
	set {_x} to x-coordinate of {_b}
	set {_y} to y-coordinate of {_b}
	set {_z} to z-coordinate of {_b}
	if {_x} is between 9263.5 and 9277.5:
		if {_y} is between 68 and 85:
			if {_z} is between 1598.5 and 1612.5:
				if {_b} is solid:
					return true
				if {_b} is water:
					return true
	return false

function DailyRewardResetId() :: integer:
	if {dailyRewardResetId} is not set:
		set {dailyRewardResetId} to 1
	return {dailyRewardResetId}

function DailyRewardCanClaim(p: player) :: boolean:
	set {_lastReset} to yaml value "Daily Reward.Last Reset" in "data-%{_p}%"
	if {_lastReset} is not DailyRewardResetId():
		return true
	return false

function DailyRewardProgress(p: player) :: integer:
	set {_progress} to yaml value "Daily Reward.Progress" in "data-%{_p}%"
	if {_progress} is not set:
		set {_progress} to 0
	return {_progress}

function DailyRewardDay(p: player) :: integer:
	return (mod(DailyRewardProgress({_p}), 14)) + 1

function DailyRewardStreak(p: player) :: integer:
	set {_streak} to yaml value "Daily Reward.Streak" in "data-%{_p}%"
	if {_streak} is not set:
		set {_streak} to 0
	return {_streak}

function DailyRewardItem(day: integer, p: player) :: item:
	if {_day} = 1:
		return 100 of {klejnot}
	else if {_day} = 2:
		return 3 of glass pane named "&fRandom Booster" with lore "&7Contains 3 random boosters."
	else if {_day} = 3:
		return 250 of {stardust}
	else if {_day} = 4:
		return {tokenwdziecznosci}
	else if {_day} = 5:
		return 3 of {adeptexpbook}
	else if {_day} = 6:
		return {magicznypryzmat}
	else if {_day} = 7:
		return 2 of {odlamekgwiazdy}
	else if {_day} = 8:
		return DailyRewardPreviewCardstone()
	else if {_day} = 9:
		return 4 of {diamondshard}
	else if {_day} = 10:
		return 25 of {skrzynkaluksusowa}
	else if {_day} = 11:
		return 10 of (random element of {esencje::*})
	else if {_day} = 12:
		return 4 of {szafirowekostki}
	else if {_day} = 13:
		return 20 of {bursztyn}
	return 4 of {odlamekgwiazdy}

function DailyRewardPreviewCardstone() :: item:
	set {_item} to yaml value "Cardstone.Item" in "ItemList"
	set {_lore::*} to lore of {_item}
	loop {_lore::*}:
		set {_line} to loop-value
		if {_line} contains "Resonates with":
			set {_line} to "&7Resonates with &fa random card."
		set {_updated::*} to {_updated::*} and {_line}
	set lore of {_item} to {_updated::*}
	return 100 of {_item}

function DailyRewardName(day: integer) :: text:
	if {_day} = 1:
		return "100 Klejnot"
	else if {_day} = 2:
		return "3x Random Booster"
	else if {_day} = 3:
		return "250 Stardust"
	else if {_day} = 4:
		return "Token of Gratitude"
	else if {_day} = 5:
		return "3x Adept Experience Book"
	else if {_day} = 6:
		return "Magic Prism"
	else if {_day} = 7:
		return "2x Star Shard"
	else if {_day} = 8:
		return "100x Random Cardstone"
	else if {_day} = 9:
		return "4x Diamond Shard"
	else if {_day} = 10:
		return "25x Luxurious Chest"
	else if {_day} = 11:
		return "10x Random Essence"
	else if {_day} = 12:
		return "4x Sapphire Dice"
	else if {_day} = 13:
		return "20x Amber"
	return "4x Star Shard"

function DailyRewardBooster() :: item:
	set {_boosters::*} to {boostersecretwonders}, {boostermajesticdawn}, {boosterunseenforces}, {boosterplasmafreeze} and {boosterteampoisonvsteamaqua}
	return random element of {_boosters::*}

function DailyRewardGive(p: player, day: integer):
	if {_day} = 2:
		loop 3 times:
			giveItem({_p}, DailyRewardBooster())
	else if {_day} = 8:
		set {_cards::*} to DiamondAllCards()
		giveItem({_p}, DiamondCardstoneItem(random element of {_cards::*}, 100))
	else:
		giveItem({_p}, DailyRewardItem({_day}, {_p}))

function DailyRewardClaimSound(p: player):
	set {_pitch} to 0.8
	play sound "entity.item.pickup" with volume 2 and pitch 1.2 to {_p}
	loop 8 times:
		play sound "block.note_block.hat" with volume 2 and pitch {_pitch} to {_p}
		play sound "block.note_block.pling" with volume 2 and pitch {_pitch} to {_p}
		set {_pitch} to {_pitch} + 0.12
		wait 2 ticks
	play sound "ui.toast.challenge_complete" with volume 2 and pitch 1.1 to {_p}

function DailyRewardClaim(p: player):
	if DailyRewardCanClaim({_p}) is false:
		send "&cYou already claimed today's reward." to {_p}
		play sound "entity.villager.no" with volume 2 and pitch 1 to {_p}
		stop

	set {_day} to DailyRewardDay({_p})
	set {_resetId} to DailyRewardResetId()
	set {_lastClaimReset} to yaml value "Daily Reward.Last Claim Reset" in "data-%{_p}%"
	set {_streak} to DailyRewardStreak({_p})
	set {_previousReset} to {_resetId} - 1

	if {_lastClaimReset} is {_previousReset}:
		set {_streak} to {_streak} + 1
	else:
		set {_streak} to 1

	set yaml value "Daily Reward.Streak" in "data-%{_p}%" to {_streak}
	set yaml value "Daily Reward.Last Reset" in "data-%{_p}%" to {_resetId}
	set yaml value "Daily Reward.Last Claim Reset" in "data-%{_p}%" to {_resetId}

	set {_newProgress} to DailyRewardProgress({_p}) + 1
	set yaml value "Daily Reward.Progress" in "data-%{_p}%" to {_newProgress}

	set {_totalClaims} to yaml value "Daily Reward.Total Claims" in "data-%{_p}%"
	if {_totalClaims} is not set:
		set {_totalClaims} to 0
	set yaml value "Daily Reward.Total Claims" in "data-%{_p}%" to {_totalClaims} + 1

	DailyRewardGive({_p}, {_day})
	addToYaml(1, "data-%{_p}%", "Statistics.Daily Reward.Claims")
	save yaml "data-%{_p}%"

	DailyRewardClaimSound({_p})
	send "<##f0cc9e>Daily Reward >>> &fClaimed day &e%{_day}% &freward!" to {_p}

function DailyRewardOpen(p: player):
	set metadata tag "dziennanagroda" of {_p} to chest inventory with 5 rows named "         <##e134eb>&lDaily Reward"
	set {_gui} to metadata tag "dziennanagroda" of {_p}
	set slots integers between 0 and 44 of {_gui} to black stained glass pane named " "

	set {_currentDay} to DailyRewardDay({_p})
	set {_canClaim} to DailyRewardCanClaim({_p})
	set {_progress} to DailyRewardProgress({_p})
	set {_cycleDay} to mod({_progress}, 14) + 1
	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24 and 25

	loop 14 times:
		set {_day} to loop-number
		set {_slot} to {_slots::%loop-number%}

		if {_day} = {_cycleDay}:
			if {_canClaim} is true:
				set {_item} to DailyRewardItem({_day}, {_p})
				set lore of {_item} to lore of {_item} and " " and "&aClick to claim today's reward."
			else:
				set {_item} to magenta stained glass pane named "&dClaimed" with lore "&8Day %{_day}%", "&7Reward: &f%DailyRewardName({_day})%"
		else if {_day} < {_cycleDay}:
			set {_item} to magenta stained glass pane named "&dClaimed" with lore "&8Day %{_day}%", "&7Reward: &f%DailyRewardName({_day})%"
		else:
			set {_item} to gray stained glass pane named "&7Day %{_day}%" with lore "&7Reward: &f%DailyRewardName({_day})%"

		set slot {_slot} of {_gui} to {_item}

	set slot 4 of {_gui} to end crystal named "<##e134eb>Current Streak" with lore "&7Current streak: &f%DailyRewardStreak({_p})%", "&7Progress day: &f%{_currentDay}%&7/&f14"
	open {_gui} to {_p}

on rightclick:
	if clicked block is set:
		if DailyRewardInFountain(clicked block) is true:
			cancel event
			DailyRewardOpen(player)
			play sound "block.note_block.pling" with volume 2 and pitch 1.5 to player

on inventory click:
	if event-inventory = metadata tag "dziennanagroda" of player:
		cancel event
		set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24 and 25
		if {_slots::*} contains index of event-slot:
			if DailyRewardCanClaim(player) is true:
				DailyRewardClaim(player)
				DailyRewardOpen(player)
			else:
				play sound "entity.villager.no" with volume 2 and pitch 1 to player

function dailyRewardAnimate():
	wait 1 tick
	set {_x} to block at location(9270, 69, 1605, world "world")
	set {_x2} to block at location(9270, 70.5, 1605, world "world")
	set {_rotate1} to 0
	set {_rotate2} to 180

	set {_raw} to "✨ Daily Reward ✨"
	set {_length} to length of {_raw}
	set {_direction} to 1

	while amount of online players > 0:
		set {_i} to {_i} + {_direction}
		if {_i} >= {_length}-2:
			set {_i} to {_length}-2
			set {_direction} to -1
		else if {_i} <= 1:
			set {_i} to 1
			set {_direction} to 1
		set {_start} to ""
		set {_end} to ""
		set {_char} to character at {_i} in {_raw}
		
		if {_i} > 1:
			set {_start} to subtext of {_raw} from characters 1 to ({_i} - 1)

			if {_i} < {_length}:
				set {_end} to subtext of {_raw} from characters ({_i} + 1) to {_length}

			set {_animated} to mini message from "<gradient:#d6ff4f:#66ff4f:#6dc452:#a1ff4f:#d6ff4f><bold>%{_start}%<bold>%{_char}%<gradient:#d6ff4f:#66ff4f:#6dc452:#a1ff4f:#d6ff4f><bold>%{_end}%"

			set {_display} to {displayText::DailyReward} parsed as entity
			set display text of {_display} to {_animated}

		loop 2 times:
			set {_counter} to loop-counter-2
			set {_v%{_counter}%} to vector 5, 0, 5
			rotate {_v%{_counter}%} around y-axis by {_rotate%{_counter}%}

			set {_v2%{_counter}%} to vector 3, 0, 3
			rotate {_v2%{_counter}%} around y-axis by {_rotate%{_counter}%}-2

			set {_rotate%{_counter}%} to {_rotate%{_counter}%} + 4

			draw 1 of lime dust particle at {_x} ~ {_v%{_counter}%}
			draw 1 of yellow dust particle at {_x} ~ {_v%{_counter}%}

			draw 1 of lime dust particle at {_x2} ~ {_v2%{_counter}%}
			draw 1 of yellow dust particle at {_x2} ~ {_v2%{_counter}%}

		wait 2 ticks