using script reflection



function playEntitySound(e: entity, state: string):
    set {_mobType} to string tag "MobType" of custom nbt of {_e}
    replace all " " in {_mobType} with ""
    set {_function} to function named "%{_mobType}%%{_state}%Sound"
    if {_function} is set:
        execute {_function} with arguments {_e}

function AzeriteElementalAttackSound(e: entity):
    set {_volume} to 1
    play sound "block.stone.break" with volume {_volume} and pitch 0.6 at location of {_e}
    play sound "block.deepslate.break" with volume {_volume} and pitch 0.7 at location of {_e}
    play sound "entity.iron_golem.attack" with volume ({_volume} * 0.5) and pitch 0.5 at location of {_e}
    play sound "entity.ravager.attack" with volume ({_volume} * 0.5) and pitch 0.6 at location of {_e}

    loop 2 times:
        set {_pitch} to 1.1 + (loop-value * 0.2)
        play sound "block.amethyst_block.hit" with volume ({_volume} * 0.8) and pitch {_pitch} at location of {_e}
    loop 3 times:
        set {_pitch} to 0.8 + (loop-value * 0.1)
        play sound "block.amethyst_block.chime" with volume ({_volume} * 0.5) and pitch {_pitch} at location of {_e}

    wait 1 tick
    play sound "block.glass.break" with volume ({_volume} * 0.3) and pitch 1.8 at location of {_e}
    play sound "block.deepslate.step" with volume ({_volume} * 0.6) and pitch 0.7 at location of {_e}

    loop 2 times:
        wait 1 tick
        play sound "block.dripstone_block.break" with volume ({_volume} * 0.8) and pitch (0.4 + loop-value * 0.2) at location of {_e}
        play sound "block.stone.hit" with volume ({_volume} * 0.3) and pitch 0.5 at location of {_e}

function AzeriteElementalRageSound(e: entity):
    play sound "entity.warden.roar" with volume 3 and pitch 0.75 at location of {_e}

function AzeriteElementalDeathSound(e: entity):
    play sound "block.amethyst_block.break" with volume 2.0 and pitch 0.5 at location of {_e}
    play sound "entity.zoglin.death" with volume 1.5 and pitch 0.1 at location of {_e}
    play sound "block.stone.break" with volume 2.0 and pitch 0.4 at location of {_e}

    wait 4 ticks

    loop 4 times:
        set {_pitch} to 0.4 + (loop-value * 0.1)
        play sound "block.deepslate.step" with volume 1.2 and pitch {_pitch} at location of {_e}
        play sound "entity.iron_golem.damage" with volume 0.8 and pitch 0.1 at location of {_e}
        
        wait 3 ticks

    play sound "block.gravel.break" with volume 1.0 and pitch 0.5 at location of {_e}
    play sound "block.amethyst_block.chime" with volume 0.8 and pitch 0.1 at location of {_e}

    play sound "entity.warden.death" with volume 0.6 and pitch 0.1 at location of {_e}

function AzeriteElementalAmbientSound(e: entity):
    while {_e} is alive:
        play sound "entity.warden.breathing" with volume 0.5 and pitch 0.1 at location of {_e}
        play sound "entity.ravager.celebrate" with volume 0.4 and pitch 0.3 at location of {_e}

        play sound "entity.warden.heartbeat" with volume 0.7 and pitch 0.2 at location of {_e}
        play sound "block.amethyst_block.resonate" with volume 0.3 and pitch 0.5 at location of {_e}

        loop (random integer between 2 and 4) times:
            play sound "block.deepslate.step" with volume 0.5 and pitch (random number between 0.1 and 0.4) at location of {_e}
            wait 3 ticks

        if chance of 15%:
            play sound "entity.iron_golem.damage" with volume 0.3 and pitch 0.1 at location of {_e}
            play sound "block.creaking_heart.idle" with volume 0.4 and pitch 0.2 at location of {_e}

        set {_wait} to random integer between 50 and 300
        wait "%{_wait}% ticks" parsed as timespan