function ProfileFavouriteCard(p: player) :: text:
	set {_card} to yaml value "Player.Profile.Favourite Card" in "data-%{_p}%"
	if {_card} is not set:
		set {_card} to "Not set"
	return {_card}

function ProfileFavouriteElement(p: player) :: text:
	set {_element} to yaml value "Player.Profile.Favourite Element" in "data-%{_p}%"
	if {_element} is not set:
		set {_element} to "Not set"
	return {_element}

function ProfileBirthday(p: player) :: text:
	set {_birthday} to yaml value "Player.Profile.Birthday" in "data-%{_p}%"
	if {_birthday} is not set:
		if {dataurodzin::%{_p}%} is set:
			set {_birthday} to {dataurodzin::%{_p}%}
	if {_birthday} is not set:
		set {_birthday} to "Not set"
	else if {_birthday} contains ".":
		set {_parts::*} to {_birthday} split at "."
		if size of {_parts::*} = 3:
			set {_d} to {_parts::1} parsed as integer
			set {_m} to {_parts::2} parsed as integer
			set {_y} to {_parts::3} parsed as integer
			set {_monthName} to GetMonthName({_m})
			set {_birthday} to "%{_d}% %{_monthName}% %{_y}%"
	return {_birthday}

function ProfileTeam(p: player) :: text:
	set {_team} to yaml value "Player.Team" in "data-%{_p}%"
	if {_team} is not set:
		set {_team} to "None"
	return {_team}

function ProfileCurrentCard(p: player) :: text:
	if {kartaname::%{_p}%} is set:
		return {kartaname::%{_p}%}
	return "None"

function ProfileCurrentCardLevel(p: player) :: number:
	if yaml "activeCard-%{_p}%" is loaded:
		set {_level} to yaml value "Card.Level" in "activeCard-%{_p}%"
		if {_level} is set:
			return {_level}
	return 0

function ProfilePrimaryStatIcon(stat: text) :: text:
	if {_stat} = "Strength":
		return "<#e35959> &fStrength"
	else if {_stat} = "Intellect":
		return "<#59c1e3> &fIntellect"
	else if {_stat} = "Agility":
		return "<#5ee359> &fAgility"
	return "&f %{_stat}%"

function ProfilePrimaryStatLine(p: player) :: text:
	set {_primaryStat} to metadata value "PrimaryStatType" of {_p}
	if {_primaryStat} is set:
		set {_value} to PrimaryStatStat({_p})
		set {_icon} to ProfilePrimaryStatIcon({_primaryStat})
		return "%{_icon}% &7- &f%{_value}%"
	return "&f Primary Stat &7- &fNone"

function ProfileHealthLine(p: player) :: text:
	set {_health} to round(Health({_p}), 0)
	return "<#c0ff02> &fHealth &7- &f%{_health}%"

function ProfileTopStatsLines(p: player) :: texts:
	set {_indices::*} to retrieveTopStats({_p}, "indices")
	set {_values::*} to retrieveTopStats({_p}, "values")
	set {_rank} to 0
	set {_i} to 1
	loop {_indices::*}:
		set {_stat} to loop-value
		set {_value} to {_values::%{_i}%}
		set {_i} to {_i} + 1
		if {_stat} != "Health":
			set {_rank} to {_rank} + 1
			set {_icon} to returnStatIcon({_stat})
			set {_lines::*} to {_lines::*} and "&7%{_rank}%. %{_icon}% &7- &f%{_value}%"
		if {_rank} >= 5:
			exit loop
	return {_lines::*}

function ProfilePlayerLevel(p: player) :: number:
	if yaml "data-%{_p}%" is loaded:
		set {_level} to yaml value "Player.Level" in "data-%{_p}%"
		if {_level} is set:
			return {_level}
	return {poziom::%{_p}%}

function ProfilePlayerExp(p: player) :: number:
	if yaml "data-%{_p}%" is loaded:
		set {_exp} to yaml value "Player.Exp" in "data-%{_p}%"
		if {_exp} is set:
			return {_exp}
	return {exp::%{_p}%}

function LegacyToMiniMessage(t: text) :: text:
	replace all "&a" with "<color:##55FF55>" in {_t}
	replace all "&b" with "<color:##55ffff>" in {_t}
	replace all "&c" with "<color:##ff5555>" in {_t}
	replace all "&d" with "<color:##FF55FF>" in {_t}
	replace all "&e" with "<color:##FFFF55>" in {_t}
	replace all "&f" with "<color:##FFFFFF>" in {_t}
	replace all "&1" with "<color:##0000aa>" in {_t}
	replace all "&2" with "<color:##00AA00>" in {_t}
	replace all "&3" with "<color:##00AAAA>" in {_t}
	replace all "&4" with "<color:##aa0000>" in {_t}
	replace all "&5" with "<color:##AA00AA>" in {_t}
	replace all "&6" with "<color:##FFAA00>" in {_t}
	replace all "&7" with "<color:##AAAAAA>" in {_t}
	replace all "&8" with "<color:##555555>" in {_t}
	replace all "&9" with "<color:##5555ff>" in {_t}
	replace all "&0" with "<color:##000000>" in {_t}
	replace all "&l" with "<bold>" in {_t}
	replace all "&n" with "<underlined>" in {_t}
	replace all "&o" with "<i>" in {_t}
	replace all "&m" with "<strikethrough>" in {_t}
	replace all "&k" with "<obfuscated>" in {_t}
	replace all "&r" with "<reset>" in {_t}
	replace all "<##" with "<color:##" in {_t}
	return {_t}

function ProfileHoverText(p: player) :: text:
	set {_level} to ProfilePlayerLevel({_p})
	set {_exp} to ProfilePlayerExp({_p})
	set {_favouriteCard} to ProfileFavouriteCard({_p})
	set {_favouriteElement} to ProfileFavouriteElement({_p})
	set {_currentCard} to ProfileCurrentCard({_p})
	set {_cardLevel} to ProfileCurrentCardLevel({_p})
	set {_primaryStat} to ProfilePrimaryStatLine({_p})
	set {_healthLine} to ProfileHealthLine({_p})
	set {_stoneMined} to {stone::%{_p}%} + {deepslate::%{_p}%}*2
	set {_mobKills} to {mobskilled::%{_p}%}
	set {_hover} to "&fLevel %{_level}% &7| &fExp. %{_exp}%"
	set {_hover} to "%{_hover}%%nl% %nl%&fFavourite Card: &e%{_favouriteCard}%"
	set {_hover} to "%{_hover}%%nl%&fFavourite Element: &e%{_favouriteElement}%"
	set {_hover} to "%{_hover}%%nl%&fBirthday: &e%ProfileBirthday({_p})%"
	set {_hover} to "%{_hover}%%nl%&fTeam: &e%ProfileTeam({_p})%"
	set {_hover} to "%{_hover}%%nl% %nl%&fCurrent Card: &e%{_currentCard}%"
	set {_hover} to "%{_hover}%%nl%&fCard Level: &e%{_cardLevel}%"
	set {_hover} to "%{_hover}%%nl% %nl%%{_primaryStat}%"
	set {_hover} to "%{_hover}%%nl%%{_healthLine}%"
	set {_stats::*} to ProfileTopStatsLines({_p})
	loop {_stats::*}:
		set {_hover} to "%{_hover}%%nl%%loop-value%"
	set {_hover} to "%{_hover}%%nl% %nl%&fTotal mob kills: &e%formatNumberEc({_mobKills})%"
	set {_hover} to "%{_hover}%%nl%&fTotal stone mined: &e%formatNumberEc({_stoneMined})%"
	set {_hover} to LegacyToMiniMessage({_hover})
	replace all nl in {_hover} with "<newline>"
	return {_hover}

function LoadTargetData(target: player):
	if yaml "data-%{_target}%" is not loaded:
		load yaml "plugins/Skript/playerdata/%uuid of {_target}%.yml" as "data-%{_target}%"

function LoadStellarChestList():
	if yaml "StellarChestList" is not loaded:
		load yaml "plugins/Skript/lists/StellarChestList" as "StellarChestList"

function LoadBoosterCardList():
	if yaml "BoosterCardList" is not loaded:
		load yaml "plugins/Skript/lists/BoosterCardList" as "BoosterCardList"

function SortKeyPad(n: integer) :: text:
	set {_s} to "%{_n}%"
	loop 8 - length of {_s} times:
		set {_s} to "0%{_s}%"
	return {_s}

function ProfileSortMode(viewer: player) :: text:
	set {_mode} to metadata value "ProfileSortMode" of {_viewer}
	if {_mode} is not set:
		set {_mode} to "Global ID"
	return {_mode}

function ProfileSortItem(viewer: player) :: item:
	if ProfileSortMode({_viewer}) = "Alphabetical":
		return hopper named "&bSort: &fAlphabetical" with lore "&7Click to sort by Global ID." with item flag hide attributes
	return hopper named "&bSort: &fGlobal ID" with lore "&7Click to sort alphabetically." with item flag hide attributes


function BoosterYamlKey(booster: text) :: text:
	if {_booster} = "Team Poison vs. Team Aqua" or "Team Poison vs Team Aqua" or "TPVSTA":
		return "TPVSTA"
	return {_booster}

function BoosterDisplayName(booster: text) :: text:
	if {_booster} = "TPVSTA":
		return "Team Poison vs. Team Aqua"
	return {_booster}

function LoadBoosterPlayerYaml(p: player, booster: text):
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_pathName} to BoosterDisplayName({_booster})
	if yaml "%{_yamlKey}%-%{_p}%" is not loaded:
		load yaml "plugins/Skript/playerdata/boosters/%{_pathName}%/%uuid of {_p}%.yml" as "%{_yamlKey}%-%{_p}%"

function BoosterCardCount(p: player, booster: text, card: text) :: integer:
	LoadBoosterPlayerYaml({_p}, {_booster})
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_val} to yaml value "Cards.%{_card}%" in "%{_yamlKey}%-%{_p}%"
	if {_val} is not set:
		return 0
	return {_val}

function PlayableCardCount(p: player, card: text) :: integer:
	if {kolekcja::karty::%{_p}%::%{_card}%} is set:
		return {kolekcja::karty::%{_p}%::%{_card}%}
	if {kolekcja::karty::%{_p}%::*} contains {_card}:
		return 1
	return 0

function BoosterCardItem(booster: text, card: text) :: item:
	LoadBoosterCardList()
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_base} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Base" in "BoosterCardList"
	set {_displayName} to yaml value "%{_yamlKey}%.Cards.%{_card}%.DisplayName" in "BoosterCardList"
	set {_cmd} to yaml value "%{_yamlKey}%.Cards.%{_card}%.CustomModelData" in "BoosterCardList"
	if {_base} is not set:
		return air
	set {_itemType} to {_base} parsed as item type
	if {_cmd} is set:
		set {_item} to {_itemType} named "%{_displayName}%" with nbt from "{""minecraft:custom_model_data"":{floats:[%{_cmd}%.0f]}}"
	else:
		set {_item} to {_itemType} named "%{_displayName}%"
	return {_item}

function BoosterCardLore(booster: text, card: text, count: integer) :: texts:
	LoadBoosterCardList()
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_displayBooster} to BoosterDisplayName({_booster})
	set {_rarity} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Rarity" in "BoosterCardList"
	set {_element} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Element" in "BoosterCardList"
	set {_id} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Id" in "BoosterCardList"
	set {_idGlobal} to yaml value "%{_yamlKey}%.Cards.%{_card}%.IdGlobal" in "BoosterCardList"
	set {_lore::*} to "&7Booster: &f%{_displayBooster}%", "&7Rarity: &f%{_rarity}%", "&7Element: &f%{_element}%", "&7Card ID: &f%{_id}%", "&7Global ID: &f%{_idGlobal}%", " ", "&7Collected: &f%{_count}%"
	return {_lore::*}

function BoosterUnknownCardLore(booster: text, card: text) :: texts:
	LoadBoosterCardList()
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_displayBooster} to BoosterDisplayName({_booster})
	set {_rarity} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Rarity" in "BoosterCardList"
	set {_element} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Element" in "BoosterCardList"
	set {_id} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Id" in "BoosterCardList"
	set {_idGlobal} to yaml value "%{_yamlKey}%.Cards.%{_card}%.IdGlobal" in "BoosterCardList"
	set {_lore::*} to "&7Booster: &f%{_displayBooster}%", "&7Rarity: &f%{_rarity}%", "&7Element: &f%{_element}%", "&7Card ID: &f%{_id}%", "&7Global ID: &f%{_idGlobal}%", " ", "&7Collected: &f0", " ", "&8Not collected yet"
	return {_lore::*}

function BoosterCardLoreAll(booster: text, card: text, count: integer) :: texts:
	LoadBoosterCardList()
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_displayBooster} to BoosterDisplayName({_booster})
	set {_rarity} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Rarity" in "BoosterCardList"
	set {_element} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Element" in "BoosterCardList"
	set {_idGlobal} to yaml value "%{_yamlKey}%.Cards.%{_card}%.IdGlobal" in "BoosterCardList"
	set {_lore::*} to "&7Booster: &f%{_displayBooster}%", "&7Rarity: &f%{_rarity}%", "&7Element: &f%{_element}%", "&7Global ID: &f%{_idGlobal}%", " ", "&7Collected: &f%{_count}%"
	return {_lore::*}

function BoosterUnknownCardLoreAll(booster: text, card: text) :: texts:
	LoadBoosterCardList()
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_displayBooster} to BoosterDisplayName({_booster})
	set {_rarity} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Rarity" in "BoosterCardList"
	set {_element} to yaml value "%{_yamlKey}%.Cards.%{_card}%.Element" in "BoosterCardList"
	set {_idGlobal} to yaml value "%{_yamlKey}%.Cards.%{_card}%.IdGlobal" in "BoosterCardList"
	set {_lore::*} to "&7Booster: &f%{_displayBooster}%", "&7Rarity: &f%{_rarity}%", "&7Element: &f%{_element}%", "&7Global ID: &f%{_idGlobal}%", " ", "&7Collected: &f0", " ", "&8Not collected yet"
	return {_lore::*}

function BoosterAllNames() :: texts:
	return "Secret Wonders", "Majestic Dawn", "Unseen Forces", "Plasma Freeze" and "TPVSTA"

function IsCardCollected(p: player, booster: text, card: text) :: boolean:
	if {kolekcja::karty::%{_p}%::*} contains {_card}:
		return true
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_pathName} to BoosterDisplayName({_booster})
	if yaml "%{_yamlKey}%-%{_p}%" is not loaded:
		load yaml "plugins/Skript/playerdata/boosters/%{_pathName}%/%uuid of {_p}%.yml" as "%{_yamlKey}%-%{_p}%"
	set {_val} to yaml value "Cards.%{_card}%" in "%{_yamlKey}%-%{_p}%"
	if {_val} is set:
		if {_val} > 0:
			return true
	return false

function CountYamlTrue(yamlId: text, path: text) :: number:
	set {_count} to 0
	set {_keys::*} to yaml node keys "%{_path}%" in {_yamlId}
	loop {_keys::*}:
		set {_childPath} to "%{_path}%.%loop-value%"
		if yaml value "%{_childPath}%" in {_yamlId} is true:
			set {_count} to {_count} + 1
		else:
			set {_childKeys::*} to yaml node keys "%{_childPath}%" in {_yamlId}
			if {_childKeys::*} is set:
				set {_count} to {_count} + CountYamlTrue({_yamlId}, {_childPath})
	return {_count}

function ProfileSummaryLore(p: player) :: texts:
	set {_stoneMined} to {stone::%{_p}%} + {deepslate::%{_p}%}*2
	set {_lore::*} to "&fLevel %ProfilePlayerLevel({_p})% &7| &fExp. %ProfilePlayerExp({_p})%", " ", "&fFavourite Card: &e%ProfileFavouriteCard({_p})%", "&fFavourite Element: &e%ProfileFavouriteElement({_p})%", "&fBirthday: &e%ProfileBirthday({_p})%", "&fTeam: &e%ProfileTeam({_p})%", " ", "&fCurrent Card: &e%ProfileCurrentCard({_p})%", "&fCard Level: &e%ProfileCurrentCardLevel({_p})%", " ", "%ProfilePrimaryStatLine({_p})%", "%ProfileHealthLine({_p})%"
	set {_stats::*} to ProfileTopStatsLines({_p})
	loop {_stats::*}:
		set {_lore::*} to {_lore::*} and loop-value
	set {_lore::*} to {_lore::*} and " " and "&fTotal mob kills: &e%formatNumberEc({mobskilled::%{_p}%})%" and "&fTotal stone mined: &e%formatNumberEc({_stoneMined})%"
	return {_lore::*}

function OpenProfileMain(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-main" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Profile"
	set {_gui} to metadata tag "profile-main" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set slot 4 of {_gui} to (skull of ("%{_target}%" parsed as offlineplayer) named "&f%{_target}%" with lore ProfileSummaryLore({_target})) with item flag hide attributes
	set slot 10 of {_gui} to book named "&bCollection" with lore "&7View collected cards." with item flag hide attributes
	set slot 11 of {_gui} to compass named "&aStatistics" with lore "&7View saved profile statistics." with item flag hide attributes
	set slot 12 of {_gui} to totem of undying named "&6Achievements" with lore "&7View achievement progress." with item flag hide attributes
	set slot 14 of {_gui} to cake named "&dSet Birthday" with lore "&7Current: &f%ProfileBirthday({_target})%" with item flag hide attributes
	set slot 15 of {_gui} to paper named "&eSet Favourite Card" with lore "&7Current: &f%ProfileFavouriteCard({_target})%" with item flag hide attributes
	set slot 16 of {_gui} to blaze powder named "&cSet Favourite Element" with lore "&7Current: &f%ProfileFavouriteElement({_target})%" with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollection(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-collection" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Collection"
	set {_gui} to metadata tag "profile-collection" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set slot 12 of {_gui} to nether star named "&fPlayable Cards" with lore "&7View your collected playable cards." with item flag hide attributes
	set slot 14 of {_gui} to experience bottle named "&9Booster Cards" with lore "&7View collected booster cards." with item flag hide attributes
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionPlayable(viewer: player, target: player):
	LoadTargetData({_target})
	LoadStellarChestList()
	set metadata tag "profile-collection-playable" of {_viewer} to chest inventory with 6 rows named "%{_target}% - Playable Cards"
	set {_gui} to metadata tag "profile-collection-playable" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_slot} to 0
	set {_cards::*} to yaml node keys "Cards" in "StellarChestList"
	loop {_cards::*}:
		set {_card} to loop-value
		set {_preview} to StellarCardPreview({_card}, true)
		if {_preview} is set:
			set {_count} to PlayableCardCount({_target}, {_card})
			if {_count} > 0:
				set {_lore::*} to coloured lore of {_preview}
				set {_lore::*} to {_lore::*} and " " and "&7Collected: &f%{_count}%"
				set lore of {_preview} to {_lore::*}
				set {_preview} to {_preview} with item flag hide attributes
			else:
				set {_preview} to gray stained glass pane named name of {_preview}
				set {_lore::*} to coloured lore of {_preview}
				set {_lore::*} to {_lore::*} and " " and "&7Collected: &f0" and " " and "&8Not collected yet"
				set lore of {_preview} to {_lore::*}
			set slot {_slot} of {_gui} to {_preview}
			set {_slot} to {_slot} + 1
			if {_slot} >= 45:
				exit loop
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterMain(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-collection-booster" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Booster Cards"
	set {_gui} to metadata tag "profile-collection-booster" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set slot 12 of {_gui} to nether star named "&fAll Cards" with lore "&7View all booster cards." with item flag hide attributes
	set slot 14 of {_gui} to book named "&9Per Booster" with lore "&7View booster cards sorted per booster." with item flag hide attributes
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterSetSelect(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-collection-booster-select" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Per Booster"
	set {_gui} to metadata tag "profile-collection-booster-select" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_slot} to 11
	set {_boosters::*} to BoosterAllNames()
	loop {_boosters::*}:
		set slot {_slot} of {_gui} to glass pane named "&9%BoosterDisplayName(loop-value)% &7Booster" with lore "&7View cards from this booster." with item flag hide attributes
		set {_slot} to {_slot} + 1
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterAll(viewer: player, target: player, page: integer):
	LoadTargetData({_target})
	LoadBoosterCardList()
	set metadata tag "profile-collection-booster-all" of {_viewer} to chest inventory with 6 rows named "%{_target}% - All Booster Cards"
	set {_gui} to metadata tag "profile-collection-booster-all" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_mode} to ProfileSortMode({_viewer})
	set {_boosters::*} to BoosterAllNames()
	set {_index} to 0
	clear {_entries::*}
	set {_entryCount} to 0
	loop {_boosters::*}:
		set {_booster} to loop-value
		set {_yamlKey} to BoosterYamlKey({_booster})
		set {_cards::*} to yaml node keys "%{_yamlKey}%.Cards" in "BoosterCardList"
		loop {_cards::*}:
			set {_index} to {_index} + 1
			if {_mode} = "Alphabetical":
				set {_sortKey} to "%loop-value-2%-%SortKeyPad({_index})%"
			else:
				set {_order} to yaml value "%{_yamlKey}%.Cards.%loop-value-2%.IdGlobal" in "BoosterCardList"
				if {_order} is not set:
					set {_order} to 9999
				set {_sortKey} to "%SortKeyPad({_order})%-%SortKeyPad({_index})%"
			set {_entryCount} to {_entryCount} + 1
			set {_entries::%{_entryCount}%} to "%{_sortKey}%|||%loop-value-2%|||%{_booster}%"
	sort {_entries::*} in ascending order
	set {_total} to size of {_entries::*}
	set {_start} to {_page} * 45 + 1
	set {_end} to {_start} + 44
	set {_slot} to 0
	loop integers between {_start} and {_end}:
		set {_entry} to {_entries::%loop-value%}
		if {_entry} is set:
			set {_parts::*} to {_entry} split at "|||"
			set {_cardName} to {_parts::2}
			set {_booster} to {_parts::3}
			set {_count} to BoosterCardCount({_target}, {_booster}, {_cardName})
			if {_count} > 0:
				set {_preview} to BoosterCardItem({_booster}, {_cardName})
				set lore of {_preview} to BoosterCardLoreAll({_booster}, {_cardName}, {_count})
				set {_preview} to {_preview} with item flag hide attributes
			else:
				set {_preview} to gray stained glass pane named "&7???" with lore BoosterUnknownCardLoreAll({_booster}, {_cardName})
			set slot {_slot} of {_gui} to {_preview}
			set {_slot} to {_slot} + 1
	set slot 48 of {_gui} to ProfileSortItem({_viewer})
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	if {_page} > 0:
		set slot 45 of {_gui} to arrow named "&ePrevious Page" with lore "&7Page &f%{_page}%" with item flag hide attributes
	if {_total} > {_end}:
		set slot 53 of {_gui} to arrow named "&eNext Page" with lore "&7Page &f%{_page}+2%" with item flag hide attributes
	set metadata value "ProfileBoosterAllPage" of {_viewer} to {_page}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileCollectionBoosterSet(viewer: player, target: player, booster: text, page: integer):
	LoadTargetData({_target})
	LoadBoosterCardList()
	set metadata tag "profile-collection-booster-set" of {_viewer} to chest inventory with 6 rows named "%{_target}% - %BoosterDisplayName({_booster})% Cards"
	set {_gui} to metadata tag "profile-collection-booster-set" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_mode} to ProfileSortMode({_viewer})
	set {_yamlKey} to BoosterYamlKey({_booster})
	set {_cards::*} to yaml node keys "%{_yamlKey}%.Cards" in "BoosterCardList"
	set {_index} to 0
	clear {_entries::*}
	set {_entryCount} to 0
	loop {_cards::*}:
		set {_index} to {_index} + 1
		if {_mode} = "Alphabetical":
			set {_sortKey} to "%loop-value%-%SortKeyPad({_index})%"
		else:
			set {_order} to yaml value "%{_yamlKey}%.Cards.%loop-value%.IdGlobal" in "BoosterCardList"
			if {_order} is not set:
				set {_order} to 9999
			set {_sortKey} to "%SortKeyPad({_order})%-%SortKeyPad({_index})%"
		set {_entryCount} to {_entryCount} + 1
		set {_entries::%{_entryCount}%} to "%{_sortKey}%|||%loop-value%"
	sort {_entries::*} in ascending order
	set {_total} to size of {_entries::*}
	set {_start} to {_page} * 45 + 1
	set {_end} to {_start} + 44
	set {_slot} to 0
	loop integers between {_start} and {_end}:
		set {_entry} to {_entries::%loop-value%}
		if {_entry} is set:
			set {_parts::*} to {_entry} split at "|||"
			set {_cardName} to {_parts::2}
			set {_count} to BoosterCardCount({_target}, {_booster}, {_cardName})
			if {_count} > 0:
				set {_preview} to BoosterCardItem({_booster}, {_cardName})
				set lore of {_preview} to BoosterCardLore({_booster}, {_cardName}, {_count})
				set {_preview} to {_preview} with item flag hide attributes
			else:
				set {_preview} to gray stained glass pane named "&7???" with lore BoosterUnknownCardLore({_booster}, {_cardName})
			set slot {_slot} of {_gui} to {_preview}
			set {_slot} to {_slot} + 1
	set slot 48 of {_gui} to ProfileSortItem({_viewer})
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	if {_page} > 0:
		set slot 45 of {_gui} to arrow named "&ePrevious Page" with lore "&7Page &f%{_page}%" with item flag hide attributes
	if {_total} > {_end}:
		set slot 53 of {_gui} to arrow named "&eNext Page" with lore "&7Page &f%{_page}+2%" with item flag hide attributes
	set metadata value "ProfileBoosterSet" of {_viewer} to {_booster}
	set metadata value "ProfileBoosterSetPage" of {_viewer} to {_page}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function ProfileStatCategoryItem(category: text) :: item:
	if {_category} = "Mining":
		return iron pickaxe named "&eMining"
	else if {_category} = "Combat":
		return iron sword named "&cCombat"
	else if {_category} = "Professions":
		return brewing stand named "&bProfessions"
	else if {_category} = "Experience":
		return experience bottle named "&aExperience"
	else if {_category} = "Miscellaneous" or "General" or "Global":
		return nether star named "&dMiscellaneous"
	else if {_category} = "Chat":
		return writable book named "&fChat"
	else if {_category} = "Diamond Chest":
		return diamond named "&bDiamond Chest"
	else if {_category} = "Stellar Chest":
		return amethyst shard named "&dStellar Chest"
	else if {_category} = "Boosters":
		return glass pane named "&5Boosters"
	return paper named "&f%{_category}%"

function ProfileStatSummaryLines(target: player, category: text) :: texts:
	if {_category} = "Experience":
		set {_total} to yaml value "Statistics.Experience.Total" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		return "&7Total XP Gained: &f%{_total}%"

	else if {_category} = "Professions":
		set {_jcLvl} to {poziomjubilerstwo::%{_target}%}
		if {_jcLvl} is not set:
			set {_jcLvl} to 0
		set {_enchLvl} to yaml value "Professions.Enchanting.Level" in "data-%{_target}%"
		if {_enchLvl} is not set:
			set {_enchLvl} to 0
		set {_minLvl} to {poziomgornictwo::%{_target}%}
		if {_minLvl} is not set:
			set {_minLvl} to 0
		return "&7Jewelcrafting Level: &f%{_jcLvl}%", "&7Enchanting Level: &f%{_enchLvl}%", "&7Mining Level: &f%{_minLvl}%"

	else if {_category} = "Mining":
		set {_stone} to yaml value "Statistics.Mining.Stone Mined" in "data-%{_target}%"
		if {_stone} is not set:
			set {_stone} to 0
		set {_deepslate} to yaml value "Statistics.Mining.Deepslate Mined" in "data-%{_target}%"
		if {_deepslate} is not set:
			set {_deepslate} to 0
		set {_gems} to yaml value "Statistics.Mining.Gemstones Mined" in "data-%{_target}%"
		if {_gems} is not set:
			set {_gems} to 0
		return "&7Stone Mined: &f%{_stone}%", "&7Deepslate Mined: &f%{_deepslate}%", "&7Gemstones Found: &f%{_gems}%"

	else if {_category} = "Stellar Chest":
		set {_total} to yaml value "Statistics.Stellar Chest.Total Drops" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		set {_pity} to yaml value "Statistics.Stellar Chest.Pity Drops" in "data-%{_target}%"
		if {_pity} is not set:
			set {_pity} to 0
		return "&7Total Drops: &f%{_total}%", "&7Pity Drops: &f%{_pity}%"

	else if {_category} = "Combat":
		set {_kills} to {mobskilled::%{_target}%}
		if {_kills} is not set:
			set {_kills} to 0
		return "&7Total Mob Kills: &f%{_kills}%"

	else if {_category} = "Chat":
		set {_msg} to yaml value "Statistics.Chat.Messages sent" in "data-%{_target}%"
		if {_msg} is not set:
			set {_msg} to 0
		return "&7Messages Sent: &f%{_msg}%"

	else if {_category} = "Diamond Chest":
		set {_total} to yaml value "Statistics.Diamond Chest.Total Drops" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		return "&7Total Drops: &f%{_total}%"

	else if {_category} = "Boosters":
		set {_total} to yaml value "Statistics.Boosters.Total" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		return "&7Total Opened: &f%{_total}%"

	else if {_category} = "Miscellaneous":
		set {_total} to yaml value "Statistics.General.Total" in "data-%{_target}%"
		if {_total} is not set:
			set {_total} to 0
		return "&7Miscellaneous stats."

	return "&7No recorded statistics."

function GetFormattedYamlLines(target: player, path: text, indent: text) :: strings:
	set {_keys::*} to yaml node keys {_path} in "data-%{_target}%"
	if size of {_keys::*} > 0:
		loop {_keys::*}:
			set {_childPath} to "%{_path}%.%loop-value%"
			set {_childKeys::*} to yaml node keys {_childPath} in "data-%{_target}%"
			if size of {_childKeys::*} > 0:
				set {_lines::*} to {_lines::*} and "%{_indent}%%loop-value%:"
				set {_childLines::*} to GetFormattedYamlLines({_target}, {_childPath}, "%{_indent}%  ")
				set {_lines::*} to {_lines::*} and {_childLines::*}
			else:
				set {_val} to yaml value {_childPath} in "data-%{_target}%"
				if {_val} is not set:
					set {_val} to 0
				set {_lines::*} to {_lines::*} and "%{_indent}%%loop-value%: &f%{_val}%"
	else:
		set {_val} to yaml value {_path} in "data-%{_target}%"
		if {_val} is not set:
			set {_val} to 0
		set {_lines::*} to {_lines::*} and "%{_indent}%Total: &f%{_val}%"
	return {_lines::*}

function ProfileStatItem(category: text, key: text) :: item:
	if {_category} = "Mining":
		if {_key} contains "Stone":
			return stone
		else if {_key} contains "Deepslate":
			return deepslate
		else if {_key} contains "Cobblestone":
			return cobblestone
		else if {_key} contains "Obsidian":
			return obsidian
		else if {_key} contains "Ruby":
			return red stained glass pane
		else if {_key} contains "Sapphire":
			return blue stained glass pane
		else if {_key} contains "Amethyst":
			return purple stained glass pane
		else if {_key} contains "Topaz":
			return yellow stained glass pane
		else if {_key} contains "Aquamarine":
			return light blue stained glass pane
		else if {_key} contains "Peridot":
			return lime stained glass pane
		else if {_key} contains "Amber":
			return orange stained glass pane
		else if {_key} contains "Klejnot":
			return emerald
		else if {_key} contains "Chest" or "skrzynka":
			return chest
		return iron pickaxe
	else if {_category} = "Professions":
		if {_key} contains "Recipe" or "Learned":
			return book
		if {_key} contains "Dust":
			return sugar
		return brewing stand
	else if {_category} = "Stellar Chest":
		if {_key} contains "Pity":
			return gold ingot
		return amethyst shard
	else if {_category} = "Diamond Chest":
		if {_key} contains "Pity":
			return gold ingot
		return diamond
	else if {_category} = "Combat":
		return iron sword
	else if {_category} = "Chat":
		return writable book
	else if {_category} = "Experience":
		return experience bottle
	else if {_category} = "Boosters":
		return glass pane
	return paper

function OpenProfileStatistics(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-stats" of {_viewer} to chest inventory with 6 rows named "%{_target}% - Statistics"
	set {_gui} to metadata tag "profile-stats" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25
	set {_i} to 1

	set {_categories::*} to "Experience", "Professions", "Mining", "Stellar Chest", "Combat", "Chat", "Diamond Chest", "Boosters", "Miscellaneous"
	loop {_categories::*}:
		set {_category} to loop-value
		set {_searchCategory} to {_category}
		if {_category} = "Miscellaneous":
			set {_searchCategory} to "General"

		set {_item} to ProfileStatCategoryItem({_category})
		set lore of {_item} to ProfileStatSummaryLines({_target}, {_searchCategory})
		set {_item} to {_item} with item flag hide attributes
		set {_slot} to {_slots::%{_i}%}
		if {_slot} is set:
			set slot {_slot} of {_gui} to {_item}
			set {_i} to {_i} + 1

	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileStatCategory(viewer: player, target: player, category: text):
	LoadTargetData({_target})
	set metadata tag "profile-stat-category" of {_viewer} to chest inventory with 6 rows named "%{_target}% - %{_category}%"
	set {_gui} to metadata tag "profile-stat-category" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes

	clear {flat-stats-keys::%{_viewer}%::*}
	clear {flat-stats-values::%{_viewer}%::*}

	set {_searchCategory} to {_category}
	if {_category} = "Miscellaneous":
		set {_searchCategory} to "General"

	set {_slot} to 9
	if {_category} = "Combat":
		set {_kills} to {mobskilled::%{_target}%}
		if {_kills} is not set:
			set {_kills} to 0
		set slot {_slot} of {_gui} to iron sword named "&eMob Kills" with lore "&7Total Mob Kills: &f%{_kills}%" with item flag hide attributes
		set {_slot} to {_slot} + 1
	else:
		loop yaml node keys "Statistics.%{_searchCategory}%" in "data-%{_target}%":
			set {_key} to loop-value
			set {_lines::*} to GetFormattedYamlLines({_target}, "Statistics.%{_searchCategory}%.%{_key}%", "")
			set {_item} to ProfileStatItem({_category}, {_key})

			set slot {_slot} of {_gui} to {_item} named "&e%{_key}%" with lore {_lines::*} with item flag hide attributes
			set {_slot} to {_slot} + 1
			if {_slot} >= 45:
				exit loop

	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	set metadata value "ProfileStatCategory" of {_viewer} to {_category}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileStatProfessionsSelect(viewer: player, target: player):
	set metadata tag "profile-stat-professions-select" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Professions Stats"
	set {_gui} to metadata tag "profile-stat-professions-select" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes

	set {_jcLvl} to {poziomjubilerstwo::%{_target}%}
	if {_jcLvl} is not set:
		set {_jcLvl} to 0
	set {_jcExp} to {exp::jubilerstwo::%{_target}%}
	if {_jcExp} is not set:
		set {_jcExp} to 0
	set {_jcRecipes} to {przepisy::jubilerstwo::%{_target}%}
	if {_jcRecipes} is not set:
		set {_jcRecipes} to 0
	set {_jc} to prismarine crystals named "&dJewelcrafting" with lore "&7Level: &f%{_jcLvl}%", "&7Experience: &f%{_jcExp}%&7/&f%150*{_jcLvl}%", "&7Unlocked Recipes: &f%{_jcRecipes}%&7/&f24" with item flag hide attributes
	set slot 11 of {_gui} to {_jc}

	set {_enchLvl} to yaml value "Professions.Enchanting.Level" in "data-%{_target}%"
	if {_enchLvl} is not set:
		set {_enchLvl} to 0
	set {_ench} to brewing stand named "&bEnchanting" with lore "&7Level: &f%{_enchLvl}%", " ", "&7Click to view detailed Enchanting stats." with item flag hide attributes
	set slot 13 of {_gui} to {_ench}

	set {_minLvl} to {poziomgornictwo::%{_target}%}
	if {_minLvl} is not set:
		set {_minLvl} to 0
	set {_min} to iron pickaxe named "&aMining" with lore "&7Level: &f%{_minLvl}%", " ", "&7Click to view detailed Mining stats." with item flag hide attributes
	set slot 15 of {_gui} to {_min}

	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileAchievements(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-achievements" of {_viewer} to chest inventory with 4 rows named "%{_target}% - Achievements"
	set {_gui} to metadata tag "profile-achievements" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set {_unlocked} to CountYamlTrue("data-%{_target}%", "Achievements.Achievement")

	set slot 10 of {_gui} to totem of undying named "&6Achievements Summary" with lore "&7Total Unlocked: &f%{_unlocked}%" with item flag hide attributes
	set slot 12 of {_gui} to iron pickaxe named "&eMining Achievements" with lore "&7Click to view Mining achievements." with item flag hide attributes
	set slot 13 of {_gui} to brewing stand named "&bProfessions Achievements" with lore "&7Click to view Professions achievements." with item flag hide attributes
	set slot 14 of {_gui} to experience bottle named "&aExperience Achievements" with lore "&7Click to view Level & Experience achievements." with item flag hide attributes
	set slot 15 of {_gui} to nether star named "&fGeneral Achievements" with lore "&7Click to view General achievements." with item flag hide attributes
	set slot 16 of {_gui} to glass pane named "&5Booster Achievements" with lore "&7Click to view Booster achievements." with item flag hide attributes
	set slot 19 of {_gui} to diamond named "&bDiamond Chest Achievements" with lore "&7Click to view Diamond Chest achievements." with item flag hide attributes
	set slot 20 of {_gui} to amethyst shard named "&dStellar Chest Achievements" with lore "&7Click to view Stellar Chest achievements." with item flag hide attributes
	set slot 21 of {_gui} to book named "&fCard Collection Achievements" with lore "&7Click to view Card Collection achievements." with item flag hide attributes
	set slot 31 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes

	set metadata value "ProfileTarget" of {_viewer} to {_target}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileAchievementsCategory(viewer: player, target: player, category: text):
	LoadTargetData({_target})
	loadAchievementList()
	set metadata tag "profile-achievements-category" of {_viewer} to chest inventory with 6 rows named "%{_target}% - %{_category}% Achievs"
	set {_gui} to metadata tag "profile-achievements-category" of {_viewer}
	set slots integers between 0 and 53 of {_gui} to black stained glass pane named " " with item flag hide attributes

	set {_slot} to 9
	set {_ids::*} to yaml node keys {_category} in "AchievementList"
	loop {_ids::*}:
		set {_id} to loop-value
		if {_name} is not set:
			set {_name} to {_id}

		set {_name} to yaml value "%{_category}%.%{_id}%.Name" in "AchievementList"
		set {_desc} to yaml value "%{_category}%.%{_id}%.Description" in "AchievementList"
		
		replace all "+" in {_name} with "."
		replace all ";" in {_name} with ":"

		if {_name} contains "TPVSTA":
			replace all "TPVSTA" in {_name} with "Team Poison vs. Team Aqua"

		set {_yamlPath} to "Achievements.Achievement.%{_category}%.%{_id}%"

		if yaml value {_yamlPath} in "data-%{_target}%" is true:
			set slot {_slot} of {_gui} to totem of undying named "&a%{_name}%" with lore "&7%{_desc}%", " ", "&a&lUNLOCKED" with item flag hide attributes
		else:
			set slot {_slot} of {_gui} to gray stained glass pane named "&c%{_name}%" with lore "&7%{_desc}%", " ", "&c&lLOCKED" with item flag hide attributes
		set {_slot} to {_slot} + 1
		if {_slot} >= 45:
			exit loop

	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	set metadata value "ProfileAchievementsCategory" of {_viewer} to {_category}
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileBirthday(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-birthday" of {_viewer} to chest inventory with 3 rows named "%{_target}% - Birthday"
	set {_gui} to metadata tag "profile-birthday" of {_viewer}
	set slots integers between 0 and 26 of {_gui} to black stained glass pane named " " with item flag hide attributes
	set slot 13 of {_gui} to cake named "&dBirthday" with lore "&7Current birthday: &f%ProfileBirthday({_target})%", " ", "&7Use &f/birthday <day> <month> <year> &7to set it." with item flag hide attributes
	set slot 22 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileFavouriteCard(viewer: player, target: player):
	LoadTargetData({_target})
	LoadStellarChestList()
	set metadata tag "profile-favcard" of {_viewer} to chest inventory with 6 rows named "%{_target}% - Favourite Card"
	set {_gui} to metadata tag "profile-favcard" of {_viewer}
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	set {_slot} to 0
	loop yaml node keys "Cards" in "StellarChestList":
		set {_card} to loop-value
		set {_preview} to StellarCardPreview({_card}, true)
		if {_preview} is set:
			set lore of {_preview} to coloured lore of {_preview}
			set string tag "StellarCard" of (custom nbt of {_preview}) to {_card}
			set {_preview} to {_preview} with item flag hide attributes
			set slot {_slot} of {_gui} to {_preview}
			set {_slot} to {_slot} + 1
			if {_slot} >= 45:
				exit loop
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

function OpenProfileFavouriteElement(viewer: player, target: player):
	LoadTargetData({_target})
	set metadata tag "profile-favelement" of {_viewer} to chest inventory with 6 rows named "%{_target}% - Favourite Element"
	set {_gui} to metadata tag "profile-favelement" of {_viewer}
	set metadata value "ProfileTarget" of {_viewer} to {_target}
	set {_slot} to 0
	loop {esencje::*}:
		set {_item} to loop-value
		set {_name} to name of {_item}
		replace all " Essence" in {_name} with ""
		set name of {_item} to {_name}
		set lore of {_item} to "&eClick here to set your favourite%nl%&eElement to %{_name}%"
		set slot {_slot} of {_gui} to {_item} with item flag hide attributes
		set {_slot} to {_slot} + 1
		if {_slot} >= 45:
			exit loop
	set slot 49 of {_gui} to barrier named "&cBack" with lore "&7Click to go back." with item flag hide attributes
	play sound "ui.click_echo" with volume 1 and pitch 1 to {_viewer}
	open {_gui} to {_viewer}

command /profile [<player>]:
	trigger:
		if arg-1 is set:
			set {_target} to arg-1
		else:
			set {_target} to player
		if {_target} is online:
			OpenProfileMain(player, {_target})

on inventory click:
	if event-inventory = metadata tag "profile-main" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 10:
			OpenProfileCollection(player, {_target})
		else if event-slot = 11:
			OpenProfileStatistics(player, {_target})
		else if event-slot = 12:
			OpenProfileAchievements(player, {_target})
		else if event-slot = 14:
			OpenProfileBirthday(player, {_target})
		else if event-slot = 15:
			OpenProfileFavouriteCard(player, {_target})
		else if event-slot = 16:
			OpenProfileFavouriteElement(player, {_target})

	else if event-inventory = metadata tag "profile-collection" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 22:
			OpenProfileMain(player, {_target})
		else if event-slot = 12:
			OpenProfileCollectionPlayable(player, {_target})
		else if event-slot = 14:
			OpenProfileCollectionBoosterMain(player, {_target})

	else if event-inventory = metadata tag "profile-collection-playable" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 49:
			OpenProfileCollection(player, {_target})

	else if event-inventory = metadata tag "profile-collection-booster" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 22:
			OpenProfileCollection(player, {_target})
		else if event-slot = 12:
			OpenProfileCollectionBoosterAll(player, {_target}, 0)
		else if event-slot = 14:
			OpenProfileCollectionBoosterSetSelect(player, {_target})

	else if event-inventory = metadata tag "profile-collection-booster-select" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 22:
			OpenProfileCollectionBoosterMain(player, {_target})
		else if clicked slot is not air:
			if name of clicked slot contains "Booster":
				set {_boosterName} to uncolored name of clicked slot
				replace all " Booster" in {_boosterName} with ""
				set {_boosterName} to BoosterYamlKey({_boosterName})
				OpenProfileCollectionBoosterSet(player, {_target}, {_boosterName}, 0)

	else if event-inventory = metadata tag "profile-collection-booster-all" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		set {_page} to metadata value "ProfileBoosterAllPage" of player
		if event-slot = 49:
			OpenProfileCollectionBoosterMain(player, {_target})
		else if event-slot = 53:
			OpenProfileCollectionBoosterAll(player, {_target}, {_page} + 1)
		else if event-slot = 45:
			OpenProfileCollectionBoosterAll(player, {_target}, {_page} - 1)
		else if event-slot = 48:
			if ProfileSortMode(player) = "Alphabetical":
				set metadata value "ProfileSortMode" of player to "Global ID"
			else:
				set metadata value "ProfileSortMode" of player to "Alphabetical"
			OpenProfileCollectionBoosterAll(player, {_target}, 0)

	else if event-inventory = metadata tag "profile-collection-booster-set" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		set {_booster} to metadata value "ProfileBoosterSet" of player
		set {_page} to metadata value "ProfileBoosterSetPage" of player
		if event-slot = 49:
			OpenProfileCollectionBoosterSetSelect(player, {_target})
		else if event-slot = 53:
			OpenProfileCollectionBoosterSet(player, {_target}, {_booster}, {_page} + 1)
		else if event-slot = 45:
			OpenProfileCollectionBoosterSet(player, {_target}, {_booster}, {_page} - 1)
		else if event-slot = 48:
			if ProfileSortMode(player) = "Alphabetical":
				set metadata value "ProfileSortMode" of player to "Global ID"
			else:
				set metadata value "ProfileSortMode" of player to "Alphabetical"
			OpenProfileCollectionBoosterSet(player, {_target}, {_booster}, 0)

	else if event-inventory = metadata tag "profile-stats" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 49:
			OpenProfileMain(player, {_target})
		else if clicked slot is not air:
			if name of clicked slot is set:
				set {_category} to uncolored name of clicked slot
				if {_category} = "Professions":
					OpenProfileStatProfessionsSelect(player, {_target})
				else:
					OpenProfileStatCategory(player, {_target}, {_category})

	else if event-inventory = metadata tag "profile-stat-professions-select" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 22:
			OpenProfileStatistics(player, {_target})
		else if clicked slot is not air:
			if index of event-slot is 13:
				OpenProfileStatCategory(player, {_target}, "Professions")
			else if index of event-slot is 15:
				OpenProfileStatCategory(player, {_target}, "Mining")

	else if event-inventory = metadata tag "profile-stat-category" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		set {_category} to metadata value "ProfileStatCategory" of player
		if event-slot = 49:
			if {_category} = "Professions" or "Mining":
				OpenProfileStatProfessionsSelect(player, {_target})
			else:
				OpenProfileStatistics(player, {_target})

	else if event-inventory = metadata tag "profile-achievements" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 22:
			OpenProfileMain(player, {_target})
		else if event-slot = 12:
			OpenProfileAchievementsCategory(player, {_target}, "Mining")
		else if event-slot = 13:
			OpenProfileAchievementsCategory(player, {_target}, "Professions")
		else if event-slot = 14:
			OpenProfileAchievementsCategory(player, {_target}, "Experience")
		else if event-slot = 15:
			OpenProfileAchievementsCategory(player, {_target}, "General")
		else if event-slot = 16:
			OpenProfileAchievementsCategory(player, {_target}, "Boosters")
		else if event-slot = 19:
			OpenProfileAchievementsCategory(player, {_target}, "Diamond Chest")
		else if event-slot = 20:
			OpenProfileAchievementsCategory(player, {_target}, "Stellar Chest")
		else if event-slot = 21:
			OpenProfileAchievementsCategory(player, {_target}, "Card Collection")

	else if event-inventory = metadata tag "profile-achievements-category" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 49:
			OpenProfileAchievements(player, {_target})

	else if event-inventory = metadata tag "profile-birthday" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 22:
			OpenProfileMain(player, {_target})

	else if event-inventory = metadata tag "profile-favcard" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 49:
			OpenProfileMain(player, {_target})
		else if {_target} = player:
			if clicked slot is not air:
				set {_card} to string tag "StellarCard" of (custom nbt of clicked slot)
				if {_card} is not set:
					set {_card} to uncolored name of clicked slot
				set yaml value "Player.Profile.Favourite Card" in "data-%player%" to {_card}
				save yaml "data-%player%"
				play sound "entity.player.levelup" with volume 3 and pitch 1.2 to player
				OpenProfileMain(player, player)

	else if event-inventory = metadata tag "profile-favelement" of player:
		cancel event
		set {_target} to metadata value "ProfileTarget" of player
		if event-slot = 49:
			OpenProfileMain(player, {_target})
		else if {_target} = player:
			if clicked slot is not air:
				set {_name} to name of clicked slot
				replace all " Essence" in {_name} with ""
				set yaml value "Player.Profile.Favourite Element" in "data-%player%" to uncolored {_name}
				save yaml "data-%player%"
				play sound "entity.player.levelup" with volume 3 and pitch 1.2 to player
				OpenProfileMain(player, player)

on rightclick on a player:
	if player is sneaking:
		if clicked player is online:
			set {_t} to clicked player
			set {_x} to {_t}'s name in uppercase
			set {_stoneMined} to {stone::%{_t}%} + {deepslate::%{_t}%}*2
			send "&f==== %{_x}% ====" to player
			send "&fLevel %ProfilePlayerLevel({_t})% &7| &fExp. %ProfilePlayerExp({_t})%" to player
			send " " to player
			send "&fFavourite Card: &e%ProfileFavouriteCard({_t})%" to player
			send "&fFavourite Element: &e%ProfileFavouriteElement({_t})%" to player
			send "&fBirthday: &e%ProfileBirthday({_t})%" to player
			send "&fTeam: &e%ProfileTeam({_t})%" to player
			send " " to player
			send "&fCurrent Card: &e%ProfileCurrentCard({_t})%" to player
			send "&fCard Level: &e%ProfileCurrentCardLevel({_t})%" to player
			send " " to player
			send formatted ProfilePrimaryStatLine({_t}) to player
			send formatted ProfileHealthLine({_t}) to player
			loop ProfileTopStatsLines({_t}):
				send formatted loop-value to player
			send " " to player
			send "&fTotal mob kills: &e%formatNumberEc({mobskilled::%{_t}%})%" to player
			send "&fTotal stone mined: &e%formatNumberEc({_stoneMined})%" to player
