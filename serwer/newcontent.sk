
using reflection



function azeriteContentUnlocked(p: player):
    if yaml value "Unlocked Content.Azerite" in "data-%{_p}%" is not set:
        set yaml value "Unlocked Content.Azerite" in "data-%{_p}%" to true
        play sound "ui.menu_select" with volume 1 and pitch 1 to {_p}
        save yaml "data-%{_p}%"
        send "" to {_p}
        send mini message from "           <gradient:#A770EF:#CF8BF3:#FDB99B><b>✨ NEW CONTENT UNLOCKED" to {_p}
        send " " to {_p}
        send "<#A770EF>* &f   <##e8ce81>&nAzerite" to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7The blood of &fEarthcraft &7crystalizes into chunks of <##e8ce81>Azerite&7, an extremely potent and powerful material." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7Upon reaching certain amounts of &fArtifact Power&7, your &f <##e8ce81>Heart of Earthcraft &7will &flevel up &7and gain increased &fItem Level&7." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7Each level of your &f <##e8ce81>Heart of Earthcraft &7will require an increasing amount of &fArtifact Power." to {_p}
        send {_msg} to {_p}
        send " " to {_p}
        newContentUnlocked({_p}, "Azerite")

function heartContentUnlocked(p: player):
    if yaml value "Unlocked Content.Heart of Earthcraft" in "data-%{_p}%" is not set:
        play sound "ui.menu_select" with volume 1 and pitch 1 to {_p}
        set yaml value "Unlocked Content.Heart of Earthcraft" in "data-%{_p}%" to true
        save yaml "data-%{_p}%"
        send "" to {_p}
        send mini message from "           <gradient:#A770EF:#CF8BF3:#FDB99B><b>✨ NEW CONTENT UNLOCKED" to {_p}
        send " " to {_p}
        send "<#A770EF>* &f   <##e8ce81>&nHeart of Earthcraft" to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7The &f <##e8ce81>Heart of Earthcraft &7is an artifact medallion entrusted to only the worthiest of heroes by &f Magni Bronzebeard&7." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7The &f <##e8ce81>Heart of Earthcraft &7grants the ability to unlock &fAzerite Traits &7on exceptional pieces of armor called &fAzerite Armor&7." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7When you first acquire the &f <##e8ce81>Heart of Earthcraft&7, it begins at &fLevel 1 &7and &fItem Level 60&7." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7You are able to empower your &f <##e8ce81>Heart of Earthcraft &7by collecting &f Azerite&7, which will grant you &fArtifact Power&7."  to {_p}
        send {_msg} to {_p}
        send " " to {_p}
        newContentUnlocked({_p}, "Heart of Earthcraft")

function enchantingContentUnlocked(p: player):
    if yaml value "Unlocked Content.Enchanting" in "data-%{_p}%" is not set:
        play sound "ui.menu_select" with volume 1 and pitch 1 to {_p}
        set yaml value "Unlocked Content.Enchanting" in "data-%{_p}%" to true
        save yaml "data-%{_p}%"
        send "" to {_p}
        send mini message from "           <gradient:#A770EF:#CF8BF3:#FDB99B><b>✨ NEW CONTENT UNLOCKED" to {_p}
        send " " to {_p}
        send mini message from "<#A770EF>* <white>   <gradient:#9921de:#d35de8:#f536cb:#bf8cfa><u>Enchanting" to {_p}
        set {_enchanters} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanters"
        set {_enchanting} to mini message from "<gradient:#9921de:#d35de8:#f536cb:#bf8cfa>Enchanting"
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &f %{_enchanters}% &7are capable of creating powerful and unique &f✨ Enchants &7to empower &fGear &7and various &fProfession &7tools and practices." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7They specialise in amplifying the power of items, allowing players to more efficiently collect resources and maximise their combat capabilities." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7%{_enchanters}% &7gain the ability to &f✨ Disenchant&7, allowing them to extract materials from spare equipment and &fCards&7." to {_p}
        send " " to {_p}
        send "<#A770EF>* <#FDB99B>>> &7Players who specialize in %{_enchanting}% &7can also &f✨ Enchant &7experience into portable items and craft other various magical curiosities!"  to {_p}
        send {_msg} to {_p}
        send " " to {_p}
        newContentUnlocked({_p}, "Enchanting")

function azeriteArmorContentUnlocked(p: player):
	send " " to {_p}
	send mini message from "           <gradient:#A770EF:#CF8BF3:#FDB99B><b>✨ NEW CONTENT UNLOCKED" to {_p}
	send " " to {_p}
	send "<#A770EF>* &f   <##0070dd>&nAzerite Armor" to {_p}
	send " " to {_p}
	send "<#A770EF>* <#FDB99B>>> &7Azerite Armor pieces are exceptional gear found across Earthcraft. Each piece contains &fAzerite Rings&7, which are tiers of selectable traits." to {_p}
	send " " to {_p}
	send "<#A770EF>* <#FDB99B>>> &7Rare pieces have &f4 rings&7. &fRow 1 &7offers a trait specific to your currently active card. &fRow 2 &7offers a general offensive trait. &fRow 3 &7offers a utility trait." to {_p}
	send " " to {_p}
	send "<#A770EF>* <#FDB99B>>> &7Epic pieces have &f5 rings&7. They gain an &fadditional card-specific trait &7on &fRow 2&7, followed by general offensive on &fRow 3 &7and utility on &fRow 4." to {_p}
	send " " to {_p}
	send "<#A770EF>* <#FDB99B>>> &7Each trait empowers a specific ability. &7The final ring is &fAzerite Empowered&7." to {_p}
	send " " to {_p}
	send "<#A770EF>* <#FDB99B>>> &7Once all other rings have a trait selected, you may empower the piece to increase its &fItem Level by 5 &7and boost all active traits." to {_p}
	send " " to {_p}
	send "<#A770EF>* <#FDB99B>>> &7Equipping Azerite Armor requires the &f <##e8ce81>Heart of Earthcraft &7to be worn." to {_p}
	send {_msg} to {_p}
	send "" to {_p}
	newContentUnlocked({_p}, "Azerite Armor")

function newContentUnlocked(p: player, content: string):
    send title "&eNew Content Unlocked" with subtitle {_content} to {_p} for 2 seconds with fade in 0.5 second and fade out 1.5 second
    spawn fake lightning at {_p} for all players
    play sound "entity.item.pickup" with volume 5 and pitch 1 to {_p}
    play sound "entity.villager.work_cartographer" with volume 5 and pitch 1 to {_p}
    play sound "ui.toast.challenge_complete" with volume 5 and pitch 1.5 to {_p}

command /newcontenttest [<text>]:
    trigger:
        if player's name = "Pehrek":
            set {_function} to function named arg-1
            if {_function} is set:
                execute {_function} with arguments player