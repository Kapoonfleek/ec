	if getCurrentVariant({_p}, "Cresselia") = "Arctic Lights":
		play sound "skill.cresselia.starsurgecast.arcticlights" with volume 4 and pitch 1 at location of {_p}
		play sound "skill.cresselia.starsurgeecho.arcticlights" with volume 4 and pitch 1 at location of {_p}
		play sound "skill.cresselia.starsurgeextra.arcticlights" with volume 4 and pitch 1 at location of {_p}
	else:
		play sound "skill.cresselia.starsurgecast" with volume 4 and pitch 1 at location of {_p}

function CresseliaStarsurgeImpactSound(p: player, target: entity):
	if getCurrentVariant({_p}, "Cresselia") = "Arctic Lights":
		play sound "skill.cresselia.starsurgeimpact.arcticlights" with volume 4 and pitch 1 at location of {_target}
	else:
		play sound "skill.cresselia.starsurgeimpact" with volume 4 and pitch 1 at location of {_target}

function CresseliaStarfirePrecastSound(p: player):
