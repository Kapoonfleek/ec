#buckshot
import:
	org.bukkit.event.entity.EntityShootBowEvent
	org.bukkit.entity.AbstractArrow
	kr.toxicity.model.api.BetterModel
	kr.toxicity.model.api.tracker.EntityTrackerRegistry

on EntityShootBowEvent:
	set {_shooter} to event.getEntity()
	if {_shooter} is a player:
		if event.getBow() = bow:
			if boolean tag "Starbolt" of custom nbt of event.getBow() = true:
				if {kartaname::%{_shooter}%} = "Buckshot":
					if {_shooter} is alive:
						if CanUseAbility({_shooter}) != false:
							if event.getForce() = 3:
								SpreadShotFire({_shooter}, 1)

							else if event.getForce() >= 1.5:
								if event.getForce() < 3:
									if string tag "Talents;Row 4" of custom nbt of {karta::%{_shooter}%} != "Arrowmaster":
										SingleShotFire({_shooter})
									else:
										SpreadShotFire({_shooter}, 0.6)

							event.setCancelled(true)
						else:
							cancel event
				else:
					send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to {_shooter}
					play sound "block.glass.break" with volume 3 and pitch 0 to {_shooter}

function SingleShotFire(p: player):
	AbilityUse({_p}, "Single Shot")
	set {_modifier} to 1

	play sound "entity.skeleton.shoot" with volume 3 and pitch 1 at location of {_p}
	play sound "entity.puffer_fish.blow_out" with volume 3 and pitch 1.1 at location of {_p}
	set {_loc} to location 1 above {_p}

	if string tag "Talents;Row 3" of custom nbt of {karta::%{_p}%} = "Shotweaving":
		ShotweavingBuckshot({_p}, 10 seconds, "Spread Shot")

	SpreadShotArrow({_p}, {_loc}, false, {_modifier}, "Single")

function SingleShotModifiers(p: player, modifier: number) :: number:
	set {_quickshotSpeedModifier} to 1.3
	set {_quickshotDamageModifier} to 1.1
	if boolean tag "Constellation;And For My Next Trick" of custom nbt of {karta::%{_p}%} is set:
		if string tag "Talents;Row 1" of custom nbt of {karta::%{_p}%} = "Quickshot":
			set {_quickshotSpeedModifier} to 1 + ({_quickshotSpeedModifier}-1)*2
			set {_quickshotDamageModifier} to 1 + ({_quickshotDamageModifier}-1)*2

		set {_arrowSpeed} to {_arrowSpeed} * {_quickshotSpeedModifier}
		set {_modifier} to {_modifier} * {_quickshotDamageModifier}

	else if string tag "Talents;Row 1" of custom nbt of {karta::%{_p}%} = "Quickshot":
		set {_arrowSpeed} to {_arrowSpeed} * {_quickshotSpeedModifier}
		set {_modifier} to {_modifier} * {_quickshotDamageModifier}

	if string tag "Talents;Row 3" of custom nbt of {karta::%{_p}%} = "Shotweaving":
		set {_shotweavingCount} to metadata value "Shotweaving-Single Shot" of {_p}
		if {_shotweavingCount} > 0:
			set {_shotweavingPercentModifier} to 2.5
			set {_shotweaving} to 1 + ({_shotweavingPercentModifier} * {_shotweavingCount})/100
			set {_modifier} to {_modifier} * {_shotweaving}

	return {_modifier}

function SpreadShotFire(p: player, modifier: number):
	AbilityUse({_p}, "Spread Shot")
	play sound "entity.skeleton.shoot" with volume 3 and pitch 1 at location of {_p}
	play sound "entity.firework_rocket.launch" with volume 3 and pitch 0.8  at location of {_p}

	set {_baseShotCount} to 5
	set {_shotCount} to {_baseShotCount}
	set {_change} to 0.6
	
	set {_wideShotShotCount} to 1
	set {_wideShotBaseModifier} to 1.15
	if boolean tag "Constellation;And For My Next Trick" of custom nbt of {karta::%{_p}%} is set:
		if string tag "Talents;Row 1" of custom nbt of {karta::%{_p}%} = "Wideshot":
			set {_wideShotShotCount} to {_wideShotShotCount}*2
			set {_wideShotBaseModifier} to 1 + ({_wideShotBaseModifier}-1)*2

		set {_shotCount} to {_shotCount} + {_wideShotShotCount}
		set {_change} to {_change}*{_wideShotBaseModifier}
		set {_modifier} to {_modifier} * {_wideShotBaseModifier}

	else if string tag "Talents;Row 1" of custom nbt of {karta::%{_p}%} = "Wideshot":
		set {_shotCount} to {_shotCount} + {_wideShotShotCount}
		set {_change} to {_change}*{_wideShotBaseModifier}
		set {_modifier} to {_modifier} * {_wideShotBaseModifier}

	if string tag "Talents;Row 3" of custom nbt of {karta::%{_p}%} = "Spreading Shots":
		chance of 20%:
			add 2 to {_shotCount}
			set {_modifier} to {_modifier} * 1.15
			play sound "entity.chicken.egg" with volume 1 and pitch 0 at location of {_p}
	if string tag "Talents;Row 2" of custom nbt of {karta::%{_p}%} = "Ethereal Shot":
		set {_etherealArrow} to a random integer between 1 and {_shotCount}
		play sound "block.end_portal_frame.fill" with volume 1 and pitch 2 at location of {_p}
	else:
		play sound "entity.puffer_fish.blow_up" with volume 3 and pitch 1.1 at location of {_p}

	if string tag "Talents;Row 3" of custom nbt of {karta::%{_p}%} = "Shotweaving":
		ShotweavingBuckshot({_p}, 10 seconds, "Single Shot")

		set {_shotweavingCount} to metadata value "Shotweaving-Spread Shot" of {_p}
		if {_shotweavingCount} > 0:
			set {_shotweavingPercentModifier} to 2.5
			set {_shotweaving} to 1 + ({_shotweavingPercentModifier} * {_shotweavingCount})/100
			set {_modifier} to {_modifier} * {_shotweaving}

	
	if string tag "Talents;Row 5" of custom nbt of {karta::%{_p}%} = "Main Attraction":
		if metadata value "G.O.A.T" of {_p} is set:
			set {_totalShots} to 20
			if {_etherealArrow} is set:
				set {_etherealArrow} to a random integer between 1 and {_totalShots}

			set {_damageIncreaseArrowsLost} to 1 + 0.05*({_shotCount}-{_baseShotCount})
			set {_modifier} to ({_modifier}*1.2)*{_damageIncreaseArrowsLost}
			set {_y} to 0
			set {_yaw} to -180
			set {_mod} to 360/{_totalShots}
			#If you do not update the yaw it creates a sort of chakram effect, cool for some kind of effect in the future

			loop {_totalShots} times:
				set {_x} to {_p}'s location
				increase {_x}'s y-coordinate by 1.25
				set {_v} to vector 0.1, 0, 0.1
				rotate {_v} around y-axis by {_y}
				set {_loc} to {_x} ~ {_v}
				set yaw of {_loc} to {_yaw}
				add {_mod} to {_y}
				add {_mod} to {_yaw}

				if loop-number = {_etherealArrow}:
					SpreadShotArrow({_p}, {_loc}, false, {_modifier}, "Ethereal")
				else:
					SpreadShotArrow({_p}, {_loc}, false, {_modifier}, "Magic Volley")	
	else:
		set {_middlePoint} to (rounded up {_shotCount}/2)
		set {_startingPoint} to location 1 above (location 0 in front of {_p})
		set {_startingLeft} to location 0 - (({_middlePoint}-1)*{_change}) left of {_startingPoint}

		loop {_shotCount} times:
			set {_loc} to {_startingLeft}
			set {_startingLeft} to location {_change} left of {_startingLeft}

			if loop-number = {_etherealArrow}:
				SpreadShotArrow({_p}, {_loc}, false, {_modifier}, "Ethereal")
			else:
				SpreadShotArrow({_p}, {_loc}, false, {_modifier}, "Multi")	

function SpreadShotArrow(p: player, x: location, nocharge: boolean, modifier: number, type: string, originalType: string = ""):
	set {_arrowSpeed} to 0.7

	shoot an arrow from {_x} with speed 2.75
	if {_type} = "Multi":
		set string tag "ProjectileType" of custom nbt of last shot arrow to "Spread Shot"
		if string tag "Talents;Row 4" of custom nbt of {karta::%{_p}%} = "Arrowmaster":
			set {_modifier} to SingleShotModifiers({_p}, {_modifier})

	else if {_type} = "Single":
		set string tag "ProjectileType" of custom nbt of last shot arrow to "Single Shot"
		set {_modifier} to SingleShotModifiers({_p}, {_modifier})

	else if {_type} = "Ethereal":
		set string tag "ProjectileType" of custom nbt of last shot arrow to "Ethereal Shot"
		EtherealArrow(last shot arrow)
		set {_modifier} to {_modifier} * 3

	else if {_type} = "Binding":
		set string tag "ProjectileType" of custom nbt of last shot arrow to "Binding Shot"
		play sound "entity.puffer_fish.blow_up" with volume 3 and pitch 0.2 at location of {_p}
		play sound "skill.buckshot.magicportal" with volume 3 and pitch 0.75 at location of {_p}
		set {_arrowSpeed} to {_arrowSpeed} + 1.7

	else if {_type} = "Magic Volley":
		set string tag "ProjectileType" of custom nbt of last shot arrow to "Magic Volley"
		if string tag "Talents;Row 4" of custom nbt of {karta::%{_p}%} = "Arrowmaster":
			set {_modifier} to SingleShotModifiers({_p}, {_modifier})

	else if {_type} = "Arrow Barrage":
		set string tag "ProjectileType" of custom nbt of last shot arrow to "Arrow Barrage"

	else:
		set string tag "ProjectileType" of custom nbt of last shot arrow to "Portal Shot"
		set boolean tag "PortalArrow" of custom nbt of last shot arrow to true
	
	if {_originalType} = "":
		set {_originalType} to (string tag "ProjectileType" of custom nbt of last shot arrow)
		
	else if {_originalType} = "Ethereal Shot":
		set glowing of last shot arrow to true

	set string tag "ProjectileTypeOriginal" of custom nbt of last shot arrow to {_originalType}

	if {_type} = "Ethereal":
		TrailMultiParticleBuckshot(last shot projectile)
	else if {_type} = "Binding":
		TrailSingleParticleBuckshot(last shot projectile, witch particle)
	else:
		TrailSingleParticleBuckshot(last shot projectile)
	
	if boolean tag "Constellation;Mystic Speed" of custom nbt of {karta::%{_p}%} is set:
		set {_arrowSpeed} to {_arrowSpeed}*1.1
		set {_arrowSpeed} to {_arrowSpeed}*Haste({_p})

	set {_arrow} to last shot arrow
	set gravity of {_arrow} to false
	set vector length of {_arrow}'s velocity to {_arrowSpeed}
	set metadata value "ProjectileShooter" of {_arrow} to {_p}
	set boolean tag "BuckshotArrow" of custom nbt of {_arrow} to true
	set float tag "DamageModifier" of custom nbt of {_arrow} to {_modifier}

	KillArrow({_arrow})
	{_arrow}.setPierceLevel(127)

function KillArrow(e: entity):
	wait 20 seconds
	clear metadata value "ProjectileType" of {_e}
	clear metadata value "ProjectileShooter" of {_e}
	kill {_e}

function EtherealArrow(e: entity):
	set {_shape} to a helix with radius 0.5, height 10, and winding rate 0.25 loops per block
	set glowing of {_e} to true
	create a new custom dust_color_transition particle with:
		count: 1
		velocity: outwards
		force: true
		data: dustTransition(blue, white, 0.65)
	set particle of {_shape} to last created particle
	while {_e} is alive:
		draw an animation of shape {_shape} at location 0.5 above {_e} over 16 ticks:
			rotate shape drawn shape around relative z axis by 90
		draw an animation of shape {_shape} at location 0.5 above {_e} over 16 ticks:
			rotate shape drawn shape around relative z axis by -90
		wait 16 ticks

function TrailSingleParticleBuckshot(e: entity, particle: particle = electric spark particle):
	while block at {_e} is air:
		if {_e} is alive:
			draw 1 of {_particle} at {_e} with offset vector(1, 0.125, 1) with extra 1
			wait 1 tick
		else:
			stop loop
	
function TrailMultiParticleBuckshot(e: entity):
	create a new custom dust_color_transition particle with:
		count: 1
		velocity: outwards
		force: false
		data: dustTransition(blue, magenta, 0.55)
	set {_particle} to last created particle
	
	while block at {_e} is air:
		if {_e} is alive:
			draw {_particle} particle at {_e}
			wait 1 tick
		else:
			stop loop
			
function BuckshotPortalCreate(p: player, portals: boolean, eventblock: location, duration: timespan, goat: boolean = false):
	set {_block} to block above {_eventblock}
	if {_eventblock} is not solid:
		set {_blocksabove} to 1.3
	else:
		set {_blocksabove} to 2.3

	spawn 1 armor stand at location {_blocksabove} above {_eventblock}
	set boolean tag "Invisible" of nbt of last spawned armor stand to true
	set boolean tag "Invulnerable" of nbt of last spawned armor stand to true
	set boolean tag "Silent" of nbt of last spawned armor stand to true
	set boolean tag "NoGravity" of nbt of last spawned armor stand to true

	set boolean tag "BuckshotPortal" of custom nbt of last spawned armor stand to true
	set int tag "PortalCount" of custom nbt of last spawned armor stand to 0
	set boolean tag "RemoveOnReset" of custom nbt of last spawned armor stand to true
	set uuid tag "PortalOwner" of custom nbt of last spawned armor stand to {_p}

	set {_portal} to last spawned armor stand
	set {buckshotportals::%{_p}%::*} to {buckshotportals::%{_p}%::*} and {_portal}
	set {_uuid} to uuid of {_portal}

	set {_shapes::outer-circle} to a circle of radius 1.225
	set {_shapes::inner-circle} to a circle of radius 1
	set {_shapes::tiny-circle} to a circle of radius 0.675

	set {_shapes::triangle-1} to a triangle with radius 1
	set {_shapes::triangle-2} to a triangle with radius 1
	rotate shapes {_shapes::triangle-2} around y axis by 60 degrees

	set particle of {_shapes::*} to dragon breath particle
	
	set {_eye} to location {_blocksabove} above {_eventblock}
	if {_portals} is not true:
		set {_view} to vector from yaw {_p}'s yaw and pitch {_p}'s pitch
	else:
		set {_yawrandom} to a random number between -180 and 180
		set {_view} to vector from yaw {_yawrandom} and pitch {_p}'s pitch

	set {_yaw} to yaw of {_view}
	set {_rotation} to rotation from vector(0, 1, 0) to {_view}
	set {_loc} to location of {_portal}
	set yaw of {_loc} to {_yaw}
	if {_p}'s pitch is between 60 and 90:
		set pitch of {_loc} to pitch of {_p}
	increase y-coordinate of {_loc} by -2
	teleport {_portal} to {_loc}

	set boolean tag "Invisible" of nbt of {_portal} to false

	if string tag "Talents;Row 4" of custom nbt of {karta::%{_p}%} = "More Bang for Your Buck":
		MoreBangForYourBuck({_p})

	BuckshotPortalDelete({_p}, {_portal}, {_duration})

	set {_scale} to BuckshotPortalScale({_p})

	if string tag "Talents;Row 5" of custom nbt of {karta::%{_p}%} = "Goated Portals":
		GoatedPortals({_p}, {_portal})

	set {_model} to BetterModel.model("portalbuckshot").get().getOrCreate({_portal})
	{_model}.scaler({_model}.scaler().multiply({_scale}))
	{_model}.registry().reload()

	if boolean tag "Constellation;Magical Adjustment" of custom nbt of {karta::%{_p}%} is set:
		MagicalAdjustment({_p}, {_portal})

function BuckshotPortalScale(p: player) :: number:
	set {_scale} to 2.0
	if string tag "Talents;Row 5" of custom nbt of {karta::%{_p}%} = "Dimensional Damage":
		set {_scale} to {_scale}*1.2
	if boolean tag "Constellation;Size Sometimes Matters" of custom nbt of {karta::%{_p}%} is set:
		set {_scale} to {_scale}*1.2

	return {_scale}

function BuckshotPortalDelete(p: player, portal: entity, t: timespan):
	wait {_t}
	remove {_portal} from {buckshotportals::%{_p}%::*}

	if int tag "AdditionalTextPortal" of custom nbt of {_portal} is set:
		set {_idText} to int tag "AdditionalTextPortal" of custom nbt of {_portal}
		remove fake entity with id {_idText} for {_p}

	kill {_portal}
	play sound "entity.ender_eye.death" with volume 2 and pitch 0.5 at location of {_portal}
	
	set {_modifier} to 1
	if boolean tag "Constellation;And For My Next Trick" of custom nbt of {karta::%{_p}%} is set:
		if string tag "Talents;Row 1" of custom nbt of {karta::%{_p}%} = "Abracadabra":
			set {_modifier} to 2
		AbracadabraBuckshot({_p}, {_portal}, {_modifier})

	else if string tag "Talents;Row 1" of custom nbt of {karta::%{_p}%} = "Abracadabra":
		AbracadabraBuckshot({_p}, {_portal}, {_modifier})

function AbracadabraBuckshot(p: player, portal: entity, modifier: number):
	if metadata value "ECEngaged" of {_p} is set:
		set {_portalRange} to 4 + CrowdControl({_p})/25
		set {_enemies::*} to LoopEntitiesAroundTarget({_portal}, {_portalRange}, false)
		set {_crit} to CriticalHit({_p})
		set {_damage} to 3 + ({damage::%{_p}%}/25) + ({versatility::%{_p}%}/75) + ({primarystat::%{_p}%}/12.5)
		set {_lore} to "lore"

		if string tag "Talents;Row 5" of custom nbt of {karta::%{_p}%} = "Dimensional Damage":
			set {_dimensionalDamageModifier} to 1.5
			set {_damage} to {_damage}*{_dimensionalDamageModifier}

		set {_damage} to {_damage}*{_modifier}

		set {_pitch} to a random number between 0.0 and 2.0
		play sound "skill.buckshot.magicportal_explode" with volume 1.5 and pitch {_pitch} at location of {_portal}

		loop {_enemies::*}:
			if metadata value "ECPulled" of loop-value is set:
				set {_damage} to Crit({_p}, loop-value, {_crit}, {_damage})
				set loop-value's last damage cause to sweep attack
				set metadata value "Element" of {_shooter} to "Magic"
				set metadata value "LastDamageCause" of loop-value to "<##866da4>Magic Portals"
				set metadata value "LastDamageCauseLore" of loop-value to {_lore}
				make {_p} damage loop-value by {_damage}

		draw 20 dragon breath particle at location above {_portal} with offset vector(2, 1, 2) with extra 0.5

on rightclick:
	if boolean tag "Magic Portals" of custom nbt of player's tool is set:
		if {kartaname::%player%} = "Buckshot":
			if CanUseAbility(player) != false:
				if cooldown "Magic Portals%player%" is finished:
					set {_portalRange} to 4 + CrowdControl(player)/25
					if distance between target block of player and player <= {_portalRange}:
						set {_cd} to 9
						set {_pospiech} to Haste(player)
						set {_cd} to {_cd}/{_pospiech}
						set {_cdd} to {_cd}
						set {_cd} to "%{_cd}% seconds" parsed as timespan
						create cooldown "Magic Portals%player%" for {_cd}
						set the cooldown of player's held item for player to {_cd}

						set {_duration} to 40 seconds
						if string tag "Talents;Row 5" of custom nbt of {karta::%player%} = "Dimensional Damage":
							set {_duration} to {_duration} + 10 seconds

						AbilityUse(player, "Magic Portals")
						set {_lore} to "&8Basic Ability%nl%&f2 Charges%nl%&fInstant cast%nl%&7Cooldown:  &f%{_cdd}% seconds%nl%&7Range: &f%{_portalRange}%%nl%&7Use: &fRMB%nl%<##866da4>Creates a &f <##c6b1de>Magic Portal <##866da4>at the target location%nl%<##866da4>for &f%seconds of {_duration}% sec<##866da4>. Arrows passing through a portal will%nl%<##866da4>vanish and <##c6b1de>fire <##866da4>from all other active &f <##c6b1de>Magic Portals<##866da4>.%nl%<##866da4>Pressing SHIFT will cause the portal to be created%nl%<##866da4>a block higher.%nl% %nl%<##866da4>Arrows can <##c6b1de>bounce <##866da4>between portals a maximum of%nl%&f3 <##866da4>times."
						LoreUpdate(player, "Magic Portals", {_lore})
						
						if player is sneaking:
							BuckshotPortalCreate(player, false, block above target block of player, {_duration})
						else:
							BuckshotPortalCreate(player, false, target block of player, {_duration})

						play sound "skill.buckshot.magic_portal_create" with volume 3 and pitch 0 at location of target block of player
						play sound "entity.enderman.teleport" with volume 3 and pitch 1.5 at location of target block of player
				else: 
					cancel event
					if {tekstcd::%player%} = true:
						if cooldown "CdTextOverlap%player%" is finished:
							create cooldown "CdTextOverlap%player%" for 2 ticks
							set {_cdd} to cooldown "Magic Portals%player%"
							send "<##866da4>You must wait &f%{_cdd}%<##866da4> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "G.O.A.T" of custom nbt of player's tool is set:
		if {kartaname::%player%} = "Buckshot":
			if CanUseAbility(player) != false:
				if cooldown "G.O.A.T%player%" is finished:
					set {_cd} to 5 #240
					set {_pospiech} to Haste(player)
					set {_duration} to 20 seconds
					set {_portalCount} to 12

					if string tag "Talents;Row 3" of custom nbt of {karta::%player%} = "Hail of Portals":
						set {_cd} to {_cd} - 2 #60
						set {_portalCount} to {_portalCount} + 4
						set {_hailOfPortals} to true

					set {_cd} to "%{_cd}/{_pospiech}% seconds" parsed as timespan

					create cooldown "G.O.A.T%player%" for {_cd}
					set the cooldown of player's held item for player to {_cd}
					AbilityUse(player, "G.O.A.T")

					set {_lore} to "lore"
					LoreUpdate(player, "G.O.A.T", {_lore})

					play sound "skill.buckshot.goat" with volume 4 and pitch 1.4 at location of player
					play sound "block.end_portal.spawn" with volume 4 and pitch 2 at location of player

					set {_y} to rounded down y-coordinate of player
					loop blocks in radius 15 around the player:
						if (rounded down y-coordinate of loop-block) = {_y}:
							add loop-block to {_blocks::*}
						else if (rounded down y-coordinate of loop-block) = ({_y}+ 1):
							add loop-block to {_blocks::*}

					loop 12 times:
						set {_block} to a random element of {_blocks::*}
						remove {_block} from {_blocks::*}
						BuckshotPortalCreate(player, true, {_block}, {_duration}, true)

					GOATBuckshot(player, {_duration}, {_blocks::*}, {_hailOfPortals})
					
				else: 
					cancel event
					if {tekstcd::%player%} = true:
						if cooldown "CdTextOverlap%player%" is finished:
							create cooldown "CdTextOverlap%player%" for 2 ticks
							set {_cdd} to cooldown "G.O.A.T%player%"
							send "<##866da4>You must wait &f%{_cdd}%<##866da4> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	else if boolean tag "Binding Shot" of custom nbt of player's tool is set:
		if {kartaname::%player%} = "Buckshot":
			if CanUseAbility(player) != false:
				if cooldown "Binding Shot%player%" is finished:
					set {_loc} to location 1 above player
					SpreadShotArrow(player, {_loc}, false, 0, "Binding")

					set {_damage} to 5 + ({damage::%player%}/11) + ({versatility::%player%}/33) + ({primarystat::%player%}/5.5)
					set {_lore} to "lore"
				else:
					cancel event
					if {tekstcd::%player%} = true:
						if cooldown "CdTextOverlap%player%" is finished:
							create cooldown "CdTextOverlap%player%" for 2 ticks
							set {_cdd} to cooldown "Binding Shot%player%"
							send "<##866da4>You must wait &f%{_cdd}%<##866da4> to use this ability." to player
					stop
		else:
			send "&8[&6Earthcraft&8] &6You don't have the required card selected to use this ability." to player
			play sound "block.glass.break" with volume 3 and pitch 0 to player

	if clicked entity is armor stand:
		if boolean tag "BuckshotPortal" of custom nbt of clicked entity is set:
			cancel event
			if boolean tag "Constellation;Interdimensional Travel" of custom nbt of {karta::%player%} is set:
				if boolean tag "AlreadyTraversed" of custom nbt of clicked entity != true:
					set {_owner} to uuid tag "PortalOwner" of custom nbt of clicked entity
					
					if ({_owner} parsed as player) = player:
						loop {buckshotportals::%player%::*}:
							if boolean tag "AlreadyTraversed" of custom nbt of loop-value != true:
								if loop-value != clicked entity:
									add loop-value to {_untraversedPortals::*}

						if size of {_untraversedPortals::*} > 0:
							set {_randomPortal} to a random element of {_untraversedPortals::*}

							set boolean tag "AlreadyTraversed" of custom nbt of clicked entity to true

							set {_loc} to location 0.5 above {_randomPortal}
							set yaw of {_loc} to {_randomPortal}'s yaw
							set pitch of {_loc} to {_randomPortal}'s pitch

							teleport player to {_loc}
							play sound "entity.enderman.teleport" with volume 3 and pitch 0.65 at location of {_randomPortal}

							set {_idText} to random integer between 0 and 999999999999

							set {_textAbove} to BuckshotPortalScale(player)

							set {_loc} to location {_textAbove} above clicked entity
							spawn fake text display entity at {_loc} for player with id {_idText}
							set {_meta} to metadata packet with id {_idText}

							set {_name} to "<##866da4>Traversed"
							add data from "display text %{_name}%" to {_meta}
							add data from "display billboard center" to packet {_meta}
							add data from "display brightness 15 15" to packet {_meta}
							add data from "display scale 0.75 0.75 0.75" to packet {_meta}

							send packet {_meta} to player
							set int tag "AdditionalTextPortal" of custom nbt of clicked entity to {_idText}

							draw 30 dragon breath particle at location above {_randomPortal} with offset vector(1, 0.5, 1) with extra 0.25
							draw 30 dragon breath particle at location above clicked entity with offset vector(1, 0.5, 1) with extra 0.25

on projectile collide:
	if boolean tag "BuckshotArrow" of custom nbt of event-projectile is set:
		set {_shooter} to metadata value "ProjectileShooter" of event-projectile
		if boolean tag "BuckshotPortal" of custom nbt of event-entity is not set:
			if event-entity is not {_shooter}:
				if event-entity is not a player:
					if boolean tag "AlreadyDamagedBuckshot%uuid of event-entity%" of (custom nbt of event-projectile) is not set:
						set boolean tag "AlreadyDamagedBuckshot%uuid of event-entity%" of (custom nbt of event-projectile) to true
						set {_shotTypes::*} to "Single Shot", "Spread Shot", "Portal Shot", "Ethereal Shot", "Magic Volley", "Arrow Barrage"
						if {_shotTypes::*} contains (string tag "ProjectileType" of custom nbt of event-projectile):
							set {_crit} to CriticalHit({_shooter})
							set {_damage} to 2 + ({damage::%{_shooter}%}/33) + ({versatility::%{_shooter}%}/99) + ({primarystat::%{_shooter}%}/16.5)
							set {_arrowBarrageDamage} to (1 + (({damage::%{_shooter}%}/47) + ({versatility::%{_shooter}%}/141) + {primarystat::%{_shooter}%}/23.5))

							set {_spreadShotDamage} to {_damage}*0.6
							set {_element} to "Magic"

							set {_shot} to string tag "ProjectileType" of custom nbt of event-projectile
							set {_shotType} to "<##866da4>%{_shot}%"

							if string tag "ProjectileType" of custom nbt of event-projectile is "Spread Shot":
								set {_damage} to {_spreadShotDamage}

							else if string tag "ProjectileType" of custom nbt of event-projectile is "Ethereal Shot":
								set {_damage} to {_spreadShotDamage}
								set {_element} to "Ethereal"
								set metadata value "IgnoreResistance%{_shooter}%" of event-entity to true

							else if string tag "ProjectileType" of custom nbt of event-projectile is "Magic Volley":
								set {_damage} to {_spreadShotDamage}

							else if string tag "ProjectileType" of custom nbt of event-projectile is "Arrow Barrage":
								set {_damage} to {_arrowBarrageDamage}
								if string tag "Talents;Row 5" of custom nbt of {karta::%{_shooter}%} = "Dimensional Damage":
									set {_dimensionalDamageModifier} to 1.5
									set {_damage} to {_damage}*{_dimensionalDamageModifier}
								
							else if string tag "ProjectileType" of custom nbt of event-projectile is "Portal Shot":
								if metadata value "ECPulled" of event-entity is set:
									set {_mastery} to 1 + (80 + ({mastery::%{_shooter}%}/7.25))/100

									if string tag "ProjectileTypeOriginal" of custom nbt of event-projectile = "Single Shot":
										set {_damage} to {_damage}*1
									else if string tag "ProjectileTypeOriginal" of custom nbt of event-projectile = "Spread Shot":
										set {_damage} to {_spreadShotDamage}

									set {_damage} to {_damage}*{_mastery}

									if string tag "Talents;Row 2" of custom nbt of {karta::%{_shooter}%} = "Arrow Barrage":
										chance of 5%:
											set {_arrowBarrageDuration} to 4 seconds
											ArrowBarrage({_shooter}, event-entity, {_arrowBarrageDuration})

								else:
									cancel event
									stop

							set {_modifier} to float tag "DamageModifier" of custom nbt of event-projectile
							set {_damage} to {_damage}*{_modifier}

							if Marksmanship4Set({_shooter}) is true:
								set {_damage} to {_damage}*1.35

							set {_damage} to Crit({_shooter}, event-entity, {_crit}, {_damage})

							set event-entity's last damage cause to sweep attack
							set metadata value "Element" of {_shooter} to {_element}
							set metadata value "LastDamageCause" of event-entity to {_shotType}
							set metadata value "LastDamageCauseLore" of event-entity to {_lore}
							make {_shooter} damage event-entity by {_damage}
						
						else if string tag "ProjectileTypeOriginal" of custom nbt of event-projectile = "Binding Shot":
							if boolean tag "ECMob" of custom nbt of event-entity is set:
								kill event-projectile
								play sound "entity.puffer_fish.sting" with volume 3 and pitch 2 at location of event-entity
								if metadata value "BindingShotTarget1" of {_shooter} is not set:
									if cooldown "Binding Shot%{_shooter}%" is finished:
										set metadata value "BindingShotTarget1" of {_shooter} to event-entity
										set {_bindingLoc} to "%x-coordinate of event-entity%,%y-coordinate of event-entity%,%z-coordinate of event-entity%"
										set metadata value "BindingShotCoordinates1" of {_shooter} to {_bindingLoc}
										BindingShotReset({_shooter})
										BindingShotEffect({_shooter}, event-entity)
								else:
									if event-entity != (metadata value "BindingShotTarget1" of {_shooter}):
										set {_firstTarget} to metadata value "BindingShotTarget1" of {_shooter}
										if world of event-entity = world of {_firstTarget}:
											set {_firstTargetLocText} to metadata value "BindingShotCoordinates1" of {_shooter}

											clear metadata value "BindingShotTarget1" of {_shooter}
											clear metadata value "BindingShotCoordinates1" of {_shooter}

											set {_cd} to 25 seconds
											create cooldown "Binding Shot%{_shooter}%" for {_cd}
											cooldownSpell({_shooter}, "Binding Shot", {_cd})

											BindingShotParticles(event-entity)
											set metadata value "BindingShotPartner" of event-entity to {_firstTarget}
											set metadata value "BindingShotPartner" of {_firstTarget} to event-entity

											set {_coords::*} to {_firstTargetLocText} split at ","
											loop {_coords::*}:
												set {_coordinateValues::%loop-counter%} to loop-value parsed as number

											set {_x} to (x-coordinate of event-entity + {_coordinateValues::1})/2
											set {_y} to (y-coordinate of event-entity + {_coordinateValues::2})/2
											set {_z} to (z-coordinate of event-entity + {_coordinateValues::3})/2

											set {_middleLoc} to location({_x}, {_y}, {_z}, world "%world of event-entity%")
											set {_targets::*} to {_firstTarget} and event-entity
											play sound "skill.buckshot.magicportal" with volume 3 and pitch 2 at {_middleLoc}
											play sound "entity.enderman.hurt" with volume 3 and pitch 2 at {_middleLoc}
											play sound "block.brewing_stand.brew" with volume 3 and pitch 1.6 at {_middleLoc}

											set {_crit} to CriticalHit({_shooter})
											set {_damage} to 5 + ({damage::%{_shooter}%}/11) + ({versatility::%{_shooter}%}/33) + ({primarystat::%{_shooter}%}/5.5)
											set {_element} to "Magic"
											set {_lore} to "lore"

											if string tag "Talents;Row 5" of custom nbt of {karta::%{_shooter}%} = "Dimensional Damage":
												set {_dimensionalDamageModifier} to 1.5
												set {_damage} to {_damage}*{_dimensionalDamageModifier}

											if Marksmanship4Set({_shooter}) is true:
												set {_damage} to {_damage}*1.35

											loop {_targets::*}:
												if loop-value is alive:
													BindingShotPull({_shooter}, loop-value, metadata value "BindingShotPartner" of loop-value, {_middleLoc})
													set {_damage} to Crit({_shooter}, loop-value, {_crit}, {_damage})

													set loop-value's last damage cause to sweep attack
													set metadata value "Element" of {_shooter} to {_element}
													set metadata value "LastDamageCause" of loop-value to "<##866da4>Binding Shot"
													set metadata value "LastDamageCauseLore" of loop-value to {_lore}
													make {_shooter} damage loop-value by {_damage}
													play sound "entity.generic.hurt" with volume 2 and pitch 1 at location of loop-value

		else:
			set {_projectileType} to string tag "ProjectileTypeOriginal" of custom nbt of event-projectile
			if {_projectileType} != "Binding Shot":
				set {_modifier} to float tag "DamageModifier" of custom nbt of event-projectile
				delete event-projectile

				set {_bounceLimit} to 3
					
				if boolean tag "PortalArrow" of custom nbt of event-projectile is set:
					set {_portalcount} to int tag "PortalCount" of custom nbt of event-entity
					if {_portalcount} < {_bounceLimit}:
						add 1 to {_portalcount}
						set int tag "PortalCount" of custom nbt of event-entity to {_portalcount}
					else:
						set {_PortalShotLimit} to true

				loop {buckshotportals::%{_shooter}%::*}:
					if loop-value is not event-entity:
						if chunk at loop-value is loaded:
							if distance between {_shooter} and loop-value < 100:
								if {_PortalShotLimit} is not set:
									SpreadShotArrow({_shooter}, loop-value's eye, false, {_modifier}, "Portal", {_projectileType})
									play sound "entity.enderman.teleport" with volume 2 and pitch 2 at location of loop-value
									
									if string tag "Talents;Row 4" of custom nbt of {karta::%{_shooter}%} = "Supernova":
										chance of 8%:
											SupernovaBuckshot({_shooter}, location of loop-value, event-entity)
		cancel event

	if boolean tag "Invisible" of nbt of event-projectile is true:
		cancel event
		
on projectile hit:
	set {_shooter} to metadata value "ProjectileShooter" of event-projectile
	set {_shotTypes::*} to "Single Shot", "Spread Shot", "Portal Shot", "Ethereal Shot", "Magic Volley", "Binding Shot", "Arrow Barrage"
	if {_shotTypes::*} contains (string tag "ProjectileType" of custom nbt of event-projectile):
		if event-block is a block:
			clear metadata value "ProjectileType" of event-projectile
			clear metadata value "ProjectileShooter" of event-projectile
			kill event-projectile

	if string tag "BuckshotArrowBalthazar" of custom nbt of event-projectile is set:
		set {_p} to (string tag "BuckshotArrowBalthazar" of custom nbt of event-projectile) parsed as entity
		BuckshotSpawn({_p}, event-location)

function BindingShotPull(p: player, e: entity, e2: entity, loc: location):
	if canBeCCed({_e}) = true:
		while distance between {_e} and {_loc} > 2:
			wait 1 tick
			push {_e} (vector from {_e} to {_loc}) with speed 0.5
			stop if loop-counter = 200
	
	if string tag "Talents;Row 2" of custom nbt of {karta::%{_p}%} = "Magic Tether":
		if metadata value "BindingShotPartner" of {_e} is set:
			set {_tetherPartner} to metadata value "BindingShotPartner" of {_e}
			clear metadata value "BindingShotPartner" of {_e}
			clear metadata value "BindingShotPartner" of {_tetherPartner}
			MagicTether({_p}, {_e}, {_tetherPartner})

function BindingShotReset(p: player):
	if metadata value "BindingShotTimer" of {_p} is not set:
		set metadata value "BindingShotTimer" of {_p} to 10 seconds
		while metadata value "BindingShotTimer" of {_p} > 0 seconds:
			wait 1 second
			remove 1 second from metadata value "BindingShotTimer" of {_p}
		clear metadata value "BindingShotTimer" of {_p}
		clear metadata value "BindingShotTarget1" of {_p}
		clear metadata value "BindingShotCoordinates1" of {_p}
	else:
		set metadata value "BindingShotTimer" of {_p} to 10 seconds

function BindingShotParticles(e: entity):
	set {_shapes::inner-circle} to a circle of radius 1
	set {_shapes::tiny-circle} to a circle of radius 0.675

	set {_shapes::triangle-1} to a triangle with radius 1
	set {_shapes::triangle-2} to a triangle with radius 1
	rotate shapes {_shapes::triangle-2} around y axis by 60 degrees

	set particle of {_shapes::*} to dragon breath particle

	draw shapes {_shapes::*} at {_e} for 0.2 seconds

function BindingShotEffect(p: player, e: entity):
	while metadata value "BindingShotTarget1" of {_p} = {_e}:
		BindingShotParticles({_e})
		wait 0.2 seconds

function GOATBuckshot(p: player, duration: timespan, blocks: locations, hailOfPortals: boolean = false):
	if metadata value "G.O.A.T" of {_p} is not set:
		set metadata value "G.O.A.T" of {_p} to {_duration}
		while metadata value "G.O.A.T" of {_p} > 0 seconds:
			if {_hailOfPortals} = true:
				if loop-counter is divisible by 5: 
					set {_block} to a random element of {_blocks::*}
					remove {_block} from {_blocks::*}
					BuckshotPortalCreate({_p}, true, {_block}, metadata value "G.O.A.T" of {_p}, true)
					play sound "skill.buckshot.magic_portal_create" with volume 3 and pitch 0 at {_block}
					play sound "entity.enderman.teleport" with volume 3 and pitch 1.5 at {_block}
			wait 1 second
			remove 1 second from metadata value "G.O.A.T" of {_p}
		clear metadata value "G.O.A.T" of {_p}
	else:
		set metadata value "G.O.A.T" of {_p} to {_duration}

function MagicTetherSound(e: entity):
	set {_pitch} to 0.5
	loop 3 times:
		play sound "entity.shulker.shoot" with volume 3 and pitch {_pitch} at location of {_e}
		wait 4 ticks
		add 0.5 to {_pitch}

function MagicTether(p: player, e1: entity, e2: entity):
	while distance between {_e1} and {_e2} < 5:
		stop loop if {_e1} is not alive
		stop loop if {_e2} is not alive

		set {_shape} to a line from {_e1} to {_e2}
		set particle of {_shape} to witch particle
		draw shape {_shape} at (location 1 above {_e1}) for 2 ticks
		wait 2 ticks
	
	set {_damage} to (8 + ({damage::%{_p}%}/9) + ({versatility::%{_p}%}/27) + ({primarystat::%{_p}%}/4.5)) * (1.8 + (({mastery::%{_p}%}/7.25)/100))
	set {_stunDurationValue} to 2 + CrowdControl({_p})/70
	set {_stunDuration} to "%{_stunDurationValue}% seconds" parsed as timespan

	set {_crit} to CriticalHit({_p})
	set {_lore} to "lore"
	set {_element} to "Magic"

	if string tag "Talents;Row 5" of custom nbt of {karta::%{_p}%} = "Dimensional Damage":
		set {_dimensionalDamageModifier} to 1.5
		set {_damage} to {_damage}*{_dimensionalDamageModifier}

	set {_targets::*} to {_e1} and {_e2}
	loop {_targets::*}:
		set {_damage} to Crit({_p}, loop-value, {_crit}, {_damage})

		set loop-value's last damage cause to sweep attack
		set metadata value "Element" of {_p} to {_element}
		set metadata value "LastDamageCause" of loop-value to "<##866da4>Magic Tether"
		set metadata value "LastDamageCauseLore" of loop-value to {_lore}
		make {_p} damage loop-value by {_damage}

		if loop-value is alive:
			Stun(loop-value, {_stunDuration})

		play sound "entity.generic.hurt" with volume 2 and pitch 1 at location of loop-value

function ArrowBarrage(p: player, e: entity, duration: timespan):
	if metadata value "ArrowBarrageBuckshot%{_p}%" of {_e} is not set:
		play sound "skill.buckshot.magic_portal_create" with volume 3 and pitch 2 at location of {_e}
		play sound "entity.enderman.teleport" with volume 2 and pitch 0.6 at location of {_e}

		set {_shapes::inner-circle} to a circle of radius 1
		set {_shapes::tiny-circle} to a circle of radius 0.675

		set {_shapes::triangle-1} to a triangle with radius 1
		set {_shapes::triangle-2} to a triangle with radius 1
		rotate shapes {_shapes::triangle-2} around y axis by 60 degrees

		set particle of {_shapes::*} to dragon breath particle

		set metadata value "ArrowBarrageBuckshot%{_p}%" of {_e} to {_duration}

		while metadata value "ArrowBarrageBuckshot%{_p}%" of {_e} > 0 seconds:
			set {_loc} to location 3 above {_e}

			draw shapes {_shapes::*} at {_loc} for 1 tick
			set pitch of {_loc} to 90

			ArrowBarrageArrow({_p}, {_loc})
			play sound "entity.chicken.egg" with volume 1.5 and pitch 1.25 at {_loc}
			play sound "entity.arrow.shoot" with volume 1.5 and pitch 1.25 at {_loc}

			wait 0.5 seconds
			remove 0.5 seconds from metadata value "ArrowBarrageBuckshot%{_p}%" of {_e}

			rotate shapes {_shapes::*} around y axis by 10 degrees

		clear metadata value "ArrowBarrageBuckshot%{_p}%" of {_e}

	else:
		set metadata value "ArrowBarrageBuckshot%{_p}%" of {_e} to {_duration}

function ArrowBarrageArrow(p: player, loc: location):
	set {_modifier} to (1.8 + (({mastery::%{_p}%}/7.25)/100))
	SpreadShotArrow({_p}, {_loc}, false, {_modifier}, "Arrow Barrage")

function ShotweavingBuckshot(p: player, duration: timespan, shotType: string):
	if metadata value "ECEngaged" of {_p} is set:
		if metadata value "Shotweaving-%{_shotType}%" of {_p} is not set:
			set metadata value "Shotweaving-%{_shotType}%" of {_p} to 1

			set metadata value "Shotweaving-%{_shotType}%Duration" of {_p} to {_duration}
			while metadata value "Shotweaving-%{_shotType}%Duration" of {_p} > 0 seconds:

				ShotweavingBuckshotUpdate({_p})

				wait 1 second
				remove 1 second from metadata value "Shotweaving-%{_shotType}%Duration" of {_p}

			clear metadata value "Shotweaving-%{_shotType}%Duration" of {_p}
			clear metadata value "Shotweaving-%{_shotType}%" of {_p}

			if metadata value "Shotweaving-Spread Shot" of {_p} is not set:
				if metadata value "Shotweaving-Single Shot" of {_p} is not set:
					buffClear({_p}, "Shot")
		else:
			set metadata value "Shotweaving-%{_shotType}%Duration" of {_p} to {_duration}
			if metadata value "Shotweaving-%{_shotType}%" of {_p} < 10:
				add 1 to metadata value "Shotweaving-%{_shotType}%" of {_p}
				ShotweavingBuckshotUpdate({_p})

function ShotweavingBuckshotUpdate(p: player):
	set {_percentIncrease} to 2.5
	if metadata value "Shotweaving-Single Shot" of {_p} is set:
		set {_stacksSingle} to metadata value "Shotweaving-Single Shot" of {_p}*{_percentIncrease}
		set {_durationSingle} to metadata value "Shotweaving-Single ShotDuration" of {_p}

		set {_durationSingle} to "%{_durationSingle}%"
		replace all " seconds" and " second" in {_durationSingle} with "s"
	else:
		set {_stacksSingle} to 0
		set {_durationSingle} to "0s"

	if metadata value "Shotweaving-Spread Shot" of {_p} is set:
		set {_stacksSpread} to metadata value "Shotweaving-Spread Shot" of {_p}*{_percentIncrease}
		set {_durationSpread} to metadata value "Shotweaving-Spread ShotDuration" of {_p}

		set {_durationSpread} to "%{_durationSpread}%"
		replace all " seconds" and " second" in {_durationSpread} with "s"
	else:
		set {_stacksSpread} to 0
		set {_durationSpread} to "0s"

	buffRegister({_p}, "Shot", 1, "", "Stacks", "&f <##866da4>%{_stacksSingle}%%% &f%{_durationSingle}% &7| &f <##866da4>%{_stacksSpread}%%% &f%{_durationSpread}%", "-")

function MoreBangForYourBuck(p: player):
	set {_portalsExisting} to (size of {buckshotportals::%{_p}%::*})-1
	set {_baseDuration} to 3.0
	set {_masteryScaling} to 7.25 * 2
	set {_extensionPerPortal} to 0.3

	set {_duration} to {_baseDuration} + {_portalsExisting}*{_extensionPerPortal}
	set {_duration} to "%{_duration}% seconds" parsed as timespan

	if metadata value "MoreBangForYourBuck" of {_p} is not set:
		set metadata value "MoreBangForYourBuck" of {_p} to {_masteryScaling}
	else:
		add {_masteryScaling} to metadata value "MoreBangForYourBuck" of {_p}
	
	add {_masteryScaling} to {bonusMastery::%{_p}%}

	set {_moreBang} to metadata value "MoreBangForYourBuck" of {_p}
	buffRegister({_p}, "More", 1, "", "Stacks", "&f%{_moreBang}% <##f53b98>", "-")
		
	wait {_duration}
	remove {_masteryScaling} from metadata value "MoreBangForYourBuck" of {_p}
	remove {_masteryScaling} from {bonusMastery::%{_p}%}
	buffRegister({_p}, "More", 1, "", "Stacks", "&f%metadata value "MoreBangForYourBuck" of {_p}% <##f53b98>", "-")

	if metadata value "MoreBangForYourBuck" of {_p} <= 0:
		buffClear({_p}, "More")

function SupernovaBuckshot(p: player, loc: location, portal: entity):
	set {_portalRange} to 4 + CrowdControl({_p})/25
	set {_enemies::*} to LoopEntitiesAroundTarget({_portal}, {_portalRange}, false)
	set {_crit} to CriticalHit({_p})
	set {_damage} to 4 + ({damage::%{_p}%}/21.75) + ({versatility::%{_p}%}/65.25) + ({primarystat::%{_p}%}/10.875)
	set {_lore} to "lore"

	set {_pitch} to a random number between 0.0 and 2.0
	play sound "skill.buckshot.supernova" with volume 1.5 and pitch {_pitch} at {_loc}

	if string tag "Talents;Row 5" of custom nbt of {karta::%{_p}%} = "Dimensional Damage":
		set {_dimensionalDamageModifier} to 1.5
		set {_damage} to {_damage}*{_dimensionalDamageModifier}

	loop {_enemies::*}:
		if metadata value "ECPulled" of loop-value is set:
			set {_damage} to Crit({_p}, loop-value, {_crit}, {_damage})
			set loop-value's last damage cause to sweep attack
			set metadata value "Element" of {_shooter} to "Magic"
			set metadata value "LastDamageCause" of loop-value to "<##866da4>Supernova"
			set metadata value "LastDamageCauseLore" of loop-value to {_lore}
			make {_p} damage loop-value by {_damage}

	set {_shape} to a helix with radius 2, height 4, and winding rate 0.5 loops per block
	create a new custom dust_color_transition particle with:
		count: 1
		velocity: inwards
		force: true
		data: dustTransition(purple, magenta, 0.55)
	set particle of {_shape} to last created particle
	draw an animation of shape {_shape} at location 0.5 above {_loc} over 10 ticks:
		rotate shape drawn shape around relative y axis by -1 * (yaw of {_p})

	set {_shape} to a solid sphere with radius 1
	create a new custom dust_color_transition particle with:
		count: 1
		velocity: inwards
		force: true
		data: dustTransition(purple, black, 1)
	set particle of {_shape} to last created particle
	draw shape {_shape} at location 0.5 above {_loc} for 5 ticks:
		rotate shape drawn shape around relative y axis by -0.5 * (yaw of {_p})

function GoatedPortals(p: player, portal: entity):
	while {_portal} is alive:
		stop if metadata value "ECEngaged" of {_p} is not set
		set {_haste} to Haste({_p})
		set {_tickTime} to "%3/{_haste}% seconds" parsed as timespan
		set {_randomChance} to a random number between 1.0 and 10.0

		chance of {_randomChance}%:
			set {_baseModifier} to 0.2
			set {_modifier} to SingleShotModifiers({_p}, {_baseModifier})

			SpreadShotArrow({_p}, {_portal}'s eye, false, {_modifier}, "Portal", "Single Shot")
			play sound "entity.enderman.teleport" with volume 2 and pitch 2 at location of {_portal}

		wait {_tickTime}
		
function MagicalAdjustment(p: player, portal: entity):
	set {_radius} to 20
	while {_portal} is alive:
		set {_haste} to Haste({_p})
		set {_tickTime} to "%3/{_haste}% seconds" parsed as timespan

		set {_entity} to nearest entity in radius {_radius} around {_portal} excluding (all entities where [boolean tag "ECMob" of custom nbt of input is not set])
	
		set {_vec} to vector between {_portal} and {_entity}
		set {_loc} to location of {_portal}

		set yaw of {_loc} to yaw of {_vec}
		set pitch of {_loc} to pitch of {_vec}

		teleport {_portal} to {_loc}

		wait {_tickTime}

function getElementalBypassBuckshot(p: player, element: text) :: number:
	return metadata value "ElementalBypassBuckshot%{_element}%" of {_p}

function ElementalBypassBuckshot(p: player, element: text):
	set {_duration} to 6 seconds
	if metadata value "ElementalBypassBuckshot%{_element}%" of {_p} is not set:
		set metadata value "ElementalBypassBuckshot%{_element}%" of {_p} to 1
	else:
		add 1 to metadata value "ElementalBypassBuckshot%{_element}%" of {_p}

	wait {_duration}

	remove 1 from metadata value "ElementalBypassBuckshot%{_element}%" of {_p}
	if metadata value "ElementalBypassBuckshot%{_element}%" of {_p} = 0:
		clear metadata value "ElementalBypassBuckshot%{_element}%" of {_p}

